---
import { Icon } from "astro-icon/components";
import { localeFromPath, localizePath } from "@/i18n";
import { getServicesData } from "@/data/services";

const currentYear = new Date().getFullYear();
const locale = localeFromPath(Astro.url.pathname);
const isEn = locale === "en";
const withSlash = (path: string) => {
  const hashIndex = path.indexOf("#");
  const base = hashIndex < 0 ? path : path.slice(0, hashIndex);
  const hash = hashIndex < 0 ? "" : path.slice(hashIndex);
  if (/\.[a-z0-9]+$/i.test(base)) return `${base}${hash}`;
  return `${base === "/" || base.endsWith("/") ? base : `${base}/`}${hash}`;
};
const to = (path: string) => withSlash(localizePath(path, locale));

const services = getServicesData(locale);

const socialLinks = [
  { title: "Instagram", path: "https://www.instagram.com/jaume.www/", icon: "bx:bxl-instagram" },
  { title: "LinkedIn", path: "https://www.linkedin.com/in/jautur/", icon: "bx:bxl-linkedin" },
  { title: "GitHub", path: "https://github.com/jaumetur3W", icon: "bx:bxl-github" },
];
const newTab = isEn ? "opens in a new tab" : "se abre en pestaña nueva";

const navLinks = [
  { title: isEn ? "Services & pricing" : "Servicios y precios", path: "/pricing" },
  { title: isEn ? "Projects" : "Proyectos", path: "/projectes" },
  { title: "Blog", path: "/blog" },
  { title: isEn ? "About me" : "Sobre mí", path: "/about" },
  { title: isEn ? "Contact" : "Contacto", path: "/contact" },
];
const toolLinks = [
  { title: isEn ? "HTML file creator" : "Creador de archivos HTML", path: "/tools/creador-html" },
  { title: isEn ? "CI/CD workflow generator" : "Generador de CI/CD para GitHub", path: "/tools/workflow-generator" },
  { title: isEn ? "Digital card (vCard)" : "Tarjeta digital (vCard)", path: "/card" },
];
const legalLinks = [
  { title: isEn ? "Privacy" : "Privacidad", path: "/privacidad" },
  { title: "Cookies", path: "/cookies" },
  { title: isEn ? "Legal notice" : "Aviso legal", path: "/aviso-legal" },
  { title: isEn ? "Quality & accessibility" : "Calidad y accesibilidad", path: "/qualitat" },
  { title: "RSS", path: "/rss.xml" },
];
const linkCls = "inline-flex min-h-9 items-center text-[1rem] text-paper underline decoration-transparent decoration-2 underline-offset-4 hover:decoration-ink";
const headCls = "font-mono text-[0.85rem] text-graphite";
---

<footer class="ink-block on-dark mt-auto">
  <div class="wrap pb-10 pt-16 sm:pt-24">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="font-display text-[clamp(2.5rem,5vw,4rem)] font-normal leading-[0.9]" style="font-stretch:75%">
          {isEn ? "Let's build the site your business needs." : "Hagamos la web que tu negocio necesita."}
        </p>
        <a href="mailto:jaumetur3w@gmail.com" class="btn btn-brand mt-8 w-full sm:w-auto">
          <Icon name="bx:envelope" class="h-5 w-5" aria-hidden="true" />
          <span>jaumetur3w@gmail.com</span>
        </a>
        <p class="mt-5">
          <a href="https://wa.me/34644525838" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2.5 text-[1rem] text-paper underline decoration-transparent decoration-2 underline-offset-4 hover:decoration-ink">
            <Icon name="bx:bxl-whatsapp" class="h-5 w-5" aria-hidden="true" />
            <span>WhatsApp +34 644 525 838</span><span class="sr-only"> ({newTab})</span>
          </a>
        </p>
        <ul class="mt-4 flex items-center gap-2">
          {socialLinks.map((item) => (
            <li>
              <a href={item.path} target="_blank" rel="noopener noreferrer"
                 class="flex h-11 w-11 items-center justify-center rounded-full border-2 border-paper text-paper hover:bg-brand hover:border-ink hover:text-ink"
                 aria-label={`${item.title} (${newTab})`}>
                <Icon name={item.icon} class="h-5 w-5" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <nav class="lg:col-span-3" aria-label={isEn ? "Services" : "Servicios"}>
        <h2 class={headCls}>{isEn ? "Services" : "Servicios"}</h2>
        <ul class="mt-4">
          {services.map((s) => (
            <li><a href={to(`/pricing/${s.id}`)} class={linkCls}>{s.name}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="lg:col-span-2" aria-label={isEn ? "Site" : "Sitio"}>
        <h2 class={headCls}>{isEn ? "Site" : "Sitio"}</h2>
        <ul class="mt-4">
          {navLinks.map((item) => (
            <li><a href={to(item.path)} class={linkCls}>{item.title}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="lg:col-span-2" aria-label={isEn ? "Free tools" : "Herramientas"}>
        <h2 class={headCls}>{isEn ? "Tools" : "Herramientas"}</h2>
        <ul class="mt-4">
          {toolLinks.map((item) => (
            <li><a href={to(item.path)} class={linkCls}>{item.title}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t border-paper/40 pt-6 text-sm md:flex-row md:items-center md:justify-between">
      <p class="text-graphite">© {currentYear} Jaume Tur · Xàtiva, València</p>
      <nav aria-label="Legal">
        <ul class="flex flex-wrap gap-x-6 gap-y-1">
          {legalLinks.map((item) => (
            <li><a href={to(item.path)} class="inline-flex min-h-9 items-center text-paper underline decoration-transparent decoration-2 underline-offset-4 hover:decoration-ink">{item.title}</a></li>
          ))}
          <li>
            <button
              type="button"
              data-open-cookie-settings
              class="inline-flex min-h-9 items-center text-paper underline decoration-transparent decoration-2 underline-offset-4 hover:decoration-ink"
            >
              {isEn ? "Cookie settings" : "Configurar cookies"}
            </button>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>

---
import { Icon } from "astro-icon/components";
import { localeFromPath, localizePath } from "@/i18n";
import { getServicesData } from "@/data/services";

const currentYear = new Date().getFullYear();
const locale = localeFromPath(Astro.url.pathname);
const isEn = locale === "en";
const withSlash = (path: string) => {
  const hashIndex = path.indexOf("#");
  const base = hashIndex < 0 ? path : path.slice(0, hashIndex);
  const hash = hashIndex < 0 ? "" : path.slice(hashIndex);
  if (/\.[a-z0-9]+$/i.test(base)) return `${base}${hash}`;
  return `${base === "/" || base.endsWith("/") ? base : `${base}/`}${hash}`;
};
const to = (path: string) => withSlash(localizePath(path, locale));

const services = getServicesData(locale);

const socialLinks = [
  { title: "Instagram", path: "https://www.instagram.com/jaume.www/", icon: "bx:bxl-instagram" },
  { title: "LinkedIn", path: "https://www.linkedin.com/in/jautur/", icon: "bx:bxl-linkedin" },
  { title: "GitHub", path: "https://github.com/jaumetur3W", icon: "bx:bxl-github" },
];

const navLinks = [
  { title: isEn ? "Services & pricing" : "Servicios y precios", path: "/pricing" },
  { title: isEn ? "Projects" : "Proyectos", path: "/projectes" },
  { title: "Blog", path: "/blog" },
  { title: isEn ? "HTML File Creator" : "Creador de archivos HTML", path: "/tools/creador-html" },
  { title: isEn ? "CI/CD Pipeline Generator" : "Generador CI/CD GitHub", path: "/tools/workflow-generator" },
  { title: isEn ? "Digital Card (vCard)" : "Tarjeta digital (vCard)", path: "/card" },
  { title: isEn ? "About me" : "Sobre mí", path: "/about" },
  { title: isEn ? "Contact" : "Contacto", path: "/contact" },
];

const legalLinks = [
  { title: isEn ? "Privacy" : "Privacidad", path: "/privacidad" },
  { title: "Cookies", path: "/cookies" },
  { title: isEn ? "Legal notice" : "Aviso legal", path: "/aviso-legal" },
  { title: isEn ? "Quality & accessibility" : "Calidad y accesibilidad", path: "/qualitat" },
  { title: "RSS Feed", path: "/rss.xml" },
];
---

<footer class="on-dark mt-auto border-t border-white/10 bg-[#08080a]">
  <!-- Ambient glow -->
  <div class="relative">
    <div class="pointer-events-none absolute left-1/2 -top-px h-px w-2/3 -translate-x-1/2 bg-gradient-to-r from-transparent via-brand/30 to-transparent" aria-hidden="true"></div>
  </div>

  <div class="mx-auto max-w-7xl px-5 pb-10 pt-16 sm:px-8 sm:pt-20">
    <!-- Top: Brand + Newsletter -->
    <div class="grid gap-14 lg:grid-cols-12">
      <!-- Col 1: Identity -->
      <div class="lg:col-span-5">
        <a href={to("/")} class="inline-flex items-center gap-3 rounded-2xl focus:outline-none group">
          <div class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-2xl border border-white/[0.08] bg-white/[0.03] transition-all duration-300 group-hover:scale-105 group-hover:border-brand/30 group-hover:shadow-[0_0_20px_rgba(255,255,0,0.12)]">
            <img src="/img/jt.LOGO-02-128.webp" alt="JT" width="48" height="48" class="h-full w-full object-cover" loading="lazy" decoding="async" />
          </div>
          <span class="font-display text-2xl font-bold tracking-tight text-white">
            jaume<span class="text-brand">tur</span>
          </span>
        </a>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-zinc-300">
          {isEn
            ? "Crafting high-performance digital experiences for local businesses and ambitious startups. Based in Xàtiva, available worldwide."
            : "Experiencias digitales de alto rendimiento para negocios locales y startups ambiciosas. Desde Xàtiva, disponible en todo el mundo."}
        </p>

        <a href="mailto:jaumetur3w@gmail.com" class="group/email mt-6 inline-flex items-center gap-2.5 rounded-full border border-white/[0.06] bg-white/[0.02] px-4 py-2 font-mono text-sm font-semibold text-brand transition-all duration-300 hover:border-brand/30 hover:bg-brand/5">
          <Icon name="bx:envelope" class="h-4 w-4" />
          <span>jaumetur3w@gmail.com</span>
        </a>

        <ul class="mt-6 flex items-center gap-2">
          {socialLinks.map((item) => (
            <li>
              <a
                href={item.path}
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-10 w-10 items-center justify-center rounded-2xl border border-white/[0.06] bg-white/[0.02] text-zinc-300 transition-all duration-300 hover:border-brand/30 hover:bg-brand/10 hover:text-brand hover:scale-110 active:scale-95"
                title={item.title}
                aria-label={item.title}
              >
                <Icon name={item.icon} class="h-4.5 w-4.5" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 2: Services -->
      <nav class="lg:col-span-4" aria-label={isEn ? "Services" : "Servicios"}>
        <h2 class="eyebrow">{isEn ? "Solutions" : "Soluciones"}</h2>
        <ul class="mt-5 space-y-2.5">
          {services.map((s) => (
            <li>
              <a href={to(`/pricing/${s.id}`)} class="text-sm text-zinc-300 hover:text-brand transition-all duration-300 flex items-center gap-2">
                <span class="h-px w-3 bg-brand/20 transition-all duration-300 group-hover:w-5 group-hover:bg-brand"></span>
                <span>{s.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Col 3: Navigation -->
      <nav class="lg:col-span-3" aria-label={isEn ? "Site" : "Sitio"}>
        <h2 class="eyebrow">{isEn ? "Navigate" : "Navegar"}</h2>
        <ul class="mt-5 space-y-2.5">
          {navLinks.map((item) => (
            <li>
              <a href={to(item.path)} class="text-sm text-zinc-300 hover:text-brand transition-all duration-300">
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <!-- Bottom bar -->
    <div class="mt-14 flex flex-col gap-4 border-t border-white/[0.04] pt-6 text-xs text-zinc-400 md:flex-row md:items-center md:justify-between">
      <p>© {currentYear} Jaume Tur · Xàtiva, Valencia</p>
      <nav aria-label={isEn ? "Legal" : "Legal"}>
        <ul class="flex flex-wrap gap-x-5 gap-y-1">
          {legalLinks.map((item) => (
            <li>
              <a href={to(item.path)} class="inline-flex min-h-8 items-center text-zinc-400 hover:text-white transition-all duration-300">{item.title}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>

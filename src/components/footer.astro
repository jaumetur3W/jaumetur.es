---
import { Icon } from "astro-icon/components";
import { localeFromPath, localizePath } from "@/i18n";
import { getServicesData } from "@/data/services";

const currentYear = new Date().getFullYear();
const locale = localeFromPath(Astro.url.pathname);
const isEn = locale === "en";
const withSlash = (path: string) => {
  const hashIndex = path.indexOf("#");
  const base = hashIndex < 0 ? path : path.slice(0, hashIndex);
  const hash = hashIndex < 0 ? "" : path.slice(hashIndex);
  return `${base === "/" || base.endsWith("/") ? base : `${base}/`}${hash}`;
};
const to = (path: string) => withSlash(localizePath(path, locale));

const services = getServicesData(locale);

const socialLinks = [
  { title: "Instagram", path: "https://www.instagram.com/jaume.www/", icon: "bx:bxl-instagram" },
  { title: "LinkedIn", path: "https://www.linkedin.com/in/jautur/", icon: "bx:bxl-linkedin" },
  { title: "GitHub", path: "https://github.com/jaumetur3W", icon: "bx:bxl-github" },
];

const navLinks = [
  { title: isEn ? "Services & pricing" : "Servicios y precios", path: "/pricing" },
  { title: isEn ? "Projects" : "Proyectos", path: "/projectes" },
  { title: isEn ? "About me" : "Sobre mí", path: "/about" },
  { title: isEn ? "Contact" : "Contacto", path: "/contact" },
];

const legalLinks = [
  { title: isEn ? "Privacy" : "Privacidad", path: "/privacidad" },
  { title: "Cookies", path: "/cookies" },
  { title: isEn ? "Legal notice" : "Aviso legal", path: "/aviso-legal" },
  { title: isEn ? "Quality & accessibility" : "Calidad y accesibilidad", path: "/qualitat" },
];
---

<footer class="on-dark mt-auto border-t border-white/10 bg-[#050507] text-white">
  <div class="mx-auto max-w-(--breakpoint-xl) px-4 pb-12 pt-16 sm:px-6 sm:pt-20">
    <div class="grid gap-12 lg:grid-cols-12">
      <!-- Columna 1: Identidad y Contacto Directo -->
      <div class="lg:col-span-5">
        <a href={to("/")} class="inline-flex items-center gap-3 rounded-xl focus:outline-none group" aria-label={isEn ? "Jaume Tur — home" : "Jaume Tur — inicio"}>
          <div class="flex h-11 w-11 items-center justify-center overflow-hidden rounded-xl border border-white/15 bg-white/5 transition-transform group-hover:scale-105 group-hover:border-brand/70">
            <img src="/img/jt.LOGO-02-128.webp" alt="Jaume Tur Logo" width="44" height="44" class="h-full w-full object-cover" loading="lazy" decoding="async" />
          </div>
          <span class="font-display text-2xl font-bold tracking-tight text-white">
            jaume<span class="text-brand">.www</span>
          </span>
        </a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/60">
          {isEn
            ? "High-performance websites, interactive menus and local SEO for businesses in Xàtiva, Valencia and remote across Spain."
            : "Desarrollo web a medida, cartas digitales interactivas y posicionamiento en Google Maps para negocios en Xàtiva, Valencia y toda España."}
        </p>

        <!-- Acreditación técnica oficial -->
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="inline-flex items-center rounded-md border border-brand/30 bg-brand/10 px-2.5 py-1 font-mono text-[0.7rem] font-bold text-brand">
            CFGS DAW
          </span>
          <span class="inline-flex items-center rounded-md border border-white/15 bg-white/5 px-2.5 py-1 font-mono text-[0.7rem] text-white/70">
            GM SMX
          </span>
        </div>

        <a href="mailto:jaumetur3w@gmail.com" class="mt-6 inline-flex items-center gap-2 font-mono text-sm font-semibold text-brand transition-colors hover:text-white">
          <Icon name="bx:envelope" class="h-4 w-4" />
          <span>jaumetur3w@gmail.com</span>
        </a>

        <ul class="mt-6 flex items-center gap-2.5">
          {socialLinks.map((item) => (
            <li>
              <a
                href={item.path}
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-9 w-9 items-center justify-center rounded-full border border-white/15 bg-white/[0.03] text-white/70 transition-all hover:border-brand hover:bg-brand hover:text-black hover:scale-105"
                title={item.title}
                aria-label={item.title}
              >
                <Icon name={item.icon} class="h-4 w-4" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 2: Servicios -->
      <nav class="lg:col-span-4" aria-label={isEn ? "Services" : "Servicios"}>
        <h2 class="font-mono text-xs font-bold uppercase tracking-wider text-brand">{isEn ? "Services & Solutions" : "Servicios y Soluciones"}</h2>
        <ul class="mt-4 space-y-2">
          {services.map((s) => (
            <li>
              <a href={to(`/pricing/${s.id}`)} class="text-xs text-white/70 hover:text-brand transition-colors flex items-center gap-1.5">
                <span class="text-brand/50">›</span>
                <span>{s.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Columna 3: Navegación y Legales -->
      <nav class="lg:col-span-3" aria-label={isEn ? "Site" : "Sitio"}>
        <h2 class="font-mono text-xs font-bold uppercase tracking-wider text-brand">{isEn ? "Navigation" : "Navegación"}</h2>
        <ul class="mt-4 space-y-2">
          {navLinks.map((item) => (
            <li>
              <a href={to(item.path)} class="text-xs text-white/70 hover:text-brand transition-colors">
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <!-- Barra inferior de copyright y ubicación -->
    <div class="mt-12 flex flex-col gap-4 border-t border-white/10 pt-6 text-xs text-white/50 md:flex-row md:items-center md:justify-between">
      <p>© {currentYear} Jaume Tur · {isEn ? "Xàtiva / Valencia, Spain & remote" : "Xàtiva / Valencia, España y remoto"}</p>
      <nav aria-label={isEn ? "Legal" : "Legal"}>
        <ul class="flex flex-wrap gap-x-5 gap-y-1">
          {legalLinks.map((item) => (
            <li>
              <a href={to(item.path)} class="inline-flex min-h-8 items-center text-white/45 hover:text-white transition-colors">{item.title}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>

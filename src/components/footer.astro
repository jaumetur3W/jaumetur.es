---
import Container from "./container.astro";
import { Icon } from "astro-icon/components";

const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-slate-200/80 bg-gradient-to-b from-white to-slate-50 py-12 text-slate-600">
  <Container>
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-slate-200/60">
      
      <!-- Logo + Memoji 6.png (Winking) -->
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5 group">
          <img
            src="/jt-logo-dark.png"
            alt="Logo Jaume Tur"
            class="w-9 h-9 rounded-full ring-2 ring-slate-900/10 group-hover:scale-105 transition"
            width="36"
            height="36"
          />
          <div>
            <span class="font-extrabold text-slate-900 text-sm block group-hover:text-indigo-600 transition-colors">
              Jaume Tur
            </span>
            <span class="text-[11px] text-slate-500 font-mono">
              Desenvolupador Web · Frontend
            </span>
          </div>
        </a>

        <!-- Guiding thread Memoji: 6.png (Winking Jaume) with transparent halo -->
        <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-purple-100 to-indigo-100 p-1 border border-indigo-200 shadow-2xs flex items-center justify-center ml-2" title="Gràcies per la visita!">
          <img
            src="/memojis/6.png"
            alt="Jaume picant l'ullet"
            class="w-full h-full object-contain"
            width="36"
            height="36"
          />
        </div>
      </div>

      <!-- Footer navigation -->
      <nav class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs font-semibold text-slate-600">
        <a href="/" class="hover:text-indigo-600 transition">Inici</a>
        <a href="/about" class="hover:text-indigo-600 transition">Sobre mi</a>
        <a href="/#projectes" class="hover:text-indigo-600 transition">Projectes</a>
        <a href="/#skills" class="hover:text-indigo-600 transition">Habilitats</a>
        <a href="/#metodologia" class="hover:text-indigo-600 transition">Metodologia</a>
        <a href="/pricing" class="hover:text-indigo-600 transition">Serveis</a>
        <a href="/blog" class="hover:text-indigo-600 transition">Blog</a>
        <a href="/contact" class="hover:text-indigo-600 transition">Contacte</a>
        <a
          href="/docs/CV_Jaume_tur.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="text-indigo-600 hover:text-indigo-800 transition font-mono font-bold">
          CV PDF ↗
        </a>
      </nav>

      <!-- Social Icons -->
      <div class="flex items-center gap-2.5">
        <a
          href="https://github.com/jautur"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-xl bg-slate-100 hover:bg-slate-900 hover:text-white transition text-slate-700 shadow-2xs"
          aria-label="GitHub">
          <Icon name="bx:bxl-github" class="w-4 h-4" />
        </a>
        <a
          href="https://www.linkedin.com/in/jautur/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-xl bg-blue-50 hover:bg-[#0A66C2] hover:text-white transition text-blue-600 shadow-2xs"
          aria-label="LinkedIn">
          <Icon name="bx:bxl-linkedin" class="w-4 h-4" />
        </a>
        <a
          href="mailto:jautursis@alu.edu.gva.es"
          class="p-2 rounded-xl bg-purple-50 hover:bg-purple-600 hover:text-white transition text-purple-600 shadow-2xs"
          aria-label="Correu">
          <Icon name="bx:bxs-envelope" class="w-4 h-4" />
        </a>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-6 text-[11px] text-slate-500 font-mono">
      <p>
        © {currentYear} Jaume Tur · Dissenyat amb Astro & Tailwind CSS
      </p>
      <div class="flex items-center gap-3">
        <span class="text-indigo-600 font-semibold">València, Espanya</span>
        <span>•</span>
        <a href="#top" class="hover:text-slate-900 transition flex items-center gap-1 font-bold">
          <span>Dalt</span>
          <span>↑</span>
        </a>
      </div>
    </div>
  </Container>
</footer>

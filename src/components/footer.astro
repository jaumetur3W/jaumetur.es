---
import Container from "./container.astro";
import { Icon } from "astro-icon/components";
import BuildStatus from "./build-status.astro";

const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-slate-200/90 bg-white py-12 text-slate-600">
  <Container>
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-slate-100">
      
      <!-- Logo + Memoji 6.png (Winking Jaume) -->
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-3 group">
          <div class="relative">
            <div class="absolute inset-0 bg-[#FFE600] rounded-2xl blur-xs opacity-50 group-hover:opacity-90 transition-opacity"></div>
            <img
              src="/img/jt.LOGO-02-128.webp"
              alt="Logo Jaume Tur"
              class="relative w-12 h-12 rounded-2xl shadow-xs group-hover:scale-105 transition object-cover ring-1 ring-slate-900/10"
              width="48"
              height="48"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="font-extrabold text-slate-900 text-base block group-hover:text-indigo-600 transition-colors">
                jaume
              </span>
              <span class="text-[11px] font-mono font-bold px-1.5 py-0.5 rounded bg-[#FFE600] text-slate-950">.www</span>
            </div>
            <span class="text-[11px] text-slate-500 font-mono">
              Backend &amp; Sistemes · Web Apps
            </span>
          </div>
        </a>

        <!-- Guiding thread Memoji: 6.webp (Winking Jaume) with interactive tooltip -->
        <div class="group/wink relative flex items-center justify-center cursor-pointer ml-1" title="Gràcies per la visita!">
          <div class="w-10 h-10 rounded-full bg-indigo-50 border border-indigo-200/70 p-1 shadow-2xs group-hover/wink:scale-110 transition-transform flex items-center justify-center">
            <img
              src="/img/6.webp"
              alt="Jaume Tur"
              class="w-full h-full object-contain"
              width="36"
              height="36"
            />
          </div>
          <span class="absolute -top-7 left-0 sm:left-1/2 sm:-translate-x-1/2 bg-slate-900 text-white text-[10px] font-mono px-2 py-0.5 rounded shadow whitespace-nowrap opacity-0 group-hover/wink:opacity-100 transition-opacity pointer-events-none">
            Gràcies per la visita!
          </span>
        </div>
      </div>

      <!-- Footer navigation -->
      <nav class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs font-semibold text-slate-600" aria-label="Enllaços secundaris">
        <a href="/" class="hover:text-indigo-600 transition">Inici</a>
        <a href="/about" class="hover:text-indigo-600 transition">Sobre mi</a>
        <a href="/#projectes" class="hover:text-indigo-600 transition">Projectes</a>
        <a href="/#skills" class="hover:text-indigo-600 transition">Habilitats</a>
        <a href="/tools/workflow-generator" class="hover:text-indigo-600 transition font-semibold text-indigo-700">Eines CI/CD</a>
        <a href="/uses" class="hover:text-indigo-600 transition">Setup (/uses)</a>
        <a href="/pricing" class="hover:text-indigo-600 transition">Serveis</a>
        <a href="/blog" class="hover:text-indigo-600 transition">Blog</a>
        <a href="/contact" class="hover:text-indigo-600 transition">Contacte</a>
        <a href="/marca" class="hover:text-indigo-600 transition font-semibold">Kit Marca</a>
        <a href="/card" class="hover:text-indigo-600 transition font-mono font-bold text-indigo-700">Targeta Digital</a>
        <a href="/qualitat" class="hover:text-emerald-600 transition font-mono font-bold text-emerald-600">Qualitat 100/100</a>
        <a href="/rss.xml" class="hover:text-indigo-600 transition font-mono">RSS Feed</a>
        <a
          href="/docs/CV_Jaume_tur.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-indigo-600 hover:text-indigo-800 transition font-mono font-bold">
          <Icon name="bx:file" class="w-3.5 h-3.5" />
          <span>CV PDF</span>
          <span class="text-[10px]">↗</span>
        </a>
      </nav>

      <!-- Social Icons with Standardized SVG Icons (Prioritat Tècnica: GitHub & LinkedIn) -->
      <div class="flex items-center gap-2.5">
        <a
          href="https://github.com/jautur"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-xl bg-slate-100 hover:bg-slate-900 hover:text-white transition text-slate-800 shadow-2xs group"
          title="GitHub de Jaume Tur (Codi i Repositoris)"
          aria-label="GitHub">
          <Icon name="bx:bxl-github" class="w-4 h-4 group-hover:scale-110 transition-transform" />
        </a>
        <a
          href="https://www.linkedin.com/in/jautur/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-xl bg-blue-50 hover:bg-[#0A66C2] hover:text-white transition text-blue-600 shadow-2xs group"
          title="LinkedIn de Jaume Tur (Perfil Professional)"
          aria-label="LinkedIn">
          <Icon name="bx:bxl-linkedin" class="w-4 h-4 group-hover:scale-110 transition-transform" />
        </a>
        <a
          href="mailto:jautursis@alu.edu.gva.es"
          class="p-2 rounded-xl bg-purple-50 hover:bg-purple-600 hover:text-white transition text-purple-600 shadow-2xs group"
          title="Enviar correu electrònic a Jaume Tur"
          aria-label="Correu">
          <Icon name="bx:envelope" class="w-4 h-4 group-hover:scale-110 transition-transform" />
        </a>
        <a
          href="https://www.instagram.com/jaume.www/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-xl bg-slate-50 hover:bg-amber-100/80 hover:text-amber-800 transition text-slate-400 shadow-2xs group"
          title="Instagram (@jaume.www)"
          aria-label="Instagram">
          <Icon name="bx:bxl-instagram" class="w-4 h-4 group-hover:scale-110 transition-transform" />
        </a>
      </div>
    </div>

    <!-- Bottom credits with Live CI/CD Status Pill -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 text-[11px] text-slate-500 font-mono">
      <div class="flex items-center gap-3 flex-wrap justify-center sm:justify-start">
        <BuildStatus variant="pill" />
        <p class="flex items-center gap-1.5 flex-wrap">
          <span>© {currentYear} Jaume Tur</span>
          <span>·</span>
          <span>Fet amb</span>
          <Icon name="simple-icons:astro" class="w-3.5 h-3.5 text-orange-500" />
          <span>Astro &</span>
          <Icon name="simple-icons:tailwindcss" class="w-3.5 h-3.5 text-cyan-500" />
          <span>Tailwind CSS</span>
        </p>
      </div>
      
      <div class="flex items-center gap-3">
        <span class="text-indigo-600 font-semibold flex items-center gap-1">
          <Icon name="bx:map-pin" class="w-3.5 h-3.5 text-indigo-600" />
          <span>València, Espanya</span>
        </span>
        <span>•</span>
        <a href="#top" class="hover:text-slate-900 transition flex items-center gap-1 font-bold group">
          <Icon name="bx:up-arrow-alt" class="w-3.5 h-3.5 group-hover:-translate-y-0.5 transition-transform" />
          <span>Dalt</span>
          <span>↑</span>
        </a>
      </div>
    </div>
  </Container>
</footer>

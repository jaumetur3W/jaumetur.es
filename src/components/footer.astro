---
import Container from "./container.astro";
import { Icon } from "astro-icon/components";
import { localeFromPath, localizePath } from "@/i18n";

const currentYear = new Date().getFullYear();
const locale = localeFromPath(Astro.url.pathname);
const isEn = locale === "en";
const href = (path: string) =>
  path.startsWith("/") && !path.startsWith("/docs/") ? localizePath(path, locale) : path;

const canonicalPagePath = (path: string) => {
  const suffixIndex = path.search(/[?#]/);
  const pathname = suffixIndex < 0 ? path : path.slice(0, suffixIndex);
  const suffix = suffixIndex < 0 ? "" : path.slice(suffixIndex);
  return pathname === "/" || pathname.endsWith("/") ? path : `${pathname}/${suffix}`;
};

const localized = (path: string) => canonicalPagePath(href(path));

const socialLinks = [
  { title: "GitHub", path: "https://github.com/jaumetur3W", icon: "bx:bxl-github", external: true },
  { title: "LinkedIn", path: "https://www.linkedin.com/in/jautur/", icon: "bx:bxl-linkedin", external: true },
  { title: "Instagram", path: "https://www.instagram.com/jaume.www/", icon: "bx:bxl-instagram", external: true },
  { title: isEn ? "Email" : "Correo", path: "mailto:jaumetur3w@gmail.com", icon: "bx:envelope", external: false },
];

const legalLinks = [
  { title: isEn ? "Privacy" : "Privacidad", path: "/privacidad" },
  { title: isEn ? "Cookies" : "Cookies", path: "/cookies" },
  { title: isEn ? "Legal notice" : "Aviso legal", path: "/aviso-legal" },
  { title: isEn ? "Accessibility" : "Accesibilidad", path: "/qualitat" },
  { title: "RSS", path: "/rss.xml", external: false },
];
---

<footer class="mt-20 border-t border-slate-200/80 bg-white py-12 text-slate-600">
  <Container>
    <div class="flex flex-col items-center text-center max-w-xl mx-auto">
      
      <!-- Nombre de cabecera -->
      <a
        href={localized("/")}
        class="inline-block group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00] rounded"
        title={isEn ? "Jaume Tur — Home" : "Jaume Tur — Inicio"}
      >
        <span class="text-xl sm:text-2xl font-bold tracking-tight text-slate-950 group-hover:text-slate-700 transition-colors">
          Jaume Tur.
        </span>
      </a>

      <!-- Descriptor -->
      <p class="text-xs sm:text-sm text-slate-600 font-light mt-1.5">
        {isEn ? "Web development · Applications · Automation" : "Desarrollo web · Aplicaciones · Automatización"}
      </p>

      <!-- Iconos de Redes y Contacto -->
      <div class="flex items-center justify-center gap-5 sm:gap-6 mt-4">
        {socialLinks.map((item) => (
          <a
            href={item.path}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
            class="text-slate-700 hover:text-slate-950 transition-all hover:scale-110 p-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00] rounded-lg"
            title={item.title}
            aria-label={item.title}
          >
            <Icon name={item.icon} class="w-5 h-5" />
          </a>
        ))}
      </div>

      <!-- Línea divisoria sutil -->
      <div class="w-full border-t border-slate-200/80 my-7"></div>

      <!-- Enlaces legales y de estándares -->
      <nav aria-label={isEn ? "Legal and standards" : "Legal y estándares"} class="w-full">
        <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-slate-600 font-medium">
          {legalLinks.map((item) => (
            <li>
              <a
                href={item.path.endsWith(".xml") ? item.path : localized(item.path)}
                class="hover:text-slate-950 hover:underline decoration-slate-300 hover:decoration-slate-950 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00] rounded py-0.5"
              >
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Copyright y ubicación -->
      <p class="mt-4 text-xs text-slate-500 font-light">
        © {currentYear} Jaume Tur · {isEn ? "Valencia, Spain & remote" : "Valencia, España y remoto"}
      </p>

    </div>
  </Container>
</footer>

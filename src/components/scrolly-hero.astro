---
import { localizePath } from "@/i18n";

export interface Props {
  isEn?: boolean;
}

const { isEn = false } = Astro.props;
const href = (path: string) => localizePath(path, isEn ? "en" : "es");

const copy = isEn
  ? {
      greeting: "Hello",
      comma: ",",
      intro: "I'm",
      firstName: "Jaume",
      lastName: "Tur",
      statement: "Web developer focused on performance, clean design, and well-crafted code.",
      seoText: "Hello, I'm Jaume Tur. Web developer, backend and digital solutions in Valencia.",
    }
  : {
      greeting: "Hola",
      comma: ",",
      intro: "soy",
      firstName: "Jaume",
      lastName: "Tur",
      statement: "Desarrollador web centrado en rendimiento, diseño limpio y código bien construido.",
      seoText: "Hola, soy Jaume Tur. Desarrollador web, backend y soluciones digitales en Valencia.",
    };
---

<!-- Scrollytelling Hero: Animació per paraules completes i independents -->
<section
  id="scrolly-hero"
  aria-label={isEn ? "Presentation of Jaume Tur" : "Presentación de Jaume Tur"}
  class="scrolly-track relative w-full bg-white text-slate-900 selection:bg-[#FFFF00] selection:text-black overflow-x-clip"
>
  <!-- Sticky Stage Viewport: Ejemplo 3 - Inicio con fondo negro y Hola en amarillo, transición a blanco y negro -->
  <div
    id="scrolly-stage"
    class="scrolly-stage hero-intro-dark sticky top-[56px] z-10 w-full overflow-hidden flex flex-col justify-center items-center px-4 sm:px-8"
  >
    <div id="hero-type-container" class="relative w-full max-w-5xl mx-auto flex flex-col items-center text-center select-none">
      
      <!-- Único H1 principal de la página: Accesible para SEO desde el primer render -->
      <h1
        id="hero-main-heading"
        class="font-sans font-normal tracking-tight text-slate-950 text-[clamp(1.85rem,7vw,3.5rem)] sm:text-[clamp(3rem,8vw,5.5rem)] md:text-[clamp(3.8rem,8.5vw,7rem)] leading-[1.08]"
      >
        <!-- Texto completo para motores de búsqueda y lectores de pantalla (Accessible SEO) -->
        <span class="sr-only">
          {copy.seoText}{" "}
          <a href={href("/about")} class="underline hover:text-black">
            {isEn ? "About Jaume Tur — More information" : "Sobre Jaume Tur — Más información"}
          </a>
        </span>

        <!-- Composición visual tipográfica: Palabras completas e independientes -->
        <span
          aria-hidden="true"
          id="hero-phrase"
          class="inline-flex items-center justify-center whitespace-nowrap will-change-transform text-center"
        >
          <span
            id="token-hola"
            class="word-token token-word inline-block font-bold opacity-100 will-change-[transform,opacity]"
          >{copy.greeting}</span><span
            id="token-comma"
            class="word-token token-word inline-block font-normal text-slate-950 opacity-0 will-change-[opacity]"
          >{copy.comma}&nbsp;</span><span
            id="token-soy"
            class="word-token token-word inline-block font-normal text-slate-950 opacity-0 will-change-[transform,opacity]"
          >{copy.intro}&nbsp;</span><a
            id="hero-name-link"
            href={href("/about")}
            tabindex="-1"
            aria-hidden="true"
            class="inline-flex items-center font-normal text-slate-950 hover:text-black focus-visible:outline-none rounded transition-colors pointer-events-none"
            aria-label={isEn ? "About Jaume Tur — More information" : "Sobre Jaume Tur — Más información"}
          ><span
              id="token-jaume"
              class="word-token token-word inline-block font-normal text-slate-950 opacity-0 will-change-[transform,opacity]"
            >{copy.firstName}&nbsp;</span><span
              id="token-tur"
              class="word-token token-word inline-block font-normal text-slate-950 opacity-0 will-change-[transform,opacity]"
            >{copy.lastName}</span></a>
        </span>
      </h1>

      <!-- Presentación personal breve: se revela en el estado 5 (80-100%) -->
      <div
        id="hero-statement"
        class="mt-8 sm:mt-12 max-w-2xl mx-auto opacity-0 translate-y-4 pointer-events-none will-change-[transform,opacity]"
      >
        <p class="font-sans text-[clamp(1.15rem,2.8vw,1.85rem)] font-light text-slate-700 tracking-tight leading-relaxed">
          {copy.statement}
        </p>
      </div>

    </div>
  </div>
</section>

<style>
  /* Altura calibrada para los 5 estados progresivos y el recorrido del telón que sube a cubrir la presentación */
  .scrolly-track {
    height: 260vh;
  }
  @media (max-width: 640px) {
    .scrolly-track {
      height: 240vh;
    }
  }

  .scrolly-stage {
    height: calc(100vh - 56px);
    height: calc(100dvh - 56px);
    background-color: #ffffff;
    transition: background-color 750ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Ejemplo 3: Entrada con fondo negro azabache y Hola en amarillo */
  .scrolly-stage.hero-intro-dark {
    background-color: #09090b !important;
  }

  /* Garantía tipográfica de peso bold en «Hola» y peso normal en el resto */
  #token-hola {
    font-weight: 700 !important;
    color: #020617;
    transition: color 750ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scrolly-stage.hero-intro-dark #token-hola {
    color: #FFFF00 !important;
  }
  #token-comma,
  #token-soy,
  #token-jaume,
  #token-tur {
    font-weight: 400 !important;
  }

  /* Modo accesible para preferencias de movimiento reducido */
  @media (prefers-reduced-motion: reduce) {
    .scrolly-stage.hero-intro-dark {
      background-color: #ffffff !important;
    }
    .scrolly-stage.hero-intro-dark #token-hola {
      color: #020617 !important;
    }
    .scrolly-track {
      height: auto !important;
      padding-top: 3.5rem;
      padding-bottom: 4rem;
    }
    .scrolly-stage {
      position: relative !important;
      top: auto !important;
      height: auto !important;
      overflow: visible !important;
    }
    #hero-phrase {
      transform: none !important;
    }
    .word-token {
      opacity: 1 !important;
      transform: none !important;
    }
    #hero-name-link {
      pointer-events: auto !important;
    }
    #hero-statement {
      opacity: 1 !important;
      transform: none !important;
      pointer-events: auto !important;
    }
  }
</style>

<script is:inline>
  (function () {
    // Ejemplo 3: Sincronización del navbar con el inicio en fondo negro
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const siteNavbar = document.getElementById("site-navbar-wrap");
      if (siteNavbar) {
        siteNavbar.classList.add("hero-intro-dark");
      }
    }

    function initHeroScrollytelling() {
      const track = document.getElementById("scrolly-hero");
      const stage = document.getElementById("scrolly-stage");
      const siteNavbar = document.getElementById("site-navbar-wrap");
      const phrase = document.getElementById("hero-phrase");
      const tokenHola = document.getElementById("token-hola");
      const tokenComma = document.getElementById("token-comma");
      const tokenSoy = document.getElementById("token-soy");
      const tokenJaume = document.getElementById("token-jaume");
      const tokenTur = document.getElementById("token-tur");
      const nameLink = document.getElementById("hero-name-link");
      const statement = document.getElementById("hero-statement");
      const container = document.getElementById("hero-type-container");

      if (
        !track ||
        !stage ||
        !phrase ||
        !tokenHola ||
        !tokenComma ||
        !tokenSoy ||
        !tokenJaume ||
        !tokenTur ||
        !statement ||
        !container
      ) {
        return;
      }

      // Desactivar el estado intro negro/amarillo hacia blanco/negro de forma suave (únicamente al scrollear)
      let introExited = false;
      function exitIntro() {
        if (introExited) return;
        introExited = true;
        stage.classList.remove("hero-intro-dark");
        if (siteNavbar) siteNavbar.classList.remove("hero-intro-dark");
      }

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        exitIntro();
      } else {
        if (window.scrollY > 20) {
          exitIntro();
        } else {
          const onScrollAction = () => {
            exitIntro();
          };

          window.addEventListener("wheel", onScrollAction, { once: true, passive: true });
          window.addEventListener("touchmove", onScrollAction, { once: true, passive: true });
          window.addEventListener("scroll", onScrollAction, { once: true, passive: true });
        }
      }

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      if (prefersReducedMotion.matches) return;

      // Offsets para centrar exactamente cada estado tipográfico (píxeles relativos al centro)
      let offset1 = 0; // Centra «Hola»
      let offset2 = 0; // Centra «Hola, soy»
      let offset3 = 0; // Centra «Hola, soy Jaume»
      let offset4 = 0; // Centra «Hola, soy Jaume Tur»

      let cachedTrackTop = 0;
      let cachedTrackHeight = 0;
      let cachedViewportHeight = window.innerHeight;

      function measureOffsets() {
        cachedViewportHeight = window.innerHeight;
        cachedTrackHeight = track.offsetHeight;
        const trackRect = track.getBoundingClientRect();
        cachedTrackTop = window.scrollY + trackRect.top;

        const containerRect = container.getBoundingClientRect();
        const containerCenter = containerRect.left + containerRect.width / 2;
        const phraseTransformX = new DOMMatrixReadOnly(
          window.getComputedStyle(phrase).transform
        ).m41;

        // Medir coordenadas respecto al origen sin transformar, sin alterar transform actual (cero parpadeo ni reflow)
        const holaRect = tokenHola.getBoundingClientRect();
        const soyRect = tokenSoy.getBoundingClientRect();
        const jaumeRect = tokenJaume.getBoundingClientRect();
        const turRect = tokenTur.getBoundingClientRect();

        const unshiftedHolaLeft = holaRect.left - phraseTransformX;
        const unshiftedHolaWidth = holaRect.width;
        const unshiftedHolaCenter = unshiftedHolaLeft + unshiftedHolaWidth / 2;

        const unshiftedSoyRight = soyRect.right - phraseTransformX;
        const unshiftedJaumeRight = jaumeRect.right - phraseTransformX;
        const unshiftedTurRight = turRect.right - phraseTransformX;

        // 1. Centro de «Hola»
        offset1 = containerCenter - unshiftedHolaCenter;

        // 2. Centro de «Hola, soy»
        const holaSoyCenter = (unshiftedHolaLeft + unshiftedSoyRight) / 2;
        offset2 = containerCenter - holaSoyCenter;

        // 3. Centro de «Hola, soy Jaume»
        const holaJaumeCenter = (unshiftedHolaLeft + unshiftedJaumeRight) / 2;
        offset3 = containerCenter - holaJaumeCenter;

        // 4. Centro de «Hola, soy Jaume Tur»
        const holaTurCenter = (unshiftedHolaLeft + unshiftedTurRight) / 2;
        offset4 = containerCenter - holaTurCenter;

      }

      const stepCount = 5;
      const transitionDuration = 460;
      const wheelQuietPeriod = 220;
      const touchThreshold = 40;
      let activeStep = 0;
      let isAnimating = false;
      let pendingDirections = [];
      let wheelGestureActive = false;
      let wheelQuietTimer = 0;
      let touchStartY = 0;
      let touchStartX = 0;
      let touchHandled = false;

      function renderStep(step, immediate = false) {
        const currentOffset = step <= 0 ? offset1 : step === 1 ? offset2 : step === 2 ? offset3 : offset4;
        const soyVisible = step >= 1;
        const jaumeVisible = step >= 2;
        const turVisible = step >= 3;
        const statementVisible = step >= 4;

        phrase.style.transition = immediate
          ? "none"
          : `transform ${transitionDuration}ms cubic-bezier(0.22, 1, 0.36, 1)`;
        phrase.style.transform = `translate3d(${currentOffset.toFixed(2)}px, 0, 0)`;

        const animatedTokens = [tokenHola, tokenComma, tokenSoy, tokenJaume, tokenTur];
        animatedTokens.forEach((token) => {
          token.style.transition = immediate
            ? "none"
            : `opacity ${transitionDuration}ms cubic-bezier(0.22, 1, 0.36, 1), transform ${transitionDuration}ms cubic-bezier(0.22, 1, 0.36, 1)`;
        });

        // «Hola» se ve obligatoriamente en todo momento desde la carga inicial
        tokenHola.style.opacity = "1";
        tokenHola.style.transform = "translate3d(0, 0, 0)";

        const soyTranslateY = soyVisible ? 0 : 12;
        tokenComma.style.opacity = soyVisible ? "1" : "0";
        tokenSoy.style.opacity = soyVisible ? "1" : "0";
        tokenSoy.style.transform = `translate3d(0, ${soyTranslateY}px, 0)`;

        const jaumeTranslateY = jaumeVisible ? 0 : 12;
        tokenJaume.style.opacity = jaumeVisible ? "1" : "0";
        tokenJaume.style.transform = `translate3d(0, ${jaumeTranslateY}px, 0)`;

        const turTranslateY = turVisible ? 0 : 12;
        tokenTur.style.opacity = turVisible ? "1" : "0";
        tokenTur.style.transform = `translate3d(0, ${turTranslateY}px, 0)`;

        if (nameLink) {
          nameLink.style.pointerEvents = turVisible ? "auto" : "none";
        }

        statement.style.transition = immediate
          ? "none"
          : `opacity ${transitionDuration}ms cubic-bezier(0.22, 1, 0.36, 1), transform ${transitionDuration}ms cubic-bezier(0.22, 1, 0.36, 1)`;
        statement.style.opacity = statementVisible ? "1" : "0";
        statement.style.transform = `translate3d(0, ${statementVisible ? 0 : 16}px, 0)`;
        statement.style.pointerEvents = statementVisible ? "auto" : "none";
      }

      function isTrackActive() {
        const rect = track.getBoundingClientRect();
        return rect.top < window.innerHeight && rect.bottom > 56;
      }

      function canQueueStep(direction) {
        const lastQueuedStep = pendingDirections.length
          ? activeStep + pendingDirections.reduce((total, queued) => total + queued, 0)
          : activeStep;
        const nextStep = lastQueuedStep + direction;
        return nextStep >= 0 && nextStep < stepCount;
      }

      function scrollToStep(step) {
        const scrollableDistance = Math.max(0, cachedTrackHeight - cachedViewportHeight);
        // Los pasos 0-4 ocupan el primer 48% del track.
        // El 52% restante permite al telón (#home-curtain) subir y cubrir el texto estático.
        const progress = step <= 0 ? 0 : step === 1 ? 0.12 : step === 2 ? 0.24 : step === 3 ? 0.36 : 0.48;
        const target = cachedTrackTop + scrollableDistance * progress;
        window.scrollTo({ top: target, behavior: "instant" });
      }

      function startStep(direction) {
        exitIntro();
        const nextStep = activeStep + direction;
        if (nextStep < 0 || nextStep >= stepCount) return;

        activeStep = nextStep;
        isAnimating = true;
        renderStep(activeStep);
        scrollToStep(activeStep);

        window.setTimeout(() => {
          isAnimating = false;
          if (pendingDirections.length > 0) {
            startStep(pendingDirections.shift());
          }
        }, transitionDuration);
      }

      function queueStep(direction) {
        if (!canQueueStep(direction)) return;
        if (isAnimating) {
          pendingDirections.push(direction);
          return;
        }
        startStep(direction);
      }

      function onWheel(event) {
        if (event.deltaY === 0 || !isTrackActive()) return;
        const direction = event.deltaY > 0 ? 1 : -1;
        if (!wheelGestureActive && !canQueueStep(direction)) return;

        event.preventDefault();
        if (!wheelGestureActive) {
          wheelGestureActive = true;
          queueStep(direction);
        }
        window.clearTimeout(wheelQuietTimer);
        wheelQuietTimer = window.setTimeout(() => {
          wheelGestureActive = false;
        }, wheelQuietPeriod);
      }

      function onTouchStart(event) {
        if (!isTrackActive() || event.touches.length !== 1) return;
        touchStartY = event.touches[0].clientY;
        touchStartX = event.touches[0].clientX;
        touchHandled = false;
      }

      function onTouchMove(event) {
        if (event.touches.length !== 1 || !isTrackActive()) return;
        if (touchHandled) {
          event.preventDefault();
          return;
        }

        const deltaY = touchStartY - event.touches[0].clientY;
        const deltaX = touchStartX - event.touches[0].clientX;
        if (Math.abs(deltaY) < touchThreshold || Math.abs(deltaY) < Math.abs(deltaX)) return;

        const direction = deltaY > 0 ? 1 : -1;
        if (!canQueueStep(direction)) return;

        event.preventDefault();
        touchHandled = true;
        queueStep(direction);
      }

      function onTouchEnd() {
        touchHandled = false;
      }

      measureOffsets();
      renderStep(activeStep, true);

      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(() => {
          requestAnimationFrame(() => {
            measureOffsets();
            renderStep(activeStep, true);
          });
        });
      } else {
        requestAnimationFrame(() => {
          measureOffsets();
          renderStep(activeStep, true);
        });
      }

      let lastWidth = window.innerWidth;
      let lastHeight = window.innerHeight;
      window.addEventListener("wheel", onWheel, { passive: false });
      window.addEventListener("touchstart", onTouchStart, { passive: true });
      window.addEventListener("touchmove", onTouchMove, { passive: false });
      window.addEventListener("touchend", onTouchEnd, { passive: true });
      window.addEventListener(
        "resize",
        () => {
          if (window.innerWidth !== lastWidth || window.innerHeight !== lastHeight) {
            lastWidth = window.innerWidth;
            lastHeight = window.innerHeight;
            measureOffsets();
            renderStep(activeStep, true);
          }
        },
        { passive: true }
      );
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initHeroScrollytelling);
    } else {
      initHeroScrollytelling();
    }
  })();
</script>

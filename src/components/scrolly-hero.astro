---
import { localizePath } from "@/i18n";

export interface Props {
  isEn?: boolean;
}

const { isEn = false } = Astro.props;
const href = (path: string) => localizePath(path, isEn ? "en" : "es");

const copy = isEn
  ? {
      greeting: "Hello",
      comma: ",",
      intro: "I'm",
      firstName: "Jaume",
      lastName: "Tur",
      statement: "Web developer focused on performance, clean design, and well-crafted code.",
      seoText: "Hello, I'm Jaume Tur. Web developer, backend and digital solutions in Valencia.",
    }
  : {
      greeting: "Hola",
      comma: ",",
      intro: "soy",
      firstName: "Jaume",
      lastName: "Tur",
      statement: "Desarrollador web centrado en rendimiento, diseño limpio y código bien construido.",
      seoText: "Hola, soy Jaume Tur. Desarrollador web, backend y soluciones digitales en Valencia.",
    };

const greetingText = copy.greeting;
const oIdx = greetingText.indexOf("o");
const greetingBeforeO = oIdx !== -1 ? greetingText.slice(0, oIdx) : greetingText;
const greetingAfterO = oIdx !== -1 ? greetingText.slice(oIdx + 1) : "";
---

<!-- Scrollytelling Hero: Animació per paraules completes i independents -->
<section
  id="scrolly-hero"
  aria-label={isEn ? "Presentation of Jaume Tur" : "Presentación de Jaume Tur"}
  class="scrolly-track relative w-full bg-white text-slate-900 selection:bg-[#FFFF00] selection:text-black overflow-x-clip"
>
  <!-- Sticky Stage Viewport: Ejemplo 3 - Inicio con fondo negro y Hola en amarillo, transición a blanco y negro -->
  <div
    id="scrolly-stage"
    class="scrolly-stage hero-intro-dark sticky top-[56px] z-10 w-full overflow-hidden flex flex-col justify-center items-center px-4 sm:px-8"
  >
    <!-- Efecte Forat Negre: absorbeix tot el fons negre cap al centre de la «o» -->
    <div id="hero-black-hole" class="hero-black-hole" aria-hidden="true">
      <div class="hero-hole-distortion" aria-hidden="true"></div>
    </div>

    <!-- Atmósfera volumétrica: fum dinàmic i degradats eteris subtils -->
    <div class="hero-volumetric-smoke" aria-hidden="true">
      <div class="smoke-nebula smoke-nebula-primary"></div>
      <div class="smoke-nebula smoke-nebula-accent"></div>
      <div class="smoke-nebula smoke-nebula-depth"></div>
    </div>

    <!-- Partícules cinètiques flotants (punts en moviment, micro-connexions) -->
    <canvas id="hero-particles-canvas" class="hero-particles-canvas" aria-hidden="true"></canvas>

    <!-- Aura luminosa ambiental en modo oscuro -->
    <div id="hero-glow-aura" class="hero-glow-aura" aria-hidden="true"></div>

    <!-- Horitzó lluminós previ al teló: pols de llum dinàmic que convida a descobrir -->
    <div id="hero-curtain-horizon" class="hero-curtain-horizon" aria-hidden="true">
      <div class="horizon-radiance"></div>
      <div class="horizon-pulse-line"></div>
    </div>

    <div id="hero-type-container" class="relative z-10 w-full max-w-5xl mx-auto flex flex-col items-center text-center select-none">
      
      <!-- Único H1 principal de la página: Accesible para SEO desde el primer render -->
      <h1
        id="hero-main-heading"
        class="font-sans font-normal tracking-tight text-slate-950 text-[clamp(1.85rem,7vw,3.5rem)] sm:text-[clamp(3rem,8vw,5.5rem)] md:text-[clamp(3.8rem,8.5vw,7rem)] leading-[1.08]"
      >
        <!-- Texto completo para motores de búsqueda y lectores de pantalla (Accessible SEO) -->
        <span class="sr-only">
          {copy.seoText}{" "}
          <a href={href("/about")} class="underline hover:text-black">
            {isEn ? "About Jaume Tur — More information" : "Sobre Jaume Tur — Más información"}
          </a>
        </span>

        <!-- Composición visual tipográfica: Palabras completas e independientes -->
        <span
          aria-hidden="true"
          id="hero-phrase"
          class="inline-flex items-center justify-center whitespace-nowrap will-change-transform text-center"
        >
          <span
            id="token-hola"
            class="word-token token-word inline-block font-bold opacity-100 will-change-[transform,opacity]"
          >{greetingBeforeO}<span id="letter-o" class="relative inline-block">o<span class="hole-singularity" aria-hidden="true"><span class="hole-accretion-ring"></span></span></span>{greetingAfterO}</span><span
            id="token-comma"
            class="word-token token-word inline-block font-normal text-slate-950 opacity-0 will-change-[opacity]"
          >{copy.comma}&nbsp;</span><span
            id="token-soy"
            class="word-token token-word inline-block font-normal text-slate-950 opacity-0 will-change-[transform,opacity]"
          >{copy.intro}&nbsp;</span><a
            id="hero-name-link"
            href={href("/about")}
            tabindex="-1"
            aria-hidden="true"
            class="inline-flex items-center font-normal text-slate-950 hover:text-black focus-visible:outline-none rounded transition-colors pointer-events-none"
            aria-label={isEn ? "About Jaume Tur — More information" : "Sobre Jaume Tur — Más información"}
          ><span
              id="token-jaume"
              class="word-token token-word inline-block font-normal text-slate-950 opacity-0 will-change-[transform,opacity]"
            >{copy.firstName}&nbsp;</span><span
              id="token-tur"
              class="word-token token-word inline-block font-normal text-slate-950 opacity-0 will-change-[transform,opacity]"
            >{copy.lastName}</span></a>
        </span>
      </h1>

      <!-- Presentación personal breve: se revela en el estado 3 -->
      <div
        id="hero-statement"
        class="mt-8 sm:mt-12 max-w-2xl mx-auto opacity-0 translate-y-4 pointer-events-none will-change-[transform,opacity]"
      >
        <p class="font-sans text-[clamp(1.15rem,2.8vw,1.85rem)] font-light text-slate-700 tracking-tight leading-relaxed">
          {copy.statement}
        </p>
      </div>

    </div>

    <!-- Indicador de scroll animado al inicio -->
    <div
      id="hero-scroll-cue"
      class="hero-scroll-cue absolute bottom-5 sm:bottom-7 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1.5 pointer-events-none select-none z-10"
      aria-hidden="true"
    >
      <span class="text-[10px] sm:text-[11px] font-mono uppercase tracking-[0.22em] text-slate-400 font-medium cue-label">
        {isEn ? "Scroll" : "Scroll"}
      </span>
      <div class="w-4 h-7 rounded-full border border-slate-600/70 flex items-start justify-center p-1 cue-pill">
        <div class="w-1 h-1.5 rounded-full bg-[#FFFF00] cue-dot"></div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Altura calibrada para los 3 estados progresivos y el recorrido del telón sin tapar el texto inferior */
  .scrolly-track {
    height: 250vh;
  }
  @media (max-width: 640px) {
    .scrolly-track {
      height: 230vh;
    }
  }

  .scrolly-stage {
    height: calc(100vh - 56px);
    height: calc(100dvh - 56px);
    background-color: #ffffff;
    --hole-x: 50%;
    --hole-y: 50%;
  }

  /* Efecto Forat Negre cinematográfico centrado en la letra 'o' de «Hola» */
  .hero-black-hole {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background: radial-gradient(
      circle at var(--hole-x, 50%) var(--hole-y, 50%),
      #040507 0%,
      #07080b 40%,
      #09090b 80%,
      #0d0e14 100%
    );
    clip-path: circle(0px at var(--hole-x, 50%) var(--hole-y, 50%));
    transition: clip-path 230ms cubic-bezier(0.7, 0, 0.2, 1);
    will-change: clip-path;
  }

  .scrolly-stage.hero-intro-dark .hero-black-hole {
    clip-path: circle(160vmax at var(--hole-x, 50%) var(--hole-y, 50%));
  }

  .hero-hole-distortion {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at var(--hole-x, 50%) var(--hole-y, 50%),
      transparent 0%,
      rgba(255, 255, 0, 0.03) 30%,
      transparent 60%
    );
    pointer-events: none;
  }

  /* Singularity y disco de acreción en el centro de la 'o' */
  #letter-o {
    display: inline-block;
    vertical-align: baseline;
    position: relative;
  }

  .hole-singularity {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hole-accretion-ring {
    position: absolute;
    width: 130%;
    height: 130%;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 0, 0.45);
    box-shadow: 0 0 14px rgba(255, 255, 0, 0.35), inset 0 0 8px rgba(255, 255, 0, 0.2);
    opacity: 0;
    transform: scale(0.4) rotate(0deg);
    transition: opacity 180ms ease, transform 230ms cubic-bezier(0.7, 0, 0.2, 1);
    will-change: transform, opacity;
  }

  .scrolly-stage.hero-intro-dark .hole-accretion-ring {
    opacity: 1;
    transform: scale(1) rotate(0deg);
    animation: accretionSpin 9s linear infinite;
  }

  @keyframes accretionSpin {
    0% {
      transform: scale(1) rotate(0deg);
    }
    100% {
      transform: scale(1) rotate(360deg);
    }
  }

  /* Aura luminosa ambiental en modo oscuro */
  .hero-glow-aura {
    position: absolute;
    top: var(--hole-y, 50%);
    left: var(--hole-x, 50%);
    width: clamp(260px, 44vw, 480px);
    height: clamp(260px, 44vw, 480px);
    transform: translate(-50%, -50%) scale(1.35);
    background: radial-gradient(circle, rgba(255, 255, 0, 0.16) 0%, rgba(255, 255, 0, 0.04) 45%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
    filter: blur(52px);
    opacity: 0;
    z-index: 2;
    transition: opacity 190ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 230ms cubic-bezier(0.16, 1, 0.3, 1),
                filter 190ms ease;
  }

  .scrolly-stage.hero-intro-dark .hero-glow-aura {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    animation: heroAuraPulse 3.5s ease-in-out infinite alternate;
  }

  @keyframes heroAuraPulse {
    0% { transform: translate(-50%, -50%) scale(0.92); opacity: 0.68; }
    100% { transform: translate(-50%, -50%) scale(1.08); opacity: 0.95; }
  }

  /* Atmósfera volumétrica con humo sutil y gradientes orgánicos */
  .hero-volumetric-smoke {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 2;
    contain: strict;
  }

  .smoke-nebula {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.45;
    will-change: transform, opacity;
    pointer-events: none;
  }

  /* Capa 1: Resplandor ambarino/dorado tenue #FFFF00 */
  .smoke-nebula-primary {
    top: 25%;
    left: 20%;
    width: clamp(320px, 55vw, 680px);
    height: clamp(320px, 55vw, 680px);
    background: radial-gradient(circle, rgba(255, 255, 0, 0.08) 0%, rgba(255, 255, 0, 0.02) 50%, transparent 70%);
    animation: smokeDriftPrimary 22s ease-in-out infinite alternate;
  }

  /* Capa 2: Bruma etérea pizarra/índigo */
  .smoke-nebula-accent {
    bottom: 15%;
    right: 15%;
    width: clamp(350px, 60vw, 720px);
    height: clamp(350px, 60vw, 720px);
    background: radial-gradient(circle, rgba(99, 102, 241, 0.05) 0%, rgba(148, 163, 184, 0.03) 45%, transparent 75%);
    animation: smokeDriftAccent 28s ease-in-out infinite alternate;
  }

  /* Capa 3: Profundidad atmosférica central */
  .smoke-nebula-depth {
    top: 45%;
    left: 50%;
    width: clamp(400px, 70vw, 840px);
    height: clamp(300px, 50vw, 600px);
    transform: translate(-50%, -50%);
    background: radial-gradient(ellipse, rgba(255, 255, 0, 0.04) 0%, rgba(15, 23, 42, 0.03) 55%, transparent 70%);
    animation: smokeDriftDepth 18s ease-in-out infinite alternate;
  }

  /* En modo oscuro inicial (Hero intro dark), humo cósmico más perceptible */
  .scrolly-stage.hero-intro-dark .smoke-nebula-primary {
    background: radial-gradient(circle, rgba(255, 255, 0, 0.14) 0%, rgba(255, 255, 0, 0.03) 50%, transparent 70%);
    opacity: 0.85;
  }
  .scrolly-stage.hero-intro-dark .smoke-nebula-accent {
    background: radial-gradient(circle, rgba(99, 102, 241, 0.12) 0%, rgba(30, 41, 59, 0.08) 50%, transparent 70%);
    opacity: 0.8;
  }

  @keyframes smokeDriftPrimary {
    0% { transform: translate3d(0, 0, 0) scale(1) rotate(0deg); }
    50% { transform: translate3d(40px, -25px, 0) scale(1.08) rotate(15deg); }
    100% { transform: translate3d(-30px, 30px, 0) scale(0.94) rotate(-10deg); }
  }

  @keyframes smokeDriftAccent {
    0% { transform: translate3d(0, 0, 0) scale(1) rotate(0deg); }
    50% { transform: translate3d(-45px, -35px, 0) scale(1.12) rotate(-18deg); }
    100% { transform: translate3d(35px, 20px, 0) scale(0.92) rotate(12deg); }
  }

  @keyframes smokeDriftDepth {
    0% { transform: translate(-50%, -50%) scale(0.95); opacity: 0.35; }
    50% { transform: translate(-48%, -52%) scale(1.06); opacity: 0.6; }
    100% { transform: translate(-52%, -48%) scale(0.98); opacity: 0.4; }
  }

  /* Partículas cinéticas flotantes */
  .hero-particles-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 3;
  }

  /* Horitzó lluminós a la vora inferior de la stage abans del teló */
  .hero-curtain-horizon {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    z-index: 4;
    pointer-events: none;
    overflow: hidden;
  }

  .horizon-radiance {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 38px;
    background: linear-gradient(to top, rgba(255, 255, 0, 0.05), transparent);
    opacity: 0.6;
    transition: opacity 300ms ease;
  }

  .horizon-pulse-line {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 0, 0.3) 30%, rgba(255, 255, 0, 0.95) 50%, rgba(255, 255, 0, 0.3) 70%, transparent 100%);
    background-size: 200% 100%;
    animation: horizonPulse 4.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    opacity: 0.75;
  }

  @keyframes horizonPulse {
    0% { background-position: -100% 0; }
    100% { background-position: 200% 0; }
  }

  .scrolly-stage.hero-intro-dark .horizon-radiance {
    opacity: 0.15;
  }

  /* Indicador sutil de scroll animado al inicio */
  .hero-scroll-cue {
    transition: opacity 280ms ease, transform 280ms ease;
  }
  .cue-dot {
    animation: cueDotBounce 1.6s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  @keyframes cueDotBounce {
    0% { transform: translateY(0); opacity: 1; }
    60% { transform: translateY(9px); opacity: 0.2; }
    100% { transform: translateY(0); opacity: 1; }
  }
  .hero-scroll-cue.is-hidden {
    opacity: 0 !important;
    transform: translate(-50%, 14px) !important;
    pointer-events: none !important;
  }

  /* Garantía tipográfica de peso bold en «Hola» y peso normal en el resto */
  #token-hola {
    font-weight: 700 !important;
    color: #020617;
    transition: color 220ms cubic-bezier(0.16, 1, 0.3, 1);
    animation: heroHolaFloat 3.2s ease-in-out infinite alternate;
  }

  @keyframes heroHolaFloat {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(-3px);
    }
  }

  .scrolly-stage.hero-intro-dark #token-hola {
    color: #FFFF00 !important;
  }
  #token-comma,
  #token-soy,
  #token-jaume,
  #token-tur {
    font-weight: 400 !important;
  }

  /* Modo accesible para preferencias de movimiento reducido */
  @media (prefers-reduced-motion: reduce) {
    .scrolly-stage.hero-intro-dark {
      background-color: #ffffff !important;
    }
    .scrolly-stage.hero-intro-dark #token-hola {
      color: #020617 !important;
    }
    #token-hola {
      animation: none !important;
    }
    .hero-black-hole,
    .hero-glow-aura,
    .hero-scroll-cue,
    .hole-singularity,
    .hero-volumetric-smoke,
    .hero-particles-canvas,
    .hero-curtain-horizon {
      display: none !important;
    }
    .scrolly-track {
      height: auto !important;
      padding-top: 3.5rem;
      padding-bottom: 4rem;
    }
    .scrolly-stage {
      position: relative !important;
      top: auto !important;
      height: auto !important;
      overflow: visible !important;
    }
    #hero-phrase {
      transform: none !important;
    }
    .word-token {
      opacity: 1 !important;
      transform: none !important;
    }
    #hero-name-link {
      pointer-events: auto !important;
    }
    #hero-statement {
      opacity: 1 !important;
      transform: none !important;
      pointer-events: auto !important;
    }
  }
</style>

<script is:inline>
  (function () {
    // Ejemplo 3: Sincronización del navbar con el inicio en fondo negro
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const siteNavbar = document.getElementById("site-navbar-wrap");
      if (siteNavbar) {
        siteNavbar.classList.add("hero-intro-dark");
      }
    }

    function initHeroScrollytelling() {
      const track = document.getElementById("scrolly-hero");
      const stage = document.getElementById("scrolly-stage");
      const siteNavbar = document.getElementById("site-navbar-wrap");
      const scrollCue = document.getElementById("hero-scroll-cue");
      const phrase = document.getElementById("hero-phrase");
      const letterO = document.getElementById("letter-o");
      const tokenHola = document.getElementById("token-hola");
      const tokenComma = document.getElementById("token-comma");
      const tokenSoy = document.getElementById("token-soy");
      const tokenJaume = document.getElementById("token-jaume");
      const tokenTur = document.getElementById("token-tur");
      const nameLink = document.getElementById("hero-name-link");
      const statement = document.getElementById("hero-statement");
      const container = document.getElementById("hero-type-container");
      const horizon = document.getElementById("hero-curtain-horizon");
      const particleCanvas = document.getElementById("hero-particles-canvas");

      if (
        !track ||
        !stage ||
        !phrase ||
        !tokenHola ||
        !tokenComma ||
        !tokenSoy ||
        !tokenJaume ||
        !tokenTur ||
        !statement ||
        !container
      ) {
        return;
      }

      // Efecte Forat Negre: absorbeix o expandeix el fons fosc centrat a la lletra 'o'
      let introExited = false;
      function exitIntro() {
        if (introExited) return;
        introExited = true;
        stage.classList.remove("hero-intro-dark");
        if (siteNavbar) siteNavbar.classList.remove("hero-intro-dark");
        if (scrollCue) scrollCue.classList.add("is-hidden");
      }

      function enterIntro() {
        if (!introExited) return;
        introExited = false;
        stage.classList.add("hero-intro-dark");
        if (siteNavbar) siteNavbar.classList.add("hero-intro-dark");
        if (scrollCue) scrollCue.classList.remove("is-hidden");
      }

      function updateBlackHoleCenter() {
        if (!letterO || !stage) return;
        const oRect = letterO.getBoundingClientRect();
        const stageRect = stage.getBoundingClientRect();
        if (stageRect.width === 0 || stageRect.height === 0) return;

        const oCenterX = oRect.left + oRect.width / 2 - stageRect.left;
        // Descuenta el desplazamiento del texto mientras sube el telón
        const containerShiftY = new DOMMatrixReadOnly(window.getComputedStyle(container).transform).m42;
        const oCenterY = oRect.top + oRect.height / 2 - stageRect.top - containerShiftY;

        const percentX = (oCenterX / stageRect.width) * 100;
        const percentY = (oCenterY / stageRect.height) * 100;

        stage.style.setProperty("--hole-x", `${percentX.toFixed(3)}%`);
        stage.style.setProperty("--hole-y", `${percentY.toFixed(3)}%`);
      }

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        exitIntro();
      } else {
        if (window.scrollY > 20) {
          exitIntro();
        } else {
          const onScrollAction = () => {
            exitIntro();
          };

          window.addEventListener("wheel", onScrollAction, { once: true, passive: true });
          window.addEventListener("touchmove", onScrollAction, { once: true, passive: true });
          window.addEventListener("scroll", onScrollAction, { once: true, passive: true });
        }
      }

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      if (prefersReducedMotion.matches) return;

      // Offsets para centrar exactamente cada estado tipográfico (píxeles relativos al centro)
      let offset1 = 0; // Centra «Hola»
      let offset2 = 0; // Centra «Hola, soy»
      let offset3 = 0; // Centra «Hola, soy Jaume Tur»

      let cachedTrackTop = 0;
      let cachedTrackHeight = 0;
      let cachedViewportHeight = window.innerHeight;

      function measureOffsets() {
        cachedViewportHeight = window.innerHeight;
        cachedTrackHeight = track.offsetHeight;
        const trackRect = track.getBoundingClientRect();
        cachedTrackTop = window.scrollY + trackRect.top;

        const containerRect = container.getBoundingClientRect();
        const containerCenter = containerRect.left + containerRect.width / 2;
        const phraseTransformX = new DOMMatrixReadOnly(
          window.getComputedStyle(phrase).transform
        ).m41;

        // Medir coordenadas respecto al origen sin transformar, sin alterar transform actual (cero parpadeo ni reflow)
        const holaRect = tokenHola.getBoundingClientRect();
        const soyRect = tokenSoy.getBoundingClientRect();
        const turRect = tokenTur.getBoundingClientRect();

        const unshiftedHolaLeft = holaRect.left - phraseTransformX;
        const unshiftedHolaWidth = holaRect.width;
        const unshiftedHolaCenter = unshiftedHolaLeft + unshiftedHolaWidth / 2;

        const unshiftedSoyRight = soyRect.right - phraseTransformX;
        const unshiftedTurRight = turRect.right - phraseTransformX;

        // 1. Centro de «Hola»
        offset1 = containerCenter - unshiftedHolaCenter;

        // 2. Centro de «Hola, soy»
        const holaSoyCenter = (unshiftedHolaLeft + unshiftedSoyRight) / 2;
        offset2 = containerCenter - holaSoyCenter;

        // 3. Centro de «Hola, soy Jaume Tur»
        const holaTurCenter = (unshiftedHolaLeft + unshiftedTurRight) / 2;
        offset3 = containerCenter - holaTurCenter;

        updateBlackHoleCenter();
      }

      // 3 estados de interacción (1: , soy | 2: Jaume Tur | 3: statement y telón al primer contenido)
      const stepCount = 4;
      const transitionDuration = 260;
      const wheelQuietPeriod = 240;
      const touchThreshold = 28;
      let activeStep = 0;
      let isAnimating = false;
      let pendingDirections = [];
      let wheelQuietTimer = 0;
      let wheelGestureActive = false;
      let touchStartY = 0;
      let touchStartX = 0;
      let touchHandled = false;

      function renderStep(step, immediate = false) {
        if (scrollCue && step > 0) {
          scrollCue.classList.add("is-hidden");
        }

        const currentOffset = step <= 0 ? offset1 : step === 1 ? offset2 : offset3;
        const soyVisible = step >= 1;
        const jaumeVisible = step >= 2;
        const turVisible = step >= 2;
        const statementVisible = step >= 3;

        phrase.style.transition = immediate
          ? "none"
          : `transform ${transitionDuration}ms cubic-bezier(0.16, 1, 0.3, 1)`;
        phrase.style.transform = `translate3d(${currentOffset.toFixed(2)}px, 0, 0)`;

        const animatedTokens = [tokenHola, tokenComma, tokenSoy, tokenJaume, tokenTur];
        animatedTokens.forEach((token) => {
          token.style.transition = immediate
            ? "none"
            : `opacity ${transitionDuration}ms cubic-bezier(0.16, 1, 0.3, 1), transform ${transitionDuration}ms cubic-bezier(0.16, 1, 0.3, 1)`;
        });

        // «Hola» se ve obligatoriamente en todo momento desde la carga inicial
        tokenHola.style.opacity = "1";
        tokenHola.style.transform = "translate3d(0, 0, 0)";

        const soyTranslateY = soyVisible ? 0 : 10;
        tokenComma.style.transitionDelay = "0ms";
        tokenComma.style.opacity = soyVisible ? "1" : "0";
        tokenSoy.style.transitionDelay = "0ms";
        tokenSoy.style.opacity = soyVisible ? "1" : "0";
        tokenSoy.style.transform = `translate3d(0, ${soyTranslateY}px, 0)`;

        const jaumeTranslateY = jaumeVisible ? 0 : 10;
        tokenJaume.style.transitionDelay = "0ms";
        tokenJaume.style.opacity = jaumeVisible ? "1" : "0";
        tokenJaume.style.transform = `translate3d(0, ${jaumeTranslateY}px, 0)`;

        const turTranslateY = turVisible ? 0 : 10;
        tokenTur.style.transitionDelay = immediate || step < 2 ? "0ms" : "35ms";
        tokenTur.style.opacity = turVisible ? "1" : "0";
        tokenTur.style.transform = `translate3d(0, ${turTranslateY}px, 0)`;

        if (nameLink) {
          nameLink.style.pointerEvents = turVisible ? "auto" : "none";
        }

        statement.style.transition = immediate
          ? "none"
          : `opacity ${transitionDuration}ms cubic-bezier(0.16, 1, 0.3, 1), transform ${transitionDuration}ms cubic-bezier(0.16, 1, 0.3, 1)`;
        statement.style.opacity = statementVisible ? "1" : "0";
        statement.style.transform = `translate3d(0, ${statementVisible ? 0 : 12}px, 0)`;
        statement.style.pointerEvents = statementVisible ? "auto" : "none";

        if (horizon) {
          if (statementVisible) {
            horizon.classList.add("is-active");
          } else {
            horizon.classList.remove("is-active");
          }
        }
      }

      // El texto sube un poco mientras el telón lo cubre
      const curtain = document.getElementById("home-curtain");
      let liftFrame = 0;

      function renderTextLift() {
        liftFrame = 0;
        if (!curtain) return;

        const stageRect = stage.getBoundingClientRect();
        const curtainTop = curtain.getBoundingClientRect().top - stageRect.top;
        const travel = Math.min(Math.max(stageRect.height - curtainTop, 0), stageRect.height);
        container.style.transform = travel > 0 ? `translate3d(0, ${(-travel * 0.12).toFixed(1)}px, 0)` : "";
      }

      function requestTextLift() {
        if (!liftFrame) liftFrame = requestAnimationFrame(renderTextLift);
      }

      function isTrackActive() {
        const rect = track.getBoundingClientRect();
        return rect.top < window.innerHeight && rect.bottom > 56;
      }

      function isCurtainCovering() {
        const curtain = document.getElementById("home-curtain");
        if (!curtain) return false;
        const rect = curtain.getBoundingClientRect();
        return rect.top <= 70;
      }

      function getCurtainTarget() {
        const scrollableDistance = Math.max(0, cachedTrackHeight - cachedViewportHeight);
        return cachedTrackTop + scrollableDistance;
      }

      function getStepTarget(step) {
        const scrollableDistance = Math.max(0, cachedTrackHeight - cachedViewportHeight);
        if (step <= 0) return cachedTrackTop;
        if (step === 1) return cachedTrackTop + scrollableDistance * 0.12;
        if (step === 2) return cachedTrackTop + scrollableDistance * 0.25;
        return cachedTrackTop + scrollableDistance * 0.38;
      }

      function isCurtainRaised() {
        return activeStep >= 3 && window.scrollY > getStepTarget(3) + 4;
      }

      function canQueueStep(direction) {
        const lastQueuedStep = pendingDirections.length
          ? activeStep + pendingDirections.reduce((total, queued) => total + queued, 0)
          : activeStep;
        const nextStep = lastQueuedStep + direction;
        return nextStep >= 0 && nextStep < stepCount;
      }

      function scrollToStep(step) {
        const target = getStepTarget(step);
        window.scrollTo({ top: target, behavior: "instant" });
      }

      function startStep(direction) {
        const nextStep = activeStep + direction;
        if (nextStep < 0 || nextStep >= stepCount) return;

        if (nextStep > 0) {
          exitIntro();
        } else if (nextStep === 0) {
          enterIntro();
        }

        activeStep = nextStep;
        isAnimating = true;
        renderStep(activeStep);
        scrollToStep(activeStep);

        window.setTimeout(() => {
          isAnimating = false;
          if (pendingDirections.length > 0) {
            startStep(pendingDirections.shift());
          }
        }, transitionDuration);
      }

      function queueStep(direction) {
        if (!canQueueStep(direction)) return;
        if (isAnimating) {
          pendingDirections.push(direction);
          return;
        }
        startStep(direction);
      }

      function onWheel(event) {
        if (event.deltaY === 0 || !isTrackActive()) return;
        const direction = event.deltaY > 0 ? 1 : -1;
        const curtainTarget = getCurtainTarget();

        // 1. Si estamos por debajo de la zona del telón (navegando por el contenido inferior):
        // Permitir scroll nativo fluido sin intercepción.
        if (window.scrollY > curtainTarget + 60) {
          pendingDirections = [];
          return;
        }

        // 2. Si se hace scroll hacia abajo y ya estamos en el paso final (todo el texto visible y telón arriba):
        // Permitir scroll nativo descendente para que el usuario navegue hacia abajo libremente.
        if (direction > 0 && activeStep >= 3) {
          pendingDirections = [];
          return;
        }

        // Si el telón está a medio subir, baja con scroll nativo en vez de saltar al paso 2
        if (direction < 0 && isCurtainRaised()) {
          pendingDirections = [];
          return;
        }

        // 3. Si se hace scroll hacia arriba y ya estamos en el paso 0 (inicio):
        // Permitir scroll nativo en la cabecera sin bloquear.
        if (direction < 0 && activeStep <= 0) {
          pendingDirections = [];
          return;
        }

        // 4. Comprobar si se puede encolar el paso de animación
        if (!canQueueStep(direction)) {
          return;
        }

        event.preventDefault();
        if (!wheelGestureActive) {
          wheelGestureActive = true;
          queueStep(direction);
        }
        window.clearTimeout(wheelQuietTimer);
        wheelQuietTimer = window.setTimeout(() => {
          wheelGestureActive = false;
        }, wheelQuietPeriod);
      }

      function onTouchStart(event) {
        if (!isTrackActive() || event.touches.length !== 1) return;
        touchStartY = event.touches[0].clientY;
        touchStartX = event.touches[0].clientX;
        touchHandled = false;
      }

      function onTouchMove(event) {
        if (event.touches.length !== 1 || !isTrackActive()) return;

        const deltaY = touchStartY - event.touches[0].clientY;
        const deltaX = touchStartX - event.touches[0].clientX;
        if (Math.abs(deltaY) < touchThreshold || Math.abs(deltaY) < Math.abs(deltaX)) return;

        const direction = deltaY > 0 ? 1 : -1;
        const curtainTarget = getCurtainTarget();

        // Si estamos por debajo de la zona del telón: scroll táctil nativo
        if (window.scrollY > curtainTarget + 60) {
          return;
        }

        // Si se desplaza hacia abajo y ya estamos en el paso final: permitir scroll táctil nativo
        if (direction > 0 && activeStep >= 3) {
          return;
        }

        // Si el telón está a medio subir, baja con scroll nativo en vez de saltar al paso 2
        if (direction < 0 && isCurtainRaised()) {
          return;
        }

        // Si se desplaza hacia arriba y ya estamos en el paso 0: permitir scroll táctil nativo
        if (direction < 0 && activeStep <= 0) {
          return;
        }

        if (touchHandled) {
          event.preventDefault();
          return;
        }

        if (!canQueueStep(direction)) return;

        if (event.cancelable) event.preventDefault();
        touchHandled = true;
        queueStep(direction);
      }

      function onTouchEnd() {
        touchHandled = false;
      }

      function onWindowScroll() {
        requestTextLift();

        if (window.scrollY <= 15 && activeStep === 0) {
          enterIntro();
        } else {
          exitIntro();
        }

        if (scrollCue && window.scrollY > 15) {
          scrollCue.classList.add("is-hidden");
        }
        const curtainTarget = getCurtainTarget();

        if (window.scrollY >= curtainTarget - 20 || isCurtainCovering()) {
          if (activeStep !== 3) {
            activeStep = 3;
            renderStep(3, false);
          }
        } else if (!isAnimating && !wheelGestureActive) {
          const scrollableDistance = Math.max(0, cachedTrackHeight - cachedViewportHeight);
          if (scrollableDistance > 0) {
            const relY = Math.max(0, window.scrollY - cachedTrackTop);
            const ratio = relY / scrollableDistance;
            let targetStep = 0;
            if (ratio >= 0.32) targetStep = 3;
            else if (ratio >= 0.18) targetStep = 2;
            else if (ratio >= 0.06) targetStep = 1;
            else targetStep = 0;

            if (targetStep !== activeStep) {
              activeStep = targetStep;
              renderStep(activeStep, true);
            }
          }
        }
      }

      measureOffsets();
      renderStep(activeStep, true);
      requestTextLift();

      // -------------------------------------------------------------
      // Dynamic Floating Kinetic Particles Canvas (punts en moviment)
      // -------------------------------------------------------------
      let particleCtx = particleCanvas ? particleCanvas.getContext("2d") : null;
      let particlesAnimationId = 0;
      let pWidth = 0;
      let pHeight = 0;
      let pointerX = -9999;
      let pointerY = -9999;
      let particles = [];
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function initParticles() {
        if (!particleCanvas || !particleCtx || reducedMotion) return;
        const rect = stage.getBoundingClientRect();
        pWidth = rect.width;
        pHeight = rect.height;
        if (pWidth === 0 || pHeight === 0) return;

        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        particleCanvas.width = Math.round(pWidth * dpr);
        particleCanvas.height = Math.round(pHeight * dpr);
        particleCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const count = Math.min(40, Math.max(20, Math.floor(pWidth / 36)));
        particles = [];
        for (let i = 0; i < count; i++) {
          particles.push({
            x: Math.random() * pWidth,
            y: Math.random() * pHeight,
            vx: (Math.random() - 0.5) * 0.32,
            vy: -0.15 - Math.random() * 0.35,
            radius: 0.9 + Math.random() * 1.4,
            alpha: 0.2 + Math.random() * 0.45,
            pulsePhase: Math.random() * Math.PI * 2,
            pulseSpeed: 0.02 + Math.random() * 0.025,
            isAccent: Math.random() > 0.72,
          });
        }
      }

      function updateAndDrawParticles() {
        if (!particleCtx || !particleCanvas || reducedMotion) return;
        if (!isTrackActive()) {
          particlesAnimationId = requestAnimationFrame(updateAndDrawParticles);
          return;
        }

        particleCtx.clearRect(0, 0, pWidth, pHeight);

        const isDark = stage.classList.contains("hero-intro-dark");
        const upwardSpeedBoost = activeStep >= 3 ? 1.7 : 1.0;

        // Connexions de constel·lació subtils
        const maxDist = 70;
        const maxDistSq = maxDist * maxDist;
        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const dx = particles[i].x - particles[j].x;
            const dy = particles[i].y - particles[j].y;
            const distSq = dx * dx + dy * dy;
            if (distSq < maxDistSq) {
              const alphaRatio = 1 - distSq / maxDistSq;
              const lineAlpha = (isDark ? 0.12 : 0.055) * alphaRatio;
              particleCtx.beginPath();
              particleCtx.moveTo(particles[i].x, particles[i].y);
              particleCtx.lineTo(particles[j].x, particles[j].y);
              particleCtx.strokeStyle = isDark
                ? "rgba(255, 255, 0, " + lineAlpha + ")"
                : "rgba(71, 85, 105, " + lineAlpha + ")";
              particleCtx.lineWidth = 0.55;
              particleCtx.stroke();
            }
          }
        }

        // Punts en moviment
        for (let i = 0; i < particles.length; i++) {
          const p = particles[i];

          p.x += p.vx;
          p.y += p.vy * upwardSpeedBoost;
          p.pulsePhase += p.pulseSpeed;

          // Repulsió líquida suau respecte al cursor
          const pdx = p.x - pointerX;
          const pdy = p.y - pointerY;
          const pDist = Math.sqrt(pdx * pdx + pdy * pdy);
          if (pDist < 110 && pDist > 0) {
            const force = (1 - pDist / 110) * 0.75;
            p.x += (pdx / pDist) * force;
            p.y += (pdy / pDist) * force;
          }

          // Wrap-around infinit suau
          if (p.y < -10) {
            p.y = pHeight + 5;
            p.x = Math.random() * pWidth;
          } else if (p.y > pHeight + 10) {
            p.y = -5;
          }
          if (p.x < -10) {
            p.x = pWidth + 5;
          } else if (p.x > pWidth + 10) {
            p.x = -5;
          }

          const currentAlpha = p.alpha * (0.8 + 0.2 * Math.sin(p.pulsePhase));

          particleCtx.beginPath();
          particleCtx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);

          if (isDark) {
            particleCtx.fillStyle = p.isAccent
              ? "rgba(255, 255, 0, " + currentAlpha + ")"
              : "rgba(226, 232, 240, " + (currentAlpha * 0.75) + ")";
          } else {
            particleCtx.fillStyle = p.isAccent
              ? "rgba(217, 119, 6, " + (currentAlpha * 0.85) + ")"
              : "rgba(51, 65, 85, " + (currentAlpha * 0.65) + ")";
          }
          particleCtx.fill();
        }

        particlesAnimationId = requestAnimationFrame(updateAndDrawParticles);
      }

      if (!reducedMotion) {
        initParticles();
        particlesAnimationId = requestAnimationFrame(updateAndDrawParticles);

        stage.addEventListener("pointermove", (e) => {
          const rect = stage.getBoundingClientRect();
          pointerX = e.clientX - rect.left;
          pointerY = e.clientY - rect.top;
        }, { passive: true });

        stage.addEventListener("pointerleave", () => {
          pointerX = -9999;
          pointerY = -9999;
        }, { passive: true });

        window.addEventListener("pagehide", () => {
          if (particlesAnimationId) cancelAnimationFrame(particlesAnimationId);
        });
      }

      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(() => {
          requestAnimationFrame(() => {
            measureOffsets();
            renderStep(activeStep, true);
          });
        });
      } else {
        requestAnimationFrame(() => {
          measureOffsets();
          renderStep(activeStep, true);
        });
      }

      let lastWidth = window.innerWidth;
      let lastHeight = window.innerHeight;
      window.addEventListener("wheel", onWheel, { passive: false });
      window.addEventListener("touchstart", onTouchStart, { passive: true });
      window.addEventListener("touchmove", onTouchMove, { passive: false });
      window.addEventListener("touchend", onTouchEnd, { passive: true });
      window.addEventListener("scroll", onWindowScroll, { passive: true });
      window.addEventListener(
        "resize",
        () => {
          if (window.innerWidth !== lastWidth || window.innerHeight !== lastHeight) {
            lastWidth = window.innerWidth;
            lastHeight = window.innerHeight;
            measureOffsets();
            renderStep(activeStep, true);
            requestTextLift();
            initParticles();
          }
        },
        { passive: true }
      );
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initHeroScrollytelling);
    } else {
      initHeroScrollytelling();
    }
  })();
</script>

---
import { Icon } from "astro-icon/components";
import EmojiIcon from "@/components/ui/emoji-icon.astro";

const steps = [
  {
    number: "01",
    emoji: "📋",
    title: "Requisits & Arquitectura",
    desc: "Definició d'abast, model de dades JSON estructurat i selecció del stack modular adequat.",
    tag: "Fase 1",
    icon: "uil:compass",
  },
  {
    number: "02",
    emoji: "🎨",
    title: "Disseny & Accessibilitat",
    desc: "Estructura semàntica HTML5, compliment dels criteris WCAG AA i responsive design fluid.",
    tag: "Fase 2",
    icon: "uil:layer-group",
  },
  {
    number: "03",
    emoji: "💻",
    title: "Frontend & Tipat Estricte",
    desc: "Desenvolupament net amb Angular, TypeScript estricte i components UI reutilitzables.",
    tag: "Fase 3",
    icon: "uil:brackets-curly",
  },
  {
    number: "04",
    emoji: "✅",
    title: "Validació & Desplegament",
    desc: "Linters automàtics, fluxos GitHub Actions i publicació contínua optimitzada a 60 FPS.",
    tag: "Fase 4",
    icon: "uil:check-circle",
  },
];
---

<section id="metodologia" class="py-20 md:py-28 scroll-mt-12">
  
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12 md:mb-14">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200/80 mb-3 shadow-2xs">
        <EmojiIcon symbol="🔄" decorative={true} />
        <span>Procés d'enginyeria</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
        Flux de treball en <span class="bg-gradient-to-r from-indigo-600 to-indigo-800 bg-clip-text text-transparent">4 etapes</span>
      </h2>
      <p class="text-sm text-slate-600 mt-2 max-w-xl">
        Metodologia iterativa enfocada en la qualitat del codi, l'accessibilitat i el rendiment des del primer commit.
      </p>
    </div>

    <!-- Guiding thread Memoji: 2.png (Thumbs up approval) -->
    <div class="relative group self-center sm:self-auto -mb-4 sm:-mb-6 z-20">
      <div class="relative flex items-center gap-3 bg-white border border-slate-200/90 rounded-2xl p-2.5 pr-4 shadow-[0_4px_16px_rgba(15,23,42,0.06)] group-hover:-translate-y-1 transition-transform">
        <div class="relative w-20 h-20 sm:w-24 sm:h-24 -my-4 -ml-2 flex items-center justify-center">
          <img
            src="/memojis/2.png"
            alt="Jaume Tur polze amunt"
            class="w-full h-full object-contain drop-shadow-[0_8px_16px_rgba(15,23,42,0.18)] group-hover:scale-105 transition-transform"
            width="96"
            height="96"
          />
        </div>
        <div class="text-xs">
          <span class="font-extrabold text-slate-900 flex items-center gap-1 text-sm leading-tight">
            <span>Garantia de Qualitat</span>
            <EmojiIcon symbol="👍" decorative={true} />
          </span>
          <span class="text-indigo-600 font-mono text-[11px] font-bold">Codi net & Proves</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 4 Step Cards with Emojis & Interactive Verified Status -->
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
    {
      steps.map((step) => (
        <div class="bg-white rounded-2xl border border-slate-200/90 p-6 shadow-[0_1px_3px_0_rgba(15,23,42,0.04)] hover:border-indigo-300 hover:shadow-md transition-all duration-200 flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-2xl transform-gpu group-hover:scale-125 transition-transform" aria-hidden="true">
                {step.emoji}
              </span>
              <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 border border-slate-200/80">
                {step.tag}
              </span>
            </div>
            
            <span class="text-xs font-mono font-bold text-indigo-600 block mb-1">
              Etapa {step.number}
            </span>
            
            <h3 class="text-base font-bold text-slate-900 group-hover:text-indigo-600 transition-colors">
              {step.title}
            </h3>
            
            <p class="text-xs text-slate-600 mt-2.5 leading-relaxed">
              {step.desc}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-[11px] font-mono text-slate-500">
            <span class="flex items-center gap-1.5 text-emerald-700 font-semibold">
              <EmojiIcon symbol="✅" class="group-hover:scale-125 transition-transform" decorative={true} />
              <span>Fase verificada</span>
            </span>
            <Icon name={step.icon} class="w-4 h-4 text-slate-400 group-hover:text-indigo-600 transition-colors" />
          </div>
        </div>
      ))
    }
  </div>
</section>

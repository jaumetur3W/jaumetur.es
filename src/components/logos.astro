---
import { Icon } from "astro-icon/components";

const techStack = [
  {
    name: "Angular",
    icon: "simple-icons:angular",
    iconColor: "text-red-500",
    badge: "hover:border-red-400 hover:bg-red-50/50 text-slate-800",
    url: "/blog/arquitectura-modular-angular-standalone-signals",
  },
  {
    name: "TypeScript",
    icon: "simple-icons:typescript",
    iconColor: "text-blue-500",
    badge: "hover:border-blue-400 hover:bg-blue-50/50 text-slate-800",
    url: "/blog/guia-definitiva-typescript-estricte-frontend",
  },
  {
    name: "JavaScript",
    icon: "simple-icons:javascript",
    iconColor: "text-amber-500",
    badge: "hover:border-amber-400 hover:bg-amber-50/50 text-slate-800",
    url: "/blog/javascript-guia-completa-ecmascript-modern",
  },
  {
    name: "Tailwind CSS",
    icon: "simple-icons:tailwindcss",
    iconColor: "text-cyan-500",
    badge: "hover:border-cyan-400 hover:bg-cyan-50/50 text-slate-800",
    url: "/blog/tailwind-css-guia-disseny-atomic-modern",
  },
  {
    name: "HTML5 Semàntic",
    icon: "simple-icons:html5",
    iconColor: "text-orange-500",
    badge: "hover:border-orange-400 hover:bg-orange-50/50 text-slate-800",
    url: "/blog/html5-semantic-accessibilitat-arquitectura-web",
  },
  {
    name: "Node.js",
    icon: "simple-icons:nodedotjs",
    iconColor: "text-emerald-500",
    badge: "hover:border-emerald-400 hover:bg-emerald-50/50 text-slate-800",
    url: "/blog/nodejs-arquitectura-backend-esdeveniments-apis",
  },
  {
    name: "GitHub Actions",
    icon: "simple-icons:githubactions",
    iconColor: "text-sky-500",
    badge: "hover:border-sky-400 hover:bg-sky-50/50 text-slate-800",
    url: "/blog/pipeline-cicd-github-actions-desplegament-continu",
  },
  {
    name: "Linux Shell",
    icon: "simple-icons:linux",
    iconColor: "text-slate-800",
    badge: "hover:border-slate-500 hover:bg-slate-100 text-slate-800",
    url: "/blog/linux-shell-bash-administracio-sistemes-devops",
  },
  {
    name: "Git & GitHub",
    icon: "simple-icons:git",
    iconColor: "text-rose-500",
    badge: "hover:border-rose-400 hover:bg-rose-50/50 text-slate-800",
    url: "/blog/git-github-control-versions-flux-colaboratiu",
  },
];
---

<div class="mt-10 pt-8 border-t border-slate-200/80 reveal-fade-up">
  <div class="flex flex-col sm:flex-row items-center justify-between gap-3 mb-5">
    <p class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500 flex items-center gap-2">
      <Icon name="bx:layer" class="w-4 h-4 text-slate-600" />
      <span>Stack Tecnològic Principal</span>
    </p>
    <span class="text-xs font-mono text-slate-400">
      Clica per llegir la guia i anàlisi de cada tecnologia ↗
    </span>
  </div>

  <!-- Interactive Tactile Tech Playground Strip (Single Line with Horizontal Scroll) -->
  <div class="flex gap-2 sm:gap-2.5 items-center overflow-x-auto no-scrollbar pb-2 pt-1 flex-nowrap scroll-smooth">
    {
      techStack.map((tech) => (
        <a
          href={tech.url}
          class={`group shrink-0 whitespace-nowrap flex items-center gap-2 px-3 py-1.5 rounded-xl border border-slate-200/90 bg-white text-xs font-semibold font-mono transition-all duration-200 shadow-2xs hover:-translate-y-0.5 hover:shadow-md cursor-pointer select-none ${tech.badge}`}
          title={`${tech.name} — Llegir article tècnic i anàlisi històrica`}>
          <Icon class={`w-4 h-4 shrink-0 transition-transform group-hover:scale-110 ${tech.iconColor}`} name={tech.icon} />
          <span>{tech.name}</span>
          <span class="text-[10px] text-slate-400 group-hover:text-slate-700 transition-colors">↗</span>
        </a>
      ))
    }
  </div>
</div>

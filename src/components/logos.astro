---
import { Icon } from "astro-icon/components";

const techStack = [
  { name: "Angular", icon: "simple-icons:angular", badge: "bg-red-50 text-red-700 border-red-200/80 hover:bg-red-100 hover:border-red-300" },
  { name: "TypeScript", icon: "simple-icons:typescript", badge: "bg-blue-50 text-blue-700 border-blue-200/80 hover:bg-blue-100 hover:border-blue-300" },
  { name: "JavaScript", icon: "simple-icons:javascript", badge: "bg-amber-50 text-amber-800 border-amber-200/80 hover:bg-amber-100 hover:border-amber-300" },
  { name: "Tailwind CSS", icon: "simple-icons:tailwindcss", badge: "bg-cyan-50 text-cyan-700 border-cyan-200/80 hover:bg-cyan-100 hover:border-cyan-300" },
  { name: "HTML5", icon: "simple-icons:html5", badge: "bg-orange-50 text-orange-700 border-orange-200/80 hover:bg-orange-100 hover:border-orange-300" },
  { name: "Node.js", icon: "simple-icons:nodedotjs", badge: "bg-emerald-50 text-emerald-700 border-emerald-200/80 hover:bg-emerald-100 hover:border-emerald-300" },
  { name: "GitHub Actions", icon: "simple-icons:githubactions", badge: "bg-sky-50 text-sky-700 border-sky-200/80 hover:bg-sky-100 hover:border-sky-300" },
  { name: "Linux", icon: "simple-icons:linux", badge: "bg-amber-50 text-amber-700 border-amber-200/80 hover:bg-amber-100 hover:border-amber-300" },
  { name: "Git", icon: "simple-icons:git", badge: "bg-rose-50 text-rose-700 border-rose-200/80 hover:bg-rose-100 hover:border-rose-300" },
];
---

<div class="mt-8 pt-8 border-t border-slate-200/70">
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-4">
    <p class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500 flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
      Stack Tecnològic Principal
    </p>
    <span class="text-xs font-mono text-slate-400">
      Tecnologies amb les quals construïsc cada dia
    </span>
  </div>

  <div class="flex gap-2.5 sm:gap-3 items-center justify-center sm:justify-start flex-wrap">
    {
      techStack.map((tech) => (
        <div
          class={`flex items-center gap-2 px-3 py-1.5 rounded-xl border text-xs font-semibold font-mono transition-all duration-200 shadow-2xs hover:scale-105 cursor-default ${tech.badge}`}
          title={tech.name}>
          <Icon class="size-4 shrink-0" name={tech.icon} />
          <span>{tech.name}</span>
        </div>
      ))
    }
  </div>
</div>

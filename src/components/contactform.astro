---
import { Icon } from "astro-icon/components";
import { localeFromPath } from "@/i18n";

const isVal = localeFromPath(Astro.url.pathname) === "val";
---

<form
  id="contact-form"
  class="needs-validation space-y-4"
  novalidate
  aria-label={isVal ? "Formulari de contacte directe" : "Formulario de contacto directo"}>
  
  <!-- Anti-spam Honeypot Field (Ocult per a humans, els bots l'ompliran automàticament) -->
  <div class="hidden" aria-hidden="true">
    <label for="honeypot-field">{isVal ? "No omplis aquest camp si ets una persona" : "No rellenes este campo si eres una persona"}</label>
    <input
      type="text"
      name="_gotcha"
      id="honeypot-field"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <!-- Nom Complet -->
  <div>
    <label for="contact-name" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 mb-1">
      {isVal ? "Nom" : "Nombre"} <span class="text-rose-500" aria-label={isVal ? "obligatori" : "obligatorio"}>*</span>
    </label>
    <div class="relative">
      <input
        id="contact-name"
        type="text"
        name="name"
        placeholder={isVal ? "Com et dius?" : "¿Cómo te llamas?"}
        required
        aria-required="true"
        aria-describedby="name-error"
        class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-slate-900 placeholder:text-slate-400 transition"
      />
    </div>
    <p id="name-error" class="hidden text-rose-600 text-xs mt-1 font-sans" role="alert">
      {isVal ? "Indica el teu nom perquè puga adreçar-me a tu." : "Indica tu nombre para poder dirigirme a ti."}
    </p>
  </div>

  <div>
    <label for="contact-phone" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 mb-1">
      {isVal ? "Telèfon (opcional)" : "Teléfono (opcional)"}
    </label>
    <input
      id="contact-phone"
      type="tel"
      name="phone"
      autocomplete="tel"
      placeholder={isVal ? "Només si prefereixes que et telefone" : "Solo si prefieres que te llame"}
      class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-slate-900 placeholder:text-slate-400 transition"
    />
  </div>

  <!-- Tipus de Servei / Projecte -->
  <div class="grid sm:grid-cols-2 gap-3">
    <div>
      <label for="contact-service" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 mb-1">
        {isVal ? "Producte o servei principal" : "Producto o servicio principal"}
      </label>
      <select
        id="contact-service"
        name="service"
        class="w-full px-3 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-slate-800 transition">
        <option value="landing-page" selected>{isVal ? "Web nova o renovació de web" : "Nueva web o renovación de la actual"}</option>
        <option value="angular-webapp">Web App SPA (Angular / TypeScript)</option>
        <option value="performance-audit">{isVal ? "Optimització 60 FPS i WCAG AA" : "Optimización 60 FPS y WCAG AA"}</option>
        <option value="cicd-devops">Pipelines CI/CD & DevOps</option>
        <option value="contractacio">{isVal ? "Oportunitat laboral / equip" : "Oportunidad laboral / equipo"}</option>
        <option value="altre">{isVal ? "Una altra consulta tècnica" : "Otra consulta técnica"}</option>
      </select>
    </div>

    <div>
      <label for="contact-extra" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 mb-1">
        {isVal ? "Extres opcionals" : "Extras opcionales"}
      </label>
      <select
        id="contact-extra"
        name="extra"
        class="w-full px-3 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-slate-800 transition">
        <option value="cap" selected>{isVal ? "Encara no ho sé / cap" : "Aún no lo sé / ninguno"}</option>
        <option value="rrss">{isVal ? "Gestió de xarxes socials (RRSS)" : "Gestión de redes sociales"}</option>
        <option value="rrss-publicitat">{isVal ? "Gestió de RRSS amb publicitat" : "Gestión de redes sociales con publicidad"}</option>
        <option value="publicitat">{isVal ? "Integració de publicitat al web" : "Integración de publicidad en la web"}</option>
        <option value="seo">{isVal ? "SEO i analítica" : "SEO y analítica"}</option>
        <option value="accessibilitat">{isVal ? "Accessibilitat i rendiment" : "Accesibilidad y rendimiento"}</option>
        <option value="altres">{isVal ? "Altres extres (explica-ho més avall)" : "Otros extras (explícalos más abajo)"}</option>
      </select>
    </div>
  </div>

  <div>
    <label for="contact-budget" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 mb-1">
      {isVal ? "Pressupost orientatiu (opcional)" : "Presupuesto orientativo (opcional)"}
    </label>
    <select id="contact-budget" name="budget" class="w-full px-3 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-slate-800 transition">
      <option value="a-definir" selected>A definir</option>
      <option value="menys-1k">{isVal ? "Menys de 1.000 €" : "Menos de 1.000 €"}</option>
      <option value="1k-3k">1.000 € - 3.000 €</option>
      <option value="mes-3k">{isVal ? "Més de 3.000 €" : "Más de 3.000 €"}</option>
    </select>
  </div>

  <!-- Missatge -->
  <div>
    <label for="contact-message" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 mb-1">
      {isVal ? "Què necessites? (opcional)" : "¿Qué necesitas? (opcional)"}
    </label>
    <textarea
      id="contact-message"
      name="message"
      aria-describedby="message-error"
      placeholder={isVal ? "Objectiu del projecte, terminis desitjats, detalls tècnics o qualsevol dubte..." : "Objetivo del proyecto, plazos deseados, detalles técnicos o cualquier duda..."}
      rows="4"
      class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-slate-900 placeholder:text-slate-400 transition"
    ></textarea>
    <p id="message-error" class="hidden text-rose-600 text-xs mt-1 font-sans" role="alert">
      {isVal ? "Escriu unes línies per a explicar la consulta." : "Escribe unas líneas para explicar tu consulta."}
    </p>
  </div>

  <!-- Botons d'Acció de Contacte (Correu directe i còpia ràpida) -->
  <div class="space-y-2 pt-1">
    <button
      type="submit"
      id="contact-submit-btn"
      class="w-full inline-flex items-center justify-center gap-2 py-3 px-6 rounded-xl bg-slate-900 hover:bg-indigo-600 text-white font-bold text-xs sm:text-sm shadow-md transition group cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
      <Icon name="bx:paper-plane" class="w-4 h-4 text-indigo-400 group-hover:scale-110 group-hover:translate-x-0.5 transition-transform" />
      <span id="submit-btn-text">{isVal ? "Obrir correu amb la proposta preparada" : "Abrir correo con la propuesta preparada"}</span>
    </button>
  </div>

  <!-- Banner d'Estat Accessible (Live Region) -->
  <div
    id="form-feedback"
    class="hidden p-3 rounded-xl text-xs font-mono text-center transition-all"
    role="status"
    aria-live="polite">
  </div>

  <p class="text-[11px] text-slate-400 text-center font-sans">
    {isVal
      ? "La consulta no comporta cap compromís. El nom és obligatori; el telèfon i la resta de dades són opcionals. En enviar-la, s'obrirà el client de correu perquè confirmes l'enviament."
      : "La consulta no implica ningún compromiso. El nombre es obligatorio; el teléfono y el resto de datos son opcionales. Al enviarla, se abrirá tu cliente de correo para que confirmes el envío."}
  </p>
</form>

<script is:inline>
  (function () {
    const form = document.getElementById("contact-form");
    const isVal = window.location.pathname === "/val" || window.location.pathname.startsWith("/val/");
    const feedback = document.getElementById("form-feedback");
    const submitBtn = document.getElementById("contact-submit-btn");
    const submitBtnText = document.getElementById("submit-btn-text");
    const honeypot = document.getElementById("honeypot-field");

    const nameInput = document.getElementById("contact-name");
    const phoneInput = document.getElementById("contact-phone");
    const messageInput = document.getElementById("contact-message");
    const serviceSelect = document.getElementById("contact-service");
    const budgetSelect = document.getElementById("contact-budget");
    const extraSelect = document.getElementById("contact-extra");

    const nameError = document.getElementById("name-error");
    const messageError = document.getElementById("message-error");

    // Sincronitzar paràmetre URL ?servei= amb el selector
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const preselectedService = urlParams.get("servei");
      if (preselectedService && serviceSelect) {
        serviceSelect.value = preselectedService;
      }
    } catch (_) {}

    function showStatus(message, isSuccess = true) {
      if (!feedback) return;
      feedback.className = isSuccess
        ? "p-3 rounded-xl text-xs font-mono text-center bg-emerald-50 text-emerald-800 border border-emerald-200"
        : "p-3 rounded-xl text-xs font-mono text-center bg-rose-50 text-rose-800 border border-rose-200";
      feedback.textContent = message;
      feedback.classList.remove("hidden");
    }

    if (form) {
      form.addEventListener("submit", async function (e) {
        e.preventDefault();

        // 1. Protecció Anti-Spam: Honeypot
        if (honeypot && honeypot.value.trim() !== "") {
          // Detectat bot: simular èxit discretament sense processar
          showStatus(isVal ? "Gràcies! Hem rebut la consulta." : "¡Gracias! Hemos recibido tu consulta.");
          form.reset();
          return;
        }

        // 2. Protecció Anti-Spam: Rate Limit (Mínim 30 segons entre enviaments)
        const RATE_KEY = "last_contact_submission";
        const lastSubmission = localStorage.getItem(RATE_KEY);
        const now = Date.now();
        if (lastSubmission && now - parseInt(lastSubmission, 10) < 30 * 1000) {
          const remainingSecs = Math.ceil((30 * 1000 - (now - parseInt(lastSubmission, 10))) / 1000);
          showStatus(isVal ? `Espera ${remainingSecs} segons abans d'enviar un altre missatge.` : `Espera ${remainingSecs} segundos antes de enviar otro mensaje.`, false);
          return;
        }

        // 3. Validació accessible
        let hasErrors = false;

        if (!nameInput.value.trim()) {
          nameError.classList.remove("hidden");
          nameInput.classList.add("border-rose-400");
          hasErrors = true;
        } else {
          nameError.classList.add("hidden");
          nameInput.classList.remove("border-rose-400");
        }

        messageError.classList.add("hidden");
        messageInput.classList.remove("border-rose-400");

        if (hasErrors) {
          const firstErr = form.querySelector(".border-rose-400");
          if (firstErr) firstErr.focus();
          return;
        }

        // 4. Preparació de dades
        const payload = {
          name: nameInput.value.trim(),
          phone: phoneInput.value.trim(),
          service: serviceSelect?.selectedOptions[0]?.text || "Consulta general",
          extra: document.getElementById("contact-extra")?.value || "cap",
          extraLabel: extraSelect?.selectedOptions[0]?.text || (isVal ? "Cap" : "Ninguno"),
          budget: budgetSelect ? budgetSelect.value : "a-definir",
          budgetLabel: budgetSelect?.selectedOptions[0]?.text || "A definir",
          message: messageInput.value.trim(),
        };

        // Feedback de càrrega
        if (submitBtn) submitBtn.disabled = true;
        if (submitBtnText) submitBtnText.textContent = isVal ? "Tramitant el missatge..." : "Preparando el mensaje...";

        try {
          // Registre de la marca temporal anti-spam
          localStorage.setItem(RATE_KEY, now.toString());

          // Registre d'esdeveniment a l'analítica respectuosa
          if (typeof window.plausible === "function") {
            window.plausible("form_submit", {
              props: { service: payload.service, budget: payload.budget },
            });
          }

          // Enviament via servei serverless sense backend propi (Web3Forms / Formspree ready)
          // Nota: Si no s'ha configurat access_key externa, s'obre el client amb el missatge preformatat.
          const mailtoBody = encodeURIComponent(
            `${isVal ? "Nom" : "Nombre"}: ${payload.name}\n` +
            `${isVal ? "Telèfon" : "Teléfono"}: ${payload.phone || (isVal ? "No indicat" : "No indicado")}\n` +
            `${isVal ? "Servei d'interès" : "Servicio de interés"}: ${payload.service}\n` +
            `${isVal ? "Extres" : "Extras"}: ${payload.extraLabel}\n` +
            `${isVal ? "Pressupost orientatiu" : "Presupuesto orientativo"}: ${payload.budgetLabel}\n\n` +
            `${isVal ? "Situació i objectius" : "Situación y objetivos"}:\n${payload.message || (isVal ? "No indicats" : "No indicados")}`
          );
          const mailtoUrl = `mailto:jaumetur3w@gmail.com?subject=${encodeURIComponent((isVal ? "Nova proposta de projecte: " : "Nueva propuesta de proyecto: ") + payload.service)}&body=${mailtoBody}`;

          setTimeout(() => {
            window.location.href = mailtoUrl;
            showStatus(isVal ? "La consulta està preparada. Revisa-la i confirma l'enviament des del client de correu." : "La consulta está preparada. Revísala y confirma el envío desde tu cliente de correo.", true);
            form.reset();
            if (submitBtn) submitBtn.disabled = false;
            if (submitBtnText) submitBtnText.textContent = isVal ? "Obrir correu amb la proposta preparada" : "Abrir correo con la propuesta preparada";
          }, 400);

        } catch (err) {
          showStatus(isVal ? "No s'ha pogut tramitar el formulari automàticament. Pots escriure a jaumetur3w@gmail.com." : "No se ha podido preparar el formulario automáticamente. Puedes escribir a jaumetur3w@gmail.com.", false);
          if (submitBtn) submitBtn.disabled = false;
          if (submitBtnText) submitBtnText.textContent = isVal ? "Obrir correu amb la proposta preparada" : "Abrir correo con la propuesta preparada";
        }
      });
    }
  })();
</script>

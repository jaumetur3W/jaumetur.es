---
import { Icon } from "astro-icon/components";
import { localeFromPath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
---

<form
  id="contact-form"
  class="needs-validation space-y-4"
  novalidate
  aria-label={isEn ? "Direct contact form" : "Formulario de contacto directo"}>
  
  <!-- Anti-spam Honeypot Field -->
  <div class="hidden" aria-hidden="true">
    <label for="honeypot-field">{isEn ? "Do not fill this field if you are human" : "No rellenes este campo si eres una persona"}</label>
    <input
      type="text"
      name="_gotcha"
      id="honeypot-field"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <!-- Nombre Completo -->
  <div>
    <label for="contact-name" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 mb-1">
      {isEn ? "Full Name" : "Nombre"} <span class="text-rose-500" aria-label={isEn ? "required" : "obligatorio"}>*</span>
    </label>
    <div class="relative">
      <input
        id="contact-name"
        type="text"
        name="name"
        placeholder={isEn ? "What is your name?" : "¿Cómo te llamas?"}
        required
        aria-required="true"
        aria-describedby="name-error"
        class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-slate-900 placeholder:text-slate-400 transition"
      />
    </div>
    <p id="name-error" class="hidden text-rose-600 text-xs mt-1 font-sans" role="alert">
      {isEn ? "Please indicate your name so I know how to address you." : "Indica tu nombre para poder dirigirme a ti."}
    </p>
  </div>

  <div>
    <label for="contact-phone" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 mb-1">
      {isEn ? "Phone (optional)" : "Teléfono (opcional)"}
    </label>
    <input
      id="contact-phone"
      type="tel"
      name="phone"
      autocomplete="tel"
      placeholder={isEn ? "Only if you prefer a phone call" : "Solo si prefieres que te llame"}
      class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-slate-900 placeholder:text-slate-400 transition"
    />
  </div>

  <!-- Tipo de Servicio / Proyecto -->
  <div class="grid sm:grid-cols-2 gap-3">
    <div>
      <label for="contact-service" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 mb-1">
        {isEn ? "Primary product or service" : "Producto o servicio principal"}
      </label>
      <select
        id="contact-service"
        name="service"
        class="w-full px-3 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-slate-800 transition">
        <option value="landing-page" selected>{isEn ? "New website or redesign" : "Nueva web o renovación de la actual"}</option>
        <option value="angular-webapp">Web App SPA (Angular / TypeScript)</option>
        <option value="performance-audit">{isEn ? "Performance optimization (60 FPS & CWV)" : "Optimización 60 FPS y WCAG AA"}</option>
        <option value="cicd-devops">Pipelines CI/CD & DevOps</option>
        <option value="contractacio">{isEn ? "Career / Team opportunity" : "Oportunidad laboral / equipo"}</option>
        <option value="altre">{isEn ? "Other technical inquiry" : "Otra consulta técnica"}</option>
      </select>
    </div>

    <div>
      <label for="contact-extra" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 mb-1">
        {isEn ? "Optional add-ons" : "Extras opcionales"}
      </label>
      <select
        id="contact-extra"
        name="extra"
        class="w-full px-3 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-slate-800 transition">
        <option value="cap" selected>{isEn ? "Not sure yet / none" : "Aún no lo sé / ninguno"}</option>
        <option value="rrss">{isEn ? "Social media management" : "Gestión de redes sociales"}</option>
        <option value="rrss-publicitat">{isEn ? "Social media management with ads" : "Gestión de redes sociales con publicidad"}</option>
        <option value="publicitat">{isEn ? "Website advertising setup" : "Integración de publicidad en la web"}</option>
        <option value="seo">{isEn ? "SEO & Analytics" : "SEO y analítica"}</option>
        <option value="accessibilitat">{isEn ? "Accessibility & Performance" : "Accesibilidad y rendimiento"}</option>
        <option value="altres">{isEn ? "Other add-ons (describe below)" : "Otros extras (explícalos más abajo)"}</option>
      </select>
    </div>
  </div>

  <div>
    <label for="contact-budget" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 mb-1">
      {isEn ? "Estimated budget (optional)" : "Presupuesto orientativo (opcional)"}
    </label>
    <select id="contact-budget" name="budget" class="w-full px-3 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-slate-800 transition">
      <option value="a-definir" selected>{isEn ? "To be defined" : "A definir"}</option>
      <option value="menys-1k">{isEn ? "Less than €1,000" : "Menos de 1.000 €"}</option>
      <option value="1k-3k">€1,000 - €3,000</option>
      <option value="mes-3k">{isEn ? "More than €3,000" : "Más de 3.000 €"}</option>
    </select>
  </div>

  <!-- Mensaje -->
  <div>
    <label for="contact-message" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 mb-1">
      {isEn ? "What do you need? (optional)" : "¿Qué necesitas? (opcional)"}
    </label>
    <textarea
      id="contact-message"
      name="message"
      aria-describedby="message-error"
      placeholder={isEn ? "Project goals, desired timeline, technical requirements, or any questions..." : "Objetivo del proyecto, plazos deseados, detalles técnicos o cualquier duda..."}
      rows="4"
      class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-slate-900 placeholder:text-slate-400 transition"
    ></textarea>
    <p id="message-error" class="hidden text-rose-600 text-xs mt-1 font-sans" role="alert">
      {isEn ? "Please write a few lines to explain your project." : "Escribe unas líneas para explicar tu consulta."}
    </p>
  </div>

  <!-- Botones de Acción de Contacto -->
  <div class="space-y-2 pt-1">
    <button
      type="submit"
      id="contact-submit-btn"
      class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 rounded-xl bg-slate-950 hover:bg-[#FFFF00] text-white hover:text-slate-950 font-mono text-xs uppercase tracking-wider font-semibold border border-slate-950 shadow-xs transition-colors group cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
      <Icon name="bx:paper-plane" class="w-4 h-4 text-slate-400 group-hover:text-slate-950 group-hover:scale-110 group-hover:translate-x-0.5 transition-transform" />
      <span id="submit-btn-text">{isEn ? "Open email with prepared proposal" : "Abrir correo con la propuesta preparada"}</span>
    </button>
  </div>

  <!-- Banner de Estado Accesible (Live Region) -->
  <div
    id="form-feedback"
    class="hidden p-3 rounded-xl text-xs font-mono text-center transition-all"
    role="status"
    aria-live="polite">
  </div>

  <p class="text-[11px] text-slate-400 text-center font-sans">
    {isEn
      ? "Inquiring carries no obligation. Name is required; phone and other fields are optional. Submitting opens your email client with the pre-formatted proposal ready to send."
      : "La consulta no implica ningún compromiso. El nombre es obligatorio; el teléfono y el resto de datos son opcionales. Al enviarla, se abrirá tu cliente de correo para que confirmes el envío."}
  </p>
</form>

<script is:inline>
  (function () {
    const form = document.getElementById("contact-form");
    const isEn = window.location.pathname === "/en" || window.location.pathname.startsWith("/en/");
    const feedback = document.getElementById("form-feedback");
    const submitBtn = document.getElementById("contact-submit-btn");
    const submitBtnText = document.getElementById("submit-btn-text");
    const honeypot = document.getElementById("honeypot-field");

    const nameInput = document.getElementById("contact-name");
    const phoneInput = document.getElementById("contact-phone");
    const messageInput = document.getElementById("contact-message");
    const serviceSelect = document.getElementById("contact-service");
    const budgetSelect = document.getElementById("contact-budget");
    const extraSelect = document.getElementById("contact-extra");

    const nameError = document.getElementById("name-error");
    const messageError = document.getElementById("message-error");

    // Sincronizar parámetro URL ?servei= con el selector
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const preselectedService = urlParams.get("servei");
      if (preselectedService && serviceSelect) {
        serviceSelect.value = preselectedService;
      }
    } catch (_) {}

    function showStatus(message, isSuccess = true) {
      if (!feedback) return;
      feedback.className = isSuccess
        ? "p-3 rounded-xl text-xs font-mono text-center bg-emerald-50 text-emerald-800 border border-emerald-200"
        : "p-3 rounded-xl text-xs font-mono text-center bg-rose-50 text-rose-800 border border-rose-200";
      feedback.textContent = message;
      feedback.classList.remove("hidden");
    }

    if (form) {
      form.addEventListener("submit", async function (e) {
        e.preventDefault();

        // 1. Protección Anti-Spam: Honeypot
        if (honeypot && honeypot.value.trim() !== "") {
          showStatus(isEn ? "Thank you! We received your message." : "¡Gracias! Hemos recibido tu consulta.");
          form.reset();
          return;
        }

        // 2. Protección Anti-Spam: Rate Limit (Mínimo 30 segundos)
        const RATE_KEY = "last_contact_submission";
        const lastSubmission = localStorage.getItem(RATE_KEY);
        const now = Date.now();
        if (lastSubmission && now - parseInt(lastSubmission, 10) < 30 * 1000) {
          const remainingSecs = Math.ceil((30 * 1000 - (now - parseInt(lastSubmission, 10))) / 1000);
          showStatus(isEn ? `Please wait ${remainingSecs} seconds before submitting again.` : `Espera ${remainingSecs} segundos antes de enviar otro mensaje.`, false);
          return;
        }

        // 3. Validación accesible
        let hasErrors = false;

        if (!nameInput.value.trim()) {
          nameError.classList.remove("hidden");
          nameInput.classList.add("border-rose-400");
          hasErrors = true;
        } else {
          nameError.classList.add("hidden");
          nameInput.classList.remove("border-rose-400");
        }

        messageError.classList.add("hidden");
        messageInput.classList.remove("border-rose-400");

        if (hasErrors) {
          const firstErr = form.querySelector(".border-rose-400");
          if (firstErr) firstErr.focus();
          return;
        }

        // 4. Preparación de datos
        const payload = {
          name: nameInput.value.trim(),
          phone: phoneInput.value.trim(),
          service: serviceSelect?.selectedOptions[0]?.text || (isEn ? "General inquiry" : "Consulta general"),
          extra: document.getElementById("contact-extra")?.value || "cap",
          extraLabel: extraSelect?.selectedOptions[0]?.text || (isEn ? "None" : "Ninguno"),
          budget: budgetSelect ? budgetSelect.value : "a-definir",
          budgetLabel: budgetSelect?.selectedOptions[0]?.text || (isEn ? "To be defined" : "A definir"),
          message: messageInput.value.trim(),
        };

        if (submitBtn) submitBtn.disabled = true;
        if (submitBtnText) submitBtnText.textContent = isEn ? "Preparing message..." : "Preparando el mensaje...";

        try {
          localStorage.setItem(RATE_KEY, now.toString());

          if (typeof window.plausible === "function") {
            window.plausible("form_submit", {
              props: { service: payload.service, budget: payload.budget },
            });
          }

          const mailtoBody = encodeURIComponent(
            `${isEn ? "Name" : "Nombre"}: ${payload.name}\n` +
            `${isEn ? "Phone" : "Teléfono"}: ${payload.phone || (isEn ? "Not provided" : "No indicado")}\n` +
            `${isEn ? "Service of interest" : "Servicio de interés"}: ${payload.service}\n` +
            `${isEn ? "Add-ons" : "Extras"}: ${payload.extraLabel}\n` +
            `${isEn ? "Budget" : "Presupuesto orientativo"}: ${payload.budgetLabel}\n\n` +
            `${isEn ? "Project details & goals" : "Situación y objetivos"}:\n${payload.message || (isEn ? "Not provided" : "No indicados")}`
          );
          const mailtoUrl = `mailto:jaumetur3w@gmail.com?subject=${encodeURIComponent((isEn ? "New project proposal: " : "Nueva propuesta de proyecto: ") + payload.service)}&body=${mailtoBody}`;

          setTimeout(() => {
            window.location.href = mailtoUrl;
            showStatus(isEn ? "Your inquiry is prepared. Please review and confirm sending from your email client." : "La consulta está preparada. Revísala y confirma el envío desde tu cliente de correo.", true);
            form.reset();
            if (submitBtn) submitBtn.disabled = false;
            if (submitBtnText) submitBtnText.textContent = isEn ? "Open email with prepared proposal" : "Abrir correo con la propuesta preparada";
          }, 400);

        } catch (err) {
          showStatus(isEn ? "Could not prepare the email automatically. You can write directly to jaumetur3w@gmail.com." : "No se ha podido preparar el formulario automáticamente. Puedes escribir a jaumetur3w@gmail.com.", false);
          if (submitBtn) submitBtn.disabled = false;
          if (submitBtnText) submitBtnText.textContent = isEn ? "Open email with prepared proposal" : "Abrir correo con la propuesta preparada";
        }
      });
    }
  })();
</script>

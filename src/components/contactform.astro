---
import { Icon } from "astro-icon/components";
---

<form
  id="contact-form"
  class="needs-validation space-y-4"
  novalidate
  aria-label="Formulari de contacte directe">
  
  <!-- Anti-spam Honeypot Field (Ocult per a humans, els bots l'ompliran automàticament) -->
  <div class="hidden" aria-hidden="true">
    <label for="honeypot-field">No omplir aquest camp si ets humà</label>
    <input
      type="text"
      name="_gotcha"
      id="honeypot-field"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <!-- Nom Complet -->
  <div>
    <label for="contact-name" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 mb-1">
      Nom <span class="text-rose-500" aria-label="obligatori">*</span>
    </label>
    <div class="relative">
      <input
        id="contact-name"
        type="text"
        name="name"
        placeholder="Com et dius?"
        required
        aria-required="true"
        aria-describedby="name-error"
        class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-slate-900 placeholder:text-slate-400 transition"
      />
    </div>
    <p id="name-error" class="hidden text-rose-600 text-xs mt-1 font-sans" role="alert">
      Per favor, indica el teu nom per poder adreçar-me a tu.
    </p>
  </div>

  <div>
    <label for="contact-phone" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 mb-1">
      Telèfon (opcional)
    </label>
    <input
      id="contact-phone"
      type="tel"
      name="phone"
      autocomplete="tel"
      placeholder="Només si prefereixes que et telefone"
      class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-slate-900 placeholder:text-slate-400 transition"
    />
  </div>

  <!-- Tipus de Servei / Projecte -->
  <div class="grid sm:grid-cols-2 gap-3">
    <div>
      <label for="contact-service" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 mb-1">
        Producte o servei principal
      </label>
      <select
        id="contact-service"
        name="service"
        class="w-full px-3 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-slate-800 transition">
        <option value="landing-page" selected>Web nova o renovació de web</option>
        <option value="angular-webapp">Web App SPA (Angular / TypeScript)</option>
        <option value="performance-audit">Optimització 60 FPS & WCAG AA</option>
        <option value="cicd-devops">Pipelines CI/CD & DevOps</option>
        <option value="contractacio">Oportunitat Laboral / Equip</option>
        <option value="altre">Altra consulta tècnica</option>
      </select>
    </div>

    <div>
      <label for="contact-extra" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 mb-1">
        Extres opcionals
      </label>
      <select
        id="contact-extra"
        name="extra"
        class="w-full px-3 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-slate-800 transition">
        <option value="cap" selected>Encara no ho sé / cap</option>
        <option value="rrss">Gestió de xarxes socials (RRSS)</option>
        <option value="rrss-publicitat">Gestió de RRSS amb publicitat</option>
        <option value="publicitat">Integració de publicitat al web</option>
        <option value="seo">SEO i analítica</option>
        <option value="accessibilitat">Accessibilitat i rendiment</option>
        <option value="altres">Altres extres (explica-ho baix)</option>
      </select>
    </div>
  </div>

  <div>
    <label for="contact-budget" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 mb-1">
      Pressupost orientatiu (opcional)
    </label>
    <select id="contact-budget" name="budget" class="w-full px-3 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-slate-800 transition">
      <option value="a-definir" selected>A definir</option>
      <option value="menys-1k">Menys de 1.000 €</option>
      <option value="1k-3k">1.000 € - 3.000 €</option>
      <option value="mes-3k">Més de 3.000 €</option>
    </select>
  </div>

  <!-- Missatge -->
  <div>
    <label for="contact-message" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 mb-1">
      Què necessites? (opcional)
    </label>
    <textarea
      id="contact-message"
      name="message"
      aria-describedby="message-error"
      placeholder="Objectiu del projecte, terminis desitjats, detalls tècnics o qualsevol dubte..."
      rows="4"
      class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-slate-900 placeholder:text-slate-400 transition"
    ></textarea>
    <p id="message-error" class="hidden text-rose-600 text-xs mt-1 font-sans" role="alert">
      Per favor, escriu unes línies explicant la teua consulta.
    </p>
  </div>

  <!-- Botó d'Enviament -->
  <button
    type="submit"
    id="contact-submit-btn"
    class="w-full inline-flex items-center justify-center gap-2 py-3 px-6 rounded-xl bg-slate-900 hover:bg-indigo-600 text-white font-bold text-xs sm:text-sm shadow-md transition group cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
    <Icon name="bx:paper-plane" class="w-4 h-4 text-indigo-400 group-hover:scale-110 group-hover:translate-x-0.5 transition-transform" />
      <span id="submit-btn-text">Preparar correu amb la consulta</span>
  </button>

  <!-- Banner d'Estat Accessible (Live Region) -->
  <div
    id="form-feedback"
    class="hidden p-3 rounded-xl text-xs font-mono text-center transition-all"
    role="status"
    aria-live="polite">
  </div>

  <p class="text-[11px] text-slate-400 text-center font-sans">
    La consulta és sense compromís. El nom és necessari; el telèfon i la resta de detalls són opcionals. En enviar-la, s'obrirà el teu client de correu perquè confirmes l'enviament.
  </p>
</form>

<script is:inline>
  (function () {
    const form = document.getElementById("contact-form");
    const feedback = document.getElementById("form-feedback");
    const submitBtn = document.getElementById("contact-submit-btn");
    const submitBtnText = document.getElementById("submit-btn-text");
    const honeypot = document.getElementById("honeypot-field");

    const nameInput = document.getElementById("contact-name");
    const phoneInput = document.getElementById("contact-phone");
    const messageInput = document.getElementById("contact-message");
    const serviceSelect = document.getElementById("contact-service");
    const budgetSelect = document.getElementById("contact-budget");

    const nameError = document.getElementById("name-error");
    const messageError = document.getElementById("message-error");

    // Sincronitzar paràmetre URL ?servei= amb el selector
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const preselectedService = urlParams.get("servei");
      if (preselectedService && serviceSelect) {
        serviceSelect.value = preselectedService;
      }
    } catch (_) {}

    function showStatus(message, isSuccess = true) {
      if (!feedback) return;
      feedback.className = isSuccess
        ? "p-3 rounded-xl text-xs font-mono text-center bg-emerald-50 text-emerald-800 border border-emerald-200"
        : "p-3 rounded-xl text-xs font-mono text-center bg-rose-50 text-rose-800 border border-rose-200";
      feedback.textContent = message;
      feedback.classList.remove("hidden");
    }

    if (form) {
      form.addEventListener("submit", async function (e) {
        e.preventDefault();

        // 1. Protecció Anti-Spam: Honeypot
        if (honeypot && honeypot.value.trim() !== "") {
          // Detectat bot: simular èxit discretament sense processar
          showStatus("Gràcies! Hem rebut la teua consulta.");
          form.reset();
          return;
        }

        // 2. Protecció Anti-Spam: Rate Limit (Mínim 30 segons entre enviaments)
        const RATE_KEY = "last_contact_submission";
        const lastSubmission = localStorage.getItem(RATE_KEY);
        const now = Date.now();
        if (lastSubmission && now - parseInt(lastSubmission, 10) < 30 * 1000) {
          const remainingSecs = Math.ceil((30 * 1000 - (now - parseInt(lastSubmission, 10))) / 1000);
          showStatus(`Per favor, espera ${remainingSecs} segons abans de tramitar un altre missatge.`, false);
          return;
        }

        // 3. Validació accessible
        let hasErrors = false;

        if (!nameInput.value.trim()) {
          nameError.classList.remove("hidden");
          nameInput.classList.add("border-rose-400");
          hasErrors = true;
        } else {
          nameError.classList.add("hidden");
          nameInput.classList.remove("border-rose-400");
        }

        messageError.classList.add("hidden");
        messageInput.classList.remove("border-rose-400");

        if (hasErrors) {
          const firstErr = form.querySelector(".border-rose-400");
          if (firstErr) firstErr.focus();
          return;
        }

        // 4. Preparació de dades
        const payload = {
          name: nameInput.value.trim(),
          phone: phoneInput.value.trim(),
          service: serviceSelect?.selectedOptions[0]?.text || "Consulta general",
          extra: document.getElementById("contact-extra")?.value || "cap",
          extraLabel: document.getElementById("contact-extra")?.selectedOptions[0]?.text || "Cap",
          budget: budgetSelect ? budgetSelect.value : "a-definir",
          budgetLabel: budgetSelect?.selectedOptions[0]?.text || "A definir",
          message: messageInput.value.trim(),
        };

        // Feedback de càrrega
        if (submitBtn) submitBtn.disabled = true;
        if (submitBtnText) submitBtnText.textContent = "Tramitant missatge...";

        try {
          // Registre de la marca temporal anti-spam
          localStorage.setItem(RATE_KEY, now.toString());

          // Registre d'esdeveniment a l'analítica respectuosa
          if (typeof window.plausible === "function") {
            window.plausible("form_submit", {
              props: { service: payload.service, budget: payload.budget },
            });
          }

          // Enviament via servei serverless sense backend propi (Web3Forms / Formspree ready)
          // Nota: Si no s'ha configurat access_key externa, s'obre el client amb el missatge preformatat.
          const mailtoBody = encodeURIComponent(
            `Nom: ${payload.name}\n` +
            `Telèfon: ${payload.phone || "No indicat"}\n` +
            `Servei d'interès: ${payload.service}\n` +
            `Extres: ${payload.extraLabel}\n` +
            `Pressupost orientatiu: ${payload.budgetLabel}\n\n` +
            `Situació i objectius:\n${payload.message || "No indicats"}`
          );
          const mailtoUrl = `mailto:jaumetur3w@gmail.com?subject=${encodeURIComponent("Nova proposta de projecte: " + payload.service)}&body=${mailtoBody}`;

          setTimeout(() => {
            window.location.href = mailtoUrl;
            showStatus("La consulta està preparada. Revisa-la i confirma l'enviament des del teu client de correu.", true);
            form.reset();
            if (submitBtn) submitBtn.disabled = false;
            if (submitBtnText) submitBtnText.textContent = "Enviar proposta / consulta";
          }, 400);

        } catch (err) {
          showStatus("No s'ha pogut tramitar el formulari automàticament. Pots escriure directament a jaumetur3w@gmail.com", false);
          if (submitBtn) submitBtn.disabled = false;
          if (submitBtnText) submitBtnText.textContent = "Enviar proposta / consulta";
        }
      });
    }
  })();
</script>

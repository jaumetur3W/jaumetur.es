---
import { Icon } from "astro-icon/components";
import { localeFromPath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
// Astro inlines PUBLIC_ variables at build time; the inline script reads the key from this attribute.
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";
---

<form
  id="contact-form"
  class="needs-validation space-y-4"
  novalidate
  data-web3forms-key={web3formsKey}
  aria-label={isEn ? "Direct contact form" : "Formulario de contacto directo"}>

  <!-- Anti-spam Honeypot Field -->
  <div class="hidden" aria-hidden="true">
    <label for="honeypot-field">{isEn ? "Do not fill this field if you are human" : "No rellenes este campo si eres una persona"}</label>
    <input
      type="text"
      name="botcheck"
      id="honeypot-field"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <!-- Nombre Completo -->
  <div>
    <label for="contact-name" class="field-label">
      {isEn ? "Full Name" : "Nombre"} <span class="text-[#9b1c1c]" aria-label={isEn ? "required" : "obligatorio"}>*</span>
    </label>
    <div class="relative">
      <input
        id="contact-name"
        type="text"
        name="name"
        placeholder={isEn ? "What is your name?" : "¿Cómo te llamas?"}
        required
        aria-required="true"
        aria-describedby="name-error"
        class="field"
      />
    </div>
    <p id="name-error" class="hidden text-[#9b1c1c] text-sm mt-1.5 font-sans" role="alert">
      {isEn ? "Please indicate your name so I know how to address you." : "Indica tu nombre para poder dirigirme a ti."}
    </p>
  </div>

  <!-- Correo de respuesta -->
  <div>
    <label for="contact-email" class="field-label">
      {isEn ? "Email" : "Correo electrónico"} <span class="text-[#9b1c1c]" aria-label={isEn ? "required" : "obligatorio"}>*</span>
    </label>
    <input
      id="contact-email"
      type="email"
      name="email"
      autocomplete="email"
      placeholder={isEn ? "Where can I reply to you?" : "¿Dónde puedo responderte?"}
      required
      aria-required="true"
      aria-describedby="email-error"
      class="field"
    />
    <p id="email-error" class="hidden text-[#9b1c1c] text-sm mt-1.5 font-sans" role="alert">
      {isEn ? "Please enter a valid email so I can reply to you." : "Indica un correo válido para poder responderte."}
    </p>
  </div>

  <div>
    <label for="contact-phone" class="field-label">
      {isEn ? "Phone (optional)" : "Teléfono (opcional)"}
    </label>
    <input
      id="contact-phone"
      type="tel"
      name="phone"
      autocomplete="tel"
      placeholder={isEn ? "Only if you prefer a phone call" : "Solo si prefieres que te llame"}
      class="field"
    />
  </div>

  <!-- Tipo de Servicio / Proyecto -->
  <div class="grid sm:grid-cols-2 gap-3">
    <div>
      <label for="contact-service" class="field-label">
        {isEn ? "Primary product or service" : "Producto o servicio principal"}
      </label>
      <select
        id="contact-service"
        name="service"
        class="field">
        <option value="digitalitzacio-local">{isEn ? "Local digitization and web menu" : "Digitalización local"}</option>
        <option value="landing-page" selected>{isEn ? "New website or redesign" : "Nueva web o renovación de la actual"}</option>
        <option value="angular-webapp">Web App SPA (Angular / TypeScript)</option>
        <option value="performance-audit">{isEn ? "Performance optimization (60 FPS & CWV)" : "Optimización 60 FPS y WCAG AA"}</option>
        <option value="cicd-devops">Pipelines CI/CD & DevOps</option>
        <option value="lanzamiento">{isEn ? "Launch offer (first clients)" : "Oferta de lanzamiento (primeros clientes)"}</option>
        <option value="contractacio">{isEn ? "Career / Team opportunity" : "Oportunidad laboral / equipo"}</option>
        <option value="altre">{isEn ? "Other technical inquiry" : "Otra consulta técnica"}</option>
      </select>
    </div>

    <div>
      <label for="contact-extra" class="field-label">
        {isEn ? "Optional add-ons" : "Extras opcionales"}
      </label>
      <select
        id="contact-extra"
        name="extra"
        class="field">
        <option value="cap" selected>{isEn ? "Not sure yet / none" : "Aún no lo sé / ninguno"}</option>
        <option value="rrss">{isEn ? "Social media management" : "Gestión de redes sociales"}</option>
        <option value="rrss-publicitat">{isEn ? "Social media management with ads" : "Gestión de redes sociales con publicidad"}</option>
        <option value="publicitat">{isEn ? "Website advertising setup" : "Integración de publicidad en la web"}</option>
        <option value="seo">{isEn ? "SEO & Analytics" : "SEO y analítica"}</option>
        <option value="accessibilitat">{isEn ? "Accessibility & Performance" : "Accesibilidad y rendimiento"}</option>
        <option value="altres">{isEn ? "Other add-ons (describe below)" : "Otros extras (explícalos más abajo)"}</option>
      </select>
    </div>
  </div>

  <div>
    <label for="contact-budget" class="field-label">
      {isEn ? "Estimated budget (optional)" : "Presupuesto orientativo (opcional)"}
    </label>
    <select id="contact-budget" name="budget" class="field">
      <option value="a-definir" selected>{isEn ? "To be defined" : "A definir"}</option>
      <option value="menys-1k">{isEn ? "Less than €1,000" : "Menos de 1.000 €"}</option>
      <option value="1k-3k">€1,000 - €3,000</option>
      <option value="mes-3k">{isEn ? "More than €3,000" : "Más de 3.000 €"}</option>
    </select>
  </div>

  <!-- Mensaje -->
  <div>
    <label for="contact-message" class="field-label">
      {isEn ? "What do you need? (optional)" : "¿Qué necesitas? (opcional)"}
    </label>
    <textarea
      id="contact-message"
      name="message"
      aria-describedby="message-error"
      placeholder={isEn ? "Project goals, desired timeline, technical requirements, or any questions..." : "Objetivo del proyecto, plazos deseados, detalles técnicos o cualquier duda..."}
      rows="4"
      class="field"
    ></textarea>
    <p id="message-error" class="hidden text-[#9b1c1c] text-sm mt-1.5 font-sans" role="alert">
      {isEn ? "Please write a few lines to explain your project." : "Escribe unas líneas para explicar tu consulta."}
    </p>
  </div>

  <!-- Botones de Acción de Contacto -->
  <div class="space-y-2 pt-1">
    <button
      type="submit"
      id="contact-submit-btn"
      class="btn btn-brand w-full disabled:cursor-not-allowed disabled:opacity-50">
      <Icon name="bx:paper-plane" class="h-5 w-5" />
      <span id="submit-btn-text">{isEn ? "Send inquiry" : "Enviar consulta"}</span>
    </button>
  </div>

  <!-- Banner de Estado Accesible (Live Region) -->
  <div
    id="form-feedback"
    class="hidden rounded-sm p-4 text-center text-sm font-semibold"
    role="status"
    aria-live="polite">
  </div>

  <p class="text-[0.82rem] text-ink/75 text-center font-sans">
    {isEn
      ? "Inquiring carries no obligation. Name and email are required; phone and other fields are optional."
      : "La consulta no implica ningún compromiso. El nombre y el correo son obligatorios; el teléfono y el resto de datos son opcionales."}
  </p>
</form>

<script is:inline>
  (function () {
    const form = document.getElementById("contact-form");
    const isEn = window.location.pathname === "/en" || window.location.pathname.startsWith("/en/");
    const feedback = document.getElementById("form-feedback");
    const submitBtn = document.getElementById("contact-submit-btn");
    const submitBtnText = document.getElementById("submit-btn-text");
    const honeypot = document.getElementById("honeypot-field");

    const WEB3FORMS_URL = "https://api.web3forms.com/submit";
    const SUBMIT_TIMEOUT_MS = 15000;
    const submitLabel = submitBtnText ? submitBtnText.textContent : "";

    const nameInput = document.getElementById("contact-name");
    const emailInput = document.getElementById("contact-email");
    const phoneInput = document.getElementById("contact-phone");
    const messageInput = document.getElementById("contact-message");
    const serviceSelect = document.getElementById("contact-service");
    const budgetSelect = document.getElementById("contact-budget");
    const extraSelect = document.getElementById("contact-extra");

    const nameError = document.getElementById("name-error");
    const emailError = document.getElementById("email-error");
    const messageError = document.getElementById("message-error");

    // Sincronizar parámetro URL ?servei= con el selector
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const preselectedService = urlParams.get("servei");
      // Un valor desconocido dejaría el selector vacío: se conserva la opción por defecto.
      if (
        preselectedService &&
        serviceSelect &&
        Array.from(serviceSelect.options).some((option) => option.value === preselectedService)
      ) {
        serviceSelect.value = preselectedService;
      }
    } catch (_) {}

    function showStatus(message, isSuccess = true) {
      if (!feedback) return;
      feedback.className = isSuccess
        ? "rounded-sm p-4 text-center text-sm font-semibold bg-[#ffff00] text-[#111111]"
        : "rounded-sm p-4 text-center text-sm font-semibold border-2 border-[#ff9b9b] text-[#9b1c1c]";
      feedback.textContent = message;
      feedback.classList.remove("hidden");
    }

    if (form) {
      form.addEventListener("submit", async function (e) {
        e.preventDefault();

        // 1. Protección Anti-Spam: Honeypot
        if (honeypot && honeypot.value.trim() !== "") {
          showStatus(isEn ? "Thank you! We received your message." : "¡Gracias! Hemos recibido tu consulta.");
          form.reset();
          return;
        }

        // 2. Protección Anti-Spam: Rate Limit (Mínimo 30 segundos)
        const RATE_KEY = "last_contact_submission";
        let lastSubmission = null;
        try {
          lastSubmission = localStorage.getItem(RATE_KEY);
        } catch (_) {}
        const now = Date.now();
        if (lastSubmission && now - parseInt(lastSubmission, 10) < 30 * 1000) {
          const remainingSecs = Math.ceil((30 * 1000 - (now - parseInt(lastSubmission, 10))) / 1000);
          showStatus(isEn ? `Please wait ${remainingSecs} seconds before submitting again.` : `Espera ${remainingSecs} segundos antes de enviar otro mensaje.`, false);
          return;
        }

        // 3. Validación accesible
        let hasErrors = false;

        if (!nameInput.value.trim()) {
          nameError.classList.remove("hidden");
          nameInput.classList.add("border-rose-400");
          hasErrors = true;
        } else {
          nameError.classList.add("hidden");
          nameInput.classList.remove("border-rose-400");
        }

        if (!emailInput.validity.valid) {
          emailError.classList.remove("hidden");
          emailInput.classList.add("border-rose-400");
          hasErrors = true;
        } else {
          emailError.classList.add("hidden");
          emailInput.classList.remove("border-rose-400");
        }

        messageError.classList.add("hidden");
        messageInput.classList.remove("border-rose-400");

        if (hasErrors) {
          const firstErr = form.querySelector(".border-rose-400");
          if (firstErr) firstErr.focus();
          return;
        }

        // 4. Preparación de datos
        const payload = {
          name: nameInput.value.trim(),
          email: emailInput.value.trim(),
          phone: phoneInput.value.trim(),
          service: serviceSelect?.selectedOptions[0]?.text || (isEn ? "General inquiry" : "Consulta general"),
          extra: document.getElementById("contact-extra")?.value || "cap",
          extraLabel: extraSelect?.selectedOptions[0]?.text || (isEn ? "None" : "Ninguno"),
          budget: budgetSelect ? budgetSelect.value : "a-definir",
          budgetLabel: budgetSelect?.selectedOptions[0]?.text || (isEn ? "To be defined" : "A definir"),
          message: messageInput.value.trim(),
        };

        if (submitBtn) submitBtn.disabled = true;
        if (submitBtnText) submitBtnText.textContent = isEn ? "Sending…" : "Enviando…";
        if (feedback) feedback.classList.add("hidden");

        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), SUBMIT_TIMEOUT_MS);

        try {
          const accessKey = form.dataset.web3formsKey;
          if (!accessKey) throw new Error("Missing Web3Forms key");

          const notProvided = isEn ? "Not provided" : "No indicado";
          const response = await fetch(WEB3FORMS_URL, {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify({
              access_key: accessKey,
              subject: (isEn ? "New project proposal: " : "Nueva propuesta de proyecto: ") + payload.service,
              from_name: "jaumetur.es",
              name: payload.name,
              email: payload.email,
              phone: payload.phone || notProvided,
              service: payload.service,
              extras: payload.extraLabel,
              budget: payload.budgetLabel,
              message: payload.message || notProvided,
            }),
            signal: controller.signal,
          });
          const result = await response.json().catch(() => null);
          if (!response.ok || !result || result.success !== true) {
            throw new Error("Web3Forms rejected the submission");
          }

          form.reset();
          showStatus(isEn ? "Message sent. Thank you for getting in touch!" : "Mensaje enviado. ¡Gracias por escribirme!", true);

          // El envío ya es correcto: un fallo aquí no debe mostrarse como error del formulario.
          try {
            localStorage.setItem(RATE_KEY, now.toString());
            if (typeof window.plausible === "function") {
              window.plausible("form_submit", {
                props: { service: payload.service, budget: payload.budget },
              });
            }
          } catch (_) {}
        } catch (err) {
          showStatus(isEn ? "Your message could not be sent and your details are still in the form. Please try again or write to jaumetur3w@gmail.com." : "No se ha podido enviar el mensaje y tus datos siguen en el formulario. Vuelve a intentarlo o escribe a jaumetur3w@gmail.com.", false);
        } finally {
          clearTimeout(timeoutId);
          if (submitBtn) submitBtn.disabled = false;
          if (submitBtnText) submitBtnText.textContent = submitLabel;
        }
      });
    }
  })();
</script>


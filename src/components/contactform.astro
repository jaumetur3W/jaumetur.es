---
import Button from "./ui/button.astro";
---

<form
  id="form"
  class="needs-validation space-y-4"
  novalidate>
  
  <div>
    <label for="name" class="block text-xs font-mono uppercase tracking-wider text-slate-700 mb-1">
      Nom complet <span class="text-red-500">*</span>
    </label>
    <input
      id="name"
      type="text"
      placeholder="El teu nom"
      required
      class="w-full px-4 py-2.5 text-sm border-2 placeholder:text-gray-400 rounded-md outline-hidden focus:ring-2 border-gray-300 focus:border-slate-800 ring-slate-100 transition"
      name="name"
    />
    <div class="empty-feedback invalid-feedback text-red-500 text-xs mt-1">
      Per favor, indica el teu nom.
    </div>
  </div>

  <div>
    <label for="email_address" class="block text-xs font-mono uppercase tracking-wider text-slate-700 mb-1">
      Correu electrònic <span class="text-red-500">*</span>
    </label>
    <input
      id="email_address"
      type="email"
      placeholder="nom@exemple.com"
      name="email"
      required
      class="w-full px-4 py-2.5 text-sm border-2 placeholder:text-gray-400 rounded-md outline-hidden focus:ring-2 border-gray-300 focus:border-slate-800 ring-slate-100 transition"
    />
    <div class="empty-feedback text-red-500 text-xs mt-1">
      Per favor, indica el teu correu electrònic.
    </div>
    <div class="invalid-feedback text-red-500 text-xs mt-1">
      Per favor, indica un correu electrònic vàlid.
    </div>
  </div>

  <div>
    <label for="subject" class="block text-xs font-mono uppercase tracking-wider text-slate-700 mb-1">
      Assumpte
    </label>
    <input
      id="subject"
      type="text"
      placeholder="Proposta de projecte / Oportunitat laboral"
      name="subject"
      class="w-full px-4 py-2.5 text-sm border-2 placeholder:text-gray-400 rounded-md outline-hidden focus:ring-2 border-gray-300 focus:border-slate-800 ring-slate-100 transition"
    />
  </div>

  <div>
    <label for="message" class="block text-xs font-mono uppercase tracking-wider text-slate-700 mb-1">
      Missatge <span class="text-red-500">*</span>
    </label>
    <textarea
      id="message"
      name="message"
      required
      placeholder="Escriu breument la teua proposta o consulta..."
      rows="4"
      class="w-full px-4 py-2.5 text-sm border-2 placeholder:text-gray-400 rounded-md outline-hidden focus:ring-2 border-gray-300 focus:border-slate-800 ring-slate-100 transition"
    ></textarea>
    <div class="empty-feedback invalid-feedback text-red-500 text-xs mt-1">
      Per favor, escriu el teu missatge.
    </div>
  </div>

  <Button type="submit" size="lg" block>
    Enviar missatge
  </Button>
  <div id="result" class="mt-3 text-center text-xs font-medium"></div>
</form>

<style>
  .invalid-feedback,
  .empty-feedback {
    display: none;
  }

  .was-validated :placeholder-shown:invalid ~ .empty-feedback {
    display: block;
  }

  .was-validated :not(:placeholder-shown):invalid ~ .invalid-feedback {
    display: block;
  }

  .is-invalid,
  .was-validated :invalid {
    border-color: #ef4444;
  }
</style>

<script is:inline>
  const form = document.getElementById("form");
  const result = document.getElementById("result");

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    form.classList.add("was-validated");
    if (!form.checkValidity()) {
      const firstInvalid = form.querySelector(":invalid");
      if (firstInvalid) firstInvalid.focus();
      return;
    }

    const formData = new FormData(form);
    const name = formData.get("name") || "";
    const email = formData.get("email") || "";
    const subject = formData.get("subject") || "Contacte des de la web de Jaume Tur";
    const message = formData.get("message") || "";

    result.className = "mt-3 text-center text-xs font-medium text-slate-700";
    result.innerHTML = "S'està obrint el teu client de correu...";

    // Use mailto link for direct client communication with Jaume Tur
    const mailtoBody = encodeURIComponent(
      `Nom: ${name}\nCorreu: ${email}\n\nMissatge:\n${message}`
    );
    const mailtoUrl = `mailto:jautursis@alu.edu.gva.es?subject=${encodeURIComponent(subject)}&body=${mailtoBody}`;

    setTimeout(() => {
      window.location.href = mailtoUrl;
      result.className = "mt-3 text-center text-xs font-medium text-emerald-600";
      result.innerHTML = "Gràcies! S'ha obert el teu client de correu per a enviar el missatge.";
      form.reset();
      form.classList.remove("was-validated");
    }, 400);
  });
</script>

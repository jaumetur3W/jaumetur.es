---
import { Icon } from "astro-icon/components";
---

<div
  id="contacte"
  class="bg-[#090D16] p-8 sm:p-12 md:p-14 my-16 md:my-24 mx-auto max-w-5xl rounded-3xl flex flex-col md:flex-row items-center justify-between text-left gap-8 border border-slate-800/90 shadow-2xl relative overflow-hidden group reveal-fade-up scroll-mt-12">
  
  <!-- Subtle ambient indigo depth -->
  <div class="absolute -top-10 -right-10 w-96 h-96 bg-indigo-600/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-10 -left-10 w-80 h-80 bg-slate-800/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 max-w-xl">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 mb-4 shadow-2xs">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-40"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
      </span>
      <span>Disponible per a noves oportunitats</span>
    </div>

    <h2 class="text-white text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight">
      Creem alguna cosa <span class="bg-gradient-to-r from-indigo-400 via-indigo-300 to-white bg-clip-text text-transparent">extraordinària</span> junts?
    </h2>
    
    <p class="text-slate-300 mt-3 text-sm sm:text-base leading-relaxed">
      Tens una proposta de feina, un projecte web o necessites suport en arquitectura frontend? Parlem!
    </p>

    <!-- Visual Tech Chips with Standardized Icons -->
    <div class="flex flex-wrap gap-2 mt-5">
      <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-white/5 text-slate-300 border border-white/10 flex items-center gap-1.5">
        <Icon name="bx:map-pin" class="w-3.5 h-3.5 text-indigo-400" />
        <span>València (Remot / Híbrid)</span>
      </span>
      <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-white/5 text-slate-300 border border-white/10 flex items-center gap-1.5">
        <Icon name="simple-icons:angular" class="w-3.5 h-3.5 text-red-400" />
        <span>Angular & TypeScript</span>
      </span>
      <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-white/5 text-slate-300 border border-white/10 flex items-center gap-1.5">
        <Icon name="bx:git-repo-forked" class="w-3.5 h-3.5 text-blue-400" />
        <span>CI/CD GitHub Actions</span>
      </span>
    </div>

    <!-- Action Buttons with Standardized Icons -->
    <div class="flex flex-wrap items-center gap-3 mt-8">
      <a
        href="/contact"
        class="group/btn inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-sm bg-white text-slate-950 hover:bg-slate-100 shadow-xl shadow-black/30 hover:scale-[1.02] transition-all">
        <Icon name="bx:message-square-dots" class="w-4 h-4 text-slate-900 group-hover/btn:scale-110 transition-transform" />
        <span>Contactar ara</span>
      </a>
      <a
        href="/docs/CV_Jaume_tur.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="group/cv inline-flex items-center gap-2 px-5 py-3 rounded-xl font-semibold text-white bg-white/5 hover:bg-white/10 border border-white/15 backdrop-blur-xs transition text-sm">
        <Icon name="bx:file" class="w-4 h-4 text-white group-hover/cv:-translate-y-0.5 transition-transform" />
        <span>Descarregar CV</span>
        <span class="text-[11px] font-mono text-slate-400">↗</span>
      </a>
    </div>
  </div>

  <!-- Memoji 3.png - Anchored to contact pill -->
  <div class="relative z-20 shrink-0 flex flex-col items-center -mb-8 sm:-mb-14 -mt-2 sm:-mt-6 md:-mr-4 group/memoji">
    <div class="relative">
      <img
        src="/img/3.webp"
        alt="Jaume Tur"
        class="relative w-52 h-52 sm:w-60 sm:h-60 lg:w-64 lg:h-64 object-contain drop-shadow-[0_16px_32px_rgba(0,0,0,0.5)] group-hover/memoji:-translate-y-1 group-hover/memoji:scale-105 transition-transform duration-200"
        width="256"
        height="256"
        loading="lazy"
        decoding="async"
      />
    </div>
    
    <span class="relative -mt-3 text-xs font-mono text-slate-300 font-medium bg-slate-900/95 border border-slate-700/80 px-3.5 py-1.5 rounded-full shadow-lg flex items-center gap-1.5 group-hover/memoji:border-indigo-400/80 transition-colors">
      <Icon name="bx:envelope" class="w-3.5 h-3.5 text-indigo-400" />
      <span>jaumetur3w@gmail.com</span>
    </span>
  </div>
</div>

---
import { Icon } from "astro-icon/components";
---

<div
  class="bg-[#090D16] p-8 sm:p-12 md:p-14 my-16 md:my-24 mx-auto max-w-5xl rounded-3xl flex flex-col md:flex-row items-center justify-between text-left gap-8 border border-slate-800/90 shadow-2xl relative overflow-hidden">
  
  <!-- Subtle ambient indigo depth (calibrated, non-distracting) -->
  <div class="absolute -top-10 -right-10 w-96 h-96 bg-indigo-600/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-10 -left-10 w-80 h-80 bg-slate-800/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 max-w-xl">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 mb-4 shadow-2xs">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
      </span>
      <span>Disponible per a noves oportunitats</span>
    </div>

    <h2 class="text-white text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight">
      Creem alguna cosa <span class="bg-gradient-to-r from-indigo-400 via-indigo-300 to-white bg-clip-text text-transparent">extraordinària</span> junts?
    </h2>
    
    <p class="text-slate-300 mt-3 text-sm sm:text-base leading-relaxed">
      Tens una proposta de feina, un projecte web o necessites suport en arquitectura frontend? Parlem!
    </p>

    <!-- Visual Tech Chips -->
    <div class="flex flex-wrap gap-2 mt-5">
      <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-white/5 text-slate-300 border border-white/10">
        València (Remot / Híbrid)
      </span>
      <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-white/5 text-slate-300 border border-white/10">
        Angular & TypeScript
      </span>
      <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-white/5 text-slate-300 border border-white/10">
        CI/CD GitHub Actions
      </span>
    </div>

    <!-- Action Buttons (Clear Visual Hierarchy) -->
    <div class="flex flex-wrap items-center gap-3 mt-8">
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-sm bg-white text-slate-950 hover:bg-slate-100 shadow-xl shadow-black/30 hover:scale-[1.02] transition-all">
        <Icon name="bx:bxs-envelope" class="w-4 h-4 text-indigo-600" />
        <span>Contactar ara</span>
      </a>
      <a
        href="/docs/CV_Jaume_tur.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-semibold text-white bg-white/5 hover:bg-white/10 border border-white/15 backdrop-blur-xs transition text-sm">
        <Icon name="bx:bxs-cloud-download" class="w-4 h-4 text-slate-300" />
        <span>Descarregar CV ↗</span>
      </a>
    </div>
  </div>

  <!-- Memoji 3.png ("Call me" gesture) - Natural 3D Integration & Directional Contact Shadow -->
  <div class="relative z-20 shrink-0 flex flex-col items-center -mb-8 sm:-mb-14 -mt-2 sm:-mt-6 md:-mr-4 group">
    <div class="relative">
      <img
        src="/memojis/3.png"
        alt="Jaume fent el gest de telefonar"
        class="relative w-52 h-52 sm:w-60 sm:h-60 lg:w-64 lg:h-64 object-contain drop-shadow-[0_16px_32px_rgba(0,0,0,0.5)] group-hover:scale-105 transition-transform duration-300"
        width="256"
        height="256"
      />
    </div>
    
    <span class="relative -mt-3 text-xs font-mono text-slate-300 font-medium bg-slate-900/95 border border-slate-700/80 px-3.5 py-1 rounded-full shadow-lg">
      jautursis@alu.edu.gva.es
    </span>
  </div>
</div>

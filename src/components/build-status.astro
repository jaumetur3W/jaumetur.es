---
import { Icon } from "astro-icon/components";

interface Props {
  variant?: "pill" | "card";
}

const { variant = "pill" } = Astro.props;
const isEn = Astro.url.pathname.startsWith("/en");
---

{
  variant === "pill" && (
    <a
      href="https://github.com/jaumetur3W/jaumetur.es/actions"
      target="_blank"
      rel="noopener noreferrer"
      id="build-status-pill"
      class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-mono font-medium bg-slate-100 hover:bg-slate-200/80 text-slate-700 border border-slate-200/80 transition shadow-2xs group cursor-pointer"
      title={isEn ? "View CI/CD pipeline runs on GitHub Actions" : "Ver las ejecuciones del pipeline CI/CD en GitHub Actions"}
      aria-label={isEn ? "CI/CD pipeline status on GitHub Actions" : "Estado del pipeline CI/CD en GitHub Actions"}
    >
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75" id="build-ping"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500" id="build-dot"></span>
      </span>

      <span class="flex items-center gap-1.5">
        <Icon name="bx:git-branch" class="w-3.5 h-3.5 text-slate-400 group-hover:text-slate-900 transition-colors" />
        <span>CI/CD:</span>
        <span id="build-status-label" class="font-bold text-emerald-600">{isEn ? "Passing" : "Correcto"}</span>
      </span>

      <span class="text-[10px] text-slate-400 font-mono hidden sm:inline" id="build-commit-sha">#main</span>
      <Icon name="bx:link-external" class="w-3 h-3 text-slate-400 group-hover:text-slate-900 transition-colors" />
    </a>
  )
}

{
  variant === "card" && (
    <div
      id="build-status-card"
      class="p-6 rounded-3xl bg-white border border-slate-200/90 shadow-sm font-mono text-xs"
    >
      <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
        <div class="flex items-center gap-2">
          <Icon name="bx:rocket" class="w-5 h-5 text-slate-900" />
          <h4 class="font-bold text-sm text-slate-900">{isEn ? "Live CI/CD pipeline status" : "Estado real del pipeline CI/CD"}</h4>
        </div>
        <a
          href="https://github.com/jaumetur3W/jaumetur.es/actions"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-[11px] text-slate-700 hover:text-slate-950 hover:underline"
        >
          <span>GitHub Actions</span>
          <Icon name="bx:link-external" class="w-3 h-3" />
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-200/80 text-[11px] mb-4">
        <div>
          <span class="text-slate-400 block text-[10px] uppercase">{isEn ? "Status" : "Estado"}</span>
          <span id="card-build-status" class="font-bold text-emerald-600 flex items-center gap-1 mt-0.5">
            <Icon name="bx:check-circle" class="w-3.5 h-3.5" />
            <span>{isEn ? "Passing" : "Correcto"}</span>
          </span>
        </div>
        <div>
          <span class="text-slate-400 block text-[10px] uppercase">{isEn ? "Branch" : "Rama"}</span>
          <span id="card-build-branch" class="font-bold text-slate-800 mt-0.5 block">main</span>
        </div>
        <div>
          <span class="text-slate-400 block text-[10px] uppercase">{isEn ? "Latest commit" : "Último commit"}</span>
          <span id="card-build-sha" class="font-bold text-indigo-600 mt-0.5 block">HEAD</span>
        </div>
        <div>
          <span class="text-slate-400 block text-[10px] uppercase">{isEn ? "Execution time" : "Tiempo de ejecución"}</span>
          <span id="card-build-time" class="font-bold text-slate-800 mt-0.5 block">&lt; 90s</span>
        </div>
      </div>

      <p class="text-[11px] text-slate-500 font-sans leading-relaxed">
        {isEn ? "Atomic pipeline configured with GitHub Actions: cached dependencies, strict TypeScript checks, unit tests, and zero-downtime deployment." : "Pipeline atómico configurado con GitHub Actions: instalación en caché, verificación estática de TypeScript, pruebas unitarias y despliegue atómico sin interrupciones."}
      </p>
    </div>
  )
}

<script is:inline>
  function fetchGitHubBuildStatus() {
    const REPO = "jaumetur3W/jaumetur.es";
    const CACHE_KEY = "gh_actions_build_status";
    const CACHE_TTL = 5 * 60 * 1000;
    const isEn = window.location.pathname.startsWith("/en");

    function updateDOM(run) {
      const label = document.getElementById("build-status-label");
      const sha = document.getElementById("build-commit-sha");
      const dot = document.getElementById("build-dot");
      const ping = document.getElementById("build-ping");
      const cardStatus = document.getElementById("card-build-status");
      const cardSha = document.getElementById("card-build-sha");
      const cardBranch = document.getElementById("card-build-branch");

      if (!run) return;

      const isSuccess = run.conclusion === "success";
      const isInProgress = run.status === "in_progress" || run.status === "queued";
      const statusText = isEn
        ? { running: "In progress", success: "Passing", failed: "Failed" }
        : { running: "En curso", success: "Correcto", failed: "Fallido" };
      const shortSha = run.head_sha ? `#${run.head_sha.substring(0, 7)}` : "#main";

      if (sha) sha.textContent = shortSha;
      if (cardSha) cardSha.textContent = shortSha;
      if (cardBranch && run.head_branch) cardBranch.textContent = run.head_branch;

      if (cardStatus) {
        if (isInProgress) {
          cardStatus.className = "font-bold text-amber-500 flex items-center gap-1 mt-0.5";
          cardStatus.textContent = statusText.running;
        } else if (isSuccess) {
          cardStatus.className = "font-bold text-emerald-600 flex items-center gap-1 mt-0.5";
          cardStatus.textContent = statusText.success;
        } else {
          cardStatus.className = "font-bold text-rose-500 flex items-center gap-1 mt-0.5";
          cardStatus.textContent = statusText.failed;
        }
      }

      if (isInProgress) {
        if (label) {
          label.textContent = statusText.running;
          label.className = "font-bold text-amber-500";
        }
        if (dot) dot.className = "relative inline-flex rounded-full h-2 w-2 bg-amber-500";
        if (ping) ping.className = "animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75";
      } else if (isSuccess) {
        if (label) {
          label.textContent = statusText.success;
          label.className = "font-bold text-emerald-600";
        }
        if (dot) dot.className = "relative inline-flex rounded-full h-2 w-2 bg-emerald-500";
        if (ping) ping.className = "animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75";
      } else {
        if (label) {
          label.textContent = statusText.failed;
          label.className = "font-bold text-rose-500";
        }
        if (dot) dot.className = "relative inline-flex rounded-full h-2 w-2 bg-rose-500";
        if (ping) ping.className = "hidden";
      }
    }

    try {
      const cached = localStorage.getItem(CACHE_KEY);
      if (cached) {
        const parsed = JSON.parse(cached);
        if (Date.now() - parsed.timestamp < CACHE_TTL) {
          updateDOM(parsed.data);
          return;
        }
      }
    } catch (_) {}

    fetch(`https://api.github.com/repos/${REPO}/actions/runs?per_page=1`, {
      headers: { "Accept": "application/vnd.github.v3+json" }
    })
      .then(res => {
        if (!res.ok) throw new Error("API rate limited or network issue");
        return res.json();
      })
      .then(data => {
        if (data.workflow_runs && data.workflow_runs.length > 0) {
          const run = data.workflow_runs[0];
          updateDOM(run);
          try {
            localStorage.setItem(CACHE_KEY, JSON.stringify({
              timestamp: Date.now(),
              data: {
                conclusion: run.conclusion,
                status: run.status,
                head_sha: run.head_sha,
                head_branch: run.head_branch
              }
            }));
          } catch (_) {}
        }
      })
      .catch(() => {});
  }

  if ("requestIdleCallback" in window) {
    requestIdleCallback(fetchGitHubBuildStatus);
  } else {
    window.addEventListener("load", () => setTimeout(fetchGitHubBuildStatus, 2000));
  }
</script>

---
/**
 * Hoja de presupuesto interactiva (solo CSS): el radio marcado muestra la partida
 * correspondiente. Los importes salen de los datos reales de los servicios.
 */
import type { ServicePackage } from "@/data/services";

export interface Props {
  services: Array<Pick<ServicePackage, "id" | "name" | "timeline" | "creationPriceNumber" | "monthlyFeeNumber">>;
  isEn: boolean;
  contactHref: (id: string) => string;
  detailHref: (id: string) => string;
}
const { services, isEn, contactHref, detailHref } = Astro.props;

const euro = (n: number) => (isEn ? `€${n.toLocaleString("en-US")}` : `${n.toLocaleString("es-ES")} €`);
const monthly = (n: number) => (isEn ? `€${n}/mo` : `${n} €/mes`);
const t = isEn
  ? { legend: "Pick a service", creation: "Creation, one-off", maint: "Monthly maintenance", deadline: "Delivery", year1: "First year total", cta: "Request this quote", incl: "See what's included", note: "Starting prices. Scope and timeline are confirmed with you before starting." }
  : { legend: "Elige un servicio", creation: "Creación, pago único", maint: "Mantenimiento mensual", deadline: "Plazo de entrega", year1: "Total primer año", cta: "Pedir este presupuesto", incl: "Ver qué incluye", note: "Precios «desde». Alcance y plazo se confirman contigo antes de empezar." };

const rules = services
  .map((_, i) => `.quote-sheet:has(#q-svc-${i}:checked) [data-panel="${i}"]{display:block}.quote-sheet:has(#q-svc-${i}:checked) label[for="q-svc-${i}"]{background:var(--brand);color:var(--ink);box-shadow:inset 6px 0 0 var(--ink)}`)
  .join("");
---

<div class="quote-sheet sheet">
  <div class="sheet-head">
    <p class="font-display text-[1.6rem] font-extrabold tracking-[-0.035em] leading-none">{t.legend}</p>
  </div>
  <div class="px-5 pb-8 pt-6 sm:px-7">
    <fieldset>
      <legend class="sr-only">{t.legend}</legend>
      <div class="grid">
        {services.map((s, i) => (
          <div>
            <input class="peer sr-only" type="radio" name="quote-service" id={`q-svc-${i}`} value={s.id} checked={i === 0} />
            <label
              for={`q-svc-${i}`}
              class="flex min-h-12 cursor-pointer items-center border-b border-ink px-3 py-2.5 text-[1.02rem] font-bold leading-tight hover:bg-paper-2 peer-focus-visible:outline peer-focus-visible:outline-[3px] peer-focus-visible:outline-offset-[-3px] peer-focus-visible:outline-ink"
            >
              <span>{s.name}</span>
            </label>
          </div>
        ))}
      </div>
    </fieldset>

    <div class="mt-7" aria-live="polite">
      {services.map((s, i) => (
        <div data-panel={i} class="stamp">
          <dl class="grid text-[1rem]">
            <div class="leader-row border-b-2 border-ink py-2.5"><dt>{t.creation}</dt><span class="leader" aria-hidden="true"></span><dd class="num font-mono font-medium">{euro(s.creationPriceNumber)}</dd></div>
            <div class="leader-row border-b-2 border-ink py-2.5"><dt>{t.maint}</dt><span class="leader" aria-hidden="true"></span><dd class="num font-mono font-medium">{monthly(s.monthlyFeeNumber)}</dd></div>
            <div class="leader-row border-b-2 border-ink py-2.5"><dt>{t.deadline}</dt><span class="leader" aria-hidden="true"></span><dd class="num font-semibold">{s.timeline}</dd></div>
            <div class="leader-row pt-4"><dt class="font-bold">{t.year1}</dt><span class="leader" aria-hidden="true"></span><dd class="price-figure">{euro(s.creationPriceNumber + 12 * s.monthlyFeeNumber)}</dd></div>
          </dl>
          <div class="mt-7 flex flex-col gap-4">
            <a href={contactHref(s.id)} class="btn btn-brand w-full">{t.cta}</a>
            <a href={detailHref(s.id)} class="link-arrow min-h-11 self-start">{t.incl}</a>
          </div>
        </div>
      ))}
      <p class="meta mt-6">{t.note}</p>
    </div>
  </div>
</div>

<style is:global set:html={rules}></style>
<style is:global>
  .quote-sheet [data-panel] { display: none; }
</style>

---
import Link from "@/components/ui/link.astro";
import { localeFromPath, localizePath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const href = (path: string) => localizePath(path, isEn ? "en" : "es");

const copy = isEn
  ? {
      kicker: "Web development & systems",
      title: "Web applications with",
      emphasis: "technical criteria.",
      intro: "I'm Jaume Tur. I build web applications, backend, and clear digital solutions with a solid systems foundation.",
      projects: "View projects",
      about: "About me",
    }
  : {
      kicker: "Desarrollo web y sistemas",
      title: "Aplicaciones web con",
      emphasis: "criterio técnico.",
      intro: "Soy Jaume Tur. Desarrollo aplicaciones web, backend y soluciones digitales claras, con una base sólida de sistemas.",
      projects: "Ver proyectos",
      about: "Sobre mí",
    };
---

<section id="hero" aria-labelledby="hero-title" class="hero-shell mb-8 sm:mb-14">
  <div class="hero-card">
    <div class="hero-content">
      <p class="hero-kicker font-mono">{copy.kicker}</p>
      <h1 id="hero-title" class="hero-title">
        {copy.title} <span>{copy.emphasis}</span>
      </h1>
      <p class="hero-intro">
        {copy.intro}
      </p>

      <div class="hero-actions">
        <Link href={href("/projectes")} class="hero-primary-action">
          {copy.projects}
        </Link>
        <a href={href("/about")} class="hero-secondary-action">{copy.about}</a>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="hero-code-panel font-mono text-xs">
        <div class="hero-code-header">
          <span class="hero-dot bg-red-400"></span>
          <span class="hero-dot bg-amber-400"></span>
          <span class="hero-dot bg-emerald-400"></span>
          <span class="hero-code-title">profile.ts</span>
        </div>
        <div class="hero-code-body">
          <p><span class="code-keyword">const</span> <span class="code-variable">developer</span> = &#123;</p>
          <p class="code-indent"><span class="code-key">name:</span> <span class="code-value">"Jaume Tur"</span>,</p>
          <p class="code-indent"><span class="code-key">role:</span> <span id="developer-role" class="code-value">"Backend & Web Apps"</span>,</p>
          <p class="code-indent"><span class="code-key">{isEn ? "focus" : "enfoque"}:</span> <span id="developer-focus" class="code-value">{isEn ? '"useful digital products"' : '"productos digitales útiles"'}</span>,</p>
          <p class="code-indent"><span class="code-key">{isEn ? "areas" : "áreas"}:</span> <span class="code-value">{isEn ? '["web", "APIs", "systems"]' : '["web", "APIs", "sistemas"]'}</span></p>
          <p>&#125;;</p>
          <div class="hero-presets" aria-label={isEn ? "Switch technical profile" : "Cambiar perfil técnico"}>
            <button class="hero-preset-chip active" data-preset="backend" type="button">Backend &amp; Web</button>
            <button class="hero-preset-chip" data-preset="sistemes" type="button">{isEn ? "Systems & Ops" : "Sistemas y servidores"}</button>
            <button class="hero-preset-chip" data-preset="frontend" type="button">Frontend &amp; UX</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const roleEl = document.getElementById("developer-role");
    const focusEl = document.getElementById("developer-focus");
    const chips = Array.from(document.querySelectorAll(".hero-preset-chip"));
    if (!roleEl || !focusEl || chips.length === 0) return;

    const isEnglish = document.documentElement.lang.startsWith("en");

    const presets = {
      backend: { role: "Backend & Web Apps", focus: isEnglish ? "useful digital products" : "productos digitales útiles" },
      sistemes: { role: isEnglish ? "Systems & Ops" : "Sistemas y servidores", focus: isEnglish ? "reliable infrastructure" : "infraestructura fiable" },
      frontend: { role: "Frontend & UX", focus: isEnglish ? "clear interfaces" : "interfaces claras" },
    };

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const key = chip.getAttribute("data-preset");
        const next = key && presets[key];
        if (!next) return;

        chips.forEach((c) => c.classList.remove("active"));
        chip.classList.add("active");

        roleEl.textContent = `"${next.role}"`;
        focusEl.textContent = `"${next.focus}"`;
      });
    });
  })();
</script>

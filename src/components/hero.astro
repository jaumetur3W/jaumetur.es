---
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";


const metrics = [
  {
    icon: "bx:server",
    value: "Backend",
    label: "APIs & Bases de Dades",
    color: "text-indigo-300 bg-slate-900/90 border-slate-700/80 hover:border-indigo-400",
    iconClass: "group-hover:scale-125 text-indigo-400",
    badgeColor: "bg-indigo-950/60 text-indigo-300 border-indigo-800/80",
  },
  {
    icon: "bx:chip",
    value: "CFGM SMX",
    label: "Servidors & Equips",
    color: "text-emerald-300 bg-slate-900/90 border-slate-700/80 hover:border-emerald-400",
    iconClass: "group-hover:scale-125 group-hover:rotate-6 text-emerald-400",
    badgeColor: "bg-emerald-950/60 text-emerald-300 border-emerald-800/80",
  },
  {
    icon: "bx:refresh",
    value: "CI/CD",
    label: "Desplegaments continus",
    color: "text-sky-300 bg-slate-900/90 border-slate-700/80 hover:border-sky-400",
    iconClass: "group-hover:rotate-180 transition-transform duration-500 text-sky-400",
    badgeColor: "bg-sky-950/60 text-sky-300 border-sky-800/80",
  },
  {
    icon: "simple-icons:typescript",
    value: "TypeScript",
    label: "Tipat estricte",
    color: "text-amber-300 bg-slate-900/90 border-slate-700/80 hover:border-amber-400",
    iconClass: "group-hover:scale-125 group-hover:-rotate-12 text-[#FFE600]",
    badgeColor: "bg-amber-950/60 text-amber-300 border-amber-800/80",
  },
];
---

<section
  id="hero"
  aria-labelledby="hero-role-heading"
  class="relative pt-10 pb-16 md:pt-14 md:pb-20 px-6 sm:px-10 lg:px-12 rounded-[2.5rem] overflow-hidden mb-12 bg-[#090D16] border border-indigo-900/50 shadow-[0_8px_45px_rgba(0,0,0,0.5)] hero-theme-dark text-white transition-colors duration-300">
  
  <!-- FONS: Obsidian Dark (#090D16) amb gradients radials estàtics i reixeta isomètrica -->
  <!-- Capa 1: Gradients d'ambient estàtics (sense càrrega contínua GPU) -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_50%_at_70%_20%,rgba(99,102,241,0.22),transparent_70%),radial-gradient(ellipse_50%_40%_at_20%_80%,rgba(255,230,0,0.06),transparent_60%)] pointer-events-none -z-20" aria-hidden="true"></div>

  <!-- Capa 2: Punts de precisió isomètrics de 24x24 px sobre fons fosc amb màscara el·líptica -->
  <div
    class="absolute inset-0 bg-[radial-gradient(#ffffff18_1.25px,transparent_1.25px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_75%_65%_at_50%_45%,#000_55%,transparent_100%)] pointer-events-none -z-20"
    aria-hidden="true"
  ></div>

  <!-- Capa 3: Textura de gra de soroll tècnic subtil -->
  <div class="hero-grain-layer absolute inset-0 opacity-[0.03] pointer-events-none -z-10" aria-hidden="true"></div>

  <!-- Capa 4: Degradat suau de sortida cap a la secció següent -->
  <div class="absolute bottom-0 inset-x-0 h-20 pointer-events-none -z-10 bg-gradient-to-t from-[#090D16] to-transparent" aria-hidden="true"></div>


  <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center relative z-10">
    
    <!-- Left text column -->
    <div class="lg:col-span-7">
      <!-- Status pill with glowing dot & live status (Reactive to profile toggle) -->
      <div
        id="hero-status-pill"
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-[#FFE600]/10 text-[#FFE600] border border-[#FFE600]/30 shadow-2xs mb-6 transition-all duration-300"
      >
        <span class="relative flex h-2 w-2" id="hero-status-indicator">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#FFE600] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-[#FFE600]"></span>
        </span>
        <span id="hero-status-text" class="font-mono text-[11px] font-bold tracking-tight text-[#FFE600]">
          DISPONIBLE PER A PROJECTES & CONTRACTACIÓ
        </span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.08]">
        Enginyeria <br class="hidden sm:inline" />
        <span id="hero-role-heading" class="bg-gradient-to-r from-cyan-400 via-indigo-300 to-[#FFE600] bg-clip-text text-transparent">
          Backend & Sistemes
        </span>{" "}
        & Web Apps
      </h1>
      
      <p class="text-base sm:text-lg mt-5 text-slate-300 max-w-xl leading-relaxed">
        Hola, sóc <strong class="text-white font-bold">Jaume Tur</strong>. Desenvolupador especialitzat principalment en <strong class="text-[#FFE600]">Backend robust</strong>, arquitectura d'APIs i bases de dades, amb competències en <strong>administració de servidors i manteniment d'equips</strong> (CFGM SMX) i desenvolupament d'aplicacions web completes (CFGS DAW).
      </p>

      <!-- Visual Metric Pills with Standardized Icons (Micro-animations on hover) -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 mt-6 max-w-xl">
        {metrics.map((m) => (
          <div class={`group p-3 rounded-2xl border ${m.color} shadow-2xs hover:shadow-md transition-all duration-200 flex flex-col justify-between cursor-default min-h-[72px] sm:min-h-[76px]`}>
            <div class="flex items-center justify-between gap-1 mb-2">
              <span class="font-extrabold text-sm sm:text-base font-mono leading-none text-slate-100">
                {m.value}
              </span>
              <Icon name={m.icon} class={`w-4 h-4 ${m.iconClass}`} />
            </div>
            <span class="text-[11px] text-slate-400 font-medium leading-tight">
              {m.label}
            </span>
          </div>
        ))}
      </div>

      <!-- Action buttons with Standardized Icons & High Contrast (Developer & Recruiter Focus) -->
      <div class="mt-8 flex flex-wrap gap-2.5 sm:gap-3 items-center">
        <Link
          href="#projectes"
          class="group flex gap-2 items-center justify-center font-bold px-4 sm:px-5 py-2.5 bg-[#FFE600] hover:bg-[#ffe81a] text-slate-950 shadow-sm shadow-[#FFE600]/20 border-0 rounded-xl transition text-xs sm:text-sm">
          <Icon name="bx:rocket" class="w-4 h-4 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 transition-transform text-slate-950" />
          <span>Veure projectes</span>
        </Link>
        
        <a
          href="/contact"
          class="group inline-flex items-center justify-center gap-1.5 px-4 sm:px-5 py-2.5 rounded-xl font-bold text-white bg-indigo-600 hover:bg-indigo-500 shadow-sm shadow-indigo-600/30 transition text-xs sm:text-sm">
          <Icon name="bx:envelope" class="w-4 h-4 group-hover:scale-110 transition-transform" />
          <span>Contactar</span>
        </a>

        <!-- GitHub: Codi i Repositoris Tècnics -->
        <a
          href="https://github.com/jautur"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-1.5 px-3.5 sm:px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold text-slate-100 bg-slate-900/90 hover:bg-slate-800 transition border border-slate-700/80 hover:border-slate-400 shadow-2xs"
          title="Veure codi i repositoris a GitHub (jautur)">
          <Icon name="bx:bxl-github" class="w-4 h-4 group-hover:scale-110 transition-transform text-slate-100" />
          <span>GitHub</span>
          <span class="text-[11px] text-slate-400 font-mono">↗</span>
        </a>

        <!-- LinkedIn: Perfil Professional per a Empreses -->
        <a
          href="https://www.linkedin.com/in/jautur/"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-1.5 px-3.5 sm:px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold text-cyan-200 bg-cyan-950/60 hover:bg-cyan-900/70 transition border border-cyan-800/80 hover:border-cyan-400 shadow-2xs"
          title="Veure perfil professional a LinkedIn">
          <Icon name="bx:bxl-linkedin" class="w-4 h-4 group-hover:scale-110 transition-transform text-cyan-400" />
          <span>LinkedIn</span>
          <span class="text-[11px] text-cyan-400/80 font-mono">↗</span>
        </a>

        <a
          href="/docs/CV_Jaume_tur.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-1.5 px-3.5 sm:px-4 py-2.5 rounded-xl font-bold text-slate-200 bg-slate-900/90 border border-slate-700/80 hover:border-[#FFE600] hover:text-[#FFE600] hover:bg-slate-800 transition shadow-2xs text-xs sm:text-sm"
          title="Descarregar currículum en PDF">
          <Icon name="bx:file" class="w-4 h-4 group-hover:-translate-y-0.5 transition-transform text-slate-300" />
          <span>CV</span>
          <span class="text-[11px] text-slate-400 font-mono">↗</span>
        </a>
      </div>
    </div>

    <!-- Right visual column: Reactive Memoji & Editable Code Terminal -->
    <div class="lg:col-span-5 flex flex-col items-center relative pt-8 sm:pt-4">
      
      <!-- Overlapping Memoji: Peeking from behind the terminal, reactive to cursor & profile -->
      <div
        id="hero-memoji-wrapper"
        class="relative z-20 -mb-12 sm:-mb-16 group cursor-pointer"
      >
        <!-- Ambient radial glow behind memoji -->
        <div id="hero-memoji-aura" class="absolute inset-0 bg-indigo-500/15 rounded-full blur-2xl group-hover:scale-105 transition-transform duration-200"></div>
        
        <img
          id="hero-memoji-img"
          src="/img/4.webp"
          alt="Jaume Tur interactiu"
          class="relative w-64 h-64 sm:w-72 sm:h-72 lg:w-80 lg:h-80 object-contain drop-shadow-[0_16px_28px_rgba(15,23,42,0.22)] group-hover:-translate-y-1.5 transition-transform duration-200 pointer-events-auto"
          loading="eager"
          fetchpriority="high"
          width="320"
          height="320"
        />

        <!-- Floating speech bubble (Standardized icon + dynamic phrase) -->
        <div
          role="status"
          aria-live="polite"
          class="absolute top-6 right-2 sm:right-4 bg-slate-900 text-white text-xs font-mono font-bold px-3.5 py-1.5 rounded-full shadow-lg whitespace-nowrap flex items-center gap-1.5 ring-2 ring-white group-hover:scale-110 transition-transform">
          <Icon name="bx:message-rounded-dots" class="w-3.5 h-3.5 text-indigo-400" id="hero-speech-icon" />
          <span id="hero-speech-text">Hola! Parlem?</span>
        </div>
      </div>

      <!-- Developer Syntax Card: Corporate Dark Slate-950 (#090D16) -->
      <div class="w-full bg-[#090D16] text-slate-100 rounded-3xl shadow-2xl border border-slate-800/90 overflow-hidden font-mono text-xs relative z-10 pt-4 sm:pt-6 group">
        <!-- Terminal Header -->
        <div class="bg-slate-900/90 px-5 py-3 flex items-center justify-between border-b border-slate-800/80">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500 inline-block"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-400 inline-block"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 inline-block"></span>
            <span class="text-slate-400 text-[11px] ml-2 flex items-center gap-1.5">
              <Icon name="bx:terminal" class="w-3.5 h-3.5 text-slate-400" />
              <span>// developer.profile (reactiu)</span>
            </span>
          </div>
          <span
            id="terminal-status-badge"
            class="px-2.5 py-0.5 bg-emerald-950 text-emerald-400 border border-emerald-800/80 rounded-full text-[10px] uppercase font-bold tracking-wider flex items-center gap-1 select-none"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" id="terminal-status-dot"></span>
            <span id="terminal-status-text">ONLINE</span>
          </span>
        </div>

        <!-- Terminal Interactive Code Body -->
        <div class="p-5 sm:p-6 space-y-2 text-[12px] sm:text-[13px] leading-relaxed">
          <div>
            <span class="text-purple-400">const</span> <span class="text-yellow-300">developer</span> = &#123;
          </div>
          <div class="pl-4">
            <span class="text-slate-400">nom:</span> <span class="text-emerald-300">"Jaume Tur"</span>,
          </div>
          
          <!-- Interactive Rol Selector -->
          <div class="pl-4 flex items-center gap-2 flex-wrap">
            <span class="text-slate-400">rol:</span>
            <button
              id="role-cycle-btn"
              type="button"
              class="text-cyan-300 hover:text-cyan-200 underline decoration-cyan-500/50 hover:decoration-cyan-400 font-bold cursor-pointer transition-colors flex items-center gap-1 group/btn"
              title="Fes clic per canviar el rol i veure la reacció del perfil"
            >
              <span id="developer-role-text">"Backend & Web Apps"</span>
              <Icon name="bx:sync" class="w-3 h-3 text-cyan-400 group-hover/btn:rotate-180 transition-transform duration-300" />
            </button>
          </div>

          <!-- Reactive Stack Array -->
          <div class="pl-4">
            <span class="text-slate-400">stack:</span>
            <span id="developer-stack" class="text-slate-300">
              [<span class="text-emerald-400">"Node.js"</span>, <span class="text-blue-300">"TypeScript"</span>, <span class="text-amber-300">"SQL/NoSQL"</span>]
            </span>,
          </div>
          
          <div class="pl-4">
            <span class="text-slate-400">titulacions:</span> <span class="text-indigo-300">["CFGS DAW", "GM SMX"]</span>,
          </div>
          <div class="pl-4">
            <span class="text-slate-400">sistemes:</span> <span class="text-emerald-300">"Servidors Linux & Manteniment"</span>,
          </div>
          <div class="pl-4">
            <span class="text-slate-400">ubicacio:</span> <span class="text-rose-300">"València (Remot/Híbrid)"</span>,
          </div>

          <!-- Interactive Disponible Toggle -->
          <div class="pl-4 flex items-center gap-2 flex-wrap">
            <span class="text-slate-400">disponible:</span>
            <button
              id="disponible-toggle-btn"
              type="button"
              class="text-emerald-400 hover:text-emerald-300 font-bold underline decoration-emerald-500/60 cursor-pointer transition-colors flex items-center gap-1 group/disp"
              title="Fes clic per commutar l'estat de disponibilitat"
            >
              <span id="developer-disponible-text">true</span>
              <Icon name="bx:toggle-right" class="w-3.5 h-3.5 text-emerald-400 group-hover/disp:scale-110 transition-transform" id="disponible-icon" />
            </button>
          </div>
          <div>&#125;;</div>

          <!-- Micro Quick Selector for Role Presets -->
          <div class="pt-3 mt-3 border-t border-slate-800/80 flex items-center gap-1.5 flex-wrap text-[10px] text-slate-400">
            <span class="text-slate-500">Preset:</span>
            <button type="button" data-preset-idx="0" class="role-preset-chip px-2 py-0.5 rounded bg-indigo-600 text-white border border-indigo-500 transition">Backend</button>
            <button type="button" data-preset-idx="1" class="role-preset-chip px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition">Sistemes SMX</button>
            <button type="button" data-preset-idx="2" class="role-preset-chip px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition">DevOps</button>
            <button type="button" data-preset-idx="3" class="role-preset-chip px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition">Frontend</button>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  function setupInteractiveHero() {
    const hero = document.getElementById("hero");
    const memojiImg = document.getElementById("hero-memoji-img");
    const speechText = document.getElementById("hero-speech-text");
    const roleCycleBtn = document.getElementById("role-cycle-btn");
    const roleText = document.getElementById("developer-role-text");
    const stackEl = document.getElementById("developer-stack");
    const roleHeading = document.getElementById("hero-role-heading");
    const disponibleBtn = document.getElementById("disponible-toggle-btn");
    const disponibleText = document.getElementById("developer-disponible-text");
    const statusPill = document.getElementById("hero-status-pill");
    const statusText = document.getElementById("hero-status-text");
    const terminalStatusBadge = document.getElementById("terminal-status-badge");
    const terminalStatusText = document.getElementById("terminal-status-text");
    const presetChips = Array.from(document.querySelectorAll(".role-preset-chip"));

    if (!hero || !roleCycleBtn || !disponibleBtn) return;

    // Presets for Roles
    const presets = [
      {
        role: "Backend & APIs",
        stackHtml: '[<span class="text-emerald-400">"Node.js"</span>, <span class="text-blue-300">"TypeScript"</span>, <span class="text-amber-300">"SQL/NoSQL"</span>]',
        memoji: "/img/4.webp",
        speech: "Arquitectures de servidor escalables!",
        heading: "Backend",
      },
      {
        role: "Sistemes & Servidors (SMX)",
        stackHtml: '[<span class="text-cyan-300">"Linux Server"</span>, <span class="text-emerald-300">"Manteniment Equips"</span>, <span class="text-purple-300">"Xarxes"</span>]',
        memoji: "/img/7.webp",
        speech: "Administració de servidors i equips!",
        heading: "Sistemes & Servidors",
      },
      {
        role: "DevOps & CI/CD Lead",
        stackHtml: '[<span class="text-sky-300">"GitHub Actions"</span>, <span class="text-slate-300">"Docker"</span>, <span class="text-emerald-300">"Zero Downtime"</span>]',
        memoji: "/img/2.webp",
        speech: "Desplegaments continus i segurs!",
        heading: "CI/CD & DevOps",
      },
      {
        role: "Frontend & Web Apps",
        stackHtml: '[<span class="text-red-400">"Angular"</span>, <span class="text-purple-300">"Signals"</span>, <span class="text-emerald-300">"60 FPS"</span>]',
        memoji: "/img/5.webp",
        speech: "Web Apps reactives d'alta fluïdesa!",
        heading: "Frontend & Web Apps",
      },
    ];

    let currentPresetIdx = 0;
    let isAvailable = true;

    function applyPreset(idx) {
      currentPresetIdx = idx % presets.length;
      const p = presets[currentPresetIdx];

      if (roleText) roleText.textContent = `"${p.role}"`;
      if (stackEl) stackEl.innerHTML = p.stackHtml;
      if (memojiImg) {
        memojiImg.style.transform = "scale(0.92)";
        setTimeout(() => {
          memojiImg.src = p.memoji;
          memojiImg.style.transform = "";
        }, 120);
      }
      if (speechText) speechText.textContent = p.speech;
      if (roleHeading) roleHeading.textContent = p.heading;

      // Update chips style
      presetChips.forEach((chip, i) => {
        if (i === currentPresetIdx) {
          chip.classList.add("bg-indigo-600", "text-white", "border-indigo-500");
          chip.classList.remove("bg-slate-800", "text-slate-300");
        } else {
          chip.classList.remove("bg-indigo-600", "text-white", "border-indigo-500");
          chip.classList.add("bg-slate-800", "text-slate-300");
        }
      });
    }

    roleCycleBtn.addEventListener("click", () => {
      applyPreset(currentPresetIdx + 1);
    });

    presetChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const idx = parseInt(chip.getAttribute("data-preset-idx") || "0", 10);
        applyPreset(idx);
      });
    });

    // Toggle Disponibilitat
    function updateAvailability(status) {
      isAvailable = status;
      if (disponibleText) disponibleText.textContent = isAvailable ? "true" : "false";

      if (isAvailable) {
        if (disponibleText) {
          disponibleText.className = "text-emerald-400 font-bold underline decoration-emerald-500/60";
        }
        if (statusPill) {
          statusPill.className = "inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200/80 shadow-2xs mb-6 transition-all duration-300";
        }
        if (statusText) {
          statusText.textContent = "DISPONIBLE PER A PROJECTES & CONTRACTACIÓ";
        }
        if (terminalStatusBadge) {
          terminalStatusBadge.className = "px-2.5 py-0.5 bg-emerald-950 text-emerald-400 border border-emerald-800/80 rounded-full text-[10px] uppercase font-bold tracking-wider flex items-center gap-1 select-none";
        }
        if (terminalStatusText) {
          terminalStatusText.textContent = "ONLINE";
        }
        if (speechText) speechText.textContent = presets[currentPresetIdx].speech;
      } else {
        if (disponibleText) {
          disponibleText.className = "text-amber-400 font-bold underline decoration-amber-500/60";
        }
        if (statusPill) {
          statusPill.className = "inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200/80 shadow-2xs mb-6 transition-all duration-300";
        }
        if (statusText) {
          statusText.textContent = "ENFOCAT EN PROJECTES ACTIUS";
        }
        if (terminalStatusBadge) {
          terminalStatusBadge.className = "px-2.5 py-0.5 bg-amber-950 text-amber-400 border border-amber-800/80 rounded-full text-[10px] uppercase font-bold tracking-wider flex items-center gap-1 select-none";
        }
        if (terminalStatusText) {
          terminalStatusText.textContent = "OCUPAT";
        }
        if (speechText) speechText.textContent = "Concentrat programant...";
      }
    }

    disponibleBtn.addEventListener("click", () => {
      updateAvailability(!isAvailable);
    });

    // Set initial preset active chip
    applyPreset(0);
  }

  if ("requestIdleCallback" in window) {
    requestIdleCallback(setupInteractiveHero);
  } else {
    window.addEventListener("load", () => setTimeout(setupInteractiveHero, 500));
  }
</script>

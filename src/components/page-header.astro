---
/** Cabecera de página interior: título grande, entradilla y espacio para migas o acciones. */
export interface Props {
  title: string;
  lede?: string;
}
const { title, lede } = Astro.props;
---

<header class="relative pt-28 pb-12 sm:pt-32 sm:pb-16 lg:pt-36">
  <div class="wrap">
    <slot name="crumbs" />
    <h1 class="h-page max-w-4xl font-extrabold tracking-tight text-ink" data-split>{title}</h1>
    {lede && <p class="lede mt-6 text-lg sm:text-xl text-ink/80 leading-relaxed max-w-3xl">{lede}</p>}
    <slot />
  </div>
  <div class="section-divider mt-10 sm:mt-14" data-divider aria-hidden="true"><div class="divider-line"></div></div>
</header>

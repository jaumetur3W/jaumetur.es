---
/** Cabecera de página interior: título grande, entradilla y espacio para migas o acciones. */
export interface Props {
  title: string;
  lede?: string;
}
const { title, lede } = Astro.props;
---

<header class="border-b-[1.5px] border-ink pb-8 pt-8 sm:pb-10 sm:pt-12">
  <div class="wrap">
    <slot name="crumbs" />
    <h1 class="h-page max-w-4xl" data-split>{title}</h1>
    {lede && <p class="lede mt-5">{lede}</p>}
    <slot />
  </div>
</header>

---
/** Cabecera de página interior: título grande, entradilla y espacio para migas o acciones. */
export interface Props {
  title: string;
  lede?: string;
}
const { title, lede } = Astro.props;
---

<header class="border-b border-white/15 pb-12 pt-12 sm:pb-16 sm:pt-20">
  <div class="wrap">
    <slot name="crumbs" />
    <h1 class="h-page max-w-[18ch] sm:max-w-4xl">{title}</h1>
    {lede && <p class="lede mt-6">{lede}</p>}
    <slot />
  </div>
</header>

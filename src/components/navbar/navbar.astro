---
import Container from "@/components/container.astro";
import { Icon } from "astro-icon/components";

const rawPathname = Astro.url.pathname;
const isVal = rawPathname === "/val" || rawPathname.startsWith("/val/");
const pathname = (isVal ? rawPathname.replace(/^\/val/, "") : rawPathname).replace(/\/$/, "") || "/";
const localizedPath = (path: string) => isVal ? `/val${path === "/" ? "/" : path}` : path;
const spanishPath = pathname;
const valencianPath = `/val${pathname === "/" ? "/" : pathname}`;
const isActive = (path: string) => {
  if (path === "/") return pathname === "/";
  return pathname.startsWith(path);
};

const navLinks = [
  { title: isVal ? "Projectes" : "Proyectos", path: "/projectes" },
  { title: isVal ? "Preus" : "Precios", path: "/pricing" },
  { title: isVal ? "Sobre mi" : "Sobre mí", path: "/about" },
  { title: isVal ? "Contacte" : "Contacto", path: "/contact" },
];
---

<div class="sticky top-0 z-50 w-full bg-white border-b border-slate-200/80 transition-colors">
  <Container>
    <header id="site-header" class="relative flex items-center justify-between py-2.5 min-h-[56px]">
      
      <!-- Logo: Isotip en mòbil, Wordmark complet en escriptori -->
      <div class="flex items-center">
        <!-- Isotip en mòbil -->
        <a
          href={localizedPath("/")}
          class="flex lg:hidden items-center p-1 rounded-xl min-h-[44px] min-w-[44px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00]"
          title="Jaume Tur — Inici"
          aria-label="Jaume Tur — Inici">
          <div class="relative w-10 h-10 shrink-0">
            <div class="absolute inset-0 bg-[#FFFF00] rounded-xl opacity-35"></div>
            <img
              src="/img/jt.LOGO-02-128.webp"
              alt="Isotip oficial de Jaume Tur"
              class="relative w-10 h-10 rounded-xl ring-1 ring-slate-900/10 shadow-sm object-cover"
              width="40"
              height="40"
              loading="eager"
              decoding="async"
            />
          </div>
        </a>

        <!-- Wordmark a l'esquerra en escriptori -->
        <a
          href={localizedPath("/")}
          class="hidden lg:flex items-center gap-2.5 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00] rounded-xl p-1"
          title="Jaume Tur — Inici"
          aria-label="Jaume Tur — Inici">
          <div class="relative w-9 h-9 shrink-0">
            <div class="absolute inset-0 bg-[#FFFF00] rounded-xl opacity-35 group-hover:opacity-60 transition-opacity"></div>
            <img
              src="/img/jt.LOGO-02-128.webp"
              alt="Isotip Jaume Tur"
              class="relative w-9 h-9 rounded-xl ring-1 ring-slate-900/10 shadow-sm group-hover:scale-105 transition-transform object-cover"
              width="36"
              height="36"
              loading="eager"
              decoding="async"
            />
          </div>
          <div class="flex items-center gap-1.5">
            <span class="font-extrabold text-slate-900 text-lg leading-tight tracking-tight group-hover:text-slate-700 transition-colors">
              jaume<span class="text-slate-900">.</span>
            </span>
            <span class="text-xs font-mono font-extrabold px-1.5 py-0.5 rounded-md bg-[#FFFF00] text-slate-950 shadow-2xs">www</span>
          </div>
        </a>
      </div>

      <!-- Navegació d'escriptori (Màxim 6 enllaços incloent accions) -->
      <nav class="hidden lg:flex items-center gap-1" aria-label={isVal ? "Navegació principal" : "Navegación principal"}>
        <ul class="flex items-center gap-1">
          {
            navLinks.map((item) => {
              const active = isActive(item.path);
              return (
                <li>
                  <a
                    href={localizedPath(item.path)}
                    class:list={[
                      "px-3 py-2 text-xs font-semibold rounded-lg transition border focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00]",
                      active
                        ? "text-slate-950 bg-[#FFFF00] border-[#FFFF00] font-bold"
                        : "text-slate-600 hover:text-slate-950 hover:bg-white border-transparent"
                    ]}
                    aria-current={active ? "page" : undefined}>
                    <span>{item.title}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <nav class="hidden lg:flex items-center gap-1 border-l border-slate-200 pl-3 text-xs font-bold" aria-label="Selector d'idioma">
        <a href={spanishPath} lang="es" aria-current={!isVal ? "page" : undefined} class:list={["rounded px-2 py-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00]", !isVal ? "bg-[#FFFF00] text-slate-950" : "text-slate-600 hover:text-slate-950"]}>ES</a>
        <span aria-hidden="true" class="text-slate-300">|</span>
        <a href={valencianPath} lang="ca-valencia" aria-current={isVal ? "page" : undefined} class:list={["rounded px-2 py-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00]", isVal ? "bg-[#FFFF00] text-slate-950" : "text-slate-600 hover:text-slate-950"]}>VAL</a>
      </nav>

      <!-- Menú Mòbil (<details>/<summary> accessible, sense drawer lateral, sense overlay) -->
      <details id="mobile-menu-details" class="lg:hidden group">
        <summary
          id="mobile-menu-summary"
          class="min-h-[44px] min-w-[44px] px-3 py-2 inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-200 bg-white font-bold text-xs text-slate-800 cursor-pointer list-none select-none hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00] transition"
          aria-label="Menú principal de navegació"
          aria-controls="mobile-nav-panel"
          aria-expanded="false">
          <span>Menú</span>
          <Icon name="bx:menu" class="w-4 h-4 block group-open:hidden" aria-hidden="true" />
          <Icon name="bx:x" class="w-4 h-4 hidden group-open:block" aria-hidden="true" />
        </summary>

        <div
          id="mobile-nav-panel"
          class="absolute left-0 right-0 top-full w-full bg-white border-b border-slate-200/90 shadow-md p-4 transition-all">
          <nav aria-label={isVal ? "Navegació mòbil" : "Navegación móvil"}>
            <ul class="flex flex-col gap-1">
              {
                navLinks.map((item) => {
                  const active = isActive(item.path);
                  return (
                    <li>
                      <a
                        href={localizedPath(item.path)}
                        class:list={[
                          "flex items-center gap-2.5 px-3.5 py-3 min-h-[44px] rounded-lg text-xs font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00]",
                          active
                            ? "bg-[#FFFF00] text-slate-950 font-bold border border-[#FFFF00]"
                            : "text-slate-700 hover:bg-slate-50 border border-transparent"
                        ]}
                        aria-current={active ? "page" : undefined}>
                        <span>{item.title}</span>
                      </a>
                    </li>
                  );
                })
              }
              <li class="mt-2 flex items-center gap-1 border-t border-slate-100 pt-2 px-3.5 text-xs font-bold" aria-label="Selector d'idioma">
                <a href={spanishPath} lang="es" aria-current={!isVal ? "page" : undefined} class:list={["min-h-11 inline-flex items-center rounded px-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00]", !isVal ? "bg-[#FFFF00] text-slate-950" : "text-slate-600"]}>ES</a>
                <span aria-hidden="true" class="text-slate-300">|</span>
                <a href={valencianPath} lang="ca-valencia" aria-current={isVal ? "page" : undefined} class:list={["min-h-11 inline-flex items-center rounded px-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00]", isVal ? "bg-[#FFFF00] text-slate-950" : "text-slate-600"]}>VAL</a>
              </li>
            </ul>
          </nav>
        </div>
      </details>
    </header>
  </Container>
</div>

<script is:inline>
  (function() {
    function setupMobileNav() {
      const details = document.getElementById("mobile-menu-details");
      const summary = document.getElementById("mobile-menu-summary");
      if (!details || !summary) return;

      details.addEventListener("toggle", function() {
        summary.setAttribute("aria-expanded", details.open ? "true" : "false");
      });

      document.addEventListener("keydown", function(e) {
        if (e.key === "Escape" && details.open) {
          details.open = false;
          summary.setAttribute("aria-expanded", "false");
          summary.focus();
        }
      });

      // Tanca en fer clic a un enllaç
      details.querySelectorAll("a").forEach(function(link) {
        link.addEventListener("click", function() {
          details.open = false;
          summary.setAttribute("aria-expanded", "false");
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupMobileNav);
    } else {
      setupMobileNav();
    }
  })();
</script>

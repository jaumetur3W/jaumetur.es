---
import { localizePath, localeFromPath, stripLocale } from "@/i18n";

const rawPathname = Astro.url.pathname;
const locale = localeFromPath(rawPathname);
const isEn = locale === "en";
const pathname = stripLocale(rawPathname);

const withSlash = (path: string) => {
  const hashIndex = path.indexOf("#");
  const base = hashIndex < 0 ? path : path.slice(0, hashIndex);
  const hash = hashIndex < 0 ? "" : path.slice(hashIndex);
  return `${base === "/" || base.endsWith("/") ? base : `${base}/`}${hash}`;
};
const to = (path: string) => withSlash(localizePath(path, locale));
const spanishPath = withSlash(localizePath(rawPathname, "es"));
const englishPath = withSlash(localizePath(rawPathname, "en"));

const links = [
  { label: isEn ? "Services" : "Servicios", path: "/pricing", active: pathname.startsWith("/pricing") },
  { label: isEn ? "Projects" : "Proyectos", path: "/projectes", active: pathname.startsWith("/projectes") },
  { label: isEn ? "How I work" : "Cómo trabajo", path: "/#proceso", active: false },
  { label: isEn ? "FAQ" : "Preguntas", path: "/#faq", active: false },
  { label: isEn ? "About" : "Sobre mí", path: "/about", active: pathname.startsWith("/about") },
];
const ctaLabel = isEn ? "Get a quote" : "Pedir presupuesto";
---

<header class="sticky top-0 z-50 w-full border-b-2 border-ink bg-[#fafaf3]/95 backdrop-blur supports-[backdrop-filter]:bg-[#fafaf3]/85">
  <div class="mx-auto flex max-w-(--breakpoint-xl) items-center justify-between gap-4 px-4 py-2.5 sm:px-5">
    <a
      href={to("/")}
      class="flex min-h-11 items-center gap-2.5 rounded-xl"
      aria-label={isEn ? "jaume.www — Jaume Tur, home" : "jaume.www — Jaume Tur, inicio"}
    >
      <img
        src="/img/jt.LOGO-02-128.webp"
        alt=""
        width="40"
        height="40"
        class="h-10 w-10 rounded-xl border-2 border-ink"
        decoding="async"
      />
      <span class="font-display text-xl font-extrabold tracking-tight leading-none">
        jaume<span class="rounded-md bg-brand px-1.5 py-0.5 ml-0.5 text-base border-2 border-ink">.www</span>
      </span>
    </a>

    <nav aria-label={isEn ? "Main navigation" : "Navegación principal"} class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {links.map((l) => (
          <li>
            <a
              href={to(l.path)}
              aria-current={l.active ? "page" : undefined}
              class:list={[
                "inline-flex min-h-11 items-center rounded-full px-4 text-[0.95rem] font-semibold transition-colors hover:bg-brand",
                l.active ? "bg-brand" : "",
              ]}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2.5">
      <div class="hidden sm:flex items-center rounded-full border-2 border-ink bg-white p-0.5 text-xs font-bold" role="group" aria-label={isEn ? "Language" : "Idioma"}>
        <a
          href={spanishPath}
          hreflang="es"
          lang="es"
          aria-current={!isEn ? "true" : undefined}
          class:list={["rounded-full px-2.5 py-1.5 min-w-9 text-center", !isEn ? "bg-ink text-white" : "hover:bg-brand"]}>ES</a>
        <a
          href={englishPath}
          hreflang="en"
          lang="en"
          aria-current={isEn ? "true" : undefined}
          class:list={["rounded-full px-2.5 py-1.5 min-w-9 text-center", isEn ? "bg-ink text-white" : "hover:bg-brand"]}>EN</a>
      </div>

      <a href={to("/contact")} class="btn btn-brand btn-sm hidden sm:inline-flex">{ctaLabel}</a>

      <button
        id="nav-toggle"
        type="button"
        class="lg:hidden inline-flex h-11 w-11 items-center justify-center rounded-xl border-2 border-ink bg-white"
        aria-expanded="false"
        aria-controls="nav-panel"
        aria-label={isEn ? "Open menu" : "Abrir menú"}
        data-open-label={isEn ? "Open menu" : "Abrir menú"}
        data-close-label={isEn ? "Close menu" : "Cerrar menú"}
      >
        <svg id="nav-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        <svg id="nav-icon-close" class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
  </div>

  <div id="nav-panel" class="hidden lg:hidden border-t-2 border-ink bg-brand">
    <nav aria-label={isEn ? "Mobile navigation" : "Navegación móvil"} class="mx-auto max-w-(--breakpoint-xl) px-4 py-4 sm:px-5">
      <ul class="grid gap-1.5">
        {links.map((l) => (
          <li>
            <a href={to(l.path)} class="flex min-h-12 items-center justify-between rounded-xl border-2 border-ink bg-white px-4 font-display text-lg font-bold">
              <span>{l.label}</span><span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
        <li class="mt-1 flex items-center gap-2">
          <a href={to("/contact")} class="btn btn-ink flex-1">{ctaLabel}</a>
          <a href={spanishPath} hreflang="es" lang="es" class:list={["btn btn-white btn-sm", !isEn ? "ring-4 ring-ink/20" : ""]}>ES</a>
          <a href={englishPath} hreflang="en" lang="en" class:list={["btn btn-white btn-sm", isEn ? "ring-4 ring-ink/20" : ""]}>EN</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById("nav-toggle");
    var panel = document.getElementById("nav-panel");
    if (!btn || !panel) return;
    var openIcon = document.getElementById("nav-icon-open");
    var closeIcon = document.getElementById("nav-icon-close");
    function setOpen(open) {
      panel.classList.toggle("hidden", !open);
      openIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? btn.dataset.closeLabel : btn.dataset.openLabel);
    }
    btn.addEventListener("click", function () { setOpen(btn.getAttribute("aria-expanded") !== "true"); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") setOpen(false); });
    panel.addEventListener("click", function (e) { if (e.target.closest("a")) setOpen(false); });
  })();
</script>

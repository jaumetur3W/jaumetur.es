---
import { localizePath, localeFromPath, stripLocale } from "@/i18n";
import UiIcon from "@/components/ui-icon.astro";

const rawPathname = Astro.url.pathname;
const locale = localeFromPath(rawPathname);
const isEn = locale === "en";
const pathname = stripLocale(rawPathname);

const withSlash = (path: string) => {
  const hashIndex = path.indexOf("#");
  const base = hashIndex < 0 ? path : path.slice(0, hashIndex);
  const hash = hashIndex < 0 ? "" : path.slice(hashIndex);
  if (/\.[a-z0-9]+$/i.test(base)) return `${base}${hash}`;
  return `${base === "/" || base.endsWith("/") ? base : `${base}/`}${hash}`;
};
const to = (path: string) => withSlash(localizePath(path, locale));

const is404 = rawPathname.includes("404");
const spanishPath = is404 ? "/" : withSlash(localizePath(rawPathname, "es"));
const englishPath = is404 ? "/en/" : withSlash(localizePath(rawPathname, "en"));

const links = [
  { label: isEn ? "Services" : "Servicios", path: "/pricing", active: pathname.startsWith("/pricing") },
  { label: isEn ? "Projects" : "Proyectos", path: "/projectes", active: pathname.startsWith("/projectes") },
  { label: "Blog", path: "/blog", active: pathname.startsWith("/blog") },
  { label: isEn ? "About" : "Sobre mí", path: "/about", active: pathname.startsWith("/about") },
];
const ctaLabel = isEn ? "Get a quote" : "Pedir presupuesto";
const homeLabel = isEn ? "Jaume Tur, home" : "Jaume Tur, inicio";
---

<header id="site-header" class="site-header sticky top-0 z-50 w-full">
  <div class="wrap flex items-center justify-between gap-4 py-2.5">
    <a href={to("/")} class="inline-flex min-h-11 items-center" aria-label={homeLabel}>
      <span class="font-display text-[1.7rem] leading-none">Jaume<span class="italic">&nbsp;</span>Tur<span class="ml-0.5 inline-block h-2 w-2 translate-y-[-0.6em] bg-brand"></span></span>
    </a>

    <nav aria-label={isEn ? "Main navigation" : "Navegación principal"} class="hidden lg:block">
      <ul class="flex items-center gap-7">
        {links.map((l) => (
          <li>
            <a
              href={to(l.path)}
              aria-current={l.active ? "page" : undefined}
              class:list={[
                "inline-flex min-h-11 items-center text-[1rem] font-bold text-ink underline-offset-[0.35em] decoration-[3px]",
                l.active ? "underline decoration-ink" : "no-underline hover:underline hover:decoration-ink",
              ]}
            >{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-4">
      <div class="hidden items-center text-sm font-bold sm:flex" role="group" aria-label={isEn ? "Language" : "Idioma"}>
        <a href={spanishPath} hreflang="es" lang="es" aria-current={!isEn ? "true" : undefined}
           class:list={["inline-flex min-h-11 min-w-9 items-center justify-center", !isEn ? "bg-ink text-paper" : "text-ink hover:underline"]}>ES</a>
        <a href={englishPath} hreflang="en" lang="en" aria-current={isEn ? "true" : undefined}
           class:list={["inline-flex min-h-11 min-w-9 items-center justify-center", isEn ? "bg-ink text-paper" : "text-ink hover:underline"]}>EN</a>
      </div>

      <a href={to("/contact")} class="btn btn-ink btn-sm hidden sm:inline-flex">{ctaLabel}</a>

      <button
        id="nav-toggle"
        type="button"
        class="inline-flex min-h-11 items-center gap-2 rounded-full border-2 border-ink px-3.5 text-sm font-bold text-ink hover:bg-ink hover:text-paper lg:hidden"
        aria-expanded="false"
        aria-controls="nav-panel"
        data-open-label={isEn ? "Menu" : "Menú"}
        data-close-label={isEn ? "Close" : "Cerrar"}
      >
        <span id="nav-toggle-label">{isEn ? "Menu" : "Menú"}</span>
        <UiIcon id="nav-icon-open" name="menu" class="h-[18px] w-[18px]" />
        <UiIcon id="nav-icon-close" name="close" class="hidden h-[18px] w-[18px]" />
      </button>
    </div>
  </div>

  <div id="nav-panel" class="hidden border-t-2 border-ink bg-paper lg:hidden" style="max-height:calc(100dvh - 4.25rem);overflow-y:auto">
    <nav aria-label={isEn ? "Mobile navigation" : "Navegación móvil"} class="wrap pb-8 pt-2">
      <ul>
        {links.map((l) => (
          <li class="border-b border-rule">
            <a href={to(l.path)} aria-current={l.active ? "page" : undefined}
               class:list={["flex min-h-16 items-center font-display text-[2.4rem] font-normal leading-none", l.active ? "underline decoration-ink decoration-[6px] underline-offset-[0.2em]" : ""]} style="font-stretch:75%">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <a href={to("/contact")} class="btn btn-brand mt-8 w-full">{ctaLabel}</a>
      <p class="mt-6 flex items-center gap-3 text-sm font-bold">
        <span class="text-graphite">{isEn ? "Language" : "Idioma"}</span>
        <a href={spanishPath} hreflang="es" lang="es" aria-current={!isEn ? "true" : undefined} class:list={["inline-flex min-h-11 items-center px-2 underline decoration-2 underline-offset-4", !isEn ? "bg-brand" : ""]}>Español</a>
        <a href={englishPath} hreflang="en" lang="en" aria-current={isEn ? "true" : undefined} class:list={["inline-flex min-h-11 items-center px-2 underline decoration-2 underline-offset-4", isEn ? "bg-brand" : ""]}>English</a>
      </p>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById("nav-toggle");
    var panel = document.getElementById("nav-panel");
    if (!btn || !panel) return;
    var openIcon = document.getElementById("nav-icon-open");
    var closeIcon = document.getElementById("nav-icon-close");
    var label = document.getElementById("nav-toggle-label");
    function setOpen(open) {
      panel.classList.toggle("hidden", !open);
      openIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);
      label.textContent = open ? btn.dataset.closeLabel : btn.dataset.openLabel;
      btn.setAttribute("aria-expanded", String(open));
    }
    btn.addEventListener("click", function () { setOpen(btn.getAttribute("aria-expanded") !== "true"); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") { setOpen(false); btn.focus(); } });
    panel.addEventListener("click", function (e) { if (e.target.closest("a")) setOpen(false); });
    window.matchMedia("(min-width: 1024px)").addEventListener("change", function (e) { if (e.matches) setOpen(false); });
  })();
</script>

---
import { localizePath, localeFromPath, stripLocale } from "@/i18n";

const rawPathname = Astro.url.pathname;
const locale = localeFromPath(rawPathname);
const isEn = locale === "en";
const pathname = stripLocale(rawPathname);

const withSlash = (path: string) => {
  const hashIndex = path.indexOf("#");
  const base = hashIndex < 0 ? path : path.slice(0, hashIndex);
  const hash = hashIndex < 0 ? "" : path.slice(hashIndex);
  if (/\.[a-z0-9]+$/i.test(base)) return `${base}${hash}`;
  return `${base === "/" || base.endsWith("/") ? base : `${base}/`}${hash}`;
};
const to = (path: string) => withSlash(localizePath(path, locale));
const spanishPath = withSlash(localizePath(rawPathname, "es"));
const englishPath = withSlash(localizePath(rawPathname, "en"));

const links = [
  { label: isEn ? "Services" : "Servicios", path: "/pricing", active: pathname.startsWith("/pricing") },
  { label: isEn ? "Projects" : "Proyectos", path: "/projectes", active: pathname.startsWith("/projectes") },
  { label: isEn ? "Blog" : "Blog", path: "/blog", active: pathname.startsWith("/blog") },
  { label: isEn ? "Tools" : "Herramientas", path: "/tools/creador-html", active: pathname.startsWith("/tools") },
  { label: isEn ? "About" : "Sobre mí", path: "/about", active: pathname.startsWith("/about") },
];
const ctaLabel = isEn ? "Start a project" : "Iniciar proyecto";
---

<header id="site-header" class="sticky top-0 z-50 w-full border-b border-white/10 bg-[#0a0a0c]/85 backdrop-blur-xl supports-[backdrop-filter]:bg-[#0a0a0c]/80 transition-all">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3.5 sm:px-8">
    <!-- Logo — Minimal, Spatial -->
    <a
      href={to("/")}
      class="group flex min-h-11 items-center gap-3.5 rounded-2xl focus:outline-none"
    >
      <div class="relative flex h-10 w-10 items-center justify-center overflow-hidden rounded-2xl border border-white/[0.08] bg-white/[0.03] transition-all duration-300 group-hover:scale-110 group-hover:border-brand/40 group-hover:shadow-[0_0_20px_rgba(255,255,0,0.15)]">
        <img
          src="/img/jt.LOGO-02-128.webp"
          alt="JT"
          width="40"
          height="40"
          class="h-full w-full object-cover"
          decoding="async"
        />
      </div>
      <div class="flex flex-col">
        <span class="font-display text-lg font-bold tracking-tight text-white leading-none">
          jaume<span class="text-brand">tur</span>
        </span>
        <span class="font-mono text-[0.58rem] tracking-[0.2em] text-zinc-400 uppercase mt-0.5">
          {isEn ? "developer" : "developer"}
        </span>
      </div>
    </a>

    <!-- Desktop Nav — Floating pill -->
    <nav aria-label={isEn ? "Main navigation" : "Navegación principal"} class="hidden lg:block">
      <ul class="flex items-center gap-0.5 rounded-full border border-white/[0.06] bg-white/[0.02] p-1 backdrop-blur-xl">
        {links.map((l) => (
          <li>
            <a
              href={to(l.path)}
              aria-current={l.active ? "page" : undefined}
              class:list={[
                "inline-flex min-h-9 items-center rounded-full px-4 text-[0.8rem] font-medium tracking-wide transition-all duration-300",
                l.active
                  ? "bg-brand text-black font-bold shadow-[0_0_15px_rgba(255,255,0,0.2)]"
                  : "text-white/60 hover:text-white hover:bg-white/[0.05]",
              ]}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <!-- Language toggle -->
      <div class="hidden sm:flex items-center rounded-full border border-white/[0.06] bg-white/[0.02] p-0.5 text-xs font-mono font-medium" role="group" aria-label={isEn ? "Language" : "Idioma"}>
        <a
          href={spanishPath}
          hreflang="es"
          lang="es"
          aria-current={!isEn ? "true" : undefined}
          class:list={["rounded-full px-2.5 py-1 text-center transition-all duration-300", !isEn ? "bg-brand text-black font-bold shadow-sm" : "text-zinc-400 hover:text-white"]}
        >ES</a>
        <a
          href={englishPath}
          hreflang="en"
          lang="en"
          aria-current={isEn ? "true" : undefined}
          class:list={["rounded-full px-2.5 py-1 text-center transition-all duration-300", isEn ? "bg-brand text-black font-bold shadow-sm" : "text-zinc-400 hover:text-white"]}
        >EN</a>
      </div>

      <!-- CTA -->
      <a href={to("/contact")} class="btn btn-brand btn-sm hidden sm:inline-flex">
        <span>{ctaLabel}</span>
        <span aria-hidden="true" class="text-xs transition-transform group-hover:translate-x-0.5">→</span>
      </a>

      <!-- Mobile toggle -->
      <button
        id="nav-toggle"
        type="button"
        class="lg:hidden inline-flex h-10 w-10 items-center justify-center rounded-2xl border border-white/[0.08] bg-white/[0.03] text-white transition-all duration-300 hover:border-brand/40 hover:text-brand active:scale-95"
        aria-expanded="false"
        aria-controls="nav-panel"
        aria-label={isEn ? "Open menu" : "Abrir menú"}
        data-open-label={isEn ? "Open menu" : "Abrir menú"}
        data-close-label={isEn ? "Close menu" : "Cerrar menú"}
      >
        <svg id="nav-icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        <svg id="nav-icon-close" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
  </div>

  <!-- Mobile panel -->
  <div id="nav-panel" class="hidden lg:hidden border-t border-white/10 bg-[#101014]/98 px-5 py-6 backdrop-blur-2xl">
    <nav aria-label={isEn ? "Mobile navigation" : "Navegación móvil"} class="mx-auto max-w-7xl">
      <ul class="grid gap-2">
        {links.map((l) => (
          <li>
            <a href={to(l.path)} class="flex min-h-13 items-center justify-between rounded-2xl border border-white/[0.06] bg-white/[0.02] px-5 font-display text-base font-semibold text-white hover:border-brand/30 hover:text-brand transition-all duration-300">
              <span>{l.label}</span>
              <span class="text-brand/50" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
        <li class="mt-3 pt-4 border-t border-white/[0.06] flex flex-col gap-3">
          <a href={to("/contact")} class="btn btn-brand w-full justify-center">{ctaLabel}</a>
          <div class="flex items-center justify-center gap-2 pt-1 font-mono text-xs">
            <span class="text-zinc-400">Idioma:</span>
            <a href={spanishPath} hreflang="es" lang="es" class:list={["px-3 py-1.5 rounded-lg transition-all", !isEn ? "bg-brand text-black font-bold" : "text-zinc-400 hover:text-white"]}>Español</a>
            <a href={englishPath} hreflang="en" lang="en" class:list={["px-3 py-1.5 rounded-lg transition-all", isEn ? "bg-brand text-black font-bold" : "text-zinc-400 hover:text-white"]}>English</a>
          </div>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById("nav-toggle");
    var panel = document.getElementById("nav-panel");
    if (!btn || !panel) return;
    var openIcon = document.getElementById("nav-icon-open");
    var closeIcon = document.getElementById("nav-icon-close");
    function setOpen(open) {
      panel.classList.toggle("hidden", !open);
      openIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? btn.dataset.closeLabel : btn.dataset.openLabel);
    }
    btn.addEventListener("click", function () { setOpen(btn.getAttribute("aria-expanded") !== "true"); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") setOpen(false); });
    panel.addEventListener("click", function (e) { if (e.target.closest("a")) setOpen(false); });
  })();
</script>

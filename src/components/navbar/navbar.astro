---
import Container from "@/components/container.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import EmojiIcon from "@/components/ui/emoji-icon.astro";

const menuitems = [
  { title: "Inici", path: "/" },
  { title: "Sobre mi", path: "/about" },
  { title: "Projectes", path: "/#projectes" },
  { title: "Habilitats", path: "/#skills" },
  { title: "Eines", path: "/tools/workflow-generator" },
  { title: "Blog", path: "/blog" },
  { title: "Serveis", path: "/pricing" },
  { title: "Contacte", path: "/contact" },
];
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center my-4 gap-4 relative z-50">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <!-- Interactive Brand Logo with Easter Egg Burst -->
        <div class="relative group/logo">
          <a
            href="/"
            id="brand-logo-btn"
            class="flex items-center gap-3 group focus-visible:outline-indigo-600 focus-visible:ring-2 rounded-2xl p-1"
            title="Jaume Tur — Clic per a un toc de màgia ✨">
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-tr from-indigo-500 to-indigo-600 rounded-full blur-xs opacity-40 group-hover:opacity-75 transition-opacity"></div>
              <img
                src="/jt-logo-dark.png"
                alt="Logo personal de Jaume Tur"
                class="relative w-10 h-10 rounded-full ring-2 ring-white shadow-xs group-hover:scale-105 active:scale-95 transition-transform"
                width="40"
                height="40"
              />
              <span class="absolute -bottom-1 -right-1 text-[11px] leading-none pointer-events-none group-hover:rotate-12 transition-transform" aria-hidden="true">
                ✨
              </span>
            </div>
            
            <div class="flex flex-col">
              <div class="flex items-center gap-1.5">
                <span class="font-extrabold text-slate-900 text-base leading-tight tracking-tight group-hover:text-indigo-600 transition-colors">
                  Jaume Tur
                </span>
                <span class="text-xs text-slate-400 font-mono font-normal">/dev</span>
              </div>
              
              <span class="inline-flex items-center gap-1.5 text-[11px] text-emerald-700 font-semibold font-mono">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                <span>Disponible per a projectes</span>
              </span>
            </div>
          </a>

          <!-- Floating emoji burst container -->
          <div id="emoji-burst-container" class="absolute inset-0 pointer-events-none overflow-visible z-50"></div>
        </div>

        <div class="block lg:hidden">
          <MenuIcon class="w-6 h-6 text-slate-800" />
        </div>
      </div>

      <MenuItems class="hidden w-full lg:w-auto mt-4 lg:flex lg:mt-0">
        <nav aria-label="Navegació principal">
          <ul class="flex flex-col lg:flex-row lg:items-center lg:gap-1">
            {
              menuitems.map((item) => (
                <li>
                  <a
                    href={item.path}
                    class="flex px-3 py-1.5 items-center text-xs font-semibold text-slate-600 hover:text-indigo-600 transition rounded-lg hover:bg-white hover:shadow-2xs">
                    <span>{item.title}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="lg:hidden flex flex-col gap-2 mt-4 pt-4 border-t border-slate-200/80">
          <a
            href="/docs/CV_Jaume_tur.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 bg-white text-slate-800 font-bold text-xs hover:bg-slate-50 transition shadow-2xs">
            <EmojiIcon symbol="📄" decorative={true} />
            <span>Descarregar CV (PDF) ↗</span>
          </a>
          <a
            href="/contact"
            class="flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs hover:bg-indigo-600 transition shadow-xs">
            <EmojiIcon symbol="💬" decorative={true} />
            <span>Contactar</span>
          </a>
        </div>
      </MenuItems>
    </Astronav>

    <!-- Desktop Action Buttons with Functional Emojis -->
    <div class="hidden lg:flex items-center gap-2.5">
      <a
        href="/docs/CV_Jaume_tur.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-slate-700 hover:text-indigo-600 border border-slate-200/90 hover:border-indigo-300 rounded-xl bg-white hover:bg-slate-50 transition shadow-2xs group"
        title="Obrir currículum en PDF">
        <EmojiIcon symbol="📄" class="group-hover:-translate-y-0.5 group-hover:rotate-6" decorative={true} />
        <span>CV</span>
        <span class="text-[10px] text-slate-400 font-mono">↗</span>
      </a>
      
      <a
        href="/contact"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-bold text-white bg-slate-900 hover:bg-indigo-600 rounded-xl shadow-xs transition group">
        <EmojiIcon symbol="💬" class="group-hover:scale-110" decorative={true} />
        <span>Contactar</span>
      </a>
    </div>
  </header>
</Container>

<!-- Logo Easter Egg Script: Generates subtle particle emojis upon clicking the logo -->
<script is:inline>
  const logoBtn = document.getElementById("brand-logo-btn");
  const burstContainer = document.getElementById("emoji-burst-container");
  const emojis = ["⚡", "💻", "🚀", "🎨", "🅰️", "✨", "🧩"];

  if (logoBtn && burstContainer) {
    logoBtn.addEventListener("click", (e) => {
      // Don't prevent navigation if clicking on link to home, just spawn delightful celebration
      for (let i = 0; i < 6; i++) {
        const particle = document.createElement("span");
        particle.innerText = emojis[Math.floor(Math.random() * emojis.length)];
        particle.className = "absolute text-sm select-none pointer-events-none transition-all duration-700 ease-out";
        particle.style.left = `${20 + (Math.random() * 40 - 20)}px`;
        particle.style.top = `${10}px`;
        particle.style.transform = `translate(0, 0) scale(0.6)`;
        particle.style.opacity = "1";
        
        burstContainer.appendChild(particle);

        const targetX = (Math.random() - 0.5) * 80;
        const targetY = -(40 + Math.random() * 50);

        requestAnimationFrame(() => {
          particle.style.transform = `translate(${targetX}px, ${targetY}px) scale(1.2)`;
          particle.style.opacity = "0";
        });

        setTimeout(() => {
          particle.remove();
        }, 750);
      }
    });
  }
</script>

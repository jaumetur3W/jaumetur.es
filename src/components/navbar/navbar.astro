---
import { localizePath, localeFromPath, stripLocale } from "@/i18n";
import BrandMark from "@/components/brand-mark.astro";

const rawPathname = Astro.url.pathname;
const locale = localeFromPath(rawPathname);
const isEn = locale === "en";
const pathname = stripLocale(rawPathname);

const withSlash = (path: string) => {
  const hashIndex = path.indexOf("#");
  const base = hashIndex < 0 ? path : path.slice(0, hashIndex);
  const hash = hashIndex < 0 ? "" : path.slice(hashIndex);
  if (/\.[a-z0-9]+$/i.test(base)) return `${base}${hash}`;
  return `${base === "/" || base.endsWith("/") ? base : `${base}/`}${hash}`;
};
const to = (path: string) => withSlash(localizePath(path, locale));
const is404 = rawPathname.includes("404");
const spanishPath = is404 ? "/" : withSlash(localizePath(rawPathname, "es"));
const englishPath = is404 ? "/en/" : withSlash(localizePath(rawPathname, "en"));
const WA = "https://wa.me/34644525838?text=Hola%20Jaume,%20quiero%20informaci%C3%B3n%20sobre%20un%20proyecto";

const links = [
  { n: "01", label: isEn ? "Projects" : "Proyectos", path: "/projectes", active: pathname.startsWith("/projectes") },
  { n: "02", label: isEn ? "Services" : "Servicios", path: "/pricing", active: pathname.startsWith("/pricing") },
  { n: "03", label: "Blog", path: "/blog", active: pathname.startsWith("/blog") },
  { n: "04", label: isEn ? "About" : "Sobre mí", path: "/about", active: pathname.startsWith("/about") },
];
---

<!-- Header flotante y adaptativo con desenfoque de cristal en scroll -->
<header id="site-header" data-tone="light" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="wrap flex items-center justify-between h-20 md:grid md:grid-cols-[1fr_auto_1fr] relative">
    
    <!-- Izquierda: Marca tipográfica con Isotipo JT dinámico y gesto de firma -->
    <a href={to("/")} class="group flex items-center gap-2.5 select-none shrink-0 justify-self-start transition-transform hover:scale-[1.02]" aria-label={isEn ? "jaumetur.es — home" : "jaumetur.es — inicio"}>
      <BrandMark size={32} class="shadow-xs transition-transform duration-200 group-hover:-rotate-3" />
      <span class="wordmark text-[1.4rem] font-bold tracking-tight">jaumetur<i>.</i>es<span class="text-brand inline-block animate-pulse font-mono font-normal">_</span></span>
    </a>

    <!-- Centro: Píldora de navegación flotante en escritorio -->
    <nav
      id="nav-center-menu"
      aria-label={isEn ? "Main navigation" : "Navegación principal"}
      class="hidden md:flex items-center justify-center px-4"
    >
      <ul class="nav-pill-track flex items-center gap-1 bg-white/80 backdrop-blur-md px-2.5 py-1.5 rounded-full border border-ink/10 shadow-xs transition-all duration-300">
        {links.map((l) => (
          <li class="shrink-0">
            <a
              href={to(l.path)}
              aria-current={l.active ? "page" : undefined}
              class:list={[
                "nav-top-link relative inline-flex items-center py-1.5 px-4 text-[0.875rem] font-semibold tracking-wide transition-all duration-200 whitespace-nowrap rounded-full",
                l.active ? "bg-ink text-paper font-bold shadow-xs active-pill" : "text-ink/75 hover:text-ink hover:bg-ink/5"
              ]}
            >
              <span>{l.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Derecha: Selector de Idioma [ES · EN] + CTA 'Hablamos' + Hamburguesa (Solo Móvil) -->
    <div class="flex items-center justify-end gap-2 sm:gap-3 shrink-0 justify-self-end">
      
      <!-- Selector de Idioma compacto y directo en 1 clic -->
      <div class="lang-switch-pill flex items-center bg-white/80 backdrop-blur-md border border-ink/10 rounded-full p-0.5 text-xs font-mono font-bold shadow-xs transition-colors">
        <a
          href={spanishPath}
          hreflang="es"
          lang="es"
          aria-label="Versión en Español"
          class:list={[
            "px-2.5 py-1 rounded-full transition-all duration-200",
            !isEn ? "bg-ink text-paper shadow-xs" : "text-ink/60 hover:text-ink hover:bg-ink/5"
          ]}
        >
          ES
        </a>
        <a
          href={englishPath}
          hreflang="en"
          lang="en"
          aria-label="English version"
          class:list={[
            "px-2.5 py-1 rounded-full transition-all duration-200",
            isEn ? "bg-ink text-paper shadow-xs" : "text-ink/60 hover:text-ink hover:bg-ink/5"
          ]}
        >
          EN
        </a>
      </div>

      <!-- CTA de contacto rápido en escritorio -->
      <a href={to("/contact")} class="nav-cta btn btn-brand !min-h-[2.5rem] !px-5 text-xs font-extrabold uppercase tracking-wider shadow-sm hover:shadow-md transition-all hidden md:inline-flex" data-cursor={isEn ? "Talk" : "Hola"}>
        {isEn ? "Let's talk" : "Hablamos"} <span aria-hidden="true">→</span>
      </a>

      <!-- Botón Hamburguesa animado (EXCLUSIVO MÓVIL) -->
      <button
        id="nav-toggle"
        type="button"
        class="md:hidden flex items-center justify-center w-10 h-10 rounded-full bg-white/80 backdrop-blur-md border border-ink/10 text-ink cursor-pointer transition-transform duration-200 active:scale-95 shadow-xs"
        aria-label={isEn ? "Toggle menu" : "Alternar menú"}
        aria-expanded="false"
        aria-controls="nav-panel"
      >
        <span class="nav-burger-icon flex flex-col justify-center items-center w-5 h-4 gap-[4.5px] relative" aria-hidden="true">
          <span class="burger-line line-1 w-5 h-[2px] bg-ink rounded-full transition-all duration-300 origin-center"></span>
          <span class="burger-line line-2 w-5 h-[2px] bg-ink rounded-full transition-all duration-200"></span>
          <span class="burger-line line-3 w-5 h-[2px] bg-ink rounded-full transition-all duration-300 origin-center"></span>
        </span>
      </button>

    </div>

  </div>

  <!-- Panel desplegable móvil con estética de estudio de diseño -->
  <div
    id="nav-panel"
    class="md:hidden absolute top-[4.75rem] left-4 right-4 bg-paper/98 backdrop-blur-2xl border border-ink/15 rounded-3xl shadow-2xl p-6 transition-all duration-300 -translate-y-4 opacity-0 pointer-events-none invisible z-40"
    aria-hidden="true"
  >
    <div class="flex items-center justify-between pb-4 border-b border-ink/10 mb-4">
      <span class="font-mono text-xs uppercase tracking-widest text-ink/60 font-semibold">
        {isEn ? "Studio Navigation" : "Menú de Navegación"}
      </span>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-teal-50 text-teal-700 border border-teal-200 text-[0.7rem] font-mono font-bold">
        <span class="w-1.5 h-1.5 rounded-full bg-teal-500 animate-pulse"></span>
        {isEn ? "Open for projects" : "Disponible 2026"}
      </span>
    </div>

    <ul class="space-y-1">
      {links.map((l) => (
        <li>
          <a
            href={to(l.path)}
            class:list={[
              "flex items-center justify-between py-3.5 px-3 rounded-2xl transition-all",
              l.active ? "bg-white border border-ink/10 text-brand font-bold shadow-xs" : "text-ink hover:bg-white/60 font-medium"
            ]}
            data-nav-link
          >
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs text-brand font-bold">{l.n}</span>
              <span class="font-display text-lg tracking-tight">{l.label}</span>
            </div>
            <span class="text-xs text-ink/40 font-mono" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>

    <!-- Accesos rápidos en móvil -->
    <div class="mt-5 pt-4 border-t border-ink/10 space-y-3">
      <a href={WA} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 rounded-xl bg-teal-50/70 border border-teal-200/60 text-teal-800 text-xs font-mono font-bold uppercase tracking-wider hover:bg-teal-50 transition-colors">
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span>
          <span>{isEn ? "Direct WhatsApp chat" : "WhatsApp directo en 1 clic"}</span>
        </span>
        <span aria-hidden="true">↗</span>
      </a>

      <a href={to("/contact")} class="btn btn-brand w-full !min-h-[3rem] text-xs font-extrabold uppercase tracking-wider shadow-md" data-nav-link>
        {isEn ? "Get a fixed quote in 24h" : "Presupuesto cerrado en 24h"} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</header>

<style>
  #site-header {
    --nav-fg: #110200;
    --nav-accent: #D4612A;
    color: var(--nav-fg);
  }

  /* Estado cuando el usuario hace scroll hacia abajo: barra con desenfoque de cristal */
  #site-header.is-scrolled {
    background: rgba(255, 247, 240, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(17, 2, 0, 0.08);
    box-shadow: 0 4px 20px -4px rgba(17, 2, 0, 0.04);
  }

  /* Modo oscuro dinámico cuando la barra cruza secciones negras */
  #site-header[data-tone="dark"] {
    --nav-fg: #FFF7F0;
    --nav-accent: #EF8E35;
  }
  #site-header[data-tone="dark"].is-scrolled {
    background: rgba(17, 2, 0, 0.92);
    border-bottom-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 6px 24px -4px rgba(0, 0, 0, 0.4);
  }
  #site-header[data-tone="dark"] .wordmark {
    color: #FFFFFF;
  }
  #site-header[data-tone="dark"] .nav-pill-track,
  #site-header[data-tone="dark"] .lang-switch-pill,
  #site-header[data-tone="dark"] #nav-toggle {
    background: rgba(36, 12, 10, 0.85);
    border-color: rgba(255, 255, 255, 0.15);
  }
  #site-header[data-tone="dark"] .nav-top-link {
    color: rgba(255, 247, 240, 0.75);
  }
  #site-header[data-tone="dark"] .nav-top-link:hover {
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.1);
  }
  #site-header[data-tone="dark"] .nav-top-link.active-pill {
    background: #FFFFFF;
    color: #110200;
  }
  #site-header[data-tone="dark"] .lang-switch-pill a {
    color: rgba(255, 247, 240, 0.7);
  }
  #site-header[data-tone="dark"] .lang-switch-pill a:hover {
    color: #FFFFFF;
  }
  #site-header[data-tone="dark"] .lang-switch-pill a.bg-ink {
    background: #FFFFFF;
    color: #110200;
  }
  #site-header[data-tone="dark"] .burger-line {
    background: #FFFFFF;
  }

  /* Transiciones tipográficas suaves */
  #site-header .wordmark { color: var(--nav-fg); transition: color 250ms ease; }
  #site-header .wordmark i { color: var(--nav-accent); }

  /* Animación de la hamburguesa a 'X' cuando el panel móvil está abierto */
  #site-header.is-menu-open #nav-toggle .line-1 {
    transform: translateY(6.5px) rotate(45deg);
  }
  #site-header.is-menu-open #nav-toggle .line-2 {
    opacity: 0;
    transform: scaleX(0);
  }
  #site-header.is-menu-open #nav-toggle .line-3 {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* Panel móvil visible */
  #site-header.is-menu-open #nav-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    visibility: visible;
  }
</style>

<script is:inline>
  (function () {
    // 1. Detección de scroll para aplicar fondo de cristal translúcido
    var onScroll = function () {
      var header = document.getElementById("site-header");
      if (!header) return;
      if (window.scrollY > 15) {
        header.classList.add("is-scrolled");
      } else {
        header.classList.remove("is-scrolled");
      }
    };

    // 2. Tono adaptativo según la luminosidad del fondo inferior
    var parseRgb = function (c) {
      var m = c.match(/rgba?\(([^)]+)\)/);
      if (!m) return null;
      var p = m[1].split(",").map(function (x) { return parseFloat(x); });
      return { r: p[0], g: p[1], b: p[2], a: p.length > 3 ? p[3] : 1 };
    };
    var bgUnder = function (el) {
      while (el && el !== document.documentElement) {
        var c = parseRgb(getComputedStyle(el).backgroundColor);
        if (c && c.a > 0.5) return c;
        el = el.parentElement;
      }
      return { r: 244, g: 243, b: 238, a: 1 };
    };
    var toneFor = function (c) {
      var lum = (0.2126 * c.r + 0.7152 * c.g + 0.0722 * c.b) / 255;
      return lum < 0.45 ? "dark" : "light";
    };

    var ticking = false;
    var updateTone = function () {
      ticking = false;
      var header = document.getElementById("site-header");
      if (!header) return;
      var y = Math.round(header.getBoundingClientRect().height / 2);
      var votes = {};
      var best = "light";
      var xs = [0.1, 0.3, 0.5, 0.7, 0.9];
      xs.forEach(function (f) {
        var els = document.elementsFromPoint(Math.round(window.innerWidth * f), y);
        var target = null;
        for (var i = 0; i < els.length; i++) {
          if (!header.contains(els[i])) { target = els[i]; break; }
        }
        var t = target ? toneFor(bgUnder(target)) : "light";
        votes[t] = (votes[t] || 0) + 1;
        if (votes[t] > (votes[best] || 0)) best = t;
      });
      if (header.dataset.tone !== best) header.dataset.tone = best;
    };

    var requestTone = function () {
      if (!ticking) { ticking = true; requestAnimationFrame(updateTone); }
    };

    // 3. Inicialización interactiva del menú
    function initNav() {
      var header = document.getElementById("site-header");
      var toggleBtn = document.getElementById("nav-toggle");
      var panel = document.getElementById("nav-panel");
      if (!header || !toggleBtn) return;

      onScroll();
      updateTone();

      if (toggleBtn.dataset.bound === "true") return;
      toggleBtn.dataset.bound = "true";

      toggleBtn.addEventListener("click", function (e) {
        e.stopPropagation();
        var isOpen = header.classList.contains("is-menu-open");
        header.classList.toggle("is-menu-open", !isOpen);
        toggleBtn.setAttribute("aria-expanded", String(!isOpen));
        if (panel) panel.setAttribute("aria-hidden", String(isOpen));
      });

      // Cerrar al pulsar fuera del panel
      document.addEventListener("click", function (e) {
        if (header.classList.contains("is-menu-open") && !header.contains(e.target)) {
          header.classList.remove("is-menu-open");
          toggleBtn.setAttribute("aria-expanded", "false");
          if (panel) panel.setAttribute("aria-hidden", "true");
        }
      });

      // Cerrar al pulsar en un enlace del panel móvil
      if (panel) {
        panel.querySelectorAll("a").forEach(function (link) {
          link.addEventListener("click", function () {
            header.classList.remove("is-menu-open");
            toggleBtn.setAttribute("aria-expanded", "false");
            panel.setAttribute("aria-hidden", "true");
          });
        });
      }

      // Cerrar con Escape
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && header.classList.contains("is-menu-open")) {
          header.classList.remove("is-menu-open");
          toggleBtn.setAttribute("aria-expanded", "false");
          if (panel) panel.setAttribute("aria-hidden", "true");
          toggleBtn.focus();
        }
      });
    }

    if (!window.__navEventsBound) {
      window.__navEventsBound = true;
      window.addEventListener("scroll", function () { onScroll(); requestTone(); }, { passive: true });
      window.addEventListener("resize", function () { onScroll(); requestTone(); });
      window.addEventListener("load", function () { onScroll(); requestTone(); });
      document.addEventListener("DOMContentLoaded", initNav);
    }

    initNav();
    document.addEventListener("astro:page-load", initNav);
    document.addEventListener("astro:after-swap", initNav);
  })();
</script>

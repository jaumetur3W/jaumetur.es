  #site-navbar-wrap.hero-intro-dark #lang-dropdown-btn,
  #site-navbar-wrap.hero-intro-dark #lang-dropdown-btn span,
  #site-navbar-wrap.hero-intro-dark #lang-dropdown-btn svg {

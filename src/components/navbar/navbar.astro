---
import { localizePath, localeFromPath, stripLocale } from "@/i18n";

const rawPathname = Astro.url.pathname;
const locale = localeFromPath(rawPathname);
const isEn = locale === "en";
const pathname = stripLocale(rawPathname);

const withSlash = (path: string) => {
  const hashIndex = path.indexOf("#");
  const base = hashIndex < 0 ? path : path.slice(0, hashIndex);
  const hash = hashIndex < 0 ? "" : path.slice(hashIndex);
  if (/\.[a-z0-9]+$/i.test(base)) return `${base}${hash}`;
  return `${base === "/" || base.endsWith("/") ? base : `${base}/`}${hash}`;
};
const to = (path: string) => withSlash(localizePath(path, locale));
const is404 = rawPathname.includes("404");
const spanishPath = is404 ? "/" : withSlash(localizePath(rawPathname, "es"));
const englishPath = is404 ? "/en/" : withSlash(localizePath(rawPathname, "en"));

const links = [
  { label: isEn ? "Services" : "Servicios", path: "/pricing", active: pathname.startsWith("/pricing") },
  { label: isEn ? "Projects" : "Proyectos", path: "/projectes", active: pathname.startsWith("/projectes") },
  { label: "Blog", path: "/blog", active: pathname.startsWith("/blog") },
  { label: isEn ? "About" : "Sobre mí", path: "/about", active: pathname.startsWith("/about") },
];
const ctaLabel = isEn ? "Get a quote" : "Pedir presupuesto";
---

<header id="site-header" class="site-header sticky top-0 z-50 w-full">
  <div class="wrap flex items-center justify-between gap-4 py-3">
    <a href={to("/")} class="flex min-h-11 items-center gap-3" aria-label={isEn ? "jaumetur — home" : "jaumetur — inicio"}>
      <img src="/img/jt.LOGO-02-128.webp" alt="" width="36" height="36" class="h-9 w-9 rounded-sm" decoding="async" />
      <span class="font-display text-[1.35rem] font-extrabold leading-none tracking-tight" style="font-stretch:85%">jaume<span class="text-brand">tur</span></span>
    </a>

    <nav aria-label={isEn ? "Main navigation" : "Navegación principal"} class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {links.map((l) => (
          <li>
            <a
              href={to(l.path)}
              aria-current={l.active ? "page" : undefined}
              class:list={[
                "inline-flex min-h-11 items-center px-3.5 text-[0.95rem] font-medium underline decoration-2 underline-offset-[0.5em] transition-colors",
                l.active ? "text-white decoration-brand" : "text-white/80 decoration-transparent hover:text-white hover:decoration-white/60",
              ]}
            >{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <div class="hidden items-center text-sm font-semibold sm:flex" role="group" aria-label={isEn ? "Language" : "Idioma"}>
        <a href={spanishPath} hreflang="es" lang="es" aria-current={!isEn ? "true" : undefined}
           class:list={["inline-flex min-h-11 min-w-9 items-center justify-center", !isEn ? "text-brand" : "text-white/70 hover:text-white"]}>ES</a>
        <span class="text-white/30" aria-hidden="true">/</span>
        <a href={englishPath} hreflang="en" lang="en" aria-current={isEn ? "true" : undefined}
           class:list={["inline-flex min-h-11 min-w-9 items-center justify-center", isEn ? "text-brand" : "text-white/70 hover:text-white"]}>EN</a>
      </div>

      <a href={to("/contact")} class="btn btn-brand btn-sm hidden sm:inline-flex">{ctaLabel}</a>

      <button
        id="nav-toggle"
        type="button"
        class="inline-flex min-h-11 items-center gap-2 rounded-sm border border-white/25 px-3.5 text-sm font-semibold text-white transition-colors hover:border-brand hover:text-brand lg:hidden"
        aria-expanded="false"
        aria-controls="nav-panel"
        data-open-label={isEn ? "Menu" : "Menú"}
        data-close-label={isEn ? "Close" : "Cerrar"}
      >
        <span id="nav-toggle-label">{isEn ? "Menu" : "Menú"}</span>
        <svg id="nav-icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"></path></svg>
        <svg id="nav-icon-close" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
      </button>
    </div>
  </div>

  <div id="nav-panel" class="hidden border-t border-white/15 bg-[#0b0b09] lg:hidden" style="max-height:calc(100dvh - 4.25rem);overflow-y:auto">
    <nav aria-label={isEn ? "Mobile navigation" : "Navegación móvil"} class="wrap pb-6 pt-2">
      <ul>
        {links.map((l) => (
          <li class="border-b border-white/15">
            <a href={to(l.path)} aria-current={l.active ? "page" : undefined}
               class:list={["flex min-h-14 items-center justify-between font-display text-3xl font-bold", l.active ? "text-brand" : "text-white"]} style="font-stretch:82%">
              <span>{l.label}</span>
              <span aria-hidden="true" class="text-xl text-brand">→</span>
            </a>
          </li>
        ))}
      </ul>
      <a href={to("/contact")} class="btn btn-brand mt-6 w-full">{ctaLabel}</a>
      <p class="mt-5 flex items-center gap-1 text-sm">
        <span class="text-white/70">{isEn ? "Language" : "Idioma"}:</span>
        <a href={spanishPath} hreflang="es" lang="es" aria-current={!isEn ? "true" : undefined} class:list={["inline-flex min-h-11 items-center px-3 font-semibold", !isEn ? "text-brand" : "text-white/80"]}>Español</a>
        <a href={englishPath} hreflang="en" lang="en" aria-current={isEn ? "true" : undefined} class:list={["inline-flex min-h-11 items-center px-3 font-semibold", isEn ? "text-brand" : "text-white/80"]}>English</a>
      </p>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById("nav-toggle");
    var panel = document.getElementById("nav-panel");
    if (!btn || !panel) return;
    var openIcon = document.getElementById("nav-icon-open");
    var closeIcon = document.getElementById("nav-icon-close");
    var label = document.getElementById("nav-toggle-label");
    function setOpen(open) {
      panel.classList.toggle("hidden", !open);
      openIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);
      label.textContent = open ? btn.dataset.closeLabel : btn.dataset.openLabel;
      btn.setAttribute("aria-expanded", String(open));
    }
    btn.addEventListener("click", function () { setOpen(btn.getAttribute("aria-expanded") !== "true"); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") { setOpen(false); btn.focus(); } });
    panel.addEventListener("click", function (e) { if (e.target.closest("a")) setOpen(false); });
    window.matchMedia("(min-width: 1024px)").addEventListener("change", function (e) { if (e.matches) setOpen(false); });
  })();
</script>

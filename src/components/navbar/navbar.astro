---
import { localizePath, localeFromPath, stripLocale } from "@/i18n";

const rawPathname = Astro.url.pathname;
const locale = localeFromPath(rawPathname);
const isEn = locale === "en";
const pathname = stripLocale(rawPathname);

const withSlash = (path: string) => {
  const hashIndex = path.indexOf("#");
  const base = hashIndex < 0 ? path : path.slice(0, hashIndex);
  const hash = hashIndex < 0 ? "" : path.slice(hashIndex);
  if (/\.[a-z0-9]+$/i.test(base)) return `${base}${hash}`;
  return `${base === "/" || base.endsWith("/") ? base : `${base}/`}${hash}`;
};
const to = (path: string) => withSlash(localizePath(path, locale));
const is404 = rawPathname.includes("404");
const spanishPath = is404 ? "/" : withSlash(localizePath(rawPathname, "es"));
const englishPath = is404 ? "/en/" : withSlash(localizePath(rawPathname, "en"));

const links = [
  { label: isEn ? "Services" : "Servicios", path: "/pricing", active: pathname.startsWith("/pricing") },
  { label: isEn ? "Projects" : "Proyectos", path: "/projectes", active: pathname.startsWith("/projectes") },
  { label: "Blog", path: "/blog", active: pathname.startsWith("/blog") },
  { label: isEn ? "About" : "Sobre mí", path: "/about", active: pathname.startsWith("/about") },
];
const ctaLabel = isEn ? "Get a quote" : "Pedir presupuesto";
---

<header id="site-header" class="site-header sticky top-0 z-50 w-full">
  <div class="wrap flex items-center justify-between gap-4 py-2.5">
    <a href={to("/")} class="flex min-h-11 items-center gap-2.5" aria-label={isEn ? "jaumetur — home" : "jaumetur — inicio"}>
      <img src="/img/jt.LOGO-02-128.webp" alt="" width="36" height="36" class="h-9 w-9 rounded-lg border-2 border-ink" decoding="async" />
      <span class="font-display text-[1.3rem] uppercase leading-none tracking-tight">jaume<span class="hl ml-[1px]">tur</span></span>
    </a>

    <nav aria-label={isEn ? "Main navigation" : "Navegación principal"} class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {links.map((l) => (
          <li>
            <a
              href={to(l.path)}
              aria-current={l.active ? "page" : undefined}
              class:list={[
                "nav-link inline-flex min-h-11 items-center px-3.5 text-[0.9rem] font-bold uppercase tracking-wide",
                l.active ? "is-active" : "",
              ]}
            ><span>{l.label}</span></a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <div class="hidden items-center font-mono text-[0.8rem] font-bold sm:flex" role="group" aria-label={isEn ? "Language" : "Idioma"}>
        <a href={spanishPath} hreflang="es" lang="es" aria-current={!isEn ? "true" : undefined}
           class:list={["inline-flex min-h-11 min-w-9 items-center justify-center", !isEn ? "underline decoration-[3px] underline-offset-4" : "text-ink/70 hover:text-ink"]}>ES</a>
        <span class="text-ink/40" aria-hidden="true">/</span>
        <a href={englishPath} hreflang="en" lang="en" aria-current={isEn ? "true" : undefined}
           class:list={["inline-flex min-h-11 min-w-9 items-center justify-center", isEn ? "underline decoration-[3px] underline-offset-4" : "text-ink/70 hover:text-ink"]}>EN</a>
      </div>

      <a href={to("/contact")} class="btn btn-brand btn-sm hidden sm:inline-flex">{ctaLabel}</a>

      <button
        id="nav-toggle"
        type="button"
        class="inline-flex min-h-11 items-center gap-2 rounded-full border-2 border-ink bg-white/70 px-4 text-sm font-bold uppercase transition-colors hover:bg-brand lg:hidden"
        aria-expanded="false"
        aria-controls="nav-panel"
        data-open-label={isEn ? "Menu" : "Menú"}
        data-close-label={isEn ? "Close" : "Cerrar"}
      >
        <span id="nav-toggle-label">{isEn ? "Menu" : "Menú"}</span>
        <svg id="nav-icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"></path></svg>
        <svg id="nav-icon-close" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
      </button>
    </div>
  </div>

  <div id="nav-panel" class="hidden border-t-[1.5px] border-ink bg-paper lg:hidden" style="max-height:calc(100dvh - 4.25rem);overflow-y:auto">
    <nav aria-label={isEn ? "Mobile navigation" : "Navegación móvil"} class="wrap pb-6 pt-2">
      <ul>
        {links.map((l) => (
          <li class="border-b-[1.5px] border-ink">
            <a href={to(l.path)} aria-current={l.active ? "page" : undefined}
               class="flex min-h-14 items-center justify-between font-display text-[1.7rem] uppercase">
              <span class:list={[l.active ? "hl" : ""]}>{l.label}</span>
              <span aria-hidden="true" class="text-xl">→</span>
            </a>
          </li>
        ))}
      </ul>
      <a href={to("/contact")} class="btn btn-brand mt-6 w-full">{ctaLabel}</a>
      <p class="mt-5 flex items-center gap-1 text-sm">
        <span class="text-ink/70">{isEn ? "Language" : "Idioma"}:</span>
        <a href={spanishPath} hreflang="es" lang="es" aria-current={!isEn ? "true" : undefined} class:list={["inline-flex min-h-11 items-center px-3 font-bold", !isEn ? "hl" : ""]}>Español</a>
        <a href={englishPath} hreflang="en" lang="en" aria-current={isEn ? "true" : undefined} class:list={["inline-flex min-h-11 items-center px-3 font-bold", isEn ? "hl" : ""]}>English</a>
      </p>
    </nav>
  </div>
</header>

<style>
  .nav-link span {
    background-image: linear-gradient(var(--brand), var(--brand));
    background-repeat: no-repeat;
    background-position: 0 90%;
    background-size: 0% 0.4em;
    transition: background-size 0.3s var(--ease-out);
  }
  .nav-link:hover span, .nav-link.is-active span { background-size: 100% 0.4em; }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById("nav-toggle");
    var panel = document.getElementById("nav-panel");
    if (!btn || !panel) return;
    var openIcon = document.getElementById("nav-icon-open");
    var closeIcon = document.getElementById("nav-icon-close");
    var label = document.getElementById("nav-toggle-label");
    function setOpen(open) {
      panel.classList.toggle("hidden", !open);
      openIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);
      label.textContent = open ? btn.dataset.closeLabel : btn.dataset.openLabel;
      btn.setAttribute("aria-expanded", String(open));
    }
    btn.addEventListener("click", function () { setOpen(btn.getAttribute("aria-expanded") !== "true"); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") { setOpen(false); btn.focus(); } });
    panel.addEventListener("click", function (e) { if (e.target.closest("a")) setOpen(false); });
    window.matchMedia("(min-width: 1024px)").addEventListener("change", function (e) { if (e.matches) setOpen(false); });
  })();
</script>

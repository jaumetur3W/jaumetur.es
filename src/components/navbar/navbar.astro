---
import { localizePath, localeFromPath, stripLocale } from "@/i18n";

const rawPathname = Astro.url.pathname;
const locale = localeFromPath(rawPathname);
const isEn = locale === "en";
const pathname = stripLocale(rawPathname);

const withSlash = (path: string) => {
  const hashIndex = path.indexOf("#");
  const base = hashIndex < 0 ? path : path.slice(0, hashIndex);
  const hash = hashIndex < 0 ? "" : path.slice(hashIndex);
  if (/\.[a-z0-9]+$/i.test(base)) return `${base}${hash}`;
  return `${base === "/" || base.endsWith("/") ? base : `${base}/`}${hash}`;
};
const to = (path: string) => withSlash(localizePath(path, locale));
const is404 = rawPathname.includes("404");
const spanishPath = is404 ? "/" : withSlash(localizePath(rawPathname, "es"));
const englishPath = is404 ? "/en/" : withSlash(localizePath(rawPathname, "en"));

const links = [
  { label: isEn ? "Services" : "Servicios", path: "/pricing", active: pathname.startsWith("/pricing") },
  { label: isEn ? "Projects" : "Proyectos", path: "/projectes", active: pathname.startsWith("/projectes") },
  { label: "Blog", path: "/blog", active: pathname.startsWith("/blog") },
  { label: isEn ? "About" : "Sobre mí", path: "/about", active: pathname.startsWith("/about") },
];
const ctaLabel = isEn ? "Get a quote" : "Pedir presupuesto";
---

<!-- Header superior: los enlaces NO se ven al entrar a la web. En la derecha está el botón con icono de 3 líneas horizontales -->
<header id="site-header" class="fixed top-0 left-0 right-0 z-50 bg-transparent transition-all duration-300">
  <div class="wrap flex h-20 items-center justify-between relative z-50">
    
    <!-- Logo oficial de Jaume Tur + Firma tipográfica -->
    <a href={to("/")} class="group flex items-center gap-3 select-none" aria-label={isEn ? "jaumetur — home" : "jaumetur — inicio"}>
      <img
        src="/img/jt.LOGO-02-128.webp"
        alt="Jaume Tur Logo"
        width="38"
        height="38"
        class="h-9 w-9 rounded-lg border-[1.5px] border-ink object-contain shadow-xs group-hover:scale-105 transition-transform"
        decoding="async"
      />
      <span class="font-display text-[1.3rem] font-extrabold tracking-[-0.03em] leading-none text-ink">
        jaume <span class="serif-italic text-[1.22em] font-normal tracking-normal text-ink/80">tur</span>
      </span>
    </a>

    <!-- Zona derecha: selector de idioma + botón con icono de 3 líneas horizontales -->
    <div class="flex items-center gap-3 sm:gap-4">
      <div class="flex items-center font-mono text-[0.78rem] font-bold" role="group" aria-label={isEn ? "Language" : "Idioma"}>
        <a href={spanishPath} hreflang="es" lang="es" aria-current={!isEn ? "true" : undefined}
           class:list={["px-2.5 py-1 rounded transition-colors", !isEn ? "bg-ink text-white" : "text-ink/70 hover:text-ink"]}>ES</a>
        <span class="text-ink/30 mx-0.5">/</span>
        <a href={englishPath} hreflang="en" lang="en" aria-current={isEn ? "true" : undefined}
           class:list={["px-2.5 py-1 rounded transition-colors", isEn ? "bg-ink text-white" : "text-ink/70 hover:text-ink"]}>EN</a>
      </div>

      <!-- Botón de menú con 3 líneas horizontales para mostrar/ocultar los enlaces superiores -->
      <button
        id="nav-toggle"
        type="button"
        class="group flex items-center gap-2.5 px-3.5 py-2 rounded-full border border-ink/20 bg-white/90 hover:bg-ink hover:text-white text-ink transition-all cursor-pointer shadow-xs"
        aria-label={isEn ? "Toggle navigation menu" : "Mostrar u ocultar menú de navegación"}
        aria-expanded="false"
        aria-controls="nav-dropdown"
      >
        <span id="nav-toggle-label" class="text-xs font-display font-bold uppercase tracking-wider select-none hidden sm:inline">
          {isEn ? "Menu" : "Menú"}
        </span>
        <!-- Icono de 3 líneas horizontales que se transforma suavemente en X al abrir -->
        <span class="nav-burger-icon flex flex-col justify-center items-center w-5 h-4 gap-1 relative" aria-hidden="true">
          <span class="burger-line line-1 w-5 h-[2px] bg-current rounded-full transition-transform duration-300"></span>
          <span class="burger-line line-2 w-5 h-[2px] bg-current rounded-full transition-opacity duration-300"></span>
          <span class="burger-line line-3 w-5 h-[2px] bg-current rounded-full transition-transform duration-300"></span>
        </span>
      </button>
    </div>

  </div>

  <!-- Desplegable superior de enlaces de navegación (sin fondo opaco pesado, integrado sobre el lienzo) -->
  <div
    id="nav-dropdown"
    class="absolute top-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-b border-ink/15 shadow-xl transition-all duration-300 -translate-y-full opacity-0 pointer-events-none pt-24 pb-8"
    aria-hidden="true"
  >
    <div class="wrap flex flex-col md:flex-row md:items-center justify-between gap-6">
      
      <!-- Enlaces horizontales directos -->
      <nav aria-label={isEn ? "Main navigation" : "Navegación principal"}>
        <ul class="flex flex-col md:flex-row md:items-center gap-4 md:gap-8 lg:gap-12">
          {links.map((l) => (
            <li>
              <a
                href={to(l.path)}
                aria-current={l.active ? "page" : undefined}
                class:list={[
                  "nav-top-link relative inline-flex items-center py-2 font-display text-xl md:text-base font-bold uppercase tracking-wider text-ink transition-all",
                  l.active ? "text-ink font-extrabold" : "text-ink/75 hover:text-ink"
                ]}
                data-nav-link
              >
                <span>{l.label}</span>
                {l.active && <span class="absolute -bottom-1 left-0 right-0 h-[2px] bg-[#ffff00] border-b border-ink"></span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Botón de acción dentro del menú desplegado -->
      <div class="flex items-center gap-4 pt-4 md:pt-0 border-t md:border-t-0 border-ink/10">
        <a href={to("/contact")} class="btn btn-dark !min-h-[2.8rem] !px-6 text-xs font-bold uppercase tracking-wider" data-nav-link>
          {ctaLabel} <span aria-hidden="true">→</span>
        </a>
      </div>

    </div>
  </div>

  <!-- Backdrop suave al abrirse el menú para cerrar al pulsar fuera -->
  <div id="nav-backdrop" class="fixed inset-0 bg-ink/20 backdrop-blur-xs opacity-0 pointer-events-none transition-opacity duration-300 -z-10" aria-hidden="true"></div>
</header>

<style>
  .nav-top-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 3px;
    background: #ffff00;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms ease;
  }
  .nav-top-link:hover::after {
    transform: scaleX(1);
  }

  /* Estado abierto del menú superior */
  #site-header.is-menu-open #nav-dropdown {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  #site-header.is-menu-open #nav-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  /* Transformación de las 3 líneas a X al abrirse */
  #site-header.is-menu-open .line-1 {
    transform: translateY(6px) rotate(45deg);
  }
  #site-header.is-menu-open .line-2 {
    opacity: 0;
  }
  #site-header.is-menu-open .line-3 {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>

<script is:inline>
  (function () {
    var header = document.getElementById("site-header");
    var toggleBtn = document.getElementById("nav-toggle");
    var dropdown = document.getElementById("nav-dropdown");
    var backdrop = document.getElementById("nav-backdrop");
    var label = document.getElementById("nav-toggle-label");
    if (!header || !toggleBtn || !dropdown) return;

    var setOpen = function (open) {
      header.classList.toggle("is-menu-open", open);
      toggleBtn.setAttribute("aria-expanded", String(open));
      dropdown.setAttribute("aria-hidden", String(!open));
      if (label) {
        var isEn = document.documentElement.lang === "en";
        label.textContent = open ? (isEn ? "Close" : "Cerrar") : (isEn ? "Menu" : "Menú");
      }
    };

    toggleBtn.addEventListener("click", function (e) {
      e.stopPropagation();
      var isOpen = header.classList.contains("is-menu-open");
      setOpen(!isOpen);
    });

    if (backdrop) {
      backdrop.addEventListener("click", function () {
        setOpen(false);
      });
    }

    // Cerrar al hacer clic en cualquier enlace del menú
    dropdown.querySelectorAll("[data-nav-link]").forEach(function (link) {
      link.addEventListener("click", function () {
        setOpen(false);
      });
    });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && header.classList.contains("is-menu-open")) {
        setOpen(false);
      }
    });
  })();
</script>

---
import { Icon } from "astro-icon/components";

const sections = [
  { id: "hero", label: "Inici", icon: "bx:home-alt" },
  { id: "projectes", label: "Projectes", icon: "bx:briefcase" },
  { id: "skills", label: "Habilitats", icon: "bx:code-alt" },
  { id: "workflow", label: "CI/CD Flux", icon: "bx:git-branch" },
  { id: "contacte", label: "Contacte", icon: "bx:envelope" },
];
---

<!-- Floating Storytelling Section Navigator (Desktop & Tablet) -->
<nav
  id="scroll-storyteller"
  aria-label="Indicador de secció activa"
  class="fixed right-4 top-1/2 -translate-y-1/2 z-40 hidden xl:flex flex-col gap-2.5 p-2 rounded-2xl bg-white/90 backdrop-blur-md border border-slate-200/90 shadow-lg select-none transition-all duration-300 opacity-90 hover:opacity-100"
>
  {sections.map((sec) => (
    <a
      href={`#${sec.id}`}
      data-section-target={sec.id}
      class="scroll-dot-link group relative flex items-center justify-end p-1.5 rounded-xl text-slate-400 hover:text-indigo-600 transition-colors"
      title={sec.label}
      aria-label={`Saltar a la secció ${sec.label}`}
    >
      <!-- Hover tooltip pill -->
      <span class="absolute right-full mr-3 px-2.5 py-1 rounded-lg bg-slate-900 text-white text-[11px] font-mono font-medium whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0 transition-all shadow-md">
        {sec.label}
      </span>

      <!-- Indicator Dot & Icon -->
      <span class="scroll-dot relative w-7 h-7 rounded-lg flex items-center justify-center bg-slate-100 group-hover:bg-indigo-50 transition-all">
        <Icon name={sec.icon} class="w-3.5 h-3.5 transition-transform group-hover:scale-110" />
      </span>
    </a>
  ))}
</nav>

<script is:inline>
  function setupScrollStoryteller() {
    const nav = document.getElementById("scroll-storyteller");
    if (!nav) return;

    const links = Array.from(nav.querySelectorAll(".scroll-dot-link"));
    const sectionIds = links.map(l => l.getAttribute("data-section-target")).filter(Boolean);

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const currentId = entry.target.id;
          links.forEach(link => {
            const isMatch = link.getAttribute("data-section-target") === currentId;
            const dot = link.querySelector(".scroll-dot");
            if (isMatch) {
              link.classList.add("text-indigo-600");
              if (dot) {
                dot.classList.add("bg-indigo-600", "text-white", "shadow-sm", "shadow-indigo-500/30");
                dot.classList.remove("bg-slate-100");
              }
            } else {
              link.classList.remove("text-indigo-600");
              if (dot) {
                dot.classList.remove("bg-indigo-600", "text-white", "shadow-sm", "shadow-indigo-500/30");
                dot.classList.add("bg-slate-100");
              }
            }
          });
        }
      });
    }, {
      rootMargin: "-25% 0px -50% 0px",
      threshold: 0.1
    });

    sectionIds.forEach(id => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }

  setupScrollStoryteller();
  document.addEventListener("astro:page-load", setupScrollStoryteller);
</script>


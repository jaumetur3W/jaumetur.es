---
// Lista de servicios por niveles: web, aplicaciones, optimización.
import { services as serviceEsData } from "@/data/services-es";
import { services as serviceEnData } from "@/data/services-en";

interface Props {
  isEn: boolean;
}

const { isEn } = Astro.props;
const services = (isEn ? serviceEnData : serviceEsData) as any[];

const byTier = services.reduce(
  (acc, svc) => {
    if (!acc[svc.tier]) acc[svc.tier] = [];
    acc[svc.tier].push(svc);
    return acc;
  },
  {} as Record<string, typeof services>
);

const tierOrder = ["web", "app", "optimization"];
const euro = (n: number | string) => (isEn ? `€${n}` : `${n} €`);
---

<div class="services-tiers mt-10 sm:mt-14">
  {tierOrder.map((tier, ti) => (
    <div class="tier-group mb-20 last:mb-0 reveal">
      <span class:list={["sticker mb-5", ti % 2 ? "sticker-paper" : "sticker-ink"]} style={`--rot:${ti % 2 ? "2deg" : "-2deg"}`}>
        {isEn ? byTier[tier]?.[0]?.tier_label_en : byTier[tier]?.[0]?.tier_label_es}
      </span>
      <ul class="border-t-[3px] border-ink">
        {byTier[tier]?.map((svc: any) => (
          <li class="service-card border-b-2 border-ink">
            <a href={`${isEn ? "/en" : ""}/pricing/${svc.id}/`} class="svc-row grid gap-4 py-8 lg:grid-cols-12 lg:gap-8 lg:py-10">
              <span class="h-card lg:col-span-4">{isEn ? svc.name_en : svc.name_es}</span>
              <span class="lg:col-span-5">
                <span class="block text-[1.05rem] leading-relaxed text-graphite">{isEn ? svc.problem_en : svc.problem_es}</span>
                <span class="mt-3 block font-semibold leading-snug">{isEn ? svc.benefit_en : svc.benefit_es}</span>
              </span>
              <span class="flex flex-wrap items-baseline gap-x-3 lg:col-span-3 lg:flex-col lg:items-end lg:text-right">
                <span class="label">{isEn ? "from" : "desde"}</span>
                <span class="price-figure text-[1.9rem]">{euro(isEn ? svc.pricing_en.initial : svc.pricing_es.initial)}</span>
                <span class="meta">+ {euro(isEn ? svc.pricing_en.monthly : svc.pricing_es.monthly)}{isEn ? "/month" : "/mes"}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>

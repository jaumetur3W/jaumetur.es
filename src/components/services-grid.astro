---
// Lista de servicios por niveles: web, aplicaciones, optimización.
import { services as serviceEsData } from "@/data/services-es";
import { services as serviceEnData } from "@/data/services-en";

interface Props {
  isEn: boolean;
}

const { isEn } = Astro.props;
const services = (isEn ? serviceEnData : serviceEsData) as any[];

const byTier = services.reduce(
  (acc, svc) => {
    if (!acc[svc.tier]) acc[svc.tier] = [];
    acc[svc.tier].push(svc);
    return acc;
  },
  {} as Record<string, typeof services>
);

const tierOrder = ["web", "app", "optimization"];
---

<div class="services-tiers mt-14 sm:mt-20">
  {tierOrder.map((tier) => (
    <div class="tier-group mb-16 last:mb-0">
      <p class="meta mb-4">
        {byTier[tier]?.[0]?.tier_label_es || byTier[tier]?.[0]?.tier_label_en || ""}
      </p>
      <ul class="border-t-2 border-ink">
        {byTier[tier]?.map((svc: any) => (
          <li class="service-card grid gap-4 border-b border-rule py-8 lg:grid-cols-12 lg:gap-8 lg:py-10">
            <h3 class="h-card lg:col-span-4">
              <a href={`${isEn ? "/en" : ""}/pricing/${svc.id}/`} class="link-hl">{isEn ? svc.name_en : svc.name_es}</a>
            </h3>
            <div class="lg:col-span-4">
              <p class="text-[1.05rem] leading-relaxed text-graphite">{isEn ? svc.problem_en : svc.problem_es}</p>
              <p class="mt-3 font-semibold leading-snug">{isEn ? svc.benefit_en : svc.benefit_es}</p>
            </div>
            <p class="flex flex-wrap items-baseline gap-x-3 lg:col-span-4 lg:flex-col lg:items-end lg:text-right">
              <span class="price-figure text-[1.9rem]">€{isEn ? svc.pricing_en.initial : svc.pricing_es.initial}</span>
              <span class="meta">+ €{isEn ? svc.pricing_en.monthly : svc.pricing_es.monthly}{isEn ? "/month" : "/mes"}</span>
            </p>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>

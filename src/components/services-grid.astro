---
// Services grid component - displays 3 service tiers
import { services as serviceEsData } from "@/data/services-es";
import { services as serviceEnData } from "@/data/services-en";

interface Props {
  isEn: boolean;
}

const { isEn } = Astro.props;
const services = isEn ? serviceEnData : serviceEsData;

// Group by tier
const byTier = services.reduce(
  (acc, svc) => {
    if (!acc[svc.tier]) acc[svc.tier] = [];
    acc[svc.tier].push(svc);
    return acc;
  },
  {} as Record<string, typeof services>
);

const tierOrder = ["web", "app", "optimization"];
---

<div class="services-tiers mt-10 grid gap-8 sm:mt-14 lg:grid-cols-3">
  {tierOrder.map((tier) => (
    <div class="tier-group border-l-2 border-brand pl-6">
      <p class="label uppercase tracking-wider">
        {byTier[tier]?.[0]?.tier_label_es || byTier[tier]?.[0]?.tier_label_en || ""}
      </p>
      <div class="mt-5 space-y-6">
        {byTier[tier]?.map((svc) => (
          <div class="service-card">
            <h3 class="font-display text-lg font-bold">
              {isEn ? svc.name_en : svc.name_es}
            </h3>
            <p class="muted mt-2 text-sm">
              {isEn ? svc.problem_en : svc.problem_es}
            </p>
            <p class="mt-3 font-semibold text-brand">
              {isEn ? svc.benefit_en : svc.benefit_es}
            </p>
            <div class="mt-4 flex items-baseline gap-1 text-sm">
              <span class="text-2xl font-bold">€{svc.pricing_es.initial}</span>
              <span class="muted">+ €{svc.pricing_es.monthly}/mes</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  ))}
</div>

<style>
  .label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: rgb(255 255 255 / 0.6);
  }

  .muted {
    color: rgb(255 255 255 / 0.7);
  }
</style>

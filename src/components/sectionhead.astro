---
const { align = "center" } = Astro.props;
---

<div class:list={["mt-10 sm:mt-16 mb-8 sm:mb-12", align === "center" ? "text-center mx-auto max-w-3xl" : "max-w-3xl"]}>
  <h1 class="text-3xl sm:text-4xl lg:text-5xl font-light tracking-tight text-slate-950">
    <slot name="title">Title</slot>
  </h1>
  <p class="text-sm sm:text-base mt-4 text-slate-600 font-light leading-relaxed">
    <slot name="desc">Some description goes here</slot>
  </p>
</div>

---
const { align = "center" } = Astro.props;
---

<div class:list={["mt-10 sm:mt-16", align === "center" && "text-center"]}>
  <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight">
    <slot name="title">Title</slot>
  </h1>
  <p class="text-base sm:text-lg mt-3 sm:mt-4 text-slate-600 leading-7">
    <slot name="desc">Some description goes here</slot>
  </p>
</div>

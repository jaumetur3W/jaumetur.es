---
import { Icon } from "astro-icon/components";
import { localizePath } from "@/i18n";

export interface Props {
  isEn?: boolean;
}

const { isEn = false } = Astro.props;
const href = (path: string) => localizePath(path, isEn ? "en" : "es");

interface ExampleItem {
  name: string;
  href: string;
  description: string;
}

interface CapabilityCategory {
  id: string;
  title: string;
  tag: string;
  icon: string;
  shortSummary: string;
  description: string;
  services: string[];
  examples: ExampleItem[];
  extraNote?: string;
  pricingLink: string;
  pricingText: string;
}

const categories: CapabilityCategory[] = [
  {
    id: "webs",
    title: "Webs",
    tag: isEn ? "Web Development" : "Desarrollo web",
    icon: "bx:globe",
    shortSummary: isEn
      ? "Corporate websites, landing pages, and web catalogs designed for speed, clarity, and search visibility."
      : "Páginas web corporativas, landing pages y catálogos diseñados para cargar rápido y posicionar bien.",
    description: isEn
      ? "Design and development of modern, fast websites tailored to each business or project, built with clean architecture, strict SEO, and extreme performance."
      : "Diseño y desarrollo de páginas web modernas, rápidas y adaptadas a cada negocio o proyecto, con arquitectura limpia, SEO estricto y rendimiento extremo.",
    services: isEn
      ? [
          "Corporate and personal websites.",
          "High-converting landing pages.",
          "Online stores and e-commerce.",
          "Custom product catalogs and tailored websites.",
          "Optimization, performance (60 FPS), and local/global SEO.",
        ]
      : [
          "Webs corporativas y personales.",
          "Landing pages optimizadas.",
          "Tiendas online y comercio electrónico.",
          "Catálogos y webs personalizadas.",
          "Optimización, rendimiento (60 FPS) y SEO.",
        ],
    examples: [
      {
        name: "Pizzería Xàtiva",
        href: href("/projectes/pizzeria-xativa"),
        description: isEn
          ? "Corporate web with interactive digital menu, 100/100 Lighthouse performance, and local SEO dominance."
          : "Web corporativa con carta digital interactiva, 100/100 en Lighthouse y posicionamiento SEO local.",
      },
      {
        name: "Burger Xàtiva",
        href: href("/projectes/burger-xativa"),
        description: isEn
          ? "Fast-food digital menu and website optimized for mobile speed, clarity, and user conversion."
          : "Web y carta digital para restaurante de comida rápida, optimizada para móviles y conversión.",
      },
    ],
    pricingLink: href("/pricing/landing-page"),
    pricingText: isEn ? "View web development packages" : "Ver tarifas y opciones de webs",
  },
  {
    id: "apps",
    title: isEn ? "Applications" : "Aplicaciones",
    tag: isEn ? "Custom Software" : "Software a medida",
    icon: "bx:layer",
    shortSummary: isEn
      ? "Web applications, internal portals, and custom platforms to manage data and streamline business operations."
      : "Aplicaciones web, plataformas de gestión y herramientas internas para resolver necesidades reales.",
    description: isEn
      ? "Development of custom web applications to solve concrete business needs, streamline internal workflows, and build scalable backends."
      : "Desarrollo de aplicaciones web a medida para resolver necesidades concretas, agilizar procesos internos y crear herramientas robustas y escalables.",
    services: isEn
      ? [
          "Custom web applications.",
          "Internal business management tools.",
          "Control panels and analytics dashboards.",
          "API and database integrations.",
          "Solid frontend and backend architectures.",
        ]
      : [
          "Aplicaciones web a medida.",
          "Herramientas de gestión interna.",
          "Paneles de control y dashboards.",
          "Integración con APIs y bases de datos.",
          "Arquitecturas frontend y backend sólidas.",
        ],
    examples: [
      {
        name: "AVISA",
        href: href("/projectes/avisa"),
        description: isEn
          ? "Urban incident reporting platform with Angular Standalone, Signals, and reactive UI architecture."
          : "Plataforma de reporte y gestión de incidencias con Angular Standalone, Signals y arquitectura reactiva.",
      },
    ],
    pricingLink: href("/pricing/angular-webapp"),
    pricingText: isEn ? "View application development options" : "Ver opciones de desarrollo de apps",
  },
  {
    id: "automation",
    title: isEn ? "Automation" : "Automatización",
    tag: isEn ? "Processes & CI/CD" : "Procesos y CI/CD",
    icon: "bx:git-branch",
    shortSummary: isEn
      ? "Automated tasks, continuous deployment, and platform integrations to eliminate manual work."
      : "Automatización de tareas, despliegue continuo e integraciones para eliminar trabajo repetitivo.",
    description: isEn
      ? "Task and process automation to save time, eliminate repetitive manual errors, connect different platforms, and deploy with confidence."
      : "Automatización de tareas y procesos para ahorrar tiempo, eliminar errores repetitivos, conectar diferentes plataformas y desplegar con total fiabilidad.",
    services: isEn
      ? [
          "Repetitive task automation.",
          "Integration between platforms and services.",
          "CI/CD pipelines and continuous deployment.",
          "Maintenance scripts and data synchronization.",
          "Automated alerts and notifications.",
        ]
      : [
          "Automatización de tareas repetitivas.",
          "Integración entre diferentes plataformas y servicios.",
          "Pipelines de CI/CD y despliegue continuo.",
          "Scripts de mantenimiento y sincronización de datos.",
          "Notificaciones y alertas automáticas.",
        ],
    examples: [
      {
        name: isEn ? "CI/CD Pipeline with GitHub Actions" : "Pipeline CI/CD con GitHub Actions",
        href: href("/projectes/pipeline-cicd"),
        description: isEn
          ? "Automated code quality gates, strict testing, and zero-downtime deployment workflows."
          : "Cadena de verificación de código, testing estricto y despliegues automáticos sin caídas.",
      },
    ],
    extraNote: isEn
      ? "Scheduled scripts, automated database backups, webhook integrations, and hands-free production deployments."
      : "Scripts periódicos automatizados, copias de seguridad de datos, integración vía webhooks y despliegues sin intervención manual.",
    pricingLink: href("/pricing/cicd-devops"),
    pricingText: isEn ? "View automation and CI/CD rates" : "Ver tarifas de automatización y CI/CD",
  },
];
---

<!-- Sección «Qué puedo desarrollar» -->
<section
  id="desenvolupament"
  class="scroll-mt-24 py-16 sm:py-24 lg:py-28 relative"
  aria-labelledby="capabilities-title"
>
  <div class="mb-12 sm:mb-16 max-w-2xl">
    <p class="mb-3 text-xs font-mono uppercase tracking-[0.16em] text-slate-600 font-semibold">
      {isEn ? "Capabilities & Solutions" : "Capacidades y soluciones"}
    </p>
    <h2
      id="capabilities-title"
      class="text-3xl sm:text-4xl lg:text-5xl font-light tracking-tight text-slate-950"
    >
      {isEn ? "What I can build." : "Qué puedo desarrollar."}
    </h2>
    <p class="mt-4 text-sm sm:text-base text-slate-600 font-light leading-relaxed">
      {isEn
        ? "Explore each area to discover practical solutions, technologies, and real case studies."
        : "Descubre las áreas en las que puedo ayudarte, con ejemplos reales y soluciones adaptadas a cada necesidad."}
    </p>
  </div>

  <!-- Cuadrícula de 3 Tarjetas con Vuelta 3D (Flip Card) Interactiva -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch relative">
    {categories.map((cat) => (
      <article
        class="cap-card-wrapper relative h-[470px] sm:h-[490px] w-full"
        data-cap-id={cat.id}
      >
        <!-- Tarjeta con rotación 3D en su sitio -->
        <div
          id={`card-${cat.id}`}
          data-cap-id={cat.id}
          class="cap-card w-full h-full relative"
        >
          <!-- CARA FRONTAL -->
          <div
            class="cap-card-face cap-card-front w-full h-full text-left p-6 sm:p-7 rounded-2xl border border-slate-200/90 bg-white hover:border-slate-950/40 shadow-2xs hover:shadow-md transition-[border-color,box-shadow] duration-200 flex flex-col justify-between"
          >
            <div>
              <!-- Indicador superior: Icono y etiqueta -->
              <div class="flex items-center justify-between mb-5">
                <div
                  class="w-11 h-11 rounded-xl bg-slate-100 border border-slate-200/80 flex items-center justify-center shrink-0"
                  aria-hidden="true"
                >
                  <Icon name={cat.icon} class="w-5 h-5 text-slate-900" />
                </div>

                <span class="text-[11px] font-mono uppercase tracking-wider text-slate-600 font-semibold">
                  {cat.tag}
                </span>
              </div>

              <!-- Título de Categoría -->
              <h3 class="text-2xl font-light text-slate-950 tracking-tight mb-2.5">
                {cat.title}
              </h3>

              <!-- Descripción breve del cuadro -->
              <p class="text-xs sm:text-sm text-slate-600 font-light leading-relaxed mb-6">
                {cat.shortSummary}
              </p>
            </div>

            <!-- Botón "Más información": Único activador para dar la vuelta a la tarjeta -->
            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <button
                type="button"
                class="cap-more-btn group/btn inline-flex items-center gap-2 font-mono text-xs font-semibold py-2 px-3.5 -ml-1 rounded-xl bg-slate-100 hover:bg-[#FFFF00] text-slate-900 border border-slate-200 hover:border-slate-950 transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00] cursor-pointer"
                aria-label={isEn ? `More information about ${cat.title}` : `Más información sobre ${cat.title}`}
                data-cat-id={cat.id}
                aria-expanded="false"
                aria-controls={`floating-${cat.id}`}
              >
                <span class="w-1.5 h-1.5 rounded-full bg-slate-950" aria-hidden="true"></span>
                <span>{isEn ? "More information" : "Más información"}</span>
                <span aria-hidden="true" class="cap-indicator-arrow ml-0.5 text-slate-500 group-hover/btn:text-slate-950 group-hover/btn:translate-x-0.5 transition-transform duration-150">
                  →
                </span>
              </button>
              <span class="text-[10px] font-mono text-slate-600 uppercase tracking-wider hidden sm:inline">
                {cat.tag}
              </span>
            </div>
          </div>

          <!-- CARA TRASERA (Más información al dar la vuelta la tarjeta) -->
          <div
            id={`floating-${cat.id}`}
            class="cap-card-face cap-card-back w-full h-full text-left p-5 sm:p-6 rounded-2xl border-2 border-slate-950 bg-white shadow-xl flex flex-col justify-between overflow-hidden"
            aria-hidden="true"
          >
            <!-- Cabecera de la cara trasera -->
            <div class="flex items-center justify-between pb-3 border-b border-slate-100 shrink-0">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[10px] font-mono font-bold uppercase tracking-wider bg-[#FFFF00] text-slate-950 border border-slate-950/20">
                  {cat.tag}
                </span>
                <h4 class="text-base font-bold text-slate-950 tracking-tight">
                  {cat.title}
                </h4>
              </div>
              <button
                type="button"
                class="cap-back-btn w-8 h-8 rounded-full bg-slate-100 hover:bg-[#FFFF00] text-slate-700 hover:text-slate-950 border border-slate-200 hover:border-slate-950 flex items-center justify-center transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00]"
                aria-label={isEn ? `Close details of ${cat.title}` : `Cerrar detalles de ${cat.title}`}
                data-cat-id={cat.id}
                tabindex="-1"
              >
                <Icon name="bx:x" class="w-4 h-4 text-slate-900" />
              </button>
            </div>

            <!-- Contenido scrollable contenido (sin aumentar la altura de la tarjeta) -->
            <div class="flex-1 overflow-y-auto py-3 space-y-3 pr-1 text-xs text-slate-700">
              <!-- Soluciones incluidas -->
              <div>
                <p class="font-mono text-[10px] uppercase tracking-wider text-slate-600 font-bold mb-1.5">
                  {isEn ? "Solutions included:" : "Soluciones incluidas:"}
                </p>
                <ul class="space-y-1">
                  {cat.services.map((svc) => (
                    <li class="flex items-start gap-1.5 text-[11px] leading-snug text-slate-800">
                      <span class="text-slate-950 font-bold shrink-0" aria-hidden="true">✓</span>
                      <span>{svc}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Casos reales -->
              {cat.examples && cat.examples.length > 0 && (
                <div class="pt-2 border-t border-slate-100">
                  <p class="font-mono text-[10px] uppercase tracking-wider text-slate-600 font-bold mb-1.5">
                    {isEn ? "Projects & demos:" : "Proyectos y demos:"}
                  </p>
                  <div class="space-y-1.5">
                    {cat.examples.map((ex) => (
                      <a
                        href={ex.href}
                        tabindex="-1"
                        class="block p-2 rounded-lg bg-slate-50 hover:bg-[#FFFF00]/20 border border-slate-200/80 hover:border-slate-950/40 transition-colors group/ex focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00]"
                      >
                        <div class="flex items-center justify-between">
                          <span class="font-semibold text-xs text-slate-950 group-hover/ex:underline">
                            {ex.name}
                          </span>
                          <span class="text-[10px] font-mono text-slate-600 flex items-center gap-0.5">
                            <span>{isEn ? "View" : "Ver"}</span>
                            <span aria-hidden="true">→</span>
                          </span>
                        </div>
                        <p class="text-[10px] text-slate-600 line-clamp-1 mt-0.5 font-light">
                          {ex.description}
                        </p>
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>

            <!-- Pie con enlace a precios -->
            <div class="pt-3 border-t border-slate-100 flex items-center justify-between shrink-0">
              <a
                href={cat.pricingLink}
                tabindex="-1"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-950 hover:bg-[#FFFF00] text-white hover:text-slate-950 font-mono text-[11px] font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00]"
              >
                <span>{cat.pricingText}</span>
                <span aria-hidden="true">→</span>
              </a>
              <button
                type="button"
                tabindex="-1"
                class="cap-back-text-btn text-[11px] font-mono text-slate-600 hover:text-slate-950 underline underline-offset-4 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00] rounded"
                data-cat-id={cat.id}
              >
                {isEn ? "Back" : "Volver"}
              </button>
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<!-- Script de Interacción: Vuelta de tarjeta 3D por clic exclusivo, sin activación por hover -->
<script is:inline>
  (function () {
    function initFlipCapabilities() {
      const section = document.getElementById("desenvolupament");
      if (!section) return;

      const cards = Array.from(section.querySelectorAll(".cap-card"));
      let activeCardId = null;

      function flipCard(id) {
        if (activeCardId === id) {
          unflipAll();
          return;
        }

        unflipAll();

        const card = document.getElementById(`card-${id}`);
        const moreBtn = section.querySelector(`.cap-more-btn[data-cat-id="${id}"]`);
        const backPane = document.getElementById(`floating-${id}`);
        const frontPane = card ? card.querySelector(".cap-card-front") : null;

        if (card) {
          card.classList.add("is-flipped");
          activeCardId = id;
        }
        if (moreBtn) {
          moreBtn.setAttribute("aria-expanded", "true");
        }
        if (frontPane) {
          frontPane.querySelectorAll("button, a").forEach((el) => {
            el.setAttribute("tabindex", "-1");
          });
        }
        if (backPane) {
          backPane.setAttribute("aria-hidden", "false");
          backPane.querySelectorAll("button, a").forEach((el) => {
            el.setAttribute("tabindex", "0");
          });
          const firstFocusable = backPane.querySelector("button, a");
          if (firstFocusable && typeof firstFocusable.focus === "function") {
            setTimeout(() => firstFocusable.focus(), 150);
          }
        }
      }

      function unflipAll() {
        cards.forEach((card) => {
          card.classList.remove("is-flipped");
          const frontPane = card.querySelector(".cap-card-front");
          if (frontPane) {
            frontPane.querySelectorAll("button, a").forEach((el) => {
              el.setAttribute("tabindex", "0");
            });
          }
        });
        section.querySelectorAll(".cap-more-btn").forEach((btn) => {
          btn.setAttribute("aria-expanded", "false");
        });
        section.querySelectorAll(".cap-card-back").forEach((pane) => {
          pane.setAttribute("aria-hidden", "true");
          pane.querySelectorAll("button, a").forEach((el) => {
            el.setAttribute("tabindex", "-1");
          });
        });

        if (activeCardId) {
          const prevBtn = section.querySelector(`.cap-more-btn[data-cat-id="${activeCardId}"]`);
          if (prevBtn && typeof prevBtn.focus === "function") {
            prevBtn.focus();
          }
          activeCardId = null;
        }
      }

      // Eventos de clic exclusivo en botón "Más información"
      section.querySelectorAll(".cap-more-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const id = btn.dataset.catId;
          flipCard(id);
        });
      });

      // Botones de cierre en la cara trasera (botón X y texto "Volver")
      section.querySelectorAll(".cap-back-btn, .cap-back-text-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          unflipAll();
        });
      });

      // Tecla Escape para des-voltear
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && activeCardId) {
          e.preventDefault();
          unflipAll();
        }
      });

      // Clic fuera para des-voltear
      document.addEventListener("click", (e) => {
        if (!activeCardId) return;
        const activeCard = document.getElementById(`card-${activeCardId}`);
        if (activeCard && !activeCard.contains(e.target)) {
          unflipAll();
        }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initFlipCapabilities);
    } else {
      initFlipCapabilities();
    }
  })();
</script>

<style>
  .cap-card-wrapper {
    perspective: 1200px;
  }

  .cap-card {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1), width 0.3s ease, margin 0.3s ease;
  }

  .cap-card-face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 1rem;
  }

  .cap-card-front {
    z-index: 2;
    transform: rotateY(0deg);
  }

  .cap-card:not(.is-flipped) .cap-card-back {
    visibility: hidden;
    pointer-events: none;
  }

  .cap-card-back {
    transform: rotateY(180deg);
    z-index: 1;
  }

  /* Estado al darse la vuelta la tarjeta */
  .cap-card.is-flipped {
    transform: rotateY(180deg);
    z-index: 30;
  }

  .cap-card.is-flipped .cap-card-front {
    visibility: hidden;
    pointer-events: none;
  }

  .cap-card.is-flipped .cap-card-back {
    visibility: visible;
    pointer-events: auto;
  }

  /* "se hace mas ancha si es necesario pero no mas alta":
     En escritorio la tarjeta se expande en anchura para mayor legibilidad
     manteniendo la misma altura exacta */
  @media (min-width: 768px) {
    .cap-card.is-flipped {
      width: calc(100% + 2rem);
      margin-left: -1rem;
    }
  }
  @media (min-width: 1024px) {
    .cap-card.is-flipped {
      width: calc(100% + 3.5rem);
      margin-left: -1.75rem;
    }
  }

  /* Scrollbar estético sutil para el contenido trasero */
  .cap-card-back .overflow-y-auto {
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    .cap-card,
    .cap-card.is-flipped {
      transition: none !important;
      animation: none !important;
    }
    .cap-card.is-flipped .cap-card-front {
      opacity: 0 !important;
      pointer-events: none !important;
    }
    .cap-card.is-flipped .cap-card-back {
      transform: none !important;
      z-index: 10 !important;
    }
  }
</style>

---
interface Props {
  /** Alto del logo en píxeles (el ancho sale de la proporción del muñeco). */
  size?: number;
  class?: string;
}

const { size = 40, class: className = "" } = Astro.props;
// El archivo mide 503×629 px; se mantiene la proporción para evitar saltos de maquetación.
const width = Math.round((size * 503) / 629);
---

<!-- Logo: el muñeco de la marca sosteniendo la J -->
<img
  src="/img/mascot/brand-j-transparent.webp"
  alt=""
  width={width}
  height={size}
  decoding="async"
  class:list={["shrink-0 select-none object-contain", className]}
  aria-hidden="true"
/>

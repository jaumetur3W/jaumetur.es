---
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className = "" } = Astro.props;
---

<!-- Monograma Isotipo Geométrico JT — Sistema Editorial Suave -->
<svg
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class:list={["shrink-0 select-none", className]}
  aria-hidden="true"
>
  <!-- Contenedor squircle con borde nítido de tinta -->
  <rect
    x="1.5"
    y="1.5"
    width="37"
    height="37"
    rx="10"
    fill="currentColor"
    class="text-ink"
  />
  
  <!-- Estructura geométrica JT en trazo continuo -->
  <!-- Barra superior horizontal de la T -->
  <path
    d="M10 12.5H30"
    stroke="var(--color-paper, #FBFBFC)"
    stroke-width="3"
    stroke-linecap="round"
  />
  
  <!-- Asta vertical y curva de la J -->
  <path
    d="M20 12.5V23.5C20 26.5 17.5 28.5 14.5 28.5C12 28.5 10 27 10 25"
    stroke="var(--color-paper, #FBFBFC)"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
  />

  <!-- Nodo de código / terminal acento (Cobalto corporativo) -->
  <circle
    cx="27.5"
    cy="23.5"
    r="3"
    fill="var(--color-brand, #2563EB)"
  />
</svg>

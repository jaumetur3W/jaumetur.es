---
import { pricingTiers as pricingTiersES } from "@/data/pricing-es";
import { pricingTiers as pricingTiersEN } from "@/data/pricing-en";
import { services as servicesES } from "@/data/services-es";
import { services as servicesEN } from "@/data/services-en";

interface Props {
  isEn?: boolean;
}

const { isEn = false } = Astro.props;
const pricingTiers = isEn ? pricingTiersEN : pricingTiersES;
const services = isEn ? servicesEN : servicesES;

const serviceNameMap: Record<string, string> = {};
services.forEach(s => {
  serviceNameMap[s.id] = isEn ? s.name_en : s.name_es;
});

const t = isEn ? {
  title: "Transparent and Clear Pricing",
  service: "Service",
  creation: "Creation",
  maintenance: "Maintenance",
  includes: "Includes",
  action: "Request",
  maintenanceTermsTitle: "Maintenance Terms",
  maintenanceTermsInclude: "Includes",
  maintenanceTermsIncludeList: [
    "Security updates",
    "Automatic backups",
    "24/7 monitoring",
    "Email support"
  ],
  minDuration: "Minimum Duration",
  minDurationValue: "12 months",
  responseTime: "Response Time",
  responseTimeValue: "Less than 24 business hours"
} : {
  title: "Precios Transparentes y Claros",
  service: "Servicio",
  creation: "Creación",
  maintenance: "Mantenimiento",
  includes: "Incluye",
  action: "Solicitar",
  maintenanceTermsTitle: "Términos de Mantenimiento",
  maintenanceTermsInclude: "Incluye",
  maintenanceTermsIncludeList: [
    "Actualizaciones de seguridad",
    "Backups automáticos",
    "Monitoreo 24/7",
    "Soporte por email"
  ],
  minDuration: "Duración mínima",
  minDurationValue: "12 meses",
  responseTime: "Tiempo de respuesta",
  responseTimeValue: "Menos de 24 horas laborables"
};
---

<section class="pricing-section">
  <div class="pricing-head">
    <span class="sticker sticker-ink stick-in" style="--rot:-3deg">{isEn ? "No hidden fees" : "Sin letra pequeña"}</span>
    <h2>{t.title}</h2>
  </div>

  <div class="pricing-table-wrapper">
    <table class="pricing-table">
      <thead>
        <tr>
          <th scope="col">{t.service}</th>
          <th scope="col">{t.creation}</th>
          <th scope="col">{t.maintenance}</th>
          <th scope="col">{t.includes}</th>
          <th scope="col">{t.action}</th>
        </tr>
      </thead>
      <tbody>
        {pricingTiers.map((tier: any) => {
          const initialLabel = isEn ? tier.initial_label_en : tier.initial_label_es;
          const monthlyLabel = isEn ? tier.monthly_label_en : tier.monthly_label_es;
          const includesList = isEn ? tier.includes_en : tier.includes_es;
          return (
            <tr>
              <td class="service-name">
                <strong>{serviceNameMap[tier.service_id] || tier.service_id}</strong>
              </td>
              <td class="pricing">
                <span class="amount num">{isEn ? `€${tier.initial_cost}` : `${tier.initial_cost} €`}</span>
                <span class="sub">{initialLabel}</span>
              </td>
              <td class="pricing">
                <span class="amount num">{isEn ? `€${tier.monthly_cost}` : `${tier.monthly_cost} €`}</span>
                <span class="sub">{monthlyLabel} / {isEn ? 'month' : 'mes'}</span>
              </td>
              <td class="includes">
                <ul>
                  {includesList.map((inc: string) => (
                    <li>{inc}</li>
                  ))}
                </ul>
              </td>
              <td class="action">
                <a href={`${isEn ? "/en" : ""}/contact/?servei=${tier.service_id}`} class="btn btn-ink btn-sm">
                  {t.action}
                </a>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <section class="maintenance-terms">
    <h3>{t.maintenanceTermsTitle}</h3>
    <div class="terms-grid">
      <div class="term">
        <h4>{t.maintenanceTermsInclude}</h4>
        <ul>
          {t.maintenanceTermsIncludeList.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
      <div class="term">
        <h4>{t.minDuration}</h4>
        <p>{t.minDurationValue}</p>
      </div>
      <div class="term">
        <h4>{t.responseTime}</h4>
        <p>{t.responseTimeValue}</p>
      </div>
    </div>
  </section>
</section>

<style>
  .pricing-section { padding: 0; }
  .pricing-head { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-bottom: 2rem; }
  .pricing-section h2 {
    font-size: clamp(2rem, 4.5vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin: 0;
  }

  .pricing-table-wrapper {
    overflow-x: auto;
    margin-bottom: 3rem;
    border: 3px solid var(--ink);
    border-radius: 1.25rem;
    background: var(--paper);
    box-shadow: var(--hard-lg);
  }

  .pricing-table { width: 100%; border-collapse: collapse; font-size: 0.98rem; }

  .pricing-table thead { background: var(--brand); border-bottom: 3px solid var(--ink); }
  .pricing-table th {
    padding: 1rem 1.25rem;
    text-align: left;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .pricing-table tbody tr { border-bottom: 2px solid var(--ink); transition: background-color 0.2s; }
  .pricing-table tbody tr:last-child { border-bottom: 0; }
  .pricing-table tbody tr:hover { background: var(--paper-2); }
  .pricing-table td { padding: 1.5rem 1.25rem; vertical-align: middle; }

  .service-name { min-width: 180px; font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; letter-spacing: -0.02em; }

  .pricing { text-align: right; min-width: 130px; white-space: nowrap; }
  .pricing .amount {
    display: block;
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .pricing .sub { display: block; font-family: var(--font-mono); font-size: 0.75rem; color: var(--graphite); margin-top: 0.4rem; }

  .includes { min-width: 250px; }
  .includes ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.92rem; color: var(--graphite); }
  .includes li { display: flex; gap: 0.6rem; align-items: baseline; }
  .includes li::before {
    content: "";
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    background: var(--brand);
    border: 2px solid var(--ink);
    border-radius: 2px;
    translate: 0 0.05rem;
  }

  .action { text-align: center; min-width: 120px; }

  .maintenance-terms {
    background: var(--brand);
    border: 3px solid var(--ink);
    border-radius: 1.25rem;
    padding: 2rem;
    box-shadow: var(--hard);
    rotate: -0.6deg;
  }
  .maintenance-terms h3 { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 1.5rem; }
  .terms-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; }
  .term h4 { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 0.75rem; color: var(--ink); }
  .term ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.95rem; }
  .term ul li::before { content: "— "; }
  .term p { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; }

  @media (max-width: 768px) {
    .pricing-table { font-size: 0.85rem; }
    .pricing-table th, .pricing-table td { padding: 0.85rem 0.75rem; }
    .includes { min-width: 180px; }
    .includes ul { font-size: 0.82rem; }
    .pricing .amount { font-size: 1.35rem; }
  }
</style>

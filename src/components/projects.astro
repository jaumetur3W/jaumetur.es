---
import { Icon } from "astro-icon/components";

const projects = [
  {
    id: "avisa",
    title: "AVISA — Gestió d'Incidències",
    badge: "Web App · En Producció",
    badgeColor: "bg-indigo-600 text-white",
    cardTheme: "from-indigo-50/70 via-white to-purple-50/30 border-indigo-200/70 hover:border-indigo-400 hover:shadow-indigo-500/10",
    summary: "Plataforma per al registre, comunicació i seguiment d'incidències en temps real amb interfície accessible.",
    highlights: [
      { icon: "bx:bxs-check-circle", text: "Arquitectura reactiva amb Angular & TypeScript", color: "text-indigo-600" },
      { icon: "bx:bxs-check-circle", text: "Integració completa amb REST API i dades JSON", color: "text-indigo-600" },
      { icon: "bx:bxs-check-circle", text: "Desplegament continu automatitzat a GitHub Pages", color: "text-indigo-600" },
    ],
    tags: ["Angular", "TypeScript", "REST API", "WCAG AA", "UX/UI"],
    stat: "EN PRODUCCIÓ",
    statColor: "text-emerald-700 bg-emerald-100/80 border-emerald-300",
    liveUrl: "https://jautur.github.io/AVISA-objectiu/",
    githubUrl: "https://github.com/jautur/FRONT-PROJECT-JJAUX",
  },
  {
    id: "margherita",
    title: "La Margherita — Pizzeria a Xàtiva",
    badge: "Landing Page · En Producció",
    badgeColor: "bg-rose-600 text-white",
    cardTheme: "from-rose-50/70 via-white to-amber-50/30 border-rose-200/70 hover:border-rose-400 hover:shadow-rose-500/10",
    summary: "Landing page comercial per a pizzeria artesanal amb carta interactiva, SEO local i comandes per WhatsApp.",
    highlights: [
      { icon: "bx:bxs-check-circle", text: "Disseny modern, fluid i responsive amb Tailwind CSS", color: "text-rose-600" },
      { icon: "bx:bxs-check-circle", text: "Canal directe de comandes integrat amb WhatsApp", color: "text-rose-600" },
      { icon: "bx:bxs-check-circle", text: "Optimització de SEO local (Geo tags Xàtiva/Costera)", color: "text-rose-600" },
    ],
    tags: ["Tailwind CSS", "HTML5 Semàntic", "SEO Local", "UX/UI", "WhatsApp API"],
    stat: "EN PRODUCCIÓ",
    statColor: "text-rose-700 bg-rose-100/80 border-rose-300",
    liveUrl: "https://jautur.github.io/margherita_xativa/",
    githubUrl: "https://github.com/jautur/margherita_xativa",
  },
  {
    id: "telemetry",
    title: "Dashboard de Telemetria",
    badge: "Frontend UI & Mètriques",
    badgeColor: "bg-emerald-600 text-white",
    cardTheme: "from-emerald-50/70 via-white to-teal-50/30 border-emerald-200/70 hover:border-emerald-400 hover:shadow-emerald-500/10",
    summary: "Panell analític interactiu per a visualitzar mètriques de rendiment web a màxima velocitat.",
    highlights: [
      { icon: "bx:bxs-check-circle", text: "Renderitzat fluid garantit a 60 FPS", color: "text-emerald-600" },
      { icon: "bx:bxs-check-circle", text: "Estructura modular de components desacoblats", color: "text-emerald-600" },
      { icon: "bx:bxs-check-circle", text: "Optimització de cicle de vida i Core Web Vitals", color: "text-emerald-600" },
    ],
    tags: ["JavaScript ES6+", "TypeScript", "Performance", "Core Web Vitals"],
    stat: "60 FPS FLUID",
    statColor: "text-indigo-700 bg-indigo-100/80 border-indigo-300",
    liveUrl: "https://jautur.github.io/portfolio/#skills",
    githubUrl: "https://github.com/jautur/portfolio",
  },
  {
    id: "pipeline",
    title: "Pipeline CI/CD Automatitzat",
    badge: "DevOps & Automatització",
    badgeColor: "bg-sky-600 text-white",
    cardTheme: "from-sky-50/70 via-white to-blue-50/30 border-sky-200/70 hover:border-sky-400 hover:shadow-sky-500/10",
    summary: "Flux d'integració contínua que valida estàndards de qualitat i publica versions automàticament.",
    highlights: [
      { icon: "bx:bxs-check-circle", text: "Execució automàtica per esdeveniment (Git Push)", color: "text-sky-600" },
      { icon: "bx:bxs-check-circle", text: "Validació amb linters i anàlisi estàtica de codi", color: "text-sky-600" },
      { icon: "bx:bxs-check-circle", text: "Publicació continuada sense interrupcions", color: "text-sky-600" },
    ],
    tags: ["GitHub Actions", "CI/CD", "Linters", "Linux Shell"],
    stat: "ZERO DOWNTIME",
    statColor: "text-sky-700 bg-sky-100/80 border-sky-300",
    liveUrl: "https://github.com/jautur/portfolio/actions",
    githubUrl: "https://github.com/jautur/portfolio",
  },
];
---

<section id="projectes" class="pt-20 pb-10 scroll-mt-12">
  
  <!-- Header with Memoji (7.png coding on laptop) -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-10">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200/80 mb-3 shadow-2xs">
        <Icon name="bx:bxs-rocket" class="w-3.5 h-3.5 text-indigo-600" />
        <span>Projectes en producció</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
        Codi real, <span class="bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">resultats mesurables</span>
      </h2>
    </div>

    <!-- Guiding thread Memoji: 7.png (Much larger, breaking out and overlapping) -->
    <div class="relative group self-center sm:self-auto -mb-6 sm:-mb-10 z-20">
      <div class="absolute inset-0 bg-gradient-to-tr from-indigo-500/25 via-purple-500/20 to-pink-500/20 rounded-full blur-xl group-hover:scale-110 transition-transform"></div>
      
      <div class="relative flex items-center gap-3 bg-gradient-to-r from-indigo-50/90 via-purple-50/90 to-pink-50/90 border border-indigo-200/80 rounded-3xl p-3 pr-5 shadow-lg group-hover:-translate-y-1 transition-transform">
        <div class="relative w-24 h-24 sm:w-32 sm:h-32 -my-6 sm:-my-8 -ml-3 flex items-center justify-center">
          <img
            src="/memojis/7.png"
            alt="Jaume programant al portàtil"
            class="w-full h-full object-contain drop-shadow-[0_12px_20px_rgba(0,0,0,0.18)] group-hover:scale-110 transition-transform"
            width="128"
            height="128"
          />
        </div>
        <div class="text-xs">
          <span class="font-extrabold text-slate-900 block text-sm">Desenvolupament Actiu</span>
          <span class="text-indigo-600 font-mono text-[11px] font-bold">Angular · TS · CI/CD</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Projects Grid (Balanced 2x2 layout for 4 projects) -->
  <div class="grid md:grid-cols-2 gap-6">
    {
      projects.map((project) => (
        <article class={`bg-gradient-to-b ${project.cardTheme} rounded-3xl border p-6 sm:p-7 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group`}>
          <div>
            <!-- Top pills -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class={`text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-wider font-mono shadow-2xs ${project.badgeColor}`}>
                {project.badge}
              </span>
              <span class={`text-[10px] font-mono font-bold px-2.5 py-0.5 rounded-md border ${project.statColor}`}>
                {project.stat}
              </span>
            </div>

            <h3 class="text-xl sm:text-2xl font-bold text-slate-900 group-hover:text-indigo-600 transition-colors">
              {project.title}
            </h3>

            <p class="text-xs sm:text-sm text-slate-600 mt-2.5 leading-relaxed">
              {project.summary}
            </p>

            <!-- Visual bullet points -->
            <ul class="mt-4 space-y-2 text-xs font-medium text-slate-700 bg-white/70 p-3.5 rounded-2xl border border-slate-200/60">
              {project.highlights.map((h) => (
                <li class="flex items-start gap-2">
                  <Icon name={h.icon} class={`w-4 h-4 shrink-0 mt-0.5 ${h.color}`} />
                  <span>{h.text}</span>
                </li>
              ))}
            </ul>

            <!-- Tech stack tags -->
            <div class="flex flex-wrap gap-1.5 mt-4">
              {project.tags.map((tag) => (
                <span class="text-[10px] font-mono font-semibold px-2.5 py-0.5 rounded-md bg-white text-slate-700 border border-slate-200 shadow-2xs">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Action buttons -->
          <div class="flex items-center gap-3 mt-6 pt-4 border-t border-slate-200/60">
            {project.liveUrl && (
              <a
                href={project.liveUrl}
                target={project.liveUrl.startsWith("http") ? "_blank" : undefined}
                rel={project.liveUrl.startsWith("http") ? "noopener noreferrer" : undefined}
                class="flex-1 inline-flex items-center justify-center gap-1.5 text-xs font-bold px-4 py-2.5 bg-slate-900 text-white rounded-xl hover:bg-indigo-600 transition shadow-xs">
                <span>Veure Demo</span>
                <span class="text-[11px]">↗</span>
              </a>
            )}
            {project.githubUrl && (
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 inline-flex items-center justify-center gap-1.5 text-xs font-bold px-4 py-2.5 bg-white text-slate-800 rounded-xl hover:bg-slate-100 transition border border-slate-300 shadow-2xs"
                title="Veure codi font a GitHub">
                <Icon name="bx:bxl-github" class="w-4 h-4 text-slate-900" />
                <span>Codi</span>
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>

---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { Icon } from "astro-icon/components";
import { localeFromPath, localizePath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const href = (path: string) => localizePath(path, isEn ? "en" : "es");

// Filter blog entries with 'draft: false' & date before current date
const publishedBlogEntries = await getCollection("blog", ({ data }) => {
  return !data.draft && data.publishDate <= new Date() && data.lang === "es";
});

// Sort content entries by publication date (newest first)
publishedBlogEntries.sort(function (a, b) {
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});

// Extract all unique categories
const allCategory = isEn ? "All" : "Todas";
const categories = [allCategory, ...new Set(publishedBlogEntries.map((post) => post.data.category))];

// Category icon helper (Standardized icons)
const getCategoryIcon = (category: string) => {
  const cat = category.toLowerCase();
  if (cat.includes("angular")) return "simple-icons:angular";
  if (cat.includes("rendiment") || cat.includes("performance") || cat.includes("rendimiento")) return "bx:bxs-zap";
  if (cat.includes("ci/cd") || cat.includes("devops")) return "bx:git-repo-forked";
  if (cat.includes("accessibilitat") || cat.includes("accesibilidad") || cat.includes("wcag")) return "bx:accessibility";
  if (cat.includes("typescript")) return "simple-icons:typescript";
  if (cat.includes("carrera") || cat.includes("portfolio")) return "bx:briefcase";
  if (cat.includes("cas d'estudi") || cat.includes("caso") || cat.includes("case study")) return "bx:search-alt";
  return "bx:file-blank";
};
---

<Layout
  title={isEn ? "Web Development Blog & Technical Resources | Jaume Tur" : "Blog de Desarrollo Web y Recursos Técnicos | Jaume Tur"}
  description={isEn ? "Technical articles, practical guides, and architecture insights on frontend apps, performance, and CI/CD." : "Artículos técnicos, guías prácticas y casos de estudio sobre diseño web, aplicaciones frontend, backend, rendimiento y automatización CI/CD."}
>
  <Container>
    <div class="mt-8 mb-4">
      <Sectionhead>
        <Fragment slot="title">{isEn ? "Engineering Blog & Resources" : "Blog y recursos de ingeniería"}</Fragment>
        <Fragment slot="desc">
          {isEn
            ? "Technical guides, frontend architecture patterns, and performance deep dives based on production projects."
            : "Guías técnicas, patrones de arquitectura frontend y análisis de rendimiento basados en proyectos reales."}
        </Fragment>
      </Sectionhead>
    </div>

    <!-- Search & Category Filters -->
    <div class="max-w-5xl mx-auto my-10 space-y-4">
      <!-- Cercador instantani d'articles -->
      <div class="relative max-w-md">
        <label for="blog-search-input" class="sr-only">
          {isEn ? "Search articles by title or content" : "Buscar artículos por título o contenido"}
        </label>
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-600">
          <Icon name="bx:search" class="h-4 w-4" />
        </div>
        <input
          id="blog-search-input"
          type="search"
          placeholder={isEn ? "Search articles (e.g. Astro, SEO, Angular, TypeScript...)" : "Buscar artículos (ej: Astro, SEO, Angular, TypeScript...)"}
          class="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-4 text-xs sm:text-sm text-slate-900 placeholder-slate-500 shadow-2xs outline-none transition focus:border-slate-950 focus:ring-0 font-mono"
        />
      </div>

      <!-- Filtres per Categoria -->
      <div class="flex flex-wrap gap-2 items-center justify-center sm:justify-start pb-6 border-b border-slate-200/90" id="category-filters" role="group" aria-label={isEn ? "Category filters" : "Filtros por categoría"}>
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-category={cat}
            class={`filter-btn px-3.5 py-2 min-h-[44px] rounded-xl text-xs font-mono transition-all border flex items-center gap-1.5 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-950 ${
              idx === 0
                ? "bg-slate-950 text-white border-slate-950 shadow-2xs active"
                : "bg-white text-slate-700 border-slate-200/90 hover:text-slate-950 hover:border-slate-950 shadow-2xs"
            }`}
          >
            <Icon name={cat !== allCategory ? getCategoryIcon(cat) : "bx:layer"} class="w-3.5 h-3.5" />
            <span>{cat}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Articles Grid -->
    <div class="max-w-5xl mx-auto mb-20">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="posts-container">
        {publishedBlogEntries.map((post) => {
          const wordsCount = post.body ? post.body.trim().split(/\s+/).length : 600;
          const readingMinutes = Math.max(1, Math.round(wordsCount / 200));
          const iconName = getCategoryIcon(post.data.category);

          return (
            <article
              class="post-card group flex flex-col justify-between rounded-3xl bg-white border border-slate-200/90 hover:border-slate-950 transition-all duration-300 overflow-hidden shadow-2xs hover:shadow-md"
              data-title={post.data.title.toLowerCase()}
              data-category={post.data.category}
              data-snippet={post.data.snippet.toLowerCase()}
              data-tags={post.data.tags.join(" ").toLowerCase()}
            >
              <div>
                {/* Cover Image */}
                {post.data.image && post.data.image.src && (
                  <a href={href(`/blog/${post.id}/`)} class="block overflow-hidden aspect-[16/9] bg-slate-100 border-b border-slate-100">
                    <img
                      src={post.data.image.src}
                      alt={post.data.image.alt}
                      loading="lazy"
                      decoding="async"
                      width="600"
                      height="338"
                      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-200"
                    />
                  </a>
                )}

                <div class="p-6 sm:p-7">
                  <!-- Category and Reading Time with Standardized Icons -->
                  <div class="flex items-center justify-between gap-2 mb-3">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-[#FFFF00] border border-slate-950/20 text-slate-950">
                      <Icon name={iconName} class="w-3.5 h-3.5" />
                      <span>{post.data.category}</span>
                    </span>
                    <span class="text-[11px] font-mono text-slate-700 bg-slate-100 border border-slate-200 px-2 py-0.5 rounded-full flex items-center gap-1">
                      <Icon name="bx:time" class="w-3.5 h-3.5 text-slate-500" />
                      <span>~{readingMinutes} min</span>
                    </span>
                  </div>

                  <!-- Post Title -->
                  <h2 class="text-xl sm:text-2xl font-light text-slate-950 group-hover:text-black transition-colors leading-snug mb-3 tracking-tight">
                    <a href={href(`/blog/${post.id}/`)}>
                      {post.data.title}
                    </a>
                  </h2>

                  <!-- Snippet -->
                  <p class="text-xs sm:text-sm text-slate-600 font-light line-clamp-3 leading-relaxed mb-4">
                    {post.data.snippet}
                  </p>
                </div>
              </div>

              <!-- Footer with Tags & Date -->
              <div class="px-6 sm:px-7 pb-6 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-mono text-slate-500">
                <time datetime={post.data.publishDate.toISOString()}>
                  {post.data.publishDate.toLocaleDateString(isEn ? "en-US" : "es-ES", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
                <a
                  href={href(`/blog/${post.id}/`)}
                  class="inline-flex items-center gap-1 text-slate-950 hover:underline font-mono text-xs uppercase tracking-wider font-semibold"
                >
                  <span>{isEn ? "Read article" : "Leer artículo"}</span>
                  <span>→</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Missatge sense articles trobats -->
      <div id="no-posts-found" class="hidden py-16 text-center">
        <p class="font-mono text-xs uppercase tracking-wider text-slate-600 font-semibold">
          {isEn ? "No matches" : "Sin coincidencias"}
        </p>
        <p class="mt-2 text-sm text-slate-600 font-light">
          {isEn ? "No articles found matching this search or category." : "No se ha encontrado ningún artículo con esta búsqueda o categoría."}
        </p>
      </div>

      <!-- Lead Magnet Newsletter Box with Standardized Icons -->
      <section class="mt-20 p-8 sm:p-10 rounded-3xl bg-slate-950 text-white border border-slate-900 shadow-xl relative overflow-hidden">
        <div class="max-w-2xl relative z-10">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-[#FFFF00] border border-slate-950/20 text-slate-950 mb-4 shadow-2xs">
            <Icon name="bx:envelope" class="w-3.5 h-3.5" />
            <span>{isEn ? "Technical newsletter: Practical frontend" : "Boletín técnico: Frontend de trinchera"}</span>
          </span>
          <h3 class="text-2xl sm:text-3xl font-light text-white tracking-tight mb-3">
            {isEn ? "Get one technical article a month, zero spam." : "Recibe un artículo técnico al mes, sin spam ni postureo."}
          </h3>
          <p class="text-xs sm:text-sm text-slate-300 font-light mb-6 leading-relaxed">
            {isEn ? "Architecture patterns in Angular, 60 FPS performance optimizations, CI/CD, and real-world audit insights." : "Patrones de arquitectura en Angular, consejos para lograr 60 FPS estables, CI/CD y aprendizajes de auditorías reales."}
          </p>
          <form
            action={href("/contact")}
            method="GET"
            class="flex flex-col sm:flex-row gap-3 max-w-lg"
          >
            <input
              type="email"
              name="email"
              placeholder={isEn ? "your.email@company.com" : "tu.correo@empresa.com"}
              required
              class="px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-xs sm:text-sm text-white placeholder-slate-400 focus:outline-none focus:border-slate-500 flex-1 font-mono"
            />
            <button
              type="submit"
              class="px-5 py-2.5 rounded-xl bg-[#FFFF00] hover:bg-[#f2d900] text-slate-950 font-mono text-xs uppercase tracking-wider font-semibold border border-slate-950 transition-all shadow-2xs whitespace-nowrap cursor-pointer"
            >
              {isEn ? "Subscribe for free" : "Suscribirme gratis"}
            </button>
          </form>
        </div>
      </section>
    </div>
  </Container>

  <!-- Client-side Category Filter & Search Script -->
  <script is:inline>
    (function() {
      const searchInput = document.getElementById("blog-search-input");
      const filterButtons = document.querySelectorAll(".filter-btn");
      const postCards = document.querySelectorAll(".post-card");
      const noResults = document.getElementById("no-posts-found");
      if (!postCards.length) return;

      let currentCategory = "ALL";
      let currentQuery = "";

      function filterPosts() {
        let visibleCount = 0;

        postCards.forEach(function(card) {
          const cardCategory = (card.getAttribute("data-category") || "").toLowerCase();
          const cardTitle = (card.getAttribute("data-title") || "").toLowerCase();
          const cardSnippet = (card.getAttribute("data-snippet") || "").toLowerCase();
          const cardTags = (card.getAttribute("data-tags") || "").toLowerCase();
          const searchable = `${cardTitle} ${cardSnippet} ${cardTags}`;

          const matchesCategory = currentCategory === "ALL" || cardCategory === currentCategory.toLowerCase();
          const matchesQuery = !currentQuery || searchable.includes(currentQuery);

          if (matchesCategory && matchesQuery) {
            card.style.display = "flex";
            visibleCount++;
          } else {
            card.style.display = "none";
          }
        });

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove("hidden");
          } else {
            noResults.classList.add("hidden");
          }
        }
      }

      if (searchInput) {
        searchInput.addEventListener("input", function(e) {
          currentQuery = (e.target.value || "").trim().toLowerCase();
          filterPosts();
        });
      }

      filterButtons.forEach(function(btn) {
        btn.addEventListener("click", function() {
          const rawCat = btn.getAttribute("data-category") || "Todas";
          currentCategory = (rawCat === "Todas" || rawCat === "All") ? "ALL" : rawCat;

          filterButtons.forEach(function(b) {
            const isCurrent = b === btn;
            b.className = isCurrent
              ? "filter-btn px-3.5 py-2 min-h-[44px] rounded-xl text-xs font-mono transition-all border flex items-center gap-1.5 cursor-pointer bg-slate-950 text-white border-slate-950 shadow-2xs active"
              : "filter-btn px-3.5 py-2 min-h-[44px] rounded-xl text-xs font-mono transition-all border flex items-center gap-1.5 cursor-pointer bg-white text-slate-700 border-slate-200/90 hover:text-slate-950 hover:border-slate-950 shadow-2xs";
          });

          filterPosts();
        });
      });
    })();
  </script>
</Layout>

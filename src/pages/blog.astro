---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { Icon } from "astro-icon/components";
import { localeFromPath, localizePath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const href = (path: string) => localizePath(path, isEn ? "en" : "es");

// Filter blog entries with 'draft: false' & date before current date
const publishedBlogEntries = await getCollection("blog", ({ data }) => {
  return !data.draft && data.publishDate <= new Date() && data.lang === "es";
});

// Sort content entries by publication date (newest first)
publishedBlogEntries.sort(function (a, b) {
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});

// Extract all unique categories
const allCategory = isEn ? "All" : "Todas";
const categories = [allCategory, ...new Set(publishedBlogEntries.map((post) => post.data.category))];

// Category icon helper
const getCategoryIcon = (category: string) => {
  const cat = category.toLowerCase();
  if (cat.includes("angular")) return "simple-icons:angular";
  if (cat.includes("rendiment") || cat.includes("performance") || cat.includes("rendimiento")) return "bx:bxs-zap";
  if (cat.includes("ci/cd") || cat.includes("devops")) return "bx:git-repo-forked";
  if (cat.includes("accessibilitat") || cat.includes("accesibilidad") || cat.includes("wcag")) return "bx:accessibility";
  if (cat.includes("typescript")) return "simple-icons:typescript";
  if (cat.includes("carrera") || cat.includes("portfolio")) return "bx:briefcase";
  if (cat.includes("cas d'estudi") || cat.includes("caso") || cat.includes("case study")) return "bx:search-alt";
  return "bx:file-blank";
};
---

<Layout
  title={isEn ? "Web Development Blog & Engineering Resources | Jaume Tur" : "Blog de Desarrollo Web y Recursos Técnicos | Jaume Tur"}
  description={isEn ? "Technical articles, practical guides, and architecture insights on frontend apps, performance, and CI/CD." : "Artículos técnicos, guías prácticas y casos de estudio sobre diseño web, aplicaciones frontend, backend, rendimiento y automatización CI/CD."}
>
  <div class="px-5 py-12 sm:py-16">
    <Container>
      <!-- Header -->
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-brand/40 bg-brand/10 px-3.5 py-1 text-xs font-bold text-brand">
          <Icon name="bx:book-open" class="h-4 w-4" />
          <span>{isEn ? "Technical Engineering Blog" : "Blog Técnico y Recursos de Ingeniería"}</span>
        </span>
        <h1 class="display mt-4 text-3xl sm:text-5xl text-white">
          {isEn ? "Articles, Patterns & Architecture" : "Artículos, Patrones y Arquitectura"}
        </h1>
        <p class="mt-4 text-base sm:text-lg text-zinc-300 leading-relaxed">
          {isEn
            ? "Technical guides, frontend architecture patterns, and performance deep dives based on real production projects."
            : "Guías técnicas, patrones de arquitectura frontend y análisis de rendimiento basados en proyectos reales de producción."}
        </p>
      </div>

      <!-- Search & Category Filters -->
      <div class="max-w-5xl mx-auto my-10 space-y-4">
        <!-- Search Input -->
        <div class="relative max-w-md">
          <label for="blog-search-input" class="sr-only">
            {isEn ? "Search articles by title or content" : "Buscar artículos por título o contenido"}
          </label>
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-zinc-400">
            <Icon name="bx:search" class="h-4 w-4" />
          </div>
          <input
            id="blog-search-input"
            type="search"
            placeholder={isEn ? "Search articles (e.g. Astro, SEO, Angular, TypeScript...)" : "Buscar artículos (ej: Astro, SEO, Angular, TypeScript...)"}
            class="w-full rounded-xl border border-white/10 bg-[#121216] py-2.5 pl-10 pr-4 text-xs sm:text-sm text-white placeholder-zinc-500 shadow-inner outline-none transition focus:border-brand font-mono"
          />
        </div>

        <!-- Category Filters -->
        <div class="flex flex-wrap gap-2 items-center justify-center sm:justify-start pb-6 border-b border-white/10" id="category-filters" role="group" aria-label={isEn ? "Category filters" : "Filtros por categoría"}>
          {categories.map((cat, idx) => (
            <button
              type="button"
              data-category={cat}
              class={`filter-btn px-3.5 py-2 min-h-[44px] rounded-xl text-xs font-mono transition-all border flex items-center gap-1.5 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand ${
                idx === 0
                  ? "bg-[#FFFF00] text-black border-brand font-bold shadow-xs active"
                  : "bg-white/5 text-zinc-300 border-white/10 hover:text-white hover:border-brand/40"
              }`}
            >
              <Icon name={cat !== allCategory ? getCategoryIcon(cat) : "bx:layer"} class="w-3.5 h-3.5" />
              <span>{cat}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Articles Grid -->
      <div class="max-w-5xl mx-auto mb-20">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="posts-container">
          {publishedBlogEntries.map((post) => {
            const wordsCount = post.body ? post.body.trim().split(/\s+/).length : 600;
            const readingMinutes = Math.max(1, Math.round(wordsCount / 200));
            const iconName = getCategoryIcon(post.data.category);

            return (
              <article
                class="post-card surface-card group flex flex-col justify-between rounded-3xl bg-[#121216] border border-white/10 hover:border-brand/40 transition-all duration-300 p-6 sm:p-8"
                data-title={post.data.title.toLowerCase()}
                data-category={post.data.category}
                data-snippet={post.data.snippet.toLowerCase()}
                data-tags={post.data.tags.join(" ").toLowerCase()}
              >
                <div>
                  <!-- Header with Icon & Meta Pills -->
                  <div class="flex items-start justify-between gap-4 mb-5">
                    <div class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-brand group-hover:bg-[#FFFF00] group-hover:text-black transition-colors shrink-0">
                      <Icon name={iconName} class="w-6 h-6" />
                    </div>

                    <div class="flex flex-wrap items-center justify-end gap-2">
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-[#FFFF00] text-black border border-brand">
                        <span>{post.data.category}</span>
                      </span>
                      <span class="text-[11px] font-mono text-zinc-400 bg-white/5 border border-white/10 px-2 py-0.5 rounded-full flex items-center gap-1">
                        <Icon name="bx:time" class="w-3 h-3 text-zinc-400" />
                        <span>~{readingMinutes} min</span>
                      </span>
                    </div>
                  </div>

                  <!-- Post Title -->
                  <h2 class="text-xl sm:text-2xl font-display font-bold text-white group-hover:text-brand transition-colors leading-snug mb-3 tracking-tight">
                    <a href={href(`/blog/${post.id}/`)}>
                      {post.data.title}
                    </a>
                  </h2>

                  <!-- Snippet -->
                  <p class="text-xs sm:text-sm text-zinc-300 font-light line-clamp-3 leading-relaxed mb-4">
                    {post.data.snippet}
                  </p>
                </div>

                <!-- Footer with Date & Read -->
                <div class="pt-5 border-t border-white/10 flex items-center justify-between text-xs font-mono text-zinc-400 mt-2">
                  <time datetime={post.data.publishDate.toISOString()}>
                    {post.data.publishDate.toLocaleDateString(isEn ? "en-US" : "es-ES", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </time>
                  <a
                    href={href(`/blog/${post.id}/`)}
                    class="inline-flex items-center gap-1 text-brand font-bold font-mono text-xs uppercase tracking-wider hover:underline"
                  >
                    <span>{isEn ? "Read article" : "Leer artículo"}</span>
                    <span>→</span>
                  </a>
                </div>
              </article>
            );
          })}
        </div>

        <!-- No matches message -->
        <div id="no-posts-found" class="hidden py-16 text-center">
          <p class="font-mono text-xs uppercase tracking-wider text-brand font-bold">
            {isEn ? "No matches" : "Sin coincidencias"}
          </p>
          <p class="mt-2 text-sm text-zinc-400 font-light">
            {isEn ? "No articles found matching this search or category." : "No se ha encontrado ningún artículo con esta búsqueda o categoría."}
          </p>
        </div>

        <!-- Newsletter CTA Card -->
        <section class="mt-20 surface-card p-8 sm:p-10 rounded-3xl bg-[#121216] border border-brand/30 shadow-xl relative overflow-hidden">
          <div class="max-w-2xl relative z-10">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold bg-[#FFFF00] text-black border border-brand mb-4">
              <Icon name="bx:envelope" class="w-3.5 h-3.5" />
              <span>{isEn ? "Technical newsletter: Practical frontend" : "Boletín técnico: Frontend de trinchera"}</span>
            </span>
            <h3 class="text-2xl sm:text-3xl font-display font-bold text-white tracking-tight mb-3">
              {isEn ? "Get one technical article a month, zero spam." : "Recibe un artículo técnico al mes, sin spam ni postureo."}
            </h3>
            <p class="text-xs sm:text-sm text-zinc-300 font-light mb-6 leading-relaxed">
              {isEn ? "Architecture patterns in Angular, 60 FPS performance optimizations, CI/CD, and real-world audit insights." : "Patrones de arquitectura en Angular, consejos para lograr 60 FPS estables, CI/CD y aprendizajes de auditorías reales."}
            </p>
            <form
              action={href("/contact")}
              method="GET"
              class="flex flex-col sm:flex-row gap-3 max-w-lg"
            >
              <input
                type="email"
                name="email"
                placeholder={isEn ? "your.email@company.com" : "tu.correo@empresa.com"}
                required
                class="px-4 py-2.5 rounded-xl bg-[#0a0a0c] border border-white/10 text-xs sm:text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-brand flex-1 font-mono"
              />
              <button
                type="submit"
                class="btn btn-brand btn-sm px-5 text-xs uppercase tracking-wider font-bold whitespace-nowrap cursor-pointer"
              >
                {isEn ? "Subscribe for free" : "Suscribirme gratis"}
              </button>
            </form>
          </div>
        </section>
      </div>
    </Container>
  </div>

  <!-- Client-side Category Filter & Search Script -->
  <script is:inline>
    (function() {
      const searchInput = document.getElementById("blog-search-input");
      const filterButtons = document.querySelectorAll(".filter-btn");
      const postCards = document.querySelectorAll(".post-card");
      const noResults = document.getElementById("no-posts-found");
      if (!postCards.length) return;

      let currentCategory = "ALL";
      let currentQuery = "";

      function filterPosts() {
        let visibleCount = 0;

        postCards.forEach(function(card) {
          const cardCategory = (card.getAttribute("data-category") || "").toLowerCase();
          const cardTitle = (card.getAttribute("data-title") || "").toLowerCase();
          const cardSnippet = (card.getAttribute("data-snippet") || "").toLowerCase();
          const cardTags = (card.getAttribute("data-tags") || "").toLowerCase();
          const searchable = `${cardTitle} ${cardSnippet} ${cardTags}`;

          const matchesCategory = currentCategory === "ALL" || cardCategory === currentCategory.toLowerCase();
          const matchesQuery = !currentQuery || searchable.includes(currentQuery);

          if (matchesCategory && matchesQuery) {
            card.style.display = "flex";
            visibleCount++;
          } else {
            card.style.display = "none";
          }
        });

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove("hidden");
          } else {
            noResults.classList.add("hidden");
          }
        }
      }

      if (searchInput) {
        searchInput.addEventListener("input", function(e) {
          currentQuery = (e.target.value || "").trim().toLowerCase();
          filterPosts();
        });
      }

      filterButtons.forEach(function(btn) {
        btn.addEventListener("click", function() {
          const rawCat = btn.getAttribute("data-category") || "Todas";
          currentCategory = (rawCat === "Todas" || rawCat === "All") ? "ALL" : rawCat;

          filterButtons.forEach(function(b) {
            const isCurrent = b === btn;
            b.className = isCurrent
              ? "filter-btn px-3.5 py-2 min-h-[44px] rounded-xl text-xs font-mono transition-all border flex items-center gap-1.5 cursor-pointer bg-[#FFFF00] text-black border-brand font-bold shadow-xs active"
              : "filter-btn px-3.5 py-2 min-h-[44px] rounded-xl text-xs font-mono transition-all border flex items-center gap-1.5 cursor-pointer bg-white/5 text-zinc-300 border-white/10 hover:text-white hover:border-brand/40";
          });

          filterPosts();
        });
      });
    })();
  </script>
</Layout>

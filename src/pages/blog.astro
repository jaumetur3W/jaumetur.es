---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { Icon } from "astro-icon/components";
import { localeFromPath, localizePath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const href = (path: string) => localizePath(path, isEn ? "en" : "es");

// Filter blog entries with 'draft: false' & date before current date
const publishedBlogEntries = await getCollection("blog", ({ data }) => {
  return !data.draft && data.publishDate <= new Date() && data.lang === "es";
});

// Sort content entries by publication date (newest first)
publishedBlogEntries.sort(function (a, b) {
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});

// Extract all unique categories
const allCategory = isEn ? "All" : "Todas";
const categories = [allCategory, ...new Set(publishedBlogEntries.map((post) => post.data.category))];

// Category icon helper
const getCategoryIcon = (category: string) => {
  const cat = category.toLowerCase();
  if (cat.includes("angular")) return "simple-icons:angular";
  if (cat.includes("rendiment") || cat.includes("performance") || cat.includes("rendimiento")) return "bx:bxs-zap";
  if (cat.includes("ci/cd") || cat.includes("devops")) return "bx:git-repo-forked";
  if (cat.includes("accessibilitat") || cat.includes("accesibilidad") || cat.includes("wcag")) return "bx:accessibility";
  if (cat.includes("typescript")) return "simple-icons:typescript";
  if (cat.includes("carrera") || cat.includes("portfolio")) return "bx:briefcase";
  if (cat.includes("cas d'estudi") || cat.includes("caso") || cat.includes("case study")) return "bx:search-alt";
  return "bx:file-blank";
};
---

<Layout
  title={isEn ? "Web Development Blog & Engineering Resources | Jaume Tur" : "Blog de Desarrollo Web y Recursos Técnicos | Jaume Tur"}
  description={isEn ? "Technical articles, practical guides, and architecture insights on frontend apps, performance, and CI/CD." : "Artículos técnicos, guías prácticas y casos de estudio sobre diseño web, aplicaciones frontend, backend, rendimiento y automatización CI/CD."}
>
  <header class="border-b border-white/15 pb-10 pt-12 sm:pb-14 sm:pt-20">
    <div class="wrap">
      <h1 class="h-page max-w-4xl">
        {isEn ? "Articles, patterns and architecture." : "Artículos, patrones y arquitectura."}
      </h1>
      <p class="lede mt-6">
        {isEn
          ? "Technical guides, frontend architecture patterns and performance deep dives based on real production projects."
          : "Guías técnicas, patrones de arquitectura frontend y análisis de rendimiento basados en proyectos reales de producción."}
      </p>

      <div class="mt-9 max-w-md">
        <label for="blog-search-input" class="field-label">
          {isEn ? "Search articles" : "Buscar artículos"}
        </label>
        <input
          id="blog-search-input"
          type="search"
          autocomplete="off"
          placeholder={isEn ? "Astro, SEO, Angular, TypeScript…" : "Astro, SEO, Angular, TypeScript…"}
          class="field"
        />
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-2" id="category-filters" role="group" aria-label={isEn ? "Category filters" : "Filtros por categoría"}>
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-category={cat}
            class={`filter-btn inline-flex min-h-11 cursor-pointer items-center rounded-sm border px-3.5 text-[0.92rem] font-semibold transition-colors ${
              idx === 0
                ? "border-[#ffff00] bg-[#ffff00] text-[#0b0b09] active"
                : "border-white/30 bg-transparent text-white hover:border-white hover:bg-white/10"
            }`}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </header>

  <section class="section" aria-label={isEn ? "Articles" : "Artículos"}>
    <div class="wrap">
      <div id="posts-container" class="border-b border-white/15">
        {publishedBlogEntries.map((post) => {
          const wordsCount = post.body ? post.body.trim().split(/\s+/).length : 600;
          const readingMinutes = Math.max(1, Math.round(wordsCount / 200));
          return (
            <article
              class="post-card flex"
              data-title={post.data.title.toLowerCase()}
              data-category={post.data.category}
              data-snippet={post.data.snippet.toLowerCase()}
              data-tags={post.data.tags.join(" ").toLowerCase()}
            >
              <a href={href(`/blog/${post.id}/`)} class="item w-full lg:grid-cols-12 lg:items-start">
                <span class="lg:col-span-3">
                  <time class="label block" datetime={post.data.publishDate.toISOString()}>
                    {post.data.publishDate.toLocaleDateString(isEn ? "en-US" : "es-ES", { year: "numeric", month: "short", day: "numeric" })}
                  </time>
                  <span class="label mt-1 block">{post.data.category} · ~{readingMinutes} min</span>
                </span>
                <span class="lg:col-span-9">
                  <span class="block font-display text-[1.6rem] font-bold leading-[1.08] sm:text-[2rem]" style="font-stretch:84%">{post.data.title}</span>
                  <span class="muted mt-2 block max-w-3xl leading-relaxed">{post.data.snippet}</span>
                </span>
              </a>
            </article>
          );
        })}
      </div>

      <div id="no-posts-found" class="hidden py-16">
        <p class="font-display text-[1.8rem] font-bold" style="font-stretch:84%">{isEn ? "No matches" : "Sin coincidencias"}</p>
        <p class="muted mt-2">
          {isEn ? "No articles found matching this search or category." : "No se ha encontrado ningún artículo con esta búsqueda o categoría."}
        </p>
      </div>
    </div>
  </section>

  <section class="section border-t border-white/15" aria-labelledby="blog-cta-title">
    <div class="wrap grid items-end gap-8 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 id="blog-cta-title" class="h-section">
          {isEn ? "Need this applied to your business?" : "¿Necesitas esto aplicado a tu negocio?"}
        </h2>
        <p class="lede mt-5">
          {isEn ? "Tell me about your project and I will reply with scope, price and timeline." : "Cuéntame tu proyecto y te respondo con alcance, precio y plazo."}
        </p>
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-5 lg:justify-end">
        <a href={href("/contact")} class="btn btn-brand">{isEn ? "Get a quote" : "Pedir presupuesto"} <span aria-hidden="true">→</span></a>
        <a href={href("/pricing")} class="btn btn-white">{isEn ? "Services & pricing" : "Servicios y precios"}</a>
      </div>
    </div>
  </section>

  <!-- Client-side Category Filter & Search Script -->
  <script is:inline>
    (function() {
      const searchInput = document.getElementById("blog-search-input");
      const filterButtons = document.querySelectorAll(".filter-btn");
      const postCards = document.querySelectorAll(".post-card");
      const noResults = document.getElementById("no-posts-found");
      if (!postCards.length) return;

      let currentCategory = "ALL";
      let currentQuery = "";

      function filterPosts() {
        let visibleCount = 0;

        postCards.forEach(function(card) {
          const cardCategory = (card.getAttribute("data-category") || "").toLowerCase();
          const cardTitle = (card.getAttribute("data-title") || "").toLowerCase();
          const cardSnippet = (card.getAttribute("data-snippet") || "").toLowerCase();
          const cardTags = (card.getAttribute("data-tags") || "").toLowerCase();
          const searchable = `${cardTitle} ${cardSnippet} ${cardTags}`;

          const matchesCategory = currentCategory === "ALL" || cardCategory === currentCategory.toLowerCase();
          const matchesQuery = !currentQuery || searchable.includes(currentQuery);

          if (matchesCategory && matchesQuery) {
            card.style.display = "flex";
            visibleCount++;
          } else {
            card.style.display = "none";
          }
        });

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove("hidden");
          } else {
            noResults.classList.add("hidden");
          }
        }
      }

      if (searchInput) {
        searchInput.addEventListener("input", function(e) {
          currentQuery = (e.target.value || "").trim().toLowerCase();
          filterPosts();
        });
      }

      filterButtons.forEach(function(btn) {
        btn.addEventListener("click", function() {
          const rawCat = btn.getAttribute("data-category") || "Todas";
          currentCategory = (rawCat === "Todas" || rawCat === "All") ? "ALL" : rawCat;

          filterButtons.forEach(function(b) {
            const isCurrent = b === btn;
            b.className = isCurrent
              ? "filter-btn inline-flex min-h-11 cursor-pointer items-center rounded-sm border px-3.5 text-[0.92rem] font-semibold transition-colors border-[#ffff00] bg-[#ffff00] text-[#0b0b09] active"
              : "filter-btn inline-flex min-h-11 cursor-pointer items-center rounded-sm border px-3.5 text-[0.92rem] font-semibold transition-colors border-white/30 bg-transparent text-white hover:border-white hover:bg-white/10";
          });

          filterPosts();
        });
      });
    })();
  </script>
</Layout>

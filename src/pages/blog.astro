---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { Icon } from "astro-icon/components";

// Filter blog entries with 'draft: false' & date before current date
const publishedBlogEntries = await getCollection("blog", ({ data }) => {
  return !data.draft && data.publishDate <= new Date();
});

// Sort content entries by publication date (newest first)
publishedBlogEntries.sort(function (a, b) {
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});

// Extract all unique categories
const categories = ["Tots", ...new Set(publishedBlogEntries.map((post) => post.data.category))];

// Category icon helper (Standardized icons)
const getCategoryIcon = (category: string) => {
  const cat = category.toLowerCase();
  if (cat.includes("angular")) return "simple-icons:angular";
  if (cat.includes("rendiment") || cat.includes("performance")) return "bx:bxs-zap";
  if (cat.includes("ci/cd") || cat.includes("devops")) return "bx:git-repo-forked";
  if (cat.includes("accessibilitat") || cat.includes("wcag")) return "bx:accessibility";
  if (cat.includes("typescript")) return "simple-icons:typescript";
  if (cat.includes("carrera") || cat.includes("portfolio")) return "bx:briefcase";
  if (cat.includes("cas d'estudi") || cat.includes("caso")) return "bx:search-alt";
  return "bx:file-blank";
};
---

<Layout
  title="Blog d'Enginyeria Frontend & Web Apps"
  description="Articles tècnics, guies pràctiques i casos d'estudi sobre Angular Modern, Signals, optimització de rendiment a 60 FPS, accessibilitat WCAG AA i automatització CI/CD."
>
  <Container>
    <div class="mt-8 mb-4">
      <Sectionhead>
        <Fragment slot="title">Blog & Recursos d'Enginyeria</Fragment>
        <Fragment slot="desc">
          Guies tècniques en profunditat, patrons d'arquitectura frontend i anàlisis de rendiment basades en projectes reals en producció.
        </Fragment>
      </Sectionhead>
    </div>

    <!-- Category Filters -->
    <div class="max-w-5xl mx-auto my-10">
      <div class="flex flex-wrap gap-2 items-center justify-center sm:justify-start pb-6 border-b border-slate-200/90" id="category-filters" role="group" aria-label="Filtres per categoria">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-category={cat}
            class={`filter-btn px-3.5 py-2 min-h-[44px] rounded-xl text-xs font-mono transition-all border flex items-center gap-1.5 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 ${
              idx === 0
                ? "bg-indigo-600 text-white border-indigo-500 shadow-sm shadow-indigo-500/20 active"
                : "bg-white text-slate-600 border-slate-200/90 hover:text-slate-900 hover:border-indigo-300 shadow-2xs"
            }`}
          >
            <Icon name={cat !== "Tots" ? getCategoryIcon(cat) : "bx:layer"} class="w-3.5 h-3.5" />
            <span>{cat}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Articles Grid -->
    <div class="max-w-5xl mx-auto mb-20">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="posts-container">
        {publishedBlogEntries.map((post) => {
          const wordsCount = post.body ? post.body.trim().split(/\s+/).length : 600;
          const readingMinutes = Math.max(1, Math.round(wordsCount / 200));
          const iconName = getCategoryIcon(post.data.category);

          return (
            <article
              class="post-card group flex flex-col justify-between rounded-2xl bg-white border border-slate-200/90 hover:border-indigo-400 transition-all duration-300 overflow-hidden shadow-2xs hover:shadow-lg hover:shadow-indigo-500/5"
              data-title={post.data.title.toLowerCase()}
              data-category={post.data.category}
              data-snippet={post.data.snippet.toLowerCase()}
              data-tags={post.data.tags.join(" ").toLowerCase()}
            >
              <div>
                {/* Cover Image */}
                {post.data.image && post.data.image.src && (
                  <a href={`/blog/${post.id}`} class="block overflow-hidden aspect-[16/9] bg-slate-100 border-b border-slate-100">
                    <img
                      src={post.data.image.src}
                      alt={post.data.image.alt}
                      loading="lazy"
                      decoding="async"
                      width="600"
                      height="338"
                      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-200"
                    />
                  </a>
                )}

                <div class="p-6">
                  <!-- Category and Reading Time with Standardized Icons -->
                  <div class="flex items-center justify-between gap-2 mb-3">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-mono font-medium bg-indigo-50 border border-indigo-200/80 text-indigo-700">
                      <Icon name={iconName} class="w-3.5 h-3.5" />
                      <span>{post.data.category}</span>
                    </span>
                    <span class="text-[11px] font-mono text-emerald-700 bg-emerald-50 border border-emerald-200/80 px-2 py-0.5 rounded-full flex items-center gap-1">
                      <Icon name="bx:time" class="w-3.5 h-3.5 text-emerald-600" />
                      <span>~{readingMinutes} min</span>
                    </span>
                  </div>

                  <!-- Post Title -->
                  <h2 class="text-xl font-bold text-slate-900 group-hover:text-indigo-600 transition-colors leading-snug mb-3">
                    <a href={`/blog/${post.id}`}>
                      {post.data.title}
                    </a>
                  </h2>

                  <!-- Snippet -->
                  <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed mb-4">
                    {post.data.snippet}
                  </p>
                </div>
              </div>

              <!-- Footer with Tags & Date -->
              <div class="px-6 pb-6 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-mono text-slate-500">
                <time datetime={post.data.publishDate.toISOString()}>
                  {post.data.publishDate.toLocaleDateString("ca-ES", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
                <a
                  href={`/blog/${post.id}`}
                  class="inline-flex items-center gap-1 text-indigo-600 hover:text-indigo-800 transition-colors font-bold"
                >
                  <span>Llegir article</span>
                  <span>→</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Lead Magnet Newsletter Box with Standardized Icons -->
      <section class="mt-20 p-8 sm:p-10 rounded-3xl bg-[#090D16] text-white border border-slate-800 shadow-2xl relative overflow-hidden">
        <div class="max-w-2xl relative z-10">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium bg-indigo-500/20 border border-indigo-400/30 text-indigo-300 mb-4 shadow-2xs">
            <Icon name="bx:envelope" class="w-3.5 h-3.5 text-indigo-400" />
            <span>Newsletter Tècnica: Frontend de Trinxera</span>
          </span>
          <h3 class="text-2xl sm:text-3xl font-black text-white tracking-tight mb-3">
            Reb un article tècnic al mes sense spam ni postureig.
          </h3>
          <p class="text-sm text-slate-300 mb-6 leading-relaxed">
            Patrons d'arquitectura en Angular, trucs per aconseguir 60 FPS estables, CI/CD per a desenvolupadors web i aprenentatges d'auditories reals.
          </p>
          <form
            action="/contact"
            method="GET"
            class="flex flex-col sm:flex-row gap-3 max-w-lg"
          >
            <input
              type="email"
              name="email"
              placeholder="el.teu.correu@empresa.com"
              required
              class="px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm text-white placeholder-slate-400 focus:outline-none focus:border-indigo-500 flex-1 font-mono"
            />
            <button
              type="submit"
              class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm transition-all shadow-lg shadow-indigo-600/30 whitespace-nowrap cursor-pointer"
            >
              Subscriure'm de franc
            </button>
          </form>
        </div>
      </section>
    </div>
  </Container>

  <!-- Client-side Category Filter Script (Mínim JS, sense cerca de text) -->
  <script is:inline>
    (function() {
      const filterButtons = document.querySelectorAll(".filter-btn");
      const postCards = document.querySelectorAll(".post-card");
      if (!filterButtons.length || !postCards.length) return;

      filterButtons.forEach(function(btn) {
        btn.addEventListener("click", function() {
          const cat = btn.getAttribute("data-category") || "Tots";

          filterButtons.forEach(function(b) {
            const isCurrent = b === btn;
            b.className = isCurrent
              ? "filter-btn px-3.5 py-2 min-h-[44px] rounded-xl text-xs font-mono transition-all border flex items-center gap-1.5 cursor-pointer bg-indigo-600 text-white border-indigo-500 shadow-sm shadow-indigo-500/20 active"
              : "filter-btn px-3.5 py-2 min-h-[44px] rounded-xl text-xs font-mono transition-all border flex items-center gap-1.5 cursor-pointer bg-white text-slate-600 border-slate-200/90 hover:text-slate-900 hover:border-indigo-300 shadow-2xs";
          });

          postCards.forEach(function(card) {
            const cardCategory = card.getAttribute("data-category") || "";
            card.style.display = (cat === "Tots" || cardCategory === cat) ? "flex" : "none";
          });
        });
      });
    })();
  </script>
</Layout>

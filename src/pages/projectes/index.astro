---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { Icon } from "astro-icon/components";
import { localeFromPath, localizePath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const href = (path: string) => localizePath(path, isEn ? "en" : "es");

const rawProjects = isEn ? await getCollection("projectes-en") : await getCollection("projectes");
const projects = rawProjects.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

// Categories per tipus de projecte
const projectCategories = [
  { id: "all", label: isEn ? "All projects" : "Todos los proyectos" },
  { id: "web-apps", label: isEn ? "Web apps" : "Aplicaciones web" },
  { id: "negocis", label: isEn ? "Business & Commerce" : "Negocios y comercio" },
  { id: "devops", label: isEn ? "DevOps & Tools" : "DevOps y herramientas" },
  { id: "editorial", label: isEn ? "Editorial websites" : "Webs editoriales" },
];

const getProjectCategory = (id: string): string => {
  if (id === "avisa" || id === "dashboard-telemetria") return "web-apps";
  if (id === "pizzeria-xativa" || id === "burger-xativa") return "negocis";
  if (id === "pipeline-cicd") return "devops";
  if (id === "forma-espacio" || id === "fincarural") return "editorial";
  return "web-apps";
};
---

<Layout
  title={isEn ? "Web Projects & Custom Applications Portfolio | Jaume Tur" : "Portafolio de Proyectos Web y Aplicaciones a Medida | Jaume Tur"}
  description={isEn ? "Real-world case studies and technical demonstrations in web development, custom applications, backend, and frontend architecture by Jaume Tur." : "Casos de estudio reales y demostraciones técnicas de desarrollo web, aplicaciones a medida, backend y arquitectura frontend por Jaume Tur."}
>
  <Container>
    <header class="mx-auto max-w-3xl pt-12 pb-10 sm:pt-16 sm:pb-12 text-left">
      <p class="mb-3 text-xs font-mono uppercase tracking-[0.16em] text-slate-600 font-semibold">
        {isEn ? "Portfolio & Case Studies" : "Portafolio y casos de estudio"}
      </p>
      <h1 class="max-w-2xl text-3xl font-light leading-tight tracking-tight text-slate-950 sm:text-4xl lg:text-5xl">
        {isEn ? "Projects that explain " : "Proyectos que explican "}<span class="decoration-[#FFFF00] decoration-2 underline underline-offset-4">{isEn ? "how I build." : "cómo desarrollo."}</span>
      </h1>
      <p class="mt-4 max-w-2xl text-sm sm:text-base leading-relaxed text-slate-600 font-light">
        {isEn ? "Applications, interactive demonstrations, and web engineering case studies. In each monograph you will find the problem statement, my specific role, and the tech stack." : "Aplicaciones, demostraciones y proyectos de desarrollo web. En cada ficha encontrarás qué es, cuál ha sido mi papel y qué tecnologías se han utilizado."}
      </p>
      <div class="mt-5">
        <a
          href={href("/qualitat")}
          class="inline-flex items-center gap-2 text-xs font-mono font-medium text-slate-600 hover:text-slate-950 underline decoration-[#FFFF00] decoration-2 underline-offset-4 transition-colors"
        >
          <span>{isEn ? "Review technical audit criteria" : "Consulta los criterios de revisión técnica"}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </header>

    <!-- Barra de Cerca i Filtres per Tipus -->
    <div class="mb-10 space-y-4">
      <!-- Cercador instantani -->
      <div class="relative max-w-md">
        <label for="project-search-input" class="sr-only">
          {isEn ? "Search projects by title, role or tech" : "Buscar proyectos por título, papel o tecnología"}
        </label>
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-600">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          id="project-search-input"
          type="search"
          placeholder={isEn ? "Search by tech (React, Angular, TypeScript...), name..." : "Buscar por tecnología (React, Angular...), nombre..."}
          class="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-4 text-xs sm:text-sm text-slate-900 placeholder-slate-500 shadow-2xs outline-none transition focus:border-slate-950 focus:ring-2 focus:ring-[#FFFF00]"
        />
      </div>

      <!-- Filtres per Tipus (Pills) -->
      <div
        id="project-type-filters"
        class="flex flex-wrap items-center gap-2"
        role="group"
        aria-label={isEn ? "Filter projects by type" : "Filtrar proyectos por tipo"}
      >
        {projectCategories.map((cat, idx) => (
          <button
            type="button"
            data-category={cat.id}
            class={`project-filter-btn inline-flex min-h-[36px] items-center rounded-xl px-3.5 py-1.5 text-xs font-mono font-medium transition cursor-pointer border ${
              idx === 0
                ? "bg-slate-950 text-white border-slate-950 shadow-xs"
                : "bg-white text-slate-600 border-slate-200 hover:border-slate-950 hover:text-slate-950 shadow-2xs"
            }`}
          >
            <span>{cat.label}</span>
          </button>
        ))}
      </div>
    </div>

    <section aria-label={isEn ? "Projects" : "Proyectos"} class="mb-24">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-8" id="projects-grid">
        {projects.map((project) => {
          const projectCopy = project.data;
          const category = getProjectCategory(project.id);
          const stackList = project.data.stack;
          const searchKeywords = `${projectCopy.title} ${projectCopy.subtitle} ${stackList.join(" ")} ${project.data.role}`.toLowerCase();
          const projectIcon = project.data.icon || "bx:code-alt";
          const isAvisa = project.id === "avisa";

          if (isAvisa) {
            return (
              <article
                class="project-card group relative md:col-span-2 overflow-hidden rounded-3xl border border-slate-900 bg-slate-950 text-white shadow-xl hover:shadow-2xl transition-all duration-300 p-6 sm:p-8 lg:p-10"
                data-category={category}
                data-keywords={searchKeywords}
              >
                <!-- Fons ambiental subtil -->
                <div class="absolute -right-20 -top-20 w-80 h-80 rounded-full bg-rose-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>
                <div class="absolute -left-20 -bottom-20 w-72 h-72 rounded-full bg-indigo-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

                <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                  <!-- Columna principal (esquerra) -->
                  <div class="lg:col-span-7 flex flex-col justify-between">
                    <!-- Capçalera amb logo oficial i badges -->
                    <div class="flex flex-wrap items-center gap-3.5 mb-6">
                      <img
                        src="/img/avisa-logo.png"
                        alt="Logo oficial AVISA"
                        class="w-13 h-13 sm:w-14 sm:h-14 rounded-2xl border border-rose-500/30 bg-[#161c28] p-1.5 shadow-md object-contain shrink-0"
                        width="56"
                        height="56"
                      />
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-rose-500/20 px-3 py-1 text-[11px] font-mono font-semibold uppercase tracking-wider text-rose-300 border border-rose-500/40 shadow-xs">
                          <Icon name="bx:star" class="w-3.5 h-3.5 text-rose-300" />
                          <span>{isEn ? "Flagship project" : "Buque insignia"}</span>
                        </span>
                        <span class="rounded-full bg-[#FFFF00] px-3 py-1 text-[11px] font-mono font-semibold uppercase tracking-wider text-slate-950 border border-slate-950/20 shadow-xs">
                          {isEn ? "Client project" : "Proyecto de cliente"}
                        </span>
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/15 px-3 py-1 text-[11px] font-mono font-semibold text-emerald-300 border border-emerald-500/30">
                          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                          <span>WCAG 2.2 AA · &lt; 150ms</span>
                        </span>
                      </div>
                    </div>

                    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-light leading-snug tracking-tight text-white">
                      <a
                        href={href(`/projectes/${project.id}`)}
                        class="hover:text-rose-200 underline decoration-[#FFFF00] decoration-2 underline-offset-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00]"
                      >
                        {projectCopy.title}
                      </a>
                    </h2>
                    <p class="mt-3 text-xs sm:text-sm lg:text-base leading-relaxed text-slate-300 font-light max-w-xl">
                      {projectCopy.subtitle}
                    </p>

                    <dl class="mt-6 border-t border-slate-800/80 pt-4 space-y-3">
                      <div>
                        <dt class="text-[10px] font-mono uppercase tracking-wider text-slate-400 font-semibold">{isEn ? "Role" : "Mi papel"}</dt>
                        <dd class="mt-0.5 text-xs font-normal text-slate-200">{project.data.role}</dd>
                      </div>
                      <div>
                        <dt class="text-[10px] font-mono uppercase tracking-wider text-slate-400 font-semibold">{isEn ? "Technologies" : "Tecnologías"}</dt>
                        <dd class="mt-1.5 flex flex-wrap gap-1.5">
                          {stackList.map((tech) => (
                            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-mono bg-slate-900 text-slate-200 border border-slate-800">
                              {tech}
                            </span>
                          ))}
                        </dd>
                      </div>
                    </dl>

                    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-slate-800/80 pt-5 text-xs font-mono font-semibold">
                      <a
                        href={href(`/projectes/${project.id}`)}
                        class="inline-flex min-h-10 items-center gap-2 px-5 py-2.5 rounded-xl bg-[#FFFF00] text-slate-950 hover:bg-[#f2d900] transition-colors shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00]"
                      >
                        <span>{isEn ? "Case study" : "Caso de estudio"}</span>
                        <span aria-hidden="true">→</span>
                      </a>
                      {project.data.liveUrl && (
                        <a
                          href={project.data.liveUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex min-h-10 items-center gap-1.5 text-slate-300 hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00]"
                        >
                          <span>{isEn ? "Open project" : "Abrir proyecto"}</span>
                          <span aria-hidden="true">↗</span>
                        </a>
                      )}
                    </div>
                  </div>

                  <!-- Columna monitor en temps real (dreta) -->
                  <div class="lg:col-span-5 w-full rounded-2xl bg-slate-900/90 border border-slate-800 p-4 sm:p-5 font-mono text-xs shadow-inner">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-800 text-[11px]">
                      <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse"></span>
                        <span class="text-rose-400 font-semibold tracking-wider uppercase text-[10px]">
                          {isEn ? "Live Incident Dispatch" : "Monitor d'incidències en viu"}
                        </span>
                      </div>
                      <span class="text-emerald-400 text-[10px] font-mono">latència: &lt;142ms</span>
                    </div>

                    <div class="mt-3 space-y-2.5">
                      <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800/90">
                        <div class="flex items-center justify-between gap-2 mb-1">
                          <span class="text-rose-400 font-bold text-[11px]">#INC-402</span>
                          <span class="px-2 py-0.5 rounded text-[9px] font-bold bg-rose-500/20 text-rose-300 border border-rose-500/30 uppercase tracking-wider">
                            {isEn ? "Critical" : "Crítica"}
                          </span>
                        </div>
                        <p class="text-slate-200 text-xs font-sans">
                          {isEn ? "Central Avenue lighting outage — automatic dispatch" : "Enllumenat avinguda central — assignació automàtica"}
                        </p>
                        <div class="mt-1.5 flex items-center justify-between text-[10px] text-slate-300">
                          <span>Zona Nord · Camí Real</span>
                          <span class="text-rose-400">Signal: active</span>
                        </div>
                      </div>

                      <div class="p-2.5 rounded-xl bg-slate-950/60 border border-slate-800/60">
                        <div class="flex items-center justify-between gap-2 mb-1">
                          <span class="text-amber-400 font-bold text-[11px]">#INC-401</span>
                          <span class="px-2 py-0.5 rounded text-[9px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 uppercase tracking-wider">
                            {isEn ? "Assigned" : "Assignada"}
                          </span>
                        </div>
                        <p class="text-slate-300 text-xs font-sans">
                          {isEn ? "Sidewalk obstruction cleared — crew in transit" : "Retirada d'obstacles vorera — brigada en trànsit"}
                        </p>
                        <div class="mt-1.5 flex items-center justify-between text-[10px] text-slate-300">
                          <span>Districte Centre</span>
                          <span class="text-emerald-400">ARIA live: polite</span>
                        </div>
                      </div>
                    </div>

                    <div class="mt-3 pt-3 border-t border-slate-800 flex items-center justify-between text-[10px] text-slate-300">
                      <span class="flex items-center gap-1.5">
                        <Icon name="bx:code-block" class="w-3.5 h-3.5 text-rose-400" />
                        <span>Angular 17+ Signals</span>
                      </span>
                      <span class="text-slate-400">Vercel Edge</span>
                    </div>
                  </div>
                </div>
              </article>
            );
          }

          return (
            <article
              class="project-card group flex min-w-0 flex-col justify-between overflow-hidden rounded-3xl border border-slate-200/90 bg-white hover:border-slate-950 shadow-2xs hover:shadow-md transition-all duration-200 p-6 sm:p-8"
              data-category={category}
              data-keywords={searchKeywords}
            >
              <div>
                <!-- Capçalera amb icona estandarditzada i badge -->
                <div class="flex items-start justify-between gap-4 mb-6">
                  <div class="w-12 h-12 rounded-2xl bg-slate-100 border border-slate-200/80 flex items-center justify-center text-slate-950 group-hover:bg-[#FFFF00] group-hover:border-slate-950 transition-colors shadow-2xs">
                    <Icon name={projectIcon} class="w-6 h-6 text-slate-950" />
                  </div>
                  <span class="rounded-full bg-[#FFFF00] px-3 py-1 text-[11px] font-mono font-semibold uppercase tracking-wider text-slate-950 border border-slate-950/20 shadow-xs">
                    {projectCopy.badge}
                  </span>
                </div>

                <h2 class="text-2xl font-light leading-snug tracking-tight text-slate-950">
                  <a
                    href={href(`/projectes/${project.id}`)}
                    class="hover:underline decoration-[#FFFF00] decoration-2 underline-offset-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00]"
                  >
                    {projectCopy.title}
                  </a>
                </h2>
                <p class="mt-2.5 max-w-prose text-xs sm:text-sm leading-relaxed text-slate-600 font-light">
                  {projectCopy.subtitle}
                </p>

                <dl class="mt-6 border-t border-slate-100 pt-4 space-y-3">
                  <div>
                    <dt class="text-[10px] font-mono uppercase tracking-wider text-slate-600 font-semibold">{isEn ? "Role" : "Mi papel"}</dt>
                    <dd class="mt-0.5 text-xs font-normal text-slate-800">{project.data.role}</dd>
                  </div>
                  <div>
                    <dt class="text-[10px] font-mono uppercase tracking-wider text-slate-600 font-semibold">{isEn ? "Technologies" : "Tecnologías"}</dt>
                    <dd class="mt-1.5 flex flex-wrap gap-1.5">
                      {stackList.map((tech) => (
                        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-mono bg-slate-100 text-slate-700 border border-slate-200/70">
                          {tech}
                        </span>
                      ))}
                    </dd>
                  </div>
                </dl>
              </div>

              <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-slate-100 pt-5 text-xs font-mono font-semibold">
                <a
                  href={href(`/projectes/${project.id}`)}
                  class="inline-flex min-h-10 items-center gap-1.5 text-slate-950 hover:text-black underline decoration-[#FFFF00] decoration-2 underline-offset-4 hover:decoration-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00]"
                >
                  <span>{isEn ? "Case study" : "Caso de estudio"}</span>
                  <span aria-hidden="true">→</span>
                </a>
                {project.data.liveUrl && (
                  <a
                    href={project.data.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-10 items-center gap-1.5 text-slate-600 hover:text-slate-950 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFFF00]"
                  >
                    <span>{isEn ? "Open project" : "Abrir proyecto"}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>

      <!-- Missatge sense resultats -->
      <div id="no-projects-found" class="hidden py-16 text-center">
        <p class="font-mono text-xs uppercase tracking-wider text-slate-600 font-semibold">
          {isEn ? "No matches" : "Sin coincidencias"}
        </p>
        <p class="mt-2 text-sm text-slate-600 font-light">
          {isEn ? "No projects found matching these filters or search." : "No se ha encontrado ningún proyecto con estos filtros o búsqueda."}
        </p>
      </div>
    </section>
  </Container>

  <!-- Script interactiu de filtres i cerca instantània -->
  <script is:inline>
    (function () {
      const searchInput = document.getElementById("project-search-input");
      const filterBtns = document.querySelectorAll(".project-filter-btn");
      const projectCards = document.querySelectorAll(".project-card");
      const noResults = document.getElementById("no-projects-found");

      let currentCategory = "all";
      let currentQuery = "";

      function filterProjects() {
        let visibleCount = 0;

        projectCards.forEach(function (card) {
          const cardCategory = card.getAttribute("data-category") || "";
          const cardKeywords = card.getAttribute("data-keywords") || "";

          const matchesCategory = currentCategory === "all" || cardCategory === currentCategory;
          const matchesQuery = !currentQuery || cardKeywords.includes(currentQuery);

          if (matchesCategory && matchesQuery) {
            card.style.display = "";
            visibleCount++;
          } else {
            card.style.display = "none";
          }
        });

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove("hidden");
          } else {
            noResults.classList.add("hidden");
          }
        }
      }

      if (searchInput) {
        searchInput.addEventListener("input", function (e) {
          currentQuery = (e.target.value || "").trim().toLowerCase();
          filterProjects();
        });
      }

      filterBtns.forEach(function (btn) {
        btn.addEventListener("click", function () {
          currentCategory = btn.getAttribute("data-category") || "all";

          filterBtns.forEach(function (b) {
            const isActive = b === btn;
            b.className = isActive
              ? "project-filter-btn inline-flex min-h-[36px] items-center rounded-xl px-3.5 py-1.5 text-xs font-mono font-medium transition cursor-pointer border bg-slate-950 text-white border-slate-950 shadow-xs"
              : "project-filter-btn inline-flex min-h-[36px] items-center rounded-xl px-3.5 py-1.5 text-xs font-mono font-medium transition cursor-pointer border bg-white text-slate-600 border-slate-200 hover:border-slate-950 hover:text-slate-950 shadow-2xs";
          });

          filterProjects();
        });
      });
    })();
  </script>
</Layout>

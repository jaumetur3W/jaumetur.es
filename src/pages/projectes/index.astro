---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { localeFromPath, localizePath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const to = (path: string) => {
  const p = localizePath(path, isEn ? "en" : "es");
  return p === "/" || p.endsWith("/") ? p : `${p}/`;
};
const projects = (await getCollection(isEn ? "projectes-en" : "projectes")).sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
const projectImages: Record<string, string> = {
  avisa: "/img/preview-avisa.webp",
  "pizzeria-xativa": "/img/foto_pizza.webp",
  "burger-xativa": "/img/foto_burger.webp",
  "dashboard-telemetria": "/img/preview-dashboard.webp",
  "pipeline-cicd": "/img/preview-pipeline.webp",
};
const shortTitle = (x: string) => x.split(" — ")[0];
const t = isEn
  ? {
      title: "Web projects and case studies | Jaume Tur",
      desc: "Websites, digital menus and web applications built by Jaume Tur in Xàtiva and Valencia. Open the live projects and see what was done in each one.",
      eyebrow: "Projects", h1: "Work you can open and try.",
      lead: "Websites, interactive demos and web applications. Demos with sample data are labelled as such. Each page explains what it is, my role and the technologies used.",
      view: "View case study", flagship: "Flagship", ctaTitle: "Your project could be next.", cta: "Get a quote", home: "Home",
    }
  : {
      title: "Proyectos y casos de estudio web | Jaume Tur",
      desc: "Páginas web, cartas digitales y aplicaciones web creadas por Jaume Tur en Xàtiva y Valencia. Abre los proyectos y mira qué se hizo en cada uno.",
      eyebrow: "Proyectos", h1: "Trabajo que puedes abrir y probar.",
      lead: "Páginas web, demos interactivas y aplicaciones web. Las demos con datos de ejemplo están indicadas como tales. Cada ficha explica qué es, mi papel y las tecnologías usadas.",
      view: "Ver caso de estudio", flagship: "Insignia", ctaTitle: "Tu proyecto puede ser el siguiente.", cta: "Pedir presupuesto", home: "Inicio",
    };
const list = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": t.eyebrow,
  "itemListElement": projects.map((p, i) => ({
    "@type": "ListItem", "position": i + 1, "name": p.data.title, "url": `https://jaumetur.es${to(`/projectes/${p.id}`)}`,
  })),
};
---

<Layout fresh title={t.title} description={t.desc} jsonLd={[list]}>
  <section class="border-b-2 border-ink bg-brand px-4 pb-14 pt-14 sm:px-5 sm:pt-20">
    <div class="mx-auto max-w-(--breakpoint-xl)">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 class="display mt-4 max-w-4xl text-[clamp(2.4rem,6.5vw,5rem)]">{t.h1}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/85">{t.lead}</p>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-5 sm:py-24">
    <ul class="mx-auto grid max-w-(--breakpoint-xl) gap-7 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p, i) => (
        <li class:list={[i === 0 ? "sm:col-span-2 lg:col-span-3" : ""]}>
          <a href={to(`/projectes/${p.id}`)} class:list={["card group grid h-full overflow-hidden", i === 0 ? "lg:grid-cols-2" : ""]}>
            <div class:list={["relative overflow-hidden border-b-2 border-ink bg-brand", i === 0 ? "lg:border-b-0 lg:border-r-2" : ""]}>
              {projectImages[p.id] ? (
                <img src={projectImages[p.id]} alt={p.data.image.alt} width="1200" height="675" loading={i < 3 ? "eager" : "lazy"} decoding="async" class="aspect-[16/9] h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
              ) : (
                <div class="flex aspect-[16/9] h-full w-full items-center justify-center p-6"><span class="display text-center text-3xl">{shortTitle(p.data.title)}</span></div>
              )}
            </div>
            <div class="flex flex-col p-6 sm:p-7">
              <div class="flex flex-wrap gap-2">
                {i === 0 && <span class="chip bg-ink! text-brand">{t.flagship}</span>}
                <span class="chip chip-brand text-[0.72rem]">{p.data.badge}</span>
              </div>
              <h2 class:list={["mt-4 font-display font-extrabold leading-tight tracking-tight", i === 0 ? "text-3xl sm:text-4xl" : "text-2xl"]}>{shortTitle(p.data.title)}</h2>
              <p class="mt-3 flex-1 leading-relaxed text-ink/75">{p.data.subtitle}</p>
              <ul class="mt-4 flex flex-wrap gap-1.5">{p.data.stack.slice(0, 4).map((s) => <li class="rounded-md border border-ink/30 px-2 py-0.5 font-mono text-[0.7rem]">{s}</li>)}</ul>
              <p class="mt-5 font-bold underline decoration-2 underline-offset-4 group-hover:bg-brand">{t.view} →</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="border-t-2 border-ink bg-brand px-4 py-16 text-center sm:px-5 sm:py-24">
    <h2 class="display mx-auto max-w-3xl text-[clamp(2rem,5.5vw,4rem)]">{t.ctaTitle}</h2>
    <p class="mt-8"><a href={to("/contact")} class="btn btn-ink">{t.cta} <span aria-hidden="true">→</span></a></p>
  </section>
</Layout>

---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { localeFromPath, localizePath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const to = (path: string) => {
  const p = localizePath(path, isEn ? "en" : "es");
  return p === "/" || p.endsWith("/") ? p : `${p}/`;
};
const projects = (await getCollection(isEn ? "projectes-en" : "projectes")).sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
const projectImages: Record<string, string> = {
  avisa: "/img/preview-avisa.webp",
  "pizzeria-xativa": "/img/foto_pizza.webp",
  "burger-xativa": "/img/foto_burger.webp",
  "dashboard-telemetria": "/img/preview-dashboard.webp",
  "pipeline-cicd": "/img/preview-pipeline.webp",
};
const shortTitle = (x: string) => x.split(" — ")[0];
const t = isEn
  ? {
      title: "Web projects and case studies | Jaume Tur",
      desc: "Websites, digital menus and web applications built by Jaume Tur in Xàtiva and Valencia. Open the live projects and see what was done in each one.",
      eyebrow: "Projects", h1: "Work you can open and try.",
      lead: "Websites, interactive demos and web applications. Demos with sample data are labelled as such. Each page explains what it is, my role and the technologies used.",
      view: "View case study", flagship: "Flagship", ctaTitle: "Your project could be next.", cta: "Get a quote", home: "Home",
    }
  : {
      title: "Proyectos y casos de estudio web | Jaume Tur",
      desc: "Páginas web, cartas digitales y aplicaciones web creadas por Jaume Tur en Xàtiva y Valencia. Abre los proyectos y mira qué se hizo en cada uno.",
      eyebrow: "Proyectos", h1: "Trabajo que puedes abrir y probar.",
      lead: "Páginas web, demos interactivas y aplicaciones web. Las demos con datos de ejemplo están indicadas como tales. Cada ficha explica qué es, mi papel y las tecnologías usadas.",
      view: "Ver caso de estudio", flagship: "Insignia", ctaTitle: "Tu proyecto puede ser el siguiente.", cta: "Pedir presupuesto", home: "Inicio",
    };
const list = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": t.eyebrow,
  "itemListElement": projects.map((p, i) => ({
    "@type": "ListItem", "position": i + 1, "name": p.data.title, "url": `https://jaumetur.es${to(`/projectes/${p.id}`)}`,
  })),
};
---

<Layout fresh title={t.title} description={t.desc} jsonLd={[list]}>
  <section class="border-b border-white/10 bg-gradient-to-b from-[#111118] to-[#070709] px-4 pb-16 pt-16 sm:px-6 sm:pt-24">
    <div class="mx-auto max-w-(--breakpoint-xl)">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 class="display mt-4 max-w-4xl text-[clamp(2.5rem,6.5vw,4.8rem)] text-white">{t.h1}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/80">{t.lead}</p>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 sm:py-24">
    <ul class="mx-auto grid max-w-(--breakpoint-xl) gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p, i) => (
        <li class:list={[i === 0 ? "sm:col-span-2 lg:col-span-3" : ""]}>
          <a href={to(`/projectes/${p.id}`)} class:list={["card group grid h-full overflow-hidden border border-white/10 bg-surface transition-all duration-300 hover:border-brand/70", i === 0 ? "lg:grid-cols-2" : ""]}>
            <div class:list={["relative overflow-hidden bg-[#16161c]", i === 0 ? "border-b border-white/10 lg:border-b-0 lg:border-r" : "border-b border-white/10 aspect-[16/10]"]}>
              {projectImages[p.id] ? (
                <img src={projectImages[p.id]} alt={p.data.image.alt} width="1200" height="675" loading={i < 3 ? "eager" : "lazy"} decoding="async" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
              ) : (
                <div class="flex aspect-[16/9] h-full w-full items-center justify-center p-6 bg-radial from-brand/20 to-transparent"><span class="display text-center text-3xl text-brand">{shortTitle(p.data.title)}</span></div>
              )}
            </div>
            <div class="flex flex-col p-6 sm:p-8">
              <div class="flex flex-wrap items-center gap-2">
                {i === 0 && <span class="rounded-full bg-brand px-3 py-0.5 text-xs font-bold text-black">{t.flagship}</span>}
                <span class="rounded-full border border-white/15 bg-white/5 px-3 py-0.5 text-[0.72rem] font-semibold text-white/80">{p.data.badge}</span>
              </div>
              <h2 class:list={["mt-4 font-display font-bold tracking-tight text-white group-hover:text-brand transition-colors", i === 0 ? "text-3xl sm:text-4xl" : "text-xl sm:text-2xl"]}>{shortTitle(p.data.title)}</h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-ink/75">{p.data.subtitle}</p>
              <ul class="mt-5 flex flex-wrap gap-1.5">{p.data.stack.slice(0, 4).map((s) => <li class="rounded-md bg-white/5 px-2.5 py-1 font-mono text-[0.7rem] text-white/60">{s}</li>)}</ul>
              <p class="mt-6 text-sm font-semibold text-brand">{t.view} →</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="relative overflow-hidden px-4 py-20 text-center sm:px-6 sm:py-28">
    <div class="pointer-events-none absolute left-1/2 top-1/2 h-[22rem] w-[46rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/15 blur-[120px]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl">
      <h2 class="display text-[clamp(2rem,5vw,3.6rem)] text-white">{t.ctaTitle}</h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-ink/80">¿Tienes una idea o necesitas actualizar la presencia de tu negocio? Hablemos sin compromiso.</p>
      <p class="mt-8"><a href={to("/contact")} class="btn btn-brand">{t.cta} <span aria-hidden="true">→</span></a></p>
    </div>
  </section>
</Layout>

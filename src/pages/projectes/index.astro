---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/page-header.astro";
import CtaBand from "@/components/cta-band.astro";
import { localeFromPath, localizePath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const to = (path: string) => {
  const p = localizePath(path, isEn ? "en" : "es");
  return p === "/" || p.endsWith("/") ? p : `${p}/`;
};
const projects = (await getCollection(isEn ? "projectes-en" : "projectes")).sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
const projectImages: Record<string, string> = {
  avisa: "/img/preview-avisa.webp",
  "pizzeria-xativa": "/img/foto_pizza.webp",
  "burger-xativa": "/img/foto_burger.webp",
  "dashboard-telemetria": "/img/preview-dashboard.webp",
  "pipeline-cicd": "/img/preview-pipeline.webp",
};
const shortTitle = (x: string) => x.split(" — ")[0];
const t = isEn
  ? {
      title: "Web projects and case studies | Jaume Tur",
      desc: "Websites, digital menus and web applications built by Jaume Tur in Xàtiva and Valencia. Open the live projects and see what was done in each one.",
      eyebrow: "Projects", h1: "Web projects and case studies you can open and try.",
      lead: "Websites, interactive demos and web applications. Demos with sample data are labelled as such. Each page explains what it is, my role and the technologies used.",
      view: "View case study", flagship: "Flagship", ctaTitle: "Your project could be next.", cta: "Get a quote", home: "Home",
    }
  : {
      title: "Proyectos y casos de estudio web | Jaume Tur",
      desc: "Páginas web, cartas digitales y aplicaciones web creadas por Jaume Tur en Xàtiva y Valencia. Abre los proyectos y mira qué se hizo en cada uno.",
      eyebrow: "Proyectos", h1: "Proyectos y casos de estudio web que puedes abrir y probar.",
      lead: "Páginas web, demos interactivas y aplicaciones web. Las demos con datos de ejemplo están indicadas como tales. Cada ficha explica qué es, mi papel y las tecnologías usadas.",
      view: "Ver caso de estudio", flagship: "Insignia", ctaTitle: "Tu proyecto puede ser el siguiente.", cta: "Pedir presupuesto", home: "Inicio",
    };
const list = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": t.eyebrow,
  "itemListElement": projects.map((p, i) => ({
    "@type": "ListItem", "position": i + 1, "name": p.data.title, "url": `https://jaumetur.es${to(`/projectes/${p.id}`)}`,
  })),
};
---

<Layout fresh title={t.title} description={t.desc} jsonLd={[list]}>
  <PageHeader title={t.h1} lede={t.lead} />

  <section class="section" aria-label={t.eyebrow}>
    <ul class="wrap grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-12">
      {projects.map((p, i) => (
        <li class:list={[i === 0 ? "sm:col-span-2 lg:col-span-12" : i % 3 === 1 ? "lg:col-span-7" : "lg:col-span-5"]}>
          <a href={to(`/projectes/${p.id}`)} class:list={["group grid h-full gap-6", i === 0 ? "lg:grid-cols-12 lg:items-center lg:gap-12" : ""]}>
            <div class:list={["overflow-hidden rounded-sm border border-white/15 bg-[#141412]", i === 0 ? "lg:col-span-7" : ""]}>
              {projectImages[p.id] ? (
                <img src={projectImages[p.id]} alt="" width="1200" height="750" loading={i < 2 ? "eager" : "lazy"} decoding="async" class="aspect-[16/10] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
              ) : (
                <div class="flex aspect-[16/10] w-full items-center justify-center bg-[#1c1c19] p-6"><span class="h-section text-center text-brand">{shortTitle(p.data.title)}</span></div>
              )}
            </div>
            <div class:list={["flex flex-col", i === 0 ? "lg:col-span-5" : ""]}>
              <p class="label flex flex-wrap items-center gap-3">
                {i === 0 && <span class="chip chip-brand !normal-case !tracking-normal">{t.flagship}</span>}
                <span>{p.data.badge}</span>
              </p>
              <h2 class:list={["mt-3 font-display font-bold leading-[1.02] group-hover:text-brand", i === 0 ? "text-[2.6rem] sm:text-[3.4rem]" : "text-[2rem] sm:text-[2.3rem]"]} style="font-stretch:80%">{shortTitle(p.data.title)}</h2>
              <p class="muted mt-3 max-w-xl leading-relaxed">{p.data.subtitle}</p>
              <p class="faint mt-3 text-[0.9rem]">{p.data.stack.slice(0, 4).join(" · ")}</p>
              <p class="link-arrow mt-4">{t.view} <span aria-hidden="true">→</span></p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <CtaBand
    title={t.ctaTitle}
    text={isEn ? "Got an idea, or need to update your business's online presence? Let's talk, no obligation." : "¿Tienes una idea o necesitas actualizar la presencia de tu negocio? Hablemos sin compromiso."}
    primary={{ href: to("/contact"), label: t.cta }}
    secondary={{ href: to("/pricing"), label: isEn ? "Services & pricing" : "Servicios y precios" }}
  />
</Layout>

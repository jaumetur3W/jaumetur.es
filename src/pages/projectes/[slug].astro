---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import CtaBand from "@/components/cta-band.astro";
import TraniaSavingsCalculator from "@/components/trania-savings-calculator.astro";
import ProjectMark from "@/components/project-mark.astro";
import { getBrand } from "@/data/project-brand";
import { getDeco } from "@/data/project-deco";
import { getStatus, statusLabel, statusNote } from "@/data/project-status";
import { localeFromPath, localizePath } from "@/i18n";

export async function getStaticPaths() {
  const allProjects = await getCollection("projectes");
  return allProjects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const isEn = localeFromPath(Astro.url.pathname) === "en";
const to = (path: string) => {
  const p = localizePath(path, isEn ? "en" : "es");
  return p === "/" || p.endsWith("/") ? p : `${p}/`;
};
const siteUrl = "https://jaumetur.es";

const allProjects = (isEn ? await getCollection("projectes-en") : await getCollection("projectes")).sort(
  (a, b) => (a.data.order || 99) - (b.data.order || 99),
);
const idx = allProjects.findIndex((p) => p.id === entry.id);
const prev = allProjects[(idx - 1 + allProjects.length) % allProjects.length];
const next = allProjects[(idx + 1) % allProjects.length];

const entryToRender = isEn ? (allProjects.find((p) => p.id === entry.id) ?? entry) : entry;
const { Content } = await render(entryToRender);
const d = entryToRender.data;

const projectImages: Record<string, string> = {
  avisa: "/img/preview-avisa.webp",
  trania: "/img/preview-trania.webp",
  worksy: "/img/preview-worksy.webp",
  "pizzeria-xativa": "/img/foto_pizza.webp",
  "burger-xativa": "/img/foto_burger.webp",
  "dashboard-telemetria": "/img/preview-dashboard.webp",
  "pipeline-cicd": "/img/preview-pipeline.webp",
};
const cover = projectImages[entry.id];
const brand = getBrand(entry.id);
const deco = getDeco(entry.id);
const num = (idx < 0 ? 0 : idx) + 1;
const status = getStatus(entry.id);
const shortTitle = (x: string) => x.split(" — ")[0];

const serviceFor =
  entry.id === "pizzeria-xativa" || entry.id === "burger-xativa"
    ? "/pricing/digitalitzacio-local"
    : entry.id === "dashboard-telemetria"
      ? "/pricing/performance-audit"
      : entry.id === "pipeline-cicd"
        ? "/pricing/cicd-devops"
        : entry.id === "forma-espacio" || entry.id === "fincarural"
          ? "/pricing/landing-page"
          : "/pricing/angular-webapp";

const t = isEn
  ? {
      home: "Home", projects: "Projects", client: "Client / context", year: "Year", role: "My role", verify: "How it was checked",
      live: "View live project", code: "Source code", stack: "Technologies", flagship: "Flagship project",
      ctaTitle: "Want something like this for your business?", ctaText: "See what the equivalent service includes and its price, or tell me about your project.",
      ctaA: "View service & pricing", ctaB: "Talk to Jaume", prev: "Previous project", next: "Next project", titleSuffix: "Case study",
    }
  : {
      home: "Inicio", projects: "Proyectos", client: "Cliente / contexto", year: "Año", role: "Mi papel", verify: "Cómo se ha comprobado",
      live: "Ver proyecto en línea", code: "Código fuente", stack: "Tecnologías", flagship: "Buque insignia",
      ctaTitle: "¿Quieres algo así para tu negocio?", ctaText: "Mira qué incluye el servicio equivalente y su precio, o cuéntame tu proyecto.",
      ctaA: "Ver servicio y precios", ctaB: "Hablar con Jaume", prev: "Proyecto anterior", next: "Proyecto siguiente", titleSuffix: "Caso de estudio",
    };

const schemaData = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": d.title,
  "description": d.subtitle,
  "author": { "@id": `${siteUrl}/#person` },
  "dateCreated": entry.data.year,
  "keywords": entry.data.stack.join(", "),
  "url": `${siteUrl}${to(`/projectes/${entry.id}`)}`,
  ...(entry.data.githubUrl ? { "codeRepository": entry.data.githubUrl } : {}),
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": t.home, "item": `${siteUrl}${to("/")}` },
    { "@type": "ListItem", "position": 2, "name": t.projects, "item": `${siteUrl}${to("/projectes")}` },
    { "@type": "ListItem", "position": 3, "name": d.title, "item": `${siteUrl}${to(`/projectes/${entry.id}`)}` },
  ],
};
---

<Layout fresh title={`${shortTitle(d.title)} — ${t.titleSuffix}`} description={d.subtitle} image={cover ?? "/opengraph.jpg"} jsonLd={[schemaData, breadcrumb]}>
 <div class="pj" data-pj={entry.id} style={`--pj-bg:${brand.bg};--pj-fg:${brand.fg};--pj-accent:${brand.accent};--pj-on:${brand.onAccent};--pj-r:${brand.radius};`}>
  <header class="pj-hero">
    <div class="pj-deco-wrap" aria-hidden="true" set:html={deco} />
    <div class="wrap relative z-[1]">
      <nav aria-label="Breadcrumb" class="pj-crumbs">
        <a href={to("/")}>{t.home}</a><span aria-hidden="true">/</span>
        <a href={to("/projectes")}>{t.projects}</a><span aria-hidden="true">/</span>
        <span aria-current="page">{shortTitle(d.title)}</span>
      </nav>
      <div class="pj-hero-grid mt-8 grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="pj-copy lg:col-span-7">
          <p class="pj-tags flex flex-wrap items-center gap-2">
            {entry.id === "avisa" && <span class="tag pj-tag-accent">{t.flagship}</span>}
            <span class={`pj-status pj-status-${status}`}>{status === "live" && <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse mr-1.5" aria-hidden="true"></span>}{statusLabel(entry.id, isEn)}</span>
            <span class="tag"><Icon name={entry.data.icon} class="h-4 w-4" />{d.badge}</span>
          </p>
          <h1 class="pj-title mt-5">{d.title}</h1>
          <p class="pj-lede mt-5">{d.subtitle}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            {entry.data.liveUrl && <a href={entry.data.liveUrl} target="_blank" rel="noopener noreferrer" class="btn pj-cta-main">{t.live} <span aria-hidden="true">↗</span><span class="sr-only"> ({isEn ? "opens in a new tab" : "se abre en pestaña nueva"})</span></a>}
            {entry.data.githubUrl && <a href={entry.data.githubUrl} target="_blank" rel="noopener noreferrer" class="btn pj-cta-alt">{t.code} <span aria-hidden="true">↗</span><span class="sr-only"> ({isEn ? "opens in a new tab" : "se abre en pestaña nueva"})</span></a>}
          </div>
        </div>
        <div class="pj-art lg:col-span-5">
          <div class="pj-folder">
            <span class="pj-folder-tab"><b>{String(num).padStart(2, "0")}</b> · {shortTitle(d.title)}</span>
            <div class="pj-folder-body">
              <ProjectMark id={entry.id} name={shortTitle(d.title)} eager />
            </div>
            <span class="note pj-folder-note" aria-hidden="true">{statusNote(entry.id, isEn)}</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <section class="pj-stat" data-stat={entry.id} aria-label={d.statLabel}>
    <div class="wrap pj-stat-row">
      <p class="label">{d.statLabel}</p>
      <p class="pj-stat-value">{d.statValue}</p>
    </div>
  </section>

  <section class="band-paper section">
    <div class="wrap grid gap-12 lg:grid-cols-12">
      <aside class="lg:col-span-4">
        <div class="pj-sticky">
          <dl class="pj-facts">
            <div><dt class="label">{t.client}</dt><dd>{d.client}</dd></div>
            <div><dt class="label">{t.year}</dt><dd>{entry.data.year}</dd></div>
            <div><dt class="label">{t.role}</dt><dd>{d.role}</dd></div>
            <div><dt class="label">{t.verify}</dt><dd class="muted">{d.verificationMethod}</dd></div>
          </dl>
          <p class="mt-6 label">{t.stack}</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {entry.data.stack.map((x) => <li class="chip">{x}</li>)}
          </ul>
        </div>
      </aside>

      <div class="lg:col-span-8 min-w-0">
        <div class="prose prose-lg max-w-none prose-headings:text-ink prose-p:text-[#2b2b28] prose-a:text-ink prose-strong:text-ink prose-li:text-[#2b2b28] prose-li:marker:text-ink">
          <Content />
        </div>
        {entry.id === "trania" && <TraniaSavingsCalculator isEn={isEn} />}
      </div>
    </div>
  </section>

  <CtaBand
    title={t.ctaTitle}
    text={t.ctaText}
    primary={{ href: to(serviceFor), label: t.ctaA }}
    secondary={{ href: to("/contact"), label: t.ctaB }}
  />

  <nav aria-label={t.projects} class="pj-pager">
    <div class="wrap grid sm:grid-cols-2">
      <a href={to(`/projectes/${prev.id}`)} class="pj-pager-link"><span class="label">← {t.prev}</span><span class="pj-pager-title">{shortTitle(prev.data.title)}</span></a>
      <a href={to(`/projectes/${next.id}`)} class="pj-pager-link sm:text-right"><span class="label">{t.next} →</span><span class="pj-pager-title">{shortTitle(next.data.title)}</span></a>
    </div>
  </nav>
 </div>
</Layout>

<style is:global>
  .pj-hero { position: relative; overflow: hidden; padding: 7.5rem 0 4.5rem; }
  .pj-crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 0.15rem 0.6rem; font-size: 0.9rem; }
  .pj-crumbs a { display: inline-flex; min-height: 2.75rem; align-items: center; color: inherit; text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .pj-crumbs a:hover { text-decoration-color: currentColor; }
  .pj-crumbs [aria-current] { font-family: var(--font-hand); font-weight: 700; font-size: 1.35rem; }

  .pj-status { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.18rem 0.7rem 0.18rem 0.55rem; border-radius: 999px; border: 1px solid var(--pj-fg); font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; line-height: 1.3; color: var(--pj-fg); }
  .pj-status::before { content: ""; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--pj-accent); }
  .pj-status-done::before { background: #2da44e; }
  .pj-status-demo { border-style: dashed; }
  .pj-title { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.9rem, 4.2vw, 3.3rem); line-height: 1.04; letter-spacing: -0.04em; text-wrap: balance; }
  .pj-lede { max-width: 38rem; font-size: clamp(1rem, 1.4vw, 1.15rem); line-height: 1.6; }
  .pj { --pj-ff: var(--font-display); --brand: var(--pj-accent); --on-brand: var(--pj-on); }
  .pj-hero { background: var(--pj-bg); color: var(--pj-fg); }
  .pj-deco-wrap { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .pj-deco { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pj-lede { color: color-mix(in srgb, var(--pj-fg) 90%, transparent); }
  .pj-hero a:not(.btn) { color: inherit; }
  .pj-stat .label { color: var(--pj-on); opacity: 0.8; }
  .pj-title, .pj-pager-title, .pj-stat-value { font-family: var(--pj-ff); }
  .pj-cta-main { --btn-bg: var(--pj-accent); --btn-fg: var(--pj-on); --btn-hover-bg: var(--pj-fg); --btn-hover-fg: var(--pj-bg); border-color: var(--pj-accent); border-radius: var(--pj-r); }
  .pj-cta-main:hover { border-color: var(--pj-fg); }
  .pj-cta-alt { --btn-bg: transparent; --btn-fg: var(--pj-fg); --btn-hover-bg: var(--pj-fg); --btn-hover-fg: var(--pj-bg); border-color: var(--pj-fg); border-radius: var(--pj-r); }
  .pj-hero .tag { background: var(--pj-accent); color: var(--pj-on); border-color: var(--pj-accent); }
  .pj-hero .tag.pj-tag-accent { background: transparent; color: var(--pj-fg); border-color: var(--pj-fg); }

  .pj-folder { position: relative; padding-top: 2.1rem; transform: none; transition: transform 300ms var(--ease-out); }
  .pj-folder:hover { transform: translateY(-3px); }
  .pj-folder-tab { position: absolute; left: 1rem; top: 0; display: inline-flex; align-items: center; gap: 0.35rem; height: 2.1rem; padding: 0 1rem; background: var(--pj-fg); color: var(--pj-bg); border: 1px solid var(--pj-fg); border-bottom: 0; border-radius: 0.6rem 0.6rem 0 0; font-family: var(--font-display); font-weight: 700; font-size: 0.8rem; letter-spacing: 0.02em; text-transform: uppercase; }
  .pj-folder-tab b { font-family: var(--font-mono); }
  .pj-folder-body { overflow: hidden; background: var(--paper); border: 1px solid var(--ink); border-radius: 0 var(--pj-r) var(--pj-r) var(--pj-r); border-color: var(--pj-fg); box-shadow: 6px 6px 0 var(--pj-accent); }
  
  .pj-folder-note { position: absolute; right: 0.5rem; bottom: -2rem; font-size: 1.4rem; color: color-mix(in srgb, var(--pj-accent) 55%, var(--pj-fg)); }
  .pj-crumbs [aria-current] { color: color-mix(in srgb, var(--pj-accent) 55%, var(--pj-fg)); }

  .pj-stat { padding: 1.75rem 0; background: var(--pj-accent); color: var(--pj-on); }
  .pj-stat-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 2rem; }
  .pj-stat-value { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.25rem, 2.6vw, 2rem); letter-spacing: -0.03em; color: var(--pj-on); text-wrap: balance; }

  .pj-sticky { position: sticky; top: 6rem; }
  .pj-facts { display: grid; border: 1px solid var(--ink); border-radius: var(--pj-r); background: #fff; box-shadow: 5px 5px 0 var(--pj-accent); overflow: hidden; }
  .pj-facts > div { padding: 1rem 1.15rem; border-top: 1px solid rgba(17, 17, 17, 0.15); }
  .pj-facts > div:first-child { border-top: 0; }
  .pj-facts dd { margin-top: 0.25rem; font-weight: 600; line-height: 1.35; }
  .pj-facts dd.muted { font-weight: 500; font-size: 0.92rem; }
  .pj .chip { background: #fff; }

  .pj .prose { --tw-prose-bullets: var(--pj-accent); --tw-prose-counters: var(--pj-accent); }
  .pj .prose :where(h2, h3, h4) { font-family: var(--pj-ff); }
  .pj .prose :where(h2) { margin-top: 3.5rem; padding-top: 1rem; border-top: 1px solid var(--ink); font-weight: 700; letter-spacing: -0.03em; }
  .pj .prose :where(h2):first-child { margin-top: 0; }
  .pj .prose :where(hr) { display: none; }
  .pj .prose :where(blockquote) { background: var(--pj-accent); border: 1px solid var(--ink); border-radius: var(--pj-r); box-shadow: 4px 4px 0 var(--ink); }
  .pj .prose :where(blockquote) * { color: var(--pj-on); }
  .pj .prose :where(code):not(:where(pre *)) { background: color-mix(in srgb, var(--pj-accent) 22%, #fff); color: var(--ink); }
  .pj .prose :where(pre) { border-radius: 0.5rem; border: 1px solid var(--ink); }
  .pj .prose :where(table) { display: block; overflow-x: auto; }
  .pj .prose figure { margin: 3rem 0; padding: 0.5rem; background: #fff; border: 1px solid var(--ink); border-radius: 0.5rem; box-shadow: 5px 5px 0 var(--ink); overflow: hidden; }
  .pj .prose figure img { display: block; width: 100%; height: auto; margin: 0; border-radius: 0.25rem; }
  .pj .prose figcaption { margin: 0.7rem 0 0.3rem; text-align: center; font-family: var(--font-hand); font-weight: 700; font-size: 1.2rem; color: var(--ink); opacity: 0.75; }

  .pj-pager { background: var(--pj-bg); color: var(--pj-fg); border-top: 1px solid color-mix(in srgb, var(--pj-fg) 35%, transparent); }
  .pj-pager .label { color: color-mix(in srgb, var(--pj-fg) 70%, transparent); }
  .pj-pager-link { display: block; padding: 2.25rem 0; min-height: 2.75rem; color: var(--pj-fg); text-decoration: none; }
  .pj-pager-title { display: block; margin-top: 0.4rem; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.4rem, 2.6vw, 2.1rem); letter-spacing: -0.03em; transition: color 200ms ease; }
  .pj-pager-link:hover .pj-pager-title, .pj-pager-link:focus-visible .pj-pager-title { color: var(--pj-accent); }

  .pj[data-pj='pizzeria-xativa'], .pj[data-pj='fincarural'] { --pj-ff: Georgia, 'Times New Roman', serif; }
  .pj[data-pj='dashboard-telemetria'], .pj[data-pj='pipeline-cicd'] { --pj-ff: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace; }
  .pj[data-pj='forma-espacio'] { --pj-ff: 'Helvetica Neue', Helvetica, Arial, sans-serif; }
  .pj[data-pj='forma-espacio'] .pj-title, .pj[data-pj='burger-xativa'] .pj-title { text-transform: uppercase; letter-spacing: -0.02em; }
  .pj[data-pj='pizzeria-xativa'] .pj-title, .pj[data-pj='fincarural'] .pj-title { letter-spacing: -0.01em; }


  /* ===== Personalidad por proyecto: composición, marco y forma propios ===== */
  .pj-folder-body .pj-mark { aspect-ratio: 4 / 3; }
  @media (min-width: 640px) { .pj-folder-body .pj-mark { aspect-ratio: 16 / 10; } }

  /* AVISA: marco en arco, como su logotipo; texto a la izquierda */
  .pj[data-pj='avisa'] .pj-folder { transform: none; }
  .pj[data-pj='avisa'] .pj-folder-tab { display: none; }
  .pj[data-pj='avisa'] .pj-folder { padding-top: 0; max-width: 24rem; margin-inline: auto; }
  .pj[data-pj='avisa'] .pj-folder-body { border-radius: 14rem 14rem var(--pj-r) var(--pj-r); box-shadow: none; border-color: color-mix(in srgb, var(--pj-fg) 30%, transparent); }
  .pj[data-pj='avisa'] .pj-folder-body .pj-mark { aspect-ratio: 3 / 4; }

  /* Pizzería: composición centrada con el sello redondo y titular serif */
  .pj[data-pj='pizzeria-xativa'] .pj-hero { padding-bottom: 7.5rem; }
  .pj[data-pj='pizzeria-xativa'] .pj-hero-grid { text-align: center; }
  .pj[data-pj='pizzeria-xativa'] .pj-copy, .pj[data-pj='pizzeria-xativa'] .pj-art { grid-column: 1 / -1; }
  .pj[data-pj='pizzeria-xativa'] .pj-art { order: -1; }
  .pj[data-pj='pizzeria-xativa'] .pj-copy > p, .pj[data-pj='pizzeria-xativa'] .pj-copy > div { justify-content: center; margin-inline: auto; }
  .pj[data-pj='pizzeria-xativa'] .pj-folder { transform: none; width: 15rem; margin-inline: auto; padding-top: 0; }
  .pj[data-pj='pizzeria-xativa'] .pj-folder-tab, .pj[data-pj='pizzeria-xativa'] .pj-folder-note { display: none; }
  .pj[data-pj='pizzeria-xativa'] .pj-folder-body { border-radius: 50%; border-width: 4px; box-shadow: 0 0 0 10px color-mix(in srgb, var(--pj-accent) 35%, transparent); }
  .pj[data-pj='pizzeria-xativa'] .pj-folder-body .pj-mark { aspect-ratio: 1 / 1; }
  .pj[data-pj='pizzeria-xativa'] .pj-lede { margin-inline: auto; }
  .pj[data-pj='pizzeria-xativa'] .pj-crumbs { justify-content: center; }

  /* Burger: titular enorme en mayúsculas y la tira diagonal cruzando */
  .pj[data-pj='burger-xativa'] .pj-hero { padding-bottom: 12rem; }
  .pj[data-pj='burger-xativa'] .pj-copy { grid-column: 1 / -1; }
  .pj[data-pj='burger-xativa'] .pj-title { font-size: clamp(2.4rem, 7.2vw, 6rem); line-height: 0.95; text-transform: uppercase; letter-spacing: -0.045em; max-width: 16ch; }
  .pj[data-pj='burger-xativa'] .pj-art { position: absolute; right: var(--gutter); top: 7rem; width: 13rem; transform: rotate(7deg); z-index: 2; grid-column: auto; }
  .pj[data-pj='burger-xativa'] .pj-folder { transform: none; padding-top: 0; }
  .pj[data-pj='burger-xativa'] .pj-folder-tab, .pj[data-pj='burger-xativa'] .pj-folder-note { display: none; }
  .pj[data-pj='burger-xativa'] .pj-folder-body { border-radius: 0.35rem; border-width: 3px; box-shadow: 5px 5px 0 var(--pj-accent); }
  @media (max-width: 1023px) { .pj[data-pj='burger-xativa'] .pj-art { position: static; width: 11rem; transform: rotate(-4deg); margin-top: 1rem; } }

  /* TranIA: marco a la izquierda y corte diagonal hacia la franja */
  .pj[data-pj='trania'] .pj-hero { clip-path: polygon(0 0, 100% 0, 100% 92%, 0 100%); padding-bottom: 6rem; margin-bottom: -1.5rem; }
  .pj[data-pj='trania'] .pj-stat { padding-top: 3rem; }
  @media (min-width: 1024px) { .pj[data-pj='trania'] .pj-art { order: -1; } .pj[data-pj='trania'] .pj-copy { grid-column: span 7 / span 7; } }
  .pj[data-pj='trania'] .pj-folder { transform: rotate(-4deg); }
  .pj[data-pj='trania'] .pj-title { font-weight: 800; letter-spacing: -0.05em; }

  /* Worksy: todo centrado, tarjeta flotante suave sobre luces difusas */
  .pj[data-pj='worksy'] .pj-hero-grid { text-align: center; }

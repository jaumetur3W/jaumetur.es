---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import CtaBand from "@/components/cta-band.astro";
import CaseStudyTemplate from "@/components/case-study-template.astro";
import { localeFromPath, localizePath } from "@/i18n";

export async function getStaticPaths() {
  const allProjects = await getCollection("projectes");
  return allProjects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const isEn = localeFromPath(Astro.url.pathname) === "en";
const to = (path: string) => {
  const p = localizePath(path, isEn ? "en" : "es");
  return p === "/" || p.endsWith("/") ? p : `${p}/`;
};
const siteUrl = "https://jaumetur.es";

const allProjects = (isEn ? await getCollection("projectes-en") : await getCollection("projectes")).sort(
  (a, b) => (a.data.order || 99) - (b.data.order || 99),
);
const idx = allProjects.findIndex((p) => p.id === entry.id);
const prev = allProjects[(idx - 1 + allProjects.length) % allProjects.length];
const next = allProjects[(idx + 1) % allProjects.length];

const entryToRender = isEn ? (allProjects.find((p) => p.id === entry.id) ?? entry) : entry;
const { Content } = await render(entryToRender);
const d = entryToRender.data;

const projectImages: Record<string, string> = {
  avisa: "/img/preview-avisa.webp",
  trania: "/img/preview-trania.webp",
  worksy: "/img/preview-worksy.webp",
  "pizzeria-xativa": "/img/foto_pizza.webp",
  "burger-xativa": "/img/foto_burger.webp",
  "dashboard-telemetria": "/img/preview-dashboard.webp",
  "pipeline-cicd": "/img/preview-pipeline.webp",
};
const cover = projectImages[entry.id];
const shortTitle = (x: string) => x.split(" — ")[0];

const serviceFor =
  entry.id === "pizzeria-xativa" || entry.id === "burger-xativa"
    ? "/pricing/digitalitzacio-local"
    : entry.id === "dashboard-telemetria"
      ? "/pricing/performance-audit"
      : entry.id === "pipeline-cicd"
        ? "/pricing/cicd-devops"
        : entry.id === "forma-espacio" || entry.id === "fincarural"
          ? "/pricing/landing-page"
          : "/pricing/angular-webapp";

const t = isEn
  ? {
      home: "Home", projects: "Projects", client: "Client / context", year: "Year", role: "My role", verify: "How it was checked",
      live: "View live project", code: "Source code", stack: "Technologies", flagship: "Flagship project",
      ctaTitle: "Want something like this for your business?", ctaText: "See what the equivalent service includes and its price, or tell me about your project.",
      ctaA: "View service & pricing", ctaB: "Talk to Jaume", prev: "Previous project", next: "Next project", titleSuffix: "Case study",
    }
  : {
      home: "Inicio", projects: "Proyectos", client: "Cliente / contexto", year: "Año", role: "Mi papel", verify: "Cómo se ha comprobado",
      live: "Ver proyecto en línea", code: "Código fuente", stack: "Tecnologías", flagship: "Buque insignia",
      ctaTitle: "¿Quieres algo así para tu negocio?", ctaText: "Mira qué incluye el servicio equivalente y su precio, o cuéntame tu proyecto.",
      ctaA: "Ver servicio y precios", ctaB: "Hablar con Jaume", prev: "Proyecto anterior", next: "Proyecto siguiente", titleSuffix: "Caso de estudio",
    };

const schemaData = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": d.title,
  "description": d.subtitle,
  "author": { "@id": `${siteUrl}/#person` },
  "dateCreated": entry.data.year,
  "keywords": entry.data.stack.join(", "),
  "url": `${siteUrl}${to(`/projectes/${entry.id}`)}`,
  ...(entry.data.githubUrl ? { "codeRepository": entry.data.githubUrl } : {}),
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": t.home, "item": `${siteUrl}${to("/")}` },
    { "@type": "ListItem", "position": 2, "name": t.projects, "item": `${siteUrl}${to("/projectes")}` },
    { "@type": "ListItem", "position": 3, "name": d.title, "item": `${siteUrl}${to(`/projectes/${entry.id}`)}` },
  ],
};
---

<Layout fresh title={`${shortTitle(d.title)} — ${t.titleSuffix}`} description={d.subtitle} image={cover ?? "/opengraph.jpg"} jsonLd={[schemaData, breadcrumb]}>
  <header class="border-b border-white/15 pb-12 pt-8 sm:pb-16">
    <div class="wrap">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-x-2 text-sm text-white/70">
        <a href={to("/")} class="inline-flex min-h-11 items-center underline decoration-transparent decoration-2 underline-offset-4 hover:text-white hover:decoration-brand">{t.home}</a><span aria-hidden="true">/</span>
        <a href={to("/projectes")} class="inline-flex min-h-11 items-center underline decoration-transparent decoration-2 underline-offset-4 hover:text-white hover:decoration-brand">{t.projects}</a><span aria-hidden="true">/</span>
        <span aria-current="page" class="text-white">{shortTitle(d.title)}</span>
      </nav>
      <div class="mt-6 grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
        <div class:list={[cover ? "lg:col-span-6" : "lg:col-span-12"]}>
          <p class="flex flex-wrap items-center gap-2">
            {entry.id === "avisa" && <span class="chip chip-brand">{t.flagship}</span>}
            <span class="chip"><Icon name={entry.data.icon} class="h-4 w-4 text-brand" />{d.badge}</span>
          </p>
          <h1 class="h-page mt-5 !text-[clamp(2.2rem,5.4vw,4.2rem)]">{d.title}</h1>
          <p class="lede mt-5">{d.subtitle}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            {entry.data.liveUrl && <a href={entry.data.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-brand">{t.live} <span aria-hidden="true">↗</span><span class="sr-only"> ({isEn ? "opens in a new tab" : "se abre en pestaña nueva"})</span></a>}
            {entry.data.githubUrl && <a href={entry.data.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-white">{t.code} <span aria-hidden="true">↗</span><span class="sr-only"> ({isEn ? "opens in a new tab" : "se abre en pestaña nueva"})</span></a>}
          </div>
        </div>
        {cover && (
          <div class="lg:col-span-6">
            <div class="overflow-hidden rounded-sm border border-white/15 bg-[#141412]">
              <img src={cover} alt={entry.data.image.alt} width="1200" height="750" class="aspect-[16/10] w-full object-cover" fetchpriority="high" decoding="async" />
            </div>
          </div>
        )}
      </div>
    </div>
  </header>

  <section class="section">
    <div class="wrap-narrow">
      <dl class="grid gap-x-8 gap-y-6 border-y border-white/20 py-7 sm:grid-cols-2">
        <div><dt class="label">{t.client}</dt><dd class="mt-1 font-semibold leading-snug">{d.client}</dd></div>
        <div><dt class="label">{t.year}</dt><dd class="mt-1 font-semibold">{entry.data.year}</dd></div>
        <div><dt class="label">{t.role}</dt><dd class="mt-1 font-semibold leading-snug">{d.role}</dd></div>
        <div><dt class="label">{t.verify}</dt><dd class="muted mt-1 text-[0.95rem] leading-snug">{d.verificationMethod}</dd></div>
      </dl>

      <p class="mt-7 flex flex-wrap items-center gap-2">
        <span class="label mr-1">{t.stack}</span>
        {entry.data.stack.map((x) => <span class="chip font-normal">{x}</span>)}
      </p>

      {(d as any).problem && (d as any).solution && (d as any).result && (
        <div class="mt-12 border-t border-white/20 pt-10">
          <CaseStudyTemplate
            problem={isEn ? (d as any).problem_en || (d as any).problem : (d as any).problem}
            solution={isEn ? (d as any).solution_en || (d as any).solution : (d as any).solution}
            result={isEn ? (d as any).result_en || (d as any).result : (d as any).result}
            technologies={entry.data.stack}
            year={parseInt(String(entry.data.year).split(' ')[0])}
          />
        </div>
      )}

      <div class="prose prose-lg prose-invert mt-12 max-w-none prose-headings:font-display prose-headings:text-white prose-p:text-[#d2d2cb] prose-a:text-brand prose-strong:text-white prose-li:text-[#d2d2cb] prose-li:marker:text-brand">
        <Content />
      </div>
    </div>
  </section>

  <CtaBand
    title={t.ctaTitle}
    text={t.ctaText}
    primary={{ href: to(serviceFor), label: t.ctaA }}
    secondary={{ href: to("/contact"), label: t.ctaB }}
  />

  <nav aria-label={t.projects} class="wrap grid gap-6 border-t border-white/15 py-10 sm:grid-cols-2">
    <a href={to(`/projectes/${prev.id}`)} class="group block min-h-11"><span class="label">← {t.prev}</span><span class="mt-1 block font-display text-[1.4rem] font-bold leading-tight group-hover:text-brand" style="font-stretch:84%">{shortTitle(prev.data.title)}</span></a>
    <a href={to(`/projectes/${next.id}`)} class="group block min-h-11 sm:text-right"><span class="label">{t.next} →</span><span class="mt-1 block font-display text-[1.4rem] font-bold leading-tight group-hover:text-brand" style="font-stretch:84%">{shortTitle(next.data.title)}</span></a>
  </nav>
</Layout>

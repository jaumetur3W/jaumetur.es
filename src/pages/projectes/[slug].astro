---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { Icon } from "astro-icon/components";
import { localeFromPath, localizePath } from "@/i18n";

export async function getStaticPaths() {
  const allProjects = await getCollection("projectes");
  return allProjects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const isEn = localeFromPath(Astro.url.pathname) === "en";
const href = (path: string) => localizePath(path, isEn ? "en" : "es");

const allProjects = isEn ? await getCollection("projectes-en") : await getCollection("projectes");
const currentIndex = allProjects.findIndex((p) => p.id === entry.id);
const prev = currentIndex > 0 ? allProjects[currentIndex - 1] : null;
const next = currentIndex < allProjects.length - 1 ? allProjects[currentIndex + 1] : null;

// Get English version of this project if we are on /en/
let entryToRender: any = entry;
if (isEn) {
  const enProjects = await getCollection("projectes-en");
  const matchingEn = enProjects.find((p) => p.id === entry.id);
  if (matchingEn) {
    entryToRender = matchingEn;
  }
}

const { Content } = await render(entryToRender);

const projectText = entryToRender.data;
const projectStack = entry.data.stack;

// JSON-LD Structured Data for SoftwareSourceCode / CreativeWork
const schemaData = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  "name": projectText.title,
  "description": projectText.subtitle,
  "programmingLanguage": projectStack,
  "author": {
    "@type": "Person",
    "name": "Jaume Tur",
    "url": "https://jaumetur.es"
  },
  "url": entry.data.liveUrl || `https://jaumetur.es${href(`/projectes/${entry.id}`)}`,
  ...(entry.data.githubUrl ? { "codeRepository": entry.data.githubUrl } : {}),
  "dateCreated": entry.data.year,
};

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://jaumetur.es";
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": isEn ? "Home" : "Inicio",
      "item": new URL(href("/"), siteUrl).toString(),
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": isEn ? "Projects" : "Proyectos",
      "item": new URL(href("/projectes"), siteUrl).toString(),
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": projectText.title,
      "item": new URL(Astro.url.pathname, siteUrl).toString(),
    },
  ],
};
---

<Layout
  title={`${projectText.title} — ${isEn ? "Case Study" : "Caso de estudio"}`}
  description={projectText.subtitle}
  image={entry.data.image.src}
>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <Container>
    <!-- Breadcrumbs -->
    <nav aria-label={isEn ? "Navigation path" : "Ruta de navegación"} class="pt-8 pb-4 text-xs font-mono text-slate-600 flex items-center gap-2 flex-wrap">
      <a href={href("/")} class="hover:text-slate-950 transition-colors">{isEn ? "Home" : "Inicio"}</a>
      <span>/</span>
      <a href={href("/projectes")} class="hover:text-slate-950 transition-colors">{isEn ? "Projects" : "Proyectos"}</a>
      <span>/</span>
      <span class="text-slate-950 font-medium">{projectText.title}</span>
    </nav>

    <!-- Case Study Hero -->
    <header class="max-w-4xl mx-auto mt-6 mb-12" style={`view-transition-name: project-card-${entry.id};`}>
      <div class="flex items-center gap-2.5 mb-4">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-semibold uppercase tracking-wider bg-[#FFFF00] text-slate-950 border border-slate-950/20">
          <Icon name={entry.data.icon} class="w-3.5 h-3.5 text-slate-950" />
          <span>{projectText.badge}</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium bg-slate-100 border border-slate-200 text-slate-800">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-950"></span>
          <span>{projectText.statValue}</span>
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-light text-slate-950 tracking-tight leading-tight mb-4">
        {projectText.title}
      </h1>

      <p class="text-base sm:text-lg text-slate-600 font-light leading-relaxed mb-8">
        {projectText.subtitle}
      </p>

      <!-- Project Metadata Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-6 rounded-3xl bg-white border border-slate-200/90 shadow-2xs text-xs font-mono mb-8">
        <div>
          <span class="text-slate-600 block uppercase tracking-wider text-[10px] font-semibold">{isEn ? "Client / context" : "Cliente / contexto"}</span>
          <span class="text-slate-950 font-normal mt-1 block">{projectText.client}</span>
        </div>
        <div>
          <span class="text-slate-600 block uppercase tracking-wider text-[10px] font-semibold">{isEn ? "Development year" : "Año de desarrollo"}</span>
          <span class="text-slate-950 font-normal mt-1 block">{entry.data.year}</span>
        </div>
        <div>
          <span class="text-slate-600 block uppercase tracking-wider text-[10px] font-semibold">{isEn ? "Engineering role" : "Rol de ingeniería"}</span>
          <span class="text-slate-950 font-normal mt-1 block">{projectText.role}</span>
        </div>
        <div>
          <span class="text-slate-600 block uppercase tracking-wider text-[10px] font-semibold">{isEn ? "Verification method" : "Método de verificación"}</span>
          <span class="text-slate-950 font-normal mt-1 block truncate" title={projectText.verificationMethod}>
            {projectText.verificationMethod.split('&')[0]}
          </span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-3">
        {entry.data.liveUrl && (
          <a
            href={entry.data.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-mono text-xs uppercase tracking-wider font-semibold bg-[#FFFF00] hover:bg-[#f2d900] text-slate-950 border border-slate-950 transition-colors shadow-xs"
          >
            <Icon name="bx:link-external" class="w-4 h-4 text-slate-950" />
            <span>{isEn ? "View live demo" : "Ver la demostración en línea"}</span>
            <span class="text-slate-950 text-[10px]">↗</span>
          </a>
        )}
        {entry.data.githubUrl && (
          <a
            href={entry.data.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-mono text-xs uppercase tracking-wider font-semibold bg-slate-950 hover:bg-[#FFFF00] text-white hover:text-slate-950 border border-slate-950 transition-colors shadow-xs"
          >
            <Icon name="bx:bxl-github" class="w-4 h-4 text-white group-hover:text-slate-950" />
            <span>{isEn ? "Source code on GitHub" : "Código fuente en GitHub"}</span>
            <span class="text-slate-400 text-[10px]">↗</span>
          </a>
        )}
      </div>
    </header>

    <!-- Browser Frame / Device Mockup Preview -->
    <div class="max-w-5xl mx-auto mb-16 rounded-3xl overflow-hidden border border-slate-200/90 bg-white shadow-md">
      <!-- Browser Top Bar -->
      <div class="px-5 py-3 bg-slate-100/80 border-b border-slate-200/80 flex items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-slate-300 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-slate-300 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-slate-300 inline-block"></span>
        </div>
        <div class="flex-1 max-w-md mx-auto bg-white px-4 py-1.5 rounded-lg border border-slate-200 text-[11px] font-mono text-slate-600 truncate flex items-center gap-2 shadow-2xs">
          <Icon name="bx:lock-alt" class="w-3 h-3 text-slate-950 shrink-0" />
          <span class="truncate">{entry.data.liveUrl || `https://jaumetur.es${href(`/projectes/${entry.id}`)}`}</span>
        </div>
        <div class="flex items-center gap-2 text-slate-600">
          <Icon name="bx:refresh" class="w-4 h-4" />
        </div>
      </div>

      <!-- Preview Image with Clean Backdrop -->
      <div class="relative bg-slate-50 p-2 sm:p-4">
        <img
          src={entry.data.image.src}
          alt={projectText.image.alt}
          class="w-full h-auto max-h-[500px] object-cover rounded-2xl shadow-sm border border-slate-200/70"
          loading="eager"
        />
      </div>
    </div>

    <!-- Tech Stack Pill Ribbon -->
    <div class="max-w-4xl mx-auto mb-14 p-5 rounded-3xl bg-white border border-slate-200/90 shadow-2xs flex flex-wrap items-center gap-2">
      <span class="text-xs font-mono text-slate-600 mr-2 flex items-center gap-1.5 font-semibold">
        <Icon name="bx:layer" class="w-3.5 h-3.5 text-slate-950" />
        <span>{isEn ? "Technologies:" : "Tecnologías:"}</span>
      </span>
      {projectStack.map((tech) => (
        <span class="text-xs font-mono px-3 py-1 rounded-xl bg-slate-100 border border-slate-200 text-slate-800">
          {tech}
        </span>
      ))}
    </div>

    <!-- Main Case Study Content (Prose) -->
    <div class="max-w-4xl mx-auto prose prose-slate max-w-none prose-headings:font-light prose-headings:tracking-tight prose-headings:text-slate-950 prose-a:text-slate-950 prose-a:underline prose-a:decoration-[#FFFF00] prose-a:decoration-2 prose-a:underline-offset-4 prose-pre:bg-slate-950 prose-pre:border prose-pre:border-slate-800 mb-16 font-light">
      <Content />
    </div>

    <!-- Related Service CTA Banner (Internal Linking) -->
    <div class="max-w-4xl mx-auto mb-16 p-6 sm:p-8 rounded-3xl bg-slate-950 text-white border-2 border-slate-950 shadow-xl flex flex-col md:flex-row items-center justify-between gap-6 selection:bg-[#FFFF00] selection:text-black">
      <div class="space-y-2 text-center md:text-left">
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-[#FFFF00]">
          {isEn ? "Equivalent professional service" : "Servicio profesional equivalente"}
        </span>
        <h3 class="text-xl sm:text-2xl font-light text-white tracking-tight">
          {isEn ? "Want to implement a solution like this for your business?" : "¿Quieres implementar una solución como esta en tu negocio?"}
        </h3>
        <p class="text-sm text-slate-300 max-w-xl font-light leading-relaxed">
          {isEn ? "Check package details, transparent pricing, and technical comparison before starting." : "Consulta los detalles del paquete, el precio transparente y la comparativa técnica antes de comenzar."}
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 shrink-0 w-full md:w-auto">
        <a
          href={href(
            entry.id === "pizzeria-xativa" || entry.id === "burger-xativa"
              ? "/pricing/digitalitzacio-local"
              : entry.id === "dashboard-telemetria"
              ? "/pricing/performance-audit"
              : entry.id === "pipeline-cicd"
              ? "/pricing/cicd-devops"
              : entry.id === "forma-espacio"
              ? "/pricing/landing-page"
              : "/pricing/angular-webapp"
          )}
          class="px-5 py-3 rounded-xl bg-[#FFFF00] hover:bg-[#f2d900] text-slate-950 font-mono text-xs uppercase tracking-wider font-semibold text-center border border-slate-950 transition-colors shadow-xs"
        >
          {isEn ? "View service & pricing" : "Ver servicio y precios"}
        </a>
        <a
          href={href("/contact")}
          class="px-5 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-mono text-xs uppercase tracking-wider font-semibold text-center border border-slate-800 transition-colors"
        >
          {isEn ? "Talk to Jaume" : "Hablar con Jaume"}
        </a>
      </div>
    </div>

    <!-- Honesty & Verification Card -->
    {entry.data.statLabel === "Mètrica Verificada" && (
    <div class="max-w-4xl mx-auto mb-16 p-6 sm:p-8 rounded-3xl bg-white border border-slate-200/90 shadow-2xs">
      <div class="flex items-center gap-2 mb-3">
        <Icon name="bx:check-shield" class="w-5 h-5 text-slate-950" />
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-600">
          {isEn ? "Technical honesty and verifiability protocol" : "Protocolo de honestidad técnica y verificabilidad"}
        </span>
      </div>
      <h3 class="text-xl font-light text-slate-950 tracking-tight mb-2">{isEn ? "How do we verify these metrics?" : "¿Cómo comprobamos estas métricas?"}</h3>
      <p class="text-sm text-slate-600 font-light leading-relaxed mb-5">
        {isEn ? "All metrics in this case study were validated with standard frontend engineering tools:" : "Todas las métricas de este caso de estudio se han validado con herramientas estándar de ingeniería frontend:"}
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-mono text-slate-700">
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200">
          <span class="text-slate-950 font-semibold block mb-1">Google Lighthouse</span>
          <span class="text-slate-600 font-normal">{isEn ? "Mobile profile with network throttling to audit LCP, CLS, and SEO." : "Perfil móvil con emulación de red para auditar LCP, CLS y SEO."}</span>
        </div>
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200">
          <span class="text-slate-950 font-semibold block mb-1">axe-core / DevTools</span>
          <span class="text-slate-600 font-normal">{isEn ? "DOM inspection to verify WCAG 2.2 AA accessibility compliance." : "Inspección del documento para verificar el cumplimiento de WCAG 2.2 AA."}</span>
        </div>
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200">
          <span class="text-slate-950 font-semibold block mb-1">Chrome Performance</span>
          <span class="text-slate-600 font-normal">{isEn ? "FPS Meter measurement and INP responsiveness latency." : "Medición de fotogramas por segundo (FPS Meter) y latencia INP."}</span>
        </div>
      </div>
    </div>
    )}

    <!-- Previous / Next Case Study Navigation -->
    <nav aria-label={isEn ? "Project navigation" : "Navegación entre proyectos"} class="max-w-4xl mx-auto pt-8 pb-16 border-t border-slate-200/90 grid grid-cols-1 sm:grid-cols-2 gap-4">
      {prev && (
        <a
          href={href(`/projectes/${prev.id}`)}
          class="group p-5 rounded-3xl bg-white border border-slate-200/90 hover:border-slate-950 transition-all duration-200 text-left flex flex-col justify-between shadow-2xs hover:shadow-md"
        >
          <span class="text-xs font-mono text-slate-600 font-semibold flex items-center gap-1 mb-2">
            <span>←</span>
            <span>{isEn ? "Previous project" : "Proyecto anterior"}</span>
          </span>
          <span class="text-base font-normal text-slate-950 group-hover:underline decoration-1 underline-offset-4 transition-colors flex items-center gap-2">
            <Icon name={prev.data.icon} class="w-4 h-4 text-slate-950" />
            <span>{prev.data.title}</span>
          </span>
        </a>
      )}

      {next && (
        <a
          href={href(`/projectes/${next.id}`)}
          class="group p-5 rounded-3xl bg-white border border-slate-200/90 hover:border-slate-950 transition-all duration-200 text-right flex flex-col justify-between sm:items-end shadow-2xs hover:shadow-md"
        >
          <span class="text-xs font-mono text-slate-600 font-semibold flex items-center justify-end gap-1 mb-2">
            <span>{isEn ? "Next project" : "Proyecto siguiente"}</span>
            <span>→</span>
          </span>
          <span class="text-base font-normal text-slate-950 group-hover:underline decoration-1 underline-offset-4 transition-colors flex items-center justify-end gap-2">
            <span>{next.data.title}</span>
            <Icon name={next.data.icon} class="w-4 h-4 text-slate-950" />
          </span>
        </a>
      )}
    </nav>
  </Container>
</Layout>

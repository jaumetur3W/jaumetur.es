---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
  const projectEntries = await getCollection("projectes");
  // Sort by order
  projectEntries.sort((a, b) => a.data.order - b.data.order);

  return projectEntries.map((entry, index) => {
    const prev = index > 0 ? projectEntries[index - 1] : projectEntries[projectEntries.length - 1];
    const next = index < projectEntries.length - 1 ? projectEntries[index + 1] : projectEntries[0];
    return {
      params: { slug: entry.id },
      props: { entry, prev, next },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

// SoftwareSourceCode / CreativeWork Schema
const schemaData = {
  "@context": "https://schema.org",
  "@type": entry.data.githubUrl ? "SoftwareSourceCode" : "CreativeWork",
  "name": entry.data.title,
  "description": entry.data.subtitle,
  "programmingLanguage": entry.data.stack,
  "author": {
    "@type": "Person",
    "name": "Jaume Tur",
    "url": "https://jaumetur.es"
  },
  "url": entry.data.liveUrl || `https://jaumetur.es/projectes/${entry.id}`,
  ...(entry.data.githubUrl ? { "codeRepository": entry.data.githubUrl } : {}),
  "dateCreated": entry.data.year,
};
---

<Layout
  title={`${entry.data.title} — Cas d'Estudi`}
  description={entry.data.subtitle}
  image={entry.data.image.src}
>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <Container>
    <!-- Breadcrumbs -->
    <nav aria-label="Ruta de navegació" class="pt-8 pb-4 text-xs font-mono text-gray-400 flex items-center gap-2 flex-wrap">
      <a href="/" class="hover:text-blue-400 transition-colors">Inici</a>
      <span>/</span>
      <a href="/#projectes" class="hover:text-blue-400 transition-colors">Projectes</a>
      <span>/</span>
      <span class="text-blue-400 font-semibold">{entry.data.title}</span>
    </nav>

    <!-- Case Study Hero -->
    <header class="max-w-4xl mx-auto mt-6 mb-12" style={`view-transition-name: project-card-${entry.id};`}>
      <div class="flex items-center gap-2.5 mb-4">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium bg-blue-950/60 border border-blue-500/30 text-blue-300">
          <Icon name={entry.data.icon} class="w-3.5 h-3.5 text-blue-400" />
          <span>{entry.data.badge}</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium bg-emerald-950/60 border border-emerald-500/30 text-emerald-300">
          <Icon name="bx:check-circle" class="w-3.5 h-3.5 text-emerald-400" />
          <span>{entry.data.statValue}</span>
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
        {entry.data.title}
      </h1>

      <p class="text-lg sm:text-xl text-slate-600 leading-relaxed mb-8">
        {entry.data.subtitle}
      </p>

      <!-- Project Metadata Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-5 rounded-3xl bg-white border border-slate-200/90 shadow-2xs text-xs font-mono mb-8">
        <div>
          <span class="text-slate-500 block uppercase tracking-wider text-[10px]">Client / Context</span>
          <span class="text-slate-900 font-bold mt-1 block">{entry.data.client}</span>
        </div>
        <div>
          <span class="text-slate-500 block uppercase tracking-wider text-[10px]">Any de Desenvolupament</span>
          <span class="text-slate-900 font-bold mt-1 block">{entry.data.year}</span>
        </div>
        <div>
          <span class="text-slate-500 block uppercase tracking-wider text-[10px]">Rol d'Enginyeria</span>
          <span class="text-slate-900 font-bold mt-1 block">{entry.data.role}</span>
        </div>
        <div>
          <span class="text-slate-500 block uppercase tracking-wider text-[10px]">Mètode de Verificació</span>
          <span class="text-emerald-700 font-bold mt-1 block truncate" title={entry.data.verificationMethod}>
            {entry.data.verificationMethod.split('&')[0]}
          </span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-3">
        {entry.data.liveUrl && (
          <a
            href={entry.data.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-xs bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm shadow-indigo-600/20 transition-all"
          >
            <Icon name="bx:link-external" class="w-4 h-4" />
            <span>Veure Demo en Línia</span>
            <span class="text-indigo-200 text-[10px]">↗</span>
          </a>
        )}
        {entry.data.githubUrl && (
          <a
            href={entry.data.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-xs bg-white hover:bg-slate-50 text-slate-800 border border-slate-200/90 shadow-2xs transition-all"
          >
            <Icon name="bx:bxl-github" class="w-4 h-4 text-slate-700" />
            <span>Codi Font a GitHub</span>
            <span class="text-slate-400 text-[10px]">↗</span>
          </a>
        )}
      </div>
    </header>

    <!-- Browser Frame / Device Mockup Preview -->
    <div class="max-w-5xl mx-auto mb-16 rounded-3xl overflow-hidden border border-slate-200/90 bg-white shadow-xl">
      <!-- Browser Top Bar -->
      <div class="px-5 py-3 bg-slate-100/80 border-b border-slate-200/80 flex items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-rose-400 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-amber-400 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-emerald-400 inline-block"></span>
        </div>
        <div class="flex-1 max-w-md mx-auto bg-white px-4 py-1.5 rounded-lg border border-slate-200 text-[11px] font-mono text-slate-600 truncate flex items-center gap-2 shadow-2xs">
          <Icon name="bx:lock-alt" class="w-3 h-3 text-emerald-600 shrink-0" />
          <span class="truncate">{entry.data.liveUrl || `https://jaumetur.es/projectes/${entry.id}`}</span>
        </div>
        <div class="flex items-center gap-2 text-slate-400">
          <Icon name="bx:refresh" class="w-4 h-4" />
        </div>
      </div>

      <!-- Preview Image with Clean Backdrop -->
      <div class="relative bg-slate-50 p-2 sm:p-4">
        <img
          src={entry.data.image.src}
          alt={entry.data.image.alt}
          class="w-full h-auto max-h-[500px] object-cover rounded-xl shadow-md border border-slate-200/70"
          loading="eager"
        />
      </div>
    </div>

    <!-- Tech Stack Pill Ribbon -->
    <div class="max-w-4xl mx-auto mb-14 p-5 rounded-3xl bg-white border border-slate-200/90 shadow-2xs flex flex-wrap items-center gap-2">
      <span class="text-xs font-mono text-slate-500 mr-2 flex items-center gap-1.5 font-bold">
        <Icon name="bx:layer" class="w-3.5 h-3.5 text-indigo-600" />
        <span>Stack d'Enginyeria:</span>
      </span>
      {entry.data.stack.map((tech) => (
        <span class="text-xs font-mono px-3 py-1 rounded-lg bg-slate-100 border border-slate-200 text-slate-700">
          {tech}
        </span>
      ))}
    </div>

    <!-- Main Case Study Content (Prose) -->
    <div class="max-w-4xl mx-auto prose prose-slate prose-indigo max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-slate-900 prose-a:text-indigo-600 prose-code:text-indigo-700 prose-pre:bg-slate-950 prose-pre:border prose-pre:border-slate-800 mb-16">
      <Content />
    </div>

    <!-- Honesty & Verification Card -->
    <div class="max-w-4xl mx-auto mb-16 p-6 sm:p-8 rounded-3xl bg-white border border-emerald-200 shadow-2xs">
      <div class="flex items-center gap-2 mb-3">
        <Icon name="bx:check-shield" class="w-5 h-5 text-emerald-600" />
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-700">
          Protocol d'Honestedat Tècnica & Verificabilitat
        </span>
      </div>
      <h3 class="text-lg font-bold text-slate-900 mb-2">Com comprovem aquestes mètriques?</h3>
      <p class="text-sm text-slate-600 leading-relaxed mb-4">
        Totes les mètriques d'aquest cas d'estudi han estat validades mitjançant eines estàndard d'enginyeria frontend:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-mono text-slate-700">
        <div class="p-4 rounded-2xl bg-emerald-50/50 border border-emerald-100">
          <span class="text-indigo-700 font-bold block mb-1">Google Lighthouse</span>
          <span class="text-slate-600">Perfil mòbil amb emulació de xarxa per a auditar LCP, CLS i SEO.</span>
        </div>
        <div class="p-4 rounded-2xl bg-emerald-50/50 border border-emerald-100">
          <span class="text-emerald-700 font-bold block mb-1">axe-core / DevTools</span>
          <span class="text-slate-600">Inspecció del document per a verificar compliment WCAG 2.2 AA.</span>
        </div>
        <div class="p-4 rounded-2xl bg-emerald-50/50 border border-emerald-100">
          <span class="text-purple-700 font-bold block mb-1">Chrome Performance</span>
          <span class="text-slate-600">Mesura de fotogrames per segon (FPS Meter) i latència INP.</span>
        </div>
      </div>
    </div>

    <!-- Previous / Next Case Study Navigation -->
    <nav aria-label="Navegació entre projectes" class="max-w-4xl mx-auto pt-8 pb-16 border-t border-slate-200/90 grid grid-cols-1 sm:grid-cols-2 gap-4">
      {prev && (
        <a
          href={`/projectes/${prev.id}`}
          class="group p-5 rounded-3xl bg-white border border-slate-200/90 hover:border-indigo-400 transition-all text-left flex flex-col justify-between shadow-2xs hover:shadow-md"
        >
          <span class="text-xs font-mono text-slate-500 flex items-center gap-1 mb-2">
            <span>←</span>
            <span>Projecte Anterior</span>
          </span>
          <span class="text-base font-bold text-slate-900 group-hover:text-indigo-600 transition-colors flex items-center gap-2">
            <Icon name={prev.data.icon} class="w-4 h-4 text-indigo-600" />
            <span>{prev.data.title}</span>
          </span>
        </a>
      )}

      {next && (
        <a
          href={`/projectes/${next.id}`}
          class="group p-5 rounded-3xl bg-white border border-slate-200/90 hover:border-indigo-400 transition-all text-right flex flex-col justify-between sm:items-end shadow-2xs hover:shadow-md"
        >
          <span class="text-xs font-mono text-slate-500 flex items-center justify-end gap-1 mb-2">
            <span>Següent Projecte</span>
            <span>→</span>
          </span>
          <span class="text-base font-bold text-slate-900 group-hover:text-indigo-600 transition-colors flex items-center justify-end gap-2">
            <span>{next.data.title}</span>
            <Icon name={next.data.icon} class="w-4 h-4 text-indigo-600" />
          </span>
        </a>
      )}
    </nav>
  </Container>
</Layout>


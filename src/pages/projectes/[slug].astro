---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import { localeFromPath, localizePath } from "@/i18n";

export async function getStaticPaths() {
  const allProjects = await getCollection("projectes");
  return allProjects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const isEn = localeFromPath(Astro.url.pathname) === "en";
const to = (path: string) => {
  const p = localizePath(path, isEn ? "en" : "es");
  return p === "/" || p.endsWith("/") ? p : `${p}/`;
};
const siteUrl = "https://jaumetur.es";

const allProjects = (isEn ? await getCollection("projectes-en") : await getCollection("projectes")).sort(
  (a, b) => (a.data.order || 99) - (b.data.order || 99),
);
const idx = allProjects.findIndex((p) => p.id === entry.id);
const prev = allProjects[(idx - 1 + allProjects.length) % allProjects.length];
const next = allProjects[(idx + 1) % allProjects.length];

const entryToRender = isEn ? (allProjects.find((p) => p.id === entry.id) ?? entry) : entry;
const { Content } = await render(entryToRender);
const d = entryToRender.data;

const projectImages: Record<string, string> = {
  avisa: "/img/preview-avisa.webp",
  "pizzeria-xativa": "/img/foto_pizza.webp",
  "burger-xativa": "/img/foto_burger.webp",
  "dashboard-telemetria": "/img/preview-dashboard.webp",
  "pipeline-cicd": "/img/preview-pipeline.webp",
};
const cover = projectImages[entry.id];
const shortTitle = (x: string) => x.split(" — ")[0];

const serviceFor =
  entry.id === "pizzeria-xativa" || entry.id === "burger-xativa"
    ? "/pricing/digitalitzacio-local"
    : entry.id === "dashboard-telemetria"
      ? "/pricing/performance-audit"
      : entry.id === "pipeline-cicd"
        ? "/pricing/cicd-devops"
        : entry.id === "forma-espacio" || entry.id === "fincarural"
          ? "/pricing/landing-page"
          : "/pricing/angular-webapp";

const t = isEn
  ? {
      home: "Home", projects: "Projects", client: "Client / context", year: "Year", role: "My role", verify: "How it was checked",
      live: "View live project", code: "Source code", stack: "Technologies", flagship: "Flagship project",
      ctaTitle: "Want something like this for your business?", ctaText: "See what the equivalent service includes and its price, or tell me about your project.",
      ctaA: "View service & pricing", ctaB: "Talk to Jaume", prev: "Previous project", next: "Next project", titleSuffix: "Case study",
    }
  : {
      home: "Inicio", projects: "Proyectos", client: "Cliente / contexto", year: "Año", role: "Mi papel", verify: "Cómo se ha comprobado",
      live: "Ver proyecto en línea", code: "Código fuente", stack: "Tecnologías", flagship: "Buque insignia",
      ctaTitle: "¿Quieres algo así para tu negocio?", ctaText: "Mira qué incluye el servicio equivalente y su precio, o cuéntame tu proyecto.",
      ctaA: "Ver servicio y precios", ctaB: "Hablar con Jaume", prev: "Proyecto anterior", next: "Proyecto siguiente", titleSuffix: "Caso de estudio",
    };

const schemaData = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": d.title,
  "description": d.subtitle,
  "author": { "@id": `${siteUrl}/#person` },
  "dateCreated": entry.data.year,
  "keywords": entry.data.stack.join(", "),
  "url": `${siteUrl}${to(`/projectes/${entry.id}`)}`,
  ...(entry.data.githubUrl ? { "codeRepository": entry.data.githubUrl } : {}),
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": t.home, "item": `${siteUrl}${to("/")}` },
    { "@type": "ListItem", "position": 2, "name": t.projects, "item": `${siteUrl}${to("/projectes")}` },
    { "@type": "ListItem", "position": 3, "name": d.title, "item": `${siteUrl}${to(`/projectes/${entry.id}`)}` },
  ],
};
---

<Layout fresh title={`${shortTitle(d.title)} — ${t.titleSuffix}`} description={d.subtitle} image={cover ?? "/opengraph.jpg"} jsonLd={[schemaData, breadcrumb]}>
  <section class="border-b border-white/10 bg-gradient-to-b from-[#111118] to-[#070709] px-4 pb-14 pt-10 sm:px-6">
    <div class="mx-auto max-w-(--breakpoint-xl)">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 font-mono text-xs text-white/50">
        <a href={to("/")} class="hover:text-brand transition-colors">{t.home}</a><span aria-hidden="true">/</span>
        <a href={to("/projectes")} class="hover:text-brand transition-colors">{t.projects}</a><span aria-hidden="true">/</span>
        <span aria-current="page" class="text-brand">{shortTitle(d.title)}</span>
      </nav>
      <div class="mt-8 grid items-center gap-10 lg:grid-cols-12">
        <div class:list={[cover ? "lg:col-span-6" : "lg:col-span-12"]}>
          <div class="flex flex-wrap gap-2">
            {entry.id === "avisa" && <span class="rounded-full bg-brand px-3 py-0.5 text-xs font-bold text-black"><Icon name="bx:star" class="h-3.5 w-3.5 inline mr-1" />{t.flagship}</span>}
            <span class="rounded-full border border-white/15 bg-white/5 px-3 py-0.5 text-[0.72rem] font-semibold text-white/80"><Icon name={entry.data.icon} class="h-3.5 w-3.5 inline mr-1 text-brand" />{d.badge}</span>
          </div>
          <h1 class="display mt-5 text-[clamp(2.1rem,5vw,4rem)] text-white">{d.title}</h1>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink/80">{d.subtitle}</p>
          <div class="mt-8 flex flex-wrap gap-4">
            {entry.data.liveUrl && <a href={entry.data.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-brand">{t.live} <span aria-hidden="true">↗</span></a>}
            {entry.data.githubUrl && <a href={entry.data.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-white">{t.code} <span aria-hidden="true">↗</span></a>}
          </div>
        </div>
        {cover && (
          <div class="lg:col-span-6">
            <div class="card overflow-hidden border border-white/10 bg-[#14141a]">
              <img src={cover} alt={entry.data.image.alt} width="1200" height="675" class="aspect-[16/10] w-full object-cover" fetchpriority="high" decoding="async" />
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="px-4 py-14 sm:px-6 sm:py-20">
    <div class="mx-auto max-w-4xl">
      <dl class="card grid gap-5 border border-white/10 bg-surface p-6 sm:grid-cols-2 lg:grid-cols-4">
        <div><dt class="font-mono text-[0.7rem] font-bold uppercase tracking-wider text-brand">{t.client}</dt><dd class="mt-1 font-semibold text-white leading-snug">{d.client}</dd></div>
        <div><dt class="font-mono text-[0.7rem] font-bold uppercase tracking-wider text-brand">{t.year}</dt><dd class="mt-1 font-semibold text-white">{entry.data.year}</dd></div>
        <div><dt class="font-mono text-[0.7rem] font-bold uppercase tracking-wider text-brand">{t.role}</dt><dd class="mt-1 font-semibold text-white leading-snug">{d.role}</dd></div>
        <div><dt class="font-mono text-[0.7rem] font-bold uppercase tracking-wider text-brand">{t.verify}</dt><dd class="mt-1 text-sm text-ink/80 leading-snug">{d.verificationMethod}</dd></div>
      </dl>

      <div class="mt-8 flex flex-wrap items-center gap-2">
        <span class="mr-1 font-mono text-xs font-bold uppercase tracking-wider text-brand">{t.stack}</span>
        {entry.data.stack.map((x) => <span class="rounded-md border border-white/10 bg-white/5 px-2.5 py-1 font-mono text-xs text-white/70">{x}</span>)}
      </div>

      <div class="prose prose-lg mt-12 max-w-none text-ink/80 prose-headings:text-white prose-a:text-brand prose-strong:text-white prose-li:marker:text-brand">
        <Content />
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-[#09090d] px-4 py-16 text-white sm:px-6 sm:py-20">
    <div class="mx-auto flex max-w-4xl flex-col items-start gap-8 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="display text-[clamp(1.8rem,4vw,2.75rem)] text-white">{t.ctaTitle}</h2>
        <p class="mt-3 max-w-lg text-ink/80">{t.ctaText}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={to(serviceFor)} class="btn btn-brand">{t.ctaA}</a>
        <a href={to("/contact")} class="btn btn-white">{t.ctaB}</a>
      </div>
    </div>
  </section>

  <nav aria-label={t.projects} class="mx-auto grid max-w-4xl gap-4 px-4 py-14 sm:grid-cols-2 sm:px-6">
    <a href={to(`/projectes/${prev.id}`)} class="card border border-white/10 bg-surface p-5 hover:border-brand/50 transition-colors"><span class="font-mono text-xs font-bold uppercase text-brand">← {t.prev}</span><span class="mt-1 block font-display text-base font-bold text-white leading-snug">{shortTitle(prev.data.title)}</span></a>
    <a href={to(`/projectes/${next.id}`)} class="card border border-white/10 bg-surface p-5 sm:text-right hover:border-brand/50 transition-colors"><span class="font-mono text-xs font-bold uppercase text-brand">{t.next} →</span><span class="mt-1 block font-display text-base font-bold text-white leading-snug">{shortTitle(next.data.title)}</span></a>
  </nav>
</Layout>

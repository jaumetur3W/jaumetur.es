---
import Container from "@/components/container.astro";
import Layout from "@/layouts/Layout.astro";
import EmojiIcon from "@/components/ui/emoji-icon.astro";
---

<Layout title="404 — Pàgina no trobada">
  <Container>
    <div class="min-h-[calc(100vh-18rem)] flex items-center justify-center py-16">
      <div class="text-center max-w-md mx-auto group">
        <!-- Memoji 6.png with contact shadow -->
        <div class="w-32 h-32 mx-auto rounded-full bg-white p-2 border border-slate-200/90 shadow-md mb-6 flex items-center justify-center group-hover:scale-105 transition-transform">
          <img
            src="/memojis/6.png"
            alt="Jaume picant l'ullet"
            class="w-full h-full object-contain drop-shadow-[0_8px_16px_rgba(15,23,42,0.18)]"
            width="128"
            height="128"
          />
        </div>
        
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-indigo-700 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-200/80 inline-flex items-center gap-1.5">
          <EmojiIcon symbol="🔍" decorative={true} />
          <span>Error 404</span>
        </span>
        
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 mt-4">
          Pàgina no trobada
        </h1>
        
        <p class="text-base mt-3 text-slate-600 leading-relaxed">
          Sembla que l'enllaç que busques no està disponible o ha canviat d'ubicació.
        </p>
        
        <div class="mt-8 flex justify-center gap-3">
          <a
            href="/"
            class="group/btn inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs hover:bg-indigo-600 transition shadow-xs">
            <EmojiIcon symbol="🏠" class="group-hover/btn:-translate-y-0.5 transition-transform" decorative={true} />
            <span>Tornar a l'inici</span>
          </a>
          <a
            href="/contact"
            class="group/c inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-200/90 font-bold text-xs text-slate-700 bg-white hover:bg-slate-50 transition shadow-2xs">
            <EmojiIcon symbol="💬" class="group-hover/c:scale-110 transition-transform" decorative={true} />
            <span>Contactar</span>
          </a>
        </div>
      </div>
    </div>
  </Container>
</Layout>

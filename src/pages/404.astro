---
import Container from "@/components/container.astro";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { localeFromPath, localizePath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const homePath = localizePath("/", isEn ? "en" : "es");
const contactPath = localizePath("/contact", isEn ? "en" : "es");
---

<Layout title={isEn ? "404 — Page Not Found | Jaume Tur" : "404 — Página no encontrada | Jaume Tur"}>
  <Container>
    <div class="min-h-[calc(100vh-18rem)] flex items-center justify-center py-20">
      <div class="text-center max-w-md mx-auto group">
        <div class="w-32 h-32 mx-auto rounded-full bg-white p-2 border border-slate-200/90 shadow-md mb-6 flex items-center justify-center group-hover:scale-105 transition-transform">
          <img
            src="/img/404.webp"
            alt={isEn ? "Jaume Tur looking puzzled for the page" : "Jaume Tur buscando la página, desconcertado"}
            class="w-full h-full object-contain drop-shadow-[0_8px_16px_rgba(15,23,42,0.18)]"
            width="128"
            height="128"
            loading="lazy"
            decoding="async"
          />
        </div>
        
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-950 bg-[#FFFF00] px-3.5 py-1 rounded-full border border-slate-950/20 inline-flex items-center gap-1.5">
          <Icon name="bx:error-circle" class="w-3.5 h-3.5 text-slate-950" />
          <span>Error 404</span>
        </span>
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-light tracking-tight text-slate-950 mt-5">
          {isEn ? "Page Not Found" : "Página no encontrada"}
        </h1>
        
        <p class="text-sm sm:text-base mt-3 text-slate-600 font-light leading-relaxed">
          {isEn
            ? "It seems the link you are looking for is unavailable or has moved."
            : "Parece que el enlace que buscas no está disponible o ha cambiado de ubicación."}
        </p>
        
        <div class="mt-8 flex justify-center gap-3">
          <a
            href={homePath}
            class="group/btn inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-slate-950 text-white font-mono text-xs uppercase tracking-wider font-semibold hover:bg-[#FFFF00] hover:text-slate-950 border border-slate-950 transition-colors shadow-xs">
            <Icon name="bx:home" class="w-4 h-4 text-white group-hover/btn:text-slate-950 transition-colors" />
            <span>{isEn ? "Back to home" : "Volver al inicio"}</span>
          </a>
          <a
            href={contactPath}
            class="inline-flex items-center gap-1.5 px-5 py-3 rounded-xl border border-slate-200 bg-white font-mono text-xs uppercase tracking-wider font-semibold text-slate-800 hover:border-slate-950 hover:text-slate-950 transition-colors">
            <span>{isEn ? "Contact" : "Contacto"}</span>
          </a>
        </div>
      </div>
    </div>
  </Container>
</Layout>

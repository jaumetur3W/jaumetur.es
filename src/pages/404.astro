---
import Container from "@/components/container.astro";
import Layout from "@/layouts/Layout.astro";
import Link from "@/components/ui/link.astro";
---

<Layout title="404 — Pàgina no trobada">
  <Container>
    <div class="min-h-[calc(100vh-18rem)] flex items-center justify-center py-16">
      <div class="text-center max-w-md mx-auto">
        <div class="w-32 h-32 mx-auto rounded-full bg-slate-100 p-2 border border-slate-200 mb-6 flex items-center justify-center">
          <img
            src="/memojis/6.png"
            alt="Jaume picant l'ullet"
            class="w-full h-full object-contain"
            width="128"
            height="128"
          />
        </div>
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-200">
          Error 404
        </span>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 mt-4">
          Pàgina no trobada
        </h1>
        <p class="text-base mt-3 text-slate-600 leading-relaxed">
          Sembla que l'enllaç que busques no està disponible o ha canviat d'ubicació.
        </p>
        <div class="mt-8 flex justify-center gap-3">
          <Link href="/" size="md" style="primary">
            Tornar a l'inici
          </Link>
          <Link href="/contact" size="md" style="outline">
            Contactar
          </Link>
        </div>
      </div>
    </div>
  </Container>
</Layout>

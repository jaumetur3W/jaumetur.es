---
import Container from "@/components/container.astro";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { localeFromPath, localizePath } from "@/i18n";

const isVal = localeFromPath(Astro.url.pathname) === "val";
const homePath = localizePath(isVal ? "/val/" : "/", isVal ? "val" : "es");
const contactPath = localizePath("/contact", isVal ? "val" : "es");
---

<Layout title={isVal ? "404 — Pàgina no trobada" : "404 — Página no encontrada"}>
  <Container>
    <div class="min-h-[calc(100vh-18rem)] flex items-center justify-center py-16">
      <div class="text-center max-w-md mx-auto group">
        <!-- Memoji 6.png with contact shadow -->
        <div class="w-32 h-32 mx-auto rounded-full bg-white p-2 border border-slate-200/90 shadow-md mb-6 flex items-center justify-center group-hover:scale-105 transition-transform">
          <img
            src="/img/404.webp"
            alt={isVal ? "Jaume Tur cercant la pàgina desconcertat" : "Jaume Tur buscando la página, desconcertado"}
            class="w-full h-full object-contain drop-shadow-[0_8px_16px_rgba(15,23,42,0.18)]"
            width="128"
            height="128"
            loading="lazy"
            decoding="async"
          />
        </div>
        
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-indigo-700 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-200/80 inline-flex items-center gap-1.5">
          <Icon name="bx:error-circle" class="w-3.5 h-3.5 text-indigo-700" />
          <span>Error 404</span>
        </span>
        
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 mt-4">
          {isVal ? "Pàgina no trobada" : "Página no encontrada"}
        </h1>
        
        <p class="text-base mt-3 text-slate-600 leading-relaxed">
          {isVal ? "Sembla que l'enllaç que busques no està disponible o ha canviat d'ubicació." : "Parece que el enlace que buscas no está disponible o ha cambiado de ubicación."}
        </p>
        
        <div class="mt-8 flex justify-center gap-3">
          <a
            href={homePath}
            class="group/btn inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs hover:bg-indigo-600 transition shadow-xs">
            <Icon name="bx:home" class="w-4 h-4 text-white group-hover/btn:-translate-y-0.5 transition-transform" />
            <span>{isVal ? "Tornar a l'inici" : "Volver al inicio"}</span>
          </a>
          <a
            href={contactPath}
            class="group/c inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-200/90 font-bold text-xs text-slate-700 bg-white hover:bg-slate-50 transition shadow-2xs">
            <Icon name="bx:message-square-dots" class="w-4 h-4 text-slate-700 group-hover/c:scale-110 transition-transform" />
            <span>{isVal ? "Contactar" : "Contactar"}</span>
          </a>
        </div>
      </div>
    </div>
  </Container>
</Layout>

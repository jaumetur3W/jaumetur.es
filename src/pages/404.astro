---
import Layout from "@/layouts/Layout.astro";
import { localeFromPath, localizePath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const loc = isEn ? "en" : "es";
const to = (p: string) => {
  const x = localizePath(p, loc);
  return x === "/" || x.endsWith("/") ? x : `${x}/`;
};
---

<Layout fresh title={isEn ? "404 — Page not found" : "404 — Página no encontrada"}>
  <section class="flex min-h-[75vh] items-center px-4 py-20 sm:px-6 relative overflow-hidden">
    <div class="pointer-events-none absolute left-1/2 top-1/2 h-[22rem] w-[46rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/15 blur-[120px]" aria-hidden="true"></div>
    <div class="mx-auto max-w-2xl text-center relative">
      <img src="/img/404.webp" alt="" width="160" height="160" class="mx-auto h-36 w-36 object-contain" decoding="async" />
      <p class="eyebrow mt-6">Error 404</p>
      <h1 class="display mt-3 text-[clamp(2.5rem,8vw,4.5rem)] text-white">{isEn ? "This page doesn't exist." : "Esta página no existe."}</h1>
      <p class="mt-4 text-base text-ink/80">{isEn ? "It may have moved. Let's get you back on track." : "Puede que se haya movido o que la dirección sea incorrecta."}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href={to("/")} class="btn btn-brand">{isEn ? "Back to home" : "Volver al inicio"}</a>
        <a href={to("/pricing")} class="btn btn-white">{isEn ? "Services & pricing" : "Servicios y precios"}</a>
        <a href={to("/contact")} class="btn btn-white">{isEn ? "Contact" : "Contacto"}</a>
      </div>
    </div>
  </section>
</Layout>

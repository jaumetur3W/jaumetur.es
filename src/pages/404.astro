---
import Layout from "@/layouts/Layout.astro";
import { localeFromPath, localizePath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const loc = isEn ? "en" : "es";
const to = (p: string) => {
  const x = localizePath(p, loc);
  return x === "/" || x.endsWith("/") ? x : `${x}/`;
};
---

<Layout fresh title={isEn ? "404 — Page not found" : "404 — Página no encontrada"}>
  <section class="flex min-h-[70vh] items-center bg-brand px-4 py-20 sm:px-5">
    <div class="mx-auto max-w-2xl text-center">
      <img src="/img/404.webp" alt="" width="160" height="160" class="mx-auto h-40 w-40 object-contain" decoding="async" />
      <p class="eyebrow mt-4">Error 404</p>
      <h1 class="display mt-3 text-[clamp(2.5rem,8vw,5rem)]">{isEn ? "This page doesn't exist." : "Esta página no existe."}</h1>
      <p class="mt-5 text-lg">{isEn ? "It may have moved. Let's get you back on track." : "Puede que se haya movido. Volvamos al camino."}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href={to("/")} class="btn btn-ink">{isEn ? "Back to home" : "Volver al inicio"}</a>
        <a href={to("/pricing")} class="btn btn-white">{isEn ? "Services & pricing" : "Servicios y precios"}</a>
        <a href={to("/contact")} class="btn btn-white">{isEn ? "Contact" : "Contacto"}</a>
      </div>
    </div>
  </section>
</Layout>

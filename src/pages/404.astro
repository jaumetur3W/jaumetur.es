---
import Layout from "@/layouts/Layout.astro";
import { localeFromPath, localizePath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const loc = isEn ? "en" : "es";
const to = (p: string) => {
  const x = localizePath(p, loc);
  return x === "/" || x.endsWith("/") ? x : `${x}/`;
};
---

<Layout fresh title={isEn ? "404 — Page not found" : "404 — Página no encontrada"}>
  <section class="flex min-h-[70vh] items-center py-16">
    <div class="wrap">
      <p class="num font-display text-[clamp(6rem,24vw,16rem)] font-extrabold leading-[0.85] text-ink" aria-hidden="true">404</p>
      <h1 class="h-section mt-4 max-w-2xl">{isEn ? "This page does not exist." : "Esta página no existe."}</h1>
      <p class="lede mt-4">{isEn ? "It may have moved, or the address is wrong. Pick up from here:" : "Puede que se haya movido o que la dirección sea incorrecta. Sigue desde aquí:"}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={to("/")} class="btn btn-brand">{isEn ? "Back to home" : "Volver al inicio"}</a>
        <a href={to("/pricing")} class="btn btn-white">{isEn ? "Services & pricing" : "Servicios y precios"}</a>
        <a href={to("/contact")} class="btn btn-white">{isEn ? "Contact" : "Contacto"}</a>
      </div>
    </div>
  </section>
</Layout>

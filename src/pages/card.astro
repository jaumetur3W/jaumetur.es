---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { Icon } from "astro-icon/components";
import { localeFromPath, localizePath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const homePath = localizePath("/", isEn ? "en" : "es");
---

<Layout
  title={isEn ? "Digital Business Card | Jaume Tur" : "Tarjeta digital de visita | Jaume Tur"}
  description={isEn ? "Digital contact card of Jaume Tur, web developer. Scan QR code or download vCard on your phone." : "Tarjeta de contacto digital de Jaume Tur, desarrollador web. Escanea el código QR o descarga la vCard en tu móvil."}>
  <Container>
    <div class="min-h-[calc(100vh-14rem)] flex items-center justify-center py-12 px-4">
      
      <!-- Targeta Digital Central (Format Wallet / Tech Pass) -->
      <div class="w-full max-w-sm rounded-[2.5rem] bg-[#141414] border border-white/15 shadow-[0_16px_48px_rgba(15,23,42,0.08)] hover:border-white/40 transition-all duration-200 overflow-hidden relative group">
        
        <!-- Fons de la Capçalera -->
        <div class="h-32 bg-[#0a0a0a] relative p-6 flex justify-between items-start border-b border-slate-900">
          <div class="flex items-center gap-2.5">
            <img src="/img/jt.LOGO-02-128.webp" alt="Logo JT" class="w-10 h-10 rounded-sm shadow-sm object-cover ring-2 ring-[#FFFF00]/60" width="40" height="40" loading="eager" />
            <span class="text-white text-xs font-mono font-semibold tracking-wider uppercase">{isEn ? "Professional Credential" : "Tarjeta profesional"}</span>
          </div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-mono font-semibold bg-[#FFFF00] text-[#0a0a0a] border border-white/20">
            <span class="w-1.5 h-1.5 rounded-full bg-[#0a0a0a]"></span>
            <span>{isEn ? "AVAILABLE" : "DISPONIBLE"}</span>
          </span>
        </div>

        <!-- Cos Principal de la Targeta -->
        <div class="px-6 pb-8 pt-0 relative">
          
          <!-- Avatar Flotant amb Memoji 3.webp -->
          <div class="flex justify-between items-end -mt-14 mb-5">
            <div class="relative">
              <div class="w-24 h-24 rounded-sm bg-[#141414] p-1.5 shadow-lg border-2 border-white overflow-hidden flex items-center justify-center">
                <img
                  src="/img/jaume-tur-contacto.webp"
                  alt="Jaume Tur"
                  class="w-full h-full object-contain"
                  width="96"
                  height="96"
                  loading="eager"
                />
              </div>
            </div>
            
            <!-- Botó vCard Principal -->
            <a
              href="/jaume-tur.vcf"
              download="jaume-tur.vcf"
              id="card-download-vcf"
              class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-sm bg-[#0a0a0a] hover:bg-[#FFFF00] text-white hover:text-black font-mono text-xs font-semibold border border-white/40 transition-colors shadow-xs group/btn cursor-pointer">
              <Icon name="bx:user-plus" class="w-4 h-4 text-[#FFFF00] group-hover/btn:text-black transition-colors" />
              <span>{isEn ? "Save Contact" : "Guardar contacto"}</span>
            </a>
          </div>

          <!-- Informació Professional -->
          <div class="mb-6">
            <h1 class="text-2xl font-light text-white tracking-tight">Jaume Tur</h1>
            <p class="text-xs font-mono text-[#a3a39b] mt-1">Backend &amp; Web Apps · Systems SMX</p>
            <p class="text-xs text-[#d4d4d4] font-light mt-2 leading-relaxed flex items-center gap-1.5">
              <Icon name="bx:map-pin" class="w-3.5 h-3.5 text-[#d4d4d4] shrink-0" />
              <span>{isEn ? "Valencia, Spain (100% remote)" : "Xàtiva / Valencia (100% en línea)"}</span>
            </p>
          </div>

          <!-- Píndoles de Stack Tècnic -->
          <div class="flex flex-wrap gap-1.5 mb-6 text-[11px] font-mono">
            <span class="px-2.5 py-1 rounded-lg bg-[#1c1c1c] text-white border border-white/15">Backend APIs</span>
            <span class="px-2.5 py-1 rounded-lg bg-[#1c1c1c] text-white border border-white/15">Linux SMX</span>
            <span class="px-2.5 py-1 rounded-lg bg-[#1c1c1c] text-white border border-white/15">Node.js</span>
            <span class="px-2.5 py-1 rounded-lg bg-[#FFFF00]/30 text-[#0a0a0a] border border-white/20 font-semibold">CFGS DAW</span>
          </div>

          <!-- Canals Directes de Comunicació -->
          <div class="space-y-2.5 mb-6 text-xs">
            <!-- Correu -->
            <a
              href={`mailto:jaumetur3w@gmail.com?subject=${encodeURIComponent(isEn ? "Digital Card - Contact" : "Tarjeta Digital - Contacto")}`}
              class="p-3.5 rounded-sm bg-[#1c1c1c] hover:bg-[#FFFF00]/20 border border-white/15 hover:border-white/40 text-white font-medium flex items-center justify-between transition-all group/mail">
              <div class="flex items-center gap-2.5 truncate">
                <Icon name="bx:envelope" class="w-4 h-4 text-white shrink-0" />
                <span class="truncate font-mono">jaumetur3w@gmail.com</span>
              </div>
              <span class="text-[#d4d4d4] group-hover/mail:text-white font-semibold" aria-hidden="true">→</span>
            </a>

            <!-- Web Portfolio -->
            <a
              href={homePath}
              class="p-3.5 rounded-sm bg-[#1c1c1c] hover:bg-[#1c1c1c] border border-white/15 hover:border-white/40 text-white font-medium flex items-center justify-between transition-all">
              <div class="flex items-center gap-2.5">
                <Icon name="bx:globe" class="w-4 h-4 text-white" />
                <span>jaumetur.es ({isEn ? "full portfolio" : "portfolio completo"})</span>
              </div>
              <span class="text-[#d4d4d4] font-semibold" aria-hidden="true">→</span>
            </a>
          </div>

          <!-- Xarxes Professionals Reals (Prioritat Tècnica: GitHub & LinkedIn) -->
          <div class="grid grid-cols-2 gap-2.5 mb-6">
            <a
              href="https://github.com/jaumetur3W"
              target="_blank"
              rel="noopener noreferrer"
              class="p-2.5 rounded-sm border border-white/15 bg-[#141414] hover:border-white/40 flex items-center justify-center gap-2 font-mono text-xs font-semibold text-white hover:bg-[#1c1c1c] transition-colors shadow-2xs">
              <Icon name="bx:bxl-github" class="w-4 h-4 text-white" />
              <span>GitHub</span>
            </a>
            <a
              href="https://www.linkedin.com/in/jautur/"
              target="_blank"
              rel="noopener noreferrer"
              class="p-2.5 rounded-sm border border-white/15 bg-[#141414] hover:border-white/40 flex items-center justify-center gap-2 font-mono text-xs font-semibold text-white hover:bg-[#1c1c1c] transition-colors shadow-2xs">
              <Icon name="bx:bxl-linkedin" class="w-4 h-4 text-white" />
              <span>LinkedIn</span>
            </a>
          </div>

          <!-- Codi QR de la Targeta -->
          <div class="p-5 rounded-sm bg-[#1c1c1c] border border-slate-200/80 text-center">
            <span class="text-[10px] font-mono uppercase tracking-wider font-semibold text-[#d4d4d4] block mb-2.5">
              {isEn ? "Scan to open on your phone" : "Escanea para abrir en el teléfono"}
            </span>
            <div class="w-32 h-32 mx-auto bg-[#141414] p-2.5 rounded-sm border border-white/15 shadow-2xs flex items-center justify-center">
              <img src="/qr-jaumetur.svg" alt="QR Code to https://jaumetur.es/" class="w-full h-full" width="128" height="128" />
            </div>
            <span class="text-xs font-mono text-[#d4d4d4] font-semibold mt-2.5 block">
              jaumetur.es
            </span>
          </div>

        </div>
      </div>

    </div>
  </Container>
</Layout>

<script is:inline>
  const vcfBtn = document.getElementById("card-download-vcf");
  if (vcfBtn) {
    vcfBtn.addEventListener("click", () => {
      if (typeof window.plausible === "function") {
        window.plausible("vcard_download", { props: { location: "digital_card" } });
      }
    });
  }
</script>


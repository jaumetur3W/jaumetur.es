---
import UiIcon from "@/components/ui-icon.astro";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { Icon } from "astro-icon/components";
import { localeFromPath, localizePath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const homePath = localizePath("/", isEn ? "en" : "es");
---

<Layout
  title={isEn ? "Digital Business Card | Jaume Tur" : "Tarjeta digital de visita | Jaume Tur"}
  description={isEn ? "Digital contact card of Jaume Tur, web developer. Scan QR code or download vCard on your phone." : "Tarjeta de contacto digital de Jaume Tur, desarrollador web. Escanea el código QR o descarga la vCard en tu móvil."}>
  <Container>
    <div class="min-h-[calc(100vh-14rem)] flex items-center justify-center py-12 px-4">
      
      <!-- Targeta Digital Central (Format Wallet / Tech Pass) -->
      <div class="w-full max-w-sm  bg-paper-2 border border-rule shadow-[0_16px_48px_rgba(15,23,42,0.08)] hover:border-rule transition-all duration-200 overflow-hidden relative group">
        
        <!-- Fons de la Capçalera -->
        <div class="h-32 bg-paper relative p-6 flex justify-between items-start border-b border-slate-900">
          <div class="flex items-center gap-2.5">
            <img src="/img/jt.LOGO-02-128.webp" alt="Logo JT" class="w-10 h-10   object-cover ring-2 ring-[var(--brand)]/60" width="40" height="40" loading="eager" />
            <span class="text-ink text-xs font-mono font-semibold tracking-wider ">{isEn ? "Professional Credential" : "Tarjeta profesional"}</span>
          </div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1  text-[10px] font-mono font-semibold bg-brand text-ink border border-rule">
            <span class="w-1.5 h-1.5  bg-paper"></span>
            <span>{isEn ? "Available" : "Disponible"}</span>
          </span>
        </div>

        <!-- Cos Principal de la Targeta -->
        <div class="px-6 pb-8 pt-0 relative">
          
          <!-- Avatar Flotant amb Memoji 3.webp -->
          <div class="flex justify-between items-end -mt-14 mb-5">
            <div class="relative">
              <div class="w-24 h-24  bg-paper-2 p-1.5  border-2 border-white overflow-hidden flex items-center justify-center">
                <img
                  src="/img/jaume-tur-contacto.webp"
                  alt="Jaume Tur"
                  class="w-full h-full object-contain"
                  width="96"
                  height="96"
                  loading="eager"
                />
              </div>
            </div>
            
            <!-- Botó vCard Principal -->
            <a
              href="/jaume-tur.vcf"
              download="jaume-tur.vcf"
              id="card-download-vcf"
              class="inline-flex items-center gap-1.5 px-4 py-2.5  bg-paper hover:bg-brand text-ink hover:text-ink font-mono text-xs font-semibold border border-rule transition-colors  group/btn cursor-pointer">
              <Icon name="bx:user-plus" class="w-4 h-4 text-ink group-hover/btn:text-ink transition-colors" />
              <span>{isEn ? "Save Contact" : "Guardar contacto"}</span>
            </a>
          </div>

          <!-- Informació Professional -->
          <div class="mb-6">
            <h1 class="font-display text-2xl font-extrabold tracking-[-0.04em]">Jaume Tur</h1>
            <p class="text-xs font-mono text-graphite mt-1">Backend &amp; Web Apps · Systems SMX</p>
            <p class="text-xs text-graphite font-normal mt-2 leading-relaxed flex items-center gap-1.5">
              <Icon name="bx:map-pin" class="w-3.5 h-3.5 text-graphite shrink-0" />
              <span>{isEn ? "Valencia, Spain (100% remote)" : "Xàtiva / Valencia (100% en línea)"}</span>
            </p>
          </div>

          <!-- Píndoles de Stack Tècnic -->
          <div class="flex flex-wrap gap-1.5 mb-6 text-[11px] font-mono">
            <span class="px-2.5 py-1  bg-paper-2 text-ink border border-rule">Backend APIs</span>
            <span class="px-2.5 py-1  bg-paper-2 text-ink border border-rule">Linux SMX</span>
            <span class="px-2.5 py-1  bg-paper-2 text-ink border border-rule">Node.js</span>
            <span class="px-2.5 py-1  bg-brand/30 text-ink border border-rule font-semibold">CFGS DAW</span>
          </div>

          <!-- Canals Directes de Comunicació -->
          <div class="space-y-2.5 mb-6 text-xs">
            <!-- Correu -->
            <a
              href={`mailto:jaumetur3w@gmail.com?subject=${encodeURIComponent(isEn ? "Digital Card - Contact" : "Tarjeta Digital - Contacto")}`}
              class="p-3.5  bg-paper-2 hover:bg-brand/20 border border-rule hover:border-rule text-ink font-medium flex items-center justify-between transition-all group/mail">
              <div class="flex items-center gap-2.5 truncate">
                <Icon name="bx:envelope" class="w-4 h-4 text-ink shrink-0" />
                <span class="truncate font-mono">jaumetur3w@gmail.com</span>
              </div>
              <UiIcon name="arrow" class="text-graphite group-hover/mail:text-ink font-semibold" aria-hidden="true" />
            </a>

            <!-- Web Portfolio -->
            <a
              href={homePath}
              class="p-3.5  bg-paper-2 hover:bg-paper-2 border border-rule hover:border-rule text-ink font-medium flex items-center justify-between transition-all">
              <div class="flex items-center gap-2.5">
                <Icon name="bx:globe" class="w-4 h-4 text-ink" />
                <span>jaumetur.es ({isEn ? "full portfolio" : "portfolio completo"})</span>
              </div>
              <UiIcon name="arrow" class="text-graphite font-semibold" aria-hidden="true" />
            </a>
          </div>

          <!-- Xarxes Professionals Reals (Prioritat Tècnica: GitHub & LinkedIn) -->
          <div class="grid grid-cols-2 gap-2.5 mb-6">
            <a
              href="https://github.com/jaumetur3W"
              target="_blank"
              rel="noopener noreferrer"
              class="p-2.5  border border-rule bg-paper-2 hover:border-rule flex items-center justify-center gap-2 font-mono text-xs font-semibold text-ink hover:bg-paper-2 transition-colors ">
              <Icon name="bx:bxl-github" class="w-4 h-4 text-ink" />
              <span>GitHub</span>
            </a>
            <a
              href="https://www.linkedin.com/in/jautur/"
              target="_blank"
              rel="noopener noreferrer"
              class="p-2.5  border border-rule bg-paper-2 hover:border-rule flex items-center justify-center gap-2 font-mono text-xs font-semibold text-ink hover:bg-paper-2 transition-colors ">
              <Icon name="bx:bxl-linkedin" class="w-4 h-4 text-ink" />
              <span>LinkedIn</span>
            </a>
          </div>

          <!-- Codi QR de la Targeta -->
          <div class="p-5  bg-paper-2 border border-rule text-center">
            <span class="text-[10px] font-mono  tracking-wider font-semibold text-graphite block mb-2.5">
              {isEn ? "Scan to open on your phone" : "Escanea para abrir en el teléfono"}
            </span>
            <div class="w-32 h-32 mx-auto bg-paper-2 p-2.5  border border-rule  flex items-center justify-center">
              <img src="/qr-jaumetur.svg" alt="QR Code to https://jaumetur.es/" class="w-full h-full" width="128" height="128" />
            </div>
            <span class="text-xs font-mono text-graphite font-semibold mt-2.5 block">
              jaumetur.es
            </span>
          </div>

        </div>
      </div>

    </div>
  </Container>
</Layout>

<script is:inline>
  const vcfBtn = document.getElementById("card-download-vcf");
  if (vcfBtn) {
    vcfBtn.addEventListener("click", () => {
      if (typeof window.plausible === "function") {
        window.plausible("vcard_download", { props: { location: "digital_card" } });
      }
    });
  }
</script>


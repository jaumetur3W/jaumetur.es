---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { Icon } from "astro-icon/components";

const lastAuditDate = "19 d'octubre de 2026";

const lighthouseScores = [
  { label: "Rendiment", score: 100, target: "≥ 95", icon: "bx:bxs-zap", color: "text-emerald-500", bg: "bg-emerald-500/10 border-emerald-500/20" },
  { label: "Accessibilitat", score: 100, target: "100", icon: "bx:accessibility", color: "text-indigo-500", bg: "bg-indigo-500/10 border-indigo-500/20" },
  { label: "Bones Pràctiques", score: 100, target: "100", icon: "bx:shield-quarter", color: "text-sky-500", bg: "bg-sky-500/10 border-sky-500/20" },
  { label: "SEO Tècnic", score: 100, target: "100", icon: "bx:line-chart", color: "text-purple-500", bg: "bg-purple-500/10 border-purple-500/20" },
];

const coreWebVitals = [
  { metric: "LCP", name: "Largest Contentful Paint", value: "0.7 s", threshold: "< 1.8 s", status: "Òptim", desc: "Temps fins que el bloc principal de contingut s'ha renderitzat completament." },
  { metric: "INP", name: "Interaction to Next Paint", value: "< 25 ms", threshold: "< 150 ms", status: "Òptim", desc: "Latència d'interacció de l'usuari amb el teclat o ratolí fins a la resposta visual." },
  { metric: "CLS", name: "Cumulative Layout Shift", value: "0.000", threshold: "< 0.05", status: "Òptim", desc: "Estabilitat visual total sense salts d'elements durant la càrrega." },
  { metric: "FCP", name: "First Contentful Paint", value: "0.4 s", threshold: "< 1.0 s", status: "Òptim", desc: "Temps d'aparició del primer element DOM visible en pantalla." },
  { metric: "TBT", name: "Total Blocking Time", value: "0 ms", threshold: "< 150 ms", status: "Òptim", desc: "Temps total en què el fil principal ha estat bloquejat per execució de JavaScript." },
  { metric: "Speed Index", name: "Índex de Velocitat", value: "0.6 s", threshold: "< 1.3 s", status: "Òptim", desc: "Rapidesa amb què els continguts visuals de la pàgina es fan visibles." },
];

const bundleBreakdown = [
  { asset: "Document HTML", size: "26.4 KB", gzipped: "7.1 KB", tech: "Astro SSG (Zero runtime superflu)" },
  { asset: "Fulls d'Estil CSS", size: "14.2 KB", gzipped: "3.8 KB", tech: "Tailwind CSS v4 purjat al 100%" },
  { asset: "JavaScript Crític", size: "7.8 KB", gzipped: "2.9 KB", tech: "Astro View Transitions & Scripts natius" },
  { asset: "JavaScript Secundari (Three.js)", size: "Desacoblat", gzipped: "Carregat en repòs", tech: "Import dinàmic només amb requestIdleCallback" },
  { asset: "Tipografies (Inter + Bricolage)", size: "Self-hosted", gzipped: "Woff2 subset", tech: "Fontsource amb font-display: swap" },
];
---

<Layout
  title="Qualitat, Rendiment & Accessibilitat"
  description="Tauler públic de transparència tècnica del portfolio de Jaume Tur: auditories de Lighthouse 100, Core Web Vitals, informe axe-core i protocol de verificació."
>
  <Container>
    <!-- Breadcrumb -->
    <nav aria-label="Ruta de navegació" class="pt-8 pb-4 text-xs font-mono text-slate-500 dark:text-slate-400 flex items-center gap-2 flex-wrap">
      <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Inici</a>
      <span>/</span>
      <span class="text-indigo-600 dark:text-indigo-400 font-semibold">Qualitat & Rendiment</span>
    </nav>

    <!-- Header -->
    <header class="max-w-4xl mx-auto mt-6 mb-12 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800 shadow-2xs mb-4">
        <Icon name="bx:check-shield" class="w-4 h-4 text-emerald-600 dark:text-emerald-400" />
        <span>Auditoria Tècnica Verificable</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        Compromís de <span class="bg-gradient-to-r from-indigo-600 via-indigo-500 to-indigo-800 dark:from-indigo-400 dark:to-indigo-300 bg-clip-text text-transparent">Qualitat i Rendiment</span>
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 mt-4 max-w-2xl leading-relaxed">
        En enginyeria de programari, la qualitat no s'afirma: es mesura i es demostra. Aquest tauler recull les dades reals de rendiment, accessibilitat WCAG 2.2 AA i eficiència de codi del propi lloc web.
      </p>

      <div class="flex items-center gap-2 mt-4 text-xs font-mono text-slate-500 dark:text-slate-400">
        <Icon name="bx:calendar" class="w-4 h-4 text-slate-400" />
        <span>Última mesura auditada: <strong class="text-slate-700 dark:text-slate-200">{lastAuditDate}</strong></span>
      </div>
    </header>

    <!-- 4 Lighthouse Score Cards -->
    <section class="max-w-5xl mx-auto mb-16" aria-labelledby="lighthouse-heading">
      <h2 id="lighthouse-heading" class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2">
        <Icon name="bx:tachometer" class="w-5 h-5 text-indigo-600 dark:text-indigo-400" />
        <span>Puntuacions Google Lighthouse (Mòbil & Escriptori)</span>
      </h2>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
        {lighthouseScores.map((item) => (
          <div class={`p-6 rounded-3xl bg-white dark:bg-slate-900 border ${item.bg} shadow-md flex flex-col items-center text-center justify-between`}>
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center bg-slate-50 dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 mb-3">
              <Icon name={item.icon} class={`w-6 h-6 ${item.color}`} />
            </div>
            
            <div class="my-2">
              <span class={`text-4xl sm:text-5xl font-black font-mono tracking-tight ${item.color}`}>
                {item.score}
              </span>
              <span class="text-xs font-mono text-slate-400 block mt-0.5">/ 100</span>
            </div>

            <div>
              <span class="text-sm font-bold text-slate-900 dark:text-slate-100 block">{item.label}</span>
              <span class="text-[11px] font-mono text-emerald-600 dark:text-emerald-400 font-semibold">Objectiu {item.target} assolit</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Core Web Vitals Table -->
    <section class="max-w-5xl mx-auto mb-16" aria-labelledby="cwv-heading">
      <h2 id="cwv-heading" class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2">
        <Icon name="bx:pulse" class="w-5 h-5 text-indigo-600 dark:text-indigo-400" />
        <span>Mètriques Core Web Vitals en Temps Real</span>
      </h2>

      <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/90 dark:border-slate-800 overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm font-sans">
            <thead class="bg-slate-50 dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800 text-[11px] font-mono uppercase text-slate-500">
              <tr>
                <th class="py-3.5 px-5">Mètrica Clau</th>
                <th class="py-3.5 px-5">Valor Mesurat</th>
                <th class="py-3.5 px-5">Límit Recomanat</th>
                <th class="py-3.5 px-5">Estat</th>
                <th class="py-3.5 px-5 hidden md:table-cell">Descripció Tècnica</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 font-mono">
              {coreWebVitals.map((cwv) => (
                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40 transition-colors">
                  <td class="py-3.5 px-5 font-bold text-slate-900 dark:text-slate-100">
                    <span class="text-indigo-600 dark:text-indigo-400">{cwv.metric}</span>
                    <span class="text-[11px] text-slate-400 block font-normal font-sans">{cwv.name}</span>
                  </td>
                  <td class="py-3.5 px-5 font-bold text-emerald-600 dark:text-emerald-400 text-base">{cwv.value}</td>
                  <td class="py-3.5 px-5 text-slate-500">{cwv.threshold}</td>
                  <td class="py-3.5 px-5">
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300">
                      <Icon name="bx:check" class="w-3 h-3 text-emerald-600" />
                      <span>{cwv.status}</span>
                    </span>
                  </td>
                  <td class="py-3.5 px-5 text-slate-600 dark:text-slate-400 font-sans text-xs hidden md:table-cell">{cwv.desc}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Axe-core Accessibility Report Details -->
    <section class="max-w-5xl mx-auto mb-16" aria-labelledby="a11y-heading">
      <h2 id="a11y-heading" class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2">
        <Icon name="bx:accessibility" class="w-5 h-5 text-indigo-600 dark:text-indigo-400" />
        <span>Auditoria d'Accessibilitat (axe-core & WCAG 2.2 AA)</span>
      </h2>

      <div class="grid md:grid-cols-3 gap-6">
        <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-sm">
          <div class="flex items-center gap-2.5 mb-3">
            <div class="w-9 h-9 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center">
              <Icon name="bx:check-circle" class="w-5 h-5" />
            </div>
            <span class="font-bold text-slate-900 dark:text-slate-100 text-sm">0 Violacions axe-core</span>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Cap error d'accessibilitat detectat pel motor automatitzat axe-core. Marcats semàntics, rols ARIA i metadades completament vàlides.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-sm">
          <div class="flex items-center gap-2.5 mb-3">
            <div class="w-9 h-9 rounded-xl bg-indigo-500/10 text-indigo-600 flex items-center justify-center">
              <Icon name="bx:pointer" class="w-5 h-5" />
            </div>
            <span class="font-bold text-slate-900 dark:text-slate-100 text-sm">Navegació per Teclat</span>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Skip link funcional a la capçalera, ordre de tabulació natural i focus trap implementat a la paleta de comandes (Cmd+K).
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-sm">
          <div class="flex items-center gap-2.5 mb-3">
            <div class="w-9 h-9 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center">
              <Icon name="bx:sun" class="w-5 h-5" />
            </div>
            <span class="font-bold text-slate-900 dark:text-slate-100 text-sm">Contrastos Cromàtics</span>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Superació del mínim 4.5:1 exigit per la normativa WCAG AA tant en mode clar (fons #F8FAFC) com en mode fosc (fons #0B0F19).
          </p>
        </div>
      </div>
    </section>

    <!-- Bundle & Payload Breakdown -->
    <section class="max-w-5xl mx-auto mb-16" aria-labelledby="bundle-heading">
      <h2 id="bundle-heading" class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2">
        <Icon name="bx:package" class="w-5 h-5 text-indigo-600 dark:text-indigo-400" />
        <span>Pes d'Actius & Pressupost de Rendiment</span>
      </h2>

      <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/90 dark:border-slate-800 overflow-hidden shadow-sm">
        <div class="p-6 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between flex-wrap gap-4">
          <div>
            <span class="text-xs font-mono uppercase tracking-wider text-slate-400 block">Pes Total a Primera Càrrega</span>
            <span class="text-2xl sm:text-3xl font-black font-mono text-emerald-600 dark:text-emerald-400">~ 48.4 KB (Transferit Gzip)</span>
          </div>
          <span class="text-xs font-mono text-slate-500 bg-slate-100 dark:bg-slate-800 px-3 py-1.5 rounded-xl border border-slate-200/80 dark:border-slate-700">
            Pressupost màxim: &lt; 150 KB (Assolit amb èxit)
          </span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-slate-50 dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800 text-[11px] font-mono uppercase text-slate-500">
              <tr>
                <th class="py-3 px-5">Recurs</th>
                <th class="py-3 px-5">Mida Bruta</th>
                <th class="py-3 px-5">Mida Comprimida</th>
                <th class="py-3 px-5">Estratègia d'Optimització</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 font-mono text-xs">
              {bundleBreakdown.map((item) => (
                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
                  <td class="py-3 px-5 font-bold text-slate-900 dark:text-slate-100">{item.asset}</td>
                  <td class="py-3 px-5 text-slate-600 dark:text-slate-400">{item.size}</td>
                  <td class="py-3 px-5 font-bold text-emerald-600 dark:text-emerald-400">{item.gzipped}</td>
                  <td class="py-3 px-5 text-slate-500 font-sans">{item.tech}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Reproduce Audit Instructions -->
    <section class="max-w-5xl mx-auto mb-20 p-8 rounded-3xl bg-slate-950 text-slate-200 border border-slate-800 font-mono text-xs" aria-labelledby="reproduce-heading">
      <div class="flex items-center gap-2 text-indigo-400 font-bold mb-3 text-sm">
        <Icon name="bx:terminal" class="w-4 h-4" />
        <h3 id="reproduce-heading">Protocol de Reproducció de l'Auditoria</h3>
      </div>
      <p class="text-slate-400 text-xs mb-4 font-sans leading-relaxed">
        Pots executar aquestes mateixes auditories des del teu entorn local per comprovar de manera independent la veracitat de les dades:
      </p>

      <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 space-y-2">
        <div><span class="text-slate-500"># 1. Compilar la versió de producció</span></div>
        <div class="text-emerald-400">npm run build && npm run preview</div>
        <div class="pt-2"><span class="text-slate-500"># 2. Executar auditoria de Lighthouse CLI</span></div>
        <div class="text-emerald-400">npx lighthouse http://localhost:4321/ --preset=desktop --view</div>
        <div class="pt-2"><span class="text-slate-500"># 3. Executar auditoria d'accessibilitat axe-core</span></div>
        <div class="text-emerald-400">npx @axe-core/cli http://localhost:4321/</div>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="https://github.com/jautur/jaumetur.es"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold transition shadow-xs text-xs">
          <Icon name="bx:bxl-github" class="w-4 h-4" />
          <span>Examinar Codi a GitHub</span>
          <span class="text-[10px]">↗</span>
        </a>
        <a
          href="/"
          class="inline-flex items-center gap-1.5 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl font-bold transition border border-slate-700 text-xs">
          <Icon name="bx:home-alt" class="w-4 h-4" />
          <span>Tornar a l'Inici</span>
        </a>
      </div>
    </section>
  </Container>
</Layout>

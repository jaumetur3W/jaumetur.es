---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { Icon } from "astro-icon/components";
import { localeFromPath, localizePath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const href = (path: string) => localizePath(path, isEn ? "en" : "es");

const categories = [
  {
    title: "Entorno de código y editor",
    titleEn: "Code Environment & Editor",
    icon: "bx:code-alt",
    items: [
      {
        name: "VS Code (Visual Studio Code)",
        desc: "Editor principal configurado con linter estricto, formateo automático al guardar y rendimiento fluido.",
        descEn: "Primary editor configured with strict linter, auto-format on save, and smooth performance.",
      },
      {
        name: "Inter Variable & JetBrains Mono",
        desc: "Combinación tipográfica para legibilidad óptima en código fuente, interfaz y métricas técnicas.",
        descEn: "Typography pairing for optimal readability across source code, UI, and technical metrics.",
      },
      {
        name: "Extensiones clave",
        nameEn: "Key Extensions",
        desc: "Angular Language Service, ESLint, Prettier, Tailwind CSS IntelliSense, Astro, GitLens y GitHub Actions Linter.",
        descEn: "Angular Language Service, ESLint, Prettier, Tailwind CSS IntelliSense, Astro, GitLens, and GitHub Actions Linter.",
      },
      {
        name: "Terminal Linux & Bash / Zsh",
        desc: "Línea de comandos nativa para automatización de scripts, gestión de paquetes npm y control de versiones.",
        descEn: "Native command line for script automation, npm package workflows, and version control.",
      },
    ],
  },
  {
    title: "Stack frontend y bibliotecas",
    titleEn: "Frontend Stack & Libraries",
    icon: "bx:bxs-zap",
    items: [
      {
        name: "Angular (Signals & Standalone)",
        desc: "Framework reactivo para aplicaciones web corporativas con arquitectura modular y ciclo de vida optimizado.",
        descEn: "Reactive framework for corporate web apps with modular architecture and optimized lifecycle.",
      },
      {
        name: "TypeScript (Strict Mode)",
        desc: "Tipado estricto sin `any`. Garantía de robustez, refactorización segura y cero errores inesperados en runtime.",
        descEn: "Strict typing without `any`. Robust architecture, safe refactoring, and zero unexpected runtime errors.",
      },
      {
        name: "Tailwind CSS v4 & PostCSS",
        desc: "Diseño de interfaces modular, atómico y ultraligero sin hojas de estilo pesadas ni dependencias innecesarias.",
        descEn: "Modular, atomic, lightweight UI styling without bloated stylesheets or unnecessary dependencies.",
      },
      {
        name: "Astro (Static Site Generation)",
        desc: "El framework más rápido para webs corporativas, landing pages y portfolios: cero JavaScript superfluo y carga instantánea.",
        descEn: "Fastest framework for corporate sites, landing pages, and portfolios: zero superfluous JS and instant load.",
      },
    ],
  },
  {
    title: "DevOps y automatización",
    titleEn: "DevOps & Automation",
    icon: "bx:git-repo-forked",
    items: [
      {
        name: "GitHub Actions",
        desc: "Pipelines CI/CD automatizados: validación de sintaxis, linters, pruebas unitarias y despliegue continuo.",
        descEn: "Automated CI/CD pipelines: syntax validation, linters, unit tests, and continuous deployment.",
      },
      {
        name: "Edge Hosting & CDNs",
        desc: "Alojamiento distribuido globalmente para entrega de activos estáticos y carga con menos de 100ms de latencia.",
        descEn: "Globally distributed hosting for static assets with sub-100ms latency delivery.",
      },
      {
        name: "Git & GitHub Flow",
        desc: "Control de versiones por ramas, commits semánticos (Conventional Commits) y revisión de código.",
        descEn: "Branch-based version control, semantic commits (Conventional Commits), and peer code reviews.",
      },
    ],
  },
  {
    title: "Diseño y accesibilidad",
    titleEn: "Design & Accessibility",
    icon: "bx:palette",
    items: [
      {
        name: "Figma & Design Systems",
        desc: "Prototipado de sistemas de diseño, contraste cromático de capas y maquetación basada en rejillas de 8px.",
        descEn: "Design systems prototyping, layered chromatic contrast, and 8px grid-based layouts.",
      },
      {
        name: "Lighthouse & Axe Accessibility Tools",
        desc: "Auditorías continuas de cumplimiento WCAG AA, Core Web Vitals (LCP, CLS, INP) y optimización de recursos.",
        descEn: "Continuous WCAG AA compliance audits, Core Web Vitals (LCP, CLS, INP), and asset optimization.",
      },
    ],
  },
];
---

<Layout
  title={isEn ? "My Setup & Tools (/uses) | Jaume Tur" : "Mi equipo y herramientas (/uses) | Jaume Tur"}
  description={isEn ? "Hardware, software, VS Code extensions, frontend stack, and configurations I use daily as a developer." : "Hardware, software, extensiones de VS Code, stack frontend y configuraciones que utilizo a diario como desarrollador."}>
  <Container>
    <div class="py-12 md:py-16">
      <Sectionhead>
        <Fragment slot="title">{isEn ? "My setup & tools (/uses)" : "Mi equipo y herramientas (/uses)"}</Fragment>
        <Fragment slot="desc">
          {isEn ? "Detailed list of hardware, software, frontend stack, and configurations I use daily." : "Lista detallada del hardware, software, stack frontend y configuraciones que utilizo a diario."}
        </Fragment>
      </Sectionhead>

      <div class="max-w-4xl mx-auto mt-12 space-y-10">
        {
          categories.map((cat) => (
            <div class="bg-white rounded-3xl border border-slate-200/90 hover:border-slate-950 p-6 sm:p-8 shadow-2xs hover:shadow-md transition-all duration-200">
              <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
                <span class="w-10 h-10 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-950">
                  <Icon name={cat.icon} class="w-5 h-5" />
                </span>
                <h2 class="text-2xl font-light text-slate-950 tracking-tight">
                  {isEn ? cat.titleEn : cat.title}
                </h2>
              </div>

              <div class="grid gap-6">
                {cat.items.map((item) => (
                  <div>
                    <h3 class="text-base font-normal text-slate-950 flex items-center gap-2.5">
                      <span class="w-1.5 h-1.5 rounded-full bg-slate-950"></span>
                      <span>{isEn ? (item.nameEn ?? item.name) : item.name}</span>
                    </h3>
                    <p class="text-xs sm:text-sm text-slate-600 font-light mt-1.5 leading-relaxed pl-4">
                      {isEn ? item.descEn : item.desc}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          ))
        }

        <!-- Community CTA & Tool Generator Link -->
        <div class="bg-slate-950 text-white rounded-3xl p-8 border-2 border-slate-950 shadow-xl flex flex-col sm:flex-row items-center justify-between gap-6 selection:bg-[#FFFF00] selection:text-black">
          <div class="space-y-1 text-center sm:text-left">
            <h3 class="text-xl font-light tracking-tight flex items-center gap-2 justify-center sm:justify-start">
              <span>{isEn ? "Want to automate your deployment?" : "¿Quieres automatizar tu despliegue?"}</span>
              <Icon name="bx:bxs-zap" class="w-4 h-4 text-[#FFFF00]" />
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 font-light">
              {isEn ? "Use the free interactive GitHub Actions workflow generator." : "Utiliza el generador interactivo gratuito para GitHub Actions."}
            </p>
          </div>
          <a
            href={href("/tools/workflow-generator")}
            class="px-5 py-3 rounded-xl bg-[#FFFF00] hover:bg-[#f2d900] text-slate-950 font-mono text-xs uppercase tracking-wider font-semibold border border-slate-950 transition-colors shadow-xs shrink-0">
            {isEn ? "Try CI/CD Generator ↗" : "Probar el generador CI/CD ↗"}
          </a>
        </div>
      </div>
    </div>
  </Container>
</Layout>

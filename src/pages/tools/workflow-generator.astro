---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { Icon } from "astro-icon/components";
import { localeFromPath, localizePath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const blogPath = localizePath("/blog", isEn ? "en" : "es");
---

<Layout
  title={isEn ? "CI/CD Pipeline Generator for GitHub Actions | Jaume Tur" : "Generador de pipelines CI/CD para GitHub Actions | Jaume Tur"}
  description={isEn ? "Free tool to generate GitHub Actions workflows for Astro, Angular, React, and Tailwind CSS." : "Herramienta gratuita para generar workflows de GitHub Actions para Astro, Angular, React y Tailwind CSS."}>
  <Container>
    <div class="py-12 md:py-16">
      <Sectionhead>
        <Fragment slot="title">{isEn ? "CI/CD Generator for GitHub Actions" : "Generador de CI/CD para GitHub Actions"}</Fragment>
        <Fragment slot="desc">
          {isEn
            ? "Build optimized continuous integration and deployment workflows for frontend projects in seconds."
            : "Crea en segundos workflows de integración y despliegue continuo optimizados para proyectos frontend."}
        </Fragment>
      </Sectionhead>

      <!-- Tool Container -->
      <div class="max-w-5xl mx-auto mt-12 grid lg:grid-cols-12 gap-8 items-start">
        
        <!-- Controls Column -->
        <div class="lg:col-span-5 bg-white p-6 sm:p-7 rounded-3xl border border-slate-200/90 shadow-2xs space-y-6">
          <div class="flex items-center gap-2 pb-4 border-b border-slate-100">
            <Icon name="bx:cog" class="w-5 h-5 text-slate-950" />
            <h2 class="font-light text-slate-950 text-base">{isEn ? "Pipeline configuration" : "Configuración del pipeline"}</h2>
          </div>

          <!-- Framework Selection -->
          <div>
            <label class="block text-xs font-mono font-semibold uppercase text-slate-700 mb-2">
              {isEn ? "1. Framework / stack" : "1. Framework / stack"}
            </label>
            <div class="grid grid-cols-2 gap-2">
              <button
                type="button"
                data-framework="astro"
                class="framework-btn active p-2.5 rounded-xl border border-slate-950 bg-slate-950 text-white font-mono text-xs text-left flex items-center gap-2 transition cursor-pointer shadow-2xs">
                <Icon name="simple-icons:astro" class="w-4 h-4 text-[#FFFF00]" />
                <span>Astro (SSG)</span>
              </button>
              <button
                type="button"
                data-framework="angular"
                class="framework-btn p-2.5 rounded-xl border border-slate-200 bg-white text-slate-700 hover:border-slate-950 font-mono text-xs text-left flex items-center gap-2 transition cursor-pointer">
                <Icon name="simple-icons:angular" class="w-4 h-4 text-red-500" />
                <span>Angular SPA</span>
              </button>
              <button
                type="button"
                data-framework="react"
                class="framework-btn p-2.5 rounded-xl border border-slate-200 bg-white text-slate-700 hover:border-slate-950 font-mono text-xs text-left flex items-center gap-2 transition cursor-pointer">
                <Icon name="simple-icons:react" class="w-4 h-4 text-cyan-500" />
                <span>React / Vite</span>
              </button>
              <button
                type="button"
                data-framework="html"
                class="framework-btn p-2.5 rounded-xl border border-slate-200 bg-white text-slate-700 hover:border-slate-950 font-mono text-xs text-left flex items-center gap-2 transition cursor-pointer">
                <Icon name="simple-icons:html5" class="w-4 h-4 text-amber-500" />
                <span>HTML & Tailwind</span>
              </button>
            </div>
          </div>

          <!-- Target Platform -->
          <div>
            <label class="block text-xs font-mono font-semibold uppercase text-slate-700 mb-2">
              {isEn ? "2. Deployment target" : "2. Destino del despliegue"}
            </label>
            <div class="grid grid-cols-2 gap-2">
              <button
                type="button"
                data-target="pages"
                class="target-btn active p-2.5 rounded-xl border border-slate-950 bg-slate-950 text-white font-mono text-xs text-left flex items-center gap-2 transition cursor-pointer shadow-2xs">
                <Icon name="bx:bxl-github" class="w-4 h-4 text-white" />
                <span>GitHub Pages</span>
              </button>
              <button
                type="button"
                data-target="vercel"
                class="target-btn p-2.5 rounded-xl border border-slate-200 bg-white text-slate-700 hover:border-slate-950 font-mono text-xs text-left flex items-center gap-2 transition cursor-pointer">
                <Icon name="simple-icons:vercel" class="w-4 h-4 text-slate-900" />
                <span>Vercel Edge</span>
              </button>
            </div>
          </div>

          <!-- Feature Toggles -->
          <div>
            <label class="block text-xs font-mono font-semibold uppercase text-slate-700 mb-2">
              {isEn ? "3. Quality and caching" : "3. Calidad y caché"}
            </label>
            <div class="space-y-2">
              <label class="flex items-center gap-2.5 text-xs font-light text-slate-700 cursor-pointer">
                <input type="checkbox" id="check-lint" checked class="rounded accent-slate-950" />
                <span>{isEn ? "Include code linter check" : "Incluir el linter y la comprobación del código"}</span>
              </label>
              <label class="flex items-center gap-2.5 text-xs font-light text-slate-700 cursor-pointer">
                <input type="checkbox" id="check-ts" checked class="rounded accent-slate-950" />
                <span>{isEn ? "Strict TypeScript type-checking" : "Verificación estricta de tipos (TypeScript)"}</span>
              </label>
              <label class="flex items-center gap-2.5 text-xs font-light text-slate-700 cursor-pointer">
                <input type="checkbox" id="check-cache" checked class="rounded accent-slate-950" />
                <span>{isEn ? "Smart npm dependencies caching" : "Caché inteligente de dependencias npm"}</span>
              </label>
            </div>
          </div>

          <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 text-[11px] text-slate-600 font-mono flex items-start gap-2">
            <Icon name="bx:info-circle" class="w-4 h-4 text-slate-950 shrink-0 mt-0.5" />
            <span><strong>{isEn ? "How to use:" : "Cómo utilizarlo:"}</strong> {isEn ? "Save this file at" : "Guarda este archivo en"} <code>.github/workflows/deploy.yml</code> {isEn ? "in your repository." : "en tu repositorio."}</span>
          </div>
        </div>

        <!-- Output YAML Code Preview Column -->
        <div class="lg:col-span-7 bg-slate-950 rounded-3xl border border-slate-900 shadow-xl overflow-hidden font-mono text-xs flex flex-col">
          <div class="bg-slate-900/90 px-5 py-3.5 flex items-center justify-between border-b border-slate-800">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-slate-700 inline-block"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-slate-700 inline-block"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#FFFF00] inline-block"></span>
              <span class="text-slate-400 text-xs ml-2">// .github/workflows/deploy.yml</span>
            </div>
            
            <button
              id="copy-yaml-btn"
              type="button"
              class="px-3.5 py-1.5 rounded-xl bg-[#FFFF00] hover:bg-[#f2d900] text-slate-950 font-mono text-xs uppercase tracking-wider font-semibold border border-slate-950 transition flex items-center gap-1.5 shadow-2xs cursor-pointer">
              <Icon name="bx:copy" class="w-3.5 h-3.5 text-slate-950" />
              <span>{isEn ? "Copy YAML" : "Copiar YAML"}</span>
            </button>
          </div>

          <pre class="p-6 text-slate-200 overflow-x-auto text-[12px] leading-relaxed max-h-[580px]"><code id="yaml-code">{isEn ? "Loading configuration..." : "Cargando configuración..."}</code></pre>
        </div>

      </div>

      <!-- Lead Magnet & Community CTA -->
      <div class="mt-16 bg-white rounded-3xl border border-slate-200/90 p-8 max-w-4xl mx-auto shadow-2xs flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span class="text-xs font-mono font-semibold text-slate-950 bg-[#FFFF00] px-3 py-1 rounded-full border border-slate-950/20 mb-3 inline-block">
            {isEn ? "FREE RESOURCE FOR DEVELOPERS" : "RECURSO GRATUITO PARA DESARROLLADORES"}
          </span>
          <h3 class="text-xl font-light text-slate-950 tracking-tight">
            {isEn ? "Want a production performance and WCAG AA checklist?" : "¿Quieres una lista de verificación de rendimiento y WCAG AA para producción?"}
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 font-light mt-1 max-w-md leading-relaxed">
            {isEn ? "Explore practical guides used in real-world projects to reach 60 FPS and avoid accessibility pitfalls." : "Descarga la guía práctica que utilizo en proyectos reales para alcanzar 60 FPS y evitar errores de accesibilidad."}
          </p>
        </div>
        <a
          href={blogPath}
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-slate-950 hover:bg-[#FFFF00] text-white hover:text-slate-950 font-mono text-xs uppercase tracking-wider font-semibold border border-slate-950 transition-all shadow-2xs shrink-0">
          <Icon name="bx:book-open" class="w-4 h-4" />
          <span>{isEn ? "Read the blog" : "Leer el blog"}</span>
        </a>
      </div>

    </div>
  </Container>
</Layout>

<script is:inline>
  let currentFramework = "astro";
  let currentTarget = "pages";

  function generateYaml() {
    const doLint = document.getElementById("check-lint")?.checked;
    const doTs = document.getElementById("check-ts")?.checked;
    const doCache = document.getElementById("check-cache")?.checked;

    let yaml = `name: Deploy Pipeline\n\non:\n  push:\n    branches: [ main ]\n  workflow_dispatch:\n\npermissions:\n  contents: read\n  pages: write\n  id-token: write\n\nconcurrency:\n  group: "pages"\n  cancel-in-progress: false\n\njobs:\n  build:\n    name: Build & Verify\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v4\n\n`;

    if (currentTarget === "pages") {
      yaml += `      - name: Setup GitHub Pages\n        uses: actions/configure-pages@v5\n\n`;
    }

    yaml += `      - name: Setup Node.js\n        uses: actions/setup-node@v4\n        with:\n          node-version: 22\n`;
    if (doCache) {
      yaml += `          cache: npm\n`;
    }
    yaml += `\n      - name: Install dependencies\n        run: npm ci\n\n`;

    if (doLint) {
      yaml += `      - name: Code Quality & Linters\n        run: npm run lint --if-present\n\n`;
    }

    if (doTs) {
      yaml += `      - name: Strict TypeScript Verification\n        run: npx tsc --noEmit\n\n`;
    }

    const buildCommand = currentFramework === "angular" ? "npm run build -- --configuration production" : "npm run build";
    const distPath = currentFramework === "angular" ? "./dist/*/browser" : "./dist";

    yaml += `      - name: Build static output\n        run: ${buildCommand}\n\n`;

    if (currentTarget === "pages") {
      yaml += `      - name: Upload artifact\n        uses: actions/upload-pages-artifact@v3\n        with:\n          path: ${distPath}\n\n  deploy:\n    name: Deploy to GitHub Pages\n    needs: build\n    runs-on: ubuntu-latest\n    environment:\n      name: github-pages\n      url: \${{ steps.deployment.outputs.page_url }}\n    steps:\n      - name: Deploy to GitHub Pages\n        id: deployment\n        uses: actions/deploy-pages@v4\n`;
    } else {
      yaml += `      - name: Deploy to Vercel\n        uses: amondnet/vercel-action@v25\n        with:\n          vercel-token: \${{ secrets.VERCEL_TOKEN }}\n          vercel-org-id: \${{ secrets.VERCEL_ORG_ID }}\n          vercel-project-id: \${{ secrets.VERCEL_PROJECT_ID }}\n          vercel-args: '--prod'\n`;
    }

    const codeEl = document.getElementById("yaml-code");
    if (codeEl) {
      codeEl.textContent = yaml;
    }
  }

  // Framework buttons
  document.querySelectorAll(".framework-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".framework-btn").forEach((b) => {
        b.className = "framework-btn p-2.5 rounded-xl border border-slate-200 bg-white text-slate-700 hover:border-slate-950 font-mono text-xs text-left flex items-center gap-2 transition cursor-pointer";
      });
      btn.className = "framework-btn active p-2.5 rounded-xl border border-slate-950 bg-slate-950 text-white font-mono text-xs text-left flex items-center gap-2 transition cursor-pointer shadow-2xs";
      currentFramework = btn.getAttribute("data-framework") || "astro";
      generateYaml();
    });
  });

  // Target buttons
  document.querySelectorAll(".target-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".target-btn").forEach((b) => {
        b.className = "target-btn p-2.5 rounded-xl border border-slate-200 bg-white text-slate-700 hover:border-slate-950 font-mono text-xs text-left flex items-center gap-2 transition cursor-pointer";
      });
      btn.className = "target-btn active p-2.5 rounded-xl border border-slate-950 bg-slate-950 text-white font-mono text-xs text-left flex items-center gap-2 transition cursor-pointer shadow-2xs";
      currentTarget = btn.getAttribute("data-target") || "pages";
      generateYaml();
    });
  });

  // Checkbox listeners
  ["check-lint", "check-ts", "check-cache"].forEach((id) => {
    document.getElementById(id)?.addEventListener("change", generateYaml);
  });

  // Copy button
  const copyBtn = document.getElementById("copy-yaml-btn");
  if (copyBtn) {
    copyBtn.addEventListener("click", () => {
      const codeEl = document.getElementById("yaml-code");
      if (codeEl) {
        navigator.clipboard.writeText(codeEl.textContent || "").then(() => {
          const original = copyBtn.innerHTML;
          const isEnglish = document.documentElement.lang.startsWith("en");
          copyBtn.innerHTML = isEnglish ? "<span>✓ Copied!</span>" : "<span>✓ ¡Copiado!</span>";
          copyBtn.className = "px-3.5 py-1.5 rounded-xl bg-[#FFFF00] text-slate-950 font-mono text-xs font-semibold border border-slate-950 transition flex items-center gap-1.5 shadow-2xs cursor-pointer";
          setTimeout(() => {
            copyBtn.innerHTML = original;
            copyBtn.className = "px-3.5 py-1.5 rounded-xl bg-[#FFFF00] hover:bg-[#f2d900] text-slate-950 font-mono text-xs uppercase tracking-wider font-semibold border border-slate-950 transition flex items-center gap-1.5 shadow-2xs cursor-pointer";
          }, 2000);
        });
      }
    });
  }

  generateYaml();
</script>

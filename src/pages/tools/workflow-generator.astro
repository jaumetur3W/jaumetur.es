---
import UiIcon from "@/components/ui-icon.astro";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { Icon } from "astro-icon/components";
import { localeFromPath, localizePath, localizeHref } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const blogPath = localizeHref("/blog", isEn ? "en" : "es");
const htmlToolPath = localizeHref("/tools/creador-html", isEn ? "en" : "es");
---

<Layout
  title={isEn ? "CI/CD Pipeline Generator for GitHub Actions | Jaume Tur" : "Generador de pipelines CI/CD para GitHub Actions | Jaume Tur"}
  description={isEn ? "Free tool to generate GitHub Actions workflows for Astro, Angular, React, and Tailwind CSS." : "Herramienta gratuita para generar workflows de GitHub Actions para Astro, Angular, React y Tailwind CSS."}>
  <div class="px-5 py-12 md:py-16">
    <Container>
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-flex items-center gap-2  border border-ink/40 bg-brand/10 px-3.5 py-1 text-xs font-bold text-ink">
          <Icon name="bx:git-repo-forked" class="h-4 w-4" />
          <span>{isEn ? "DevOps Automation Tool" : "Herramienta DevOps y Automatización"}</span>
        </span>
        <h1 class="h-page mt-4">
          {isEn ? "CI/CD Generator for GitHub Actions" : "Generador de CI/CD para GitHub Actions"}
        </h1>
        <p class="mt-4 text-base sm:text-lg text-graphite leading-relaxed">
          {isEn
            ? "Build optimized continuous integration and deployment workflows for frontend projects in seconds. Copy or download deploy.yml ready for production."
            : "Crea en segundos workflows de integración y despliegue continuo optimizados para proyectos frontend. Copia o descarga deploy.yml listo para producción."}
        </p>
      </div>

      <!-- Tool Container -->
      <div class="max-w-5xl mx-auto mt-12 grid lg:grid-cols-12 gap-8 items-start">
        
        <!-- Controls Column -->
        <div class="lg:col-span-5 surface-card bg-paper-2 p-6 sm:p-7  border border-rule space-y-6">
          <div class="flex items-center gap-2 pb-4 border-b-2 border-ink">
            <Icon name="bx:cog" class="w-5 h-5 text-ink" />
            <h2 class="font-display font-extrabold tracking-[-0.035em] text-ink text-base">{isEn ? "Pipeline configuration" : "Configuración del pipeline"}</h2>
          </div>

          <!-- Framework Selection -->
          <div>
            <label class="block text-xs font-mono font-semibold  text-graphite mb-2">
              {isEn ? "1. Framework / stack" : "1. Framework / stack"}
            </label>
            <div class="grid grid-cols-2 gap-2" id="framework-group">
              <button
                type="button"
                data-framework="astro"
                class="framework-btn active p-2.5  border border-ink bg-brand text-ink font-mono text-xs text-left flex items-center gap-2 transition cursor-pointer font-bold ">
                <Icon name="simple-icons:astro" class="w-4 h-4 text-ink" />
                <span>Astro (SSG)</span>
              </button>
              <button
                type="button"
                data-framework="angular"
                class="framework-btn p-2.5  border border-rule bg-paper-2 text-graphite hover:border-ink font-mono text-xs text-left flex items-center gap-2 transition cursor-pointer">
                <Icon name="simple-icons:angular" class="w-4 h-4 text-red-400" />
                <span>Angular SPA</span>
              </button>
              <button
                type="button"
                data-framework="react"
                class="framework-btn p-2.5  border border-rule bg-paper-2 text-graphite hover:border-ink font-mono text-xs text-left flex items-center gap-2 transition cursor-pointer">
                <Icon name="simple-icons:react" class="w-4 h-4 text-cyan-400" />
                <span>React / Vite</span>
              </button>
              <button
                type="button"
                data-framework="html"
                class="framework-btn p-2.5  border border-rule bg-paper-2 text-graphite hover:border-ink font-mono text-xs text-left flex items-center gap-2 transition cursor-pointer">
                <Icon name="simple-icons:html5" class="w-4 h-4 text-amber-400" />
                <span>HTML & Tailwind</span>
              </button>
            </div>
          </div>

          <!-- Target Platform -->
          <div>
            <label class="block text-xs font-mono font-semibold  text-graphite mb-2">
              {isEn ? "2. Deployment target" : "2. Destino del despliegue"}
            </label>
            <div class="grid grid-cols-2 gap-2" id="target-group">
              <button
                type="button"
                data-target="pages"
                class="target-btn active p-2.5  border border-ink bg-brand text-ink font-mono text-xs text-left flex items-center gap-2 transition cursor-pointer font-bold ">
                <Icon name="bx:bxl-github" class="w-4 h-4 text-ink" />
                <span>GitHub Pages</span>
              </button>
              <button
                type="button"
                data-target="vercel"
                class="target-btn p-2.5  border border-rule bg-paper-2 text-graphite hover:border-ink font-mono text-xs text-left flex items-center gap-2 transition cursor-pointer">
                <Icon name="simple-icons:vercel" class="w-4 h-4 text-ink" />
                <span>Vercel Edge</span>
              </button>
            </div>
          </div>

          <!-- Feature Toggles -->
          <div>
            <label class="block text-xs font-mono font-semibold  text-graphite mb-2">
              {isEn ? "3. Quality and caching" : "3. Calidad y caché"}
            </label>
            <div class="space-y-2.5 text-xs text-graphite">
              <label class="flex items-center gap-2.5 cursor-pointer">
                <input type="checkbox" id="check-lint" checked class="rounded border-rule bg-ink text-ink focus:ring-brand accent-[var(--brand)]" />
                <span>{isEn ? "Execute linter before build (npm run lint)" : "Ejecutar linter antes de compilar (npm run lint)"}</span>
              </label>
              <label class="flex items-center gap-2.5 cursor-pointer">
                <input type="checkbox" id="check-ts" checked class="rounded border-rule bg-ink text-ink focus:ring-brand accent-[var(--brand)]" />
                <span>{isEn ? "Strict TypeScript verification (tsc --noEmit)" : "Verificación estricta de TypeScript (tsc --noEmit)"}</span>
              </label>
              <label class="flex items-center gap-2.5 cursor-pointer">
                <input type="checkbox" id="check-cache" checked class="rounded border-rule bg-ink text-ink focus:ring-brand accent-[var(--brand)]" />
                <span>{isEn ? "Cache npm dependencies (faster runner)" : "Caché de dependencias npm (ejecución rápida)"}</span>
              </label>
            </div>
          </div>

          <!-- HTML Creator link -->
          <div class="pt-4 border-t-2 border-ink">
            <a href={htmlToolPath} class="flex items-center justify-between p-3  border border-rule bg-paper/[0.02] hover:border-ink text-xs text-graphite hover:text-ink transition">
              <span class="flex items-center gap-2">
                <Icon name="bx:code-block" class="h-4 w-4 text-ink" />
                <span>{isEn ? "Looking to create an HTML file?" : "¿Quieres crear un archivo HTML?"}</span>
              </span>
              <UiIcon name="arrow" class="text-ink font-mono" />
            </a>
          </div>
        </div>

        <!-- Output YAML Code Preview Column -->
        <div class="lg:col-span-7 surface-card bg-paper-2  border border-rule  overflow-hidden font-mono text-xs flex flex-col">
          <div class="bg-paper-2 px-5 py-3.5 flex flex-wrap items-center justify-between gap-3 border-b-2 border-ink">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5  bg-red-500/80 inline-block"></span>
              <span class="w-2.5 h-2.5  bg-yellow-500/80 inline-block"></span>
              <span class="w-2.5 h-2.5  bg-emerald-500/80 inline-block"></span>
              <span class="text-graphite text-xs ml-2">// .github/workflows/deploy.yml</span>
            </div>
            
            <div class="flex items-center gap-2">
              <button
                id="copy-yaml-btn"
                type="button"
                class="px-3 py-1.5  bg-paper-2 hover:bg-paper-2 text-ink font-mono text-xs transition flex items-center gap-1.5 cursor-pointer border border-rule">
                <Icon name="bx:copy" class="w-3.5 h-3.5 text-ink" />
                <span id="copy-yaml-label">{isEn ? "Copy" : "Copiar"}</span>
              </button>
              <button
                id="download-yaml-btn"
                type="button"
                class="px-3.5 py-1.5  bg-brand hover:bg-paper text-ink font-mono text-xs  tracking-wider font-bold border border-ink transition flex items-center gap-1.5 cursor-pointer ">
                <Icon name="bx:download" class="w-3.5 h-3.5 text-ink" />
                <span id="download-yaml-label">{isEn ? "Download .yml" : "Descargar .yml"}</span>
              </button>
            </div>
          </div>

          <pre tabindex="0" aria-label={isEn ? "Generated GitHub Workflow YAML code" : "Código YAML de GitHub Workflow generado"} class="p-6 text-emerald-400 overflow-x-auto text-[12px] leading-relaxed max-h-[580px] focus:outline-hidden focus:ring-1 focus:ring-brand"><code id="yaml-code">{isEn ? "Loading configuration..." : "Cargando configuración..."}</code></pre>
        </div>

      </div>

      <!-- Lead Magnet & Community CTA -->
      <div class="mt-16 surface-card bg-paper-2  border border-rule p-8 max-w-4xl mx-auto  flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span class="text-xs font-mono font-bold text-ink bg-brand px-3 py-1  border border-ink mb-3 inline-block">
            {isEn ? "Free developer resource" : "Recurso gratuito para desarrolladores"}
          </span>
          <h3 class="text-xl font-display font-extrabold tracking-[-0.035em] text-ink tracking-tight">
            {isEn ? "Want a production performance and WCAG AA checklist?" : "¿Quieres una lista de verificación de rendimiento y WCAG AA para producción?"}
          </h3>
          <p class="text-xs sm:text-sm text-graphite font-normal mt-1 max-w-md leading-relaxed">
            {isEn ? "Explore practical guides used in real-world projects to reach 60 FPS and avoid accessibility pitfalls." : "Descarga la guía práctica que utilizo en proyectos reales para alcanzar 60 FPS y evitar errores de accesibilidad."}
          </p>
        </div>
        <a
          href={blogPath}
          class="btn btn-brand min-h-11 px-5 text-xs  tracking-wider font-bold shrink-0">
          <Icon name="bx:book-open" class="w-4 h-4" />
          <span>{isEn ? "Read the blog" : "Leer el blog"}</span>
        </a>
      </div>

    </Container>
  </div>
</Layout>

<script is:inline>
  let currentFramework = "astro";
  let currentTarget = "pages";

  function generateYaml() {
    const doLint = document.getElementById("check-lint")?.checked;
    const doTs = document.getElementById("check-ts")?.checked;
    const doCache = document.getElementById("check-cache")?.checked;

    let yaml = `name: Deploy Pipeline\n\non:\n  push:\n    branches: [ main ]\n  workflow_dispatch:\n\npermissions:\n  contents: read\n  pages: write\n  id-token: write\n\nconcurrency:\n  group: "pages"\n  cancel-in-progress: false\n\njobs:\n  build:\n    name: Build & Verify\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v4\n\n`;

    if (currentTarget === "pages") {
      yaml += `      - name: Setup GitHub Pages\n        uses: actions/configure-pages@v5\n\n`;
    }

    yaml += `      - name: Setup Node.js\n        uses: actions/setup-node@v4\n        with:\n          node-version: 22\n`;
    if (doCache) {
      yaml += `          cache: npm\n`;
    }
    yaml += `\n      - name: Install dependencies\n        run: npm ci\n\n`;

    if (doLint) {
      yaml += `      - name: Code Quality & Linters\n        run: npm run lint --if-present\n\n`;
    }

    if (doTs) {
      yaml += `      - name: Strict TypeScript Verification\n        run: npx tsc --noEmit\n\n`;
    }

    const buildCommand = currentFramework === "angular" ? "npm run build -- --configuration production" : "npm run build";
    const distPath = currentFramework === "angular" ? "./dist/*/browser" : "./dist";

    yaml += `      - name: Build static output\n        run: ${buildCommand}\n\n`;

    if (currentTarget === "pages") {
      yaml += `      - name: Upload artifact\n        uses: actions/upload-pages-artifact@v3\n        with:\n          path: ${distPath}\n\n  deploy:\n    name: Deploy to GitHub Pages\n    needs: build\n    runs-on: ubuntu-latest\n    environment:\n      name: github-pages\n      url: \${{ steps.deployment.outputs.page_url }}\n    steps:\n      - name: Deploy to GitHub Pages\n        id: deployment\n        uses: actions/deploy-pages@v4\n`;
    } else {
      yaml += `      - name: Deploy to Vercel\n        uses: amondnet/vercel-action@v25\n        with:\n          vercel-token: \${{ secrets.VERCEL_TOKEN }}\n          vercel-org-id: \${{ secrets.VERCEL_ORG_ID }}\n          vercel-project-id: \${{ secrets.VERCEL_PROJECT_ID }}\n          vercel-args: '--prod'\n`;
    }

    const codeEl = document.getElementById("yaml-code");
    if (codeEl) {
      codeEl.textContent = yaml;
    }
    return yaml;
  }

  // Framework buttons
  document.querySelectorAll(".framework-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".framework-btn").forEach((b) => {
        b.className = "framework-btn p-2.5  border border-rule bg-paper-2 text-graphite hover:border-ink font-mono text-xs text-left flex items-center gap-2 transition cursor-pointer";
        const icon = b.querySelector("svg");
        if (icon && b.getAttribute("data-framework") === "astro") icon.className = "w-4 h-4 text-ink";
      });
      btn.className = "framework-btn active p-2.5  border border-ink bg-brand text-ink font-mono text-xs text-left flex items-center gap-2 transition cursor-pointer font-bold ";
      const icon = btn.querySelector("svg");
      if (icon) icon.className = "w-4 h-4 text-ink";
      currentFramework = btn.getAttribute("data-framework") || "astro";
      generateYaml();
    });
  });

  // Target buttons
  document.querySelectorAll(".target-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".target-btn").forEach((b) => {
        b.className = "target-btn p-2.5  border border-rule bg-paper-2 text-graphite hover:border-ink font-mono text-xs text-left flex items-center gap-2 transition cursor-pointer";
        const icon = b.querySelector("svg");
        if (icon) icon.className = "w-4 h-4 text-ink";
      });
      btn.className = "target-btn active p-2.5  border border-ink bg-brand text-ink font-mono text-xs text-left flex items-center gap-2 transition cursor-pointer font-bold ";
      const icon = btn.querySelector("svg");
      if (icon) icon.className = "w-4 h-4 text-ink";
      currentTarget = btn.getAttribute("data-target") || "pages";
      generateYaml();
    });
  });

  // Checkbox listeners
  ["check-lint", "check-ts", "check-cache"].forEach((id) => {
    document.getElementById(id)?.addEventListener("change", generateYaml);
  });

  // Copy button
  const copyBtn = document.getElementById("copy-yaml-btn");
  const copyLabel = document.getElementById("copy-yaml-label");
  if (copyBtn) {
    copyBtn.addEventListener("click", () => {
      const codeEl = document.getElementById("yaml-code");
      if (codeEl) {
        navigator.clipboard.writeText(codeEl.textContent || "").then(() => {
          const original = copyLabel ? copyLabel.textContent : "Copiar";
          if (copyLabel) copyLabel.textContent = "✓ ¡Copiado!";
          setTimeout(() => {
            if (copyLabel) copyLabel.textContent = original;
          }, 2000);
        });
      }
    });
  }

  // Download button
  const downloadBtn = document.getElementById("download-yaml-btn");
  const downloadLabel = document.getElementById("download-yaml-label");
  if (downloadBtn) {
    downloadBtn.addEventListener("click", () => {
      const yaml = generateYaml();
      const blob = new Blob([yaml], { type: "text/yaml;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "deploy.yml";
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      const original = downloadLabel ? downloadLabel.textContent : "Descargar";
      if (downloadLabel) downloadLabel.textContent = "✓ ¡Descargado!";
      setTimeout(() => {
        if (downloadLabel) downloadLabel.textContent = original;
      }, 2000);
    });
  }

  generateYaml();
</script>

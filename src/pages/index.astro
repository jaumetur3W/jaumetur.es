---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import { getServicesData } from "@/data/services";
import { localeFromPath, localizePath } from "@/i18n";

const locale = localeFromPath(Astro.url.pathname);
const isEn = locale === "en";
const to = (path: string) => {
  const p = localizePath(path, locale);
  const [base, hash] = p.split("#");
  const b = base === "/" || base.endsWith("/") ? base : `${base}/`;
  return hash ? `${b}#${hash}` : b;
};

const services = getServicesData(locale);
const featured = services.find((s) => s.isFeatured) ?? services[0];
const others = services.filter((s) => s.id !== featured.id);
const monthly = (n: number) => (isEn ? `€${n}/month` : `${n} €/mes`);
const euro = (n: number) => (isEn ? `€${n.toLocaleString("en-US")}` : `${n.toLocaleString("es-ES")} €`);

const rawProjects = await getCollection(isEn ? "projectes-en" : "projectes");
const projects = rawProjects.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
const projectImages: Record<string, string> = {
  avisa: "/img/preview-avisa.webp",
  "pizzeria-xativa": "/img/foto_pizza.webp",
  "burger-xativa": "/img/foto_burger.webp",
  "dashboard-telemetria": "/img/preview-dashboard.webp",
  "pipeline-cicd": "/img/preview-pipeline.webp",
};
const shortTitle = (t: string) => t.split(" — ")[0];

const t = isEn
  ? {
      eyebrow: "Web design · Xàtiva · Valencia · Remote",
      h1a: "Your website and social media,",
      h1b: "ready to attract customers.",
      lead: "I'm Jaume Tur, a web developer based in Xàtiva. I build fast websites, digital menus and polished Google Maps, Instagram and Facebook profiles for businesses in Xàtiva, Valencia and remote.",
      cta1: "Get a free quote",
      cta2: "See prices from €290",
      trust: [
        { big: "From €290", small: "Clear pricing from day one" },
        { big: "3–5 days", small: "Delivery of the local business pack" },
        { big: "100% yours", small: "Code, menu and profiles belong to you" },
        { big: "< 24 h", small: "Usual reply time on business days" },
      ],
      marquee: ["Websites", "Digital menus", "Google Maps", "Instagram & Facebook", "Local SEO", "Landing pages", "Web apps", "WhatsApp orders", "Accessibility"],
      svcEyebrow: "Services",
      svcTitle: "Everything your business needs to be found online.",
      svcLead: "Fixed starting prices, a clear scope and one person in charge of the whole project.",
      recommended: "Most recommended",
      from: "From",
      deliveryLabel: "Delivery",
      seeDetail: "See details and pricing",
      requestPack: "Request this pack",
      allPricing: "Compare all plans",
      painEyebrow: "Local businesses",
      painTitle: "From invisible to easy to choose.",
      pain: [
        { before: "A heavy PDF menu nobody can open", after: "A clear, mobile-friendly web menu with allergen info", icon: "bx:restaurant" },
        { before: "An outdated Google Maps listing", after: "A Google Business Profile created or optimised with your hours and contact", icon: "bx:map" },
        { before: "Social profiles with no care", after: "Instagram and Facebook profiles created or managed", icon: "bx:bxl-instagram" },
        { before: "Orders through third-party platforms", after: "Direct bookings and orders via WhatsApp, no commissions", icon: "bx:bxl-whatsapp" },
      ],
      beforeLabel: "Before",
      afterLabel: "After",
      projEyebrow: "Projects",
      projTitle: "Real work you can open and try.",
      projLead: "Some are demos with sample data and are labelled as such. Each page explains what it is and what I did.",
      viewProject: "View project",
      allProjects: "See all projects",
      procEyebrow: "How I work",
      procTitle: "A simple process, no surprises.",
      steps: [
        { n: "01", t: "We talk", d: "Analysis of requirements and project scope. You tell me what you need; I tell you what makes sense." },
        { n: "02", t: "Design and build", d: "I design and implement the agreed solution with the technologies we choose." },
        { n: "03", t: "Quality review", d: "Quality, performance and accessibility review is included in the scope." },
        { n: "04", t: "Delivery", d: "Delivery of the code and documentation of the work done, and ongoing support during the contracted period." },
      ],
      aboutEyebrow: "Who you'll work with",
      aboutTitle: "One person, start to finish.",
      aboutText:
        "I'm Jaume Tur, a software developer based in Xàtiva (Valencia). I hold a Higher Technical Certificate in Web Application Development (DAW) and an intermediate certificate in Microcomputer Systems and Networks (SMX). I work with local businesses and remote teams.",
      aboutCta: "More about me",
      cv: "Download CV (PDF)",
      faqEyebrow: "FAQ",
      faqTitle: "Questions before you start.",
      finalTitle: "Let's talk about your website.",
      finalText: "Tell me about your business and what you need. I'll reply on business days, usually within 24 hours.",
      finalCta: "Write to me",
      finalCta2: "Detailed questionnaire",
      finalCta3: "Contact page",
      avail: "Available for projects",
    }
  : {
      eyebrow: "Diseño web · Xàtiva · Valencia · Remoto",
      h1a: "Tu web y tus redes,",
      h1b: "listas para atraer clientes.",
      lead: "Soy Jaume Tur, desarrollador web en Xàtiva. Creo páginas web rápidas, cartas digitales y perfiles cuidados de Google Maps, Instagram y Facebook para negocios de Xàtiva, Valencia y en remoto.",
      cta1: "Pedir presupuesto",
      cta2: "Ver precios desde 290 €",
      trust: [
        { big: "Desde 290 €", small: "Precio claro desde el primer día" },
        { big: "3–5 días", small: "Entrega del pack de negocio local" },
        { big: "100 % tuyo", small: "Código, carta y perfiles son tuyos" },
        { big: "< 24 h", small: "Respuesta habitual en días laborables" },
      ],
      marquee: ["Páginas web", "Carta digital", "Google Maps", "Instagram y Facebook", "SEO local", "Landing pages", "Aplicaciones web", "Pedidos por WhatsApp", "Accesibilidad"],
      svcEyebrow: "Servicios",
      svcTitle: "Todo lo que tu negocio necesita para que lo encuentren en internet.",
      svcLead: "Precios de partida fijos, un alcance claro y una sola persona al frente de todo el proyecto.",
      recommended: "Más recomendado",
      from: "Desde",
      deliveryLabel: "Entrega",
      seeDetail: "Ver detalle y precios",
      requestPack: "Solicitar este pack",
      allPricing: "Comparar todos los planes",
      painEyebrow: "Negocios locales",
      painTitle: "De pasar desapercibido a ser fácil de elegir.",
      pain: [
        { before: "Una carta en PDF pesado que nadie puede abrir", after: "Una carta web clara, para móvil y con información de alérgenos", icon: "bx:restaurant" },
        { before: "Una ficha de Google Maps desactualizada", after: "Ficha de Google Business Profile creada u optimizada, con horarios y contacto", icon: "bx:map" },
        { before: "Redes sociales sin cuidar", after: "Perfiles de Instagram y Facebook creados o gestionados", icon: "bx:bxl-instagram" },
        { before: "Pedidos a través de plataformas de terceros", after: "Reservas y pedidos directos por WhatsApp, sin comisiones", icon: "bx:bxl-whatsapp" },
      ],
      beforeLabel: "Antes",
      afterLabel: "Después",
      projEyebrow: "Proyectos",
      projTitle: "Trabajo real que puedes abrir y probar.",
      projLead: "Algunos son demos con datos de ejemplo y están indicados como tales. Cada ficha explica qué es y qué hice yo.",
      viewProject: "Ver proyecto",
      allProjects: "Ver todos los proyectos",
      procEyebrow: "Cómo trabajo",
      procTitle: "Un proceso sencillo, sin sorpresas.",
      steps: [
        { n: "01", t: "Hablamos", d: "Análisis de requisitos y alcance del proyecto. Tú me cuentas qué necesitas; yo te digo qué tiene sentido." },
        { n: "02", t: "Diseño y desarrollo", d: "Diseño e implementación de la solución acordada con las tecnologías que elijamos." },
        { n: "03", t: "Revisión de calidad", d: "La revisión de calidad, rendimiento y accesibilidad está incluida en el alcance." },
        { n: "04", t: "Entrega", d: "Entrega del código y documentación del trabajo realizado, con soporte continuado durante el periodo contratado." },
      ],
      aboutEyebrow: "Con quién vas a trabajar",
      aboutTitle: "Una sola persona, de principio a fin.",
      aboutText:
        "Soy Jaume Tur, desarrollador de software afincado en Xàtiva (Valencia). Tengo el CFGS en Desarrollo de Aplicaciones Web (DAW) y el Grado Medio en Sistemas Microinformáticos y Redes (SMX). Trabajo con negocios locales y con equipos en remoto.",
      aboutCta: "Más sobre mí",
      cv: "Descargar CV (PDF)",
      faqEyebrow: "Preguntas frecuentes",
      faqTitle: "Dudas antes de empezar.",
      finalTitle: "Hablemos de tu web.",
      finalText: "Cuéntame tu negocio y qué necesitas. Respondo en días laborables, normalmente en menos de 24 horas.",
      finalCta: "Escríbeme",
      finalCta2: "Cuestionario detallado",
      finalCta3: "Página de contacto",
      avail: "Disponible para proyectos",
    };

const local = services.find((s) => s.id === "digitalitzacio-local")!;
const landing = services.find((s) => s.id === "landing-page")!;
const webapp = services.find((s) => s.id === "angular-webapp")!;
const audit = services.find((s) => s.id === "performance-audit")!;

const faqs = isEn
  ? [
      { q: "How much does a website cost?", a: `Prices start at ${euro(local.creationPriceNumber)} for the local business pack (digital menu, Google Maps and social profiles) and at ${euro(landing.creationPriceNumber)} for a high-performance landing page. Web applications start at ${euro(webapp.creationPriceNumber)}. Each plan adds a monthly maintenance fee (${monthly(local.monthlyFeeNumber)} for the local pack, ${monthly(landing.monthlyFeeNumber)} for the landing page) with a one-year minimum.` },
      { q: "How long does it take?", a: `The local business pack takes ${local.timeline.toLowerCase()}; a landing page, ${landing.timeline.toLowerCase()}; a web application, ${webapp.timeline.toLowerCase()}. Timelines depend on the final scope.` },
      { q: "Can you improve my Google Maps listing and social media?", a: "Yes. The local business pack includes creating or optimising your Google Business Profile and creating or managing Instagram and Facebook profiles, plus periodic updates of prices, seasonal dishes and menus." },
      { q: "Will the website be mine?", a: "Yes. The code is 100% the client's and lives in a repository you own. You don't depend on a closed platform." },
      { q: "Is there a minimum commitment?", a: "Maintenance requires a minimum commitment of one year, as stated in the offer. It lets me provide continuous technical follow-up: updates, incident handling and advice." },
      { q: "Do you only work in Xàtiva and Valencia?", a: "I'm based in Xàtiva and work with clients in Valencia and the surrounding area, but I also work 100% remotely with clients and teams anywhere." },
      { q: "I already have a website that is slow. Can you fix it?", a: `Yes. The optimisation and accessibility service (from ${euro(audit.creationPriceNumber)}) audits Core Web Vitals and accessibility, applies the fixes to your code and delivers a before-and-after report.` },
    ]
  : [
      { q: "¿Cuánto cuesta una página web?", a: `Los precios parten de ${euro(local.creationPriceNumber)} para el pack de negocio local (carta digital, Google Maps y redes) y de ${euro(landing.creationPriceNumber)} para una landing page de alto rendimiento. Las aplicaciones web parten de ${euro(webapp.creationPriceNumber)}. Cada plan suma una cuota mensual de mantenimiento (${monthly(local.monthlyFeeNumber)} el pack local, ${monthly(landing.monthlyFeeNumber)} la landing) con permanencia mínima de un año.` },
      { q: "¿Cuánto se tarda?", a: `El pack de negocio local, ${local.timeline.toLowerCase()}; una landing page, ${landing.timeline.toLowerCase()}; una aplicación web, ${webapp.timeline.toLowerCase()}. Los plazos dependen del alcance final.` },
      { q: "¿Podéis mejorar mi ficha de Google Maps y mis redes sociales?", a: "Sí. El pack de negocio local incluye crear u optimizar la ficha de Google Business Profile y crear o gestionar los perfiles de Instagram y Facebook, además de la actualización periódica de precios, platos de temporada y menús." },
      { q: "¿La web será mía?", a: "Sí. El código es 100 % del cliente y queda en un repositorio de tu propiedad. No dependes de una plataforma cerrada." },
      { q: "¿Hay permanencia?", a: "El mantenimiento requiere una permanencia mínima de un año, tal como se indica en la oferta. Permite dar continuidad al seguimiento técnico: actualizaciones, incidencias y asesoramiento." },
      { q: "¿Solo trabajas en Xàtiva y Valencia?", a: "Estoy en Xàtiva y trabajo con clientes de Valencia y alrededores, pero también trabajo 100 % en remoto con clientes y equipos de cualquier lugar." },
      { q: "Ya tengo una web lenta. ¿Se puede arreglar?", a: `Sí. El servicio de optimización y accesibilidad (desde ${euro(audit.creationPriceNumber)}) audita Core Web Vitals y accesibilidad, aplica las correcciones en tu código y entrega un informe comparativo antes y después.` },
    ];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<Layout
  fresh
  title={isEn ? "Home" : "Inicio"}
  description={
    isEn
      ? "Custom websites, digital menus, Google Maps and Instagram presence for local businesses in Xàtiva and Valencia. From €290. Get a quote."
      : "Creo páginas web a medida, cartas digitales y presencia en Google Maps e Instagram para negocios de Xàtiva y Valencia. Desde 290 €. Pide presupuesto."
  }
  jsonLd={[faqSchema]}
>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden" aria-labelledby="hero-title">
    <div class="grid-dots pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_at_center,#000_30%,transparent_75%)]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute left-1/2 top-0 h-[34rem] w-[60rem] -translate-x-1/2 -translate-y-1/3 rounded-full bg-brand/20 blur-[120px]" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-(--breakpoint-xl) px-4 pb-16 pt-16 text-center sm:px-5 sm:pt-24">
      <p class="chip mx-auto"><span class="pulse-dot h-2 w-2 rounded-full bg-brand"></span>{t.avail} · {t.eyebrow}</p>
      <h1 id="hero-title" class="display mx-auto mt-8 max-w-5xl text-[clamp(2.6rem,8vw,6.5rem)]">
        {t.h1a} <span class="text-brand">{t.h1b}</span>
      </h1>
      <p class="mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-ink/80 sm:text-xl">{t.lead}</p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href={to("/contact")} class="btn btn-brand">{t.cta1} <span aria-hidden="true">→</span></a>
        <a href={to("/pricing")} class="btn btn-white">{t.cta2}</a>
      </div>
    </div>

    <!-- Bento de datos clave -->
    <div class="relative mx-auto grid max-w-(--breakpoint-xl) gap-4 px-4 pb-20 sm:px-5 md:grid-cols-4 md:grid-rows-2">
      <div class="card relative overflow-hidden p-0 md:col-span-1 md:row-span-2">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_30%,rgba(255,255,0,0.28),transparent_65%)]"></div>
        <img src="/img/3.webp" alt="Jaume Tur" width="320" height="320" class="relative mx-auto h-64 w-64 object-contain pt-4 md:h-72 md:w-72" fetchpriority="high" decoding="async" />
        <div class="relative px-6 pb-6 pt-2">
          <p class="font-display text-2xl font-bold text-white">Jaume Tur</p>
          <p class="mt-1 flex items-center gap-1.5 text-sm text-ink/70"><Icon name="bx:map-pin" class="h-4 w-4 text-brand" />Xàtiva · Valencia · {isEn ? "Remote" : "Remoto"}</p>
        </div>
      </div>
      {t.trust.map((x, i) => (
        <div class:list={["card flex flex-col justify-between p-6", i === 0 ? "md:col-span-2" : ""]}>
          <p class:list={["display text-brand", i === 0 ? "text-5xl sm:text-6xl" : "text-3xl sm:text-4xl"]}>{x.big}</p>
          <p class="mt-4 text-sm text-ink/75 sm:text-base">{x.small}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Cinta -->
  <div class="marquee overflow-hidden border-y border-white/10 bg-black py-5 text-white/80" aria-hidden="true">
    <div class="marquee-track flex gap-12 whitespace-nowrap font-display text-xl font-medium tracking-tight">
      {[0, 1].map(() => (
        <div class="flex gap-12">
          {t.marquee.map((w) => (
            <span class="flex items-center gap-12">{w}<span class="text-brand">●</span></span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- ============ SERVICIOS (BENTO) ============ -->
  <section id="servicios" class="scroll-mt-20 px-4 py-24 sm:px-5 sm:py-32" aria-labelledby="svc-title">
    <div class="mx-auto max-w-(--breakpoint-xl)">
      <div class="max-w-3xl reveal-fade-up">
        <p class="eyebrow">{t.svcEyebrow}</p>
        <h2 id="svc-title" class="display mt-4 text-[clamp(2rem,5vw,3.75rem)]">{t.svcTitle}</h2>
        <p class="mt-5 text-lg text-ink/80">{t.svcLead}</p>
      </div>

      <div class="mt-14 grid gap-4 lg:grid-cols-6">
        <article class="card reveal-fade-up relative overflow-hidden p-8 sm:p-10 lg:col-span-4 lg:row-span-2">
          <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-brand/25 blur-[90px]" aria-hidden="true"></div>
          <span class="chip chip-brand relative"><Icon name="bx:star" class="h-4 w-4" />{t.recommended}</span>
          <h3 class="display relative mt-6 text-3xl sm:text-5xl">{featured.name}</h3>
          <p class="relative mt-4 max-w-2xl text-lg leading-relaxed text-ink/80">{featured.tagline}</p>
          <ul class="relative mt-8 grid gap-3 sm:grid-cols-2">
            {featured.features.slice(0, 6).map((f) => (
              <li class="flex gap-2.5 text-[0.95rem] leading-snug text-ink/85">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand text-xs font-bold text-black" aria-hidden="true">✓</span>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <div class="relative mt-10 flex flex-wrap items-end justify-between gap-6 border-t border-white/10 pt-6">
            <div>
              <p class="font-mono text-xs font-bold uppercase tracking-[0.14em] text-brand">{t.from}</p>
              <p class="display text-6xl text-white sm:text-7xl">{euro(featured.creationPriceNumber)}</p>
              <p class="text-ink/75">+ {monthly(featured.monthlyFeeNumber)} · {featured.timeline}</p>
            </div>
            <div class="flex flex-wrap gap-3">
              <a href={to("/contact")} class="btn btn-brand">{t.requestPack}</a>
              <a href={to(`/pricing/${featured.id}`)} class="btn btn-white">{t.seeDetail}</a>
            </div>
          </div>
        </article>

        {others.map((s, i) => (
          <a href={to(`/pricing/${s.id}`)} class:list={["card reveal-fade-up group flex flex-col p-6", i < 2 ? "lg:col-span-2" : "lg:col-span-3"]} style={`transition-delay:${i * 60}ms`}>
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand text-black"><Icon name={s.icon} class="h-6 w-6" /></span>
            <h3 class="mt-5 font-display text-xl font-bold leading-snug text-white">{s.name}</h3>
            <p class="mt-2 flex-1 text-[0.95rem] leading-relaxed text-ink/70">{s.tagline}</p>
            <div class="mt-5 flex items-end justify-between gap-3 border-t border-white/10 pt-4">
              <div>
                <p class="font-display text-2xl font-bold text-brand">{t.from} {euro(s.creationPriceNumber)}</p>
                <p class="text-xs text-ink/65">+ {monthly(s.monthlyFeeNumber)} · {s.timeline}</p>
              </div>
              <span class="text-xl text-white transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
      <p class="mt-10"><a href={to("/pricing")} class="btn btn-white">{t.allPricing} <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <!-- ============ ANTES / DESPUÉS ============ -->
  <section class="border-y border-white/10 bg-[#0c0c11] px-4 py-24 sm:px-5 sm:py-32" aria-labelledby="pain-title">
    <div class="mx-auto max-w-(--breakpoint-xl)">
      <div class="max-w-3xl reveal-fade-up">
        <p class="eyebrow">{t.painEyebrow}</p>
        <h2 id="pain-title" class="display mt-4 text-[clamp(2rem,5vw,3.75rem)]">{t.painTitle}</h2>
      </div>
      <ul class="mt-14 grid gap-4 md:grid-cols-2">
        {t.pain.map((p) => (
          <li class="card reveal-fade-up overflow-hidden">
            <div class="flex items-start gap-3 p-5 text-ink/55">
              <span class="mt-0.5 shrink-0 rounded-md border border-white/20 px-2 py-0.5 font-mono text-[0.68rem] font-bold uppercase tracking-wider">{t.beforeLabel}</span>
              <p class="line-through decoration-white/30">{p.before}</p>
            </div>
            <div class="flex items-start gap-3 border-t border-brand/40 bg-brand/10 p-5">
              <span class="mt-0.5 shrink-0 rounded-md bg-brand px-2 py-0.5 font-mono text-[0.68rem] font-bold uppercase tracking-wider text-black">{t.afterLabel}</span>
              <p class="flex-1 font-display text-lg font-medium leading-snug text-white">{p.after}</p>
              <Icon name={p.icon} class="hidden h-7 w-7 shrink-0 text-brand sm:block" />
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ PROYECTOS (carrusel horizontal) ============ -->
  <section id="proyectos" class="scroll-mt-20 py-24 sm:py-32" aria-labelledby="proj-title">
    <div class="mx-auto max-w-(--breakpoint-xl) px-4 sm:px-5">
      <div class="flex flex-wrap items-end justify-between gap-6 reveal-fade-up">
        <div class="max-w-3xl">
          <p class="eyebrow">{t.projEyebrow}</p>
          <h2 id="proj-title" class="display mt-4 text-[clamp(2rem,5vw,3.75rem)]">{t.projTitle}</h2>
          <p class="mt-5 text-lg text-ink/80">{t.projLead}</p>
        </div>
        <a href={to("/projectes")} class="btn btn-white">{t.allProjects} <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <ul class="mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-6 sm:px-[max(1.25rem,calc((100vw-80rem)/2+1.25rem))]" tabindex="0" aria-label={t.projEyebrow}>
      {projects.map((p) => (
        <li class="w-[82vw] max-w-sm shrink-0 snap-start sm:w-[24rem]">
          <a href={to(`/projectes/${p.id}`)} class="card group flex h-full flex-col overflow-hidden">
            <div class="relative aspect-[16/10] overflow-hidden bg-[#17171d]">
              {projectImages[p.id] ? (
                <img src={projectImages[p.id]} alt={p.data.image.alt} width="1200" height="750" loading="lazy" decoding="async" class="h-full w-full object-cover opacity-90 transition duration-500 group-hover:scale-105 group-hover:opacity-100" />
              ) : (
                <div class="flex h-full w-full items-center justify-center bg-[radial-gradient(circle_at_30%_20%,rgba(255,255,0,0.25),transparent_60%)] p-6"><span class="display text-center text-3xl text-brand">{shortTitle(p.data.title)}</span></div>
              )}
            </div>
            <div class="flex flex-1 flex-col p-5">
              <span class="chip self-start text-[0.7rem]">{p.data.badge}</span>
              <h3 class="mt-3 font-display text-xl font-bold leading-snug text-white">{shortTitle(p.data.title)}</h3>
              <p class="mt-2 line-clamp-3 flex-1 text-[0.92rem] leading-relaxed text-ink/70">{p.data.subtitle}</p>
              <p class="mt-4 text-sm font-semibold text-brand">{t.viewProject} →</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ============ PROCESO (línea de tiempo) ============ -->
  <section id="proceso" class="scroll-mt-20 border-y border-white/10 bg-[#0c0c11] px-4 py-24 sm:px-5 sm:py-32" aria-labelledby="proc-title">
    <div class="mx-auto grid max-w-(--breakpoint-xl) gap-12 lg:grid-cols-12">
      <div class="reveal-fade-up lg:col-span-5">
        <p class="eyebrow">{t.procEyebrow}</p>
        <h2 id="proc-title" class="display mt-4 text-[clamp(2rem,5vw,3.75rem)]">{t.procTitle}</h2>
      </div>
      <ol class="relative space-y-4 lg:col-span-7">
        <div class="absolute bottom-6 left-[1.6rem] top-6 w-px bg-gradient-to-b from-brand via-white/20 to-transparent" aria-hidden="true"></div>
        {t.steps.map((s) => (
          <li class="reveal-fade-up relative flex gap-5">
            <span class="relative z-10 flex h-[3.25rem] w-[3.25rem] shrink-0 items-center justify-center rounded-full border border-brand bg-[#0c0c11] font-mono text-sm font-bold text-brand">{s.n}</span>
            <div class="card flex-1 p-5">
              <h3 class="font-display text-xl font-bold text-white">{s.t}</h3>
              <p class="mt-1.5 text-[0.95rem] leading-relaxed text-ink/75">{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ SOBRE MÍ ============ -->
  <section id="sobre-mi" class="scroll-mt-20 px-4 py-24 sm:px-5 sm:py-32" aria-labelledby="about-title">
    <div class="card relative mx-auto grid max-w-(--breakpoint-xl) items-center gap-8 overflow-hidden p-8 sm:p-12 lg:grid-cols-12">
      <div class="pointer-events-none absolute -left-20 top-1/2 h-80 w-80 -translate-y-1/2 rounded-full bg-brand/20 blur-[100px]" aria-hidden="true"></div>
      <div class="relative lg:col-span-3"><img src="/img/1.webp" alt="Jaume Tur" width="320" height="320" loading="lazy" decoding="async" class="mx-auto h-56 w-56 object-contain" /></div>
      <div class="relative lg:col-span-9">
        <p class="eyebrow">{t.aboutEyebrow}</p>
        <h2 id="about-title" class="display mt-4 text-[clamp(1.9rem,4.5vw,3.25rem)]">{t.aboutTitle}</h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink/80">{t.aboutText}</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href={to("/about")} class="btn btn-brand">{t.aboutCta} <span aria-hidden="true">→</span></a>
          <a href="/docs/CV_Jaume_tur.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-white">{t.cv}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section id="faq" class="scroll-mt-20 border-t border-white/10 bg-[#0c0c11] px-4 py-24 sm:px-5 sm:py-32" aria-labelledby="faq-title">
    <div class="mx-auto grid max-w-(--breakpoint-xl) gap-12 lg:grid-cols-12">
      <div class="reveal-fade-up lg:col-span-4">
        <p class="eyebrow">{t.faqEyebrow}</p>
        <h2 id="faq-title" class="display mt-4 text-[clamp(2rem,4.5vw,3.25rem)]">{t.faqTitle}</h2>
      </div>
      <div class="space-y-3 lg:col-span-8">
        {faqs.map((f) => (
          <details class="group card reveal-fade-up">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 rounded-3xl px-5 py-4 font-display text-lg font-medium leading-snug text-white [&::-webkit-details-marker]:hidden">
              <span>{f.q}</span>
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand text-lg text-black transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="px-5 pb-5 text-base leading-relaxed text-ink/80">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CTA FINAL ============ -->
  <section class="relative overflow-hidden px-4 py-28 text-center sm:px-5 sm:py-36" aria-labelledby="final-title">
    <div class="pointer-events-none absolute left-1/2 top-1/2 h-[28rem] w-[56rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/20 blur-[120px]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-(--breakpoint-xl)">
      <h2 id="final-title" class="display mx-auto max-w-4xl text-[clamp(2.5rem,8vw,6rem)]">{t.finalTitle}</h2>
      <p class="mx-auto mt-6 max-w-xl text-lg text-ink/80">{t.finalText}</p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="mailto:jaumetur3w@gmail.com" class="btn btn-brand">{t.finalCta} <span aria-hidden="true">→</span></a>
        <a href={to("/contact")} class="btn btn-white">{t.finalCta3}</a>
        <a href={isEn ? "/en/briefing/" : "/briefing/"} class="btn btn-white">{t.finalCta2}</a>
      </div>
      <p class="mt-8 font-mono text-sm font-bold text-brand">jaumetur3w@gmail.com</p>
    </div>
  </section>
</Layout>

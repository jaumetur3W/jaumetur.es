  <!-- ==================== FAQ ==================== -->
  <section id="faq" class="scroll-mt-20 border-t border-white/10 bg-[#09090d] px-4 py-20 sm:px-5 sm:py-28" aria-labelledby="faq-title">
    <div class="mx-auto max-w-(--breakpoint-xl)">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="eyebrow">{t.faqEyebrow}</p>
          <h2 id="faq-title" class="display mt-4 text-[clamp(2.1rem,5vw,3.4rem)] text-white">{t.faqTitle}</h2>

---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import CtaBand from "@/components/cta-band.astro";
import ProjectMark from "@/components/project-mark.astro";
import { getServicesData } from "@/data/services";
import { statusLabel, statusNote } from "@/data/project-status";
import { localeFromPath, localizePath } from "@/i18n";

const locale = localeFromPath(Astro.url.pathname);
const isEn = locale === "en";
const to = (path: string) => {
  const [rest, query] = path.split("?");
  const p = localizePath(rest, locale);
  const [base, hash] = p.split("#");
  const b = base === "/" || base.endsWith("/") ? base : `${base}/`;
  return `${b}${query ? `?${query}` : ""}${hash ? `#${hash}` : ""}`;
};

const services = getServicesData(locale);
const euro = (n: number) => (isEn ? `€${n.toLocaleString("en-US")}` : `${n.toLocaleString("es-ES")} €`);

// Solo los dos proyectos insignia reales y demostrables
const rawProjects = await getCollection(isEn ? "projectes-en" : "projectes");
const flagshipProjects = ["avisa", "pizzeria-xativa", "trania", "worksy"]
  .map((id) => rawProjects.find((p) => p.id === id))
  .filter(Boolean) as typeof rawProjects;
const projectImages: Record<string, { src: string; w: number; h: number }> = {
  avisa: { src: "/img/preview-avisa.webp", w: 1200, h: 750 },
  "pizzeria-xativa": { src: "/img/foto_pizza.webp", w: 1200, h: 575 },
  trania: { src: "/img/preview-trania.webp", w: 1200, h: 750 },
  worksy: { src: "/img/preview-worksy.webp", w: 1200, h: 750 },
};
const shortTitle = (x: string) => x.split(" — ")[0];

const WA = "https://wa.me/34644525838?text=Hola%20Jaume,%20quiero%20informaci%C3%B3n%20sobre%20un%20proyecto";

const t = isEn
  ? {
      title: "High-Performance Web Design & Apps in Valencia | Jaume Tur",
      desc: "Custom websites, digital menus and web apps for businesses in Valencia, Xàtiva and Spain. 100% proprietary code and transparent pricing.",
      h1: "Custom websites and web applications built to stand out.",
      lede: "Bespoke web design, interactive digital menus, and tailored web applications. Direct collaboration with the developer, guaranteed fixed quotes, and 100% code ownership with zero lock-in.",
      cta1: "Get a fixed quote", cta2: "Services & pricing from €290", wa: "WhatsApp",
      reply: "Direct reply within 24 business hours.",
      launchLink: "2026 Partner Program · Limited Places",
      svcTitle: "Tailored solutions built for real business growth.",
      svcLede: "Every service package features transparent creation fees and comprehensive technical maintenance. Zero lock-in, zero hidden charges.",
      allPrices: "See all plans & pricing",
      from: "From", delivery: "Timeline", more: "What's included",
      whyTitle: "Why work directly with an engineer, not a traditional agency.",
      why: [
        { t: "Direct author contact", d: "You collaborate directly with the engineer designing and programming your platform. No account managers, no broken telephone." },
        { t: "100% Code ownership", d: "You receive the full Git repository, domain, and credentials in your name. You own your digital asset outright, with no platform captivity." },
        { t: "Extreme speed (<1s) & SEO", d: "Modern Astro & TypeScript architecture achieving 95-100 on Google Core Web Vitals, securing top positions in local search." },
      ],
      projTitle: "Featured projects & live interactive demos.",
      projLede: "Real client projects engineered for speed, clean UX and measurable business impact. Test them live.",
      viewStudy: "View case study", live: "Open live project", allProjects: "All projects",
      procTitle: "A surgical process, from concept to production.",
      steps: [
        { n: "1", t: "Strategy & Scope", d: "We define your commercial goals, architectural scope and a guaranteed fixed price before writing a single line of code." },
        { n: "2", t: "Custom Engineering", d: "Modern frontend development with continuous interactive previews so you validate progress in real time." },
        { n: "3", t: "Performance & Local SEO", d: "Exhaustive Google Business Profile setup, Schema structured data, WCAG AA accessibility and Core Web Vitals tuning." },
        { n: "4", t: "Zero-Downtime Launch", d: "Production launch and official handover of your complete Git repository and operational accounts." },
      ],
      launchTag: "Partner Program 2026 · 3 Priority Slots",
      launchTitle: "Upgrade your business with top-tier digital architecture.",
      launchText: "Each quarter, I select 3 representative local businesses in Valencia to craft flagship case studies. I fully subsidize the initial architecture fees to demonstrate the tangible revenue impact of high-end frontend engineering; you only cover basic infrastructure (domain & hosting) and agree to share the success metrics.",
      launchNote: "Selective application process. All scope and terms confirmed in writing prior to kickoff. Open to hospitality, local commerce and service companies.",
      launchCta: "Apply for a partner slot",
      aboutTitle: "Jaume Tur — Creative Frontend Engineer & Web Designer.",
      aboutText: "Specialized in ultra-lightweight frontend architectures, universal accessibility (WCAG AA), and high-conversion UI. Certified in Web Application Development (CFGS DAW) and Microcomputer Systems & Networks (GM SMX).",
      aboutCta: "More about my work", cv: "Download CV (PDF)",
      faqTitle: "Frequently asked questions.",
      faqs: [
        { q: "How does the Partner Program work?", a: "To build impactful benchmark case studies, I create selected digital architectures subsidizing the initial development fees. In exchange, the project is showcased in my portfolio and you only cover direct domain and hosting fees. Places are strictly limited." },
        { q: "What are your standard rates?", a: "Professional custom work with full transparency: digital menu & local setups start at €290, high-converting landing pages from €490, and custom web applications from €950+, plus ongoing maintenance." },
        { q: "Will I truly own my website's code?", a: "Yes, 100%. The source code is handed over in a private Git repository under your ownership, alongside your domain and DNS, free from proprietary site builders." },
        { q: "What are the typical turnaround times?", a: "Local digital menus take 3 to 5 business days, landing pages 1 to 2 weeks, and custom web apps 3 to 6 weeks. Timelines are contractually fixed before kickoff." },
        { q: "Do you only serve businesses in Valencia?", a: "I am based in Xàtiva and meet in person throughout the Valencia metropolitan area, while also working remotely with companies across Spain." },
      ],
      finalTitle: "Ready for a website that actually drives revenue?",
      finalText: "Tell me about your business and I'll send you a fixed scope, guaranteed quote, and delivery date within 24 hours.",
      finalWa: "Message on WhatsApp", finalForm: "Send request form",
    }
  : {
      title: "Diseño Web & Apps de Alto Rendimiento en Valencia | Jaume Tur",
      desc: "Webs a medida, cartas interactivas y aplicaciones para negocios de Valencia, Xàtiva y toda España. Código 100% propio y precios cerrados.",
      h1: "Webs y aplicaciones a medida para negocios que van en serio.",
      lede: "Diseño y programación web con código propio, alta velocidad y posicionamiento en Google. Hablas directamente con quien programa tu proyecto, con precio cerrado antes de empezar y el código 100% en tu propiedad.",
      cta1: "Pedir presupuesto cerrado", cta2: "Ver servicios desde 290 €", wa: "WhatsApp",
      reply: "Respuesta directa en menos de 24 horas laborables.",
      launchLink: "Programa Partner 2026 · Plazas Preferentes",
      svcTitle: "Soluciones a medida para hacer crecer tu negocio.",
      svcLede: "Cada servicio tiene un alcance definido, precio de creación transparente y mantenimiento técnico integral. Sin sorpresas ni costes ocultos.",
      allPrices: "Ver todos los precios y planes",
      from: "Desde", delivery: "Plazo", more: "Qué incluye",
      whyTitle: "Por qué trabajar directamente con un ingeniero, sin agencias intermediarias.",
      why: [
        { t: "Trato directo de autor", d: "Hablas y trabajas directamente con la persona que diseña y programa tu plataforma. Cero comerciales, cero pérdidas de tiempo." },
        { t: "Código 100% en tu propiedad", d: "Te entrego el repositorio Git íntegro, el dominio y los accesos a tu nombre. Eres el dueño absoluto de tu activo digital, sin plataformas cautivas." },
        { t: "Velocidad extrema (<1s) & SEO", d: "Arquitectura moderna en Astro y TypeScript que arrasa en Google Core Web Vitals (95-100) y te coloca en las primeras posiciones locales." },
      ],
      projTitle: "Casos de estudio y demos interactivas.",
      projLede: "Proyectos reales diseñados con rigor técnico. Pruébalos en vivo, comprueba su fluidez y audita su código.",
      viewStudy: "Ver caso de estudio", live: "Abrir demo en línea", allProjects: "Todos los proyectos",
      procTitle: "Un proceso quirúrgico, de la idea a producción.",
      steps: [
        { n: "1", t: "Estrategia & Alcance", d: "Definimos tus objetivos comerciales, estructura y precio cerrado por escrito antes de picar una sola línea de código." },
        { n: "2", t: "Diseño & Ingeniería", d: "Desarrollo a medida con previsualizaciones interactivas continuas para que valides cada paso del camino." },
        { n: "3", t: "Optimización & SEO Local", d: "Configuración exhaustiva de Google Business, datos estructurados Schema, accesibilidad WCAG AA y Core Web Vitals." },
        { n: "4", t: "Lanzamiento & Entrega Git", d: "Despliegue con cero caídas y entrega formal de todas las credenciales y repositorio a tu nombre." },
      ],
      launchTag: "Programa Partner 2026 · 3 Plazas Preferentes",
      launchTitle: "Impulsa tu negocio con una arquitectura digital de primer nivel.",
      launchText: "Cada trimestre selecciono 3 proyectos locales emblemáticos en Valencia y comarcas para crear casos de estudio de referencia. Bonifico los honorarios de arquitectura inicial para demostrar el impacto medible de una web de élite; tú solo cubres la infraestructura básica (dominio y hosting) y permites publicar las métricas del caso de éxito.",
      launchNote: "Acceso limitado bajo validación de proyecto. Las condiciones se formalizan por escrito antes de iniciar. Abierto a hostelería, comercios y empresas de servicios.",
      launchCta: "Candidatar mi proyecto",
      aboutTitle: "Jaume Tur — Creative Frontend Engineer & Diseñador Web.",
      aboutText: "Especializado en arquitecturas frontend ultraligeras, accesibilidad universal y diseño orientado a conversión. Ayudo a negocios tradicionales y marcas innovadoras a destacar frente a su competencia con tecnología moderna.",
      aboutCta: "Conoce mi trayectoria", cv: "Descargar CV (PDF)",
      faqTitle: "Dudas frecuentes antes de empezar.",
      faqs: [
        { q: "¿Cómo funciona el Programa Partner?", a: "Para ampliar mi portfolio con casos de estudio emblemáticos, construyo plataformas seleccionadas bonificando los honorarios de desarrollo inicial. A cambio, el proyecto se muestra en mi portfolio y tú solo abonas los costes directos de hosting y dominio." },
        { q: "¿Cuáles son las tarifas habituales?", a: "Trabajo profesional con tarifas publicadas y transparentes: digitalización local y cartas desde 290 €, landing pages desde 490 € y aplicaciones web a medida desde 950 €, más mantenimiento." },
        { q: "¿El código y las cuentas serán 100% míos?", a: "Sí, sin letra pequeña. Se entrega un repositorio Git con todo el código fuente y las cuentas de hosting y dominio a tu nombre, sin ataduras a plataformas propietarias." },
        { q: "¿Cuánto se tarda en completar un proyecto?", a: "Digitalización local y cartas: 3 a 5 días laborables; landing pages: 1 a 2 semanas; aplicaciones a medida: 3 a 6 semanas. El plazo se firma antes de empezar." },
        { q: "¿Trabajas solo en Xàtiva o en toda Valencia?", a: "Tengo base en Xàtiva y me desplazo para reuniones presenciales en toda el área de Valencia y comarcas, además de trabajar 100% en remoto con proyectos de toda España." },
      ],
      finalTitle: "¿Listo para que tu web empiece a generar resultados?",
      finalText: "Cuéntame qué necesita tu negocio y te respondo con alcance, precio cerrado y plazo de entrega en menos de 24 horas.",
      finalWa: "Escribir por WhatsApp", finalForm: "Solicitar propuesta",
    };

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": t.faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<Layout fresh title={t.title} description={t.desc} jsonLd={[faqSchema]}>
  <!-- 1. Hero editorial & arquitectónico: mensaje claro, garantías y panel de especialización de estudio -->
  <section class="band-paper relative isolate overflow-hidden pt-20 pb-16 sm:pt-28 sm:pb-24 lg:pt-24 lg:pb-20" aria-labelledby="hero-title">
    <div class="w-full max-w-[94rem] mx-auto px-5 sm:px-8 lg:px-12 xl:px-16 grid items-center gap-12 lg:grid-cols-12 lg:gap-12 xl:gap-16 min-h-[80vh] lg:min-h-[88vh]">
      
      <!-- Columna izquierda: mensaje contundente, beneficios y llamada a la acción -->
      <div class="lg:col-span-6 xl:col-span-6 flex flex-col justify-center items-start order-2 lg:order-1 pt-4 lg:pt-0 z-10">
        
        <!-- Badge de disponibilidad en vivo -->
        <div class="flex items-center gap-3 mb-6 flex-wrap">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-ink/10 text-xs font-mono font-semibold uppercase tracking-wider text-ink shadow-sm">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-teal-600"></span>
            </span>
            {isEn ? "Open for 2026 projects" : "Disponible 2026 · Trato directo"}
          </span>
          <span class="note text-xs tracking-wider !text-brand" aria-hidden="true">{isEn ? "Valencia & Remote" : "Xàtiva · Valencia · Remoto"}</span>
        </div>

        <h1 id="hero-title" class="font-display text-4xl sm:text-6xl lg:text-[3.6rem] xl:text-[4.2rem] font-extrabold leading-[1.04] tracking-[-0.04em] text-ink" data-split>
          {isEn ? (
            <>
              Custom websites and apps<br />
              <span class="text-brand inline-block">built to stand out.</span>
            </>
          ) : (
            <>
              Webs y aplicaciones a medida<br />
              <span class="text-brand inline-block">para negocios que van en serio.</span>
            </>
          )}
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-ink/85 max-w-xl leading-relaxed">
          {t.lede}
        </p>

        <!-- Botones de acción principales -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href={to("/contact")} class="btn btn-brand !min-h-[3.6rem] !px-8 text-sm tracking-wider uppercase font-extrabold shadow-lg hover:shadow-xl transition-all" data-cursor={isEn ? "Quote" : "Presupuesto"}>
            {t.cta1} <span aria-hidden="true">→</span>
          </a>
          <a href="#servicios" class="btn btn-white !min-h-[3.6rem] !px-8 text-sm tracking-wider uppercase font-bold border border-ink/15 hover:border-ink/30 transition-all">
            {t.cta2}
          </a>
        </div>

        <!-- Enlace rápido a WhatsApp -->
        <div class="mt-4 flex items-center gap-2">
          <a href={WA} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-teal-800 hover:text-brand transition-colors py-1">
            <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span>
            <span>{isEn ? "Prefer WhatsApp? Direct chat in 1 click →" : "¿Prefieres WhatsApp? Escríbeme en 1 clic →"}</span>
          </a>
        </div>

        <!-- Barra de 3 garantías tangibles -->
        <div class="mt-8 pt-5 border-t border-ink/10 w-full max-w-xl">
          <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-mono uppercase tracking-wider text-ink/80">
            <li class="inline-flex items-center gap-1.5 font-medium">
              <span class="text-teal-600 font-bold" aria-hidden="true">✓</span> {isEn ? "100% Code ownership (Git)" : "Código 100% tuyo (Git)"}
            </li>
            <li class="inline-flex items-center gap-1.5 font-medium">
              <span class="text-teal-600 font-bold" aria-hidden="true">✓</span> {isEn ? "Fixed guaranteed quote" : "Precio cerrado antes de empezar"}
            </li>
            <li class="inline-flex items-center gap-1.5 font-medium">
              <span class="text-teal-600 font-bold" aria-hidden="true">✓</span> {isEn ? "No captive platforms" : "Sin ataduras a plataformas"}
            </li>
          </ul>
        </div>
      </div>

      <!-- Columna derecha: Ficha técnica y catálogo de soluciones de estudio (reemplaza imagen y clichés) -->
      <div class="lg:col-span-6 xl:col-span-6 flex flex-col justify-center order-1 lg:order-2 w-full max-w-2xl mx-auto lg:ml-auto">
        <div class="bg-white rounded-3xl border border-ink/10 shadow-xl p-6 sm:p-8 lg:p-9 relative overflow-hidden">
          
          <!-- Cabecera de la ficha: Identificador de estudio -->
          <div class="flex items-center justify-between pb-5 border-b border-ink/10 flex-wrap gap-2">
            <div class="flex items-center gap-2.5">
              <span class="w-2.5 h-2.5 rounded-full bg-brand"></span>
              <span class="font-mono text-xs uppercase tracking-widest font-bold text-ink">
                {isEn ? "Studio Spec & Services · 2026" : "Especialización & Servicios · 2026"}
              </span>
            </div>
            <span class="font-mono text-[0.75rem] text-ink/60 uppercase tracking-wider">
              {isEn ? "Direct engineering · No middlemen" : "Ingeniería directa · Sin comerciales"}
            </span>
          </div>

          <!-- Lista de 3 soluciones con precio y plazo transparente -->
          <div class="mt-5 space-y-3.5">
            
            <!-- Item 1: Cartas y hostelería -->
            <a href="#servicios" class="group block p-4 rounded-2xl bg-paper/70 hover:bg-white border border-ink/5 hover:border-brand/40 hover:shadow-md transition-all duration-200">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="font-mono text-xs font-bold text-brand uppercase tracking-wider">01</span>
                    <h2 class="font-display text-base font-bold text-ink group-hover:text-brand transition-colors">
                      {isEn ? "Digital QR Menus & Local Commerce" : "Cartas Digitales QR & Hostelería"}
                    </h2>
                  </div>
                  <p class="mt-1 text-xs text-ink/75 leading-relaxed">
                    {isEn ? "Mobile-first tactile menu, allergen management, and instant updates." : "Navegación táctil para móvil, gestión de alérgenos y cambios al momento sin cuotas forzadas."}
                  </p>
                </div>
                <div class="text-right shrink-0">
                  <span class="block font-mono text-xs sm:text-sm font-bold text-ink">{isEn ? "From €290" : "Desde 290 €"}</span>
                  <span class="block font-mono text-[0.7rem] text-ink/60 uppercase">{isEn ? "3–5 days" : "3–5 días"}</span>
                </div>
              </div>
            </a>

            <!-- Item 2: Webs corporativas y captación -->
            <a href="#servicios" class="group block p-4 rounded-2xl bg-paper/70 hover:bg-white border border-ink/5 hover:border-brand/40 hover:shadow-md transition-all duration-200">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="font-mono text-xs font-bold text-brand uppercase tracking-wider">02</span>
                    <h2 class="font-display text-base font-bold text-ink group-hover:text-brand transition-colors">
                      {isEn ? "Corporate Websites & Landing Pages" : "Webs Corporativas & Landing Pages"}
                    </h2>
                  </div>
                  <p class="mt-1 text-xs text-ink/75 leading-relaxed">
                    {isEn ? "Custom architecture, local Google positioning and high conversion design for SMEs." : "Diseño exclusivo, posicionamiento local en Google y enfoque directo a captación de clientes."}
                  </p>
                </div>
                <div class="text-right shrink-0">
                  <span class="block font-mono text-xs sm:text-sm font-bold text-ink">{isEn ? "From €490" : "Desde 490 €"}</span>
                  <span class="block font-mono text-[0.7rem] text-ink/60 uppercase">{isEn ? "1–2 weeks" : "1–2 semanas"}</span>
                </div>
              </div>
            </a>

            <!-- Item 3: Software a medida -->
            <a href="#servicios" class="group block p-4 rounded-2xl bg-paper/70 hover:bg-white border border-ink/5 hover:border-brand/40 hover:shadow-md transition-all duration-200">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="font-mono text-xs font-bold text-brand uppercase tracking-wider">03</span>
                    <h2 class="font-display text-base font-bold text-ink group-hover:text-brand transition-colors">
                      {isEn ? "Custom Web Apps & Internal Tools" : "Aplicaciones Web & Software a Medida"}
                    </h2>
                  </div>
                  <p class="mt-1 text-xs text-ink/75 leading-relaxed">
                    {isEn ? "Work orders, employee timesheets and business management portals (e.g. AVISA, Worksy, Trania)." : "Partes de trabajo, control de fichajes, reservas y paneles privados (ej. AVISA, Worksy, Trania)."}
                  </p>
                </div>
                <div class="text-right shrink-0">
                  <span class="block font-mono text-xs sm:text-sm font-bold text-ink">{isEn ? "From €950" : "Desde 950 €"}</span>
                  <span class="block font-mono text-[0.7rem] text-ink/60 uppercase">{isEn ? "3–6 weeks" : "3–6 semanas"}</span>
                </div>
              </div>
            </a>

          </div>

          <!-- Pie de la ficha: Compromiso y salto a demos reales -->
          <div class="mt-5 pt-4 border-t border-ink/10 flex items-center justify-between flex-wrap gap-2 text-xs font-mono">
            <span class="text-ink/80 flex items-center gap-1.5">
              <span class="text-teal-600 font-bold">✓</span>
              {isEn ? "100% proprietary code" : "Código y accesos 100% a tu nombre"}
            </span>
            <a href="#proyectos" class="text-brand font-bold hover:underline inline-flex items-center gap-1">
              {isEn ? "Inspect real projects ↓" : "Ver proyectos reales ↓"}
            </a>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- 4. Proyectos: muchas piezas medianas en marcos pequeños -->
  <section id="proyectos" class="band-ink section scroll-mt-20 py-20 sm:py-28" aria-labelledby="proj-title">
    <div class="wrap">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <h2 id="proj-title" class="h-section" data-reveal>{t.projTitle}</h2>
          <p class="lede mt-3">{t.projLede}</p>
          <span class="note mt-3 !text-[#FF7A50] font-mono text-xs uppercase tracking-wider" aria-hidden="true">{isEn ? "100% auditable in production" : "100% auditables en producción"}</span>
        </div>
        <a href={to("/projectes")} class="btn btn-brand shrink-0">{t.allProjects} <span aria-hidden="true">→</span></a>
      </div>

      <ul class="folders mt-16" data-stagger>
        {flagshipProjects.map((p, i) => {
          const img = projectImages[p.id];
          return (
            <li class="folder-slot">
              <a href={to(`/projectes/${p.id}`)} class="folder" data-cursor={isEn ? "Open" : "Abrir"} aria-label={`${shortTitle(p.data.title)}: ${isEn ? "open case study" : "abrir caso de estudio"}`}>
                <span class="folder-tab"><b>{String(i + 1).padStart(2, "0")}</b> · {shortTitle(p.data.title)}</span>
                <span class="folder-sheet" aria-hidden="true">
                  <img src={img.src} width={img.w} height={img.h} alt="" loading="lazy" decoding="async" />
                </span>
                <span class="folder-body">
                  <span class="folder-status">{statusLabel(p.id, isEn)}</span>
                  <span class="tag">{p.data.badge}</span>
                  <span class="folder-title">{shortTitle(p.data.title)}</span>
                  <span class="folder-text">{p.data.subtitle}</span>
                  <span class="folder-meta">{p.data.stack?.slice(0, 3).join(" · ")}</span>
                  <span class="folder-open">{t.viewStudy} <span aria-hidden="true">→</span></span>
                </span>
              </a>
              <span class="folder-note font-hand" aria-hidden="true">{statusNote(p.id, isEn)}</span>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- 2. Servicios: una tarjeta por servicio; el scroll las recorre en horizontal -->
  <section id="servicios" class="band-clay svc-h scroll-mt-20 py-20 sm:py-28" aria-labelledby="svc-title" data-svc>
    <div class="svc-pin">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <h2 id="svc-title" class="h-section" data-reveal>{t.svcTitle}</h2>
            <p class="lede mt-3">{t.svcLede}</p>
          </div>
          <a href={to("/pricing")} class="btn btn-dark shrink-0">{t.allPrices} <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <ul class="svc-track wrap" data-svc-track>
        {services.map((s, i) => (
          <li class="svc-card">
            <a href={to(`/pricing/${s.id}`)} class="glass is-hoverable flex h-full flex-col p-6 sm:p-7 group" data-tilt data-cursor={isEn ? "Open" : "Ver"}>
              <div class="flex items-center justify-between gap-3">
                <span class="label">N.º {String(i + 1).padStart(2, "0")}</span>
                <span class="label bg-paper/80 px-2 py-0.5 rounded-sm border border-ink/10">{s.timeline}</span>
              </div>
              <span class="mt-4 block font-display text-[1.5rem] uppercase leading-[1.05] group-hover:text-ink">{s.name}</span>
              <span class="muted mt-2.5 text-[0.92rem] leading-snug">{s.tagline}</span>

              {s.features && s.features.length > 0 && (
                <ul class="mt-4 space-y-1.5 border-t border-white/10 pt-3 text-xs text-slate-300">
                  {s.features.slice(0, 3).map((feat) => (
                    <li class="flex items-start gap-1.5 leading-snug">
                      <span class="text-brand font-bold shrink-0" aria-hidden="true">✓</span>
                      <span class="line-clamp-1">{feat}</span>
                    </li>
                  ))}
                </ul>
              )}

              <span class="mt-auto flex items-end justify-between gap-3 pt-6 border-t border-white/10">
                <span>
                  <span class="label block !text-slate-400">{t.from}</span>
                  <span class="num font-display text-[2.1rem] leading-none text-white font-bold">{euro(s.creationPriceNumber)}</span>
                </span>
                <span class="text-[0.875rem] font-bold text-brand underline decoration-2 underline-offset-4 hover:text-white transition-all">{t.more} <span aria-hidden="true">→</span></span>
              </span>
            </a>
          </li>
        ))}
        <li class="svc-card">
          <div class="glass flex h-full flex-col justify-between p-6 sm:p-7 shadow-xs border border-white/15 bg-white/5" data-tilt>
            <div>
              <p class="tag mb-4 !bg-brand !text-white !border-transparent">100% a medida</p>
              <p class="font-display text-[1.6rem] uppercase leading-[1.02] text-white">{isEn ? "Not sure which one?" : "¿No sabes cuál?"}</p>
              <p class="mt-3 text-[0.95rem] leading-snug text-slate-300">{isEn ? "Tell me about your business and I'll recommend the smallest plan that works." : "Cuéntame tu negocio y te recomiendo el plan más pequeño que funcione."}</p>
            </div>
            <a href={to("/contact")} class="btn btn-brand btn-sm mt-8 self-start">{t.cta1} <span aria-hidden="true">→</span></a>
          </div>
        </li>
      </ul>
    </div>
  
  <!-- 3. Por qué: tres compromisos de valor -->
  <div class="mt-16 sm:mt-24">
    <div class="wrap">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <span class="note mb-2 block text-lg" aria-hidden="true">{isEn ? "direct value ↓" : "compromiso directo ↓"}</span>
          <h2 id="why-title" class="h-section max-w-3xl" data-reveal>{t.whyTitle}</h2>
        </div>
      </div>
      <div class="grid gap-5 md:grid-cols-3" data-stagger>
        {t.why.map((w, i) => (
          <div class="glass p-6 sm:p-7 flex flex-col justify-between hover:border-ink/40 transition-colors" data-tilt>
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="tag !bg-ink !text-paper font-mono font-bold">{String(i + 1).padStart(2, "0")}</span>
                <span class="label font-mono text-[0.7rem] text-ink/60">Garantía #{i + 1}</span>
              </div>
              <h3 class="font-display text-[1.35rem] uppercase leading-tight font-bold">{w.t}</h3>
              <p class="muted mt-3 text-[0.95rem] leading-relaxed">{w.d}</p>
            </div>
            <div class="mt-6 pt-4 border-t border-ink/10 flex items-center justify-between text-xs font-mono text-ink/70">
              <span>{i === 0 ? "100% Personal" : i === 1 ? "100% Propietario" : "Sin Sorpresas"}</span>
              <span class="text-brand font-bold">✓</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  </section>

  <!-- 5. Proceso + oferta de lanzamiento -->
  <section class="band-paper section py-20 sm:py-28" aria-labelledby="proc-title">
    <div class="wrap">
      <h2 id="proc-title" class="h-section max-w-3xl" data-reveal>{t.procTitle}</h2>
      <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {t.steps.map((s) => (
          <li class="step-card">
            <p class="font-display text-[2.6rem] font-bold leading-none text-brand"><span class="sr-only">{isEn ? "Step" : "Paso"} </span>{s.n}</p>
            <h3 class="mt-3 font-display text-[1.05rem] uppercase leading-tight">{s.t}</h3>
            <p class="muted mt-2 text-[0.92rem]">{s.d}</p>
          </li>
        ))}
      </ol>

      <div id="lanzamiento" class="mt-20 scroll-mt-24 rounded-2xl bg-gradient-to-br from-[#12141A] to-[#1E222D] text-white p-8 sm:p-12 border border-white/10 shadow-2xl grid gap-8 lg:grid-cols-12 items-center" data-tilt>
        <div class="lg:col-span-8">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand/20 text-[#FF7A50] border border-brand/35 text-xs font-mono font-bold uppercase tracking-wider">{t.launchTag}</span>
          <h2 id="launch-title" class="h-section mt-4 text-white font-extrabold">{t.launchTitle}</h2>
          <p class="mt-4 max-w-2xl text-[1.05rem] leading-relaxed text-slate-300">{t.launchText}</p>
          <p class="mt-3 max-w-2xl text-[0.875rem] leading-relaxed text-slate-400">{t.launchNote}</p>
        </div>
        <div class="flex lg:col-span-4 lg:items-end lg:justify-end">
          <a href={to("/contact?servei=lanzamiento")} class="btn btn-brand w-full sm:w-auto !min-h-[3.25rem] !px-8 text-sm font-extrabold uppercase tracking-wider shadow-lg hover:shadow-brand/35 transition-all">{t.launchCta} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Quién + preguntas (fondo negro) -->
  <section class="band-ink section" aria-labelledby="about-title">
    <div class="wrap grid items-center gap-8 lg:grid-cols-12">
      <div class="lg:col-span-3">
        <img src="/img/jaume-tur-desarrollador-web.webp" alt="Jaume Tur" width="320" height="320" loading="lazy" decoding="async" class="mx-auto -mb-6 block w-40 sm:w-56 lg:mx-0 lg:w-72" />
      </div>
      <div class="lg:col-span-9">
        <h2 id="about-title" class="h-section" data-reveal>{isEn ? <>Jaume Tur, web developer in <span class="hl">Xàtiva</span>.</> : <>Jaume Tur, desarrollador web en <span class="hl">Xàtiva</span>.</>}</h2>
        <p class="lede mt-4">{t.aboutText}</p>
        <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-1">
          <a href={to("/about")} class="link-arrow min-h-11">{t.aboutCta} <span aria-hidden="true">→</span></a>
          <a href="/docs/CV_Jaume_tur.pdf" target="_blank" rel="noopener noreferrer" class="link-arrow min-h-11">{t.cv} <span aria-hidden="true">↗</span><span class="sr-only"> ({isEn ? "opens in a new tab" : "se abre en pestaña nueva"})</span></a>
        </div>
      </div>
    </div>

    <div class="wrap mt-16 grid gap-8 lg:grid-cols-12">
      <h2 id="faq-title" class="h-section lg:col-span-4" data-reveal>{t.faqTitle}</h2>
      <div class="lg:col-span-8">
        {t.faqs.map((f) => (
          <details class="faq group border-t-[1.5px] border-white/30 last:border-b-[1.5px] last:border-white/30">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-3.5 font-display text-[1.05rem] uppercase leading-tight hover:text-brand sm:text-[1.15rem] [&::-webkit-details-marker]:hidden">
              <span>{f.q}</span>
              <span class="relative h-4 w-4 shrink-0" aria-hidden="true">
                <span class="absolute left-0 top-1/2 h-[3px] w-4 -translate-y-1/2 bg-current"></span>
                <span class="absolute left-1/2 top-0 h-4 w-[3px] -translate-x-1/2 bg-current transition-transform duration-200 group-open:scale-y-0"></span>
              </span>
            </summary>
            <p class="max-w-2xl pb-5 pr-10 leading-relaxed text-white/80">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. Cierre -->
  <CtaBand
    title={t.finalTitle}
    text={t.finalText}
    primary={{ href: WA, label: t.finalWa, external: true }}
    secondary={{ href: to("/contact"), label: t.finalForm }}
  />
</Layout>

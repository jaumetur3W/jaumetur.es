---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import CtaBand from "@/components/cta-band.astro";
import ProjectMark from "@/components/project-mark.astro";
import { getServicesData } from "@/data/services";
import { localeFromPath, localizePath } from "@/i18n";

const locale = localeFromPath(Astro.url.pathname);
const isEn = locale === "en";
const to = (path: string) => {
  const [rest, query] = path.split("?");
  const p = localizePath(rest, locale);
  const [base, hash] = p.split("#");
  const b = base === "/" || base.endsWith("/") ? base : `${base}/`;
  return `${b}${query ? `?${query}` : ""}${hash ? `#${hash}` : ""}`;
};

const services = getServicesData(locale);
const euro = (n: number) => (isEn ? `€${n.toLocaleString("en-US")}` : `${n.toLocaleString("es-ES")} €`);

// Solo los dos proyectos insignia reales y demostrables
const rawProjects = await getCollection(isEn ? "projectes-en" : "projectes");
const flagshipProjects = ["avisa", "pizzeria-xativa", "trania", "worksy"]
  .map((id) => rawProjects.find((p) => p.id === id))
  .filter(Boolean) as typeof rawProjects;
const projectImages: Record<string, { src: string; w: number; h: number }> = {
  avisa: { src: "/img/preview-avisa.webp", w: 1200, h: 750 },
  "pizzeria-xativa": { src: "/img/foto_pizza.webp", w: 1200, h: 575 },
  trania: { src: "/img/preview-trania.webp", w: 1200, h: 750 },
  worksy: { src: "/img/preview-worksy.webp", w: 1200, h: 750 },
};
const shortTitle = (x: string) => x.split(" — ")[0];

const WA = "https://wa.me/34644525838?text=Hola%20Jaume,%20quiero%20informaci%C3%B3n%20sobre%20un%20proyecto";

const t = isEn
  ? {
      title: "Custom Web Design in Xàtiva and Valencia | Jaume Tur",
      desc: "Custom websites, digital menus and web apps for businesses in Xàtiva, Valencia and across Spain, built by the developer you talk to. Quote and launch offer for the first clients.",
      h1: "Custom websites and web apps in Xàtiva and Valencia.",
      lede: "Built and maintained by the same person who answers you. Websites, digital menus and web applications for businesses in Xàtiva, Valencia and the rest of Spain; price and scope are fixed before we start, and the code and accounts are yours.",
      cta1: "Get a quote", cta2: "See services & pricing", wa: "WhatsApp",
      reply: "Reply within 24 business hours.",
      launchLink: "Launch offer for the first clients",
      svcTitle: "Five services for your business.",
      svcLede: "Every service has a published creation price and a monthly maintenance fee (one-year minimum); you can see them on each card and on each service page. Scope and timeline are confirmed with you before starting.",
      allPrices: "See all prices",
      from: "From", delivery: "Delivery", more: "See what's included",
      whyTitle: "Whoever answers you is whoever builds it.",
      why: [
        { t: "Direct contact", d: "You talk to the person who designs and programs your site. No sales reps, no subcontracting." },
        { t: "Everything is yours", d: "Source code, Git repository, domain and accounts are handed over in your name. No captive platforms." },
        { t: "Price fixed up front", d: "You see what's included and what it costs before asking for anything, and we agree scope and timeline before starting." },
      ],
      projTitle: "Work you can open and try.",
      projLede: "Real projects. Demos with sample data are labelled as such.",
      viewStudy: "Read the case study", live: "Open live project", allProjects: "All projects",
      procTitle: "How a project runs.",
      steps: [
        { n: "1", t: "Brief and scope", d: "We define what you need, what's included and the price, in writing, before any code is written." },
        { n: "2", t: "Custom build", d: "Modern development with previews along the way, so you see progress and can correct early." },
        { n: "3", t: "Review and SEO", d: "Google Business Profile, structured data, accessibility and performance checks." },
        { n: "4", t: "Delivery and code", d: "Production launch and handover of the repository, with maintenance if you've contracted it." },
      ],
      launchTag: "Launch offer · limited places",
      launchTitle: "Your website created without development fees, for the first clients.",
      launchText: "I'm opening my studio to a first group of clients and I want to work on real projects I can later show. During this launch offer I build your site without charging for development; you only cover the domain and hosting, and agree that the project can feature in my portfolio.",
      launchNote: "It's a temporary, limited opportunity: the usual rates above remain my standard prices. Exact terms are confirmed in writing before starting. Open to businesses in Xàtiva, Valencia and, remotely, the rest of Spain.",
      launchCta: "Apply for a place",
      aboutTitle: "Jaume Tur, web developer in Xàtiva.",
      aboutText: "Certified in Web Application Development (CFGS DAW) and in Microcomputer Systems and Networks (GM SMX). I build fast websites and web applications for local businesses and remote teams.",
      aboutCta: "More about me", cv: "Download CV (PDF)",
      faqTitle: "Questions before starting.",
      faqs: [
        { q: "How does the launch offer work?", a: "To grow my portfolio of real projects, I create selected websites without charging development fees. In return the project can be shown in my portfolio, and you only pay for the domain and hosting needed to keep it online. Places are limited and the terms are confirmed in writing first." },
        { q: "Are your services normally free?", a: "No. This is professional work with a price: creation starts at €290 and goes up to €1,950+ depending on scope, plus a monthly maintenance fee. The launch offer is temporary and only for the first clients." },
        { q: "Will I own the code and the accounts?", a: "Yes. The source code is delivered in a Git repository in your name, together with the domain and accounts, with no lock-in to proprietary platforms." },
        { q: "How long does it take?", a: "Local digitisation packs take 3 to 5 business days, landing pages 1 to 2 weeks and web applications 3 to 6 weeks. The exact timeline is agreed before starting." },
        { q: "Do you only work in Xàtiva?", a: "I'm based in Xàtiva and can meet in person around Valencia, but I also work fully remotely with businesses and teams across Spain." },
      ],
      finalTitle: "Have a project in mind?",
      finalText: "Tell me what you need and I'll reply with scope, price and timeline. No obligation.",
      finalWa: "Message on WhatsApp", finalForm: "Send the form",
    }
  : {
      title: "Diseño web a medida en Xàtiva y Valencia | Jaume Tur",
      desc: "Diseño web a medida, cartas digitales y aplicaciones para negocios de Xàtiva, València y toda España, hechas por quien las programa. Pide presupuesto; oferta de lanzamiento para los primeros clientes.",
      h1: "Páginas web y aplicaciones a medida en Xàtiva y València.",
      lede: "Hechas y mantenidas por la misma persona que te atiende. Páginas web, cartas digitales y aplicaciones para negocios de Xàtiva, València y toda España; precio y alcance cerrados antes de empezar, y el código y las cuentas son tuyos.",
      cta1: "Pedir presupuesto", cta2: "Ver servicios y precios", wa: "WhatsApp",
      reply: "Respuesta en menos de 24 horas laborables.",
      launchLink: "Oferta de lanzamiento para los primeros clientes",
      svcTitle: "Cinco servicios para tu negocio.",
      svcLede: "Cada servicio tiene un precio de creación y una cuota mensual de mantenimiento (permanencia mínima de un año) publicados: los ves en cada tarjeta y en la página de cada servicio. Alcance y plazo se confirman contigo antes de empezar.",
      allPrices: "Ver todos los precios",
      from: "Desde", delivery: "Entrega", more: "Ver qué incluye",
      whyTitle: "Quien te atiende es quien lo construye.",
      why: [
        { t: "Trato directo", d: "Hablas con la persona que diseña y programa tu web. Sin comerciales ni subcontratas." },
        { t: "Todo es tuyo", d: "El código, el repositorio Git, el dominio y las cuentas se entregan a tu nombre. Sin plataformas cautivas." },
        { t: "Precio cerrado", d: "Ves qué incluye y cuánto cuesta antes de pedir nada, y acordamos alcance y plazo antes de empezar." },
      ],
      projTitle: "Trabajo que puedes abrir y probar.",
      projLede: "Proyectos reales. Las demos con datos de ejemplo están indicadas como tales.",
      viewStudy: "Ver el caso de estudio", live: "Abrir proyecto en línea", allProjects: "Todos los proyectos",
      procTitle: "Cómo se desarrolla un proyecto.",
      steps: [
        { n: "1", t: "Briefing y alcance", d: "Definimos por escrito qué necesitas, qué incluye y cuánto cuesta, antes de escribir una línea de código." },
        { n: "2", t: "Desarrollo a medida", d: "Programación moderna con previsualizaciones por el camino, para que veas el avance y corrijas pronto." },
        { n: "3", t: "Revisión y SEO", d: "Ficha de Google Business, datos estructurados, y comprobaciones de accesibilidad y rendimiento." },
        { n: "4", t: "Entrega y código", d: "Publicación en producción y entrega del repositorio, con mantenimiento si lo has contratado." },
      ],
      launchTag: "Oferta de lanzamiento · plazas limitadas",
      launchTitle: "Tu web creada sin honorarios de desarrollo, para los primeros clientes.",
      launchText: "Estoy abriendo mi estudio a un primer grupo de clientes y quiero trabajar en proyectos reales que pueda enseñar después. Durante esta oferta de lanzamiento creo tu web sin cobrar el desarrollo; tú cubres solo el dominio y el alojamiento, y aceptas que el proyecto pueda aparecer en mi portfolio.",
      launchNote: "Es una oportunidad temporal y limitada: las tarifas de arriba siguen siendo mis precios habituales. Las condiciones exactas se confirman por escrito antes de empezar. Abierta a negocios de Xàtiva, València y, en remoto, del resto de España.",
      launchCta: "Solicitar plaza",
      aboutTitle: "Jaume Tur, desarrollador web en Xàtiva.",
      aboutText: "Titulado en Desarrollo de Aplicaciones Web (CFGS DAW) y en Sistemas Microinformáticos y Redes (GM SMX). Hago páginas y aplicaciones web rápidas para negocios locales y equipos en remoto.",
      aboutCta: "Más sobre mí", cv: "Descargar CV (PDF)",
      faqTitle: "Dudas antes de empezar.",
      faqs: [
        { q: "¿Cómo funciona la oferta de lanzamiento?", a: "Para ampliar mi portfolio de proyectos reales, creo webs seleccionadas sin cobrar honorarios de desarrollo. A cambio, el proyecto puede mostrarse en mi portfolio, y tú solo pagas el dominio y el alojamiento necesarios para mantenerlo en línea. Las plazas son limitadas y las condiciones se confirman antes por escrito." },
        { q: "¿Vuestros servicios son habitualmente gratuitos?", a: "No. Es trabajo profesional con precio: la creación parte de 290 € y llega a 1.950 € o más según el alcance, más una cuota mensual de mantenimiento. La oferta de lanzamiento es temporal y solo para los primeros clientes." },
        { q: "¿El código y las cuentas serán míos?", a: "Sí. El código fuente se entrega en un repositorio Git a tu nombre, junto con el dominio y las cuentas, sin ataduras a plataformas propietarias." },
        { q: "¿Cuánto se tarda?", a: "El pack de digitalización local, de 3 a 5 días laborables; una landing, de 1 a 2 semanas; una aplicación web, de 3 a 6 semanas. El plazo exacto se acuerda antes de empezar." },
        { q: "¿Solo trabajas en Xàtiva?", a: "Tengo base en Xàtiva y puedo reunirme en persona por Valencia y comarcas, pero también trabajo 100 % en remoto con negocios y equipos de toda España." },
      ],
      finalTitle: "¿Tienes un proyecto en mente?",
      finalText: "Cuéntame qué necesitas y te respondo con alcance, precio y plazo. Sin compromiso.",
      finalWa: "Escribir por WhatsApp", finalForm: "Enviar el formulario",
    };

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": t.faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<Layout fresh title={t.title} description={t.desc} jsonLd={[faqSchema]}>
  <!-- 1. Hero ampliado: dispositivos a escala imponente y texto abajo a la izquierda desplazados hacia los extremos -->
  <section class="relative isolate overflow-hidden pt-20 pb-14 sm:pt-28 sm:pb-20 lg:pt-24 lg:pb-16" aria-labelledby="hero-title">
    <div class="w-full max-w-[94rem] mx-auto px-5 sm:px-8 lg:px-12 xl:px-16 grid items-center gap-10 lg:grid-cols-12 lg:gap-12 xl:gap-16 min-h-[85vh] lg:min-h-[92vh]">
      
      <!-- Columna izquierda: texto colocado en el extremo izquierdo, con todo su ancho libre -->
      <div class="lg:col-span-6 xl:col-span-5 flex flex-col justify-end items-start order-2 lg:order-1 pt-6 lg:pt-0 pb-2 z-10">
        <!-- Línea sutil superior que delimita el bloque de texto (según la referencia) -->
        <div class="w-full max-w-[280px] sm:max-w-[340px] h-[1px] bg-ink/20 mb-6 sm:mb-8" aria-hidden="true"></div>

        <h1 id="hero-title" class="font-display text-5xl sm:text-6xl lg:text-[3.9rem] xl:text-[4.5rem] font-extrabold leading-[1.01] tracking-tight text-ink" data-split>
          {isEn ? (
            <>
              Your website. <span class="serif-italic text-[1.18em] font-normal tracking-normal text-ink/85">Your code.</span><br />
              <span class="hl mt-2 inline-block px-2.5 sm:px-3.5 py-0.5">Your accounts.</span>
            </>
          ) : (
            <>
              Tu web. <span class="serif-italic text-[1.18em] font-normal tracking-normal text-ink/85">Tu código.</span><br />
              <span class="hl mt-2 inline-block px-2.5 sm:px-3.5 py-0.5">Tus cuentas.</span>
            </>
          )}
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-ink/80 max-w-xl leading-relaxed">
          {isEn
            ? "Custom websites and applications built by whoever answers you. No locked-in platforms or middlemen."
            : "Páginas web y aplicaciones a medida hechas por quien te atiende. Sin plataformas cautivas ni intermediarios."}
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href={to("/contact")} class="btn btn-dark !min-h-[3.5rem] !px-8 text-sm tracking-wider uppercase font-extrabold" data-cursor={isEn ? "Quote" : "Hola"}>
            {t.cta1} <span aria-hidden="true">→</span>
          </a>
          <a href="#servicios" class="btn btn-white !min-h-[3.5rem] !px-8 text-sm tracking-wider uppercase font-bold">
            {t.cta2}
          </a>
        </div>

        <p class="mt-6 text-xs text-ink/60 font-mono">
          {t.reply}
        </p>
      </div>

      <!-- Columna derecha: imagen desplazada hacia el extremo derecho sin reducir su tamaño -->
      <div class="lg:col-span-6 xl:col-span-7 flex items-center justify-end order-1 lg:order-2 lg:translate-x-4 xl:translate-x-8 2xl:translate-x-12" data-tilt>
        <picture class="w-full scale-105 sm:scale-110 lg:scale-115 xl:scale-120 origin-center lg:origin-right transition-transform duration-500">
          <source srcset="/img/hero-devices.webp" type="image/webp" />
          <img
            src="/img/hero-devices.png"
            alt="Proyectos desarrollados por Jaume Tur: AVISA, Worksy y Trania en iMac, portátil y smartphone"
            width="1024"
            height="769"
            class="h-auto w-full max-h-[640px] sm:max-h-[780px] xl:max-h-[920px] object-contain select-none ml-auto"
            loading="eager"
            decoding="async"
          />
        </picture>
      </div>

    </div>
  </section>

  <!-- Divisor animado dinámico al scroll -->
  <div class="section-divider my-8 sm:my-14" data-divider aria-hidden="true"><div class="divider-line"></div></div>

  <!-- 2. Servicios: una tarjeta por servicio; el scroll las recorre en horizontal -->
  <section id="servicios" class="svc-h scroll-mt-20 py-20 sm:py-28" aria-labelledby="svc-title" data-svc>
    <div class="svc-pin">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <h2 id="svc-title" class="h-section" data-reveal>{t.svcTitle}</h2>
            <p class="lede mt-3">{t.svcLede}</p>
          </div>
          <a href={to("/pricing")} class="btn btn-white shrink-0">{t.allPrices} <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <ul class="svc-track wrap" data-svc-track>
        {services.map((s, i) => (
          <li class="svc-card">
            <a href={to(`/pricing/${s.id}`)} class="glass is-hoverable flex h-full flex-col p-6 sm:p-7" data-tilt data-cursor={isEn ? "Open" : "Ver"}>
              <span class="flex items-center justify-between gap-3">
                <span class="label">N.º {String(i + 1).padStart(2, "0")}</span>
                <span class="label">{s.timeline}</span>
              </span>
              <span class="mt-5 block font-display text-[1.6rem] uppercase leading-[1.02]">{s.name}</span>
              <span class="muted mt-3 text-[0.95rem] leading-snug">{s.tagline}</span>
              <span class="mt-auto flex items-end justify-between gap-3 pt-8">
                <span><span class="label block">{t.from}</span><span class="num font-display text-[2.2rem] leading-none">{euro(s.creationPriceNumber)}</span></span>
                <span class="text-[0.9rem] font-bold underline decoration-2 underline-offset-4">{t.more} <span aria-hidden="true">→</span></span>
              </span>
            </a>
          </li>
        ))}
        <li class="svc-card">
          <div class="sheet flex h-full flex-col justify-between p-6 sm:p-7" data-tilt>
            <p class="font-display text-[1.6rem] uppercase leading-[1.02]">{isEn ? "Not sure which one?" : "¿No sabes cuál?"}</p>
            <p class="mt-3 text-[0.95rem] leading-snug">{isEn ? "Tell me about your business and I'll recommend the smallest plan that works." : "Cuéntame tu negocio y te recomiendo el plan más pequeño que funcione."}</p>
            <a href={to("/contact")} class="btn btn-dark btn-sm mt-8 self-start">{t.cta1} <span aria-hidden="true">→</span></a>
          </div>
        </li>
      </ul>
    </div>
  
  <!-- 3. Por qué: tres compromisos -->
  <div class="mt-16 sm:mt-24">
    <div class="wrap">
      <h2 id="why-title" class="h-section max-w-3xl" data-reveal>{t.whyTitle}</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-3" data-stagger>
        {t.why.map((w, i) => (
          <div class="glass p-5" data-tilt>
            <p class="tag">{String(i + 1).padStart(2, "0")}</p>
            <h3 class="mt-3 font-display text-[1.25rem] uppercase leading-none">{w.t}</h3>
            <p class="muted mt-2 text-[0.95rem]">{w.d}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  </section>

  <!-- Divisor animado dinámico al scroll -->
  <div class="section-divider my-8 sm:my-14" data-divider aria-hidden="true"><div class="divider-line"></div></div>

  <!-- 4. Proyectos: muchas piezas medianas en marcos pequeños -->
  <section id="proyectos" class="section scroll-mt-20 py-20 sm:py-28" aria-labelledby="proj-title">
    <div class="wrap">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <h2 id="proj-title" class="h-section" data-reveal>{t.projTitle}</h2>
          <p class="lede mt-3">{t.projLede}</p>
        </div>
        <a href={to("/projectes")} class="btn btn-white shrink-0">{t.allProjects} <span aria-hidden="true">→</span></a>
      </div>

      <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {flagshipProjects.map((p, i) => {
          return (
            <article class="project-card card-interactive group flex flex-col overflow-hidden rounded-2xl" data-tilt>
              <a href={to(`/projectes/${p.id}`)} class="relative block overflow-hidden border-b border-ink/15" tabindex="-1" aria-hidden="true">
                <ProjectMark id={p.id} name={shortTitle(p.data.title)} class="transition-transform duration-500 group-hover:scale-105" />
                <span class="tag absolute left-2.5 top-2.5">Nº {String(i + 1).padStart(2, "0")}</span>
              </a>
              <div class="flex flex-1 flex-col p-5">
                <p class="label">{p.data.badge}</p>
                <h3 class="mt-2 font-display text-[1.25rem] uppercase leading-[1.02]">
                  <a href={to(`/projectes/${p.id}`)} class="hover:underline">{shortTitle(p.data.title)}</a>
                </h3>
                <p class="muted mt-2 line-clamp-3 text-[0.88rem] leading-snug">{p.data.subtitle}</p>
                <p class="label mt-auto pt-3 !normal-case">{p.data.stack?.slice(0, 3).join(" · ")}</p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Divisor animado dinámico al scroll -->
  <div class="section-divider my-8 sm:my-14" data-divider aria-hidden="true"><div class="divider-line"></div></div>

  <!-- 5. Proceso + oferta de lanzamiento -->
  <section class="section py-20 sm:py-28" aria-labelledby="proc-title">
    <div class="wrap">
      <h2 id="proc-title" class="h-section max-w-3xl" data-reveal>{t.procTitle}</h2>
      <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {t.steps.map((s) => (
          <li class="p-6 rounded-xl border border-ink/10 bg-white/70 shadow-xs">
            <p class="font-display text-[2.6rem] leading-none text-ink"><span class="sr-only">{isEn ? "Step" : "Paso"} </span>{s.n}</p>
            <h3 class="mt-3 font-display text-[1.05rem] uppercase leading-tight">{s.t}</h3>
            <p class="muted mt-2 text-[0.92rem]">{s.d}</p>
          </li>
        ))}
      </ol>

      <div id="lanzamiento" class="sheet mt-16 grid scroll-mt-24 gap-6 px-6 py-7 sm:px-9 sm:py-9 lg:grid-cols-12 lg:gap-10 rounded-2xl" data-tilt>
        <div class="lg:col-span-8">
          <p class="tag" style="background:var(--ink);color:#fff">{t.launchTag}</p>
          <h2 id="launch-title" class="h-section mt-3">{t.launchTitle}</h2>
          <p class="mt-4 max-w-2xl text-[1rem] leading-relaxed">{t.launchText}</p>
          <p class="mt-3 max-w-2xl text-[0.9rem] leading-relaxed text-ink/85">{t.launchNote}</p>
        </div>
        <div class="flex lg:col-span-4 lg:items-end lg:justify-end">
          <a href={to("/contact?servei=lanzamiento")} class="btn btn-dark w-full sm:w-auto">{t.launchCta} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Quién + preguntas (fondo negro) -->
  <section class="band-ink section" aria-labelledby="about-title">
    <div class="wrap grid items-center gap-8 lg:grid-cols-12">
      <div class="lg:col-span-3">
        <img src="/img/jaume-tur-desarrollador-web.webp" alt="Jaume Tur" width="320" height="320" loading="lazy" decoding="async" class="mx-auto -mb-6 block w-40 sm:w-56 lg:mx-0 lg:w-72" />
      </div>
      <div class="lg:col-span-9">
        <h2 id="about-title" class="h-section" data-reveal>{isEn ? <>Jaume Tur, web developer in <span class="hl">Xàtiva</span>.</> : <>Jaume Tur, desarrollador web en <span class="hl">Xàtiva</span>.</>}</h2>
        <p class="lede mt-4">{t.aboutText}</p>
        <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-1">
          <a href={to("/about")} class="link-arrow min-h-11">{t.aboutCta} <span aria-hidden="true">→</span></a>
          <a href="/docs/CV_Jaume_tur.pdf" target="_blank" rel="noopener noreferrer" class="link-arrow min-h-11">{t.cv} <span aria-hidden="true">↗</span><span class="sr-only"> ({isEn ? "opens in a new tab" : "se abre en pestaña nueva"})</span></a>
        </div>
      </div>
    </div>

    <div class="wrap mt-16 grid gap-8 lg:grid-cols-12">
      <h2 id="faq-title" class="h-section lg:col-span-4" data-reveal>{t.faqTitle}</h2>
      <div class="lg:col-span-8">
        {t.faqs.map((f) => (
          <details class="faq group border-t-[1.5px] border-white/30 last:border-b-[1.5px] last:border-white/30">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-3.5 font-display text-[1.05rem] uppercase leading-tight hover:text-brand sm:text-[1.15rem] [&::-webkit-details-marker]:hidden">
              <span>{f.q}</span>
              <span class="relative h-4 w-4 shrink-0" aria-hidden="true">
                <span class="absolute left-0 top-1/2 h-[3px] w-4 -translate-y-1/2 bg-current"></span>
                <span class="absolute left-1/2 top-0 h-4 w-[3px] -translate-x-1/2 bg-current transition-transform duration-200 group-open:scale-y-0"></span>
              </span>
            </summary>
            <p class="max-w-2xl pb-5 pr-10 leading-relaxed text-white/80">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. Cierre -->
  <CtaBand
    title={t.finalTitle}
    text={t.finalText}
    primary={{ href: WA, label: t.finalWa, external: true }}
    secondary={{ href: to("/contact"), label: t.finalForm }}
  />
</Layout>

---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import { getServicesData } from "@/data/services";
import { localeFromPath, localizePath } from "@/i18n";

const locale = localeFromPath(Astro.url.pathname);
const isEn = locale === "en";
const to = (path: string) => {
  const p = localizePath(path, locale);
  const [base, hash] = p.split("#");
  const b = base === "/" || base.endsWith("/") ? base : `${base}/`;
  return hash ? `${b}#${hash}` : b;
};

const services = getServicesData(locale);
const euro = (n: number) => (isEn ? `€${n.toLocaleString("en-US")}` : `${n.toLocaleString("es-ES")} €`);

// Seleccionamos EXCLUSIVAMENTE los 2 proyectos insignia reales y demostrables
const rawProjects = await getCollection(isEn ? "projectes-en" : "projectes");
const flagshipProjects = ["avisa", "pizzeria-xativa"]
  .map((id) => rawProjects.find((p) => p.id === id))
  .filter(Boolean) as typeof rawProjects;

const projectImages: Record<string, string> = {
  avisa: "/img/preview-avisa.webp",
  "pizzeria-xativa": "/img/foto_pizza.webp",
};
const shortTitle = (t: string) => t.split(" — ")[0];

/* ──────────────── COPY BILINGÜE: CLARO, DIRECTO Y EQUILIBRADO ──────────────── */
const t = isEn
  ? {
      // Hero
      heroTag: "Launch Campaign 2026 · Limited Partner Slots",
      heroTitle: "Custom web development",
      heroHighlight: "built to grow your business.",
      heroSub: "High-speed websites, interactive hospitality menus, and local SEO ranking. Clean code, zero middlemen, built directly by an accredited software developer.",
      ctaPrimary: "Start your project",
      ctaSecondary: "Explore services",
      ctaWa: "WhatsApp chat",

      // Services
      svcEyebrow: "Solutions & Pricing",
      svcTitle: "Transparent services built for real commercial growth.",
      svcSub: "Balanced digital solutions for local shops, hospitality, SMEs, and digital products. Fixed budgets and direct developer collaboration.",
      from: "From",
      timelineLabel: "Delivery",
      seeDetails: "View full scope",

      // Differential values
      valuesEyebrow: "Why Work With Us",
      valuesTitle: "High-performance digital engineering without the agency bloat.",
      values: [
        {
          icon: "bx:bxs-zap",
          title: "Sub-second load times",
          desc: "Built on modern frameworks (Astro, Angular, Tailwind). 100/100 Lighthouse speed scores without bloated templates.",
        },
        {
          icon: "bx:code-block",
          title: "100% Client code ownership",
          desc: "All source code, Git repositories, domain and accounts belong entirely to you. Zero vendor lock-in or captive monthly traps.",
        },
        {
          icon: "bx:user-check",
          title: "Direct developer communication",
          desc: "No sales reps or subcontracted juniors. You collaborate directly with the accredited engineer coding your platform.",
        },
      ],

      // Launch program
      launchEyebrow: "Launch Opportunity",
      launchTitle: "0 € Development Fee for First Partner Clients",
      launchBadge: "Exclusive Launch Program",
      launchDesc: "To demonstrate our technical standards and build prominent public case studies, we are selecting a limited number of local businesses. We engineer and design your website with zero creation fees — you only handle minimal hosting and domain operating costs.",
      launchCondition: "Strictly limited slots · Available for businesses in Xàtiva, Valencia, and remote Spain.",
      launchCta: "Apply for launch program",

      // Curated Work
      projEyebrow: "Verified Case Studies",
      projTitle: "Featured production work you can inspect right now.",
      projSub: "Selected case studies demonstrating our technical capacity in hospitality digitalization and complex reactive web applications.",
      viewStudy: "Read case study",
      tryDemo: "Live demo",
      allProjects: "View all projects",

      // Methodology
      procEyebrow: "Methodology",
      procTitle: "Predictable process. Zero technical debt.",
      steps: [
        { n: "01", t: "Briefing & Scope", d: "Clear requirements and fixed budget with zero surprises." },
        { n: "02", t: "Custom Architecture", d: "Modern web build with real-time progress reviews." },
        { n: "03", t: "SEO & Optimization", d: "Google Maps sync, structured data, and Core Web Vitals audit." },
        { n: "04", t: "Launch & Code Transfer", d: "Production deploy, full Git repo handover, and ongoing support." },
      ],

      // Profile
      aboutEyebrow: "Accredited Engineer",
      aboutTitle: "The developer behind your digital platform.",
      aboutLead: "Based in Xàtiva (Valencia), working locally and remotely across Spain.",
      aboutText: "I hold state-certified qualifications in Web Application Development (CFGS DAW) and Microcomputer Systems & Networks (GM SMX). I focus on resilient technical architecture, fast UX, and measurable local SEO rankings.",
      aboutCta: "Career profile",
      cv: "Download CV (PDF)",

      // FAQ
      faqEyebrow: "FAQ",
      faqTitle: "Clear answers before starting.",
      faqs: [
        { q: "How does the 0 € development launch program work?", a: "To expand our verified case studies, we build selected websites with zero design and creation fees. In return for featuring the project publicly, the client only covers the minimal domain, SSL, and VPS hosting costs necessary to keep the site active." },
        { q: "Are development services normally free?", a: "No. Professional software engineering carries real commercial value. Our standard creation rates range from €290 to €1,950+ depending on architectural scope. The €0 development condition is strictly an exclusive, temporary launch opportunity." },
        { q: "Will I own 100% of the code and digital assets?", a: "Yes, completely. The source code is clean, fully documented, and transferred directly into a Git repository under your ownership." },
        { q: "What is the typical delivery timeframe?", a: "Local digitalization packages take 3 to 5 business days; landing pages take 1 to 2 weeks; complex web applications require 3 to 6 weeks." },
        { q: "Do you only work with businesses in Xàtiva?", a: "I have my base in Xàtiva and serve the Valencia metropolitan area directly, but I also build projects 100% remotely for businesses and startups throughout Spain." },
      ],

      // Final CTA
      finalTag: "Direct Consultation · No Obligation",
      finalTitle: "Ready to build a high-performance web presence?",
      finalSub: "Apply for our limited launch program or request a tailored proposal for your business. Speak directly with the developer.",
      finalCta: "Chat on WhatsApp",
      finalCta2: "Send contact form",
    }
  : {
      // Hero
      heroTag: "Campaña de Lanzamiento 2026 · Plazas Limitadas",
      heroTitle: "Desarrollo web a medida para",
      heroHighlight: "hacer crecer tu negocio.",
      heroSub: "Páginas web ultrarrápidas, cartas digitales para hostelería y posicionamiento SEO local en Google Maps. Código limpio y trato directo con el programador, sin intermediarios.",
      ctaPrimary: "Iniciar proyecto",
      ctaSecondary: "Ver servicios",
      ctaWa: "WhatsApp directo",

      // Services
      svcEyebrow: "Servicios y Tarifas",
      svcTitle: "Soluciones digitales con tarifas claras y transparentes.",
      svcSub: "Propuestas equilibradas para comercios, hostelería, pymes y productos digitales. Presupuestos cerrados y soporte continuo.",
      from: "Desde",
      timelineLabel: "Entrega",
      seeDetails: "Ver desglose",

      // Differential values
      valuesEyebrow: "Por Qué Nosotros",
      valuesTitle: "Ingeniería web de alto rendimiento sin los costes inflados de agencia.",
      values: [
        {
          icon: "bx:bxs-zap",
          title: "Carga en menos de 0,5 segundos",
          desc: "Desarrollado sobre tecnologías modernas (Astro, Angular, Tailwind). Puntuaciones de 100/100 en Lighthouse sin plantillas pesadas.",
        },
        {
          icon: "bx:code-block",
          title: "Código 100% de tu propiedad",
          desc: "El código fuente, repositorio Git, dominio y cuentas son íntegramente tuyos. Sin permanencias forzosas ni plataformas cautivas.",
        },
        {
          icon: "bx:user-check",
          title: "Trato directo con el programador",
          desc: "Sin comerciales ni intermediarios. Hablas y decides directamente con el profesional titulado que diseña y programa tu web.",
        },
      ],

      // Launch program
      launchEyebrow: "Oportunidad de Lanzamiento",
      launchTitle: "0 € en Costes de Desarrollo para Primeros Clientes",
      launchBadge: "Programa Exclusivo de Lanzamiento",
      launchDesc: "Para dar a conocer la calidad de nuestro trabajo y sumar casos de éxito demostrables a nuestro portfolio público, seleccionamos un número limitado de negocios. Te diseñamos y programamos la web sin honorarios de creación; tú solo cubres el alojamiento y dominio mínimos.",
      launchCondition: "Plazas estrictamente limitadas · Válido para negocios de Xàtiva, Valencia y ámbito nacional.",
      launchCta: "Solicitar plaza de lanzamiento",

      // Curated Work
      projEyebrow: "Casos Demostrables",
      projTitle: "Proyectos en producción que puedes comprobar ahora mismo.",
      projSub: "Una selección cuidada que demuestra nuestra capacidad técnica en digitalización de hostelería local y aplicaciones web reactivas complejas.",
      viewStudy: "Ver caso de estudio",
      tryDemo: "Demo en vivo",
      allProjects: "Ver todos los proyectos",

      // Methodology
      procEyebrow: "Metodología",
      procTitle: "Un proceso claro, predecible y sin sorpresas.",
      steps: [
        { n: "01", t: "Briefing y alcance", d: "Requisitos claros y presupuesto cerrado antes de escribir una línea de código." },
        { n: "02", t: "Desarrollo a medida", d: "Programación moderna con revisiones y previsualizaciones en tiempo real." },
        { n: "03", t: "SEO y optimización", d: "Sincronización con Google Maps, datos estructurados y velocidad Core Web Vitals." },
        { n: "04", t: "Entrega y código", d: "Despliegue en producción, cesión completa del repositorio y soporte continuo." },
      ],

      // Profile
      aboutEyebrow: "Perfil Profesional",
      aboutTitle: "El desarrollador detrás de tu presencia digital.",
      aboutLead: "Afincado en Xàtiva (Valencia), trabajando de forma cercana y en remoto.",
      aboutText: "Cuento con las titulaciones oficiales de Técnico Superior en Desarrollo de Aplicaciones Web (CFGS DAW) y Técnico en Sistemas Microinformáticos y Redes (GM SMX). Combino rigor arquitectónico con interfaces comerciales ágiles para maximizar tus ventas.",
      aboutCta: "Mi trayectoria",
      cv: "Descargar CV (PDF)",

      // FAQ
      faqEyebrow: "Preguntas Frecuentes",
      faqTitle: "Resolvemos tus dudas con total transparencia.",
      faqs: [
        { q: "¿En qué consiste la oportunidad de desarrollo a 0 €?", a: "Para ampliar nuestros casos de éxito públicos, seleccionamos negocios a los que creamos su web sin costes de programación. A cambio de mostrar el caso en nuestro portfolio, el cliente únicamente asume el coste técnico de servidor VPS y dominio indispensable para mantener la web activa." },
        { q: "¿Vuestros servicios son habitualmente gratuitos?", a: "No. El desarrollo de software profesional tiene un valor económico real. Las tarifas estándar de creación parten de 290 € hasta 1.950 €+ según la envergadura técnica. La condición de 0 € en creación es una oportunidad promocional exclusiva y temporal de lanzamiento." },
        { q: "¿La web y el código serán 100% de mi propiedad?", a: "Sí, con total garantía. El código fuente es limpio, estructurado y se entrega en un repositorio Git a tu nombre sin ataduras a plataformas propietarias." },
        { q: "¿Cuánto se tarda en completar el desarrollo?", a: "El pack de digitalización local se entrega en 3–5 días laborables; una landing page en 1–2 semanas; y una aplicación web interactiva en 3–6 semanas." },
        { q: "¿Solo trabajáis en Xàtiva?", a: "Tengo mi sede en Xàtiva y doy cobertura presencial y cercana en Valencia y comarcas, pero desarrollo proyectos 100% en remoto para empresas y profesionales de toda España." },
      ],

      // Final CTA
      finalTag: "Consulta Técnica Directa · Sin Compromiso",
      finalTitle: "¿Hablamos de tu próximo proyecto digital?",
      finalSub: "Aprovecha las plazas de la campaña de lanzamiento o solicita una propuesta adaptada a tus objetivos comerciales. Habla directamente con el desarrollador.",
      finalCta: "Contactar por WhatsApp",
      finalCta2: "Enviar formulario",
    };

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": t.faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<Layout
  fresh
  title={isEn ? "Web Development & Local SEO in Valencia | Jaume Tur" : "Desarrollo Web y SEO Local en Valencia | Jaume Tur"}
  description={
    isEn
      ? "Custom web development, interactive hospitality menus, and local SEO in Xàtiva & Valencia. Clean code and transparent launch conditions."
      : "Desarrollo web a medida, cartas digitales para hostelería y SEO local en Xàtiva y Valencia. Código limpio y campaña de lanzamiento para primeros clientes."
  }
  jsonLd={[faqSchema]}
>

  <!-- ══════════════════════════════════════════════════════════
       1. HERO — SIMPLIFICADO, CONTUNDENTE Y MOBILE-FIRST
       Sin bloques de texto interminables, sin elementos compitiendo.
  ═══════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden pt-10 pb-16 sm:pt-18 sm:pb-24 border-b border-white/5" aria-labelledby="hero-title">
    <!-- Luz ambiental sutil y limpia (sin círculos giratorios ni ruido) -->
    <div class="pointer-events-none absolute inset-x-0 -top-20 h-96 bg-[radial-gradient(ellipse_60%_50%_at_50%_0%,rgba(255,255,0,0.06),transparent_70%)]" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-5xl px-5 text-center">
      <!-- Badge discreto de lanzamiento -->
      <div class="inline-flex items-center gap-2 rounded-full border border-brand/30 bg-brand/10 px-3.5 py-1 text-xs font-semibold text-brand">
        <span class="h-1.5 w-1.5 rounded-full bg-brand"></span>
        <span>{t.heroTag}</span>
      </div>

      <!-- Titular breve y de alto impacto -->
      <h1 id="hero-title" class="mt-6 font-display text-[clamp(2.3rem,6vw,4.5rem)] font-bold text-white tracking-tight leading-[1.08]">
        {t.heroTitle} <br class="hidden sm:inline" />
        <span class="text-brand">{t.heroHighlight}</span>
      </h1>

      <!-- Subtítulo de 1–2 líneas máximo -->
      <p class="mx-auto mt-4 max-w-2xl text-base sm:text-lg leading-relaxed text-zinc-300">
        {t.heroSub}
      </p>

      <!-- Llamadas a la acción principales y directas -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5">
        <a href={to("/contact")} class="btn btn-brand min-h-12 px-7 text-sm sm:text-base">
          <span>{t.ctaPrimary}</span>
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
        </a>
        <a href="#servicios" class="btn btn-white min-h-12 px-6 text-sm sm:text-base">
          {t.ctaSecondary}
        </a>
        <a href="https://wa.me/34644525838?text=Hola%20Jaume,%20quiero%20informaci%C3%B3n%20sobre%20un%20proyecto" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-5 text-xs sm:text-sm font-semibold text-emerald-400 transition-all hover:bg-emerald-500/20 active:scale-97">
          <Icon name="bx:bxl-whatsapp" class="h-4.5 w-4.5" />
          <span>{t.ctaWa}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       2. SERVICIOS — CUADRÍCULA COMPLETAMENTE EQUILIBRADA
       Misma jerarquía, proporciones idénticas, sin desproporciones.
  ═══════════════════════════════════════════════════════════ -->
  <section id="servicios" class="scroll-mt-16 px-5 py-16 sm:py-24" aria-labelledby="svc-title">
    <div class="mx-auto max-w-6xl">
      <div class="text-center max-w-2xl mx-auto">
        <p class="eyebrow justify-center">{t.svcEyebrow}</p>
        <h2 id="svc-title" class="display mt-3 text-2xl sm:text-4xl text-white">{t.svcTitle}</h2>
        <p class="mt-3 text-sm sm:text-base text-zinc-400">{t.svcSub}</p>
      </div>

      <!-- Cuadrícula limpia y uniforme para los 5 servicios -->
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <article class="surface-card group flex flex-col justify-between p-6">
            <div>
              <!-- Cabecera de la tarjeta con icono y precio -->
              <div class="flex items-center justify-between gap-3">
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-white/5 text-brand transition-colors group-hover:bg-brand group-hover:text-black">
                  <Icon name={s.icon} class="h-5 w-5" />
                </span>
                <span class="font-mono text-xs font-bold text-brand bg-brand/10 border border-brand/25 px-2.5 py-1 rounded-full">
                  {t.from} {euro(s.creationPriceNumber)}
                </span>
              </div>

              <!-- Nombre y descripción uniforme -->
              <h3 class="mt-4 font-display text-lg font-bold text-white group-hover:text-brand transition-colors">
                <a href={to(`/pricing/${s.id}`)}>{s.name}</a>
              </h3>
              <p class="mt-2 text-xs sm:text-sm text-zinc-300 leading-relaxed line-clamp-3">
                {s.tagline}
              </p>

              <!-- Características destacadas (2 puntos clave) -->
              <ul class="mt-4 space-y-2 border-t border-white/5 pt-3.5">
                {s.features.slice(0, 2).map((f) => (
                  <li class="flex items-start gap-2 text-xs text-zinc-400">
                    <span class="mt-0.5 text-brand font-bold">✓</span>
                    <span class="line-clamp-1">{f}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Pie de tarjeta con plazo y llamada a la acción uniforme -->
            <div class="mt-6 flex items-center justify-between border-t border-white/10 pt-4 text-xs">
              <span class="text-zinc-400 font-mono">{t.timelineLabel}: {s.timeline}</span>
              <a href={to(`/pricing/${s.id}`)} class="font-semibold text-brand hover:underline flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
                <span>{t.seeDetails}</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       3. VALORES DIFERENCIALES — 3 PILARES CLAROS Y NO REPETITIVOS
  ═══════════════════════════════════════════════════════════ -->
  <section class="border-y border-white/5 bg-[#0e0e12] px-5 py-16 sm:py-20" aria-labelledby="values-title">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-xl">
        <p class="eyebrow">{t.valuesEyebrow}</p>
        <h2 id="values-title" class="display mt-3 text-2xl sm:text-3xl text-white">{t.valuesTitle}</h2>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {t.values.map((v) => (
          <div class="rounded-xl border border-white/5 bg-white/[0.02] p-5 sm:p-6">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand/10 text-brand">
              <Icon name={v.icon} class="h-5 w-5" />
            </span>
            <h3 class="mt-4 font-display text-base font-bold text-white">{v.title}</h3>
            <p class="mt-2 text-xs sm:text-sm text-zinc-300 leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       4. PROGRAMA DE LANZAMIENTO — EXPLICACIÓN CONCISA Y ELEGANTE
       Aparece como una oportunidad comercial destacada pero delimitada.
  ═══════════════════════════════════════════════════════════ -->
  <section class="px-5 py-16 sm:py-24" aria-labelledby="launch-title">
    <div class="mx-auto max-w-5xl">
      <div class="surface-card relative overflow-hidden border border-brand/35 bg-gradient-to-r from-brand/[0.08] via-surface to-brand/[0.03] p-7 sm:p-10">
        <div class="relative flex flex-col md:flex-row md:items-center md:justify-between gap-8">
          <div class="max-w-2xl">
            <span class="inline-block rounded-md bg-brand px-2.5 py-0.5 text-[0.7rem] font-bold uppercase tracking-wider text-black">
              {t.launchBadge}
            </span>
            <h2 id="launch-title" class="display mt-3 text-2xl sm:text-3xl text-white">
              {t.launchTitle}
            </h2>
            <p class="mt-3 text-sm sm:text-base text-zinc-300 leading-relaxed">
              {t.launchDesc}
            </p>
            <p class="mt-2 text-xs font-mono text-brand">
              ● {t.launchCondition}
            </p>
          </div>

          <div class="shrink-0">
            <a href={to("/contact")} class="btn btn-brand min-h-12 px-7 text-sm font-bold">
              <span>{t.launchCta}</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       5. CASOS DEMOSTRABLES — SOLO 2 PROYECTOS INSIGNIA REALES
       Eliminadas demos genéricas y de relleno; máxima calidad.
  ═══════════════════════════════════════════════════════════ -->
  <section id="proyectos" class="scroll-mt-16 border-t border-white/5 bg-[#0e0e12] px-5 py-16 sm:py-24" aria-labelledby="proj-title">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div>
          <p class="eyebrow">{t.projEyebrow}</p>
          <h2 id="proj-title" class="display mt-3 text-2xl sm:text-4xl text-white">{t.projTitle}</h2>
          <p class="mt-2 text-sm sm:text-base text-zinc-400 max-w-2xl">{t.projSub}</p>
        </div>
        <a href={to("/projectes")} class="text-xs sm:text-sm font-semibold text-brand hover:underline inline-flex items-center gap-1 self-start sm:self-auto">
          <span>{t.allProjects}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Presentación de 2 columnas de los proyectos de referencia -->
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {flagshipProjects.map((p) => {
          const imgSrc = projectImages[p.id] || p.data.image?.src;
          return (
            <article class="surface-card group overflow-hidden flex flex-col justify-between">
              <div>
                <!-- Previsualización -->
                <a href={to(`/projectes/${p.id}`)} class="relative block aspect-[16/9] overflow-hidden bg-[#16161c]">
                  {imgSrc ? (
                    <img
                      src={imgSrc}
                      alt={p.data.image?.alt || p.data.title}
                      width="700"
                      height="400"
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-102"
                    />
                  ) : null}
                  <span class="absolute bottom-3 left-3 rounded-md bg-black/75 px-2.5 py-1 text-[0.7rem] font-semibold text-white backdrop-blur-md">
                    {p.data.badge}
                  </span>
                </a>

                <!-- Contenido -->
                <div class="p-6">
                  <h3 class="font-display text-xl font-bold text-white group-hover:text-brand transition-colors">
                    <a href={to(`/projectes/${p.id}`)}>{shortTitle(p.data.title)}</a>
                  </h3>
                  <p class="mt-2 text-xs sm:text-sm text-zinc-300 leading-relaxed line-clamp-3">
                    {p.data.subtitle}
                  </p>

                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {p.data.stack?.slice(0, 4).map((st) => (
                      <span class="rounded bg-white/5 px-2 py-0.5 text-[0.7rem] font-mono text-zinc-300">
                        {st}
                      </span>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Enlaces directos -->
              <div class="px-6 pb-6 pt-2 flex items-center justify-between border-t border-white/5 text-xs font-semibold">
                <a href={to(`/projectes/${p.id}`)} class="text-brand hover:underline">
                  {t.viewStudy} →
                </a>
                {p.data.liveUrl && (
                  <a href={p.data.liveUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-zinc-300 hover:text-white transition-colors">
                    <Icon name="bx:link-external" class="h-3.5 w-3.5 text-brand" />
                    <span>{t.tryDemo}</span>
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       6. METODOLOGÍA (PROCESO EN 4 PASOS)
  ═══════════════════════════════════════════════════════════ -->
  <section class="px-5 py-16 sm:py-20" aria-labelledby="proc-title">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-xl">
        <p class="eyebrow">{t.procEyebrow}</p>
        <h2 id="proc-title" class="display mt-3 text-2xl sm:text-3xl text-white">{t.procTitle}</h2>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {t.steps.map((s) => (
          <div class="rounded-xl border border-white/5 bg-[#121216] p-5">
            <span class="font-mono text-xs font-bold text-brand bg-brand/10 px-2 py-0.5 rounded">
              {s.n}
            </span>
            <h3 class="mt-3 font-display text-base font-bold text-white">{s.t}</h3>
            <p class="mt-1.5 text-xs sm:text-sm text-zinc-400 leading-relaxed">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       7. PERFIL DEL DESARROLLADOR (JAUME TUR)
  ═══════════════════════════════════════════════════════════ -->
  <section class="border-t border-white/5 bg-[#0e0e12] px-5 py-16 sm:py-20" aria-labelledby="about-title">
    <div class="mx-auto max-w-5xl">
      <div class="surface-card p-6 sm:p-8 flex flex-col md:flex-row items-center gap-8">
        <div class="h-36 w-36 shrink-0 overflow-hidden rounded-2xl border border-brand/35 bg-[#14141c]">
          <img src="/img/1.webp" alt="Jaume Tur" width="160" height="160" loading="lazy" decoding="async" class="h-full w-full object-contain" />
        </div>
        <div>
          <p class="eyebrow">{t.aboutEyebrow}</p>
          <h2 id="about-title" class="display mt-2 text-2xl sm:text-3xl text-white">{t.aboutTitle}</h2>
          <p class="mt-1 text-sm font-semibold text-brand">{t.aboutLead}</p>
          <p class="mt-2 text-xs sm:text-sm text-zinc-300 leading-relaxed">{t.aboutText}</p>
          
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="rounded bg-brand/10 border border-brand/25 px-2.5 py-1 font-mono text-xs font-bold text-brand">
              CFGS DAW
            </span>
            <span class="rounded bg-white/5 border border-white/10 px-2.5 py-1 font-mono text-xs text-zinc-300">
              GM SMX
            </span>
            <a href="/docs/CV_Jaume_tur.pdf" target="_blank" rel="noopener noreferrer" class="rounded bg-white/5 border border-white/10 px-3 py-1 font-mono text-xs text-white hover:border-brand/40 transition-colors">
              {t.cv} ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       8. PREGUNTAS FRECUENTES (FAQ)
  ═══════════════════════════════════════════════════════════ -->
  <section class="px-5 py-16 sm:py-20" aria-labelledby="faq-title">
    <div class="mx-auto max-w-4xl">
      <div class="text-center max-w-xl mx-auto">
        <p class="eyebrow justify-center">{t.faqEyebrow}</p>
        <h2 id="faq-title" class="display mt-3 text-2xl sm:text-3xl text-white">{t.faqTitle}</h2>
      </div>

      <div class="mt-8 space-y-3">
        {t.faqs.map((f) => (
          <details class="surface-card group">
            <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-display text-sm sm:text-base font-semibold text-white hover:text-brand transition-colors [&::-webkit-details-marker]:hidden">
              <span>{f.q}</span>
              <span class="text-brand font-bold transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <div class="border-t border-white/5 px-5 pb-5 pt-3 text-xs sm:text-sm text-zinc-300 leading-relaxed">
              {f.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       9. LLAMADA A LA ACCIÓN FINAL Y CONTACTO
  ═══════════════════════════════════════════════════════════ -->
  <section class="border-t border-white/5 bg-[#0a0a0c] px-5 py-16 sm:py-24 text-center" aria-labelledby="final-title">
    <div class="mx-auto max-w-3xl">
      <span class="text-xs font-mono font-bold uppercase tracking-wider text-brand">
        {t.finalTag}
      </span>
      <h2 id="final-title" class="display mt-3 text-2xl sm:text-4xl text-white">
        {t.finalTitle}
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-sm sm:text-base text-zinc-300 leading-relaxed">
        {t.finalSub}
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5">
        <a href="https://wa.me/34644525838?text=Hola%20Jaume,%20quiero%20informaci%C3%B3n%20sobre%20un%20proyecto" target="_blank" rel="noopener noreferrer" class="btn btn-brand min-h-12 px-7 text-sm sm:text-base">
          <Icon name="bx:bxl-whatsapp" class="h-4.5 w-4.5" />
          <span>{t.finalCta}</span>
        </a>
        <a href={to("/contact")} class="btn btn-white min-h-12 px-6 text-sm sm:text-base">
          {t.finalCta2}
        </a>
      </div>

      <p class="mt-8 font-mono text-xs text-zinc-400">
        jaumetur3w@gmail.com · Xàtiva (Valencia)
      </p>
    </div>
  </section>
</Layout>

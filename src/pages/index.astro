const local = services.find((s) => s.id === "digitalitzacio-local")!;
const landing = services.find((s) => s.id === "landing-page")!;
const webapp = services.find((s) => s.id === "angular-webapp")!;
const audit = services.find((s) => s.id === "performance-audit")!;

const faqs = isEn
  ? [
      { q: "Is it really true that the website creation is 100% FREE?", a: "Yes. As a web developer completing my official DAW portfolio, I am taking on select projects with 0 € design and development fees. You don't pay anything for the creation of the code, layout or design. You only cover the minimal technical maintenance/VPS hosting and domain costs to keep the site active online." },
      { q: "What does the 0 € free website promotion include?", a: "It includes the entire design and programming of your website or interactive digital menu, responsive mobile optimization, basic local SEO configuration (Google Business Profile/Google Maps) and WhatsApp ordering or booking integration." },
      { q: "Why do you offer website design for free?", a: "Because I am expanding my portfolio of real local business case studies in Xàtiva and Valencia. Having visible, high-impact reference projects benefits my professional credentials, and your business gets a high-performance website without typical agency fees of 1,000 € to 3,000 €." },
      { q: "How much does a website cost after the promotion or for larger projects?", a: `Standard creation prices start at ${euro(local.creationPriceNumber)} for the local business pack (digital menu, Google Maps and social profiles) and at ${euro(landing.creationPriceNumber)} for a high-performance landing page. Each plan adds a monthly maintenance fee (${monthly(local.monthlyFeeNumber)} for the local pack) with a one-year minimum.` },

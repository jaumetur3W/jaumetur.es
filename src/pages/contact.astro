---
import Contactform from "@/components/contactform.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import EmojiIcon from "@/components/ui/emoji-icon.astro";
---

<Layout title="Contacte">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Contacte directe</Fragment>
      <Fragment slot="desc">
        Disponible per a ofertes de treball, projectes o col·laboracions tècniques.
      </Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-10 items-start">
      
      <!-- Left Channels Column -->
      <div>
        
        <!-- Header with Memoji 3.png (Clean surface anchor) -->
        <div class="flex items-center gap-4 mb-6 bg-white p-4 pr-5 rounded-3xl border border-slate-200/90 shadow-[0_4px_16px_rgba(15,23,42,0.06)] relative overflow-visible group">
          <div class="relative group/memoji shrink-0 -my-6 -ml-2 sm:-ml-4 z-20">
            <img
              src="/memojis/3.png"
              alt="Jaume Tur trucant"
              class="relative w-28 h-28 sm:w-36 sm:h-36 object-contain drop-shadow-[0_12px_20px_rgba(15,23,42,0.18)] group-hover/memoji:scale-105 group-hover/memoji:-translate-y-1 transition-transform duration-300"
              width="144"
              height="144"
            />
          </div>
          <div class="relative z-10">
            <span class="inline-flex items-center gap-1.5 text-xs text-emerald-700 font-bold bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200 shadow-2xs">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Resposta &lt; 24h</span>
            </span>
            <h2 class="font-extrabold text-xl text-slate-900 mt-1 flex items-center gap-1.5">
              <span>Parlem del teu projecte</span>
              <EmojiIcon symbol="💬" decorative={true} />
            </h2>
            <p class="text-xs text-slate-600 mt-0.5">
              Contacta directament o envia un missatge.
            </p>
          </div>
        </div>

        <div class="space-y-3">
          
          <!-- Email box with 1-click copy -->
          <div class="bg-white border border-slate-200/90 rounded-2xl p-4 flex items-center justify-between gap-3 shadow-[0_1px_3px_0_rgba(15,23,42,0.04)] group hover:border-indigo-300 transition-colors">
            <div class="flex items-center gap-3 overflow-hidden">
              <div class="w-10 h-10 rounded-xl bg-indigo-50 border border-indigo-200/60 text-indigo-600 flex items-center justify-center shrink-0 shadow-2xs text-lg">
                <span aria-hidden="true">✉️</span>
              </div>
              <div class="truncate">
                <span class="text-[10px] font-mono font-bold text-indigo-600 block uppercase tracking-wider">
                  Correu Directe
                </span>
                <a
                  href="mailto:jautursis@alu.edu.gva.es"
                  class="text-sm font-bold text-slate-800 hover:text-indigo-600 transition truncate block">
                  jautursis@alu.edu.gva.es
                </a>
              </div>
            </div>
            <button
              id="copy-email-btn"
              type="button"
              class="shrink-0 text-xs font-mono font-bold px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-indigo-50 border border-slate-200/80 text-slate-700 hover:text-indigo-600 transition shadow-2xs flex items-center gap-1"
              title="Copiar correu">
              <EmojiIcon symbol="📋" decorative={true} />
              <span>Copiar</span>
            </button>
          </div>

          <!-- GitHub -->
          <a
            href="https://github.com/jautur"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white border border-slate-200/90 hover:border-slate-800 rounded-2xl p-4 flex items-center justify-between transition group shadow-[0_1px_3px_0_rgba(15,23,42,0.04)]">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center shrink-0 shadow-sm text-lg">
                <span aria-hidden="true">🐙</span>
              </div>
              <div>
                <span class="text-[10px] font-mono font-bold text-slate-500 block uppercase tracking-wider">
                  Perfil de GitHub
                </span>
                <span class="text-sm font-bold text-slate-900 group-hover:text-indigo-600 transition-colors">
                  github.com/jautur
                </span>
              </div>
            </div>
            <span class="text-slate-400 group-hover:text-slate-900 text-sm font-bold font-mono">↗</span>
          </a>

          <!-- LinkedIn -->
          <a
            href="https://www.linkedin.com/in/jautur/"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white border border-slate-200/90 hover:border-indigo-300 rounded-2xl p-4 flex items-center justify-between transition group shadow-[0_1px_3px_0_rgba(15,23,42,0.04)]">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-indigo-50 border border-indigo-200/60 text-indigo-600 flex items-center justify-center shrink-0 shadow-2xs text-lg">
                <span aria-hidden="true">💼</span>
              </div>
              <div>
                <span class="text-[10px] font-mono font-bold text-indigo-600 block uppercase tracking-wider">
                  Perfil de LinkedIn
                </span>
                <span class="text-sm font-bold text-slate-900 group-hover:text-indigo-600 transition-colors">
                  linkedin.com/in/jautur
                </span>
              </div>
            </div>
            <span class="text-slate-400 group-hover:text-indigo-600 text-sm font-bold font-mono">↗</span>
          </a>

          <!-- Location -->
          <div class="bg-white border border-slate-200/90 rounded-2xl p-4 flex items-center gap-3 shadow-[0_1px_3px_0_rgba(15,23,42,0.04)]">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200/60 text-emerald-600 flex items-center justify-center shrink-0 shadow-2xs text-lg">
              <span aria-hidden="true">📍</span>
            </div>
            <div>
              <span class="text-[10px] font-mono font-bold text-emerald-700 block uppercase tracking-wider">
                Ubicació
              </span>
              <span class="text-sm font-bold text-slate-800">
                València, Espanya (Híbrid / Remot)
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact form column -->
      <div class="bg-white rounded-3xl border border-slate-200/90 p-6 sm:p-8 shadow-[0_1px_3px_0_rgba(15,23,42,0.04)]">
        <div class="flex items-center justify-between mb-5">
          <h3 class="font-extrabold text-lg text-slate-900 flex items-center gap-1.5">
            <EmojiIcon symbol="✍️" decorative={true} />
            <span>Enviar missatge</span>
          </h3>
          <span class="text-[11px] font-mono font-semibold text-indigo-700 bg-indigo-50 px-2.5 py-0.5 rounded-full border border-indigo-200/60">
            Formulari directe
          </span>
        </div>
        <Contactform />
      </div>

    </div>
  </Container>
</Layout>

<script is:inline>
  const copyBtn = document.getElementById("copy-email-btn");
  if (copyBtn) {
    copyBtn.addEventListener("click", () => {
      navigator.clipboard.writeText("jautursis@alu.edu.gva.es").then(() => {
        const originalContent = copyBtn.innerHTML;
        copyBtn.innerHTML = "<span>✓ ¡Copiat!</span>";
        copyBtn.className = "shrink-0 text-xs font-mono font-bold px-3 py-1.5 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-700 transition shadow-2xs";
        setTimeout(() => {
          copyBtn.innerHTML = originalContent;
          copyBtn.className = "shrink-0 text-xs font-mono font-bold px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-indigo-50 border border-slate-200/80 text-slate-700 hover:text-indigo-600 transition shadow-2xs flex items-center gap-1";
        }, 2000);
      });
    });
  }
</script>

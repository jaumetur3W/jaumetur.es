---
import Contactform from "@/components/contactform.astro";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { localeFromPath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const subject = encodeURIComponent(isEn ? "New project inquiry" : "Nueva consulta de proyecto");
const mailto = `mailto:jaumetur3w@gmail.com?subject=${subject}`;

const t = isEn
  ? {
      title: "Contact — get a web design quote in Valencia | Jaume Tur",
      desc: "Tell Jaume Tur about your website, digital menu or app. Based in Xàtiva, working in Valencia and 100% remote. Replies within 24 business hours.",
      eyebrow: "Contact", h1: "Let's talk about your project.",
      lead: "Web developer based in Xàtiva, available for web projects, custom applications and technical collaborations in person in Valencia or 100% online.",
      reply: "Typical response time: < 24 business hours",
      mail: "Write to Jaume", direct: "Direct email", copy: "Copy",
      brief: "Fill out a more detailed questionnaire", cv: "Download full CV (PDF)", maps: "View Google profile and reviews",
      formTitle: "Proposal form", formText: "Fill in your details and you will receive a technical proposal without commitment.", nocaptcha: "No CAPTCHA",
      pricing: "See services & pricing first", loc: "Xàtiva / Valencia, Spain. Remote work.",
    }
  : {
      title: "Contacto — pide presupuesto de diseño web en Valencia | Jaume Tur",
      desc: "Cuéntale a Jaume Tur tu web, carta digital o aplicación. Desde Xàtiva, para Valencia y 100 % en remoto. Respuesta en menos de 24 horas laborables.",
      eyebrow: "Contacto", h1: "Hablemos de tu proyecto.",
      lead: "Desarrollador web desde Xàtiva, disponible para proyectos web, aplicaciones a medida y colaboraciones técnicas, en Valencia o 100 % en línea.",
      reply: "Tiempo de respuesta habitual: < 24 horas laborables",
      mail: "Escribir a Jaume", direct: "Correo directo", copy: "Copiar",
      brief: "Haz un cuestionario más extenso", cv: "Descargar CV completo (PDF)", maps: "Ver perfil y reseñas en Google",
      formTitle: "Formulario de propuesta", formText: "Completa los datos y recibirás una valoración técnica sin compromiso.", nocaptcha: "Sin CAPTCHA",
      pricing: "Ver servicios y precios antes", loc: "Xàtiva / Valencia, España. Trabajo en línea.",
    };
const base = isEn ? "/en" : "";
---

<Layout fresh title={t.title} description={t.desc}>
  <section class="border-b border-white/10 bg-gradient-to-b from-[#111118] to-[#070709] px-4 pb-16 pt-16 sm:px-6 sm:pt-24">
    <div class="mx-auto max-w-(--breakpoint-xl)">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 class="display mt-4 max-w-4xl text-[clamp(2.5rem,6.5vw,4.8rem)] text-white">{t.h1}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/80">{t.lead}</p>
      <p class="chip mt-6 border-emerald-500/30 bg-emerald-500/10 text-emerald-400 font-semibold"><span class="h-2 w-2 rounded-full bg-emerald-400"></span>{t.reply}</p>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto grid max-w-(--breakpoint-xl) items-start gap-10 lg:grid-cols-12">
      <div class="space-y-4 lg:col-span-5">
        <div class="card flex items-center gap-4 border border-white/10 bg-surface p-6">
          <div class="relative h-20 w-20 shrink-0 overflow-hidden rounded-2xl border border-brand bg-[#1c1c24]">
            <img src="/img/3.webp" alt="Jaume Tur" width="96" height="96" class="h-full w-full object-contain pt-1" loading="eager" decoding="async" />
          </div>
          <div>
            <p class="font-display text-2xl font-bold text-white">Jaume Tur</p>
            <p class="text-xs font-semibold text-brand">Desarrollador Web</p>
            <p class="mt-1 text-xs text-white/60">{t.loc}</p>
          </div>
        </div>

        <a href="https://wa.me/34644525838?text=Hola%20Jaume,%20quiero%20informaci%C3%B3n%20sobre%20una%20web" target="_blank" rel="noopener noreferrer" class="btn btn-brand w-full justify-between">
          <span class="flex items-center gap-3"><Icon name="bx:bxl-whatsapp" class="h-6 w-6" />Hablar directamente por WhatsApp</span><span aria-hidden="true">→</span>
        </a>

        <div class="card flex items-center justify-between gap-3 border border-white/10 bg-surface p-4">
          <div class="min-w-0">
            <p class="font-mono text-[0.7rem] font-bold uppercase tracking-wider text-brand">{t.direct}</p>
            <a id="contact-email-link" href={mailto} class="block truncate font-semibold text-white hover:text-brand transition-colors">jaumetur3w@gmail.com</a>
          </div>
          <button id="copy-email-btn" type="button" class="chip hover:bg-brand hover:text-black transition-colors cursor-pointer"><Icon name="bx:copy" class="h-4 w-4" /><span id="copy-btn-label">{t.copy}</span></button>
        </div>

        <a href={`${base}/briefing/`} class="card flex items-center justify-between gap-3 border border-white/10 bg-surface p-4 font-semibold text-white hover:border-brand/60 transition-colors">
          <span class="flex items-center gap-3"><Icon name="bx:clipboard" class="h-5 w-5 text-brand" />{t.brief}</span><span aria-hidden="true" class="text-brand">→</span>
        </a>
        <a href={`${base}/pricing/`} class="card flex items-center justify-between gap-3 border border-brand/40 bg-brand/10 p-4 font-semibold text-white hover:border-brand transition-colors">
          <span class="flex items-center gap-3"><Icon name="bx:tag" class="h-5 w-5 text-brand" />{t.pricing}</span><span aria-hidden="true" class="text-brand">→</span>
        </a>

        <div class="grid grid-cols-2 gap-3">
          <a href="https://www.instagram.com/jaume.www/" target="_blank" rel="noopener noreferrer" class="card flex items-center gap-2.5 border border-white/10 bg-surface p-3.5 text-xs font-semibold text-white hover:border-brand hover:text-brand transition-colors"><Icon name="bx:bxl-instagram" class="h-4 w-4" />Instagram</a>
          <a href="https://www.linkedin.com/in/jautur/" target="_blank" rel="noopener noreferrer" class="card flex items-center gap-2.5 border border-white/10 bg-surface p-3.5 text-xs font-semibold text-white hover:border-brand hover:text-brand transition-colors"><Icon name="bx:bxl-linkedin" class="h-4 w-4" />LinkedIn</a>
          <a href="https://github.com/jaumetur3W" target="_blank" rel="noopener noreferrer" class="card flex items-center gap-2.5 border border-white/10 bg-surface p-3.5 text-xs font-semibold text-white hover:border-brand hover:text-brand transition-colors"><Icon name="bx:bxl-github" class="h-4 w-4" />GitHub</a>
          <a href="/docs/CV_Jaume_tur.pdf" target="_blank" rel="noopener noreferrer" id="contact-cv-btn" class="card flex items-center gap-2.5 border border-white/10 bg-surface p-3.5 text-xs font-semibold text-white hover:border-brand hover:text-brand transition-colors"><Icon name="bx:file" class="h-4 w-4" />CV (PDF)</a>
        </div>
        <a href="https://share.google/3tihWcZBWMyYHmjBp" target="_blank" rel="noopener noreferrer" class="card flex items-center gap-3 border border-white/10 bg-surface p-3.5 text-xs font-semibold text-white hover:border-brand hover:text-brand transition-colors">
          <Icon name="bx:map-pin" class="h-4 w-4 text-brand" />{t.maps}<span class="sr-only">({isEn ? "opens in new tab" : "se abre en una pestaña nueva"})</span>
        </a>
      </div>

      <div class="card border border-white/10 bg-surface p-6 sm:p-8 lg:col-span-7">
        <div class="mb-6 flex flex-wrap items-start justify-between gap-3 border-b border-white/10 pb-5">
          <div>
            <h2 class="font-display text-3xl font-extrabold tracking-tight">{t.formTitle}</h2>
            <p class="mt-1 text-sm text-ink/70">{t.formText}</p>
          </div>
          <span class="chip chip-brand">{t.nocaptcha}</span>
        </div>
        <Contactform />
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    var track = function (name) {
      if (typeof window.plausible === "function") window.plausible(name, { props: { location: "contact_page" } });
    };
    var copyBtn = document.getElementById("copy-email-btn");
    var copyLabel = document.getElementById("copy-btn-label");
    if (copyBtn && copyLabel) {
      copyBtn.addEventListener("click", function () {
        navigator.clipboard.writeText("jaumetur3w@gmail.com").then(function () {
          var en = document.documentElement.lang.indexOf("en") === 0;
          var prev = copyLabel.textContent;
          copyLabel.textContent = en ? "Copied!" : "¡Copiado!";
          setTimeout(function () { copyLabel.textContent = prev; }, 2000);
        });
      });
    }
    ["contact-email-cta", "contact-email-link"].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.addEventListener("click", function () { track("email_click"); });
    });
    var cv = document.getElementById("contact-cv-btn");
    if (cv) cv.addEventListener("click", function () { if (typeof window.plausible === "function") window.plausible("cv_download", { props: { location: "contact_page", format: "pdf" } }); });
  })();
</script>

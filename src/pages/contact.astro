---
import UiIcon from "@/components/ui-icon.astro";
import Contactform from "@/components/contactform.astro";
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/page-header.astro";
import { Icon } from "astro-icon/components";
import { localeFromPath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const subject = encodeURIComponent(isEn ? "New project inquiry" : "Nueva consulta de proyecto");
const mailto = `mailto:jaumetur3w@gmail.com?subject=${subject}`;

const t = isEn
  ? {
      title: "Contact — get a web design quote in Valencia | Jaume Tur",
      desc: "Tell Jaume Tur about your website, digital menu or app. Based in Xàtiva, working in Valencia and 100% remote. Replies within 24 business hours.",
      eyebrow: "Contact", h1: "Request a quote for your website or app.",
      lead: "Web developer based in Xàtiva, available for web projects, custom applications and technical collaborations in person in Valencia or 100% online.",
      reply: "Typical response time: < 24 business hours",
      mail: "Write to Jaume", direct: "Direct email", copy: "Copy",
      brief: "Fill out a more detailed questionnaire", cv: "Download full CV (PDF)", maps: "View Google profile and reviews",
      formTitle: "Proposal form", formText: "Fill in your details and you will receive a technical proposal without commitment.", nocaptcha: "No CAPTCHA",
      pricing: "See services & pricing first", loc: "Xàtiva / Valencia, Spain. Remote work.",
    }
  : {
      title: "Contacto — pide presupuesto de diseño web en Valencia | Jaume Tur",
      desc: "Cuéntale a Jaume Tur tu web, carta digital o aplicación. Desde Xàtiva, para Valencia y 100 % en remoto. Respuesta en menos de 24 horas laborables.",
      eyebrow: "Contacto", h1: "Pide presupuesto para tu web o aplicación.",
      lead: "Desarrollador web desde Xàtiva, disponible para proyectos web, aplicaciones a medida y colaboraciones técnicas, en Valencia o 100 % en línea.",
      reply: "Tiempo de respuesta habitual: < 24 horas laborables",
      mail: "Escribir a Jaume", direct: "Correo directo", copy: "Copiar",
      brief: "Haz un cuestionario más extenso", cv: "Descargar CV completo (PDF)", maps: "Ver perfil y reseñas en Google",
      formTitle: "Formulario de propuesta", formText: "Completa los datos y recibirás una valoración técnica sin compromiso.", nocaptcha: "Sin CAPTCHA",
      pricing: "Ver servicios y precios antes", loc: "Xàtiva / Valencia, España. Trabajo en línea.",
    };
const base = isEn ? "/en" : "";
---

<Layout fresh title={t.title} description={t.desc}>
  <PageHeader tone="yellow" title={t.h1} lede={t.lead} sticker={t.eyebrow} stickers={[t.reply, isEn ? "No CAPTCHA" : "Sin CAPTCHA"]} />

  <section class="section">
    <div class="wrap grid items-start gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <div class="flex items-center gap-4">
          <div class="cutout h-24 w-20 shrink-0 rotate-[-4deg]">
            <img src="/img/jaume-tur-contacto.webp" alt="Jaume Tur" width="96" height="120" class="h-full w-full" loading="eager" decoding="async" />
          </div>
          <div>
            <p class="font-display text-[1.8rem] font-extrabold leading-none tracking-[-0.04em]">Jaume Tur</p>
            <p class="muted mt-1 text-[0.95rem]">{isEn ? "Web developer" : "Desarrollador web"}</p>
            <p class="faint text-[0.9rem]">{t.loc}</p>
          </div>
        </div>

        <a href={mailto} class="btn btn-ink mt-7 w-full justify-between">
          <span class="flex items-center gap-3"><Icon name="bx:envelope" class="h-6 w-6" />{isEn ? "Write by email" : "Escribir por correo"} · jaumetur3w@gmail.com</span><UiIcon name="arrow" aria-hidden="true" />
        </a>

        <a href="https://wa.me/34644525838?text=Hola%20Jaume,%20quiero%20informaci%C3%B3n%20sobre%20una%20web" target="_blank" rel="noopener noreferrer" class="btn btn-white mt-3 w-full justify-between">
          <span class="flex items-center gap-3"><Icon name="bx:bxl-whatsapp" class="h-6 w-6" />{isEn ? "Talk on WhatsApp" : "Hablar por WhatsApp"} · +34 644 525 838<span class="sr-only"> ({isEn ? "opens in a new tab" : "se abre en pestaña nueva"})</span></span><UiIcon name="arrow" aria-hidden="true" />
        </a>

        <ul class="mt-7 border-b border-rule">
          <li class="flex items-center justify-between gap-3 border-t border-rule py-3">
            <div class="min-w-0">
              <p class="label">{t.direct}</p>
              <a id="contact-email-link" href={mailto} class="block truncate font-semibold underline decoration-ink decoration-2 underline-offset-4 hover:decoration-ink">jaumetur3w@gmail.com</a>
            </div>
            <button id="copy-email-btn" type="button" class="btn btn-white btn-sm shrink-0"><Icon name="bx:copy" class="h-4 w-4" /><span id="copy-btn-label">{t.copy}</span></button>
          </li>
          <li class="border-t border-rule">
            <a href={`${base}/briefing/`} class="flex min-h-14 items-center justify-between gap-3 font-semibold hover:bg-brand"><span class="flex items-center gap-3"><Icon name="bx:clipboard" class="h-5 w-5 text-ink" />{t.brief}</span><UiIcon name="arrow" aria-hidden="true" class="text-ink" /></a>
          </li>
          <li class="border-t border-rule">
            <a href={`${base}/pricing/`} class="flex min-h-14 items-center justify-between gap-3 font-semibold hover:bg-brand"><span class="flex items-center gap-3"><Icon name="bx:tag" class="h-5 w-5 text-ink" />{t.pricing}</span><UiIcon name="arrow" aria-hidden="true" class="text-ink" /></a>
          </li>
          <li class="border-t border-rule">
            <a href="https://share.google/3tihWcZBWMyYHmjBp" target="_blank" rel="noopener noreferrer" class="flex min-h-14 items-center justify-between gap-3 font-semibold hover:bg-brand"><span class="flex items-center gap-3"><Icon name="bx:map-pin" class="h-5 w-5 text-ink" />{t.maps}</span><UiIcon name="external" aria-hidden="true" class="text-ink" /><span class="sr-only">({isEn ? "opens in a new tab" : "se abre en una pestaña nueva"})</span></a>
          </li>
          <li class="border-t border-rule">
            <a href="/docs/CV_Jaume_tur.pdf" target="_blank" rel="noopener noreferrer" id="contact-cv-btn" class="flex min-h-14 items-center justify-between gap-3 font-semibold hover:bg-brand"><span class="flex items-center gap-3"><Icon name="bx:file" class="h-5 w-5 text-ink" />{t.cv}</span><UiIcon name="external" aria-hidden="true" class="text-ink" /></a>
          </li>
        </ul>

        <ul class="mt-4 flex flex-wrap gap-2">
          <li><a href="https://www.instagram.com/jaume.www/" target="_blank" rel="noopener noreferrer" class="btn btn-white btn-sm"><Icon name="bx:bxl-instagram" class="h-4 w-4" />Instagram<span class="sr-only"> ({isEn ? "opens in a new tab" : "se abre en pestaña nueva"})</span></a></li>
          <li><a href="https://www.linkedin.com/in/jautur/" target="_blank" rel="noopener noreferrer" class="btn btn-white btn-sm"><Icon name="bx:bxl-linkedin" class="h-4 w-4" />LinkedIn<span class="sr-only"> ({isEn ? "opens in a new tab" : "se abre en pestaña nueva"})</span></a></li>
          <li><a href="https://github.com/jaumetur3W" target="_blank" rel="noopener noreferrer" class="btn btn-white btn-sm"><Icon name="bx:bxl-github" class="h-4 w-4" />GitHub<span class="sr-only"> ({isEn ? "opens in a new tab" : "se abre en pestaña nueva"})</span></a></li>
        </ul>
      </div>

      <div class="sheet relative lg:col-span-7 lg:rotate-[0.6deg]">
        <div class="sheet-head flex items-center justify-between">
          <span class="label !text-ink">{t.formTitle}</span>
          <span class="label !text-ink">{t.reply}</span>
        </div>
        <div class="p-6 sm:p-8">
        <h2 class="h-card">{t.formText}</h2>
        <div class="mt-7 border-t-2 border-ink pt-7">
          <Contactform />
        </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    var track = function (name) {
      if (typeof window.plausible === "function") window.plausible(name, { props: { location: "contact_page" } });
    };
    var copyBtn = document.getElementById("copy-email-btn");
    var copyLabel = document.getElementById("copy-btn-label");
    if (copyBtn && copyLabel) {
      copyBtn.addEventListener("click", function () {
        navigator.clipboard.writeText("jaumetur3w@gmail.com").then(function () {
          var en = document.documentElement.lang.indexOf("en") === 0;
          var prev = copyLabel.textContent;
          copyLabel.textContent = en ? "Copied!" : "¡Copiado!";
          setTimeout(function () { copyLabel.textContent = prev; }, 2000);
        });
      });
    }
    ["contact-email-cta", "contact-email-link"].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.addEventListener("click", function () { track("email_click"); });
    });
    var cv = document.getElementById("contact-cv-btn");
    if (cv) cv.addEventListener("click", function () { if (typeof window.plausible === "function") window.plausible("cv_download", { props: { location: "contact_page", format: "pdf" } }); });
  })();
</script>

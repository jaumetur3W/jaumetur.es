---
import Contactform from "@/components/contactform.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { localeFromPath, localizePath } from "@/i18n";
const isVal = localeFromPath(Astro.url.pathname) === "val";
const href = (path: string) => localizePath(path, isVal ? "val" : "es");
---

<Layout
  title={isVal ? "Contacte | Desenvolupament Web a Xàtiva i València | Jaume Tur" : "Contacto | Desarrollo Web en Xàtiva y Valencia | Jaume Tur"}
  description={isVal ? "Contacta amb Jaume Tur per parlar del teu projecte web, aplicació a mida, consultoria o col·laboració des de Xàtiva, València o en remot." : "Contacta con Jaume Tur para hablar sobre tu proyecto web, aplicación a medida, consultoría o colaboración desde Xàtiva, Valencia o en remoto."}>
  <Container>
    <!-- Capçalera -->
    <Sectionhead>
      <Fragment slot="title">{isVal ? "Parlem del teu projecte" : "Hablemos de tu proyecto"}</Fragment>
      <Fragment slot="desc">
        {isVal
          ? "Desenvolupador web a Xàtiva i València disponible per a projectes web, aplicacions a mida i col·laboracions tècniques en modalitat remota o híbrida."
          : "Desarrollador web en Xàtiva y Valencia disponible para proyectos web, aplicaciones a medida y colaboraciones técnicas en modalidad remota o híbrida."}
      </Fragment>
    </Sectionhead>

    <!-- Indicador de Resposta Ràpida -->
    <div class="flex justify-center mt-6 mb-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-mono font-medium bg-emerald-50 text-emerald-800 border border-emerald-200/80 shadow-2xs">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span>{isVal ? "Temps de resposta habitual: < 24 hores laborables" : "Tiempo de respuesta habitual: < 24 horas laborables"}</span>
      </div>
    </div>

    <div class="grid lg:grid-cols-12 gap-8 max-w-5xl mx-auto items-start">
      
      <!-- Columna Esquerra: Canals Directes & Prova Social (5 columnes) -->
      <div class="lg:col-span-5 space-y-4">
        
        <!-- Targeta d'identitat amb Memoji 3.png -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 relative overflow-visible group transition-colors hover:border-slate-400">
          <div class="flex items-center gap-4">
            <div class="relative shrink-0 -my-4 -ml-2 z-10">
              <img
                src="/img/3.webp"
                alt="Memoji de Jaume Tur saludant"
                class="w-24 h-24 sm:w-28 sm:h-28 object-contain drop-shadow-[0_8px_16px_rgba(15,23,42,0.16)] group-hover:scale-105 transition-transform duration-200"
                width="112"
                height="112"
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <div>
              <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-indigo-600 block">
                {isVal ? "Desenvolupador web · Frontend" : "Desarrollador web · Frontend"}
              </span>
              <h2 class="font-extrabold text-lg text-slate-900 leading-tight mt-0.5">
                Jaume Tur
              </h2>
              <p class="text-xs text-slate-500 mt-1 leading-relaxed">
                {isVal ? "Xàtiva / València, Espanya. Treball presencial i remot." : "Xàtiva / Valencia, España. Trabajo presencial y remoto."}
              </p>
            </div>
          </div>
        </div>

        <!-- Contacte directe per correu -->
        <a
          href="mailto:jaumetur3w@gmail.com?subject=Nova%20consulta%20de%20projecte"
          id="contact-email-cta"
          class="p-4 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs flex items-center justify-between shadow-md transition group">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-indigo-500/80 flex items-center justify-center text-white shrink-0">
              <Icon name="bx:envelope" class="w-5 h-5 group-hover:scale-110 transition-transform" />
            </div>
            <div>
              <span class="text-[10px] uppercase font-mono tracking-wider opacity-90 block">{isVal ? "Correu directe" : "Correo directo"}</span>
              <span class="text-sm font-extrabold">{isVal ? "Escriure a Jaume" : "Escribir a Jaume"}</span>
            </div>
          </div>
          <Icon name="bx:right-arrow-alt" class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
        </a>

        <!-- Correu Electrònic amb 1-Click Copy -->
        <div class="bg-white border border-slate-200/90 rounded-2xl p-4 flex items-center justify-between gap-2 shadow-2xs group hover:border-indigo-300 transition-colors">
          <div class="flex items-center gap-3 overflow-hidden">
            <div class="w-9 h-9 rounded-xl bg-indigo-50 border border-indigo-100 text-indigo-600 flex items-center justify-center shrink-0">
              <Icon name="bx:envelope" class="w-4 h-4" />
            </div>
            <div class="truncate">
              <span class="text-[10px] font-mono font-bold text-indigo-600 uppercase tracking-wider block">{isVal ? "Correu directe" : "Correo directo"}</span>
              <a
                href="mailto:jaumetur3w@gmail.com?subject=Nova%20consulta%20de%20projecte"
                id="contact-email-link"
                class="text-xs sm:text-sm font-bold text-slate-800 hover:text-indigo-600 transition truncate block">
                jaumetur3w@gmail.com
              </a>
            </div>
          </div>
          <button
            id="copy-email-btn"
            type="button"
            class="shrink-0 text-xs font-mono font-bold px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-indigo-50 border border-slate-200 text-slate-700 hover:text-indigo-600 transition flex items-center gap-1 cursor-pointer"
            title={isVal ? "Copiar correu electrònic" : "Copiar correo electrónico"}>
            <Icon name="bx:copy" class="w-3.5 h-3.5" />
            <span id="copy-btn-label">Copiar</span>
          </button>
        </div>

        <!-- Descàrrega de CV Oficial -->
        <a
          href="/docs/CV_Jaume_tur.pdf"
          target="_blank"
          rel="noopener noreferrer"
          id="contact-cv-btn"
          class="bg-white border border-slate-200/90 hover:border-slate-800 rounded-2xl p-4 flex items-center justify-between transition group shadow-2xs">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-slate-100 border border-slate-200 text-slate-800 flex items-center justify-center shrink-0">
              <Icon name="bx:file" class="w-4 h-4 text-slate-700 group-hover:text-indigo-600 transition-colors" />
            </div>
            <div>
              <span class="text-[10px] font-mono font-bold text-slate-500 uppercase tracking-wider block">{isVal ? "Currículum professional" : "Currículum profesional"}</span>
              <span class="text-xs sm:text-sm font-bold text-slate-900 group-hover:text-indigo-600 transition-colors">
                {isVal ? "Descarregar CV complet (PDF)" : "Descargar CV completo (PDF)"}
              </span>
            </div>
          </div>
          <span class="text-slate-400 group-hover:text-slate-900 text-xs font-mono font-bold">↗</span>
        </a>

        <!-- Xarxes Professionals Reals (Prioritat Tècnica: GitHub & LinkedIn) -->
        <div class="grid grid-cols-2 gap-3 pt-1">
          <a
            href="https://github.com/jaumetur3W"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white border border-slate-200/90 hover:border-slate-900 rounded-2xl p-3.5 flex items-center gap-3 transition group shadow-2xs">
            <div class="w-9 h-9 rounded-xl bg-slate-100 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <Icon name="bx:bxl-github" class="w-5 h-5 text-slate-900" />
            </div>
            <div class="truncate">
              <span class="text-[9px] font-mono uppercase text-slate-400 block font-bold">{isVal ? "Codi i repositoris" : "Código y repositorios"}</span>
              <span class="text-xs font-bold text-slate-800 group-hover:text-indigo-600 transition-colors">GitHub (@jaumetur3W)</span>
            </div>
          </a>

          <a
            href="https://www.linkedin.com/in/jautur/"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white border border-slate-200/90 hover:border-indigo-400 rounded-2xl p-3.5 flex items-center gap-3 transition group shadow-2xs">
            <div class="w-9 h-9 rounded-xl bg-indigo-50 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <Icon name="bx:bxl-linkedin" class="w-5 h-5 text-indigo-600" />
            </div>
            <div class="truncate">
              <span class="text-[9px] font-mono uppercase text-slate-400 block font-bold">Trajectòria</span>
              <span class="text-xs font-bold text-slate-800 group-hover:text-indigo-600 transition-colors">LinkedIn (in/jautur)</span>
            </div>
          </a>
        </div>

        <a
          href="https://www.instagram.com/jaume.www/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={isVal ? "Visita l'Instagram de Jaume Tur, @jaume.www (s'obri en una pestanya nova)" : "Visita el Instagram de Jaume Tur, @jaume.www (se abre en una pestaña nueva)"}
          class="bg-white border border-slate-200/90 hover:border-pink-300 rounded-2xl p-3.5 flex items-center gap-3 transition group shadow-2xs">
          <div class="w-9 h-9 rounded-xl bg-pink-50 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
            <Icon name="bx:bxl-instagram" class="w-5 h-5 text-pink-600" />
          </div>
          <div class="truncate">
            <span class="text-[9px] font-mono uppercase text-slate-400 block font-bold">Instagram</span>
            <span class="text-xs font-bold text-slate-800 group-hover:text-pink-600 transition-colors">@jaume.www</span>
          </div>
          <Icon name="bx:link-external" class="w-4 h-4 text-slate-400 ml-auto" />
        </a>

        <!-- Caixa de Garantia & Prova Social Real -->
        <div class="p-4 rounded-2xl bg-indigo-50/60 border border-indigo-100 text-xs text-slate-700 space-y-1.5 font-sans">
          <span class="font-bold text-indigo-900 flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wider">
            <Icon name="bx:shield-quarter" class="w-4 h-4 text-indigo-600" />
            <span>{isVal ? "Honestedat i transparència" : "Honestidad y transparencia"}</span>
          </span>
          <p class="text-[11px] leading-relaxed text-slate-600">
            {isVal ? "Tots els projectes compten amb documentació tècnica pública i codi auditable. Consulta els " : "Todos los proyectos incluyen documentación técnica pública y código auditable. Consulta los "}<a href={href("/pricing")} class="font-bold text-indigo-600 underline">{isVal ? "paquets de serveis" : "paquetes de servicios"}</a>{isVal ? " o els " : " o los "}<a href={href("/#projectes")} class="font-bold text-indigo-600 underline">{isVal ? "casos d'estudi reals" : "casos de estudio reales"}</a>.
          </p>
        </div>

      </div>

      <!-- Columna Dreta: Formulari Accessible (7 columnes) -->
      <div class="lg:col-span-7 bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 transition-colors hover:border-slate-400">
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-100">
          <div>
            <h3 class="font-extrabold text-lg text-slate-900 flex items-center gap-2">
              <Icon name="bx:message-square-edit" class="w-5 h-5 text-indigo-600" />
              <span>{isVal ? "Formulari de proposta" : "Formulario de propuesta"}</span>
            </h3>
            <p class="text-xs text-slate-500 mt-0.5">
              {isVal ? "Completa les dades i rebràs una valoració tècnica sense compromís." : "Completa los datos y recibirás una valoración técnica sin compromiso."}
            </p>
          </div>
          <span class="text-[10px] font-mono font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
            {isVal ? "Sense CAPTCHA" : "Sin CAPTCHA"}
          </span>
        </div>

        <Contactform />
      </div>

    </div>
  </Container>
</Layout>

<script is:inline>
  // Còpia ràpida del correu amb feedback accessible
  const copyBtn = document.getElementById("copy-email-btn");
  const copyLabel = document.getElementById("copy-btn-label");
  if (copyBtn && copyLabel) {
    copyBtn.addEventListener("click", () => {
      navigator.clipboard.writeText("jaumetur3w@gmail.com").then(() => {
        copyLabel.textContent = document.documentElement.lang.startsWith("ca") ? "Copiat!" : "¡Copiado!";
        copyBtn.className = "shrink-0 text-xs font-mono font-bold px-3 py-1.5 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-700 transition flex items-center gap-1";
        setTimeout(() => {
          copyLabel.textContent = "Copiar";
          copyBtn.className = "shrink-0 text-xs font-mono font-bold px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-indigo-50 border border-slate-200 text-slate-700 hover:text-indigo-600 transition flex items-center gap-1 cursor-pointer";
        }, 2000);
      });
    });
  }

  // Seguiment del contacte directe per correu
  const emailCta = document.getElementById("contact-email-cta");
  if (emailCta) {
    emailCta.addEventListener("click", () => {
      if (typeof window.plausible === "function") {
        window.plausible("email_click", { props: { location: "contact_page" } });
      }
    });
  }

  const cvBtn = document.getElementById("contact-cv-btn");
  if (cvBtn) {
    cvBtn.addEventListener("click", () => {
      if (typeof window.plausible === "function") {
        window.plausible("cv_download", { props: { location: "contact_page", format: "pdf" } });
      }
    });
  }

  const emailLink = document.getElementById("contact-email-link");
  if (emailLink) {
    emailLink.addEventListener("click", () => {
      if (typeof window.plausible === "function") {
        window.plausible("email_click", { props: { location: "contact_page" } });
      }
    });
  }
</script>

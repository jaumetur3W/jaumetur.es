---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import { servicesData, getLocalizedService, type ServicePackage } from "@/data/services";
import { localeFromPath, localizePath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const to = (path: string) => {
  const [base, query] = path.split("?");
  const p = localizePath(base, isEn ? "en" : "es");
  const normalized = p === "/" || p.endsWith("/") ? p : `${p}/`;
  return query ? `${normalized}?${query}` : normalized;
};

export async function getStaticPaths() {
  return servicesData.map((service, index) => ({
    params: { slug: service.id },
    props: {
      service,
      prev: servicesData[(index - 1 + servicesData.length) % servicesData.length],
      next: servicesData[(index + 1) % servicesData.length],
    },
  }));
}

interface Props {
  service: ServicePackage;
  prev: ServicePackage;
  next: ServicePackage;
}

const { service, prev, next } = Astro.props;
const loc = isEn ? "en" : "es";
const s = getLocalizedService(service, loc);
const p = getLocalizedService(prev, loc);
const n = getLocalizedService(next, loc);
const monthly = (v: number) => (isEn ? `€${v}/month` : `${v} €/mes`);
const euro = (v: number) => (isEn ? `€${v.toLocaleString("en-US")}` : `${v.toLocaleString("es-ES")} €`);
const siteUrl = "https://jaumetur.es";

const t = isEn
  ? {
      home: "Home", services: "Services & pricing", from: "From", deliver: "Delivery", firstYear: "First year",
      forWho: "Ideal for", includes: "What's included", why: "Where the price comes from", creation: "Creation price covers",
      maint: "Monthly fee covers", commit: "Why a one-year commitment", worth: "How it pays off",
      worthNote: "Results depend on each business; these are the ways the investment can pay off.",
      compare: "How it compares with the alternatives", price: "Price", maintenance: "Maintenance", hidden: "Hidden costs", ownership: "Ownership",
      request: "Request this plan", other: "Other plans", prev: "Previous", next: "Next", ctaTitle: "Shall we talk about it?",
      ctaText: "Tell me about your project and I'll confirm scope, price and timeline.",
      title: `${s.name} — pricing and what's included`,
      desc: `${s.tagline} From ${euro(service.creationPriceNumber)} + ${monthly(service.monthlyFeeNumber)}. See what's included and how it compares.`,
    }
  : {
      home: "Inicio", services: "Servicios y precios", from: "Desde", deliver: "Entrega", firstYear: "Primer año",
      forWho: "Ideal para", includes: "Qué incluye", why: "De dónde sale el precio", creation: "El precio de creación cubre",
      maint: "La cuota mensual cubre", commit: "Por qué una permanencia de un año", worth: "Cómo se amortiza",
      worthNote: "Los resultados dependen de cada negocio; estas son las vías por las que la inversión puede amortizarse.",
      compare: "Comparativa con las alternativas", price: "Precio", maintenance: "Mantenimiento", hidden: "Costes ocultos", ownership: "Propiedad",
      request: "Solicitar este plan", other: "Otros planes", prev: "Anterior", next: "Siguiente", ctaTitle: "¿Lo hablamos?",
      ctaText: "Cuéntame tu proyecto y te confirmo alcance, precio y plazo.",
      title: `${s.name} — precio y qué incluye`,
      desc: `${s.tagline} Desde ${euro(service.creationPriceNumber)} + ${monthly(service.monthlyFeeNumber)}. Qué incluye y cómo se compara.`,
    };

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": s.name,
  "description": s.description,
  "provider": { "@id": `${siteUrl}/#service` },
  "areaServed": ["Xàtiva", "València", "España"],
  "audience": { "@type": "Audience", "audienceType": s.targetAudience },
  "offers": {
    "@type": "Offer",
    "price": service.creationPriceNumber,
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "url": `${siteUrl}${to(`/pricing/${service.id}`)}`,
    "description": `${s.creationPrice} + ${monthly(service.monthlyFeeNumber)}`,
  },
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": t.home, "item": `${siteUrl}${to("/")}` },
    { "@type": "ListItem", "position": 2, "name": t.services, "item": `${siteUrl}${to("/pricing")}` },
    { "@type": "ListItem", "position": 3, "name": s.name, "item": `${siteUrl}${to(`/pricing/${service.id}`)}` },
  ],
};
---

<Layout fresh title={t.title} description={t.desc} jsonLd={[serviceSchema, breadcrumb]}>
  <section class="border-b border-white/10 bg-gradient-to-b from-[#111118] to-[#070709] px-4 pb-14 pt-10 sm:px-6">
    <div class="mx-auto max-w-(--breakpoint-xl)">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 font-mono text-xs text-white/50">
        <a href={to("/")} class="hover:text-brand transition-colors">{t.home}</a><span aria-hidden="true">/</span>
        <a href={to("/pricing")} class="hover:text-brand transition-colors">{t.services}</a><span aria-hidden="true">/</span>
        <span aria-current="page" class="text-brand">{s.name}</span>
      </nav>
      <div class="mt-8 grid items-end gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-brand/40 bg-brand/10 px-3.5 py-1 text-xs font-bold text-brand"><Icon name={s.icon} class="h-4 w-4" />{s.badge}</span>
          <h1 class="display mt-5 text-[clamp(2.2rem,5.5vw,4.25rem)] text-white">{s.name}</h1>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink/80">{s.description}</p>
        </div>
        <div class="card border border-brand/40 bg-[#121218] p-8 text-white lg:col-span-5 shadow-[0_0_35px_rgba(255,255,0,0.15)]">
          <p class="font-mono text-xs font-bold uppercase tracking-wider text-brand">{t.from}</p>
          <p class="display mt-1 text-5xl font-black text-white sm:text-6xl">{euro(service.creationPriceNumber)}</p>
          <p class="mt-2 text-sm text-ink/75">+ {monthly(service.monthlyFeeNumber)} de mantenimiento</p>
          <div class="mt-6 space-y-2 border-t border-white/10 pt-4 text-xs text-white/70">
            <div class="flex justify-between"><span class="text-white/50">{t.deliver}:</span> <span class="font-semibold text-white">{s.timeline}</span></div>
            <div class="flex justify-between"><span class="text-white/50">{t.firstYear}:</span> <span class="font-semibold text-white">{s.annualTotal}</span></div>
          </div>
          <a href={to(`/contact?servei=${service.id}`)} class="btn btn-brand mt-6 w-full justify-center">{s.ctaText}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-5 sm:py-24">
    <div class="mx-auto grid max-w-(--breakpoint-xl) gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="display text-[clamp(1.8rem,4vw,3rem)]">{t.includes}</h2>
        <ul class="mt-6 space-y-3">
          {s.features.map((f) => (
            <li class="card flex gap-3 p-4 border border-white/10 bg-surface leading-snug">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand text-sm font-bold text-black ring-2 ring-white/10" aria-hidden="true">✓</span>
              <span class="text-white/90">{f}</span>
            </li>
          ))}
        </ul>
      </div>
      <aside class="lg:col-span-5">
        <div class="card border border-white/10 bg-surface p-7">
          <h2 class="font-display text-2xl font-extrabold text-white">{t.forWho}</h2>
          <p class="mt-3 leading-relaxed text-zinc-300">{s.targetAudience}</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-y border-white/10 bg-[#09090d] px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-(--breakpoint-xl)">
      <h2 class="display text-[clamp(1.8rem,4vw,3rem)] text-white">{t.why}</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="card border border-white/10 bg-surface p-6 sm:p-8">
          <h3 class="font-display text-xl font-bold text-white">{t.creation}</h3>
          <ul class="mt-4 space-y-2 text-sm text-ink/80 leading-relaxed">
            {s.whyThisPrice.creationBreakdown.map((x) => <li class="flex gap-2"><span class="text-brand font-bold" aria-hidden="true">▸</span><span>{x}</span></li>)}
          </ul>
        </div>
        <div class="card border border-white/10 bg-surface p-6 sm:p-8">
          <h3 class="font-display text-xl font-bold text-white">{t.maint}</h3>
          <ul class="mt-4 space-y-2 text-sm text-ink/80 leading-relaxed">
            {s.whyThisPrice.monthlyBreakdown.map((x) => <li class="flex gap-2"><span class="text-brand font-bold" aria-hidden="true">▸</span><span>{x}</span></li>)}
          </ul>
        </div>
      </div>
      <div class="card mt-6 border border-brand/40 bg-brand/10 p-6 sm:p-8">
        <h3 class="font-display text-xl font-bold text-white">{t.commit}</h3>
        <p class="mt-2 text-sm text-ink/80 leading-relaxed">{s.whyThisPrice.whyCommitmentOneYear}</p>
      </div>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-(--breakpoint-xl)">
      <h2 class="display text-[clamp(1.8rem,4vw,3rem)] text-white">{t.worth}</h2>
      <p class="mt-4 max-w-2xl text-ink/75">{t.worthNote}</p>
      <p class="mt-4 text-lg font-bold text-brand">{s.amortizationSummary}</p>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2">
        {s.amortizationPoints.map((a) => (
          <li class="card border border-white/10 bg-surface p-6">
            <p class="inline-flex rounded-md bg-brand px-2.5 py-1 text-xs font-bold text-black">{a.metric}</p>
            <h3 class="mt-3 font-display text-lg font-bold text-white">{a.title}</h3>
            <p class="mt-2 text-sm text-ink/75 leading-relaxed">{a.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-y border-white/10 bg-[#09090d] px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-(--breakpoint-xl)">
      <h2 class="display text-[clamp(1.8rem,4vw,3rem)] text-white">{t.compare}</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {s.marketComparison.map((m, i) => (
          <article class:list={["card p-6 border", i === 0 ? "border-brand/60 bg-gradient-to-br from-brand/10 to-surface" : "border-white/10 bg-surface"]}>
            <h3 class="font-display text-xl font-bold text-white">{m.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/75">{m.summary}</p>
            <dl class="mt-4 space-y-1.5 border-t border-white/10 pt-4 text-xs text-white/70">
              <div><dt class="inline text-white/50">{t.price}:</dt> <dd class="inline font-semibold text-white">{m.priceRange}</dd></div>
              <div><dt class="inline text-white/50">{t.maintenance}:</dt> <dd class="inline font-semibold text-white">{m.maintenanceCost}</dd></div>
              <div><dt class="inline text-white/50">{t.hidden}:</dt> <dd class="inline font-semibold text-white">{m.hiddenCosts}</dd></div>
              <div><dt class="inline text-white/50">{t.ownership}:</dt> <dd class="inline font-semibold text-white">{m.codeOwnership}</dd></div>
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden px-4 py-20 text-center sm:px-6 sm:py-28">
    <div class="pointer-events-none absolute left-1/2 top-1/2 h-[22rem] w-[46rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/15 blur-[120px]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl">
      <h2 class="display text-[clamp(2rem,5vw,3.6rem)] text-white">{t.ctaTitle}</h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-ink/80">{t.ctaText}</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href={to("/contact")} class="btn btn-brand">{s.ctaText} <span aria-hidden="true">→</span></a>
      </div>
      <nav aria-label={t.other} class="mx-auto mt-12 grid max-w-3xl gap-4 text-left sm:grid-cols-2">
        <a href={to(`/pricing/${prev.id}`)} class="card border border-white/10 bg-surface p-5 hover:border-brand/50 transition-colors"><span class="font-mono text-xs font-bold uppercase text-brand">← {t.prev}</span><span class="mt-1 block font-display text-base font-bold text-white">{p.name}</span></a>
        <a href={to(`/pricing/${next.id}`)} class="card border border-white/10 bg-surface p-5 sm:text-right hover:border-brand/50 transition-colors"><span class="font-mono text-xs font-bold uppercase text-brand">{t.next} →</span><span class="mt-1 block font-display text-base font-bold text-white">{n.name}</span></a>
      </nav>
    </div>
  </section>
</Layout>

---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import { servicesData, getLocalizedService, type ServicePackage } from "@/data/services";
import { localeFromPath, localizePath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const to = (path: string) => {
  const p = localizePath(path, isEn ? "en" : "es");
  return p === "/" || p.endsWith("/") ? p : `${p}/`;
};

export async function getStaticPaths() {
  return servicesData.map((service, index) => ({
    params: { slug: service.id },
    props: {
      service,
      prev: servicesData[(index - 1 + servicesData.length) % servicesData.length],
      next: servicesData[(index + 1) % servicesData.length],
    },
  }));
}

interface Props {
  service: ServicePackage;
  prev: ServicePackage;
  next: ServicePackage;
}

const { service, prev, next } = Astro.props;
const loc = isEn ? "en" : "es";
const s = getLocalizedService(service, loc);
const p = getLocalizedService(prev, loc);
const n = getLocalizedService(next, loc);
const monthly = (v: number) => (isEn ? `€${v}/month` : `${v} €/mes`);
const euro = (v: number) => (isEn ? `€${v.toLocaleString("en-US")}` : `${v.toLocaleString("es-ES")} €`);
const siteUrl = "https://jaumetur.es";

const t = isEn
  ? {
      home: "Home", services: "Services & pricing", from: "From", deliver: "Delivery", firstYear: "First year",
      forWho: "Ideal for", includes: "What's included", why: "Where the price comes from", creation: "Creation price covers",
      maint: "Monthly fee covers", commit: "Why a one-year commitment", worth: "How it pays off",
      worthNote: "Results depend on each business; these are the ways the investment can pay off.",
      compare: "How it compares with the alternatives", price: "Price", maintenance: "Maintenance", hidden: "Hidden costs", ownership: "Ownership",
      request: "Request this plan", other: "Other plans", prev: "Previous", next: "Next", ctaTitle: "Shall we talk about it?",
      ctaText: "Tell me about your project and I'll confirm scope, price and timeline.",
      title: `${s.name} — pricing and what's included`,
      desc: `${s.tagline} From ${euro(service.creationPriceNumber)} + ${monthly(service.monthlyFeeNumber)}. See what's included and how it compares.`,
    }
  : {
      home: "Inicio", services: "Servicios y precios", from: "Desde", deliver: "Entrega", firstYear: "Primer año",
      forWho: "Ideal para", includes: "Qué incluye", why: "De dónde sale el precio", creation: "El precio de creación cubre",
      maint: "La cuota mensual cubre", commit: "Por qué una permanencia de un año", worth: "Cómo se amortiza",
      worthNote: "Los resultados dependen de cada negocio; estas son las vías por las que la inversión puede amortizarse.",
      compare: "Comparativa con las alternativas", price: "Precio", maintenance: "Mantenimiento", hidden: "Costes ocultos", ownership: "Propiedad",
      request: "Solicitar este plan", other: "Otros planes", prev: "Anterior", next: "Siguiente", ctaTitle: "¿Lo hablamos?",
      ctaText: "Cuéntame tu proyecto y te confirmo alcance, precio y plazo.",
      title: `${s.name} — precio y qué incluye`,
      desc: `${s.tagline} Desde ${euro(service.creationPriceNumber)} + ${monthly(service.monthlyFeeNumber)}. Qué incluye y cómo se compara.`,
    };

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": s.name,
  "description": s.description,
  "provider": { "@id": `${siteUrl}/#service` },
  "areaServed": ["Xàtiva", "València", "España"],
  "audience": { "@type": "Audience", "audienceType": s.targetAudience },
  "offers": {
    "@type": "Offer",
    "price": service.creationPriceNumber,
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "url": `${siteUrl}${to(`/pricing/${service.id}`)}`,
    "description": `${s.creationPrice} + ${monthly(service.monthlyFeeNumber)}`,
  },
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": t.home, "item": `${siteUrl}${to("/")}` },
    { "@type": "ListItem", "position": 2, "name": t.services, "item": `${siteUrl}${to("/pricing")}` },
    { "@type": "ListItem", "position": 3, "name": s.name, "item": `${siteUrl}${to(`/pricing/${service.id}`)}` },
  ],
};
---

<Layout fresh title={t.title} description={t.desc} jsonLd={[serviceSchema, breadcrumb]}>
  <section class="border-b-2 border-ink bg-brand px-4 pb-14 pt-8 sm:px-5">
    <div class="mx-auto max-w-(--breakpoint-xl)">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 font-mono text-xs font-bold">
        <a href={to("/")} class="underline underline-offset-4 hover:no-underline">{t.home}</a><span aria-hidden="true">/</span>
        <a href={to("/pricing")} class="underline underline-offset-4 hover:no-underline">{t.services}</a><span aria-hidden="true">/</span>
        <span aria-current="page">{s.name}</span>
      </nav>
      <div class="mt-10 grid items-end gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <span class="chip bg-ink! text-brand"><Icon name={s.icon} class="h-4 w-4" />{s.badge}</span>
          <h1 class="display mt-5 text-[clamp(2.2rem,5.5vw,4.25rem)]">{s.name}</h1>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink/85">{s.description}</p>
        </div>
        <div class="on-dark card bg-ink p-7 text-white lg:col-span-5">
          <p class="font-mono text-xs font-bold uppercase tracking-[0.14em] text-brand">{t.from}</p>
          <p class="display mt-1 text-6xl text-brand sm:text-7xl">{euro(service.creationPriceNumber)}</p>
          <p class="mt-2 text-lg">+ {monthly(service.monthlyFeeNumber)}</p>
          <p class="mt-4 text-sm text-white/80"><strong class="text-white">{t.deliver}:</strong> {s.timeline}</p>
          <p class="mt-1 text-sm text-white/80"><strong class="text-white">{t.firstYear}:</strong> {s.annualTotal}</p>
          <a href={to("/contact")} class="btn btn-brand mt-6 w-full">{s.ctaText}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-5 sm:py-24">
    <div class="mx-auto grid max-w-(--breakpoint-xl) gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="display text-[clamp(1.8rem,4vw,3rem)]">{t.includes}</h2>
        <ul class="mt-6 space-y-3">
          {s.features.map((f) => (
            <li class="card flex gap-3 p-4 shadow-[3px_3px_0_#0b0b0f]! leading-snug">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand text-sm font-bold ring-2 ring-ink" aria-hidden="true">✓</span>
              <span>{f}</span>
            </li>
          ))}
        </ul>
      </div>
      <aside class="lg:col-span-5">
        <div class="card bg-sand p-7">
          <h2 class="font-display text-2xl font-extrabold">{t.forWho}</h2>
          <p class="mt-3 leading-relaxed">{s.targetAudience}</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-y-2 border-ink bg-sand px-4 py-16 sm:px-5 sm:py-24">
    <div class="mx-auto max-w-(--breakpoint-xl)">
      <h2 class="display text-[clamp(1.8rem,4vw,3rem)]">{t.why}</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="card bg-white p-6">
          <h3 class="font-display text-xl font-extrabold">{t.creation}</h3>
          <ul class="mt-4 space-y-2 text-[0.95rem] leading-relaxed">
            {s.whyThisPrice.creationBreakdown.map((x) => <li class="flex gap-2"><span aria-hidden="true">▸</span><span>{x}</span></li>)}
          </ul>
        </div>
        <div class="card bg-white p-6">
          <h3 class="font-display text-xl font-extrabold">{t.maint}</h3>
          <ul class="mt-4 space-y-2 text-[0.95rem] leading-relaxed">
            {s.whyThisPrice.monthlyBreakdown.map((x) => <li class="flex gap-2"><span aria-hidden="true">▸</span><span>{x}</span></li>)}
          </ul>
        </div>
      </div>
      <div class="card mt-6 bg-brand p-6">
        <h3 class="font-display text-xl font-extrabold">{t.commit}</h3>
        <p class="mt-2 leading-relaxed">{s.whyThisPrice.whyCommitmentOneYear}</p>
      </div>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-5 sm:py-24">
    <div class="mx-auto max-w-(--breakpoint-xl)">
      <h2 class="display text-[clamp(1.8rem,4vw,3rem)]">{t.worth}</h2>
      <p class="mt-4 max-w-2xl text-ink/75">{t.worthNote}</p>
      <p class="mt-4 text-lg font-bold">{s.amortizationSummary}</p>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2">
        {s.amortizationPoints.map((a) => (
          <li class="card p-6">
            <p class="chip chip-brand">{a.metric}</p>
            <h3 class="mt-3 font-display text-xl font-extrabold leading-snug">{a.title}</h3>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-ink/80">{a.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-y-2 border-ink bg-sand px-4 py-16 sm:px-5 sm:py-24">
    <div class="mx-auto max-w-(--breakpoint-xl)">
      <h2 class="display text-[clamp(1.8rem,4vw,3rem)]">{t.compare}</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {s.marketComparison.map((m, i) => (
          <article class:list={["card p-6", i === 0 ? "bg-brand" : "bg-white"]}>
            <h3 class="font-display text-xl font-extrabold leading-snug">{m.name}</h3>
            <p class="mt-2 text-[0.95rem] leading-relaxed">{m.summary}</p>
            <dl class="mt-4 space-y-1.5 border-t-2 border-ink pt-4 text-sm">
              <div><dt class="inline font-bold">{t.price}:</dt> <dd class="inline">{m.priceRange}</dd></div>
              <div><dt class="inline font-bold">{t.maintenance}:</dt> <dd class="inline">{m.maintenanceCost}</dd></div>
              <div><dt class="inline font-bold">{t.hidden}:</dt> <dd class="inline">{m.hiddenCosts}</dd></div>
              <div><dt class="inline font-bold">{t.ownership}:</dt> <dd class="inline">{m.codeOwnership}</dd></div>
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-brand px-4 py-16 text-center sm:px-5 sm:py-24">
    <h2 class="display mx-auto max-w-3xl text-[clamp(2rem,5.5vw,4rem)]">{t.ctaTitle}</h2>
    <p class="mx-auto mt-5 max-w-xl text-lg text-ink/85">{t.ctaText}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a href={to("/contact")} class="btn btn-ink">{s.ctaText} <span aria-hidden="true">→</span></a>
    </div>
    <nav aria-label={t.other} class="mx-auto mt-12 grid max-w-3xl gap-4 text-left sm:grid-cols-2">
      <a href={to(`/pricing/${prev.id}`)} class="card bg-white p-5"><span class="font-mono text-xs font-bold uppercase">← {t.prev}</span><span class="mt-1 block font-display text-lg font-extrabold leading-snug">{p.name}</span></a>
      <a href={to(`/pricing/${next.id}`)} class="card bg-white p-5 sm:text-right"><span class="font-mono text-xs font-bold uppercase">{t.next} →</span><span class="mt-1 block font-display text-lg font-extrabold leading-snug">{n.name}</span></a>
    </nav>
  </section>
</Layout>

---
import UiIcon from "@/components/ui-icon.astro";
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import CtaBand from "@/components/cta-band.astro";
import { getCollection } from "astro:content";
import { servicesData, getLocalizedService, type ServicePackage } from "@/data/services";
import { localeFromPath, localizePath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const to = (path: string) => {
  const [base, query] = path.split("?");
  const p = localizePath(base, isEn ? "en" : "es");
  const normalized = p === "/" || p.endsWith("/") ? p : `${p}/`;
  return query ? `${normalized}?${query}` : normalized;
};

export async function getStaticPaths() {
  return servicesData.map((service, index) => ({
    params: { slug: service.id },
    props: {
      service,
      prev: servicesData[(index - 1 + servicesData.length) % servicesData.length],
      next: servicesData[(index + 1) % servicesData.length],
    },
  }));
}

interface Props {
  service: ServicePackage;
  prev: ServicePackage;
  next: ServicePackage;
}

const { service, prev, next } = Astro.props;
const loc = isEn ? "en" : "es";
const s = getLocalizedService(service, loc);
const p = getLocalizedService(prev, loc);
const n = getLocalizedService(next, loc);
const monthly = (v: number) => (isEn ? `€${v}/month` : `${v} €/mes`);
const euro = (v: number) => (isEn ? `€${v.toLocaleString("en-US")}` : `${v.toLocaleString("es-ES")} €`);
const siteUrl = "https://jaumetur.es";

// Lecturas del blog que apoyan cada servicio (enlazado interno con sentido temático)
const relatedByService: Record<string, string[]> = {
  "digitalitzacio-local": [
    "por-que-el-menu-en-pdf-mata-ventas-restaurante",
    "guia-seo-local-google-maps-comunidad-valenciana",
    "tarjetas-fidelizacion-wallet-negocios-locales",
  ],
  "landing-page": ["por-que-elegir-astro-sobre-wordpress-negocios-locales", "optimizacion-imagenes-web-avif-webp-pipeline", "accesibilidad-web-wcag-aa-guia-practica"],
  "angular-webapp": ["arquitectura-modular-angular-standalone-signals", "guia-definitiva-typescript-estricto-frontend", "avisa-arquitectura-frontend-angular-pwa"],
  "performance-audit": ["optimizacion-core-web-vitals-60fps", "accesibilidad-web-wcag-aa-guia-practica", "optimizacion-imagenes-web-avif-webp-pipeline"],
  "cicd-devops": ["pipeline-cicd-github-actions-despliegue-continuo", "git-github-control-de-versiones-flujo-colaborativo"],
};
const blogPosts = await getCollection("blog", ({ data }) => !data.draft && data.lang === "es");
const readings = (relatedByService[service.id] ?? [])
  .map((id) => blogPosts.find((post) => post.id === id))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));

const t = isEn
  ? {
      home: "Home", services: "Services & pricing", from: "From", deliver: "Delivery", firstYear: "First year",
      forWho: "Ideal for", includes: "What's included", why: "Where the price comes from", creation: "Creation price covers",
      maint: "Monthly fee covers", commit: "Why a one-year commitment", worth: "How it pays off",
      worthNote: "Results depend on each business; these are the ways the investment can pay off.",
      compare: "How it compares with the alternatives", price: "Price", maintenance: "Maintenance", hidden: "Hidden costs", ownership: "Ownership",
      request: "Request this plan", other: "Other plans", prev: "Previous", next: "Next", ctaTitle: "Shall we talk about it?",
      ctaText: "Tell me about your project and I'll confirm scope, price and timeline.",
      title: `${s.name} — pricing & scope`,
      desc: `${s.tagline} From ${euro(service.creationPriceNumber)} + ${monthly(service.monthlyFeeNumber)}. See what's included and how it compares.`,
    }
  : {
      home: "Inicio", services: "Servicios y precios", from: "Desde", deliver: "Entrega", firstYear: "Primer año",
      forWho: "Ideal para", includes: "Qué incluye", why: "De dónde sale el precio", creation: "El precio de creación cubre",
      maint: "La cuota mensual cubre", commit: "Por qué una permanencia de un año", worth: "Cómo se amortiza",
      worthNote: "Los resultados dependen de cada negocio; estas son las vías por las que la inversión puede amortizarse.",
      compare: "Comparativa con las alternativas", price: "Precio", maintenance: "Mantenimiento", hidden: "Costes ocultos", ownership: "Propiedad",
      request: "Solicitar este plan", other: "Otros planes", prev: "Anterior", next: "Siguiente", ctaTitle: "¿Lo hablamos?",
      ctaText: "Cuéntame tu proyecto y te confirmo alcance, precio y plazo.",
      title: `${s.name} — precio y qué incluye`,
      desc: `${s.tagline} Desde ${euro(service.creationPriceNumber)} + ${monthly(service.monthlyFeeNumber)}. Qué incluye y cómo se compara.`,
    };

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": s.name,
  "description": s.description,
  "provider": { "@id": `${siteUrl}/#service` },
  "areaServed": ["Xàtiva", "València", "España"],
  "audience": { "@type": "Audience", "audienceType": s.targetAudience },
  "offers": {
    "@type": "Offer",
    "price": service.creationPriceNumber,
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "url": `${siteUrl}${to(`/pricing/${service.id}`)}`,
    "description": `${s.creationPrice} + ${monthly(service.monthlyFeeNumber)}`,
  },
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": t.home, "item": `${siteUrl}${to("/")}` },
    { "@type": "ListItem", "position": 2, "name": t.services, "item": `${siteUrl}${to("/pricing")}` },
    { "@type": "ListItem", "position": 3, "name": s.name, "item": `${siteUrl}${to(`/pricing/${service.id}`)}` },
  ],
};
---

<Layout fresh title={t.title} description={t.desc} jsonLd={[serviceSchema, breadcrumb]}>
  <header class="relative border-b-[3px] border-ink pb-12 pt-8 sm:pb-16">
    <div class="wrap">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-x-2 text-sm text-graphite">
        <a href={to("/")} class="inline-flex min-h-11 items-center underline decoration-transparent decoration-2 underline-offset-4 hover:text-ink hover:decoration-ink">{t.home}</a><span aria-hidden="true">/</span>
        <a href={to("/pricing")} class="inline-flex min-h-11 items-center underline decoration-transparent decoration-2 underline-offset-4 hover:text-ink hover:decoration-ink">{t.services}</a><span aria-hidden="true">/</span>
        <span aria-current="page" class="text-ink">{s.name}</span>
      </nav>
      <div class="mt-6 grid items-start gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-7">
          <p class="chip"><Icon name={s.icon} class="h-4 w-4 text-ink" />{s.badge}</p>
          <h1 class="h-page mt-5">{s.name}</h1>
          <p class="lede mt-6">{s.description}</p>
        </div>
        <div class="sheet px-6 pb-12 pt-7 lg:col-span-5">
          <p class="label">{t.from}</p>
          <p class="num font-display text-[4rem] font-extrabold tracking-[-0.035em] leading-none">{euro(service.creationPriceNumber)}</p>
          <dl class="mt-5 grid gap-2.5 border-t-2 border-dotted border-[var(--ink)]/50 pt-5 text-[0.95rem]">
            <div class="leader-row"><dt>{isEn ? "Maintenance" : "Mantenimiento"}</dt><span class="leader" aria-hidden="true"></span><dd class="num font-bold">{monthly(service.monthlyFeeNumber)}</dd></div>
            <div class="leader-row"><dt>{t.deliver}</dt><span class="leader" aria-hidden="true"></span><dd class="num text-right font-bold">{s.timeline}</dd></div>
            <div class="leader-row"><dt>{t.firstYear}</dt><span class="leader" aria-hidden="true"></span><dd class="num font-bold">{euro(service.creationPriceNumber + 12 * service.monthlyFeeNumber)}</dd></div>
          </dl>
          <a href={to(`/contact?servei=${service.id}`)} class="btn btn-brand mt-6 w-full">{s.ctaText} <UiIcon name="arrow" aria-hidden="true" /></a>
        </div>
      </div>
    </div>
  </header>

  <section class="section" aria-labelledby="inc-title">
    <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-7">
        <h2 id="inc-title" class="h-section">{t.includes}</h2>
        <ul class="mt-8 border-b-2 border-ink">
          {s.features.map((f) => (
            <li class="flex gap-4 border-t-2 border-ink py-4 leading-snug">
              <svg class="mt-[0.2em] h-5 w-5 shrink-0 text-ink" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true"><path d="M2.5 8.5l3.5 3.5 7.5-8"></path></svg>
              <span>{f}</span>
            </li>
          ))}
        </ul>
      </div>
      <aside class="lg:col-span-5">
        <div class="border-t-2 border-ink pt-5">
          <h2 class="font-display text-[1.8rem] font-extrabold tracking-[-0.035em] leading-none">{t.forWho}</h2>
          <p class="muted mt-4 leading-relaxed">{s.targetAudience}</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section border-t-2 border-ink" aria-labelledby="why-title">
    <div class="wrap">
      <h2 id="why-title" class="h-section max-w-3xl">{t.why}</h2>
      <div class="mt-10 grid gap-x-12 gap-y-10 md:grid-cols-2">
        <div class="border-t-2 border-ink pt-5">
          <h3 class="font-display text-[1.5rem] font-extrabold tracking-[-0.035em] leading-tight">{t.creation}</h3>
          <ul class="muted mt-4 grid gap-2.5 leading-snug">
            {s.whyThisPrice.creationBreakdown.map((x) => <li class="flex gap-3"><span class="text-ink" aria-hidden="true">–</span><span>{x}</span></li>)}
          </ul>
        </div>
        <div class="border-t-2 border-ink pt-5">
          <h3 class="font-display text-[1.5rem] font-extrabold tracking-[-0.035em] leading-tight">{t.maint}</h3>
          <ul class="muted mt-4 grid gap-2.5 leading-snug">
            {s.whyThisPrice.monthlyBreakdown.map((x) => <li class="flex gap-3"><span class="text-ink" aria-hidden="true">–</span><span>{x}</span></li>)}
          </ul>
        </div>
      </div>
      <div class="mt-12 max-w-3xl">
        <h3 class="font-display text-[1.5rem] font-extrabold tracking-[-0.035em] leading-tight">{t.commit}</h3>
        <p class="muted mt-3 leading-relaxed">{s.whyThisPrice.whyCommitmentOneYear}</p>
      </div>
    </div>
  </section>

  <section class="section border-t-2 border-ink" aria-labelledby="worth-title">
    <div class="wrap">
      <h2 id="worth-title" class="h-section max-w-3xl">{t.worth}</h2>
      <p class="lede mt-4">{t.worthNote}</p>
      <ul class="mt-10 grid gap-x-12 gap-y-9 sm:grid-cols-2">
        {s.amortizationPoints.map((a) => (
          <li class="border-t-2 border-ink pt-5">
            <h3 class="font-display text-[1.45rem] font-extrabold tracking-[-0.035em] leading-tight">{a.title}</h3>
            <p class="muted mt-2 leading-relaxed">{a.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section border-t-2 border-ink" aria-labelledby="cmp-title">
    <div class="wrap">
      <h2 id="cmp-title" class="h-section max-w-3xl">{t.compare}</h2>
      <div class="mt-10 grid gap-x-10 gap-y-12 md:grid-cols-2">
        {s.marketComparison.map((m, i) => (
          <article class:list={["border-t-2 pt-5", i === 0 ? "border-ink" : "border-rule"]}>
            <h3 class="font-display text-[1.45rem] font-extrabold tracking-[-0.035em] leading-tight">{m.name}</h3>
            <p class="muted mt-2 leading-relaxed">{m.summary}</p>
            <dl class="mt-4 grid gap-1.5 text-[0.92rem]">
              <div><dt class="faint inline">{t.price}:</dt> <dd class="inline font-semibold">{m.priceRange}</dd></div>
              <div><dt class="faint inline">{t.maintenance}:</dt> <dd class="inline font-semibold">{m.maintenanceCost}</dd></div>
              <div><dt class="faint inline">{t.hidden}:</dt> <dd class="inline font-semibold">{m.hiddenCosts}</dd></div>
              <div><dt class="faint inline">{t.ownership}:</dt> <dd class="inline font-semibold">{m.codeOwnership}</dd></div>
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  {readings.length > 0 && (
    <section class="section border-t-2 border-ink" aria-labelledby="read-title">
      <div class="wrap">
        <h2 id="read-title" class="h-section max-w-3xl">{isEn ? "Related reading (in Spanish)" : "Para leer antes de decidir"}</h2>
        <ul class="mt-8 border-b-2 border-ink">
          {readings.map((post) => (
            <li class="contents">
              <a href={`/blog/${post.id}/`} class="item">
                <span class="font-display text-[1.4rem] font-extrabold tracking-[-0.035em] leading-tight sm:text-[1.7rem]">{post.data.title}</span>
                <span class="muted max-w-3xl">{post.data.snippet}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <CtaBand title={t.ctaTitle} text={t.ctaText} primary={{ href: to(`/contact?servei=${service.id}`), label: s.ctaText }} secondary={{ href: to("/pricing"), label: t.services }} />

  <nav aria-label={t.other} class="wrap grid gap-6 border-t-2 border-ink py-10 sm:grid-cols-2">
    <a href={to(`/pricing/${prev.id}`)} class="group block min-h-11"><span class="label">← {t.prev}</span><span class="mt-1 block font-display text-[1.4rem] font-extrabold tracking-[-0.035em] leading-tight group-hover:bg-brand">{p.name}</span></a>
    <a href={to(`/pricing/${next.id}`)} class="group block min-h-11 sm:text-right"><span class="label">{t.next} →</span><span class="mt-1 block font-display text-[1.4rem] font-extrabold tracking-[-0.035em] leading-tight group-hover:bg-brand">{n.name}</span></a>
  </nav>
</Layout>

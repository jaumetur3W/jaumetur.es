---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { Icon } from "astro-icon/components";
import { localeFromPath, localizePath } from "@/i18n";

// Generate paths for all blog posts
export async function getStaticPaths() {
  const blogEntries = await getCollection("blog", ({ data }) => data.lang === "es");
  return blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const isEn = localeFromPath(Astro.url.pathname) === "en";
const href = (path: string) => localizePath(path, isEn ? "en" : "es");
const { Content, headings } = await render(entry);

// Estimate reading time (average 200 words/min)
const wordsCount = entry.body ? entry.body.trim().split(/\s+/).length : 600;
const readingMinutes = Math.max(1, Math.round(wordsCount / 200));

// Find related posts (same category or common tags, excluding current)
const allPosts = await getCollection("blog", ({ data }) => !data.draft && data.lang === "es");
const relatedPosts = allPosts
  .filter((post) => post.id !== entry.id && (post.data.category === entry.data.category || post.data.tags.some(t => entry.data.tags.includes(t))))
  .slice(0, 2);

// Category icon helper
const getCategoryIcon = (category: string) => {
  const cat = category.toLowerCase();
  if (cat.includes("angular")) return "simple-icons:angular";
  if (cat.includes("rendiment") || cat.includes("performance") || cat.includes("rendimiento")) return "bx:bxs-zap";
  if (cat.includes("ci/cd") || cat.includes("devops")) return "bx:git-repo-forked";
  if (cat.includes("accessibilitat") || cat.includes("accesibilidad") || cat.includes("wcag")) return "bx:accessibility";
  if (cat.includes("typescript")) return "simple-icons:typescript";
  if (cat.includes("carrera") || cat.includes("portfolio")) return "bx:briefcase";
  if (cat.includes("cas d'estudi") || cat.includes("caso") || cat.includes("case study")) return "bx:search-alt";
  return "bx:file-blank";
};

const categoryIcon = getCategoryIcon(entry.data.category);
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://jaumetur.es";
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": isEn ? "Home" : "Inicio",
      "item": new URL(href("/"), siteUrl).toString(),
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": new URL(href("/blog"), siteUrl).toString(),
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": entry.data.category,
      "item": new URL(`${href("/blog")}#${entry.data.category}`, siteUrl).toString(),
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": entry.data.title,
      "item": new URL(Astro.url.pathname, siteUrl).toString(),
    },
  ],
};
---

<Layout
  fresh
  title={entry.data.title}
  description={entry.data.snippet}
  image={entry.data.image.src}
  lang={isEn ? "en" : "es"}
  canonicalURL={entry.data.canonicalUrl}
  jsonLd={[breadcrumbSchema]}
>

  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="bg-[#FFFF00]" aria-hidden="true"></div>

  <div class="px-5 py-8 sm:py-12">
    <Container>
      <!-- Breadcrumbs -->
      <nav aria-label={isEn ? "Navigation path" : "Ruta de navegación"} class="pt-4 pb-4 text-xs font-mono text-zinc-400 flex items-center gap-2 flex-wrap">
        <a href={href("/")} class="hover:text-brand transition-colors">{isEn ? "Home" : "Inicio"}</a>
        <span>/</span>
        <a href={href("/blog")} class="hover:text-brand transition-colors">Blog</a>
        <span>/</span>
        <span class="text-white font-semibold">{entry.data.category}</span>
      </nav>

      <!-- Article Header -->
      <header class="max-w-4xl mx-auto mt-4 mb-8">
        <div class="flex items-center gap-2 mb-4">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold bg-[#FFFF00] text-black border border-brand">
            <Icon name={categoryIcon} class="w-3.5 h-3.5" />
            <span>{entry.data.category}</span>
          </span>
        </div>

        <h1 class="display text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight mb-5">
          {entry.data.title}
        </h1>

        <p class="text-lg sm:text-xl text-zinc-300 font-light leading-relaxed mb-6">
          {entry.data.snippet}
        </p>

        <!-- Metadata Bar -->
        <div class="flex flex-wrap items-center gap-4 py-4 border-y border-white/10 text-sm text-zinc-400">
          <div class="flex items-center gap-2">
            <img
              src="/img/2.webp"
              alt="Jaume Tur"
              class="w-8 h-8 rounded-full border border-white/20 bg-white/5 object-cover"
              width="32"
              height="32"
              loading="lazy"
              decoding="async"
            />
            <span class="font-semibold text-white">{entry.data.author}</span>
          </div>
          <span class="text-zinc-600" aria-hidden="true">•</span>
          <time datetime={entry.data.publishDate.toISOString()} class="font-mono text-xs text-zinc-400">
            {entry.data.publishDate.toLocaleDateString(isEn ? 'en-US' : 'es-ES', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>
          <span class="text-zinc-600" aria-hidden="true">•</span>
          <span class="inline-flex items-center gap-1.5 font-mono text-xs text-zinc-300 bg-white/5 border border-white/10 px-2 py-0.5 rounded-full">
            <Icon name="bx:time" class="w-3.5 h-3.5 text-brand" />
            <span>{isEn ? `${readingMinutes} min estimated read` : `${readingMinutes} min de lectura estimada`}</span>
          </span>
        </div>
      </header>

      <!-- Main Content & Sticky TOC Layout -->
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <!-- Article Content -->
        <article class="lg:col-span-8 min-w-0">
          <!-- Technical Article Overview -->
          <div class="mb-10 p-6 sm:p-8 rounded-sm surface-card bg-[#121216] border border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 rounded-sm bg-[#FFFF00] text-black border border-brand flex items-center justify-center shrink-0 shadow-xs">
                <Icon name={categoryIcon} class="w-7 h-7 text-black" />
              </div>
              <div>
                <p class="text-xs font-mono uppercase tracking-wider text-zinc-400 font-semibold">{isEn ? "Engineering Guide" : "Guía de ingeniería"}</p>
                <p class="text-sm sm:text-base font-bold text-white mt-0.5">{entry.data.category}</p>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              {entry.data.tags.map((tag) => (
                <span class="inline-flex items-center px-2.5 py-1 rounded-sm text-xs font-mono bg-white/5 border border-white/10 text-zinc-300">
                  #{tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Mobile Table of Contents -->
          {filteredHeadings.length > 0 && (
            <details class="lg:hidden mb-8 p-4 rounded-sm surface-card bg-[#121216] border border-white/10">
              <summary class="font-mono text-sm font-semibold text-white cursor-pointer flex items-center justify-between">
                <span class="flex items-center gap-2">
                  <Icon name="bx:book-content" class="w-4 h-4 text-brand" />
                  <span>{isEn ? "Table of contents" : "Tabla de contenidos"}</span>
                </span>
                <span class="text-xs text-brand font-bold">{isEn ? "Show / hide" : "Mostrar / ocultar"}</span>
              </summary>
              <nav class="mt-3 space-y-1.5 text-sm">
                {filteredHeadings.map((h) => (
                  <a
                    href={`#${h.slug}`}
                    class={`block py-1 text-zinc-400 hover:text-brand transition-colors ${
                      h.depth === 3 ? "pl-4 text-xs text-zinc-500" : "font-medium"
                    }`}
                  >
                    {h.text}
                  </a>
                ))}
              </nav>
            </details>
          )}

          <div class="prose prose-invert max-w-none prose-headings:scroll-mt-24 prose-headings:font-display prose-headings:font-bold prose-headings:text-white prose-p:text-zinc-300 prose-p:leading-relaxed prose-a:text-brand prose-a:underline hover:prose-a:text-white prose-code:text-brand prose-code:font-mono prose-pre:bg-[#050507] prose-pre:border prose-pre:border-white/10 prose-strong:text-white prose-li:text-zinc-300">
            <Content />
          </div>

          <!-- Tags -->
          <div class="mt-10 pt-6 border-t border-white/10 flex flex-wrap gap-2 items-center">
            <span class="text-xs font-mono text-zinc-400">{isEn ? "Tags:" : "Etiquetas:"}</span>
            {entry.data.tags.map((tag) => (
              <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-zinc-300">
                #{tag}
              </span>
            ))}
          </div>

          <!-- Share & Interaction Bar -->
          <div class="mt-8 p-5 rounded-sm surface-card bg-[#121216] border border-white/10 flex flex-wrap items-center justify-between gap-4">
            <span class="text-sm font-semibold text-white">{isEn ? "Found this article useful?" : "¿Te ha resultado útil este artículo?"}</span>
            <div class="flex items-center gap-2">
              <button
                id="copy-link-btn"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-sm text-xs font-mono bg-white/5 hover:bg-white/10 text-white transition-colors border border-white/10 cursor-pointer"
              >
                <Icon name="bx:link" class="w-3.5 h-3.5 text-brand" />
                <span id="copy-link-text">{isEn ? "Copy link" : "Copiar enlace"}</span>
              </button>
              <a
                href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent(`https://jaumetur.es${href(`/blog/${entry.id}/`)}`)}&via=jautur`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-sm text-xs font-mono bg-white/5 hover:bg-white/10 text-white border border-white/10 transition-colors"
              >
                <Icon name="simple-icons:x" class="w-3 h-3 text-white" />
                <span>{isEn ? "Share" : "Compartir"}</span>
              </a>
              <a
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://jaumetur.es${href(`/blog/${entry.id}/`)}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-sm text-xs font-mono bg-[#0077b5]/20 hover:bg-[#0077b5]/40 text-blue-300 border border-[#0077b5]/40 transition-colors"
              >
                <Icon name="bx:bxl-linkedin" class="w-3.5 h-3.5 text-blue-300" />
                <span>LinkedIn</span>
              </a>
            </div>
          </div>

          <!-- Author Bio Card -->
          <div class="mt-10 p-6 rounded-sm surface-card bg-[#121216] border border-white/10 flex flex-col sm:flex-row gap-5 items-center sm:items-start text-center sm:text-left">
            <img
              src="/img/4.webp"
              alt="Jaume Tur"
              class="w-20 h-20 rounded-sm border border-white/10 bg-white/5 p-1 object-contain shrink-0"
              width="80"
              height="80"
              loading="lazy"
              decoding="async"
            />
            <div>
              <h3 class="text-lg font-display text-white flex items-center justify-center sm:justify-start gap-2">
                <span class="font-bold">Jaume Tur</span>
                <span class="text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-[#FFFF00] text-black border border-brand">
                  Frontend & Web Apps
                </span>
              </h3>
              <p class="text-sm text-zinc-300 font-light mt-2 leading-relaxed">
                {isEn
                  ? "Web developer based in Valencia specialized in Angular, TypeScript, 60 FPS performance, WCAG AA accessibility, and CI/CD pipeline automation. Sharing battle-tested production lessons."
                  : "Desarrollador web en Valencia especializado en Angular, TypeScript, rendimiento a 60 FPS, accesibilidad WCAG AA y automatización de pipelines CI/CD. Comparte aprendizajes prácticos del trabajo diario en producción."}
              </p>
              <div class="mt-3 flex items-center justify-center sm:justify-start gap-4 text-xs font-mono text-zinc-400">
                <a href="https://github.com/jaumetur3W" target="_blank" rel="noopener noreferrer" class="hover:text-brand transition-colors flex items-center gap-1">
                  <Icon name="bx:bxl-github" class="w-3.5 h-3.5" />
                  <span>GitHub</span>
                </a>
                <a href="https://x.com/jautur" target="_blank" rel="noopener noreferrer" class="hover:text-brand transition-colors flex items-center gap-1">
                  <Icon name="simple-icons:x" class="w-3 h-3" />
                  <span>@jautur</span>
                </a>
                <a href="https://linkedin.com/in/jautur" target="_blank" rel="noopener noreferrer" class="hover:text-brand transition-colors flex items-center gap-1">
                  <Icon name="bx:bxl-linkedin" class="w-3.5 h-3.5" />
                  <span>LinkedIn</span>
                </a>
                <a href={href("/contact")} class="hover:text-brand transition-colors flex items-center gap-1">
                  <Icon name="bx:envelope" class="w-3.5 h-3.5" />
                  <span>{isEn ? "Contact" : "Contacto"}</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Contextual B2B Consulting CTA -->
          <div class="mt-8 p-6 sm:p-8 rounded-sm surface-card bg-[#121216] border border-white/10 text-center">
            <h4 class="text-xl font-display font-bold text-white mb-2">
              {isEn ? "Facing a similar challenge at your business?" : "¿Tienes un reto similar en tu empresa o negocio?"}
            </h4>
            <p class="text-xs sm:text-sm text-zinc-300 font-light mb-5 max-w-lg mx-auto leading-relaxed">
              {isEn ? "I develop custom web apps, fast websites, and help teams optimize performance and CI/CD automation in Valencia or remotely." : "Desarrollo aplicaciones web a medida, diseño páginas web rápidas y ayudo a negocios a optimizar rendimiento y automatización en Xàtiva, Valencia o en remoto."}
            </p>
            <div class="flex flex-wrap items-center justify-center gap-3">
              <a
                href={href("/pricing")}
                class="btn btn-white btn-sm px-5"
              >
                <Icon name="bx:purchase-tag" class="w-4 h-4" />
                <span>{isEn ? "Check services & pricing" : "Consultar servicios y precios"}</span>
              </a>
              <a
                href={href("/contact")}
                class="btn btn-brand btn-sm px-5 font-bold"
              >
                <Icon name="bx:message-square-dots" class="w-4 h-4" />
                <span>{isEn ? "Talk about your project" : "Hablar de tu proyecto"}</span>
              </a>
            </div>
          </div>

          <!-- Related Posts -->
          {relatedPosts.length > 0 && (
            <div class="mt-14">
              <h3 class="text-xl font-display font-bold text-white mb-6 flex items-center gap-2">
                <Icon name="bx:layer" class="w-4 h-4 text-brand" />
                <span>{isEn ? "Related articles" : "Artículos relacionados"}</span>
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                {relatedPosts.map((rel) => (
                  <a
                    href={href(`/blog/${rel.id}/`)}
                    class="group block p-5 rounded-sm surface-card bg-[#121216] border border-white/10 hover:border-brand/40 transition-all"
                  >
                    <span class="text-xs font-mono text-brand font-bold uppercase tracking-wider">
                      {rel.data.category}
                    </span>
                    <h4 class="text-base font-display font-bold text-white group-hover:text-brand transition-colors mt-1 leading-snug">
                      {rel.data.title}
                    </h4>
                    <p class="text-xs text-zinc-400 font-light mt-2 line-clamp-2">
                      {rel.data.snippet}
                    </p>
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="text-center mt-12 mb-16">
            <a
              href={href("/blog")}
              class="btn btn-white btn-sm px-6"
            >
              <span>{isEn ? "← Back to all articles" : "← Volver a todos los artículos"}</span>
            </a>
          </div>
        </article>

        <!-- Sticky Table of Contents (Desktop Sidebar) -->
        <aside class="hidden lg:block lg:col-span-4 sticky top-24 space-y-6">
          {filteredHeadings.length > 0 && (
            <div class="p-5 rounded-sm surface-card bg-[#121216] border border-white/10">
              <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-brand mb-3 flex items-center gap-2">
                <Icon name="bx:book-content" class="w-4 h-4 text-brand" />
                <span>{isEn ? "Table of contents" : "Tabla de contenidos"}</span>
              </h4>
              <nav class="space-y-1.5 text-xs">
                {filteredHeadings.map((h) => (
                  <a
                    href={`#${h.slug}`}
                    class={`block py-1 text-zinc-400 hover:text-white transition-colors ${
                      h.depth === 3 ? "pl-3 text-zinc-500" : "font-medium"
                    }`}
                  >
                    {h.text}
                  </a>
                ))}
              </nav>
            </div>
          )}

          <!-- Quick Contact Pill in Sidebar -->
          <div class="p-5 rounded-sm surface-card bg-[#121216] border border-white/10 text-center">
            <p class="text-xs font-mono text-zinc-400 uppercase tracking-wider">{isEn ? "Need a custom development?" : "¿Necesitas un desarrollo a medida?"}</p>
            <p class="text-sm font-display font-bold text-white mt-1 mb-3">{isEn ? "Let's build it together" : "Creemos tu proyecto"}</p>
            <a href={href("/contact")} class="btn btn-brand btn-sm w-full font-bold">
              {isEn ? "Start project" : "Iniciar proyecto"}
            </a>
          </div>
        </aside>
      </div>
    </Container>
  </div>

  <script is:inline>
    // Reading Progress Indicator
    window.addEventListener("scroll", function () {
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
      const bar = document.getElementById("reading-progress");
      if (bar) {
        bar.style.width = scrolled + "%";
      }
    });

    // Copy Link Button
    const copyLinkBtn = document.getElementById("copy-link-btn");
    const copyLinkText = document.getElementById("copy-link-text");
    if (copyLinkBtn) {
      copyLinkBtn.addEventListener("click", function () {
        navigator.clipboard.writeText(window.location.href).then(function () {
          const original = copyLinkText ? copyLinkText.textContent : "Copiar";
          if (copyLinkText) copyLinkText.textContent = "✓ ¡Copiado!";
          setTimeout(function () {
            if (copyLinkText) copyLinkText.textContent = original;
          }, 2000);
        });
      });
    }
  </script>
</Layout>

---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { Icon } from "astro-icon/components";
import { localeFromPath, localizePath } from "@/i18n";

// Generate paths for all blog posts
export async function getStaticPaths() {
  const blogEntries = await getCollection("blog", ({ data }) => data.lang === "es");
  return blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const isEn = localeFromPath(Astro.url.pathname) === "en";
const href = (path: string) => localizePath(path, isEn ? "en" : "es");
const { Content, headings } = await render(entry);

// Estimate reading time (average 200 words/min)
const wordsCount = entry.body ? entry.body.trim().split(/\s+/).length : 600;
const readingMinutes = Math.max(1, Math.round(wordsCount / 200));

// Find related posts (same category or common tags, excluding current)
const allPosts = await getCollection("blog", ({ data }) => !data.draft && data.lang === "es");
const relatedPosts = allPosts
  .filter((post) => post.id !== entry.id && (post.data.category === entry.data.category || post.data.tags.some(t => entry.data.tags.includes(t))))
  .slice(0, 2);

// Category icon helper (Standardized icons)
const getCategoryIcon = (category: string) => {
  const cat = category.toLowerCase();
  if (cat.includes("angular")) return "simple-icons:angular";
  if (cat.includes("rendiment") || cat.includes("performance") || cat.includes("rendimiento")) return "bx:bxs-zap";
  if (cat.includes("ci/cd") || cat.includes("devops")) return "bx:git-repo-forked";
  if (cat.includes("accessibilitat") || cat.includes("accesibilidad") || cat.includes("wcag")) return "bx:accessibility";
  if (cat.includes("typescript")) return "simple-icons:typescript";
  if (cat.includes("carrera") || cat.includes("portfolio")) return "bx:briefcase";
  if (cat.includes("cas d'estudi") || cat.includes("caso") || cat.includes("case study")) return "bx:search-alt";
  return "bx:file-blank";
};

const categoryIcon = getCategoryIcon(entry.data.category);
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://jaumetur.es";
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": isEn ? "Home" : "Inicio",
      "item": new URL(href("/"), siteUrl).toString(),
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": new URL(href("/blog"), siteUrl).toString(),
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": entry.data.category,
      "item": new URL(`${href("/blog")}#${entry.data.category}`, siteUrl).toString(),
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": entry.data.title,
      "item": new URL(Astro.url.pathname, siteUrl).toString(),
    },
  ],
};
---

<Layout
  title={entry.data.title}
  description={entry.data.snippet}
  image={entry.data.image.src}
  publishDate={entry.data.publishDate}
  author={entry.data.author}
  tags={entry.data.tags}
  isBlogPost={true}
  lang={isEn ? "en" : "es"}
  canonicalURL={entry.data.canonicalUrl}
>
  <!-- BreadcrumbList Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="bg-[#FFFF00]" aria-hidden="true"></div>

  <Container>
    <!-- Breadcrumbs -->
    <nav aria-label={isEn ? "Navigation path" : "Ruta de navegación"} class="pt-8 pb-4 text-xs font-mono text-slate-500 flex items-center gap-2 flex-wrap">
      <a href={href("/")} class="hover:text-slate-950 transition-colors">{isEn ? "Home" : "Inicio"}</a>
      <span>/</span>
      <a href={href("/blog")} class="hover:text-slate-950 transition-colors">Blog</a>
      <span>/</span>
      <span class="text-slate-950 font-semibold">{entry.data.category}</span>
    </nav>

    <!-- Article Header -->
    <header class="max-w-4xl mx-auto mt-4 mb-8">
      <div class="flex items-center gap-2 mb-4">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-[#FFFF00] border border-slate-950/20 text-slate-950">
          <Icon name={categoryIcon} class="w-3.5 h-3.5" />
          <span>{entry.data.category}</span>
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-light text-slate-950 tracking-tight leading-tight mb-5">
        {entry.data.title}
      </h1>

      <p class="text-lg sm:text-xl text-slate-600 font-light leading-relaxed mb-6">
        {entry.data.snippet}
      </p>

      <!-- Metadata Bar -->
      <div class="flex flex-wrap items-center gap-4 py-4 border-y border-slate-200/90 text-sm text-slate-600">
        <div class="flex items-center gap-2">
          <img
            src="/img/2.webp"
            alt="Jaume Tur"
            class="w-8 h-8 rounded-full border border-slate-200 bg-white object-cover"
            width="32"
            height="32"
            loading="lazy"
            decoding="async"
          />
          <span class="font-semibold text-slate-900">{entry.data.author}</span>
        </div>
        <span class="text-slate-300">•</span>
        <time datetime={entry.data.publishDate.toISOString()} class="font-mono text-xs text-slate-500">
          {entry.data.publishDate.toLocaleDateString(isEn ? 'en-US' : 'es-ES', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
        <span class="text-slate-300">•</span>
        <span class="inline-flex items-center gap-1.5 font-mono text-xs text-slate-700 bg-slate-100 border border-slate-200 px-2 py-0.5 rounded-full">
          <Icon name="bx:time" class="w-3.5 h-3.5 text-slate-500" />
          <span>{isEn ? `${readingMinutes} min estimated read` : `${readingMinutes} min de lectura estimada`}</span>
        </span>
      </div>
    </header>

    <!-- Main Content & Sticky TOC Layout -->
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Article Content -->
      <article class="lg:col-span-8 min-w-0">
        {entry.data.image && entry.data.image.src && (
          <div class="mb-10 rounded-3xl overflow-hidden border border-slate-200/90 shadow-2xs bg-slate-100">
            <img
              src={entry.data.image.src}
              alt={entry.data.image.alt}
              class="w-full h-auto max-h-[440px] object-cover object-center aspect-[1200/630]"
              loading="eager"
              fetchpriority="high"
              width="1200"
              height="630"
            />
          </div>
        )}

        <!-- Mobile Table of Contents -->
        {filteredHeadings.length > 0 && (
          <details class="lg:hidden mb-8 p-4 rounded-2xl bg-white border border-slate-200/90 shadow-2xs">
            <summary class="font-mono text-sm font-semibold text-slate-800 cursor-pointer flex items-center justify-between">
              <span class="flex items-center gap-2">
                <Icon name="bx:book-content" class="w-4 h-4 text-slate-950" />
                <span>{isEn ? "Table of contents" : "Tabla de contenidos"}</span>
              </span>
              <span class="text-xs text-slate-950 font-bold">{isEn ? "Show / hide" : "Mostrar / ocultar"}</span>
            </summary>
            <nav class="mt-3 space-y-1.5 text-sm">
              {filteredHeadings.map((h) => (
                <a
                  href={`#${h.slug}`}
                  class={`block py-1 text-slate-600 hover:text-slate-950 transition-colors ${
                    h.depth === 3 ? "pl-4 text-xs text-slate-500" : "font-medium"
                  }`}
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </details>
        )}

        <div class="prose prose-slate max-w-none prose-headings:scroll-mt-24 prose-headings:font-light prose-headings:tracking-tight prose-headings:text-slate-950 prose-a:text-slate-950 prose-a:underline hover:prose-a:bg-[#FFFF00]/50 prose-code:text-slate-900 prose-code:font-mono prose-pre:bg-slate-950 prose-pre:border prose-pre:border-slate-800">
          <Content />
        </div>

        <!-- Tags -->
        <div class="mt-10 pt-6 border-t border-slate-200/90 flex flex-wrap gap-2 items-center">
          <span class="text-xs font-mono text-slate-500">{isEn ? "Tags:" : "Etiquetas:"}</span>
          {entry.data.tags.map((tag) => (
            <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-slate-100 border border-slate-200 text-slate-700 hover:border-slate-950 transition-colors">
              #{tag}
            </span>
          ))}
        </div>

        <!-- Share & Interaction Bar -->
        <div class="mt-8 p-5 rounded-3xl bg-white border border-slate-200/90 shadow-2xs flex flex-wrap items-center justify-between gap-4">
          <span class="text-sm font-semibold text-slate-900">{isEn ? "Found this article useful?" : "¿Te ha resultado útil este artículo?"}</span>
          <div class="flex items-center gap-2">
            <button
              id="copy-link-btn"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-mono bg-slate-100 hover:bg-slate-200 text-slate-800 transition-colors border border-slate-200 cursor-pointer"
            >
              <Icon name="bx:link" class="w-3.5 h-3.5 text-slate-600" />
              <span id="copy-link-text">{isEn ? "Copy link" : "Copiar enlace"}</span>
            </button>
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent(`https://jaumetur.es${href(`/blog/${entry.id}`)}`)}&via=jautur`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-mono bg-slate-900 hover:bg-slate-800 text-white transition-colors"
            >
              <Icon name="simple-icons:x" class="w-3 h-3 text-white" />
              <span>{isEn ? "Share" : "Compartir"}</span>
            </a>
            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://jaumetur.es${href(`/blog/${entry.id}`)}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-mono bg-[#0077b5] hover:bg-[#006097] text-white transition-colors"
            >
              <Icon name="bx:bxl-linkedin" class="w-3.5 h-3.5 text-white" />
              <span>LinkedIn</span>
            </a>
          </div>
        </div>

        <!-- Author Bio Card -->
        <div class="mt-10 p-6 rounded-3xl bg-white border border-slate-200/90 shadow-2xs flex flex-col sm:flex-row gap-5 items-center sm:items-start text-center sm:text-left">
          <img
            src="/img/4.webp"
            alt="Jaume Tur"
            class="w-20 h-20 rounded-2xl border border-slate-200 bg-slate-50 p-1 object-contain shrink-0"
            width="80"
            height="80"
            loading="lazy"
            decoding="async"
          />
          <div>
            <h3 class="text-lg font-light text-slate-950 flex items-center justify-center sm:justify-start gap-2">
              <span class="font-semibold">Jaume Tur</span>
              <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded-full bg-[#FFFF00] border border-slate-950/20 text-slate-950">
                Frontend & Web Apps
              </span>
            </h3>
            <p class="text-sm text-slate-600 font-light mt-2 leading-relaxed">
              {isEn
                ? "Web developer based in Valencia specialized in Angular, TypeScript, 60 FPS performance, WCAG AA accessibility, and CI/CD pipeline automation. Sharing battle-tested production lessons."
                : "Desarrollador web en Valencia especializado en Angular, TypeScript, rendimiento a 60 FPS, accesibilidad WCAG AA y automatización de pipelines CI/CD. Comparte aprendizajes prácticos del trabajo diario en producción."}
            </p>
            <div class="mt-3 flex items-center justify-center sm:justify-start gap-4 text-xs font-mono text-slate-500">
              <a href="https://github.com/jaumetur3W" target="_blank" rel="noopener noreferrer" class="hover:text-slate-950 transition-colors flex items-center gap-1">
                <Icon name="bx:bxl-github" class="w-3.5 h-3.5" />
                <span>GitHub</span>
              </a>
              <a href="https://x.com/jautur" target="_blank" rel="noopener noreferrer" class="hover:text-slate-950 transition-colors flex items-center gap-1">
                <Icon name="simple-icons:x" class="w-3 h-3" />
                <span>@jautur</span>
              </a>
              <a href="https://linkedin.com/in/jautur" target="_blank" rel="noopener noreferrer" class="hover:text-slate-950 transition-colors flex items-center gap-1">
                <Icon name="bx:bxl-linkedin" class="w-3.5 h-3.5" />
                <span>LinkedIn</span>
              </a>
              <a href={href("/contact")} class="hover:text-slate-950 transition-colors flex items-center gap-1">
                <Icon name="bx:envelope" class="w-3.5 h-3.5" />
                <span>{isEn ? "Contact" : "Contacto"}</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Lead Magnet: Checklist de Rendiment & Accessibilitat -->
        <div class="mt-10 p-6 sm:p-8 rounded-3xl bg-slate-950 text-white border border-slate-900 shadow-xl relative overflow-hidden">
          <div class="relative z-10">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-[#FFFF00] border border-slate-950/20 text-slate-950 mb-3 shadow-2xs">
              <Icon name="bx:gift" class="w-3.5 h-3.5" />
              <span>{isEn ? "Free Resource for Developers" : "Recurso Gratuito para Desarrolladores"}</span>
            </span>
            <h3 class="text-xl sm:text-2xl font-light text-white mb-2 tracking-tight">
              {isEn ? "Performance (60 FPS) & Accessibility (WCAG AA) Checklist" : "Checklist de Rendimiento (60 FPS) y Accesibilidad (WCAG AA)"}
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 font-light mb-5 leading-relaxed max-w-xl">
              {isEn ? "The 25 audit checkpoints applied before deploying any Angular/TypeScript web application or SPA." : "Los 25 puntos de auditoría que aplico en producción antes de desplegar cualquier aplicación web o SPA en Angular/TypeScript."}
            </p>
            <form
              action={href("/contact")}
              method="GET"
              class="flex flex-col sm:flex-row gap-3 max-w-md"
            >
              <input
                type="email"
                name="email"
                placeholder={isEn ? "your.email@company.com" : "tu.correo@empresa.com"}
                required
                class="px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-xs sm:text-sm text-white placeholder-slate-400 focus:outline-none focus:border-slate-500 flex-1 font-mono"
              />
              <button
                type="submit"
                class="px-5 py-2.5 rounded-xl bg-[#FFFF00] hover:bg-[#f2d900] text-slate-950 font-mono text-xs uppercase tracking-wider font-semibold border border-slate-950 transition-all shadow-2xs whitespace-nowrap flex items-center justify-center gap-1.5 cursor-pointer"
              >
                <span>{isEn ? "Download checklist" : "Descargar la lista"}</span>
                <Icon name="bx:download" class="w-4 h-4 text-slate-950" />
              </button>
            </form>
          </div>
        </div>

        <!-- Contextual B2B Consulting CTA -->
        <div class="mt-8 p-6 rounded-3xl bg-white border border-slate-200/90 shadow-2xs text-center">
          <h4 class="text-lg font-light text-slate-950 mb-2">
            {isEn ? "Facing a similar challenge at your business?" : "¿Tienes un reto similar en tu empresa o negocio?"}
          </h4>
          <p class="text-xs sm:text-sm text-slate-600 font-light mb-4 max-w-lg mx-auto leading-relaxed">
            {isEn ? "I develop custom web apps, fast websites, and help teams optimize performance and CI/CD automation in Valencia or remotely." : "Desarrollo aplicaciones web a medida, diseño páginas web rápidas y ayudo a negocios a optimizar rendimiento y automatización en Xàtiva, Valencia o en remoto."}
          </p>
          <div class="flex flex-wrap items-center justify-center gap-3">
            <a
              href={href("/pricing")}
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-200 hover:border-slate-950 bg-white text-slate-800 hover:text-slate-950 font-mono text-xs font-semibold transition shadow-2xs"
            >
              <Icon name="bx:purchase-tag" class="w-4 h-4 text-slate-950" />
              <span>{isEn ? "Check services & pricing" : "Consultar servicios y precios"}</span>
            </a>
            <a
              href={href("/contact")}
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#FFFF00] hover:bg-[#f2d900] text-slate-950 font-mono text-xs uppercase tracking-wider font-semibold border border-slate-950 transition shadow-2xs"
            >
              <Icon name="bx:message-square-dots" class="w-4 h-4 text-slate-950" />
              <span>{isEn ? "Talk about your project" : "Hablar de tu proyecto"}</span>
            </a>
          </div>
        </div>

        <!-- Related Posts -->
        {relatedPosts.length > 0 && (
          <div class="mt-14">
            <h3 class="text-xl font-light text-slate-950 mb-6 flex items-center gap-2">
              <Icon name="bx:layer" class="w-4 h-4 text-slate-950" />
              <span>{isEn ? "Related articles" : "Artículos relacionados"}</span>
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              {relatedPosts.map((rel) => (
                <a
                  href={href(`/blog/${rel.id}`)}
                  class="group block p-5 rounded-3xl bg-white border border-slate-200/90 hover:border-slate-950 transition-all shadow-2xs hover:shadow-md"
                >
                  <span class="text-xs font-mono text-slate-500 font-semibold uppercase tracking-wider">
                    {rel.data.category}
                  </span>
                  <h4 class="text-base font-light text-slate-950 group-hover:text-black transition-colors mt-1 leading-snug">
                    {rel.data.title}
                  </h4>
                  <p class="text-xs text-slate-500 font-light mt-2 line-clamp-2">
                    {rel.data.snippet}
                  </p>
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="text-center mt-12 mb-16">
          <a
            href={href("/blog")}
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-200/90 bg-white hover:border-slate-950 text-slate-800 hover:text-slate-950 font-mono text-xs font-semibold transition-colors shadow-2xs"
          >
            <span>{isEn ? "← Back to all articles" : "← Volver a todos los artículos"}</span>
          </a>
        </div>
      </article>

      <!-- Sticky Table of Contents (Desktop Sidebar) -->
      <aside class="hidden lg:block lg:col-span-4 sticky top-24 space-y-6">
        {filteredHeadings.length > 0 && (
          <div class="p-5 rounded-3xl bg-white border border-slate-200/90 shadow-2xs">
            <h4 class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-500 mb-3 flex items-center gap-2">
              <Icon name="bx:book-content" class="w-4 h-4 text-slate-950" />
              <span>{isEn ? "Table of contents" : "Tabla de contenidos"}</span>
            </h4>
            <nav class="space-y-2 text-xs">
              {filteredHeadings.map((h) => (
                <a
                  href={`#${h.slug}`}
                  class={`block text-slate-600 hover:text-slate-950 transition-colors leading-relaxed ${
                    h.depth === 3 ? "pl-3 text-slate-400 font-light" : "font-medium"
                  }`}
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </div>
        )}

        <!-- Quick Info Box -->
        <div class="p-5 rounded-3xl bg-white border border-slate-200/90 shadow-2xs text-xs text-slate-600 space-y-3 font-mono">
          <div class="flex items-center justify-between">
            <span class="text-slate-500">{isEn ? "Technology:" : "Tecnología:"}</span>
            <span class="text-slate-900 font-semibold">{entry.data.category}</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-slate-500">{isEn ? "Reading time:" : "Lectura:"}</span>
            <span class="text-slate-900 font-semibold">~{readingMinutes} min</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-slate-500">{isEn ? "Status:" : "Estado:"}</span>
            <span class="text-slate-900 font-semibold flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#FFFF00] border border-slate-950/40 inline-block"></span>
              <span>{isEn ? "Production" : "Producción"}</span>
            </span>
          </div>
        </div>

        <!-- Workflow Tool Promo Pill -->
        <a
          href={href("/tools/workflow-generator")}
          class="block p-5 rounded-3xl bg-slate-50 border border-slate-200/90 hover:border-slate-950 transition-all text-xs shadow-2xs group"
        >
          <span class="text-slate-900 font-mono font-semibold flex items-center gap-1.5 mb-1">
            <Icon name="bx:wrench" class="w-3.5 h-3.5 text-slate-950 group-hover:rotate-45 transition-transform" />
            <span>{isEn ? "Free tool" : "Herramienta gratuita"}</span>
          </span>
          <p class="text-slate-950 font-semibold">{isEn ? "CI/CD Workflow Generator" : "Generador de Workflows CI/CD"}</p>
          <p class="text-slate-600 font-light text-[11px] mt-1">{isEn ? "Configure Astro and Angular pipelines with one click." : "Configura pipelines para Astro y Angular con un clic."}</p>
        </a>
      </aside>
    </div>
  </Container>

  <!-- Client-side Scripts: Scroll Progress, Code Copy Button Injection, Share Link -->
  <script is:inline>
    // 1. Reading Progress Bar
    const progressBar = document.getElementById("reading-progress");
    window.addEventListener("scroll", () => {
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
      if (progressBar) {
        progressBar.style.width = scrolled + "%";
      }
    }, { passive: true });

    // 2. Dynamic Copy Button for Shiki Code Blocks
    document.querySelectorAll("pre.astro-code").forEach((preBlock) => {
      if (preBlock.querySelector(".code-copy-btn")) return;

      const isEnglish = document.documentElement.lang.startsWith("en");
      const button = document.createElement("button");
      button.className = "code-copy-btn";
      button.type = "button";
      button.setAttribute("aria-label", isEnglish ? "Copy code" : "Copiar código");
      button.innerHTML = `<span>${isEnglish ? "Copy" : "Copiar"}</span>`;

      button.addEventListener("click", async () => {
        const code = preBlock.querySelector("code")?.innerText || preBlock.innerText;
        try {
          await navigator.clipboard.writeText(code);
          button.classList.add("copied");
          button.innerHTML = `<span>✓ ${isEnglish ? "Copied!" : "¡Copiado!"}</span>`;
          setTimeout(() => {
            button.classList.remove("copied");
            button.innerHTML = `<span>${isEnglish ? "Copy" : "Copiar"}</span>`;
          }, 2000);
        } catch (err) {
          console.error("Error copying code:", err);
        }
      });

      preBlock.style.position = "relative";
      preBlock.appendChild(button);
    });

    // 3. Copy Link Button
    const copyLinkBtn = document.getElementById("copy-link-btn");
    const copyLinkText = document.getElementById("copy-link-text");
    if (copyLinkBtn && copyLinkText) {
      copyLinkBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          const isEnglish = document.documentElement.lang.startsWith("en");
          copyLinkText.innerText = `✓ ${isEnglish ? "Copied!" : "¡Copiado!"}`;
          setTimeout(() => {
            copyLinkText.innerText = isEnglish ? "Copy link" : "Copiar enlace";
          }, 2000);
        } catch (e) {
          console.error("Error copying URL:", e);
        }
      });
    }
  </script>
</Layout>

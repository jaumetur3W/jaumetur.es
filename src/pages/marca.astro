---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { Icon } from "astro-icon/components";
import { localeFromPath } from "@/i18n";

const isVal = localeFromPath(Astro.url.pathname) === "val";

// Paleta de colors oficial
const brandColors = [
  {
    name: "Groc Corporatiu (Brand Yellow)",
    nameEs: "Amarillo corporativo (Brand Yellow)",
    role: "Identitat oficial 'jaume.www', isotip principal i accents d'alt impacte",
    roleEs: "Identidad oficial «jaume.www», isotipo principal y acentos de alto impacto",
    hex: "#FFFF00",
    rgb: "255, 230, 0",
    hsl: "54°, 100%, 50%",
    contrast: "16.5:1 sobre fosc (AAA)",
    contrastEs: "16,5:1 sobre fondo oscuro (AAA)",
    textDark: true,
    bgClass: "bg-[#FFFF00] border border-amber-300",
  },
  {
    name: "Índigo Primari",
    nameEs: "Índigo primario",
    role: "Identitat de marca, enllaços clau i focus d'atenció",
    roleEs: "Identidad de marca, enlaces clave y puntos de atención",
    hex: "#4F46E5",
    rgb: "79, 70, 229",
    hsl: "243°, 75%, 59%",
    contrast: "8.5:1 (WCAG AAA)",
    contrastEs: "8,5:1 (WCAG AAA)",
    textDark: false,
    bgClass: "bg-[#4F46E5]",
  },
  {
    name: "Cian Tecnològic",
    nameEs: "Cian tecnológico",
    role: "Nodes de dades, accents d'enginyeria i gradients",
    roleEs: "Nodos de datos, acentos de ingeniería y degradados",
    hex: "#06B6D4",
    rgb: "6, 182, 212",
    hsl: "189°, 94%, 43%",
    contrast: "4.7:1 (WCAG AA)",
    contrastEs: "4,7:1 (WCAG AA)",
    textDark: true,
    bgClass: "bg-[#06B6D4]",
  },
  {
    name: "Pissarra Tech (Deep Slate)",
    nameEs: "Pizarra tecnológica (Deep Slate)",
    role: "Tipografia principal, superfícies de codi i terminals",
    roleEs: "Tipografía principal, superficies de código y terminales",
    hex: "#0F172A",
    rgb: "15, 23, 42",
    hsl: "222°, 47%, 11%",
    contrast: "16.1:1 (WCAG AAA)",
    contrastEs: "16,1:1 (WCAG AAA)",
    textDark: false,
    bgClass: "bg-[#0F172A]",
  },
  {
    name: "Verd Maragda (Success)",
    nameEs: "Verde esmeralda (éxito)",
    role: "Estat en línia, fites verificades i tests superats",
    roleEs: "Estado en línea, hitos verificados y pruebas superadas",
    hex: "#10B981",
    rgb: "16, 185, 129",
    hsl: "160°, 84%, 39%",
    contrast: "4.6:1 (WCAG AA)",
    contrastEs: "4,6:1 (WCAG AA)",
    textDark: true,
    bgClass: "bg-[#10B981]",
  },
  {
    name: "Superfície Suau (Slate-50)",
    nameEs: "Superficie suave (Slate-50)",
    role: "Fons del lloc web en mode clar permanent",
    roleEs: "Fondo del sitio web en modo claro permanente",
    hex: "#F8FAFC",
    rgb: "248, 250, 252",
    hsl: "210°, 40%, 98%",
    contrast: "Base neutra",
    contrastEs: "Base neutra",
    textDark: true,
    bgClass: "bg-[#F8FAFC] border border-slate-200",
  },
];

// Matriu de Memojis contextuals
const memojiGuide = [
  {
    pose: "Salutació & Benvinguda",
    poseEs: "Saludo y bienvenida",
    file: "3.png",
    context: "Pàgina de contacte, missatgeria i targeta digital /card",
    contextEs: "Página de contacto, mensajería y tarjeta digital /card",
    alt: "Memoji de Jaume Tur saludant amb la mà",
    altEs: "Memoji de Jaume Tur saludando con la mano",
    size: "112px - 144px",
  },
  {
    pose: "Programador en Acció",
    poseEs: "Programador en acción",
    file: "2.png",
    context: "Hero de projectes, secció d'habilitats i càrrega",
    contextEs: "Cabecera de proyectos, sección de habilidades y carga",
    alt: "Memoji de Jaume Tur treballant amb el portàtil",
    altEs: "Memoji de Jaume Tur trabajando con el portátil",
    size: "128px - 180px",
  },
  {
    pose: "Somriure de Perfil",
    poseEs: "Sonrisa de perfil",
    file: "4.png",
    context: "Capçalera Hero principal sobre la targeta de codi",
    contextEs: "Cabecera principal sobre la tarjeta de código",
    alt: "Memoji de Jaume Tur somrient",
    altEs: "Memoji de Jaume Tur sonriendo",
    size: "160px - 320px",
  },
  {
    pose: "Pàgina No Trobada (404)",
    poseEs: "Página no encontrada (404)",
    file: "404.png",
    context: "Pàgina d'error 404 i continguts no localitzats",
    contextEs: "Página de error 404 y contenido no localizado",
    alt: "Memoji de Jaume Tur cercant la pàgina desconcertat",
    altEs: "Memoji de Jaume Tur buscando la página, desconcertado",
    size: "128px",
  },
  {
    pose: "Analista Tècnic & Docència",
    poseEs: "Analista técnico y docente",
    file: "blog.png",
    context: "Blog tècnic, articles d'enginyeria i documentació",
    contextEs: "Blog técnico, artículos de ingeniería y documentación",
    alt: "Memoji de Jaume Tur amb ulleres explicant un concepte",
    altEs: "Memoji de Jaume Tur con gafas explicando un concepto",
    size: "96px - 128px",
  },
  {
    pose: "Aprovació & Fita Superada",
    poseEs: "Aprobación e hito completado",
    file: "success.png",
    context: "Proves superades, subscripció i confirmació de formulari",
    contextEs: "Pruebas superadas, suscripción y confirmación de formulario",
    alt: "Memoji de Jaume Tur amb el polze amunt",
    altEs: "Memoji de Jaume Tur con el pulgar hacia arriba",
    size: "96px - 128px",
  },
];
---

<Layout
  title={isVal ? "Kit de marca i identitat visual" : "Kit de marca e identidad visual"}
  description={isVal ? "Guia d'identitat visual de Jaume Tur: logotips oficials «jaume.www», paleta de colors WCAG AA, tipografies i sistema d'iconografia tècnica." : "Guía de identidad visual de Jaume Tur: logotipos oficiales «jaume.www», paleta de colores WCAG AA, tipografías y sistema de iconografía técnica."}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">{isVal ? "Kit de marca i identitat visual" : "Kit de marca e identidad visual"}</Fragment>
      <Fragment slot="desc">
        {isVal ? "Recursos gràfics oficials, logotips i isotip d'alta resolució, paleta de colors auditable i regles d'ús per a col·laboracions, premsa i comunicació tècnica." : "Recursos gráficos oficiales, logotipos e isotipo de alta resolución, paleta de colores auditable y normas de uso para colaboraciones, prensa y comunicación técnica."}
      </Fragment>
    </Sectionhead>

    <!-- 1. Logotip & Isotip Oficials "jaume.www" -->
    <section class="max-w-5xl mx-auto mt-10 mb-16" aria-labelledby="logo-heading">
      <div class="flex items-center justify-between mb-6 flex-wrap gap-2">
        <div class="flex items-center gap-2">
          <Icon name="bx:badge-check" class="w-6 h-6 text-amber-500" />
          <h2 id="logo-heading" class="text-xl sm:text-2xl font-bold text-slate-900">
            {isVal ? 'Logotips i isotip oficials "jaume.www"' : 'Logotipos e isotipo oficiales «jaume.www»'}
          </h2>
        </div>
        <span class="text-xs font-mono font-bold px-3 py-1 rounded-full bg-amber-50 text-amber-800 border border-amber-200">
          {isVal ? "Identitat oficial única · 3 aplicacions cromàtiques" : "Identidad oficial única · 3 aplicaciones cromáticas"}
        </span>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <!-- Aplicació 1: Groc Corporatiu (#FFFF00) -->
        <div class="bg-white rounded-3xl border border-amber-200 p-6 shadow-xs flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-[10px] font-mono uppercase tracking-wider text-amber-600 font-bold">
                {isVal ? "Versió principal (groc)" : "Versión principal (amarillo)"}
              </span>
              <span class="text-[10px] font-mono bg-amber-100 text-amber-900 px-1.5 py-0.5 rounded font-bold">
                #FFFF00
              </span>
            </div>
            
            <div class="grid grid-cols-2 gap-3 mb-4">
              <div class="rounded-xl overflow-hidden shadow-2xs border border-amber-200 aspect-square flex items-center justify-center bg-[#FFFF00]">
                <img src="/img/jt.LOGO-01.png" alt={isVal ? "Logotip jaume.www sobre groc" : "Logotipo jaume.www sobre fondo amarillo"} class="w-full h-full object-cover" />
              </div>
              <div class="rounded-xl overflow-hidden shadow-2xs border border-amber-200 aspect-square flex items-center justify-center bg-[#FFFF00]">
                <img src="/img/jt.LOGO-02.png" alt={isVal ? "Isotip j sobre groc" : "Isotipo j sobre fondo amarillo"} class="w-full h-full object-cover" />
              </div>
            </div>

            <h3 class="font-bold text-slate-900 text-sm mb-1">{isVal ? "Logotip i isotip grocs" : "Logotipo e isotipo amarillos"}</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              {isVal ? 'Logotip complet «jaume.www» (LOGO-01) i isotip d’accent amb somriure i ulls XX (LOGO-02).' : 'Logotipo completo «jaume.www» (LOGO-01) e isotipo de acento con sonrisa y ojos XX (LOGO-02).'}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100 flex gap-2 mt-4">
            <a href="/img/jt.LOGO-01.png" download="jt-logo-groc.png" class="flex-1 text-center py-1.5 rounded-lg bg-slate-900 text-white font-bold text-xs hover:bg-amber-500 hover:text-slate-950 transition">LOGO-01</a>
            <a href="/img/jt.LOGO-02.png" download="jt-isotip-groc.png" class="flex-1 text-center py-1.5 rounded-lg border border-slate-200 text-slate-700 bg-white font-bold text-xs hover:bg-slate-50 transition">LOGO-02</a>
          </div>
        </div>

        <!-- Aplicació 2: Fons Fosc Obsidiana (#090D16) -->
        <div class="bg-[#090D16] text-white rounded-3xl border border-slate-800 p-6 shadow-xs flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 font-bold">
                {isVal ? "Versió fosca" : "Versión oscura"}
              </span>
              <span class="text-[10px] font-mono bg-slate-800 text-slate-300 px-1.5 py-0.5 rounded font-bold">
                #090D16
              </span>
            </div>
            
            <div class="grid grid-cols-2 gap-3 mb-4">
              <div class="rounded-xl overflow-hidden shadow-2xs border border-slate-800 aspect-square flex items-center justify-center bg-[#090D16]">
                <img src="/img/jt.LOGO-03.png" alt={isVal ? "Logotip jaume.www fosc" : "Logotipo jaume.www sobre fondo oscuro"} class="w-full h-full object-cover" />
              </div>
              <div class="rounded-xl overflow-hidden shadow-2xs border border-slate-800 aspect-square flex items-center justify-center bg-[#090D16]">
                <img src="/img/jt.LOGO-04.png" alt={isVal ? "Isotip j fosc" : "Isotipo j sobre fondo oscuro"} class="w-full h-full object-cover" />
              </div>
            </div>

            <h3 class="font-bold text-white text-sm mb-1">{isVal ? "Logotip i isotip foscos" : "Logotipo e isotipo oscuros"}</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              {isVal ? "Traç blanc d'alt contrast sobre fons obsidiana per a terminals i entorns foscos (LOGO-03 i LOGO-04)." : "Trazo blanco de alto contraste sobre fondo obsidiana para terminales y entornos oscuros (LOGO-03 y LOGO-04)."}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-800 flex gap-2 mt-4">
            <a href="/img/jt.LOGO-03.png" download="jt-logo-dark.png" class="flex-1 text-center py-1.5 rounded-lg bg-white text-slate-900 font-bold text-xs hover:bg-[#FFFF00] transition">LOGO-03</a>
            <a href="/img/jt.LOGO-04.png" download="jt-isotip-dark.png" class="flex-1 text-center py-1.5 rounded-lg border border-slate-700 text-slate-200 bg-slate-900 font-bold text-xs hover:bg-slate-800 transition">LOGO-04</a>
          </div>
        </div>

        <!-- Aplicació 3: Editorial Blanc & Negre (#000000 / #FFFFFF) -->
        <div class="bg-white rounded-3xl border border-slate-200/90 p-6 shadow-xs flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 font-bold">
                {isVal ? "Versió editorial (clara)" : "Versión editorial (clara)"}
              </span>
              <span class="text-[10px] font-mono bg-slate-100 text-slate-700 px-1.5 py-0.5 rounded font-bold">
                {isVal ? "Monocrom" : "Monocromo"}
              </span>
            </div>
            
            <div class="grid grid-cols-2 gap-3 mb-4">
              <div class="rounded-xl overflow-hidden shadow-2xs border border-slate-200 aspect-square flex items-center justify-center bg-white">
                <img src="/img/jt.LOGO-05.png" alt={isVal ? "Logotip jaume.www blanc i negre" : "Logotipo jaume.www en blanco y negro"} class="w-full h-full object-cover" />
              </div>
              <div class="rounded-xl overflow-hidden shadow-2xs border border-slate-200 aspect-square flex items-center justify-center bg-white">
                <img src="/img/jt.LOGO-06.png" alt={isVal ? "Isotip j blanc i negre" : "Isotipo j en blanco y negro"} class="w-full h-full object-cover" />
              </div>
            </div>

            <h3 class="font-bold text-slate-900 text-sm mb-1">{isVal ? "Logotip i isotip monocroms" : "Logotipo e isotipo monocromos"}</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              {isVal ? "Tinta negra pura sobre fons blanc per a impressió i aplicacions netes (LOGO-05 i LOGO-06)." : "Tinta negra pura sobre fondo blanco para impresión y aplicaciones limpias (LOGO-05 y LOGO-06)."}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100 flex gap-2 mt-4">
            <a href="/img/jt.LOGO-05.png" download="jt-logo-mono.png" class="flex-1 text-center py-1.5 rounded-lg bg-slate-900 text-white font-bold text-xs hover:bg-indigo-600 transition">LOGO-05</a>
            <a href="/img/jt.LOGO-06.png" download="jt-isotip-mono.png" class="flex-1 text-center py-1.5 rounded-lg border border-slate-200 text-slate-700 bg-white font-bold text-xs hover:bg-slate-50 transition">LOGO-06</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Paleta de Colors Oficial & Contrast WCAG -->
    <section class="max-w-5xl mx-auto mb-16" aria-labelledby="colors-heading">
      <div class="flex items-center gap-2 mb-6">
        <Icon name="bx:palette" class="w-6 h-6 text-indigo-600" />
        <h2 id="colors-heading" class="text-xl sm:text-2xl font-bold text-slate-900">
          {isVal ? "Paleta cromàtica oficial i contrast" : "Paleta cromática oficial y contraste"}
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          brandColors.map((color) => (
            <div class="bg-white rounded-3xl border border-slate-200/90 overflow-hidden shadow-2xs group hover:border-indigo-300 transition-all">
              <div class={`h-28 p-4 flex flex-col justify-end ${color.bgClass}`}>
                <span class={`font-mono text-xs font-bold ${color.textDark ? 'text-slate-900' : 'text-white'}`}>
                  {color.hex}
                </span>
              </div>
              <div class="p-5 space-y-2 text-xs">
                <div class="flex items-center justify-between">
                  <h3 class="font-bold text-slate-900 text-sm">{isVal ? color.name : color.nameEs}</h3>
                  <span class="font-mono text-[10px] text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded font-bold">
                    {isVal ? color.contrast : color.contrastEs}
                  </span>
                </div>
                <p class="text-slate-500 leading-relaxed">{isVal ? color.role : color.roleEs}</p>
                <div class="pt-2 border-t border-slate-100 font-mono text-[11px] text-slate-400 space-y-0.5">
                  <div>RGB: {color.rgb}</div>
                  <div>HSL: {color.hsl}</div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 3. Tipografia Oficial -->
    <section class="max-w-5xl mx-auto mb-16" aria-labelledby="typography-heading">
      <div class="flex items-center gap-2 mb-6">
        <Icon name="bx:font" class="w-6 h-6 text-indigo-600" />
        <h2 id="typography-heading" class="text-xl sm:text-2xl font-bold text-slate-900">
          {isVal ? "Sistema tipogràfic" : "Sistema tipográfico"}
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-3xl border border-slate-200/90 p-7 shadow-2xs">
          <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-indigo-600 block mb-2">
            {isVal ? "Tipografia de titulars (Display)" : "Tipografía para titulares (Display)"}
          </span>
          <h3 class="text-2xl font-black text-slate-900 tracking-tight mb-2">
            Bricolage Grotesque
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-4">
            {isVal ? "Font variable de caràcter contemporani, proporcions humanistes i traços angulats que transmeten personalitat i rigor d'enginyeria." : "Fuente variable de carácter contemporáneo, proporciones humanistas y trazos angulares que transmiten personalidad y rigor de ingeniería."}
          </p>
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-1 font-sans">
            <div class="text-2xl font-extrabold text-slate-900">Aa Bb Cc Dd Ee Ff Gg</div>
            <div class="text-xs text-slate-500">{isVal ? "Ús: H1, H2, H3, titulars de secció i distintius destacats." : "Uso: H1, H2, H3, títulos de sección e insignias destacadas."}</div>
          </div>
        </div>

        <div class="bg-white rounded-3xl border border-slate-200/90 p-7 shadow-2xs">
          <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-indigo-600 block mb-2">
            {isVal ? "Tipografia de lectura i codi" : "Tipografía para lectura y código"}
          </span>
          <h3 class="text-2xl font-bold text-slate-900 tracking-tight mb-2">
            Inter &amp; JetBrains Mono
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-4">
            {isVal ? "Inter per a cossos de text i paràgrafs d'alta densitat de lectura. Fonts monoespaiades del sistema per a mètriques, dades i codi." : "Inter para el texto y los párrafos de lectura densa. Fuentes monoespaciadas del sistema para métricas, datos y código."}
          </p>
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-2">
            <div class="text-sm font-sans text-slate-800">Inter Variable — The quick brown fox jumps over the lazy dog.</div>
            <div class="text-xs font-mono text-indigo-700">const developer = &#123; fps: 60, wcag: "AA" &#125;;</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Sistema de Memojis Contextuals -->
    <section class="max-w-5xl mx-auto mb-16" aria-labelledby="memojis-heading">
      <div class="flex items-center gap-2 mb-6">
        <Icon name="bx:face" class="w-6 h-6 text-indigo-600" />
        <h2 id="memojis-heading" class="text-xl sm:text-2xl font-bold text-slate-900">
          {isVal ? "Kit de Memojis contextuals" : "Kit de Memojis contextuales"}
        </h2>
      </div>

      <div class="overflow-x-auto bg-white rounded-3xl border border-slate-200/90 shadow-2xs">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 font-mono text-[11px] uppercase tracking-wider">
            <tr>
              <th class="py-3 px-5">{isVal ? "Il·lustració" : "Ilustración"}</th>
              <th class="py-3 px-5">{isVal ? "Posició i significat" : "Pose y significado"}</th>
              <th class="py-3 px-5">{isVal ? "Àmbit d'ús" : "Ámbito de uso"}</th>
              <th class="py-3 px-5">{isVal ? "Mida recomanada" : "Tamaño recomendado"}</th>
              <th class="py-3 px-5">{isVal ? "Text alternatiu (A11y)" : "Texto alternativo (A11y)"}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {
              memojiGuide.map((m) => (
                <tr class="hover:bg-slate-50/50 transition-colors">
                  <td class="py-3 px-5">
                    <img src={`/img/${m.file}`} alt={isVal ? m.alt : m.altEs} class="w-12 h-12 object-contain" width="48" height="48" />
                  </td>
                  <td class="py-3 px-5 font-bold text-slate-900">{isVal ? m.pose : m.poseEs}</td>
                  <td class="py-3 px-5 text-slate-600">{isVal ? m.context : m.contextEs}</td>
                  <td class="py-3 px-5 font-mono text-indigo-600 font-bold">{m.size}</td>
                  <td class="py-3 px-5 text-slate-500 italic">{isVal ? m.alt : m.altEs}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- 5. Regla d'Or d'Iconografia Estandarditzada -->
    <section class="max-w-5xl mx-auto mb-20 p-8 rounded-3xl bg-slate-900 text-slate-100 border border-slate-800 shadow-xl">
      <div class="flex items-center gap-3 mb-4">
        <Icon name="bx:info-circle" class="w-6 h-6 text-indigo-400 shrink-0" />
        <h3 class="text-lg font-bold">{isVal ? "Regla d'or: iconografia estandarditzada vs. emojis" : "Regla de oro: iconografía estandarizada frente a emojis"}</h3>
      </div>
      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-4">

---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { Icon } from "astro-icon/components";
import { servicesData } from "@/data/services";
import { servicesCopyEs } from "@/data/services-es";
import { localeFromPath, localizePath } from "@/i18n";
const isVal = localeFromPath(Astro.url.pathname) === "val";
const href = (path: string) => localizePath(path, isVal ? "val" : "es");

// Paquets de serveis d'alta conversió (importats des de @/data/services)
const packages = servicesData;

// Procés de treball en 4 passos
const workflowSteps = [
  {
    step: "01",
    title: isVal ? "Descoberta i abast" : "Descubrimiento y alcance",
    icon: "bx:search-alt",
    desc: isVal ? "Definim conjuntament els objectius del projecte, els requisits funcionals, els terminis i les mètriques d'èxit per a oferir una proposta ajustada i transparent." : "Definimos juntos los objetivos del proyecto, los requisitos funcionales, los plazos y las métricas de éxito para ofrecer una propuesta ajustada y transparente.",
  },
  {
    step: "02",
    title: isVal ? "Arquitectura i prototipatge" : "Arquitectura y prototipado",
    icon: "bx:layer",
    desc: isVal ? "Seleccionem la millor tecnologia, dissenyem l'estructura dels components i validem la interacció per a assegurar una base tècnica sòlida." : "Seleccionamos la mejor tecnología, diseñamos la estructura de componentes y validamos la interacción para asegurar una base técnica sólida.",
  },
  {
    step: "03",
    title: isVal ? "Desenvolupament i qualitat" : "Desarrollo y calidad",
    icon: "bx:code-curly",
    desc: isVal ? "Codi modular amb TypeScript estricte, proves unitàries i validació contínua del rendiment a 60 FPS i de l'accessibilitat WCAG AA." : "Código modular con TypeScript estricto, pruebas unitarias y validación continua del rendimiento a 60 FPS y de la accesibilidad WCAG AA.",
  },
  {
    step: "04",
    title: isVal ? "Desplegament i verificació" : "Despliegue y verificación",
    icon: "bx:check-shield",
    desc: isVal ? "Publicació atòmica sense interrupcions, auditories finals i documentació clara perquè mantingues el control total." : "Publicación atómica sin interrupciones, auditorías finales y documentación clara para que mantengas el control total.",
  },
];

// Preguntes Freqüents per al FAQ interactiu i Schema JSON-LD
const faqs = [
  {
    question: isVal ? "Com s'estructura el pagament inicial i la mensualitat de manteniment?" : "¿Cómo se estructura el pago inicial y la mensualidad de mantenimiento?",
    answer: isVal ? "Els projectes tenen un pagament inicial de creació i desenvolupament, a més d'una quota mensual de manteniment tècnic. El manteniment inclou una permanència mínima d'un any per a mantindre el projecte ràpid, segur i actualitzat, amb suport tècnic." : "Los proyectos incluyen un pago inicial de creación y desarrollo, además de una cuota mensual de mantenimiento técnico. El mantenimiento requiere una permanencia mínima de un año para mantener el proyecto rápido, seguro y actualizado, con soporte técnico.",
  },
  {
    question: isVal ? "Què inclou el manteniment mensual?" : "¿Qué incluye el mantenimiento mensual?",
    answer: isVal ? "Inclou supervisió de disponibilitat i rendiment, actualitzacions de dependències i seguretat, còpies de seguretat, resolució d'incidències i assessorament per a l'evolució de la plataforma." : "Incluye supervisión de disponibilidad y rendimiento, actualizaciones de dependencias y seguridad, copias de seguridad, resolución de incidencias y asesoramiento para la evolución de la plataforma.",
  },
  {
    question: isVal ? "Per què hi ha una permanència mínima d'un any?" : "¿Por qué hay una permanencia mínima de un año?",
    answer: isVal ? "Una solució web necessita continuïtat tècnica per a mantindre la velocitat, evitar vulnerabilitats i garantir que els canvis en navegadors o dependències no interrompen el servei." : "Una solución web necesita continuidad técnica para mantener la velocidad, evitar vulnerabilidades y garantizar que los cambios en navegadores o dependencias no interrumpan el servicio.",
  },
  {
    question: isVal ? "Com ens comunicarem i farem el seguiment?" : "¿Cómo nos comunicaremos y haremos el seguimiento?",
    answer: isVal ? "La comunicació serà fluida, asíncrona i transparent, principalment per correu electrònic. També tindràs accés al repositori i a una previsualització per a provar cada avanç abans de publicar-lo." : "La comunicación será fluida, asíncrona y transparente, principalmente por correo electrónico. También tendrás acceso al repositorio y a una vista previa para probar cada avance antes de publicarlo.",
  },
  {
    question: isVal ? "Com és la modalitat de treball?" : "¿Cómo es la modalidad de trabajo?",
    answer: isVal ? "Treballe 100% en línia des de Xàtiva (València), amb comunicació asíncrona fluida per correu o videotrucada amb clients de la Comunitat Valenciana i de qualsevol altra zona." : "Trabajo 100% en línea desde Xàtiva (Valencia), con comunicación ágil y transparente por correo o videollamada con clientes de la Comunidad Valenciana y de cualquier otra zona.",
  },
  {
    question: isVal ? "Quines garanties tècniques ofereixes?" : "¿Qué garantías técnicas ofreces?",
    answer: isVal ? "Els projectes es lliuren amb mètriques auditables: puntuacions de Lighthouse, comprovacions d'accessibilitat WCAG 2.2 AA i compilació TypeScript sense errors." : "Los proyectos se entregan con métricas auditables: puntuaciones de Lighthouse, comprobaciones de accesibilidad WCAG 2.2 AA y compilación TypeScript sin errores.",
  },
  {
    question: isVal ? "Com podem començar a treballar junts?" : "¿Cómo podemos empezar a trabajar juntos?",
    answer: isVal ? "Envia un missatge des del formulari o escriu a jaumetur3w@gmail.com explicant què necessites. Et respondré en menys de 24 hores laborables." : "Envía un mensaje desde el formulario o escribe a jaumetur3w@gmail.com explicando qué necesitas. Te responderé en menos de 24 horas laborables.",
  },
];

// Schema JSON-LD FAQPage per a Google
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer,
    },
  })),
};
---

<Layout
  title={isVal ? "Serveis de Disseny Web i Aplicacions a Xàtiva i València | Jaume Tur" : "Servicios de Diseño Web y Aplicaciones en Xàtiva y Valencia | Jaume Tur"}
  description={isVal ? "Serveis professionals de disseny web, creació de pàgines per a negocis, aplicacions a mida, backend i CI/CD des de Xàtiva i València." : "Servicios profesionales de diseño web, creación de páginas para negocios, aplicaciones web a medida, backend y CI/CD desde Xàtiva y Valencia."}>
  
  <!-- Structured Data: FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Container>
    <!-- Capçalera Principal -->
    <Sectionhead>
      <Fragment slot="title">{isVal ? "Serveis de desenvolupament web i aplicacions" : "Servicios de desarrollo web y aplicaciones"}</Fragment>
      <Fragment slot="desc">
        {isVal ? "Col·laboració professional i transparent per a crear pàgines web per a negocis, landing pages i aplicacions ràpides a Xàtiva, València i en remot." : "Colaboración profesional y transparente para crear páginas web para negocios, landing pages y aplicaciones rápidas en Xàtiva, Valencia y en remoto."}
      </Fragment>
    </Sectionhead>

    <!-- Indicadors: Disponibilitat i Model de Servei -->
    <div class="flex flex-wrap items-center justify-center gap-3 mt-8 mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-mono font-medium bg-emerald-50 text-emerald-800 border border-emerald-200/80 shadow-2xs">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span>{isVal ? "Disponibilitat per a projectes: activa" : "Disponibilidad para proyectos: activa"}</span>
      </div>
      <div class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-mono font-bold bg-amber-50 text-amber-900 border border-amber-300 shadow-2xs">
        <Icon name="bx:star" class="w-3.5 h-3.5 text-amber-600" />
        <span>{isVal ? "Proposta estrella: pack de digitalització local i carta web" : "Propuesta estrella: paquete de digitalización local y carta web"}</span>
      </div>
      <div class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-mono font-medium bg-indigo-50 text-indigo-800 border border-indigo-200/80 shadow-2xs">
        <Icon name="bx:shield-quarter" class="w-3.5 h-3.5 text-indigo-600" />
        <span>{isVal ? "Model d'entrada i mensualitat (manteniment mínim d'un any)" : "Modelo de pago inicial y mensualidad (mantenimiento mínimo de un año)"}</span>
      </div>
    </div>

    <!-- Graella de Paquets de Serveis -->
    <div class="grid md:grid-cols-2 gap-8 max-w-6xl mx-auto">
      {
        packages.map((pkg) => {
          const packageCopy = isVal ? pkg : { ...pkg, ...servicesCopyEs[pkg.id] };
          return (
          <div
            class:list={[
              "rounded-2xl p-7 sm:p-9 flex flex-col justify-between transition-colors duration-200 group relative",
              pkg.isFeatured
                ? "md:col-span-2 bg-gradient-to-br from-amber-50/60 via-white to-yellow-50/40 border-2 border-amber-400 shadow-xl shadow-amber-500/10 hover:border-amber-500 ring-4 ring-amber-400/10"
                : "bg-white border border-slate-200 hover:border-slate-400"
            ]}
          >
            {pkg.isFeatured && (
              <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-gradient-to-r from-amber-500 to-yellow-400 text-slate-950 px-4 py-1 rounded-full text-xs font-mono font-black uppercase tracking-wider shadow-md flex items-center gap-1.5 whitespace-nowrap z-10">
                <Icon name="bx:star" class="w-4 h-4 fill-slate-950" />
                <span>{isVal ? "Proposta clau · Oferta estrella per a bars i comerços" : "Propuesta clave · Oferta estrella para bares y comercios"}</span>
              </div>
            )}

            <div>
              <!-- Capçalera de la targeta -->
              <div class="flex items-center justify-between gap-3 mb-5">
                <div class:list={[
                  "w-12 h-12 rounded-2xl flex items-center justify-center group-hover:scale-105 transition-transform",
                  pkg.isFeatured ? "bg-amber-100/80 border border-amber-300" : "bg-slate-50 border border-slate-200/80"
                ]}>
                  <Icon name={pkg.icon} class={`w-6 h-6 ${pkg.iconColor}`} />
                </div>
                <span class={`text-[11px] font-mono font-bold uppercase tracking-wider px-3 py-1 rounded-full border shadow-2xs ${pkg.badgeColor}`}>
                  {packageCopy.badge}
                </span>
              </div>

              <!-- Layout de contingut: 2 columnes per a la proposta clau en escriptori -->
              <div class:list={[pkg.isFeatured && "grid md:grid-cols-12 gap-8 items-start"]}>
                <div class:list={[pkg.isFeatured && "md:col-span-7"]}>
                  <!-- Títol i Descripció -->
                  <h3 class:list={[
                    "font-bold text-slate-900 mb-2 group-hover:text-indigo-600 transition-colors",
                    pkg.isFeatured ? "text-2xl sm:text-3xl text-amber-950" : "text-xl sm:text-2xl"
                  ]}>
                    <a href={href(`/pricing/${pkg.id}`)} class="hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 rounded">
                      {packageCopy.name}
                    </a>
                  </h3>
                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
                    {packageCopy.description}
                  </p>

                  <!-- Per a qui és -->
                  <div class="p-3.5 rounded-2xl bg-slate-50/80 border border-slate-200/70 mb-6 text-xs">
                    <span class="font-bold text-slate-900 block mb-1 flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wider">
                      <Icon name="bx:user-check" class="w-4 h-4 text-indigo-600" />
                      <span>{isVal ? "Per a qui és aquest servei:" : "¿Para quién es este servicio?"}</span>
                    </span>
                    <span class="text-slate-600 leading-relaxed">
                      {packageCopy.targetAudience}
                    </span>
                  </div>

                  <!-- Estructura de Preus: Entrada + Mensualitat amb manteniment -->
                  <div class:list={[
                    "p-4 rounded-2xl border mb-4 font-mono text-xs space-y-2.5",
                    pkg.isFeatured ? "bg-amber-100/40 border-amber-200/90" : "bg-indigo-50/60 border-indigo-100/90"
                  ]}>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                      <div>
                        <span class="text-[10px] text-slate-500 uppercase tracking-wider block">{isVal ? "Entrada / creació" : "Pago inicial / creación"}</span>
                        <span class="font-bold text-indigo-950 text-sm mt-0.5 block">{packageCopy.creationPrice}</span>
                      </div>
                      <div>
                        <span class="text-[10px] text-slate-500 uppercase tracking-wider block">{isVal ? "Mensualitat" : "Mensualidad"}</span>
                        <span class:list={["text-sm mt-0.5 block font-bold", pkg.isFeatured ? "text-amber-800" : "text-indigo-600"]}>
                          +{pkg.monthlyFee}
                        </span>
                      </div>
                      <div>
                        <span class="text-[10px] text-slate-500 uppercase tracking-wider block">{isVal ? "Termini d'entrega" : "Plazo de entrega"}</span>
                        <span class="font-bold text-slate-800 text-sm mt-0.5 block">{packageCopy.timeline}</span>
                      </div>
                    </div>

                    <!-- Condició de Manteniment No Opcional i Permanència Mínima -->
                    <div class="pt-2 border-t border-slate-200/60 flex items-center gap-1.5 text-[11px] text-slate-700 font-medium">
                      <Icon name="bx:shield-quarter" class="w-3.5 h-3.5 text-indigo-600 shrink-0" />
                      <span>{isVal ? "Manteniment inclòs (no opcional · permanència mín. d'un any)" : "Mantenimiento incluido (obligatorio · permanencia mínima de un año)"}</span>
                    </div>
                  </div>

                  <!-- Enllaç a l'Explicació del Preu, Comparativa i Amortització -->
                  <a
                    href={href(`/pricing/${pkg.id}`)}
                    class:list={[
                      "flex items-center justify-between gap-2 p-3 rounded-2xl border text-xs font-mono font-bold transition-all group/info mb-6 md:mb-0",
                      pkg.isFeatured
                        ? "bg-amber-100/80 hover:bg-amber-200/80 border-amber-300 text-amber-950"
                        : "bg-indigo-50/80 hover:bg-indigo-100/90 border-indigo-200/80 text-indigo-900"
                    ]}
                    title={isVal ? `Veure per què costa aquest preu i com s'amortitza ${packageCopy.name}` : `Descubre por qué cuesta este precio y cómo se amortiza ${packageCopy.name}`}
                  >
                    <span class="flex items-center gap-1.5">
                      <Icon name="bx:info-circle" class="w-4 h-4 text-indigo-600 shrink-0" />
                      <span>{isVal ? "Per què aquest preu? Comparativa i amortització" : "¿Por qué este precio? Comparativa y amortización"}</span>
                    </span>
                    <span class="inline-flex items-center gap-1 text-[11px] text-indigo-600 group-hover/info:translate-x-0.5 transition-transform">
                      <span>{isVal ? "Veure detall" : "Ver detalles"}</span>
                      <Icon name="bx:right-arrow-alt" class="w-3.5 h-3.5" />
                    </span>
                  </a>
                </div>

                <div class:list={[pkg.isFeatured && "md:col-span-5 flex flex-col justify-between h-full"]}>
                  <!-- Llista d'Inclusions -->
                  <div class="space-y-3 pt-2">
                    <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400 block">
                      {isVal ? "Què inclou exactament:" : "¿Qué incluye exactamente?"}
                    </span>
                    <ul class="space-y-2.5 text-xs text-slate-700">
                      {packageCopy.features.map((feature) => (
                        <li class="flex items-start gap-2.5">
                          <Icon name="bx:check" class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                          <span>{feature}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <!-- Botons d'Acció: Detall & Contactar (si és featured en 2 columnes) -->
                  {pkg.isFeatured && (
                    <div class="mt-8 pt-6 border-t border-amber-200/60 flex flex-col sm:flex-row gap-2.5">
                      <a
                        href={href(`/pricing/${pkg.id}`)}
                        class="flex-1 inline-flex items-center justify-center gap-1.5 py-3 px-4 rounded-xl text-xs font-bold text-slate-800 bg-white hover:bg-slate-50 border border-slate-300 transition text-center shadow-2xs"
                      >
                        <Icon name="bx:detail" class="w-4 h-4 text-indigo-600" />
                        <span>{isVal ? "Detall i comparativa" : "Detalle y comparativa"}</span>
                      </a>
                      <a
                        href={href(`/contact?servei=${pkg.id}`)}
                        data-analytics-cta={pkg.id}
                        class="flex-1 inline-flex items-center justify-center gap-1.5 py-3 px-4 rounded-xl text-xs font-bold bg-[#FFFF00] hover:bg-yellow-400 text-slate-950 shadow-md shadow-yellow-500/20 transition group/btn text-center"
                      >
                        <span>{packageCopy.ctaText}</span>
                        <Icon name="bx:right-arrow-alt" class="w-4 h-4 group-hover/btn:translate-x-1 transition-transform" />
                      </a>
                    </div>
                  )}
                </div>
              </div>
            </div>

            <!-- Botons d'Acció per a targetes normals (no featured) -->
            {!pkg.isFeatured && (
              <div class="mt-8 pt-6 border-t border-slate-100 flex flex-col sm:flex-row gap-2.5">
                <a
                  href={href(`/pricing/${pkg.id}`)}
                  class="flex-1 inline-flex items-center justify-center gap-1.5 py-3 px-4 rounded-xl text-xs font-bold text-indigo-900 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 transition text-center"
                >
                  <Icon name="bx:detail" class="w-4 h-4 text-indigo-600" />
                  <span>{isVal ? "Detall i comparativa" : "Detalle y comparativa"}</span>
                </a>
                <a
                  href={href(`/contact?servei=${pkg.id}`)}
                  data-analytics-cta={pkg.id}
                  class="flex-1 inline-flex items-center justify-center gap-1.5 py-3 px-4 rounded-xl text-xs font-bold bg-slate-900 hover:bg-indigo-600 text-white shadow-sm transition group/btn text-center"
                >
                  <span>{packageCopy.ctaText}</span>
                  <Icon name="bx:right-arrow-alt" class="w-4 h-4 group-hover/btn:translate-x-1 transition-transform" />
                </a>
              </div>
            )}
          </div>
          );
        })
      }
    </div>

    <!-- Prova Social Real (Projectes Verificables de l'Enginyer) -->
    <div class="mt-20 max-w-5xl mx-auto">
      <div class="text-center mb-8">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-200/60">
          {isVal ? "Portafolis i demos funcionals" : "Portafolio y demos funcionales"}
        </span>
        <h3 class="text-2xl font-bold text-slate-900 mt-2">
          {isVal ? "Projectes desenvolupats i verificables" : "Proyectos desarrollados y verificables"}
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 max-w-xl mx-auto mt-1">
          {isVal
            ? "Cadascun d'aquests projectes compta amb cas d'estudi tècnic i codi auditable:"
            : "Cada proyecto cuenta con un caso de estudio técnico y código auditable:"}
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a
          href={href("/projectes/avisa")}
          class="p-5 rounded-2xl bg-white border border-slate-200/90 hover:border-indigo-400 hover:shadow-md transition group flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <Icon name="bx:bell" class="w-6 h-6 text-rose-500" />
              <span class="text-[10px] font-mono text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded font-bold">{isVal ? "Producció" : "En producción"}</span>
            </div>
            <h4 class="font-bold text-slate-900 text-sm group-hover:text-indigo-600 transition-colors">AVISA</h4>
            <p class="text-[11px] text-slate-500 mt-1">{isVal ? "Plataforma d'incidències amb Angular Signals i WCAG AA." : "Plataforma de incidencias con Angular Signals y WCAG AA."}</p>
          </div>
          <span class="text-xs font-bold text-indigo-600 mt-4 flex items-center gap-1">
            <span>{isVal ? "Veure cas d'estudi" : "Ver caso de estudio"}</span>
            <Icon name="bx:right-arrow-alt" class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
          </span>
        </a>

        <a
          href={href("/projectes/pizzeria-xativa")}
          class="p-5 rounded-2xl bg-white border border-slate-200/90 hover:border-indigo-400 hover:shadow-md transition group flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <Icon name="bx:restaurant" class="w-6 h-6 text-amber-500" />
              <span class="text-[10px] font-mono text-amber-800 bg-amber-50 px-2 py-0.5 rounded font-bold">{isVal ? "Demo interactiva" : "Demo interactiva"}</span>
            </div>
            <h4 class="font-bold text-slate-900 text-sm group-hover:text-indigo-600 transition-colors">Pizzeria a Xàtiva</h4>
            <p class="text-[11px] text-slate-500 mt-1">{isVal ? "Prototip de carta digital de 85 KB, comandes de mostra i pass Wallet." : "Prototipo de carta digital de 85 KB, pedidos de muestra y pase Wallet."}</p>
          </div>
          <span class="text-xs font-bold text-indigo-600 mt-4 flex items-center gap-1">
            <span>{isVal ? "Veure cas d'estudi" : "Ver caso de estudio"}</span>
            <Icon name="bx:right-arrow-alt" class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
          </span>
        </a>

        <a
          href={href("/projectes/dashboard-telemetria")}
          class="p-5 rounded-2xl bg-white border border-slate-200/90 hover:border-indigo-400 hover:shadow-md transition group flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <Icon name="bx:line-chart" class="w-6 h-6 text-indigo-500" />
              <span class="text-[10px] font-mono text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded font-bold">60 FPS</span>
            </div>
            <h4 class="font-bold text-slate-900 text-sm group-hover:text-indigo-600 transition-colors">Dashboard Telemetria</h4>
            <p class="text-[11px] text-slate-500 mt-1">{isVal ? "Renderitzat fluid en temps real i Core Web Vitals estrictes." : "Renderizado fluido en tiempo real y Core Web Vitals estrictos."}</p>
          </div>
          <span class="text-xs font-bold text-indigo-600 mt-4 flex items-center gap-1">
            <span>{isVal ? "Veure cas d'estudi" : "Ver caso de estudio"}</span>
            <Icon name="bx:right-arrow-alt" class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
          </span>
        </a>

        <a
          href={href("/projectes/pipeline-cicd")}
          class="p-5 rounded-2xl bg-white border border-slate-200/90 hover:border-indigo-400 hover:shadow-md transition group flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <Icon name="bx:git-repo-forked" class="w-6 h-6 text-sky-500" />
              <span class="text-[10px] font-mono text-sky-700 bg-sky-50 px-2 py-0.5 rounded font-bold">{isVal ? "Automàtic" : "Automático"}</span>
            </div>
            <h4 class="font-bold text-slate-900 text-sm group-hover:text-indigo-600 transition-colors">Pipeline CI/CD</h4>
            <p class="text-[11px] text-slate-500 mt-1">{isVal ? "GitHub Actions atòmic, zero temps d'inactivitat i proves automàtiques." : "GitHub Actions atómico, sin tiempo de inactividad y con pruebas automáticas."}</p>
          </div>
          <span class="text-xs font-bold text-indigo-600 mt-4 flex items-center gap-1">
            <span>{isVal ? "Veure cas d'estudi" : "Ver caso de estudio"}</span>
            <Icon name="bx:right-arrow-alt" class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
          </span>
        </a>
      </div>

    </div>

    <!-- Procés de Treball en 4 Fases (Amb Icones Estandarditzades) -->
    <div class="mt-20 max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-200/60">
          {isVal ? "Metodologia i transparència" : "Metodología y transparencia"}
        </span>
        <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 mt-2">
          {isVal ? "Com treballem junts pas a pas" : "Cómo trabajamos juntos paso a paso"}
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 max-w-lg mx-auto mt-1">
          {isVal
            ? "Un procés clar i estructurat per garantir zero sorpreses i entregues a temps."
            : "Un proceso claro y estructurado para evitar sorpresas y cumplir los plazos."}
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          workflowSteps.map((ws) => (
            <div class="p-6 rounded-3xl bg-white border border-slate-200/90 shadow-2xs hover:border-indigo-300 transition-all flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="w-10 h-10 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600">
                    <Icon name={ws.icon} class="w-5 h-5" />
                  </span>
                  <span class="text-xs font-mono font-black text-slate-400">{ws.step}</span>
                </div>
                <h4 class="font-bold text-slate-900 text-base mb-2">{ws.title}</h4>
                <p class="text-xs text-slate-600 leading-relaxed">{ws.desc}</p>
              </div>
              <div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-1.5 text-[11px] font-mono text-emerald-600 font-bold">
                <Icon name="bx:check-circle" class="w-3.5 h-3.5" />
                <span>Fase verificada</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Secció de Preguntes Freqüents (FAQ Interactiu) -->
    <div class="mt-20 max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-200/60">
          {isVal ? "FAQ i resolució de dubtes" : "Preguntas y respuestas"}
        </span>
        <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 mt-2">
          {isVal ? "Preguntes freqüents" : "Preguntas frecuentes"}
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 max-w-lg mx-auto mt-1">
          {isVal
            ? "Tot el que necessites saber abans de començar un projecte."
            : "Todo lo que necesitas saber antes de empezar un proyecto."}
        </p>
      </div>

      <div class="space-y-4">
        {
          faqs.map((faq) => (
            <details class="group bg-white rounded-2xl border border-slate-200/90 p-5 shadow-2xs transition-all duration-200 open:shadow-md open:border-indigo-200">
              <summary class="font-bold text-sm sm:text-base text-slate-900 cursor-pointer list-none flex items-center justify-between gap-3 select-none">
                <span class="flex items-center gap-2">
                  <Icon name="bx:help-circle" class="w-4 h-4 text-indigo-600 shrink-0" />
                  <span>{faq.question}</span>
                </span>
                <Icon name="bx:chevron-down" class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform shrink-0" />
              </summary>
              <p class="mt-3 text-xs sm:text-sm text-slate-600 leading-relaxed pl-6 border-t border-slate-100 pt-3">
                {faq.answer}
              </p>
            </details>
          ))
        }
      </div>
    </div>

    <!-- CTA Final Enfocat a la Conversió -->
    <div class="mt-20 mb-12 p-8 sm:p-12 rounded-[2.5rem] bg-gradient-to-br from-indigo-900 via-slate-900 to-slate-950 text-white max-w-4xl mx-auto shadow-2xl relative overflow-hidden">
      <!-- Fons geomètric subtil -->
      <div class="absolute inset-0 bg-[radial-gradient(#6366f125_1px,transparent_1px)] bg-[size:24px_24px] pointer-events-none opacity-40"></div>
      
      <div class="relative z-10 text-center max-w-xl mx-auto space-y-4">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold bg-emerald-950 text-emerald-400 border border-emerald-800/80 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>{isVal ? "DISPONIBLE PER A NOUS PROJECTES" : "DISPONIBLE PARA NUEVOS PROYECTOS"}</span>
        </span>
        <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
          {isVal ? "Tens una idea o un projecte que vols fer realitat?" : "¿Tienes una idea o un proyecto que quieres hacer realidad?"}
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          {isVal
            ? "Parlar és gratuït i sense cap compromís. Explica'm el teu repte tècnic i t'enviaré una proposta clara amb terminis i pressupost detallat."
            : "La primera conversación es gratuita y sin compromiso. Cuéntame tu reto técnico y te enviaré una propuesta clara con plazos y presupuesto detallado."}
        </p>

        <div class="pt-4 flex flex-wrap gap-3 justify-center items-center">
          <a
            href={href("/contact")}
            id="pricing-cta-primary"
            class="group inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white text-slate-950 text-xs sm:text-sm font-bold hover:bg-slate-100 transition shadow-lg">
            <Icon name="bx:message-square-dots" class="w-4 h-4 text-indigo-600 group-hover:scale-110 transition-transform" />
            <span>{isVal ? "Demanar proposta sense compromís" : "Solicitar propuesta sin compromiso"}</span>
          </a>
          <a
            href={`mailto:jaumetur3w@gmail.com?subject=${encodeURIComponent(isVal ? "Consulta sobre serveis" : "Consulta sobre servicios")}`}
            id="pricing-cta-email"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-indigo-700 hover:bg-indigo-600 text-white text-xs sm:text-sm font-bold transition shadow-lg">
            <Icon name="bx:envelope" class="w-4 h-4 text-indigo-200" />
            <span>{isVal ? "Escriure per correu" : "Escribir por correo"}</span>
          </a>
        </div>
      </div>
    </div>
  </Container>
</Layout>

<script is:inline>
  // Seguiment d'esdeveniments de conversió a la pàgina de serveis
  document.querySelectorAll("[data-analytics-cta]").forEach((el) => {
    el.addEventListener("click", () => {
      const pkg = el.getAttribute("data-analytics-cta");
      if (typeof window.plausible === "function") {
        window.plausible("service_inquiry_click", { props: { package: pkg } });
      }
    });
  });

  const primaryBtn = document.getElementById("pricing-cta-primary");
  if (primaryBtn) {
    primaryBtn.addEventListener("click", () => {
      if (typeof window.plausible === "function") {
        window.plausible("cta_click", { props: { location: "pricing_bottom_primary" } });
      }
    });
  }

  const emailBtn = document.getElementById("pricing-cta-email");
  if (emailBtn) {
    emailBtn.addEventListener("click", () => {
      if (typeof window.plausible === "function") {
        window.plausible("email_click", { props: { location: "pricing_bottom" } });
      }
    });
  }
</script>

---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import { getServicesData } from "@/data/services";
import { localeFromPath, localizePath } from "@/i18n";

const locale = localeFromPath(Astro.url.pathname);
const isEn = locale === "en";
const to = (path: string) => {
  const p = localizePath(path, locale);
  return p === "/" || p.endsWith("/") ? p : `${p}/`;
};
const services = getServicesData(locale);
const monthly = (n: number) => (isEn ? `€${n}/month` : `${n} €/mes`);
const euro = (n: number) => (isEn ? `€${n.toLocaleString("en-US")}` : `${n.toLocaleString("es-ES")} €`);

const t = isEn
  ? {
      title: "Web design services and pricing in Valencia | Jaume Tur",
      desc: "Transparent prices for websites, digital menus, landing pages, web apps, optimisation and CI/CD. From €290. Based in Xàtiva, working across Valencia and remote.",
      eyebrow: "Services & pricing",
      h1: "Clear prices. Clear scope. No surprises.",
      lead: "Every plan has a starting price for creation plus a monthly maintenance fee (one-year minimum). You see what's included before you ask.",
      from: "From",
      deliver: "Delivery",
      forWho: "Ideal for",
      includes: "Includes",
      firstYear: "First year",
      detail: "See full detail",
      request: "Request this plan",
      recommended: "Most recommended",
      noteTitle: "How the pricing works",
      notes: [
        "Creation price: one-off payment for analysis, design, development, quality review and delivery of the code and documentation.",
        "Monthly fee: continued technical maintenance, incident follow-up, included updates and advice. Minimum commitment of one year, as stated in each offer.",
        "Final scope and timeline are agreed with you before starting.",
      ],
      ctaTitle: "Not sure which plan fits?",
      ctaText: "Tell me about your business and I'll recommend what makes sense — even if that's the smallest plan.",
      cta: "Ask for a quote",
    }
  : {
      title: "Servicios y precios de diseño web en Valencia | Jaume Tur",
      desc: "Precios transparentes de páginas web, cartas digitales, landing pages, apps web, optimización y CI/CD. Desde 290 €. Desde Xàtiva para Valencia y en remoto.",
      eyebrow: "Servicios y precios",
      h1: "Precios claros. Alcance claro. Sin sorpresas.",
      lead: "Cada plan tiene un precio de creación de partida y una cuota mensual de mantenimiento (permanencia mínima de un año). Ves lo que incluye antes de pedir nada.",
      from: "Desde",
      deliver: "Entrega",
      forWho: "Ideal para",
      includes: "Incluye",
      firstYear: "Primer año",
      detail: "Ver detalle completo",
      request: "Solicitar este plan",
      recommended: "Más recomendado",
      noteTitle: "Cómo funcionan los precios",
      notes: [
        "Precio de creación: pago único por el análisis, el diseño, el desarrollo, la revisión de calidad y la entrega del código y la documentación.",
        "Cuota mensual: mantenimiento técnico continuado, seguimiento de incidencias, actualizaciones incluidas y asesoramiento. Permanencia mínima de un año, como se indica en cada oferta.",
        "El alcance final y el plazo se acuerdan contigo antes de empezar.",
      ],
      ctaTitle: "¿No sabes qué plan te encaja?",
      ctaText: "Cuéntame tu negocio y te recomiendo lo que tenga sentido, aunque sea el plan más pequeño.",
      cta: "Pedir presupuesto",
    };

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": t.eyebrow,
  "itemListElement": services.map((s, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": s.name,
    "url": `https://jaumetur.es${to(`/pricing/${s.id}`)}`,
  })),
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": isEn ? "Home" : "Inicio", "item": `https://jaumetur.es${to("/")}` },
    { "@type": "ListItem", "position": 2, "name": t.eyebrow, "item": `https://jaumetur.es${to("/pricing")}` },
  ],
};
---

<Layout fresh title={t.title} description={t.desc} jsonLd={[itemList, breadcrumb]}>
  <section class="border-b-2 border-ink bg-brand px-4 pb-14 pt-14 sm:px-5 sm:pt-20">
    <div class="mx-auto max-w-(--breakpoint-xl)">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 class="display mt-4 max-w-4xl text-[clamp(2.4rem,6.5vw,5rem)]">{t.h1}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/85">{t.lead}</p>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-5 sm:py-24">
    <div class="mx-auto grid max-w-(--breakpoint-xl) gap-8 lg:grid-cols-2">
      {services.map((s) => (
        <article class:list={["card flex flex-col overflow-hidden", s.isFeatured ? "bg-brand lg:col-span-2" : ""]}>
          <div class:list={["grid flex-1", s.isFeatured ? "lg:grid-cols-12" : ""]}>
            <div class:list={["p-7 sm:p-9", s.isFeatured ? "lg:col-span-7" : ""]}>
              <div class="flex flex-wrap items-center gap-2">
                <span class="flex h-11 w-11 items-center justify-center rounded-2xl border-2 border-ink bg-brand">
                  <Icon name={s.icon} class="h-6 w-6" />
                </span>
                {s.isFeatured && <span class="chip bg-ink! text-brand">{t.recommended}</span>}
              </div>
              <h2 class="mt-4 font-display text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">{s.name}</h2>
              <p class="mt-3 text-lg leading-relaxed text-ink/80">{s.tagline}</p>
              <p class="mt-4 text-sm text-ink/75"><strong>{t.forWho}:</strong> {s.targetAudience}</p>
              <h3 class="mt-6 font-mono text-xs font-bold uppercase tracking-[0.14em]">{t.includes}</h3>
              <ul class="mt-3 space-y-2">
                {s.features.map((f) => (
                  <li class="flex gap-2.5 text-[0.95rem] leading-snug">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-ink text-xs font-bold text-brand" aria-hidden="true">✓</span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class:list={["flex flex-col justify-between gap-6 border-t-2 border-ink bg-ink p-7 text-white sm:p-9", s.isFeatured ? "lg:col-span-5 lg:border-l-2 lg:border-t-0" : ""]}>
              <div>
                <p class="font-mono text-xs font-bold uppercase tracking-[0.14em] text-brand">{t.from}</p>
                <p class="display mt-1 text-6xl text-brand">{euro(s.creationPriceNumber)}</p>
                <p class="mt-2 text-lg">+ {monthly(s.monthlyFeeNumber)}</p>
                <dl class="mt-5 space-y-1.5 text-sm text-white/80">
                  <div><dt class="inline font-bold text-white">{t.deliver}:</dt> <dd class="inline">{s.timeline}</dd></div>
                  <div><dt class="inline font-bold text-white">{t.firstYear}:</dt> <dd class="inline">{s.annualTotal}</dd></div>
                </dl>
              </div>
              <div class="on-dark flex flex-wrap gap-3">
                <a href={to("/contact")} class="btn btn-brand btn-sm">{t.request}</a>
                <a href={to(`/pricing/${s.id}`)} class="btn btn-ink btn-sm">{t.detail}</a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="border-y-2 border-ink bg-sand px-4 py-16 sm:px-5">
    <div class="mx-auto max-w-(--breakpoint-xl)">
      <h2 class="display text-[clamp(1.8rem,4vw,3rem)]">{t.noteTitle}</h2>
      <ul class="mt-8 grid gap-5 md:grid-cols-3">
        {t.notes.map((n, i) => (
          <li class="card bg-white p-6">
            <span class="display text-4xl text-brand [-webkit-text-stroke:2px_#0b0b0f]">0{i + 1}</span>
            <p class="mt-3 leading-relaxed">{n}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-brand px-4 py-16 text-center sm:px-5 sm:py-24">
    <h2 class="display mx-auto max-w-3xl text-[clamp(2rem,5.5vw,4rem)]">{t.ctaTitle}</h2>
    <p class="mx-auto mt-5 max-w-xl text-lg text-ink/85">{t.ctaText}</p>
    <p class="mt-8"><a href={to("/contact")} class="btn btn-ink">{t.cta} <span aria-hidden="true">→</span></a></p>
  </section>
</Layout>

</Layout>

<script is:inline>
  // Seguiment d'esdeveniments de conversió a la pàgina de serveis
  document.querySelectorAll("[data-analytics-cta]").forEach((el) => {
    el.addEventListener("click", () => {
      const pkg = el.getAttribute("data-analytics-cta");
      if (typeof window.plausible === "function") {
        window.plausible("service_inquiry_click", { props: { package: pkg } });
      }
    });
  });

  const primaryBtn = document.getElementById("pricing-cta-primary");
  if (primaryBtn) {
    primaryBtn.addEventListener("click", () => {
      if (typeof window.plausible === "function") {
        window.plausible("cta_click", { props: { location: "pricing_bottom_primary" } });
      }
    });
  }

  const emailBtn = document.getElementById("pricing-cta-email");
  if (emailBtn) {
    emailBtn.addEventListener("click", () => {
      if (typeof window.plausible === "function") {
        window.plausible("email_click", { props: { location: "pricing_bottom" } });
      }
    });
  }
</script>

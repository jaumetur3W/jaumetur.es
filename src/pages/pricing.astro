---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { Icon } from "astro-icon/components";

// Paquets de serveis d'alta conversió
const packages = [
  {
    id: "landing-page",
    name: "Landing Page d'Alt Rendiment",
    icon: "bx:rocket",
    iconColor: "text-indigo-600",
    badge: "Màxima Conversió",
    badgeColor: "bg-indigo-50 text-indigo-700 border-indigo-200/80",
    description: "Webs corporatives o pàgines de llançament ultraràpides, optimitzades per convertir visites en contactes i liderar les cerques a Google.",
    targetAudience: "Startups, pimes i professionals que busquen transmetre autoritat i captar clients amb la màxima velocitat.",
    timeline: "1 a 2 setmanes",
    creationPrice: "Des de 650 €",
    monthlyFee: "45 €/mes",
    features: [
      "Desenvolupament estàtic amb Astro i Tailwind CSS v4",
      "Garantia de 100/100 a Lighthouse (Rendiment, SEO i Bones Pràctiques)",
      "Accessibilitat universal certificable WCAG 2.2 AA",
      "Optimització de SEO tècnic i metadades Open Graph per a xarxes",
      "Formulari de contacte accessible amb protecció anti-spam sense captcha",
      "Manteniment tècnic actiu inclòs (no opcional · permanència mín. 1 any)",
      "Monitoratge d'uptime, còpies de seguretat i actualitzacions de seguretat",
    ],
    ctaText: "Sol·licitar Landing Page",
  },
  {
    id: "angular-webapp",
    name: "Web App SPA amb Angular",
    icon: "simple-icons:angular",
    iconColor: "text-rose-600",
    badge: "Més Sol·licitat",
    badgeColor: "bg-rose-50 text-rose-700 border-rose-200/80",
    description: "Aplicacions web reactives, riques en interacció i pensades per a escalar, construïdes sobre els darrers estàndards d'Angular.",
    targetAudience: "Empreses tecnològiques i equips de producte que necessiten dashboards, plataformes SaaS o panells de gestió robustos.",
    timeline: "3 a 6 setmanes",
    creationPrice: "Des de 1.950 €",
    monthlyFee: "95 €/mes",
    features: [
      "Arquitectura modular moderna (Standalone Components & Signals)",
      "Tipat estricte TypeScript d'extrem a extrem sense `any`",
      "Gestió d'estat reactiva i fluida amb RxJS / Signals",
      "Integració amb APIs REST, WebSockets o plataformes Backend",
      "Suite de proves de regressió amb Vitest",
      "Manteniment tècnic continuat inclòs (no opcional · permanència mín. 1 any)",
      "Supervisió de rendiment a 60 FPS i actualitzacions del framework",
    ],
    ctaText: "Projectar Web App",
  },
  {
    id: "performance-audit",
    name: "Optimització & Accessibilitat (Audit & Fix)",
    icon: "bx:bxs-zap",
    iconColor: "text-emerald-600",
    badge: "Auditoria & Millora",
    badgeColor: "bg-emerald-50 text-emerald-700 border-emerald-200/80",
    description: "Resolució de problemes de lentitud, bloqueig de renderitzat o incompliments legals d'accessibilitat en aplicacions existents.",
    targetAudience: "Projectes web en producció amb caigudes de trànsit, queixes de lentitud o obligació de complir normatives europees (WCAG).",
    timeline: "3 a 7 dies hàbils",
    creationPrice: "Des de 450 €",
    monthlyFee: "39 €/mes",
    features: [
      "Auditoria integral de Core Web Vitals (LCP, CLS, INP) amb DevTools",
      "Inspecció d'accessibilitat profunda amb axe-core i lectors de pantalla",
      "Eliminació de codi JS innecessari i optimització de recursos crítics",
      "Correcció de contrastos de color, focus visible i semàntica HTML",
      "Informe tècnic comparatiu abans i després amb mètriques verificables",
      "Seguiment mensual de mètriques i accessibilitat (manteniment mín. 1 any)",
    ],
    ctaText: "Auditar el Meu Lloc",
  },
  {
    id: "cicd-devops",
    name: "Pipelines CI/CD & Automatització",
    icon: "bx:git-branch",
    iconColor: "text-sky-600",
    badge: "Fiabilitat DevOps",
    badgeColor: "bg-sky-50 text-sky-700 border-sky-200/80",
    description: "Eliminació d'errors manuals i automatització del cicle de vida del codi, des del git push fins a la publicació en producció.",
    targetAudience: "Equips de desenvolupament que volen accelerar els desplegaments i garantir que cap canvi trenqui la producció.",
    timeline: "2 a 5 dies hàbils",
    creationPrice: "Des de 350 €",
    monthlyFee: "35 €/mes",
    features: [
      "Pipelines automatitzats amb GitHub Actions en paral·lel",
      "Execució automàtica de linters, verificació TypeScript i tests",
      "Auditoria de Lighthouse CI que atura el build si baixen les mètriques",
      "Desplegaments continus amb previews automàtiques a cada Pull Request",
      "Configuració de dependències automatitzada amb Dependabot",
      "Supervisió contínua de pipelines i runners (manteniment mín. 1 any)",
    ],
    ctaText: "Automatitzar el Meu Flux",
  },
];

// Procés de treball en 4 passos
const workflowSteps = [
  {
    step: "01",
    title: "Descoberta & Abast",
    icon: "bx:search-alt",
    desc: "Definim conjuntament els objectius del projecte, requisits funcionals, terminis i mètriques d'èxit per oferir una proposta ajustada i transparent.",
  },
  {
    step: "02",
    title: "Arquitectura & Prototipat",
    icon: "bx:layer",
    desc: "Seleccionem la millor tecnologia, dissenyem l'estructura de components i validem la interacció per assegurar que el fonament tècnic sigui impecable.",
  },
  {
    step: "03",
    title: "Desenvolupament & Qualitat",
    icon: "bx:code-curly",
    desc: "Codi modular amb TypeScript estricte, proves unitàries i validació contínua de rendiment 60 FPS i accessibilitat WCAG AA pas a pas.",
  },
  {
    step: "04",
    title: "Desplegament & Verificació",
    icon: "bx:check-shield",
    desc: "Publicació atòmica sense caiguda de servei, auditories finals de validació i lliurament de documentació clara perquè mantinguis el control total.",
  },
];

// Preguntes Freqüents per al FAQ interactiu i Schema JSON-LD
const faqs = [
  {
    question: "Com s'estructura el pagament d'entrada i la mensualitat de manteniment?",
    answer: "Tots els projectes funcionen amb una entrada inicial (preu de creació i desenvolupament) acompanyada d'una quota mensual de manteniment tècnic actiu. Aquest manteniment no és opcional i inclou un compromís de permanència mínima d'1 any. D'aquesta manera garantim que el teu projecte es mantingui sempre ràpid, segur, actualitzat i amb suport tècnic prioritari continuat.",
  },
  {
    question: "Què inclou exactament el manteniment mensual obligatori?",
    answer: "El manteniment inclou supervisió d'uptime i monitoratge de rendiment (Lighthouse / Core Web Vitals), actualitzacions de dependències i seguretat, còpies de seguretat periòdiques, resolució d'incidències tècniques i assessorament continu per a l'evolució de la plataforma.",
  },
  {
    question: "Per què hi ha una permanència mínima d'1 any?",
    answer: "Perquè una solució web d'enginyeria requereix continuïtat tècnica per mantenir la màxima velocitat, evitar vulnerabilitats i garantir que cap canvi en navegadors o dependències trenqui el servei en producció al llarg del temps.",
  },
  {
    question: "Quin és el mètode de comunicació i seguiment?",
    answer: "Mantenim una comunicació fluïda, asíncrona i transparent mitjançant correu electrònic, Slack/Discord o WhatsApp segons la teva preferència. A més, tindràs accés directe al repositori i a un entorn de previsualització (preview deployment) per provar cada avanç abans de la publicació final.",
  },
  {
    question: "Treballes en remot o de manera presencial?",
    answer: "Tinc la base a València (Espanya), per la qual cosa puc realitzar reunions presencials a la Comunitat Valenciana i treballar en remot amb equips i clients de qualsevol punt del món.",
  },
  {
    question: "Quines garanties tècniques ofereixes en els lliuraments?",
    answer: "Tots els projectes es lliuren amb mètriques auditables de manera independent: 100/100 en auditories de Lighthouse (Rendiment, SEO, Bones pràctiques i Accessibilitat), compliment demostrable de WCAG 2.2 AA i zero errors de compilació TypeScript.",
  },
  {
    question: "Com podem començar a treballar junts?",
    answer: "Pots enviar un missatge des del formulari de contacte o enviar un correu directe a hola@jaumetur.es explicant breument què necessites. Et respondré en menys de 24 hores laborables amb preguntes d'aclariment o una data per coordinar una primera conversa.",
  },
];

// Schema JSON-LD FAQPage per a Google
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer,
    },
  })),
};
---

<Layout
  title="Serveis & Paquets de Desenvolupament Frontend | Jaume Tur"
  description="Paquets professionals de desenvolupament web a València: Landing pages ultra ràpides, aplicacions Angular modulars, optimització de rendiment 60 FPS i automatització CI/CD.">
  
  <!-- Structured Data: FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Container>
    <!-- Capçalera Principal -->
    <Sectionhead>
      <Fragment slot="title">Serveis de Desenvolupament Frontend</Fragment>
      <Fragment slot="desc">
        Col·laboració professional i transparent per a crear productes digitals fluids, robustos i accessibles des de València i en remot.
      </Fragment>
    </Sectionhead>

    <!-- Indicadors: Disponibilitat i Model de Servei -->
    <div class="flex flex-wrap items-center justify-center gap-3 -mt-6 mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-mono font-medium bg-emerald-50 text-emerald-800 border border-emerald-200/80 shadow-2xs">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span>Disponibilitat per a projectes: Activa</span>
      </div>
      <div class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-mono font-medium bg-indigo-50 text-indigo-800 border border-indigo-200/80 shadow-2xs">
        <Icon name="bx:shield-quarter" class="w-3.5 h-3.5 text-indigo-600" />
        <span>Model Entrada + Mensualitat (manteniment mín. 1 any)</span>
      </div>
    </div>

    <!-- Graella de Paquets de Serveis -->
    <div class="grid md:grid-cols-2 gap-8 max-w-6xl mx-auto">
      {
        packages.map((pkg) => (
          <div class="bg-white rounded-3xl border border-slate-200/90 p-7 sm:p-9 flex flex-col justify-between shadow-[0_4px_20px_rgba(15,23,42,0.03)] hover:border-indigo-300 hover:shadow-xl hover:shadow-indigo-500/5 transition-all duration-300 group relative">
            <div>
              <!-- Capçalera de la targeta -->
              <div class="flex items-center justify-between gap-3 mb-5">
                <div class="w-12 h-12 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-center justify-center group-hover:scale-105 transition-transform">
                  <Icon name={pkg.icon} class={`w-6 h-6 ${pkg.iconColor}`} />
                </div>
                <span class={`text-[11px] font-mono font-bold uppercase tracking-wider px-3 py-1 rounded-full border shadow-2xs ${pkg.badgeColor}`}>
                  {pkg.badge}
                </span>
              </div>

              <!-- Títol i Descripció -->
              <h3 class="text-xl sm:text-2xl font-bold text-slate-900 mb-2 group-hover:text-indigo-600 transition-colors">
                {pkg.name}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
                {pkg.description}
              </p>

              <!-- Per a qui és -->
              <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/70 mb-6 text-xs">
                <span class="font-bold text-slate-900 block mb-1 flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wider">
                  <Icon name="bx:user-check" class="w-4 h-4 text-indigo-600" />
                  <span>Per a qui és aquest servei:</span>
                </span>
                <span class="text-slate-600 leading-relaxed">
                  {pkg.targetAudience}
                </span>
              </div>

              <!-- Estructura de Preus: Entrada + Mensualitat amb manteniment -->
              <div class="p-4 rounded-2xl bg-indigo-50/60 border border-indigo-100/90 mb-6 font-mono text-xs space-y-2.5">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                  <div>
                    <span class="text-[10px] text-slate-500 uppercase tracking-wider block">Entrada / Creació</span>
                    <span class="font-bold text-indigo-950 text-sm mt-0.5 block">{pkg.creationPrice}</span>
                  </div>
                  <div>
                    <span class="text-[10px] text-slate-500 uppercase tracking-wider block">Mensualitat</span>
                    <span class="font-bold text-indigo-600 text-sm mt-0.5 block">+{pkg.monthlyFee}</span>
                  </div>
                  <div>
                    <span class="text-[10px] text-slate-500 uppercase tracking-wider block">Termini d'entrega</span>
                    <span class="font-bold text-slate-800 text-sm mt-0.5 block">{pkg.timeline}</span>
                  </div>
                </div>

                <!-- Condició de Manteniment No Opcional i Permanència Mínima -->
                <div class="pt-2 border-t border-indigo-200/60 flex items-center gap-1.5 text-[11px] text-slate-700 font-medium">
                  <Icon name="bx:shield-quarter" class="w-3.5 h-3.5 text-indigo-600 shrink-0" />
                  <span>Manteniment inclòs (no opcional · permanència mín. 1 any)</span>
                </div>
              </div>

              <!-- Llista d'Inclusions -->
              <div class="space-y-3 pt-2">
                <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400 block">
                  Què inclou exactament:
                </span>
                <ul class="space-y-2.5 text-xs text-slate-700">
                  {pkg.features.map((feature) => (
                    <li class="flex items-start gap-2.5">
                      <Icon name="bx:check" class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Botó d'Acció Directa -->
            <div class="mt-8 pt-6 border-t border-slate-100">
              <a
                href={`/contact?servei=${pkg.id}`}
                data-analytics-cta={pkg.id}
                class="w-full inline-flex items-center justify-center gap-2 py-3 px-5 rounded-xl text-xs font-bold bg-slate-900 hover:bg-indigo-600 text-white shadow-sm transition group/btn">
                <span>{pkg.ctaText}</span>
                <Icon name="bx:right-arrow-alt" class="w-4 h-4 group-hover/btn:translate-x-1 transition-transform" />
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Prova Social Real (Projectes Verificables de l'Enginyer) -->
    <div class="mt-20 max-w-5xl mx-auto">
      <div class="text-center mb-8">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-200/60">
          Prova Social & Casos Reals
        </span>
        <h3 class="text-2xl font-bold text-slate-900 mt-2">
          Projectes reals desenvolupats i verificables
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 max-w-xl mx-auto mt-1">
          Seguint el nostre compromís d'honestedat, cadascun d'aquests projectes disposa de cas d'estudi amb mètriques auditables:
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a
          href="/projectes/avisa"
          class="p-5 rounded-2xl bg-white border border-slate-200/90 hover:border-indigo-400 hover:shadow-md transition group flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <Icon name="bx:bell" class="w-6 h-6 text-rose-500" />
              <span class="text-[10px] font-mono text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded font-bold">Producció</span>
            </div>
            <h4 class="font-bold text-slate-900 text-sm group-hover:text-indigo-600 transition-colors">AVISA</h4>
            <p class="text-[11px] text-slate-500 mt-1">Plataforma d'incidències amb Angular Signals i WCAG AA.</p>
          </div>
          <span class="text-xs font-bold text-indigo-600 mt-4 flex items-center gap-1">
            <span>Veure cas d'estudi</span>
            <Icon name="bx:right-arrow-alt" class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
          </span>
        </a>

        <a
          href="/projectes/pizzeria-xativa"
          class="p-5 rounded-2xl bg-white border border-slate-200/90 hover:border-indigo-400 hover:shadow-md transition group flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <Icon name="bx:restaurant" class="w-6 h-6 text-amber-500" />
              <span class="text-[10px] font-mono text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded font-bold">En línia</span>
            </div>
            <h4 class="font-bold text-slate-900 text-sm group-hover:text-indigo-600 transition-colors">Pizzeria a Xàtiva</h4>
            <p class="text-[11px] text-slate-500 mt-1">SEO Local nº1 a Google, 85KB HTML i comandes directes.</p>
          </div>
          <span class="text-xs font-bold text-indigo-600 mt-4 flex items-center gap-1">
            <span>Veure cas d'estudi</span>
            <Icon name="bx:right-arrow-alt" class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
          </span>
        </a>

        <a
          href="/projectes/dashboard-telemetria"
          class="p-5 rounded-2xl bg-white border border-slate-200/90 hover:border-indigo-400 hover:shadow-md transition group flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <Icon name="bx:line-chart" class="w-6 h-6 text-indigo-500" />
              <span class="text-[10px] font-mono text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded font-bold">60 FPS</span>
            </div>
            <h4 class="font-bold text-slate-900 text-sm group-hover:text-indigo-600 transition-colors">Dashboard Telemetria</h4>
            <p class="text-[11px] text-slate-500 mt-1">Renderitzat fluid en temps real i estricte Core Web Vitals.</p>
          </div>
          <span class="text-xs font-bold text-indigo-600 mt-4 flex items-center gap-1">
            <span>Veure cas d'estudi</span>
            <Icon name="bx:right-arrow-alt" class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
          </span>
        </a>

        <a
          href="/projectes/pipeline-cicd"
          class="p-5 rounded-2xl bg-white border border-slate-200/90 hover:border-indigo-400 hover:shadow-md transition group flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <Icon name="bx:git-repo-forked" class="w-6 h-6 text-sky-500" />
              <span class="text-[10px] font-mono text-sky-700 bg-sky-50 px-2 py-0.5 rounded font-bold">Automàtic</span>
            </div>
            <h4 class="font-bold text-slate-900 text-sm group-hover:text-indigo-600 transition-colors">Pipeline CI/CD</h4>
            <p class="text-[11px] text-slate-500 mt-1">GitHub Actions atòmic, zero downtime i tests automàtics.</p>
          </div>
          <span class="text-xs font-bold text-indigo-600 mt-4 flex items-center gap-1">
            <span>Veure cas d'estudi</span>
            <Icon name="bx:right-arrow-alt" class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
          </span>
        </a>
      </div>

      <!-- Espai Reservat per a Testimonis Reals -->
      <div class="mt-8 p-6 rounded-3xl bg-slate-50 border border-dashed border-slate-300 text-center text-xs text-slate-500">
        <Icon name="bx:message-alt-detail" class="w-6 h-6 mx-auto mb-2 text-slate-400" />
        <span class="font-bold text-slate-700 block mb-1">
          [COMPLETAR: Espai per a testimonis reals de clients i responsables d'equip]
        </span>
        <p class="max-w-xl mx-auto text-slate-500">
          Per respecte i honestedat professional, no s'inclouen ressenyes fictícies ni logotips sense consentiment directe. Els testimonis s'afegiran conforme finalitzin els projectes contractats en curs.
        </p>
      </div>
    </div>

    <!-- Procés de Treball en 4 Fases (Amb Icones Estandarditzades) -->
    <div class="mt-20 max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-200/60">
          Metodologia & Transparència
        </span>
        <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 mt-2">
          Com treballem junts pas a pas
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 max-w-lg mx-auto mt-1">
          Un procés clar i estructurat per garantir zero sorpreses i entregues a temps.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          workflowSteps.map((ws) => (
            <div class="p-6 rounded-3xl bg-white border border-slate-200/90 shadow-2xs hover:border-indigo-300 transition-all flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="w-10 h-10 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600">
                    <Icon name={ws.icon} class="w-5 h-5" />
                  </span>
                  <span class="text-xs font-mono font-black text-slate-400">{ws.step}</span>
                </div>
                <h4 class="font-bold text-slate-900 text-base mb-2">{ws.title}</h4>
                <p class="text-xs text-slate-600 leading-relaxed">{ws.desc}</p>
              </div>
              <div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-1.5 text-[11px] font-mono text-emerald-600 font-bold">
                <Icon name="bx:check-circle" class="w-3.5 h-3.5" />
                <span>Fase verificada</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Secció de Preguntes Freqüents (FAQ Interactiu) -->
    <div class="mt-20 max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-200/60">
          FAQ & Resolució de Dubtes
        </span>
        <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 mt-2">
          Preguntes freqüents
        </h3>

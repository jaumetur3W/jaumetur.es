---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/page-header.astro";
import CtaBand from "@/components/cta-band.astro";
import { getServicesData } from "@/data/services";
import { localeFromPath, localizePath } from "@/i18n";

const locale = localeFromPath(Astro.url.pathname);
const isEn = locale === "en";
const to = (path: string) => {
  const [base, query] = path.split("?");
  const p = localizePath(base, locale);
  const normalized = p === "/" || p.endsWith("/") ? p : `${p}/`;
  return query ? `${normalized}?${query}` : normalized;
};
const services = getServicesData(locale);
const monthly = (n: number) => (isEn ? `€${n}/month` : `${n} €/mes`);
const euro = (n: number) => (isEn ? `€${n.toLocaleString("en-US")}` : `${n.toLocaleString("es-ES")} €`);

const t = isEn
  ? {
      title: "Web design services and pricing in Valencia | Jaume Tur",
      desc: "Transparent prices for websites, digital menus, landing pages, web apps, optimisation and CI/CD. From €290. Based in Xàtiva, working across Valencia and remote.",
      eyebrow: "Services & pricing",
      h1: "Web design and development prices, with clear scope.",
      lead: "Every plan has a starting price for creation plus a monthly maintenance fee (one-year minimum). You see what's included before you ask.",
      from: "From",
      deliver: "Delivery",
      forWho: "Ideal for",
      includes: "Includes",
      firstYear: "First year",
      detail: "See full detail",
      request: "Request this plan",
      recommended: "Most recommended",
      noteTitle: "How the pricing works",
      notes: [
        "Creation price: one-off payment for analysis, design, development, quality review and delivery of the code and documentation.",
        "Monthly fee: continued technical maintenance, incident follow-up, included updates and advice. Minimum commitment of one year, as stated in each offer.",
        "Final scope and timeline are agreed with you before starting.",
      ],
      ctaTitle: "Not sure which plan fits?",
      ctaText: "Tell me about your business and I'll recommend what makes sense — even if that's the smallest plan.",
      cta: "Ask for a quote",
    }
  : {
      title: "Servicios y precios de diseño web en Valencia | Jaume Tur",
      desc: "Precios transparentes de páginas web, cartas digitales, landing pages, apps web, optimización y CI/CD. Desde 290 €. Desde Xàtiva para Valencia y en remoto.",
      eyebrow: "Servicios y precios",
      h1: "Precios de diseño web y desarrollo a medida, con alcance claro.",
      lead: "Cada plan tiene un precio de creación de partida y una cuota mensual de mantenimiento (permanencia mínima de un año). Ves lo que incluye antes de pedir nada.",
      from: "Desde",
      deliver: "Entrega",
      forWho: "Ideal para",
      includes: "Incluye",
      firstYear: "Primer año",
      detail: "Ver detalle completo",
      request: "Solicitar este plan",
      recommended: "Más recomendado",
      noteTitle: "Cómo funcionan los precios",
      notes: [
        "Precio de creación: pago único por el análisis, el diseño, el desarrollo, la revisión de calidad y la entrega del código y la documentación.",
        "Cuota mensual: mantenimiento técnico continuado, seguimiento de incidencias, actualizaciones incluidas y asesoramiento. Permanencia mínima de un año, como se indica en cada oferta.",
        "El alcance final y el plazo se acuerdan contigo antes de empezar.",
      ],
      ctaTitle: "¿No sabes qué plan te encaja?",
      ctaText: "Cuéntame tu negocio y te recomiendo lo que tenga sentido, aunque sea el plan más pequeño.",
      cta: "Pedir presupuesto",
    };

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": t.eyebrow,
  "itemListElement": services.map((s, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": s.name,
    "url": `https://jaumetur.es${to(`/pricing/${s.id}`)}`,
  })),
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": isEn ? "Home" : "Inicio", "item": `https://jaumetur.es${to("/")}` },
    { "@type": "ListItem", "position": 2, "name": t.eyebrow, "item": `https://jaumetur.es${to("/pricing")}` },
  ],
};
---

<Layout fresh title={t.title} description={t.desc} jsonLd={[itemList, breadcrumb]}>
  <PageHeader title={t.h1} lede={t.lead} />

  <!-- Tabla de tarifas: todo el precio de un vistazo -->
  <section class="section pb-2" aria-labelledby="table-title">
    <div class="wrap">
      <h2 id="table-title" class="sr-only">{isEn ? "Price table" : "Tabla de precios"}</h2>
      <div class="glass overflow-x-auto !rounded-[1.25rem] !p-0">
        <table class="w-full min-w-[46rem] border-collapse text-left text-[0.95rem]">
          <caption class="sr-only">{isEn ? "Services with creation price, monthly fee, delivery time and first-year total" : "Servicios con precio de creación, cuota mensual, plazo y total del primer año"}</caption>
          <thead>
            <tr class="border-b-[1.5px] border-ink bg-brand">
              <th scope="col" class="px-4 py-3 font-mono text-[0.72rem] font-bold uppercase tracking-wider">{isEn ? "Service" : "Servicio"}</th>
              <th scope="col" class="px-4 py-3 text-right font-mono text-[0.72rem] font-bold uppercase tracking-wider">{t.from}</th>
              <th scope="col" class="px-4 py-3 text-right font-mono text-[0.72rem] font-bold uppercase tracking-wider">{isEn ? "Maintenance" : "Mantenimiento"}</th>
              <th scope="col" class="px-4 py-3 font-mono text-[0.72rem] font-bold uppercase tracking-wider">{t.deliver}</th>
              <th scope="col" class="px-4 py-3 text-right font-mono text-[0.72rem] font-bold uppercase tracking-wider">{t.firstYear}</th>
              <th scope="col" class="px-4 py-3"><span class="sr-only">{t.request}</span></th>
            </tr>
          </thead>
          <tbody>
            {services.map((s) => (
              <tr class="border-b border-ink/25 last:border-b-0 hover:bg-brand/25">
                <th scope="row" class="px-4 py-3.5 font-bold">
                  <a href={to(`/pricing/${s.id}`)} class="link-arrow">{s.name}</a>
                  {s.isFeatured && <span class="tag ml-2 align-middle">{t.recommended}</span>}
                </th>
                <td class="num whitespace-nowrap px-4 py-3.5 text-right font-display text-[1.25rem]">{euro(s.creationPriceNumber)}</td>
                <td class="num whitespace-nowrap px-4 py-3.5 text-right font-semibold">{monthly(s.monthlyFeeNumber)}</td>
                <td class="px-4 py-3.5">{s.timeline}</td>
                <td class="num whitespace-nowrap px-4 py-3.5 text-right font-semibold">{euro(s.creationPriceNumber + 12 * s.monthlyFeeNumber)}</td>
                <td class="px-4 py-3 text-right"><a href={to(`/contact?servei=${s.id}`)} class="btn btn-brand btn-sm">{isEn ? "Quote" : "Presupuesto"}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Fichas: qué incluye cada plan -->
  <section class="section" aria-labelledby="fichas-title">
    <div class="wrap">
      <h2 id="fichas-title" class="h-section mb-6">{isEn ? "What each plan includes" : "Qué incluye cada plan"}</h2>
      <div class="cat-grid sm:grid-cols-2 lg:grid-cols-3" data-stagger>
        {services.map((s, i) => (
          <article class="flex flex-col p-5 sm:p-6">
            <div class="flex items-start justify-between gap-3">
              <p class="label">{isEn ? "Plan" : "Plan"} {String(i + 1).padStart(2, "0")}</p>
              {s.isFeatured && <span class="tag">{t.recommended}</span>}
            </div>
            <h3 class="mt-3 font-display text-[1.35rem] uppercase leading-[1.02]">{s.name}</h3>
            <p class="num mt-4 font-display text-[2.4rem] leading-none"><span class="label mr-1.5 align-middle">{t.from}</span><span class="hl">{euro(s.creationPriceNumber)}</span></p>
            <p class="muted mt-2 text-[0.88rem]">{monthly(s.monthlyFeeNumber)} · {s.timeline}</p>
            <ul class="mt-5 grid gap-2">
              {s.features.slice(0, 5).map((f) => (
                <li class="flex gap-2.5 text-[0.9rem] leading-snug">
                  <svg class="mt-[0.2em] h-4 w-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square" aria-hidden="true"><path d="M2.5 8.5l3.5 3.5 7.5-8"></path></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <p class="faint mt-4 text-[0.82rem]"><span class="font-semibold text-ink">{t.forWho}:</span> {s.targetAudience}</p>
            <div class="mt-auto flex flex-wrap gap-2 pt-5">
              <a href={to(`/contact?servei=${s.id}`)} class="btn btn-brand btn-sm">{t.request}</a>
              <a href={to(`/pricing/${s.id}`)} class="btn btn-white btn-sm">{t.detail}</a>
            </div>
          </article>
        ))}
        <div class="flex flex-col justify-between p-5 sm:p-6" style="background:var(--brand)">
          <p class="font-display text-[1.35rem] uppercase leading-[1.02]">{t.ctaTitle}</p>
          <p class="mt-2 text-[0.92rem] leading-snug">{t.ctaText}</p>
          <a href={to("/contact")} class="btn btn-dark btn-sm mt-5 self-start">{t.cta} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="how-title">
    <div class="wrap">
      <h2 id="how-title" class="h-section max-w-3xl">{t.noteTitle}</h2>
      <ul class="mt-10 grid gap-x-10 gap-y-8 md:grid-cols-3">
        {t.notes.map((n) => (
          <li class="glass p-5"><p class="max-w-sm text-[0.95rem]">{n}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand
    title={t.ctaTitle}
    text={t.ctaText}
    primary={{ href: to("/contact"), label: t.cta }}
    secondary={{ href: "https://wa.me/34644525838?text=Hola%20Jaume,%20quiero%20informaci%C3%B3n%20sobre%20los%20planes%20de%20dise%C3%B1o%20web", label: isEn ? "Ask on WhatsApp" : "Preguntar por WhatsApp", external: true }}
  />
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { Icon } from "astro-icon/components";

const services = [
  {
    name: "Desenvolupament Frontend SPA",
    icon: "simple-icons:angular",
    iconColor: "text-red-500",
    badge: "Més Sol·licitat",
    badgeColor: "bg-indigo-600 text-white",
    btnTheme: "bg-indigo-600 hover:bg-indigo-700 text-white shadow-xs",
    features: [
      "Aplicacions completes amb Angular o React",
      "Tipat estricte amb TypeScript",
      "Disseny 100% responsive i modern",
      "Accessibilitat WCAG AA garantida",
      "Integració fluïda amb REST APIs",
      "Arquitectura de components modular",
    ],
  },
  {
    name: "Optimització & Refactorització",
    icon: "bx:bxs-zap",
    iconColor: "text-emerald-500",
    badge: "Rendiment",
    badgeColor: "bg-slate-900 text-white",
    btnTheme: "bg-white hover:bg-slate-50 text-slate-800 border border-slate-200/90 hover:border-slate-800 shadow-2xs",
    features: [
      "Auditoria de rendiment (Core Web Vitals)",
      "Objectiu 60 FPS i renderitzat fluid",
      "Migració de JavaScript a TypeScript",
      "Neteja d'arquitectura de codi",
      "Millora de SEO tècnic i semàntica",
      "Informe complet de millores",
    ],
  },
  {
    name: "Arquitectura CI/CD & DevOps",
    icon: "bx:git-repo-forked",
    iconColor: "text-blue-500",
    badge: "Automatització",
    badgeColor: "bg-slate-900 text-white",
    btnTheme: "bg-slate-900 hover:bg-indigo-600 text-white shadow-xs",
    features: [
      "Pipelines automatitzats amb GitHub Actions",
      "Configuració de Linters i tests de validació",
      "Desplegament continu a Vercel / GitHub Pages",
      "Arquitectura Trigger & Executor",
      "Sense interrupcions de servei",
      "Documentació de manteniment",
    ],
  },
];
---

<Layout
  title="Serveis de Desenvolupament Web a València | Freelance Frontend"
  description="Serveis professionals de desenvolupament web a València i en remot: aplicacions SPA amb Angular i TypeScript, auditoria de rendiment 60 FPS i automatització CI/CD.">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Serveis de Desenvolupament Web a València</Fragment>
      <Fragment slot="desc">
        Desenvolupador web freelance a València i en remot: modalitats de treball per a projectes frontend amb Angular, consultoria d'arquitectura i automatització de processos CI/CD.
      </Fragment>
    </Sectionhead>

    <!-- Services Grid: Standardized Icons -->
    <div class="grid md:grid-cols-3 gap-6 mx-auto max-w-6xl mt-12">
      {
        services.map((s) => (
          <div class="bg-white rounded-3xl border border-slate-200/90 p-6 sm:p-8 flex flex-col justify-between shadow-[0_1px_3px_0_rgba(15,23,42,0.04)] hover:border-indigo-300 hover:shadow-xl hover:shadow-indigo-500/5 transition-all duration-300 group">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="w-10 h-10 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-center transform-gpu group-hover:scale-110 transition-transform">
                  <Icon name={s.icon} class={`w-5 h-5 ${s.iconColor}`} />
                </span>
                <span class={`text-[10px] font-mono font-bold uppercase tracking-wider px-2.5 py-1 rounded-full shadow-2xs ${s.badgeColor}`}>
                  {s.badge}
                </span>
              </div>
              
              <h3 class="text-xl font-bold text-slate-900 mb-4 group-hover:text-indigo-600 transition-colors">
                {s.name}
              </h3>

              <ul class="space-y-3 text-xs text-slate-600 pt-3 border-t border-slate-100">
                {s.features.map((f) => (
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5 select-none" aria-hidden="true">✓</span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-8 pt-5 border-t border-slate-100">
              <a
                href="/contact"
                class={`w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs font-bold transition group/btn ${s.btnTheme}`}>
                <Icon name="bx:message-square-dots" class="w-4 h-4 group-hover/btn:scale-110 transition-transform" />
                <span>Sol·licitar proposta</span>
                <span class="text-[11px] font-mono">↗</span>
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Career Callout Banner: Dark Tech Surface (#090D16) -->
    <div class="mt-16 bg-[#090D16] text-white rounded-3xl p-8 sm:p-10 max-w-4xl mx-auto border border-slate-800/90 shadow-xl flex flex-col sm:flex-row items-center justify-between gap-6 group">
      <div class="space-y-2 text-center sm:text-left">
        <span class="text-xs font-mono font-bold text-emerald-400 bg-emerald-950/80 px-2.5 py-0.5 rounded-full border border-emerald-800/80 flex items-center gap-1.5 w-max">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>INCORPORACIÓ DISPONIBLE</span>
        </span>
        <h4 class="text-xl font-bold flex items-center gap-2">
          <span>Busques un Desenvolupador Frontend per al teu equip?</span>
          <Icon name="bx:briefcase" class="w-4 h-4 text-emerald-400" />
        </h4>
        <p class="text-xs text-slate-300 max-w-lg">
          Obert a posicions a jornada completa o col·laboracions en modalitat remota o híbrida des de València.
        </p>
      </div>

      <div class="flex gap-3 shrink-0">
        <a
          href="/docs/CV_Jaume_tur.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="group/cv inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-white text-slate-900 text-xs font-bold hover:bg-slate-100 transition shadow-xs">
          <Icon name="bx:file" class="w-3.5 h-3.5 group-hover/cv:-translate-y-0.5 transition-transform" />
          <span>CV PDF</span>
          <span class="text-[10px] text-slate-400 font-mono">↗</span>
        </a>
        <a
          href="/contact"
          class="group/c inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-indigo-600 text-white text-xs font-bold hover:bg-indigo-700 transition shadow-sm">
          <Icon name="bx:message-square-dots" class="w-3.5 h-3.5 group-hover/c:scale-110 transition-transform" />
          <span>Contactar</span>
        </a>
      </div>
    </div>
  </Container>
</Layout>

---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import { getServicesData } from "@/data/services";
import { localeFromPath, localizePath } from "@/i18n";

const locale = localeFromPath(Astro.url.pathname);
const isEn = locale === "en";
const to = (path: string) => {
  const p = localizePath(path, locale);
  return p === "/" || p.endsWith("/") ? p : `${p}/`;
};
const services = getServicesData(locale);
const monthly = (n: number) => (isEn ? `€${n}/month` : `${n} €/mes`);
const euro = (n: number) => (isEn ? `€${n.toLocaleString("en-US")}` : `${n.toLocaleString("es-ES")} €`);

const t = isEn
  ? {
      title: "Web design services and pricing in Valencia | Jaume Tur",
      desc: "Transparent prices for websites, digital menus, landing pages, web apps, optimisation and CI/CD. From €290. Based in Xàtiva, working across Valencia and remote.",
      eyebrow: "Services & pricing",
      h1: "Clear prices. Clear scope. No surprises.",
      lead: "Every plan has a starting price for creation plus a monthly maintenance fee (one-year minimum). You see what's included before you ask.",
      from: "From",
      deliver: "Delivery",
      forWho: "Ideal for",
      includes: "Includes",
      firstYear: "First year",
      detail: "See full detail",
      request: "Request this plan",
      recommended: "Most recommended",
      noteTitle: "How the pricing works",
      notes: [
        "Creation price: one-off payment for analysis, design, development, quality review and delivery of the code and documentation.",
        "Monthly fee: continued technical maintenance, incident follow-up, included updates and advice. Minimum commitment of one year, as stated in each offer.",
        "Final scope and timeline are agreed with you before starting.",
      ],
      ctaTitle: "Not sure which plan fits?",
      ctaText: "Tell me about your business and I'll recommend what makes sense — even if that's the smallest plan.",
      cta: "Ask for a quote",
    }
  : {
      title: "Servicios y precios de diseño web en Valencia | Jaume Tur",
      desc: "Precios transparentes de páginas web, cartas digitales, landing pages, apps web, optimización y CI/CD. Desde 290 €. Desde Xàtiva para Valencia y en remoto.",
      eyebrow: "Servicios y precios",
      h1: "Precios claros. Alcance claro. Sin sorpresas.",
      lead: "Cada plan tiene un precio de creación de partida y una cuota mensual de mantenimiento (permanencia mínima de un año). Ves lo que incluye antes de pedir nada.",
      from: "Desde",
      deliver: "Entrega",
      forWho: "Ideal para",
      includes: "Incluye",
      firstYear: "Primer año",
      detail: "Ver detalle completo",
      request: "Solicitar este plan",
      recommended: "Más recomendado",
      noteTitle: "Cómo funcionan los precios",
      notes: [
        "Precio de creación: pago único por el análisis, el diseño, el desarrollo, la revisión de calidad y la entrega del código y la documentación.",
        "Cuota mensual: mantenimiento técnico continuado, seguimiento de incidencias, actualizaciones incluidas y asesoramiento. Permanencia mínima de un año, como se indica en cada oferta.",
        "El alcance final y el plazo se acuerdan contigo antes de empezar.",
      ],
      ctaTitle: "¿No sabes qué plan te encaja?",
      ctaText: "Cuéntame tu negocio y te recomiendo lo que tenga sentido, aunque sea el plan más pequeño.",
      cta: "Pedir presupuesto",
    };

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": t.eyebrow,
  "itemListElement": services.map((s, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": s.name,
    "url": `https://jaumetur.es${to(`/pricing/${s.id}`)}`,
  })),
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": isEn ? "Home" : "Inicio", "item": `https://jaumetur.es${to("/")}` },
    { "@type": "ListItem", "position": 2, "name": t.eyebrow, "item": `https://jaumetur.es${to("/pricing")}` },
  ],
};
---

<Layout fresh title={t.title} description={t.desc} jsonLd={[itemList, breadcrumb]}>
  <section class="border-b border-white/10 bg-gradient-to-b from-[#111118] to-[#070709] px-4 pb-16 pt-16 sm:px-6 sm:pt-24">
    <div class="mx-auto max-w-(--breakpoint-xl)">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 class="display mt-4 max-w-4xl text-[clamp(2.5rem,6.5vw,4.8rem)] text-white">{t.h1}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/80">{t.lead}</p>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto grid max-w-(--breakpoint-xl) gap-8 lg:grid-cols-2">
      {services.map((s) => (
        <article class:list={[
          "card flex flex-col overflow-hidden border transition-all duration-300",
          s.isFeatured ? "border-brand/70 bg-gradient-to-br from-[#161622] via-[#0f0f15] to-[#08080c] lg:col-span-2 shadow-[0_0_35px_-5px_rgba(255,255,0,0.2)]" : "border-white/10 bg-surface hover:border-brand/40"
        ]}>
          <div class:list={["grid flex-1", s.isFeatured ? "lg:grid-cols-12" : ""]}>
            <div class:list={["p-7 sm:p-10", s.isFeatured ? "lg:col-span-7" : ""]}>
              <div class="flex flex-wrap items-center gap-3">
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand/15 text-brand">
                  <Icon name={s.icon} class="h-6 w-6" />
                </span>
                {s.isFeatured && (
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-brand px-3 py-0.5 text-xs font-bold text-black shadow-xs">
                    <Icon name="bx:star" class="h-3.5 w-3.5" />
                    {t.recommended}
                  </span>
                )}
              </div>
              <h2 class="mt-5 font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">{s.name}</h2>
              <p class="mt-3 text-base leading-relaxed text-ink/80">{s.tagline}</p>
              <p class="mt-4 text-xs font-medium text-white/60"><strong>{t.forWho}:</strong> {s.targetAudience}</p>
              
              <h3 class="mt-7 font-mono text-xs font-bold uppercase tracking-wider text-brand">{t.includes}</h3>
              <ul class="mt-3 space-y-2">
                {s.features.map((f) => (
                  <li class="flex items-start gap-2.5 text-sm text-white/90">
                    <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-brand text-[10px] font-black text-black" aria-hidden="true">✓</span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class:list={[
              "flex flex-col justify-between gap-6 border-t border-white/10 bg-black/60 p-7 sm:p-10",
              s.isFeatured ? "lg:col-span-5 lg:border-l lg:border-t-0" : ""
            ]}>
              <div>
                <p class="font-mono text-xs font-bold uppercase tracking-widest text-brand">{t.from}</p>
                <p class="display mt-1 text-5xl font-black text-white">{euro(s.creationPriceNumber)}</p>
                <p class="mt-2 text-sm text-ink/75">+ {monthly(s.monthlyFeeNumber)} de mantenimiento continuo</p>
                
                <dl class="mt-6 space-y-2 border-t border-white/10 pt-4 text-xs text-white/70">
                  <div class="flex justify-between"><dt class="text-white/50">{t.deliver}:</dt> <dd class="font-semibold text-white">{s.timeline}</dd></div>
                  <div class="flex justify-between"><dt class="text-white/50">{t.firstYear}:</dt> <dd class="font-semibold text-white">{s.annualTotal}</dd></div>
                </dl>
              </div>

              <div class="flex flex-wrap gap-3">
                <a href={to("/contact")} class="btn btn-brand btn-sm flex-1 text-center justify-center">{t.request}</a>
                <a href={to(`/pricing/${s.id}`)} class="btn btn-white btn-sm">{t.detail}</a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="border-y border-white/10 bg-[#09090d] px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-(--breakpoint-xl)">
      <h2 class="display text-[clamp(1.8rem,4vw,3rem)] text-white">{t.noteTitle}</h2>
      <ul class="mt-8 grid gap-5 md:grid-cols-3">
        {t.notes.map((n, i) => (
          <li class="card border border-white/10 bg-surface p-6">
            <span class="display text-3xl font-extrabold text-brand">0{i + 1}</span>
            <p class="mt-3 text-sm leading-relaxed text-ink/80">{n}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="relative overflow-hidden px-4 py-20 text-center sm:px-6 sm:py-28">
    <div class="pointer-events-none absolute left-1/2 top-1/2 h-[22rem] w-[46rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/15 blur-[120px]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl">
      <h2 class="display text-[clamp(2rem,5vw,3.6rem)] text-white">{t.ctaTitle}</h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-ink/80">{t.ctaText}</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href={to("/contact")} class="btn btn-brand">{t.cta} <span aria-hidden="true">→</span></a>
        <a href="https://wa.me/34644525838?text=Hola%20Jaume,%20quiero%20informaci%C3%B3n%20sobre%20los%20planes%20de%20dise%C3%B1o%20web" target="_blank" rel="noopener noreferrer" class="btn btn-white inline-flex items-center gap-2">
          <Icon name="bx:bxl-whatsapp" class="h-4 w-4 text-emerald-400" />
          <span>Preguntar por WhatsApp</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

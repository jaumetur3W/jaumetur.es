---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { Icon } from "astro-icon/components";
import { localeFromPath, localizePath } from "@/i18n";

const locale = localeFromPath(Astro.url.pathname);
const isEn = locale === "en";
const href = (path: string) => localizePath(path, locale);

const pillars = isEn
  ? [
      {
        title: "Backend & Architecture",
        icon: "bx:server",
        points: [
          "Scalable REST APIs and robust services with Node.js and TypeScript",
          "Design and administration of relational and document databases",
          "Clean architecture, defense-in-depth security, and system integrations",
        ],
      },
      {
        title: "Systems & Servers (SMX)",
        icon: "bx:chip",
        points: [
          "Linux server administration and local network infrastructure",
          "Preventive maintenance, hardware diagnostics, and workstation assembly",
          "Network configuration, firewall security, and automated backups",
        ],
      },
      {
        title: "Frontend & Web Apps (DAW)",
        icon: "bx:layout",
        points: [
          "Modular single-page applications with Angular, React, and TypeScript",
          "Smooth 60 FPS performance and strict WCAG AA accessibility",
          "Automated deployment pipelines with GitHub Actions and CI/CD",
        ],
      },
    ]
  : [
      {
        title: "Backend y arquitectura",
        icon: "bx:server",
        points: [
          "API REST escalables y servicios robustos con Node.js y TypeScript",
          "Diseño y gestión de bases de datos SQL y NoSQL",
          "Arquitectura limpia, seguridad e integración de sistemas",
        ],
      },
      {
        title: "Sistemas y servidores (SMX)",
        icon: "bx:chip",
        points: [
          "Administración de servidores Linux y entornos de red",
          "Mantenimiento preventivo, diagnóstico y montaje de equipos",
          "Configuración de redes locales, seguridad y copias de seguridad",
        ],
      },
      {
        title: "Frontend y aplicaciones web (DAW)",
        icon: "bx:layout",
        points: [
          "Aplicaciones SPA modulares con Angular y TypeScript",
          "Rendimiento fluido a 60 FPS y accesibilidad WCAG AA",
          "Despliegues automatizados con GitHub Actions y CI/CD",
        ],
      },
    ];

const highlights = [
  {
    icon: "bx:bxs-graduation",
    label: isEn ? "EDUCATION" : "FORMACIÓN",
    val: "CFGS DAW + GM SMX",
    color: "border-slate-200/90 bg-slate-50 text-slate-800",
  },
  {
    icon: "bx:map-pin",
    label: isEn ? "LOCATION" : "UBICACIÓN",
    val: isEn ? "Valencia, Spain (and remote)" : "Xàtiva / Valencia (y remoto)",
    color: "border-slate-200/90 bg-slate-50 text-slate-800",
  },
  {
    icon: "bx:server",
    label: isEn ? "SPECIALTY" : "ESPECIALIDAD",
    val: isEn ? "Web development, apps & backend" : "Desarrollo web, aplicaciones y backend",
    color: "border-indigo-200/90 bg-indigo-50 text-indigo-900",
  },
  {
    icon: "bx:check-circle",
    label: isEn ? "AVAILABILITY" : "DISPONIBILIDAD",
    val: isEn ? "Projects & collaborations" : "Proyectos y colaboraciones",
    color: "border-emerald-200 bg-emerald-50 text-emerald-800",
  },
];
---

<Layout
  title={isEn ? "About Me — Web & Application Developer in Valencia" : "Sobre mí — Desarrollador Web en Xàtiva y Valencia"}
  description={isEn ? "Career, education, and technical background of Jaume Tur: web developer, custom applications, and backend systems in Valencia." : "Trayectoria, formación y enfoque de Jaume Tur: desarrollador de páginas web, aplicaciones a medida y sistemas desde Xàtiva y Valencia."}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">{isEn ? "About Me" : "Sobre mí"}</Fragment>
      <Fragment slot="desc">{isEn ? "Technical journey, official certifications, and practical web engineering approach." : "Trayectoria técnica, formación oficial y enfoque práctico de desarrollo web."}</Fragment>
    </Sectionhead>

    <!-- Main Profile Card with Memoji 1.png -->
    <div class="mt-14 bg-white rounded-2xl border border-slate-200 p-6 sm:p-10 relative pt-12 sm:pt-14 group transition-colors hover:border-slate-400">
      
      <div class="flex flex-col md:flex-row items-center gap-8 lg:gap-12">
        
        <!-- Memoji 1.png -->
        <div class="shrink-0 flex flex-col items-center -mt-16 sm:-mt-24 relative z-20 group/memoji">
          <div class="relative">
            <div class="absolute inset-0 bg-indigo-500/15 rounded-full blur-2xl group-hover/memoji:scale-105 transition-transform"></div>
            
            <img
              src="/img/1.webp"
              alt="Jaume Tur"
              class="relative w-56 h-56 sm:w-64 sm:h-64 lg:w-72 lg:h-72 object-contain drop-shadow-[0_16px_28px_rgba(15,23,42,0.20)] group-hover/memoji:-translate-y-2 transition-transform duration-200"
              width="288"
              height="288"
              loading="eager"
              fetchpriority="high"
            />
          </div>

          <span class="relative -mt-4 inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/80 shadow-md">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>{isEn ? "Available for projects" : "Disponible para proyectos"}</span>
          </span>
        </div>

        <div class="flex-1 text-left">
          <div class="inline-flex items-center gap-1.5 text-xs font-mono font-bold uppercase tracking-wider text-indigo-700 bg-indigo-50 px-2.5 py-0.5 rounded-md mb-2 border border-indigo-200/60">
            <Icon name="bx:terminal" class="w-3.5 h-3.5" />
            <span>{isEn ? "Backend & Systems · Web Applications" : "Backend y sistemas · Aplicaciones web"}</span>
          </div>

          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
            Jaume Tur
          </h2>

          <p class="text-base text-slate-600 mt-3 leading-relaxed">
            {isEn ? (
              <>I am a software developer based in <strong>Valencia, Spain</strong>, specializing in <strong>web development, custom applications, and backend systems</strong>. My official certification in <strong>Microcomputer Systems and Networks (SMX)</strong> provides me with deep expertise in servers, networking, and infrastructure reliability, which I complement with the <strong>Higher Technical Certificate in Web Application Development (DAW)</strong> to design and build ultra-fast websites, reactive interfaces, and robust backend services for local businesses and remote engineering teams.</>
            ) : (
              <>Soy desarrollador de software afincado en <strong>Xàtiva (Valencia)</strong>, especializado en <strong>desarrollo web, aplicaciones a medida y sistemas</strong>. Mi titulación de <strong>Grado Medio en Sistemas Microinformáticos y Redes (SMX)</strong> me aporta un dominio sólido de servidores, redes y fiabilidad, que complemento con el <strong>CFGS en Desarrollo de Aplicaciones Web (DAW)</strong> para diseñar y programar páginas rápidas, interfaces reactivas y servicios backend robustos para negocios locales o empresas en remoto.</>
            )}
          </p>

          <!-- Visual highlights pills -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-6">
            {highlights.map((h) => (
              <div class={`p-3 rounded-xl border ${h.color} shadow-2xs flex items-start gap-3 hover:-translate-y-0.5 transition-transform`}>
                <div class="w-8 h-8 rounded-lg bg-slate-200/50 flex items-center justify-center shrink-0 text-slate-700 mt-0.5">
                  <Icon name={h.icon} class="w-4 h-4" />
                </div>
                <div>
                  <span class="block text-[10px] font-mono font-bold uppercase tracking-wider opacity-70">
                    {h.label}
                  </span>
                  <span class="font-bold text-sm mt-0.5 block leading-tight">
                    {h.val}
                  </span>
                </div>
              </div>
            ))}
          </div>

          <!-- Quick action buttons -->
          <div class="flex flex-wrap items-center gap-3 mt-6 pt-6 border-t border-slate-100">
            <a
              href="/docs/CV_Jaume_tur.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="group/btn inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs hover:bg-indigo-600 transition shadow-xs">
              <Icon name="bx:file" class="w-4 h-4 text-white group-hover/btn:-translate-y-0.5 transition-transform" />
              <span>{isEn ? "Download Full Resume (PDF)" : "Descargar CV completo (PDF)"}</span>
              <span class="text-[11px] font-mono text-slate-400">↗</span>
            </a>
            <a
              href="https://github.com/jaumetur3W"
              target="_blank"
              rel="noopener noreferrer"
              class="group/gh inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl border border-slate-200 font-bold text-xs text-slate-800 bg-white hover:bg-slate-50 hover:border-slate-800 transition shadow-2xs"
              title={isEn ? "Code repositories on GitHub" : "Repositorios de código en GitHub"}>
              <Icon name="bx:bxl-github" class="w-4 h-4 text-slate-900 group-hover/gh:scale-110 transition-transform" />
              <span>GitHub</span>
              <span class="text-[10px] text-slate-400 font-mono">↗</span>
            </a>
            <a
              href="https://www.linkedin.com/in/jautur/"
              target="_blank"
              rel="noopener noreferrer"
              class="group/li inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl border border-indigo-200 font-bold text-xs text-indigo-700 bg-indigo-50/50 hover:bg-indigo-100 transition shadow-2xs"
              title={isEn ? "Professional profile on LinkedIn" : "Trayectoria profesional en LinkedIn"}>
              <Icon name="bx:bxl-linkedin" class="w-4 h-4 text-indigo-600 group-hover/li:scale-110 transition-transform" />
              <span>LinkedIn</span>
              <span class="text-[10px] text-indigo-400 font-mono">↗</span>
            </a>
            <a
              href={href("/contact")}
              class="group/c inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-200/90 font-bold text-xs text-slate-700 bg-white hover:bg-slate-50 transition shadow-2xs">
              <Icon name="bx:message-square-dots" class="w-4 h-4 text-slate-700 group-hover/c:scale-110 transition-transform" />
              <span>{isEn ? "Contact" : "Contactar"}</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- 3 Pillars Section -->
    <div class="mt-16">
      <div class="text-center max-w-xl mx-auto mb-10">
        <span class="text-xs font-mono uppercase tracking-wider text-indigo-700 font-bold bg-indigo-50 px-3 py-1 rounded-full border border-indigo-200/80 flex items-center justify-center gap-1.5 w-max mx-auto">
          <Icon name="bx:compass" class="w-3.5 h-3.5 text-indigo-700" />
          <span>{isEn ? "Engineering Principles" : "Principios de ingeniería"}</span>
        </span>
        <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 mt-2.5">
          {isEn ? "How I approach every project" : "Cómo enfoco cada proyecto"}
        </h3>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {
          pillars.map((pillar) => (
            <div class="bg-white rounded-2xl border border-slate-200 p-6 hover:border-slate-400 transition-colors flex flex-col justify-between group">
              <div>
                <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 bg-indigo-50 border border-indigo-200/60 shadow-2xs group-hover:scale-110 transition-transform text-indigo-600">
                  <Icon name={pillar.icon} class="w-6 h-6" />
                </div>
                <h4 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-indigo-600 transition-colors">
                  {pillar.title}
                </h4>
                <ul class="space-y-2.5 text-xs text-slate-600">
                  {pillar.points.map((pt) => (
                    <li class="flex items-start gap-2.5">
                      <span class="text-emerald-600 font-bold shrink-0 mt-0.5 select-none" aria-hidden="true">✓</span>
                      <span>{pt}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Technical Architecture Visual Card -->
    <div class="mt-16 bg-[#090D16] text-white rounded-3xl p-6 sm:p-10 border border-slate-800/90 shadow-xl relative overflow-visible group">
      <div class="flex flex-col md:flex-row items-center gap-8 justify-between">
        <div class="space-y-3 max-w-xl">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-400/30">
            <Icon name="bx:bxs-zap" class="w-3.5 h-3.5 text-indigo-300" />
            <span>{isEn ? "Software Architecture" : "Arquitectura de software"}</span>
          </span>
          <h3 class="text-2xl font-bold tracking-tight text-white">
            {isEn ? "Trigger / Executor Event Pattern" : "Patrón disparador y ejecutor (Trigger / Executor)"}
          </h3>
          <p class="text-slate-300 text-sm leading-relaxed">
            {isEn
              ? "Event-driven software development: autonomous triggers (webhooks, git push) dispatch typed JSON payloads to automated validation, static analysis, and atomic deployment pipelines, eliminating human error."
              : "Desarrollo orientado a eventos: los disparadores autónomos (webhooks, git push) envían datos JSON a los procesos de validación, análisis estático y despliegue automático, reduciendo los errores humanos."}
          </p>
        </div>

        <!-- Memoji 7.png -->
        <div class="shrink-0 flex flex-col items-center -mb-8 sm:-mb-14 relative z-20 group/memoji">
          <div class="relative">
            <img
              src="/img/7.webp"
              alt="Jaume Tur"
              class="relative w-44 h-44 sm:w-52 sm:h-52 object-contain drop-shadow-[0_16px_32px_rgba(0,0,0,0.5)] group-hover/memoji:-translate-y-1 group-hover/memoji:scale-105 transition-transform duration-200"
              width="208"
              height="208"
              loading="lazy"
              decoding="async"
            />
          </div>
          <span class="relative -mt-3 text-xs font-mono text-slate-300 font-medium bg-slate-900 border border-slate-700/80 px-3 py-1 rounded-full shadow-lg flex items-center gap-1.5">
            <Icon name="bx:code-alt" class="w-3.5 h-3.5 text-indigo-400" />
            <span>{isEn ? "Reliable Code & CI/CD" : "Código fiable y CI/CD"}</span>
          </span>
        </div>
      </div>
    </div>

  </Container>
</Layout>

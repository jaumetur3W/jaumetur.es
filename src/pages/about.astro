---
import Layout from "@/layouts/Layout.astro";
import CtaBand from "@/components/cta-band.astro";
import { localeFromPath, localizePath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
const to = (path: string) => {
  const p = localizePath(path, isEn ? "en" : "es");
  return p === "/" || p.endsWith("/") ? p : `${p}/`;
};

const facts = [
  { label: isEn ? "Education" : "Formación", val: "CFGS DAW + GM SMX" },
  { label: isEn ? "Location" : "Ubicación", val: isEn ? "Xàtiva / Valencia (and remote)" : "Xàtiva / Valencia (y remoto)" },
  { label: isEn ? "Languages" : "Idiomas", val: isEn ? "Valencian, Spanish, English (basic)" : "Valenciano, castellano, inglés (básico)" },
  { label: isEn ? "Availability" : "Disponibilidad", val: isEn ? "Immediate start" : "Incorporación inmediata" },
];

// Experiencia laboral (datos del CV)
const experience = isEn
  ? [
      {
        period: "Aug – Oct 2025", role: "IT technician", org: "Conecta Servicios Informáticos",
        points: [
          "Maintenance, diagnosis and repair of computers and mobile devices.",
          "Basic administration of server services and direct technical support to customers.",
          "Improved the support procedures, which shortened response times and raised user satisfaction.",
        ],
      },
    ]
  : [
      {
        period: "Ago – Oct 2025", role: "Técnico informático", org: "Conecta Servicios Informáticos",
        points: [
          "Mantenimiento, diagnóstico y reparación de equipos informáticos y dispositivos móviles.",
          "Administración básica de servicios en servidores y atención técnica directa a clientes.",
          "Mejora de los procedimientos de soporte, que redujo los tiempos de respuesta y elevó la satisfacción del usuario.",
        ],
      },
    ];

// Formación (datos del CV)
const education = isEn
  ? [
      {
        period: "Sep 2023 – present", title: "Higher Technical Certificate in Web Application Development (DAW)", org: "IES Dr. Lluís Simarro, Xàtiva",
        points: [
          "Modern languages and frameworks: Java, PHP, JavaScript, SQL, HTML, CSS, Spring Boot and Angular.",
          "Software architecture, responsive interface design and relational database optimisation (MySQL).",
          "Version control, application deployment and agile methodologies in team and personal projects.",
        ],
      },
      {
        period: "Sep 2021 – Jun 2023", title: "Intermediate Certificate in Microcomputer Systems and Networks (SMX)", org: "IES Dr. Lluís Simarro, Xàtiva",
        points: [
          "Installation, configuration and maintenance of operating systems, hardware and local networks.",
          "Solid experience in technical support, computer assembly and efficient incident resolution.",
        ],
      },
    ]
  : [
      {
        period: "Sep 2023 – actualidad", title: "CFGS en Desarrollo de Aplicaciones Web (DAW)", org: "IES Dr. Lluís Simarro, Xàtiva",
        points: [
          "Lenguajes y frameworks actuales: Java, PHP, JavaScript, SQL, HTML, CSS, Spring Boot y Angular.",
          "Arquitectura de software, diseño de interfaces responsive y optimización de bases de datos relacionales (MySQL).",
          "Control de versiones, despliegue de aplicaciones y metodologías ágiles en proyectos colaborativos y personales.",
        ],
      },
      {
        period: "Sep 2021 – Jun 2023", title: "Grado Medio en Sistemas Microinformáticos y Redes (SMX)", org: "IES Dr. Lluís Simarro, Xàtiva",
        points: [
          "Instalación, configuración y mantenimiento de sistemas operativos, hardware y redes locales.",
          "Experiencia sólida en soporte técnico, ensamblaje de equipos y resolución eficiente de incidencias.",
        ],
      },
    ];

const built = isEn
  ? [
      { id: "avisa", name: "Avisa", text: "My DAW final project. A PWA built with Angular and a Spring Boot backend where people post a job and receive quotes for services and home repairs." },
      { id: "trania", name: "TranIA", text: "A management platform for gyms and trainers: members, classes, billing and adaptive training plans. React and Vite on the front, Python and FastAPI behind." },
      { id: "worksy", name: "Worksy", text: "A business platform that gathers HR, calendars, Kanban tasks and corporate mail in one place, planned as a multi-tenant SaaS with React, Node.js and PostgreSQL." },
      { id: "", name: "Websites for local businesses", text: "Digital menus, restaurant sites and a country estate site, with local SEO, accessibility and fast loading from day one." },
    ]
  : [
      { id: "avisa", name: "Avisa", text: "Mi proyecto final del CFGS DAW. Una PWA en Angular con backend en Spring Boot donde se publica un trabajo y se reciben presupuestos de servicios y reformas." },
      { id: "trania", name: "TranIA", text: "Una plataforma de gestión para gimnasios y entrenadores: socios, clases, facturación y planes de entrenamiento adaptativos. React y Vite delante, Python y FastAPI detrás." },
      { id: "worksy", name: "Worksy", text: "Una plataforma empresarial que reúne RR. HH., calendarios, tareas Kanban y correo corporativo en un solo sitio, planteada como SaaS multi-tenant con React, Node.js y PostgreSQL." },
      { id: "", name: "Webs para negocios locales", text: "Cartas digitales, webs de hostelería y de una finca rural, con SEO local, accesibilidad y carga rápida desde el primer día." },
    ];

const stack = isEn
  ? [
      { group: "Frontend", items: ["Angular", "React", "Astro", "TypeScript", "JavaScript", "HTML", "CSS", "Tailwind CSS"] },
      { group: "Backend", items: ["Java and Spring Boot", "Node.js", "Python and FastAPI", "PHP", "REST APIs"] },
      { group: "Databases", items: ["MySQL", "PostgreSQL", "Neon", "CRUD and query optimisation"] },
      { group: "Systems and deployment", items: ["Linux", "nginx", "Git and GitHub", "GitHub Actions", "Google Cloud", "Docker", "Render"] },
      { group: "Systems and support", items: ["Operating systems", "Hardware", "Local networks", "Debugging"] },
    ]
  : [
      { group: "Frontend", items: ["Angular", "React", "Astro", "TypeScript", "JavaScript", "HTML", "CSS", "Tailwind CSS"] },
      { group: "Backend", items: ["Java y Spring Boot", "Node.js", "Python y FastAPI", "PHP", "API REST"] },
      { group: "Datos", items: ["MySQL", "PostgreSQL", "Neon", "CRUD y optimización de consultas"] },
      { group: "Sistemas y despliegue", items: ["Linux", "nginx", "Git y GitHub", "GitHub Actions", "Google Cloud", "Docker", "Render"] },
      { group: "Sistemas y soporte", items: ["Sistemas operativos", "Hardware", "Redes locales", "Depuración de código"] },
    ];

const pillars = isEn
  ? [
      { title: "Backend & architecture", points: ["Scalable REST APIs and robust services with Node.js and TypeScript", "Design and management of SQL and NoSQL databases", "Clean architecture, security and systems integration"] },
      { title: "Systems & servers (SMX)", points: ["Linux server administration and network environments", "Preventive maintenance, diagnostics and workstation assembly", "Local network setup, security and backups"] },
      { title: "Frontend & web apps (DAW)", points: ["Modular SPA applications with Angular and TypeScript", "Smooth 60 FPS performance and WCAG AA accessibility", "Automated deployments with GitHub Actions and CI/CD"] },
    ]
  : [
      { title: "Backend y arquitectura", points: ["API REST escalables y servicios robustos con Node.js y TypeScript", "Diseño y gestión de bases de datos SQL y NoSQL", "Arquitectura limpia, seguridad e integración de sistemas"] },
      { title: "Sistemas y servidores (SMX)", points: ["Administración de servidores Linux y entornos de red", "Mantenimiento preventivo, diagnóstico y montaje de equipos", "Configuración de redes locales, seguridad y copias de seguridad"] },
      { title: "Frontend y aplicaciones web (DAW)", points: ["Aplicaciones SPA modulares con Angular y TypeScript", "Rendimiento fluido a 60 FPS y accesibilidad WCAG AA", "Despliegues automatizados con GitHub Actions y CI/CD"] },
    ];

const t = isEn
  ? {
      title: "About Jaume Tur — web developer in Xàtiva and Valencia",
      desc: "Jaume Tur is a web and application developer from Xàtiva (Valencia) with a DAW higher certificate and an SMX certificate. Experience, education, projects, skills and how he works.",
      h1: "Jaume Tur, web developer in Xàtiva and Valencia.",
      bio: "IT technician and web application developer with a consolidated background in full-stack development, systems maintenance and database management. I build websites, custom applications and the server that keeps them running, for local businesses and remote teams.",
      cv: "Download CV (PDF)", contact: "Get in touch", avail: "Available for projects",
      storyTitle: "My story",
      story: [
        "I started with the hardware and the network. I studied the intermediate certificate in Microcomputer Systems and Networks (SMX) at IES Dr. Lluís Simarro, in Xàtiva: assembling computers, setting up local networks, administering operating systems and solving incidents. That base is why I care so much that a website loads fast, stays secure and does not go down.",
        "In 2023 I moved to the Higher Technical Certificate in Web Application Development (DAW), at the same school. There I worked with Java and Spring Boot, JavaScript and TypeScript, Angular, MySQL, version control and team projects. My final project, Avisa, comes from that stage.",
        "Today I put both halves together. I design and program the application, and I deploy and maintain it myself. This website, Avisa and TranIA run on my own Google Cloud server, with automatic deployment from GitHub Actions every time I merge a change.",
        "I am passionate about technology and focused on efficient, scalable solutions. I am looking for an opportunity to apply what I know, keep growing professionally and take on new challenges in real environments.",
      ],
      expTitle: "Work experience",
      eduTitle: "Education",
      builtTitle: "What I have built", builtAll: "See all projects", builtOpen: "View project",
      stackTitle: "Technical skills",
      pillarsTitle: "How I approach every project",
      softTitle: "Personal skills",
      soft: [
        "Effective communication, proactivity and teamwork.",
        "Analytical and practical approach to solving incidents.",
        "Strong organisation, responsibility and attention to detail.",
        "Quick learner, adapting fast to new technologies and dynamic environments.",
      ],
      moreTitle: "Other information",
      more: [
        { label: "Languages", val: "Valencian and Spanish (native). English at a basic level (A2), which I am currently improving." },
        { label: "Certifications", val: "Office suite certification (LibreOffice and Microsoft 365)." },
      ],
    }
  : {
      title: "Sobre Jaume Tur — desarrollador web en Xàtiva y Valencia",
      desc: "Jaume Tur es desarrollador web y de aplicaciones en Xàtiva (Valencia), con CFGS DAW y Grado Medio SMX. Experiencia, formación, proyectos, habilidades y forma de trabajar.",
      h1: "Jaume Tur, desarrollador web en Xàtiva y Valencia.",
      bio: "Técnico informático y desarrollador de aplicaciones web, con formación consolidada en desarrollo full-stack, mantenimiento de sistemas y gestión de bases de datos. Hago páginas web, aplicaciones a medida y el servidor que las mantiene en marcha, para negocios locales y equipos en remoto.",
      cv: "Descargar CV (PDF)", contact: "Contactar", avail: "Disponible para proyectos",
      storyTitle: "Mi historia",
      story: [
        "Empecé por el hardware y la red. Estudié el Grado Medio en Sistemas Microinformáticos y Redes (SMX) en el IES Dr. Lluís Simarro, en Xàtiva: montar ordenadores, configurar redes locales, administrar sistemas operativos y resolver incidencias. Esa base explica por qué me importa tanto que una web cargue rápido, sea segura y no se caiga.",
        "En 2023 pasé al CFGS en Desarrollo de Aplicaciones Web (DAW), en el mismo centro. Allí trabajé con Java y Spring Boot, JavaScript y TypeScript, Angular, MySQL, control de versiones y proyectos en equipo. De esa etapa sale mi proyecto final, Avisa.",
        "Hoy junto las dos mitades. Diseño y programo la aplicación, y yo mismo la despliego y la mantengo. Esta web, Avisa y TranIA funcionan en un servidor propio de Google Cloud, con despliegue automático desde GitHub Actions cada vez que acepto un cambio.",
        "Me apasiona la tecnología y me enfoco en soluciones eficientes y escalables. Busco una oportunidad en la que aportar lo que sé, seguir creciendo profesionalmente y afrontar nuevos retos en entornos reales.",
      ],
      expTitle: "Experiencia laboral",
      eduTitle: "Formación académica",
      builtTitle: "Lo que he construido", builtAll: "Ver todos los proyectos", builtOpen: "Ver proyecto",
      stackTitle: "Aptitudes técnicas",
      pillarsTitle: "Cómo enfoco cada proyecto",
      softTitle: "Aptitudes personales",
      soft: [
        "Comunicación efectiva, proactividad y trabajo en equipo.",
        "Enfoque analítico y práctico para la resolución de incidencias.",
        "Alta capacidad de organización, responsabilidad y atención al detalle.",
        "Aprendizaje rápido y rápida adaptación a nuevas tecnologías y entornos dinámicos.",
      ],
      moreTitle: "Otros datos de interés",
      more: [
        { label: "Idiomas", val: "Valenciano y castellano (nativos). Inglés de nivel básico (A2), que sigo ampliando." },
        { label: "Certificaciones", val: "Certificación en ofimática (LibreOffice y Microsoft 365)." },
      ],
    };
---

<Layout fresh title={t.title} description={t.desc}>
  <header class="relative pt-28 pb-14 sm:pt-32 sm:pb-18 lg:pt-36">
    <div class="wrap">
      <p class="chip chip-brand"><span class="h-2 w-2 rounded-full bg-[#111111]" aria-hidden="true"></span>{t.avail}</p>
      <h1 class="h-page mt-6 max-w-4xl font-extrabold tracking-tight text-ink" data-split>{t.h1}</h1>
      <p class="lede mt-6 text-lg sm:text-xl text-ink/80 leading-relaxed !max-w-3xl">{t.bio}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={to("/contact")} class="btn btn-dark !min-h-[3.25rem] !px-7 font-extrabold">{t.contact} <span aria-hidden="true">→</span></a>
        <a href="/docs/CV_Jaume_tur.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-white !min-h-[3.25rem] !px-7 font-bold">{t.cv}<span class="sr-only"> ({isEn ? "opens in a new tab" : "se abre en pestaña nueva"})</span></a>
      </div>
    </div>
    <div class="section-divider mt-10 sm:mt-14" data-divider aria-hidden="true"><div class="divider-line"></div></div>
  </header>

  <section class="border-b border-ink/20" aria-label={isEn ? "Key facts" : "Datos clave"}>
    <dl class="wrap grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
      {facts.map((f) => (
        <div class="border-b border-ink/20 py-6 last:border-b-0 sm:pr-6 lg:border-b-0">
          <dt class="label">{f.label}</dt>
          <dd class="mt-1 font-display text-[1.35rem] font-bold leading-tight">{f.val}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section" aria-labelledby="story-title">
    <div class="wrap grid gap-8 lg:grid-cols-12 lg:gap-14">
      <h2 id="story-title" class="h-section lg:col-span-4">{t.storyTitle}</h2>
      <div class="grid gap-5 text-lg leading-relaxed text-ink/80 lg:col-span-8">
        {t.story.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section border-t border-ink/20" aria-labelledby="exp-title">
    <div class="wrap grid gap-8 lg:grid-cols-12 lg:gap-14">
      <h2 id="exp-title" class="h-section lg:col-span-4">{t.expTitle}</h2>
      <ol class="grid gap-10 lg:col-span-8">
        {experience.map((e) => (
          <li class="border-t-2 border-ink pt-5">
            <p class="label">{e.period}</p>
            <h3 class="mt-1 font-display text-[1.5rem] font-bold leading-tight">{e.role}</h3>
            <p class="muted font-semibold">{e.org}</p>
            <ul class="muted mt-4 grid gap-2 leading-snug">
              {e.points.map((pt) => <li class="flex gap-3"><span class="text-ink" aria-hidden="true">–</span><span>{pt}</span></li>)}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section border-t border-ink/20" aria-labelledby="edu-title">
    <div class="wrap grid gap-8 lg:grid-cols-12 lg:gap-14">
      <h2 id="edu-title" class="h-section lg:col-span-4">{t.eduTitle}</h2>
      <ol class="grid gap-10 lg:col-span-8">
        {education.map((e) => (
          <li class="border-t-2 border-ink pt-5">
            <p class="label">{e.period}</p>
            <h3 class="mt-1 font-display text-[1.5rem] font-bold leading-tight">{e.title}</h3>
            <p class="muted font-semibold">{e.org}</p>
            <ul class="muted mt-4 grid gap-2 leading-snug">
              {e.points.map((pt) => <li class="flex gap-3"><span class="text-ink" aria-hidden="true">–</span><span>{pt}</span></li>)}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section border-t border-ink/20" aria-labelledby="built-title">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="built-title" class="h-section max-w-3xl">{t.builtTitle}</h2>
        <a href={to("/projectes")} class="link-arrow min-h-11">{t.builtAll} <span aria-hidden="true">→</span></a>
      </div>
      <div class="mt-10 grid gap-x-10 gap-y-12 md:grid-cols-2">
        {built.map((b) => (
          <article class="border-t-2 border-ink pt-5">
            <h3 class="font-display text-[1.6rem] font-bold leading-tight">{b.name}</h3>
            <p class="muted mt-3 leading-snug">{b.text}</p>
            {b.id && (
              <a href={to(`/projectes/${b.id}`)} class="link-arrow mt-4 min-h-11">
                {t.builtOpen}<span class="sr-only">: {b.name}</span> <span aria-hidden="true">→</span>
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section border-t border-ink/20" aria-labelledby="stack-title">
    <div class="wrap grid gap-8 lg:grid-cols-12 lg:gap-14">
      <h2 id="stack-title" class="h-section lg:col-span-4">{t.stackTitle}</h2>
      <dl class="grid gap-6 lg:col-span-8">
        {stack.map((s) => (
          <div>
            <dt class="label">{s.group}</dt>
            <dd class="mt-2">
              <ul class="flex flex-wrap gap-2">
                {s.items.map((i) => <li class="rounded-full border border-ink/30 px-3.5 py-1.5 text-[0.95rem] font-semibold leading-none">{i}</li>)}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section border-t border-ink/20" aria-labelledby="how-title">
    <div class="wrap">
      <h2 id="how-title" class="h-section max-w-3xl">{t.pillarsTitle}</h2>
      <div class="mt-10 grid gap-x-10 gap-y-12 md:grid-cols-3">
        {pillars.map((p) => (
          <article class="border-t-2 border-ink pt-5">
            <h3 class="font-display text-[1.6rem] font-bold leading-tight">{p.title}</h3>
            <ul class="muted mt-4 grid gap-2.5 leading-snug">
              {p.points.map((pt) => <li class="flex gap-3"><span class="text-ink" aria-hidden="true">–</span><span>{pt}</span></li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section border-t border-ink/20" aria-labelledby="soft-title">
    <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <h2 id="soft-title" class="h-section">{t.softTitle}</h2>
        <ul class="muted mt-8 grid gap-3 leading-snug">
          {t.soft.map((s) => <li class="flex gap-3"><span class="text-ink" aria-hidden="true">–</span><span>{s}</span></li>)}
        </ul>
      </div>
      <div class="lg:col-span-7">
        <h2 class="h-section">{t.moreTitle}</h2>
        <dl class="mt-8 grid gap-6 sm:grid-cols-2">
          {t.more.map((m) => (
            <div class="border-t-2 border-ink pt-4">
              <dt class="label">{m.label}</dt>
              <dd class="mt-1 leading-snug text-ink/80">{m.val}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <CtaBand
    title={isEn ? "Have a project in mind?" : "¿Tienes un proyecto en mente?"}
    text={isEn ? "Tell me what you need and I will reply with scope, price and timeline." : "Cuéntame qué necesitas y te respondo con alcance, precio y plazo."}
    primary={{ href: to("/contact"), label: t.contact }}
    secondary={{ href: to("/pricing"), label: isEn ? "Services & pricing" : "Servicios y precios" }}
  />
</Layout>

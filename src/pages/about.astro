---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { Icon } from "astro-icon/components";

const pillars = [
  {
    title: "Frontend Modern",
    icon: "bx:bxs-window-alt",
    points: ["Components modulars amb Angular", "Tipat segur i estricte amb TypeScript", "Maquetació responsive i semàntica"],
  },
  {
    title: "Qualitat & Rendiment",
    icon: "bx:bxs-badge-check",
    points: ["Sense errors en temps d'execució", "Compliment estricte de WCAG AA", "Objectiu de renderitzat fluid a 60 FPS"],
  },
  {
    title: "CI/CD & DevOps",
    icon: "bx:bxs-bot",
    points: ["Pipelines automatitzats a GitHub Actions", "Linters estàtics i verificacions contínues", "Desplegaments continus i segurs"],
  },
];

const highlights = [
  { label: "ESTUDIS", val: "CFGS Desenvolupament Web (DAW)", color: "border-slate-200/90 bg-slate-50 text-slate-800" },
  { label: "UBICACIÓ", val: "València (Híbrid / Remot)", color: "border-slate-200/90 bg-slate-50 text-slate-800" },
  { label: "ESPECIALITAT", val: "Arquitectura Frontend SPA", color: "border-slate-200/90 bg-slate-50 text-slate-800" },
  { label: "DISPONIBILITAT", val: "Incorporació immediata", color: "border-emerald-200 bg-emerald-50 text-emerald-800" },
];
---

<Layout title="Sobre mi">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Sobre mi</Fragment>
      <Fragment slot="desc">Trajectòria, principis d'enginyeria i enfocament professional.</Fragment>
    </Sectionhead>

    <!-- Main Profile Card with Memoji 1.png: Unified Surface Palette -->
    <div class="mt-14 bg-white rounded-3xl border border-slate-200/90 p-6 sm:p-10 shadow-[0_1px_3px_0_rgba(15,23,42,0.04)] relative pt-12 sm:pt-14">
      
      <div class="flex flex-col md:flex-row items-center gap-8 lg:gap-12">
        
        <!-- Memoji 1.png - Overlapping with natural contact shadow -->
        <div class="shrink-0 flex flex-col items-center -mt-16 sm:-mt-24 relative z-20 group">
          <div class="relative">
            <div class="absolute inset-0 bg-indigo-500/15 rounded-full blur-2xl group-hover:scale-105 transition-transform"></div>
            
            <img
              src="/memojis/1.png"
              alt="Jaume Tur somrient"
              class="relative w-56 h-56 sm:w-64 sm:h-64 lg:w-72 lg:h-72 object-contain drop-shadow-[0_16px_28px_rgba(15,23,42,0.20)] group-hover:scale-105 transition-transform duration-300"
              width="288"
              height="288"
            />
          </div>

          <span class="relative -mt-4 inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/80 shadow-md">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Disponible per a projectes
          </span>
        </div>

        <div class="flex-1 text-left">
          <div class="inline-flex items-center gap-1.5 text-xs font-mono font-bold uppercase tracking-wider text-indigo-700 bg-indigo-50 px-2.5 py-0.5 rounded-md mb-2 border border-indigo-200/60">
            Desenvolupador Web · Frontend
          </div>

          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
            Jaume Tur
          </h2>

          <p class="text-base text-slate-600 mt-3 leading-relaxed">
            Passió pel desenvolupament frontend estructurat, les interfícies intuïtives i l'automatització. Compromès amb el codi net, la maquetació semàntica i els processos fiables d'entrega de programari.
          </p>

          <!-- Visual highlights pills -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-6">
            {highlights.map((h) => (
              <div class={`p-3 rounded-xl border ${h.color} shadow-2xs`}>
                <span class="block text-[10px] font-mono font-bold uppercase tracking-wider opacity-70">
                  {h.label}
                </span>
                <span class="font-bold text-sm mt-0.5 block">
                  {h.val}
                </span>
              </div>
            ))}
          </div>

          <!-- Quick action buttons -->
          <div class="flex flex-wrap items-center gap-3 mt-6 pt-6 border-t border-slate-100">
            <a
              href="/docs/CV_Jaume_tur.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs hover:bg-indigo-600 transition shadow-xs">
              <Icon name="bx:bxs-cloud-download" class="w-4 h-4" />
              Descarregar CV Complet (PDF) ↗
            </a>
            <a
              href="/contact"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-200/90 font-bold text-xs text-slate-700 bg-white hover:bg-slate-50 transition shadow-2xs">
              Contactar
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- 3 Pillars Section: Unified Surface Grid -->
    <div class="mt-16">
      <div class="text-center max-w-xl mx-auto mb-10">
        <span class="text-xs font-mono uppercase tracking-wider text-indigo-700 font-bold bg-indigo-50 px-3 py-1 rounded-full border border-indigo-200/80">
          Principis d'Enginyeria
        </span>
        <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 mt-2.5">
          Com enfocament cada projecte
        </h3>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {
          pillars.map((pillar) => (
            <div class="bg-white rounded-2xl border border-slate-200/90 p-6 shadow-[0_1px_3px_0_rgba(15,23,42,0.04)] hover:border-indigo-300 hover:shadow-md transition-all flex flex-col justify-between">
              <div>
                <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 bg-indigo-50 border border-indigo-200/60 text-indigo-600 shadow-2xs">
                  <Icon name={pillar.icon} class="w-6 h-6 text-indigo-600" />
                </div>
                <h4 class="text-lg font-bold text-slate-900 mb-3">
                  {pillar.title}
                </h4>
                <ul class="space-y-2.5 text-xs text-slate-600">
                  {pillar.points.map((pt) => (
                    <li class="flex items-start gap-2.5">
                      <Icon name="bx:bxs-check-circle" class="w-4 h-4 shrink-0 text-indigo-600 mt-0.5" />
                      <span>{pt}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Technical Architecture Visual Card: Dark Tech Surface (#090D16) -->
    <div class="mt-16 bg-[#090D16] text-white rounded-3xl p-6 sm:p-10 border border-slate-800/90 shadow-xl relative overflow-visible">
      <div class="flex flex-col md:flex-row items-center gap-8 justify-between">
        <div class="space-y-3 max-w-xl">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-400/30">
            Arquitectura de Software
          </span>
          <h3 class="text-2xl font-bold tracking-tight text-white">
            Patró Disparador & Executor (Trigger / Executor)
          </h3>
          <p class="text-slate-300 text-sm leading-relaxed">
            Desenvolupament orientat a esdeveniments: disparadors autònoms (webhooks, git push) que transmeten càrregues JSON a executors de validació, linters i desplegament automàtic sense fallades humanes.
          </p>
        </div>

        <!-- Memoji 7.png Overlapping -->
        <div class="shrink-0 flex flex-col items-center -mb-8 sm:-mb-14 relative z-20 group">
          <div class="relative">
            <img
              src="/memojis/7.png"
              alt="Jaume Tur programant"
              class="relative w-44 h-44 sm:w-52 sm:h-52 object-contain drop-shadow-[0_16px_32px_rgba(0,0,0,0.5)] group-hover:scale-105 transition-transform duration-300"
              width="208"
              height="208"
            />
          </div>
          <span class="relative -mt-3 text-xs font-mono text-slate-300 font-medium bg-slate-900 border border-slate-700/80 px-3 py-0.5 rounded-full shadow-lg">
            Codi fiable & CI/CD
          </span>
        </div>
      </div>
    </div>

  </Container>
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { localeFromPath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
---

<Layout
  title={isEn ? "Legal notice and site owner details | Jaume Tur" : "Aviso legal y datos del titular | Jaume Tur"}
  description={isEn ? "Legal information, ownership and terms of use of jaumetur.es, the website of web developer Jaume Tur in Xàtiva (Valencia)." : "Información legal, titularidad y condiciones de uso de jaumetur.es, la web del desarrollador web Jaume Tur en Xàtiva (València)."}
>
  <Container class="py-12 max-w-3xl">
    <Sectionhead>
      <Fragment slot="title">{isEn ? "Legal Notice" : "Aviso legal"}</Fragment>
      <Fragment slot="desc">
        {isEn ? "Information in compliance with Spanish Law 34/2002 (LSSI-CE)." : "Información general en cumplimiento de la Ley 34/2002 (LSSI-CE)."}
      </Fragment>
    </Sectionhead>

    <div class="mt-10 space-y-8 text-[1rem] text-graphite leading-relaxed">
      <section class="space-y-3">
        <h2 class="h-card !text-[1.4rem]">{isEn ? "1. Ownership" : "1. Datos identificativos"}</h2>
        <p>
          {isEn
            ? "In accordance with article 10 of Law 34/2002, of July 11, on Information Society Services and Electronic Commerce (LSSI-CE), the user is informed that this website (jaumetur.es) is owned and operated by Jaume Tur, independent software developer based in Valencia, Spain. Contact email: jaumetur3w@gmail.com."
            : "En cumplimiento del artículo 10 de la Ley 34/2002, de 11 de julio, de Servicios de la Sociedad de la Información y de Comercio Electrónico (LSSI-CE), se informa de que este sitio web (jaumetur.es) es titularidad de Jaume Tur, desarrollador web y de software independiente ubicado en Valencia, España. Correo electrónico de contacto: jaumetur3w@gmail.com."}
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="h-card !text-[1.4rem]">{isEn ? "2. Purpose of the Website" : "2. Finalidad del sitio web"}</h2>
        <p>
          {isEn
            ? "The purpose of this website is to showcase professional software engineering services, real case studies, technical documentation, and contact channels for client proposals."
            : "La finalidad de este sitio web es la difusión de servicios profesionales de desarrollo web, aplicaciones a medida, casos de estudio técnicos y canales de contacto para la solicitud de presupuestos y colaboraciones."}
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="h-card !text-[1.4rem]">{isEn ? "3. Intellectual Property" : "3. Propiedad intelectual"}</h2>
        <p>
          {isEn
            ? "The source code of public projects and repositories is licensed under their respective open-source terms. The textual and visual content published by Jaume Tur belongs to its author and cannot be reproduced without explicit attribution."
            : "El código fuente de los proyectos de código abierto se rige por sus respectivas licencias en GitHub. Los textos, artículos y contenidos de autoría de Jaume Tur pertenecen a su autor y no pueden ser reproducidos con fines comerciales sin autorización o atribución expresa."}
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="h-card !text-[1.4rem]">{isEn ? "4. Applicable Law" : "4. Legislación aplicable"}</h2>
        <p>
          {isEn
            ? "Relations between the owner of the website and users are governed by Spanish regulations, submitting any dispute to the Courts and Tribunals of the Valencian Community."
            : "Las relaciones entre el titular del sitio web y las personas usuarias se rigen por la normativa española, sometiéndose cualquier controversia a los Juzgados y Tribunales competentes de la Comunidad Valenciana."}
        </p>
      </section>
    </div>
  </Container>
</Layout>


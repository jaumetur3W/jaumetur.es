---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { localeFromPath } from "@/i18n";

const isEn = localeFromPath(Astro.url.pathname) === "en";
---

<Layout
  title={isEn ? "Cookies Policy | Jaume Tur" : "Política de cookies | Jaume Tur"}
  description={isEn ? "Information about cookies and privacy on jaumetur.es. 100% cookie-free and tracking-free." : "Información sobre cookies y privacidad en jaumetur.es. Sitio 100% libre de cookies y rastreo."}
>
  <Container class="py-12 max-w-3xl">
    <Sectionhead>
      <Fragment slot="title">{isEn ? "Cookies Policy" : "Política de cookies"}</Fragment>
      <Fragment slot="desc">
        {isEn ? "Complete transparency: this website operates without tracking cookies." : "Transparencia absoluta: este sitio web funciona sin cookies de seguimiento."}
      </Fragment>
    </Sectionhead>

    <div class="mt-10 space-y-8 text-sm text-zinc-300 leading-relaxed font-light">
      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-white font-sans">{isEn ? "1. No Tracking Cookies" : "1. Sin cookies de seguimiento ni publicidad"}</h2>
        <p>
          {isEn
            ? "jaumetur.es does not use advertising cookies, remarketing pixels, or third-party profiling scripts. We believe in high performance and privacy by default, which is why we do not interrupt your navigation with cookie consent banners."
            : "jaumetur.es no utiliza cookies publicitarias, ni píxeles de remarketing ni scripts de perfilado de terceros. Apostamos por el máximo rendimiento técnico y la privacidad por defecto, motivo por el cual no interrumpimos tu navegación con molestos banners de consentimiento."}
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-white font-sans">{isEn ? "2. Privacy-Friendly Analytics" : "2. Analítica ética sin cookies"}</h2>
        <p>
          {isEn
            ? "We measure website visits and key technical conversions using Plausible Analytics. Plausible is completely cookie-free, operates under strict European GDPR standards, and does not store any persistent personal identifiers."
            : "La medición de visitas y conversiones técnicas clave se realiza a través de Plausible Analytics. Plausible funciona en modo 100% libre de cookies, opera bajo los estándares del RGPD europeo y no almacena identificadores personales persistentes."}
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-white font-sans">{isEn ? "3. Browser Controls" : "3. Control en el navegador"}</h2>
        <p>
          {isEn
            ? "You can configure your browser to block or alert you about the storage of cookies on any website. Because this website does not store cookies, no data will be written to your local storage for tracking purposes."
            : "Puedes configurar tu navegador en cualquier momento para bloquear o eliminar el almacenamiento de cookies en cualquier web. Dado que este sitio no instala cookies de seguimiento, no se registra ningún archivo en tu dispositivo con fines publicitarios."}
        </p>
      </section>
    </div>
  </Container>
</Layout>


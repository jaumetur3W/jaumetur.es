---
import Container from "@/components/container.astro";
import { getFormattedDate } from "@/utils/all";
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title}>
  <div class="px-5 py-12">
    <Container>
      <div class="mx-auto max-w-[760px] mt-8">
        <span class="inline-flex items-center gap-1.5 px-3 py-1  text-xs font-mono font-bold bg-brand text-ink border border-ink  tracking-wider">
          {frontmatter.category}
        </span>
        <h1
          class="display text-3xl sm:text-4xl lg:text-5xl font-bold text-ink tracking-tight mt-4 leading-tight">
          {frontmatter.title}
        </h1>
        <div class="flex gap-2 mt-4 items-center flex-wrap text-xs font-mono text-graphite">
          <span class="text-ink font-medium">
            {frontmatter.author}
          </span>
          <span>•</span>
          <time datetime={frontmatter.publishDate}>
            {getFormattedDate(frontmatter.publishDate)}
          </time>
          {frontmatter.tags && (
            <>
              <span class="hidden md:inline">•</span>
              <div class="flex flex-wrap gap-2">
                {frontmatter.tags.map((tag: string) => (
                  <span class="text-graphite">#{tag}</span>
                ))}
              </div>
            </>
          )}
        </div>
      </div>

      <div class="mx-auto prose prose-headings:font-display prose-headings:text-ink prose-p:text-graphite prose-a:text-ink prose-pre:bg-paper-2 prose-pre:border prose-pre:border-rule prose-strong:text-ink max-w-[760px] mt-8">
        <slot />
      </div>

      <div class="text-center mt-12 mb-8">
        <a
          href="/blog"
          class="btn btn-white btn-sm px-6"
        >
          ← Volver al blog
        </a>
      </div>
    </Container>
  </div>
</Layout>

---
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import EasterEggs from "@/components/easter-eggs.astro";
import { SETUP_IMAGE_SIZES, setupSrcset } from "@/config/setup-scene";
import { alternatePaths, localeFromPath } from "@/i18n";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  publishDate?: Date | string;
  author?: string;
  tags?: string[];
  lang?: string;
  canonicalURL?: string;
  isBlogPost?: boolean;
  /** Private page: not indexed and without hreflang alternates. */
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/opengraph.jpg",
  publishDate,
  author = "Jaume Tur",
  tags = [],
  lang,
  canonicalURL: customCanonical,
  isBlogPost = false,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://jaumetur.es";
const locale = localeFromPath(Astro.url.pathname);
const isEn = locale === "en";
const resolvedDescription = description || (isEn
  ? "Professional web development, custom applications, backend architecture, and process automation based in Valencia. High-speed, robust digital solutions."
  : "Desarrollo de páginas web profesionales, aplicaciones a medida, backend y automatización en Xàtiva y Valencia. Soluciones rápidas y adaptadas a tu negocio.");
const activeLang = lang || (isEn ? "en" : "es");
const alternatePathsForPage = alternatePaths(Astro.url.pathname);

const ensureTrailingSlash = (urlStr: string) => {
  const url = new URL(urlStr, siteUrl);
  if (!url.pathname.endsWith("/") && !url.pathname.includes(".") && !/\.[a-z0-9]+$/i.test(url.pathname)) {
    url.pathname = `${url.pathname}/`;
  }
  return url.toString();
};

const is404 = Astro.url.pathname.includes("404");
const shouldNoIndex = noindex || is404 || Astro.url.pathname.includes("/en/blog");

const spanishURL = ensureTrailingSlash(new URL(alternatePathsForPage.es, siteUrl).toString());
const englishURL = ensureTrailingSlash(new URL(alternatePathsForPage.en, siteUrl).toString());
const canonicalURL = ensureTrailingSlash(customCanonical || new URL(Astro.url.pathname, siteUrl).toString());
const resolvedImageWithDomain = new URL(image, siteUrl).toString();

// Dynamic, keyword-rich title generation
const TITLE_MAX = 60;
const DESCRIPTION_MAX = 158;
const BRAND_SUFFIX = " | Jaume Tur";

const shortenAtBoundary = (text: string, max: number) => {
  if (text.length <= max) return text;
  const cut = text.slice(0, max);
  const separator = Math.max(
    cut.lastIndexOf(": "),
    cut.lastIndexOf(", "),
    cut.lastIndexOf(" — "),
    cut.lastIndexOf(" – "),
    cut.lastIndexOf(" - "),
  );
  const end = separator >= 25 ? separator : cut.lastIndexOf(" ");
  return cut.slice(0, end > 0 ? end : max).replace(/[\s,:;—–-]+$/, "");
};

const buildSeoTitle = (rawTitle: string) => {
  const core = rawTitle.replace(/\s*[|—–-]\s*Jaume Tur$/, "");
  return core.length + BRAND_SUFFIX.length <= TITLE_MAX
    ? `${core}${BRAND_SUFFIX}`
    : shortenAtBoundary(core, TITLE_MAX);
};

const isHome = !title || title === "Inici" || title === "Inicio" || title === "Home";
const makeTitle = isHome
  ? isEn
    ? "Web Development & Custom Apps in Valencia | Jaume Tur"
    : "Desarrollo web a medida en Xàtiva y Valencia | Jaume Tur"
  : buildSeoTitle(title);

const shortenDescription = (text: string) => {
  if (text.length <= DESCRIPTION_MAX) return text;
  const cut = text.slice(0, DESCRIPTION_MAX - 1);
  const sentenceEnd = cut.lastIndexOf(". ");
  const end = sentenceEnd >= 90 ? sentenceEnd : cut.lastIndexOf(" ");
  return `${cut.slice(0, end > 0 ? end : cut.length).replace(/[\s.,:;]+$/, "")}…`;
};
const metaDescription = shortenDescription(resolvedDescription);

// JSON-LD Structured Data
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}/#person`,
  "name": "Jaume Tur",
  "givenName": "Jaume",
  "familyName": "Tur",
  "jobTitle": isEn ? "Web & Application Developer | Backend & Systems" : "Desarrollador Web y Aplicaciones a Medida | Backend y Sistemas",
  "email": "jaumetur3w@gmail.com",
  "url": siteUrl,
  "image": `${siteUrl}/img/jt.LOGO-02.png`,
  "sameAs": [
    "https://github.com/jaumetur3W",
    "https://www.linkedin.com/in/jautur/",
    "https://www.instagram.com/jaume.www/",
    "https://twitter.com/jautur",
    "https://share.google/3tihWcZBWMyYHmjBp"
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Xàtiva",
    "addressRegion": "València",
    "addressCountry": "ES"
  },
  "knowsAbout": [
    "Diseño web",
    "Desarrollo de páginas web",
    "Aplicaciones web a medida",
    "Desarrollo backend y APIs",
    "Automatización de procesos",
    "Angular",
    "TypeScript",
    "JavaScript ES6+",
    "Tailwind CSS",
    "CI/CD",
    "GitHub Actions",
    "Web Performance",
    "WCAG AA Accessibility"
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${siteUrl}/#service`,
  "name": isEn ? "Jaume Tur — Web Development & Custom Applications" : "Jaume Tur — Desarrollo Web y Aplicaciones a Medida",
  "url": siteUrl,
  "image": `${siteUrl}/img/jt.LOGO-02.png`,
  "email": "jaumetur3w@gmail.com",
  "priceRange": "€€",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Xàtiva",
    "addressRegion": "València",
    "addressCountry": "ES"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 38.9897,
    "longitude": -0.5197
  },
  "areaServed": [
    "Xàtiva",
    "La Costera",
    "València",
    "Comunitat Valenciana",
    "España",
    "Remote"
  ],
  "hasMap": "https://share.google/3tihWcZBWMyYHmjBp",
  "sameAs": [
    "https://share.google/3tihWcZBWMyYHmjBp"
  ],
  "serviceArea": isEn ? "Valencia, Spain & Worldwide Remote" : "Xàtiva, Valencia y Remoto"
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": "Jaume Tur",
  "description": resolvedDescription,
  "inLanguage": ["es", "en"],
  "publisher": {
    "@id": `${siteUrl}/#person`
  }
};

const blogPostSchema = isBlogPost ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": resolvedDescription,
  "image": resolvedImageWithDomain,
  "datePublished": publishDate ? new Date(publishDate).toISOString() : undefined,
  "dateModified": publishDate ? new Date(publishDate).toISOString() : undefined,
  "author": {
    "@type": "Person",
    "name": author,
    "url": siteUrl
  },
  "publisher": {
    "@type": "Person",
    "name": "Jaume Tur",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/jt-monogram.svg`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL
  },
  "keywords": tags.join(", ")
} : null;
---

<!doctype html>
<html lang={activeLang} class="scroll-smooth overflow-x-clip">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme Initialization: Permanent Light Mode -->
    <script is:inline>
      (function() {
        try {
          localStorage.removeItem('theme');
          document.documentElement.classList.remove('dark');
        } catch (_) {}
      })();
    </script>
    <!-- RSS Feed Autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={isEn ? "Jaume Tur — Technical Blog RSS Feed" : "Jaume Tur — Blog Técnico Canal RSS"}
      href="/rss.xml"
    />

    <!-- Hreflang Tags for i18n (Canonical is managed by SEO component below) -->
    {!shouldNoIndex && (
      <>
        <link rel="alternate" hreflang="es" href={spanishURL} />
        <link rel="alternate" hreflang="en" href={englishURL} />
        <link rel="alternate" hreflang="x-default" href={spanishURL} />
      </>
    )}

    <!-- SEO & Social OpenGraph -->
    <SEO
      title={makeTitle}
      description={metaDescription}
      canonical={is404 ? null : canonicalURL}
      noindex={shouldNoIndex}
      nofollow={shouldNoIndex}
      twitter={{
        creator: "@jautur",
        site: "@jautur",
        card: "summary_large_image",
        title: makeTitle,
        description: metaDescription,
        image: resolvedImageWithDomain,
        imageAlt: makeTitle,
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: isBlogPost ? "article" : "website",
          title: makeTitle,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: makeTitle,
        },
        optional: {
          siteName: isEn ? "Jaume Tur — Portfolio & Engineering" : "Jaume Tur — Portafolio y Blog de Ingeniería",
          description: metaDescription,
          locale: isEn ? "en_US" : "es_ES",
        },
      }}
    />

    <!--
      Entrada «setup»: decide antes de pintar si se muestra. El contenido sigue en el HTML;
      la capa se monta en cliente y una cobertura con tope de 2 s evita el parpadeo de la home.
    -->
    <style is:inline>
      html[data-setup-pending]::after { content: ""; position: fixed; inset: 0; z-index: 2147483646; background: #0a0a0a; }
      /* Al salir de la entrada, la página llega deslizándose desde abajo. No afecta a ninguna otra navegación. */
      ::view-transition-old(root) { animation: none; }
      ::view-transition-new(root) { animation: setup-slide-in 520ms cubic-bezier(0.22, 1, 0.36, 1); }
      @keyframes setup-slide-in { from { transform: translateY(100%); } }
    </style>
    <script is:inline define:vars={{ setupDev: import.meta.env.DEV, setupSrcsetAvif: setupSrcset("avif"), setupSizes: SETUP_IMAGE_SIZES }}>
      var root = document.documentElement;
      var params = new URLSearchParams(location.search);
      var KEY = "jt-setup-done";
      var storage = null;
      try { storage = window.sessionStorage; } catch (_) {}

      var entry = performance.getEntriesByType("navigation")[0];
      var type = entry ? entry.type : "navigate";
      var path = location.pathname;
      var isRoot = path === "/" || path === "/en" || path === "/en/";
      var fromCampaign = params.has("gclid") || Array.from(params.keys()).some(function (key) { return key.indexOf("utm_") === 0; });
      var unsuitable =
        innerWidth < 768 ||
        innerWidth / innerHeight < 1.3 ||
        matchMedia("(hover: none)").matches ||
        navigator.webdriver === true;
      var calibrate = setupDev && params.has("calibrate");

      // Se viene de pulsar un objeto de la entrada: esta página llega deslizándose.
      var SLIDE_KEY = "jt-setup-slide";
      var slideIn = !!(storage && storage.getItem(SLIDE_KEY));
      if (slideIn) storage.removeItem(SLIDE_KEY);

      var show = false;
      if (calibrate) {
        show = true;
      } else if (!slideIn && storage && !params.has("nosetup") && !fromCampaign && !unsuitable) {
        if (type === "reload") storage.removeItem(KEY);
        show = type === "reload" || (type === "navigate" && isRoot && !storage.getItem(KEY));
      }

      // Las dos páginas deben activarlo: solo la entrada y la página a la que lleva.
      if (slideIn || (show && !matchMedia("(prefers-reduced-motion: reduce)").matches)) {
        var viewTransition = document.createElement("style");
        viewTransition.setAttribute("data-setup-slide", "");
        viewTransition.textContent = "@view-transition { navigation: auto; }";
        document.head.appendChild(viewTransition);
      }

      if (!show) {
        // Una entrada sin setup cuenta como vista: el logo o volver a la raíz no deben mostrarlo después.
        if (storage) storage.setItem(KEY, "1");
      } else {
        root.setAttribute("data-setup-pending", "");
        if ("scrollRestoration" in history) history.scrollRestoration = "manual";

        var preload = document.createElement("link");
        preload.rel = "preload";
        preload.as = "image";
        preload.type = "image/avif";
        preload.setAttribute("imagesrcset", setupSrcsetAvif);
        preload.setAttribute("imagesizes", setupSizes);
        preload.setAttribute("fetchpriority", "high");
        document.head.appendChild(preload);

        // Mientras dure la capa, la rueda no debe llegar al hero que hay debajo.
        var block = function (event) { event.preventDefault(); event.stopPropagation(); };
        var options = { capture: true, passive: false };
        window.addEventListener("wheel", block, options);
        window.addEventListener("touchmove", block, options);

        var boot = (window.__jtSetup = {
          calibrate: calibrate,
          uncover: function () { root.removeAttribute("data-setup-pending"); },
          release: function () {
            window.removeEventListener("wheel", block, options);
            window.removeEventListener("touchmove", block, options);
          },
        });
        setTimeout(function () {
          if (boot.mounted) return;
          boot.expired = true;
          boot.uncover();
          boot.release();
          if (storage) storage.setItem(KEY, "1");
        }, 2000);
      }
    </script>

    <!-- Preload Critical Font: Eliminates font waterfall for LCP -->
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Structured Data: JSON-LD Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    {isBlogPost && blogPostSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(blogPostSchema)} />
    )}
  </head>
  <body class="bg-white text-slate-900 antialiased selection:bg-[#FFFF00] selection:text-black min-h-screen flex flex-col justify-between overflow-x-clip">
    <!-- Accessible Skip Link for Keyboard and Screen Reader Navigation -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2.5 focus:bg-slate-950 focus:text-[#FFFF00] focus:font-bold focus:rounded-xl focus:shadow-2xl focus:outline-none focus:ring-4 focus:ring-[#FFFF00]/40 transition">
      {isEn ? "Skip to main content" : "Saltar al contenido principal"}
    </a>
    <div id="top"></div>
    <div class="flex-1 w-full flex flex-col">
      <Navbar />
      <main id="main-content" class="outline-none" tabindex="-1">
        <slot />
      </main>
    </div>
    <Footer />

    <!-- Interactive Layer: Easter Eggs -->
    <EasterEggs />
    <!-- Entrada «setup»: su código solo se descarga cuando se va a mostrar -->
    <script>
      const boot = (window as unknown as { __jtSetup?: import("@/setup/setup-layer").SetupBoot & { calibrate?: boolean } }).__jtSetup;
      if (boot) {
        import("@/setup/setup-layer")
          .then(async ({ mountSetup }) => {
            const mounted = mountSetup(boot);
            if (import.meta.env.DEV && mounted && boot.calibrate) {
              const { mountCalibration } = await import("@/setup/calibrate");
              mountCalibration(mounted.layer, mounted.camera);
            }
          })
          .catch(() => {
            boot.uncover();
            boot.release();
          });
      }
    </script>
    <!-- Motion Budget: Lightweight IntersectionObserver for single-pass section reveals -->
    <script is:inline>
      function initSectionReveals() {
        const reveals = document.querySelectorAll('.reveal-fade-up');
        if (!reveals.length) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
          reveals.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -40px 0px', threshold: 0.08 });

        reveals.forEach((el) => {
          if (!el.classList.contains('is-visible')) {
            observer.observe(el);
          }
        });
      }
      if ("requestIdleCallback" in window) {
        requestIdleCallback(initSectionReveals);
      } else {
        window.addEventListener("load", () => setTimeout(initSectionReveals, 300));
      }
    </script>
    <!-- Privacy-friendly Web Analytics (Plausible / Umami Ready) -->
    <script is:inline>
      function initAnalytics() {
        if (typeof window !== "undefined" && window.location.hostname === "jaumetur.es") {
          const s = document.createElement("script");
          s.defer = true;
          s.dataset.domain = "jaumetur.es";
          s.src = "https://plausible.io/js/script.js";
          document.body.appendChild(s);
        }
      }
      if ("requestIdleCallback" in window) {
        requestIdleCallback(initAnalytics);
      } else {
        window.addEventListener("load", () => setTimeout(initAnalytics, 1500));
      }
    </script>
  </body>
</html>

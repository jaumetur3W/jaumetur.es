---
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import { getServicesData } from "@/data/services";
import { alternatePaths, localeFromPath } from "@/i18n";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: string;
  canonicalURL?: string;
  /** Bloques JSON-LD adicionales de la página (FAQ, migas de pan, servicios…). */
  jsonLd?: object[];
  /** Página con el diseño nuevo: omite el ajuste tipográfico de las páginas heredadas. */
  fresh?: boolean;
  /** Página privada: sin indexar y sin alternates hreflang. */
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/opengraph.jpg",
  lang,
  canonicalURL: customCanonical,
  jsonLd = [],
  fresh = false,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://jaumetur.es";
const locale = localeFromPath(Astro.url.pathname);
const isEn = locale === "en";
const resolvedDescription =
  description ||
  (isEn
    ? "Custom websites, digital menus, Google Maps and Instagram presence for local businesses in Xàtiva and Valencia. From €290."
    : "Páginas web a medida, cartas digitales y presencia en Google Maps e Instagram para negocios de Xàtiva y Valencia. Desde 290 €.");
const activeLang = lang || (isEn ? "en" : "es");
const alternatePathsForPage = alternatePaths(Astro.url.pathname);

const ensureTrailingSlash = (urlStr: string) => {
  const url = new URL(urlStr, siteUrl);
  if (!url.pathname.endsWith("/") && !/\.[a-z0-9]+$/i.test(url.pathname)) {
    url.pathname = `${url.pathname}/`;
  }
  return url.toString();
};

const is404 = Astro.url.pathname.includes("404");
const shouldNoIndex = noindex || is404;

const spanishURL = ensureTrailingSlash(new URL(alternatePathsForPage.es, siteUrl).toString());
const englishURL = ensureTrailingSlash(new URL(alternatePathsForPage.en, siteUrl).toString());
const canonicalURL = ensureTrailingSlash(customCanonical || new URL(Astro.url.pathname, siteUrl).toString());
const resolvedImageWithDomain = new URL(image, siteUrl).toString();

// Títulos y descripciones con longitud segura para los resultados de Google
const TITLE_MAX = 60;
const DESCRIPTION_MAX = 158;
const BRAND_SUFFIX = " | Jaume Tur";

const shortenAtBoundary = (text: string, max: number) => {
  if (text.length <= max) return text;
  const cut = text.slice(0, max);
  const separator = Math.max(
    cut.lastIndexOf(": "),
    cut.lastIndexOf(", "),
    cut.lastIndexOf(" — "),
    cut.lastIndexOf(" – "),
    cut.lastIndexOf(" - "),
  );
  const end = separator >= 25 ? separator : cut.lastIndexOf(" ");
  return cut.slice(0, end > 0 ? end : max).replace(/[\s,:;—–-]+$/, "");
};

const buildSeoTitle = (rawTitle: string) => {
  const core = rawTitle.replace(/\s*[|—–-]\s*Jaume Tur$/, "");
  return core.length + BRAND_SUFFIX.length <= TITLE_MAX
    ? `${core}${BRAND_SUFFIX}`
    : shortenAtBoundary(core, TITLE_MAX);
};

const isHome = !title || title === "Inici" || title === "Inicio" || title === "Home";
const makeTitle = isHome
  ? isEn
    ? "Web Design in Valencia & Xàtiva, from €290 | Jaume Tur"
    : "Diseño web en Xàtiva y Valencia, desde 290 € | Jaume Tur"
  : buildSeoTitle(title);

const shortenDescription = (text: string) => {
  if (text.length <= DESCRIPTION_MAX) return text;
  const cut = text.slice(0, DESCRIPTION_MAX - 1);
  const sentenceEnd = cut.lastIndexOf(". ");
  const end = sentenceEnd >= 90 ? sentenceEnd : cut.lastIndexOf(" ");
  return `${cut.slice(0, end > 0 ? end : cut.length).replace(/[\s.,:;]+$/, "")}…`;
};
const metaDescription = shortenDescription(resolvedDescription);

// ---------------------------------------------------------------
// Datos estructurados (JSON-LD). Solo datos reales ya publicados en la web.
// ---------------------------------------------------------------
const sameAs = [
  "https://github.com/jaumetur3W",
  "https://www.linkedin.com/in/jautur/",
  "https://www.instagram.com/jaume.www/",
  "https://twitter.com/jautur",
  "https://share.google/3tihWcZBWMyYHmjBp",
];

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}/#person`,
  "name": "Jaume Tur",
  "givenName": "Jaume",
  "familyName": "Tur",
  "jobTitle": isEn ? "Web developer and custom applications" : "Desarrollador web y de aplicaciones a medida",
  "email": "jaumetur3w@gmail.com",
  "url": siteUrl,
  "image": `${siteUrl}/img/jt.LOGO-02.png`,
  "sameAs": sameAs,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Xàtiva",
    "addressRegion": "València",
    "addressCountry": "ES",
  },
  "knowsAbout": [
    "Diseño web",
    "Desarrollo de páginas web",
    "Carta digital para restaurantes",
    "SEO local y Google Business Profile",
    "Aplicaciones web a medida",
    "Angular",
    "TypeScript",
    "Tailwind CSS",
    "Astro",
    "CI/CD",
    "Accesibilidad web WCAG",
    "Rendimiento web",
  ],
};

const services = getServicesData(isEn ? "en" : "es");
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${siteUrl}/#service`,
  "name": isEn ? "Jaume Tur — Web design and custom applications" : "Jaume Tur — Diseño web y aplicaciones a medida",
  "url": siteUrl,
  "image": `${siteUrl}/img/jt.LOGO-02.png`,
  "email": "jaumetur3w@gmail.com",
  "founder": { "@id": `${siteUrl}/#person` },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Xàtiva",
    "addressRegion": "València",
    "addressCountry": "ES",
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 38.9897, "longitude": -0.5197 },
  "areaServed": ["Xàtiva", "La Costera", "València", "Comunitat Valenciana", "España"],
  "hasMap": "https://share.google/3tihWcZBWMyYHmjBp",
  "sameAs": sameAs,
  "knowsLanguage": ["es", "en"],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": isEn ? "Services and pricing" : "Servicios y precios",
    "itemListElement": services.map((service) => ({
      "@type": "Offer",
      "price": service.creationPriceNumber,
      "priceCurrency": "EUR",
      "url": `${siteUrl}${isEn ? "/en" : ""}/pricing/${service.id}/`,
      "itemOffered": {
        "@type": "Service",
        "name": service.name,
        "description": service.tagline,
      },
    })),
  },
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": "Jaume Tur",
  "description": resolvedDescription,
  "inLanguage": ["es", "en"],
  "publisher": { "@id": `${siteUrl}/#person` },
};
---

<!doctype html>
<html lang={activeLang} class="scroll-smooth overflow-x-clip">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffff00" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add("js");</script>

    <!-- Hreflang (el canonical lo gestiona el componente SEO) -->
    {!shouldNoIndex && (
      <>
        <link rel="alternate" hreflang="es" href={spanishURL} />
        <link rel="alternate" hreflang="en" href={englishURL} />
        <link rel="alternate" hreflang="x-default" href={spanishURL} />
      </>
    )}

    <SEO
      title={makeTitle}
      description={metaDescription}
      canonical={is404 ? null : canonicalURL}
      noindex={shouldNoIndex}
      nofollow={shouldNoIndex}
      twitter={{
        creator: "@jautur",
        site: "@jautur",
        card: "summary_large_image",
        title: makeTitle,
        description: metaDescription,
        image: resolvedImageWithDomain,
        imageAlt: makeTitle,
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: makeTitle,
          image: resolvedImageWithDomain,
        },
        image: { alt: makeTitle },
        optional: {
          siteName: "Jaume Tur",
          description: metaDescription,
          locale: isEn ? "en_US" : "es_ES",
        },
      }}
    />

    <!-- Fuentes críticas: evita la cascada que retrasa el LCP -->
    <link rel="preload" href="/fonts/space-grotesk-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body class="bg-[#fafaf3] text-[#0b0b0f] antialiased selection:bg-[#ffff00] selection:text-black min-h-screen flex flex-col overflow-x-clip">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2.5 focus:bg-[#0b0b0f] focus:text-[#ffff00] focus:font-bold focus:rounded-xl focus:outline-none focus:ring-4 focus:ring-[#ffff00]/40"
    >
      {isEn ? "Skip to main content" : "Saltar al contenido principal"}
    </a>
    <Navbar />
    <main id="main-content" class="flex-1 outline-none" tabindex="-1" data-fresh={fresh ? "" : undefined}>
      <slot />
    </main>
    <Footer />

    <!-- Revelado suave de secciones (un solo observer, sin dependencias) -->
    <script is:inline>
      (function () {
        var els = document.querySelectorAll(".reveal-fade-up");
        if (!els.length) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) {
          els.forEach(function (el) { el.classList.add("is-visible"); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          });
        }, { rootMargin: "0px 0px -40px 0px", threshold: 0.08 });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>

    <!-- Analítica respetuosa con la privacidad (Plausible) -->
    <script is:inline>
      function initAnalytics() {
        if (typeof window !== "undefined" && window.location.hostname === "jaumetur.es") {
          var s = document.createElement("script");
          s.defer = true;
          s.dataset.domain = "jaumetur.es";
          s.src = "https://plausible.io/js/script.js";
          document.body.appendChild(s);
        }
      }
      if ("requestIdleCallback" in window) {
        requestIdleCallback(initAnalytics);
      } else {
        window.addEventListener("load", function () { setTimeout(initAnalytics, 1500); });
      }
    </script>
  </body>
</html>

---
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import CommandPalette from "@/components/command-palette.astro";
import ScrollIndicator from "@/components/scroll-indicator.astro";
import EasterEggs from "@/components/easter-eggs.astro";
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/bricolage-grotesque";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  publishDate?: Date | string;
  author?: string;
  tags?: string[];
  canonicalURL?: string;
  lang?: string;
  isBlogPost?: boolean;
}

const {
  title,
  description = "Portfolio professional i blog tècnic de Jaume Tur, desenvolupador Frontend & Web Apps a València. Especialista en Angular, TypeScript, alt rendiment (60 FPS), accessibilitat WCAG AA i automatització CI/CD.",
  image = "/jt-logo-dark.png",
  publishDate,
  author = "Jaume Tur",
  tags = [],
  canonicalURL: customCanonical,
  lang = "ca",
  isBlogPost = false,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://jaumetur.es";
const canonicalURL = customCanonical || new URL(Astro.url.pathname, siteUrl).toString();
const resolvedImageWithDomain = new URL(image, siteUrl).toString();

// Dynamic, keyword-rich title generation
const isHome = !title || title === "Inici" || title === "Home";
const makeTitle = isHome
  ? "Jaume Tur — Desenvolupador Frontend & Web Apps a València | Angular & TypeScript"
  : `${title} | Jaume Tur`;

// JSON-LD Structured Data
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}/#person`,
  "name": "Jaume Tur",
  "givenName": "Jaume",
  "familyName": "Tur",
  "jobTitle": "Desenvolupador Frontend & Web Apps",
  "url": siteUrl,
  "image": `${siteUrl}/jt-logo-dark.png`,
  "sameAs": [
    "https://github.com/jautur",
    "https://www.linkedin.com/in/jautur/",
    "https://twitter.com/jautur"
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "València",
    "addressRegion": "Comunitat Valenciana",
    "addressCountry": "ES"
  },
  "knowsAbout": [
    "Angular",
    "TypeScript",
    "JavaScript ES6+",
    "Tailwind CSS",
    "CI/CD",
    "GitHub Actions",
    "Web Performance",
    "WCAG AA Accessibility"
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${siteUrl}/#service`,
  "name": "Jaume Tur — Desenvolupament Frontend Freelance València",
  "url": siteUrl,
  "image": `${siteUrl}/jt-logo-dark.png`,
  "telephone": "+34-600-000-000",
  "priceRange": "€€",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "València",
    "addressRegion": "Comunitat Valenciana",
    "addressCountry": "ES"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 39.4699,
    "longitude": -0.3763
  },
  "areaServed": [
    "València",
    "Comunitat Valenciana",
    "Espanya",
    "Remote"
  ],
  "serviceArea": "València i Remot"
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": "Jaume Tur",
  "description": description,
  "inLanguage": ["ca", "es", "en"],
  "publisher": {
    "@id": `${siteUrl}/#person`
  }
};

const blogPostSchema = isBlogPost ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": resolvedImageWithDomain,
  "datePublished": publishDate ? new Date(publishDate).toISOString() : undefined,
  "dateModified": publishDate ? new Date(publishDate).toISOString() : undefined,
  "author": {
    "@type": "Person",
    "name": author,
    "url": siteUrl
  },
  "publisher": {
    "@type": "Person",
    "name": "Jaume Tur",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/jt-logo-dark.png`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL
  },
  "keywords": tags.join(", ")
} : null;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Astro View Transitions Router -->
    <ClientRouter />

    <!-- Theme Initialization: Permanent Light Mode -->
    <script is:inline>
      (function() {
        try {
          localStorage.removeItem('theme');
          document.documentElement.classList.remove('dark');
        } catch (_) {}
      })();
    </script>

    <!-- RSS Feed Autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Jaume Tur — Blog Tècnic RSS Feed"
      href="/rss.xml"
    />

    <!-- Canonical and Hreflang Tags for i18n -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="ca" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <!-- Google Search Console & Bing Verification Placeholders -->
    <meta name="google-site-verification" content="GSC_VERIFICATION_TOKEN_PLACEHOLDER" />
    <meta name="msvalidate.01" content="BING_VERIFICATION_TOKEN_PLACEHOLDER" />

    <!-- SEO & Social OpenGraph -->
    <SEO
      title={makeTitle}
      description={description}
      canonical={canonicalURL}
      twitter={{
        creator: "@jautur",
        site: "@jautur",
        card: "summary_large_image",
        title: makeTitle,
        description: description,
        image: resolvedImageWithDomain,
        imageAlt: makeTitle,
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: isBlogPost ? "article" : "website",
          title: makeTitle,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: makeTitle,
        },
        optional: {
          siteName: "Jaume Tur — Portfolio & Blog Tècnic",
          description: description,
          locale: "ca_ES",
        },
      }}
    />

    <!-- Structured Data: JSON-LD Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    {isBlogPost && blogPostSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(blogPostSchema)} />
    )}

    <!-- Privacy-friendly Web Analytics (Plausible / Umami Ready) -->
    <!-- Documented in MEDICION.md: Activated when domain is configured -->
    <script
      defer
      data-domain="jaumetur.es"
      src="https://plausible.io/js/script.js"
    ></script>
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased selection:bg-slate-900 selection:text-white min-h-screen flex flex-col justify-between">
    <!-- Accessible Skip Link for Keyboard and Screen Reader Navigation -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2.5 focus:bg-indigo-600 focus:text-white focus:font-bold focus:rounded-xl focus:shadow-2xl focus:outline-none focus:ring-4 focus:ring-indigo-300 transition">
      Saltar al contingut principal
    </a>
    <div id="top"></div>
    <div>
      <Navbar />
      <main id="main-content" class="outline-none" tabindex="-1">
        <slot />
      </main>
    </div>
    <Footer />

    <!-- Interactive Layer: Command Palette (Cmd+K), Scroll Indicator & Easter Eggs -->
    <CommandPalette />
    <ScrollIndicator />
    <EasterEggs />

    <style is:global>
      /* Core Web Vitals optimization */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": "Jaume Tur",
  "description": resolvedDescription,
  "inLanguage": ["es", "en"],

---
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import EasterEggs from "@/components/easter-eggs.astro";
import { alternatePaths, localeFromPath } from "@/i18n";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/bricolage-grotesque";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  publishDate?: Date | string;
  author?: string;
  tags?: string[];
  lang?: string;
  canonicalURL?: string;
  isBlogPost?: boolean;
}

const {
  title,
  description,
  image = "/opengraph.jpg",
  publishDate,
  author = "Jaume Tur",
  tags = [],
  lang,
  canonicalURL: customCanonical,
  isBlogPost = false,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://jaumetur.es";
const locale = localeFromPath(Astro.url.pathname);
const resolvedDescription = description || (locale === "val"
  ? "Desenvolupament de pàgines web, aplicacions a mida, backend i automatització a Xàtiva i València. Solucions ràpides i adaptades al teu negoci."
  : "Desarrollo de páginas web profesionales, aplicaciones a medida, backend y automatización en Xàtiva y Valencia. Soluciones rápidas y adaptadas a tu negocio.");
const activeLang = lang === "es" ? "es" : locale === "val" || lang === "ca" ? "ca-ES-valencia" : "es";
const alternatePathsForPage = alternatePaths(Astro.url.pathname);
const spanishURL = new URL(alternatePathsForPage.es, siteUrl).toString();
const valencianURL = new URL(alternatePathsForPage.val, siteUrl).toString();
const canonicalURL = customCanonical || new URL(Astro.url.pathname, siteUrl).toString();
const resolvedImageWithDomain = new URL(image, siteUrl).toString();

// Dynamic, keyword-rich title generation
const isHome = !title || title === "Inici" || title === "Inicio" || title === "Home";
const makeTitle = isHome
  ? locale === "val"
    ? "Jaume Tur — Desenvolupament Web i Aplicacions a Xàtiva i València"
    : "Jaume Tur — Desarrollo Web y Aplicaciones a Medida en Xàtiva y Valencia"
  : title.endsWith("Jaume Tur")
    ? title
    : `${title} | Jaume Tur`;

// JSON-LD Structured Data
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}/#person`,
  "name": "Jaume Tur",
  "givenName": "Jaume",
  "familyName": "Tur",
  "jobTitle": "Desenvolupador Web & Aplicacions a Mida | Backend i Sistemes",
  "email": "jaumetur3w@gmail.com",
  "url": siteUrl,
  "image": `${siteUrl}/img/jt.LOGO-02.png`,
  "sameAs": [
    "https://github.com/jaumetur3W",
    "https://www.linkedin.com/in/jautur/",
    "https://www.instagram.com/jaume.www/",
    "https://twitter.com/jautur",
    "https://share.google/3tihWcZBWMyYHmjBp"
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Xàtiva",
    "addressRegion": "València",
    "addressCountry": "ES"
  },
  "knowsAbout": [
    "Diseño web",
    "Desarrollo de páginas web",
    "Aplicaciones web a medida",
    "Desarrollo backend y APIs",
    "Automatización de procesos",
    "Angular",
    "TypeScript",
    "JavaScript ES6+",
    "Tailwind CSS",
    "CI/CD",
    "GitHub Actions",
    "Web Performance",
    "WCAG AA Accessibility"
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${siteUrl}/#service`,
  "name": "Jaume Tur — Desenvolupament Web & Aplicacions",
  "url": siteUrl,
  "image": `${siteUrl}/img/jt.LOGO-02.png`,
  "email": "jaumetur3w@gmail.com",
  "priceRange": "€€",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Xàtiva",
    "addressRegion": "València",
    "addressCountry": "ES"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 38.9897,
    "longitude": -0.5197
  },
  "areaServed": [
    "Xàtiva",
    "La Costera",
    "València",
    "Comunitat Valenciana",
    "España",
    "Remote"
  ],
  "hasMap": "https://share.google/3tihWcZBWMyYHmjBp",
  "sameAs": [
    "https://share.google/3tihWcZBWMyYHmjBp"
  ],
  "serviceArea": "Xàtiva, València i Remot"
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": "Jaume Tur",
  "description": resolvedDescription,
  "inLanguage": ["ca", "es", "en"],
  "publisher": {
    "@id": `${siteUrl}/#person`
  }
};

const blogPostSchema = isBlogPost ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": resolvedDescription,
  "image": resolvedImageWithDomain,
  "datePublished": publishDate ? new Date(publishDate).toISOString() : undefined,
  "dateModified": publishDate ? new Date(publishDate).toISOString() : undefined,
  "author": {
    "@type": "Person",
    "name": author,
    "url": siteUrl
  },
  "publisher": {
    "@type": "Person",
    "name": "Jaume Tur",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/jt-monogram.svg`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL
  },
  "keywords": tags.join(", ")
} : null;
---

<!doctype html>
<html lang={activeLang} class="scroll-smooth overflow-x-clip">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#090D16" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme Initialization: Permanent Light Mode -->
    <script is:inline>
      (function() {
        try {
          localStorage.removeItem('theme');
          document.documentElement.classList.remove('dark');
        } catch (_) {}
      })();
    </script>
    <!-- RSS Feed Autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Jaume Tur — Blog Tècnic RSS Feed"
      href="/rss.xml"
    />

    <!-- Hreflang Tags for i18n (Canonical is managed by SEO component below) -->
    <link rel="alternate" hreflang="es" href={spanishURL} />
    <link rel="alternate" hreflang="ca-ES-valencia" href={valencianURL} />
    <link rel="alternate" hreflang="x-default" href={spanishURL} />

    <!-- SEO & Social OpenGraph -->
    <SEO
      title={makeTitle}
      description={resolvedDescription}
      canonical={canonicalURL}
      twitter={{
        creator: "@jautur",
        site: "@jautur",
        card: "summary_large_image",
        title: makeTitle,
        description: resolvedDescription,
        image: resolvedImageWithDomain,
        imageAlt: makeTitle,
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: isBlogPost ? "article" : "website",
          title: makeTitle,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: makeTitle,
        },
        optional: {
          siteName: "Jaume Tur — Portfolio & Blog Tècnic",
          description: resolvedDescription,
          locale: locale === "val" ? "ca_ES" : "es_ES",
        },
      }}
    />

    <!-- Structured Data: JSON-LD Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    {isBlogPost && blogPostSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(blogPostSchema)} />
    )}

    <!-- Privacy-friendly Web Analytics (Plausible / Umami Ready) -->
    <!-- Documented in MEDICION.md: Activated when domain is configured -->
    <script is:inline>
      if (typeof window !== "undefined" && window.location.hostname === "jaumetur.es") {
        const s = document.createElement("script");
        s.defer = true;
        s.dataset.domain = "jaumetur.es";
        s.src = "https://plausible.io/js/script.js";
        document.head.appendChild(s);
      }
    </script>
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased selection:bg-slate-900 selection:text-white min-h-screen flex flex-col justify-between overflow-x-clip">
    <!-- Accessible Skip Link for Keyboard and Screen Reader Navigation -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2.5 focus:bg-indigo-600 focus:text-white focus:font-bold focus:rounded-xl focus:shadow-2xl focus:outline-none focus:ring-4 focus:ring-indigo-300 transition">
      Saltar al contingut principal
    </a>
    <div id="top"></div>
    <div class="flex-1 w-full flex flex-col">
      <Navbar />
      <main id="main-content" class="outline-none" tabindex="-1">
        <slot />
      </main>
    </div>
    <Footer />

    <!-- Interactive Layer: Easter Eggs -->
    <EasterEggs />
    <!-- Motion Budget: Lightweight IntersectionObserver for single-pass section reveals -->
    <script is:inline>
      function initSectionReveals() {
        const reveals = document.querySelectorAll('.reveal-fade-up');
        if (!reveals.length) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
          reveals.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -40px 0px', threshold: 0.08 });

        reveals.forEach((el) => {
          if (!el.classList.contains('is-visible')) {
            observer.observe(el);
          }
        });
      }
      if ("requestIdleCallback" in window) {
        requestIdleCallback(initSectionReveals);
      } else {
        window.addEventListener("load", () => setTimeout(initSectionReveals, 300));
      }
    </script>
  </body>
</html>
